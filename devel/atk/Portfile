PortSystem          1.0
PortGroup           gobject_introspection 1.0
PortGroup           meson 1.0

name                atk
epoch               3
version             2.38.0
revision            2
set branch          [join [lrange [split ${version} .] 0 1] .]
categories          devel
license             LGPL
maintainers         nomaintainer

description         GNOME accessibility toolkit

long_description    ATK is the GNOME Accessibility ToolKit

homepage            https://projects.gnome.org/accessibility
master_sites        gnome:sources/${name}/${branch}/

checksums           rmd160  43ddb754d6ec43e69365fa14856959eebd65df15 \
                    sha256  ac4de2a4ef4bd5665052952fe169657e65e895c5057dffb3c2a810f6191a0c36 \
                    size    303952

use_xz              yes

depends_build-append \
                    port:gettext \
                    port:gtk-doc \
                    path:bin/pkg-config:pkgconfig

depends_lib         port:gettext-runtime \
                    path:lib/pkgconfig/glib-2.0.pc:glib2

gobject_introspection   yes

configure.args      -Ddocs=true

# atk-scan is linked with @loader_path/libatk-1.0.0.dylib during doc
# generation phase, which is incorrect. Skipping docs prevents it from being
# called during the build.
platform darwin 8 {
    configure.args-replace  -Ddocs=true -Ddocs=false
}

pre-configure {
    configure.args-replace  -Dintrospection=enabled -Dintrospection=true
}

livecheck.type      gnome
