+struct CocoMenuLink {
+	CocoMenuLink     *next;
+	void             *menu; // NSMenu, used as the key only
+	Upp::CocoMenuBar *bar;
+};
+
+// Plain list rather than a container: it has to work while static objects are destroyed
+static CocoMenuLink     *sCocoMenuLinks;
+static Upp::StaticMutex  sCocoMenuLinkMutex;
+
+static void sCocoMenuRemove(void *menu, Upp::CocoMenuBar *bar)
+{ // removes links of menu and links of bar
+	Upp::Mutex::Lock __(sCocoMenuLinkMutex);
+	CocoMenuLink **p = &sCocoMenuLinks;
+	while(*p) {
+		CocoMenuLink *m = *p;
+		if(menu && m->menu == menu || bar && m->bar == bar) {
+			*p = m->next;
+			delete m;
+		}
+		else
+			p = &m->next;
+	}
+}
+
+static Upp::CocoMenuBar *CocoMenuGetPtr(NSMenu *menu)
+{
+	Upp::Mutex::Lock __(sCocoMenuLinkMutex);
+	for(CocoMenuLink *m = sCocoMenuLinks; m; m = m->next)
+		if(m->menu == (void *)menu)
+			return m->bar;
+	return NULL;
+}
+
+static void CocoMenuRemoveBar(Upp::CocoMenuBar *p)
+{
+	sCocoMenuRemove(NULL, p);
+}
+
+static void CocoMenuSetPtr(NSMenu *menu, Upp::CocoMenuBar *p)
+{
+	Upp::Mutex::Lock __(sCocoMenuLinkMutex);
+	sCocoMenuRemove((void *)menu, p); // CocoMenuBar has a single menu
+	if(p) {
+		CocoMenuLink *m = new CocoMenuLink;
+		m->menu = (void *)menu;
+		m->bar = p;
+		m->next = sCocoMenuLinks;
+		sCocoMenuLinks = m;
+	}
+}
+
+static Upp::Event<Upp::Bar&> *CocoMenuGetProc(NSMenu *menu)
+{
+	Upp::CocoMenuBar *bar = CocoMenuGetPtr(menu);
+	return bar ? bar->proc : NULL;
+}
+
+static Upp::CocoMenuBar *CocoMenuItemGetBar(id nsitem)
+{
+	Upp::Mutex::Lock __(sCocoMenuLinkMutex);
+	for(CocoMenuLink *m = sCocoMenuLinks; m; m = m->next) {
+		const Upp::Array<Upp::CocoMenuBar::Item>& item = m->bar->item;
+		for(int i = 0; i < item.GetCount(); i++)
+			if(item[i].nsitem == nsitem)
+				return m->bar;
+	}
+	return NULL;
+}
+
