diff --git a/uppsrc/CtrlCore/CocoWin.mm b/uppsrc/CtrlCore/CocoWin.mm
index c8254a5..e146938 100644
--- a/uppsrc/CtrlCore/CocoWin.mm
+++ b/uppsrc/CtrlCore/CocoWin.mm
@@ -83,6 +83,91 @@ static void SwizzleNSWindowMethods()
 
 namespace Upp {
 
+struct CocoLink {
+	CocoLink  *next;
+	void      *object; // CocoView or CocoWindow, used as the key only
+	Ptr<Ctrl>  ctrl;
+	bool       active = false;
+};
+
+// Plain list rather than a container: it has to work while static objects are destroyed
+static CocoLink   *sCocoLinks;
+static StaticMutex sCocoLinkMutex; // own lock: lookups are also done for windows of AppKit
+
+static CocoLink *sFindCocoLink(void *object)
+{
+	for(CocoLink *m = sCocoLinks; m; m = m->next)
+		if(m->object == object)
+			return m->ctrl ? m : NULL;
+	return NULL;
+}
+
+static void sSetCocoLink(void *object, Ctrl *ctrl)
+{
+	CocoLink **p = &sCocoLinks;
+	while(*p) {
+		CocoLink *m = *p;
+		if(m->object == object || !m->ctrl) { // !ctrl: Ctrl was destroyed meanwhile
+			*p = m->next;
+			delete m;
+		}
+		else
+			p = &m->next;
+	}
+	if(ctrl) {
+		CocoLink *m = new CocoLink;
+		m->object = object;
+		m->ctrl = ctrl;
+		m->next = sCocoLinks;
+		sCocoLinks = m;
+	}
+}
+
+};
+
+Upp::Ctrl *CocoViewGetCtrl(CocoView *view)
+{
+	Upp::Mutex::Lock __(Upp::sCocoLinkMutex);
+	Upp::CocoLink *m = Upp::sFindCocoLink((void *)view);
+	return m ? ~m->ctrl : NULL;
+}
+
+void CocoViewSetCtrl(CocoView *view, Upp::Ctrl *c)
+{
+	Upp::Mutex::Lock __(Upp::sCocoLinkMutex);
+	Upp::sSetCocoLink((void *)view, c);
+}
+
+Upp::Ctrl *CocoWindowGetCtrl(CocoWindow *win)
+{
+	Upp::Mutex::Lock __(Upp::sCocoLinkMutex);
+	Upp::CocoLink *m = Upp::sFindCocoLink((void *)win);
+	return m ? ~m->ctrl : NULL;
+}
+
+void CocoWindowSetCtrl(CocoWindow *win, Upp::Ctrl *c)
+{
+	Upp::Mutex::Lock __(Upp::sCocoLinkMutex);
+	Upp::sSetCocoLink((void *)win, c);
+}
+
+bool CocoWindowGetActive(CocoWindow *win)
+{
+	Upp::Mutex::Lock __(Upp::sCocoLinkMutex);
+	Upp::CocoLink *m = Upp::sFindCocoLink((void *)win);
+	return m && m->active;
+}
+
+void CocoWindowSetActive(CocoWindow *win, bool a)
+{
+	Upp::Mutex::Lock __(Upp::sCocoLinkMutex);
+	Upp::CocoLink *m = Upp::sFindCocoLink((void *)win);
+	if(m)
+		m->active = a;
+}
+
+namespace Upp {
+
 static Vector<Ptr<Ctrl>> mmtopctrl; // should work without Ptr, but let us be defensive....
 
 bool Ctrl::always_use_bundled_icon = false;
@@ -236,6 +321,12 @@ void Ctrl::WndDestroy()
 	[window orderOut:nil];
 	[window close];
 
+	// Window can outlive Ctrl. 'window' is used as the key only here, it is not accessed,
+	// as it can be deallocated already; should another window have got its address and a
+	// link meanwhile, leave that link alone.
+	if(CocoWindowGetCtrl(window) == this)
+		CocoWindowSetCtrl(window, NULL);
+
 	delete coco;
 	DeleteTop();
 
