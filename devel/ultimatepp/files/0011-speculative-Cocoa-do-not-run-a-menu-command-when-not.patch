From 99eaa5d8aeaccc94c410dff9d89d8d1bbce60347 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 28 Sep 2026 20:31:16 +0000
Subject: [PATCH 11/15] [speculative] Cocoa: do not run a menu command when
 nothing is highlighted

The fallback in menuDidClose: invokes the item that was highlighted
last, even if the highlight has left it since: menu:willHighlightItem:
is called with nil then, and nil was ignored. So a command ran when the
pointer was moved off the menu and the menu dismissed, or when moving
from one menu of the menu bar to the next.

Track the highlighted item per menu and honour nil.

Speculative because of one thing that cannot be told without trying:
if AppKit removes the highlight (nil) from the chosen item *before* it
calls menuDidClose:, no menu command will run at all with this patch.
That would be obvious at once; drop the patch in that case.

To test: choose a command from the main menu, from a submenu, from a
context menu (mouse and keyboard). Then hover an item, move the pointer
off the menu and click elsewhere; and move between menus of the menu
bar over highlighted items. Commands must run in the first case only.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 uppsrc/CtrlLib/MacMenu.mm | 43 ++++++++++++++++++++++++++++-----------
 1 file changed, 31 insertions(+), 12 deletions(-)

diff --git a/uppsrc/CtrlLib/MacMenu.mm b/uppsrc/CtrlLib/MacMenu.mm
index b53c21e..b8eff2b 100644
--- a/uppsrc/CtrlLib/MacMenu.mm
+++ b/uppsrc/CtrlLib/MacMenu.mm
@@ -26,10 +26,10 @@ static void                   CocoMenuRemoveBar(Upp::CocoMenuBar *p);
 static Upp::Event<Upp::Bar&> *CocoMenuGetProc(NSMenu *menu);
 // CocoMenuBar that owns the menu item, NULL if there is none (anymore)
 static Upp::CocoMenuBar      *CocoMenuItemGetBar(id nsitem);
-
-// Last highlighted menu item, for the fallback in menuDidClose:. It is not retained,
-// check it with CocoMenuItemGetBar before use.
-static NSMenuItem *lastSelectedMenuItem = nil;
+// Highlighted item of menu, for the fallback in menuDidClose:. It is not retained, check
+// it with CocoMenuItemGetBar before use.
+static id                     CocoMenuGetHighlighted(NSMenu *menu);
+static void                   CocoMenuSetHighlighted(NSMenu *menu, id nsitem);
 
 static void CocoMenuRemoveAllItems(NSMenu *menu)
 { // -[NSMenu removeAllItems] is 10.6+
@@ -190,6 +190,7 @@ struct CocoMenuLink {
 	CocoMenuLink     *next;
 	void             *menu; // NSMenu, used as the key only
 	Upp::CocoMenuBar *bar;
+	id                highlighted;
 };
 
 // Plain list rather than a container: it has to work while static objects are destroyed
@@ -226,6 +227,21 @@ static Upp::CocoMenuBar *CocoMenuGetPtr(NSMenu *menu)
 	return m ? m->bar : NULL;
 }
 
+static id CocoMenuGetHighlighted(NSMenu *menu)
+{
+	Upp::Mutex::Lock __(sCocoMenuLinkMutex);
+	CocoMenuLink *m = sCocoMenuFind((void *)menu);
+	return m ? m->highlighted : nil;
+}
+
+static void CocoMenuSetHighlighted(NSMenu *menu, id nsitem)
+{
+	Upp::Mutex::Lock __(sCocoMenuLinkMutex);
+	CocoMenuLink *m = sCocoMenuFind((void *)menu);
+	if(m)
+		m->highlighted = nsitem;
+}
+
 static void CocoMenuRemoveBar(Upp::CocoMenuBar *p)
 {
 	sCocoMenuRemove(NULL, p);
@@ -239,6 +255,7 @@ static void CocoMenuSetPtr(NSMenu *menu, Upp::CocoMenuBar *p)
 		CocoMenuLink *m = new CocoMenuLink;
 		m->menu = (void *)menu;
 		m->bar = p;
+		m->highlighted = nil;
 		m->next = sCocoMenuLinks;
 		sCocoMenuLinks = m;
 	}
@@ -422,14 +439,16 @@ void CocoMenuBar::New() {
 }
 
 - (void)menu:(NSMenu *)menu willHighlightItem:(NSMenuItem *)item {
-	// Track highlighted item - if it's a real item (not nil, not separator, not submenu parent)
-	if(item && ![item isSeparatorItem] && ![item hasSubmenu]) {
-		lastSelectedMenuItem = item;
-	}
+	// Track the highlighted item of each menu. item is nil when the highlight leaves the
+	// menu, e.g. when the pointer moves away or to another menu of the menu bar; nothing
+	// is selected then. Separators and submenu parents cannot be selected either.
+	if(item && ([item isSeparatorItem] || [item hasSubmenu]))
+		item = nil;
+	CocoMenuSetHighlighted(menu, item);
 }
 
 - (void)menuWillOpen:(NSMenu *)menu {
-	lastSelectedMenuItem = nil;
+	CocoMenuSetHighlighted(menu, nil);
 	Upp::CocoMenuBar *ptr = CocoMenuGetPtr(menu);
 	Upp::Event<Upp::Bar&> *proc = CocoMenuGetProc(menu);
 	if(ptr && ptr->dockmenu)
@@ -447,9 +466,9 @@ void CocoMenuBar::New() {
 		return;
 
 	// The action of the selected item is not delivered here, so invoke the action of the
-	// item that was highlighted last when the menu closes.
-	NSMenuItem *item = lastSelectedMenuItem;
-	lastSelectedMenuItem = nil;
+	// item that is highlighted when the menu closes.
+	NSMenuItem *item = (NSMenuItem *)CocoMenuGetHighlighted(menu);
+	CocoMenuSetHighlighted(menu, nil);
 	NSEvent *e = [NSApp currentEvent];
 	if(e && [e type] == NSEventTypeKeyDown && [e keyCode] == 53) // closed by Esc (kVK_Escape)
 		item = nil;
