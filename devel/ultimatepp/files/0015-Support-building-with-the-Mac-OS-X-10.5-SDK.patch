+#ifdef COCOA_LEOPARD
+// +[NSWindow windowNumbersWithOptions:] is 10.6+. This gets windows of all applications,
+// front to back; -[NSApp windowWithWindowNumber:] then finds ours.
+static NSArray *sWindowNumbers()
+{
+	NSInteger n = 0;
+	NSCountWindows(&n);
+	NSMutableArray *r = [NSMutableArray array];
+	if(n > 0) {
+		Buffer<NSInteger> list(n, 0);
+		NSWindowList(n, ~list);
+		for(NSInteger i = 0; i < n; i++)
+			[r addObject:[NSNumber numberWithInteger:list[i]]];
+	}
+	return r;
+}
+#endif
