@@ -2,6 +2,11 @@
 
 #ifdef PLATFORM_OSX
 #include <sys/time.h>
+#ifdef UPP_MACH_SEMAPHORE
+#include <mach/mach.h>
+#include <mach/semaphore.h>
+#include <mach/task.h>
