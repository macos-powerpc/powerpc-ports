 namespace Upp {
@@ -714,7 +719,47 @@ bool ConditionVariable::Wait(Mutex& m, int timeout_ms)
 	return pthread_cond_timedwait(cv, m.mutex, &until) == 0;
 }
 
-#ifdef PLATFORM_OSX
+#if defined(PLATFORM_OSX) && defined(UPP_MACH_SEMAPHORE)
+
+// Mac OS X before 10.6: no Grand Central Dispatch, and unnamed POSIX semaphores
+// (sem_init) are not implemented in Darwin at all
+
+void Semaphore::Release()
+{
+	semaphore_signal(sem);
+}
+
+bool Semaphore::Wait(int timeout_ms)
+{
+	kern_return_t r;
+	if(timeout_ms < 0) {
+		do
+			r = semaphore_wait(sem);
+		while(r == KERN_ABORTED);
+		return r == KERN_SUCCESS;
+	}
+	mach_timespec_t tm;
+	tm.tv_sec = timeout_ms / 1000;
+	tm.tv_nsec = (timeout_ms % 1000) * 1000000;
+	do
+		r = semaphore_timedwait(sem, tm);
+	while(r == KERN_ABORTED);
+	return r == KERN_SUCCESS;
+}
+
+Semaphore::Semaphore()
+{
+	semaphore_t h = 0;
+	semaphore_create(mach_task_self(), &h, SYNC_POLICY_FIFO, 0);
+	sem = h;
+}
+
+Semaphore::~Semaphore()
+{
+	semaphore_destroy(mach_task_self(), sem);
+}
+
+#elif defined(PLATFORM_OSX)
 
 void Semaphore::Release()
 {
