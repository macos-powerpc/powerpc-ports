diff --git a/uppsrc/Core/String.h b/uppsrc/Core/String.h
index 6694a62..d7cc45a 100644
--- a/uppsrc/Core/String.h
+++ b/uppsrc/Core/String.h
@@ -298,15 +298,14 @@ protected:
 public:
 	bool LEq(const String0& s) const;
 	bool IsEqual(const String0& s) const {
-		// Mask picks out chr[KIND] (byte index 6 within q[1], which aliases chr[8..15]);
-		// built by chr[] index rather than MAKE8B/bit-shifts so it is correct regardless
-		// of CPU endianness.
-		static const uint64 kind_mask = [] {
-			union { uint64 q; char chr[8]; } u;
-			u.q = 0;
-			u.chr[KIND - 8] = (char)255;
-			return u.q;
-		}();
+		// Mask picks out chr[KIND], which is byte index 6 within q[1] (q[1] aliases
+		// chr[8..15]). Compile time constant: this is one of the hottest inline functions,
+		// a function-local static would put a guard check into it.
+#ifdef CPU_LE
+		const uint64 kind_mask = 0x00ff000000000000ull;
+#else
+		const uint64 kind_mask = 0x000000000000ff00ull;
+#endif
 		uint64 q1 = q[1];
 		uint64 sq1 = s.q[1];
 		return q1 == sq1 && q[0] == s.q[0] || ((q1 | sq1) & kind_mask) && LEq(s);
