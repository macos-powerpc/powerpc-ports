-			if(ch >= 32 && ch != 127 && ch != ' ' &&
+			// Arrows, Home, End, F-keys, forward delete etc. have 'characters' too, in the
+			// range 0xF700..0xF8FF (NSUpArrowFunctionKey...), and they never go through
