+
+static void CocoMenuRemoveAllItems(NSMenu *menu)
+{ // -[NSMenu removeAllItems] is 10.6+
+	if([menu respondsToSelector:@selector(removeAllItems)])
+		[menu performSelector:@selector(removeAllItems)];
+	else
+		while([menu numberOfItems] > 0)
+			[menu removeItemAtIndex:0];
+}
 
