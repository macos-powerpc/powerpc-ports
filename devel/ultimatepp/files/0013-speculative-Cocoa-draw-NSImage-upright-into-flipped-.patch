From 1c164db984abf1154e6389a6e0823a3a2d4ce54f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 28 Sep 2026 20:32:21 +0000
Subject: [PATCH 13/15] [speculative] Cocoa: draw NSImage upright into flipped
 contexts

-drawInRect: (10.9) honours the flipped state of the graphics context.
Its replacement for older systems, drawInRect:fromRect:operation:
fraction:, does not. Both users draw into an ImageDraw, whose CTM is
flipped, through a context created with flipped:YES, so file icons
(GetIconForFile) and the information / exclamation icons of Prompt
dialogs should come out upside down.

Flip a copy of the image with -setFlipped: before drawing. It is
deprecated in 10.6 but present in 10.5 and 10.6.

Speculative because I have not seen the result: if the icons are
upright without this patch, they will be upside down with it.

To test: open FileSel (file icons), PromptOK and Exclamation.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 uppsrc/CtrlCore/CocoImage.mm | 7 ++++++-
 uppsrc/CtrlLib/ChCocoMM.mm   | 7 ++++++-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/uppsrc/CtrlCore/CocoImage.mm b/uppsrc/CtrlCore/CocoImage.mm
index 06caaad..dcf77ea 100644
--- a/uppsrc/CtrlCore/CocoImage.mm
+++ b/uppsrc/CtrlCore/CocoImage.mm
@@ -420,7 +420,12 @@ Image GetIconForFile(const char *path)
 #ifdef MAC_OS_X_VERSION_10_9
     [image drawInRect:NSMakeRect(0, 0, DPI(16), DPI(16))];
 #else
-    // macOS 10.6-10.8: drawInRect: without extra params not available
+    // macOS 10.6-10.8: drawInRect: without extra params not available.
+    // Unlike it, drawInRect:fromRect:operation:fraction: ignores that the context is
+    // flipped and would draw the image upside down. Flip a copy of the image (the one
+    // obtained from NSWorkspace can be shared).
+    image = [[image copy] autorelease];
+    [image setFlipped:YES];
     [image drawInRect:NSMakeRect(0, 0, DPI(16), DPI(16)) fromRect:NSZeroRect operation:NSCompositeSourceOver fraction:1.0];
 #endif
 	[NSGraphicsContext setCurrentContext:cgc];
diff --git a/uppsrc/CtrlLib/ChCocoMM.mm b/uppsrc/CtrlLib/ChCocoMM.mm
index 4062f64..783a1fc 100644
--- a/uppsrc/CtrlLib/ChCocoMM.mm
+++ b/uppsrc/CtrlLib/ChCocoMM.mm
@@ -74,7 +74,12 @@ static void DoPaintChInternal(CGContextRef cg, int type, int value, int state)
 		NSGraphicsContext *gc = [NSGraphicsContext graphicsContextWithGraphicsPort:cg flipped:YES];
 		NSGraphicsContext *cgc = [NSGraphicsContext currentContext];
 		[NSGraphicsContext setCurrentContext:gc];
-		// drawInRect: without fromRect:operation:fraction: not available until 10.9
+		// drawInRect: without fromRect:operation:fraction: not available until 10.9.
+		// Unlike it, drawInRect:fromRect:operation:fraction: ignores that the context is
+		// flipped and would draw the image upside down. Flip a copy of the image (named
+		// images are shared).
+		img = [[img copy] autorelease];
+		[img setFlipped:YES];
 		[img drawInRect:NSMakeRect(0, 0, 48, 48) fromRect:NSZeroRect operation:NSCompositeSourceOver fraction:1.0];
 		[NSGraphicsContext setCurrentContext:cgc];
 #endif
