From 4658543112dd063014743749b12ed3bede231770 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 28 Sep 2026 20:33:16 +0000
Subject: [PATCH 14/15] [speculative] Cocoa: make CocoWindow a subclass of
 NSWindow again

canBecomeKeyWindow and canBecomeMainWindow were replaced on NSWindow
itself with method_setImplementation(), because subclassing NSWindow
"causes crashes with GCC's ObjC runtime". That changes the methods for
every window of the process, those of AppKit included (open and save
panels, sheets).

The subclass of upstream had C++ instance variables (Ptr<Ctrl>), which
is the likely reason for the crashes. The state is in the link table
now, so CocoWindow can be a plain subclass without any instance
variables, like CocoView, which is an NSView subclass without instance
variables and works.

Speculative because the cause of the original crashes is not known. If
windows crash or do not open with this patch, drop it.

To test: open and close windows and dialogs, a modal dialog over a
window (the window under it must not get activated by a click), popups,
the native file selector.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 uppsrc/CtrlCore/CocoMM.h   |   9 ++--
 uppsrc/CtrlCore/CocoWin.mm | 100 ++++++++++++-------------------------
 2 files changed, 35 insertions(+), 74 deletions(-)

diff --git a/uppsrc/CtrlCore/CocoMM.h b/uppsrc/CtrlCore/CocoMM.h
index 5799a53..1bdf185 100644
--- a/uppsrc/CtrlCore/CocoMM.h
+++ b/uppsrc/CtrlCore/CocoMM.h
@@ -194,15 +194,12 @@ NSRect DesktopRect(const Upp::Rect& r);
 
 }
 
-// class_getInstanceMethod etc. for method swizzling in CocoWin.mm
-#import <objc/runtime.h>
-
 @interface CocoView : NSView <NSWindowDelegate, NSTextInputClient>
 @end
 
-// Use NSWindow directly - GCC ObjC runtime has issues with subclassing
-// canBecomeKeyWindow/canBecomeMainWindow are handled via method swizzling in CocoWin.mm
-typedef NSWindow CocoWindow;
+// Overrides canBecomeKeyWindow/canBecomeMainWindow. No instance variables, see CocoWin.mm
+@interface CocoWindow : NSWindow
+@end
 
 // Links between CocoView / CocoWindow and Ctrl; they stand in for the instance variables
 // of upstream classes. They are kept in a table in CocoWin.mm which stores Ptr<Ctrl>, so,
diff --git a/uppsrc/CtrlCore/CocoWin.mm b/uppsrc/CtrlCore/CocoWin.mm
index d014a1a..0755e09 100644
--- a/uppsrc/CtrlCore/CocoWin.mm
+++ b/uppsrc/CtrlCore/CocoWin.mm
@@ -4,75 +4,42 @@
 
 #define LLOG(x)
 
-// Method swizzling for NSWindow to override canBecomeKeyWindow/canBecomeMainWindow
-// This avoids subclassing NSWindow which causes crashes with GCC's ObjC runtime
+// CocoWindow has no instance variables, its Ctrl and 'active' flag are in the link table
+// (see CocoWindowGetCtrl below), so there is nothing for the compiler to lay out after the
+// ivars of NSWindow or to construct.
 
-static IMP sOriginalCanBecomeKeyWindow = NULL;
-static IMP sOriginalCanBecomeMainWindow = NULL;
+@implementation CocoWindow
 
-// Replacement for canBecomeKeyWindow - checks if our Ctrl is enabled
+// Checks if our Ctrl is enabled
 // Note: The 'active' flag is only used for popup menus/tooltips that should never become key
 // Dialogs (TopWindow) should always be able to become key if enabled
-static BOOL Swizzled_canBecomeKeyWindow(id self, SEL _cmd)
-{
-	Upp::Ctrl *ctrl = CocoWindowGetCtrl((CocoWindow*)self);
-	// If this is our window, use our logic
-	if(ctrl) {
-		Upp::GuiLock __;
-		// Check if it's a TopWindow (dialog) - these should always be able to become key if enabled
-		// PopUp windows (menus, tooltips) have active=false and should not become key
-		bool active = CocoWindowGetActive((CocoWindow*)self);
-		Upp::TopWindow *tw = dynamic_cast<Upp::TopWindow*>(ctrl);
-		bool isTopWindow = (tw != NULL);
-		BOOL result = (active || isTopWindow) && ctrl->IsEnabled();
-		return result;
-	}
-	// Otherwise call original
-	if(sOriginalCanBecomeKeyWindow)
-		return ((BOOL(*)(id, SEL))sOriginalCanBecomeKeyWindow)(self, _cmd);
-	return YES; // NSWindow default
-}
-
-// Replacement for canBecomeMainWindow - checks if TopWindow without owner
-static BOOL Swizzled_canBecomeMainWindow(id self, SEL _cmd)
-{
-	Upp::Ctrl *ctrl = CocoWindowGetCtrl((CocoWindow*)self);
-	// If this is our window, use our logic
-	if(ctrl) {
-		Upp::GuiLock __;
-		// Main window must be a TopWindow, enabled, and without owner
-		// The 'active' flag is not relevant for main window status
-		Upp::TopWindow *tw = dynamic_cast<Upp::TopWindow *>(ctrl);
-		return tw && ctrl->IsEnabled() && !ctrl->GetOwner();
-	}
-	// Otherwise call original
-	if(sOriginalCanBecomeMainWindow)
-		return ((BOOL(*)(id, SEL))sOriginalCanBecomeMainWindow)(self, _cmd);
-	return YES; // NSWindow default
-}
-
-static void SwizzleNSWindowMethods()
-{
-	static bool swizzled = false;
-	if(swizzled) return;
-	swizzled = true;
-
-	Class windowClass = [NSWindow class];
-
-	// Swizzle canBecomeKeyWindow
-	Method origKey = class_getInstanceMethod(windowClass, @selector(canBecomeKeyWindow));
-	if(origKey) {
-		sOriginalCanBecomeKeyWindow = method_getImplementation(origKey);
-		method_setImplementation(origKey, (IMP)Swizzled_canBecomeKeyWindow);
-	}
-
-	// Swizzle canBecomeMainWindow
-	Method origMain = class_getInstanceMethod(windowClass, @selector(canBecomeMainWindow));
-	if(origMain) {
-		sOriginalCanBecomeMainWindow = method_getImplementation(origMain);
-		method_setImplementation(origMain, (IMP)Swizzled_canBecomeMainWindow);
-	}
-}
+- (BOOL)canBecomeKeyWindow {
+	Upp::Ctrl *ctrl = CocoWindowGetCtrl(self);
+	if(!ctrl) // not linked yet or not anymore
+		return [super canBecomeKeyWindow];
+	Upp::GuiLock __;
+	// Check if it's a TopWindow (dialog) - these should always be able to become key if enabled
+	// PopUp windows (menus, tooltips) have active=false and should not become key
+	bool active = CocoWindowGetActive(self);
+	Upp::TopWindow *tw = dynamic_cast<Upp::TopWindow*>(ctrl);
+	bool isTopWindow = (tw != NULL);
+	BOOL result = (active || isTopWindow) && ctrl->IsEnabled();
+	return result;
+}
+
+// Checks if TopWindow without owner
+- (BOOL)canBecomeMainWindow {
+	Upp::Ctrl *ctrl = CocoWindowGetCtrl(self);
+	if(!ctrl) // not linked yet or not anymore
+		return [super canBecomeMainWindow];
+	Upp::GuiLock __;
+	// Main window must be a TopWindow, enabled, and without owner
+	// The 'active' flag is not relevant for main window status
+	Upp::TopWindow *tw = dynamic_cast<Upp::TopWindow *>(ctrl);
+	return tw && ctrl->IsEnabled() && !ctrl->GetOwner();
+}
+
+@end
 
 namespace Upp {
 
@@ -241,9 +208,6 @@ void Ctrl::Create(Ctrl *owner, dword style, bool active)
 {
 	cancel_preedit = DoCancelPreedit; // We really need this just once, but whatever..
 
-	// Swizzle NSWindow methods for canBecomeKeyWindow/canBecomeMainWindow (GCC compatibility)
-	SwizzleNSWindowMethods();
-	
 	if(owner)
 		owner = owner->GetTopCtrl();
 
