From 5eede53b7d31ab1259b18e8f1694268e6cbbc775 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 28 Sep 2026 21:21:03 +0000
Subject: [PATCH 09/15] umk: say why a process could not be started, raise the
 limit of open files

On Mac OS X 10.6 the first build of a big package set fails: after some
120 compiler runs umk cannot start the next one, the build stops with
"There were errors" and nothing else, and a rerun, which needs fewer
processes, completes. LocalProcess::Start returns false without a
reason (pipe or fork failed), and Console::Run drops it silently.

- Console::Run prints the command and strerror(errno) when the process
  cannot be started.
- umk raises its limit of open files to 4096 on start (the default is
  256 in MacOS). Descriptor exhaustion is the suspected cause, it is not
  confirmed; should the build still fail, the message will tell.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 uppsrc/umk/Console.cpp | 10 ++++++++--
 uppsrc/umk/umake.cpp   | 12 ++++++++++++
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/uppsrc/umk/Console.cpp b/uppsrc/umk/Console.cpp
index 23c6b67..6ed5aea 100644
--- a/uppsrc/umk/Console.cpp
+++ b/uppsrc/umk/Console.cpp
@@ -115,8 +115,14 @@ bool Console::Run(const char *cmdline, Stream *out, const char *envptr, bool qui
 	try {
 		Wait(slot);
 		One<AProcess> sproc;
-		return sproc.Create<LocalProcess>().Start(cmdline, envptr) &&
-		       Run(pick(sproc), cmdline, out, quiet, slot, key, blitz_count);
+		if(sproc.Create<LocalProcess>().Start(cmdline, envptr))
+			return Run(pick(sproc), cmdline, out, quiet, slot, key, blitz_count);
+	#ifdef PLATFORM_POSIX
+		// LocalProcess does not tell why; errno is still that of the failed pipe, fork or stat
+		String err = strerror(errno);
+		FlushConsole();
+		Append(String() << "Failed to start a process (" << err << "): " << cmdline << "\n");
+	#endif
 	}
 	catch(Exc e) {
 		Append(e);
diff --git a/uppsrc/umk/umake.cpp b/uppsrc/umk/umake.cpp
index 8025285..5a58ba5 100644
--- a/uppsrc/umk/umake.cpp
+++ b/uppsrc/umk/umake.cpp
@@ -4,6 +4,10 @@
 #include <build_info.h>
 #endif
 
+#ifdef PLATFORM_POSIX
+#include <sys/resource.h>
+#endif
+
 bool SilentMode;
 
 String GetUmkFile(const char *fn)
@@ -95,6 +99,14 @@ CONSOLE_APP_MAIN
 
 #ifdef PLATFORM_POSIX
 	setlinebuf(stdout);
+	{ // The default limit of open files is 256 in MacOS; a build starts hundreds of processes
+		struct rlimit rl;
+		const rlim_t wanted = 4096;
+		if(getrlimit(RLIMIT_NOFILE, &rl) == 0 && rl.rlim_cur < wanted) {
+			rl.rlim_cur = rl.rlim_max < wanted ? rl.rlim_max : wanted;
+			setrlimit(RLIMIT_NOFILE, &rl);
+		}
+	}
 	CreateBuildMethods();
 #endif
 
