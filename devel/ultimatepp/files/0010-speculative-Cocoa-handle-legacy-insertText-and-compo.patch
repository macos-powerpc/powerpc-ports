From 8b321e88a4635217c41571af3bf65cedf0027486 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 28 Sep 2026 20:29:59 +0000
Subject: [PATCH 10/15] [speculative] Cocoa: handle legacy insertText: and
 composition in key input

Untested guess at why interpretKeyEvents: does not deliver plain
characters on native 10.6 PowerPC: CocoView implements only
insertText:replacementRange: of NSTextInputClient. The text input
system that predates NSTextInputContext calls -insertText: of
NSResponder instead, which CocoView does not override, so the text goes
up the responder chain and is dropped. Add the override.

If this is the cause, the manual dispatch in keyDown: becomes a pure
safety net, and dead keys start working.

Also set coco_text_inserted in setMarkedText:..., so that a key that
went into a composition (dead key, input method) is not dispatched by
keyDown: as a plain character as well.

To test: type text, a dead key sequence (Option-e, e), arrows, Return,
Backspace. Nothing should be doubled or lost.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 uppsrc/CtrlCore/CocoProc.mm | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/uppsrc/CtrlCore/CocoProc.mm b/uppsrc/CtrlCore/CocoProc.mm
index cbe1393..e886085 100644
--- a/uppsrc/CtrlCore/CocoProc.mm
+++ b/uppsrc/CtrlCore/CocoProc.mm
@@ -18,6 +18,7 @@ static Upp::Ptr<Upp::Ctrl> coco_capture;
 // plain characters through insertText: (e.g. native 10.6 PowerPC), this stays false and
 // keyDown: dispatches the character itself. Only meaningful on the main thread within
 // a single keyDown: call.
+// It is also set by setMarkedText:, the key went into the composition (dead key, IME).
 static bool       coco_text_inserted;
 
 Upp::Ptr<Upp::Ctrl> Upp::Ctrl::lastActive;
@@ -616,6 +617,15 @@ struct MMImp {
 		Upp::MMImp::PreeditText(CocoViewGetCtrl(self), Upp::ToWString(pInsert));
 }
 
+// The text input system that predates NSTextInputContext (10.5, and possibly native PowerPC
+// builds of 10.6) delivers text through this NSResponder method, not through
+// insertText:replacementRange: of NSTextInputClient. Without it, NSResponder passes the text
+// up the responder chain, where it is dropped.
+- (void)insertText:(id)aString
+{
+	[self insertText:aString replacementRange:NSMakeRange(NSNotFound, 0)];
+}
+
 - (NSRange)markedRange
 {
 	return NSMakeRange( NSNotFound, 0 );
@@ -638,6 +648,7 @@ struct MMImp {
     if(![aString isKindOfClass:[NSAttributedString class]] )
         aString = [[[NSAttributedString alloc] initWithString:aString] autorelease];
 
+	coco_text_inserted = true; // key is a part of composition, keyDown: must not dispatch it
 	Upp::MMImp::ShowPreedit(CocoViewGetCtrl(self), Upp::ToWString([aString string]));
 }
 
