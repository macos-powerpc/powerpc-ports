From 4ac8b678b160798ad6a1b6a2c6ce11fecade51d3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 28 Sep 2026 21:20:24 +0000
Subject: [PATCH 08/15] Core: do not take the process serial number for a
 command line option

Up to Mac OS X 10.8, an application launched by Finder or 'open' is
passed its process serial number as an argument, e.g. -psn_0_123456.
AppInit__ put it into CommandLine() like any other argument.

An application that checks its options then fails when started as an
application bundle, while it works when the same binary is started
from a terminal. Bobcat does exactly that: "Unknown option", help text
to stdout, Exit().

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 uppsrc/Core/App.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/uppsrc/Core/App.cpp b/uppsrc/Core/App.cpp
index 5e99ca7..06524dd 100644
--- a/uppsrc/Core/App.cpp
+++ b/uppsrc/Core/App.cpp
@@ -546,6 +546,11 @@ void AppInit__(int argc, const char **argv, const char **envptr)
 	}
 	Vector<WString>& cmd = coreCmdLine__();
 	for(int i = 1; i < argc; i++)
+	#ifdef PLATFORM_OSX
+		// Up to Mac OS X 10.8, an application started by Finder or 'open' gets its process
+		// serial number as an argument (-psn_0_123456). It is not a command line option.
+		if(strncmp(argv[i], "-psn_", 5))
+	#endif
 		cmd.Add(FromSystemCharset(argv[i]).ToWString());
 	CommonInit();
 	signal(SIGILL, s_ill_handler);
