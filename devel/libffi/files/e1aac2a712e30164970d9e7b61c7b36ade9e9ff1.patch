From e1aac2a712e30164970d9e7b61c7b36ade9e9ff1 Mon Sep 17 00:00:00 2001
From: Mohamed Akram <mohd.akram@outlook.com>
Date: Tue, 27 Oct 2026 19:13:52 +0400
Subject: [PATCH] x86-64: fix build with missing CFI

---
 src/x86/unix64.S | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/src/x86/unix64.S b/src/x86/unix64.S
index 61983ef3b..6520f815c 100644
--- src/x86/unix64.S
+++ src/x86/unix64.S
@@ -31,6 +31,7 @@
 #define LIBFFI_ASM	
 #include <fficonfig.h>
 #include <ffi.h>
+#include <ffi_cfi.h>
 #include "internal64.h"
 #include "asmnames.h"
 
@@ -256,7 +257,7 @@ ENDF(C(ffi_call_unix64))
 	.globl	C(ffi_plan_fast_call)
 	FFI_HIDDEN(C(ffi_plan_fast_call))
 C(ffi_plan_fast_call):
-	.cfi_startproc
+	cfi_startproc
 	_CET_ENDBR
 	movq	%rsi, %r11		/* fn */
 	movq	%rdi, %rax		/* img */
@@ -280,12 +281,12 @@ C(ffi_plan_fast_call):
 	movq	0x28(%rax), %r9
 	movl	%r10d, %eax		/* %al = ssecount */
 	subq	$8, %rsp		/* realign to 16 across the call */
-	.cfi_adjust_cfa_offset 8
+	cfi_adjust_cfa_offset(8)
 	call	*%r11
 	addq	$8, %rsp
-	.cfi_adjust_cfa_offset -8
+	cfi_adjust_cfa_offset(-8)
 	ret				/* rax + xmm0 carry the callee's return */
-	.cfi_endproc
+	cfi_endproc
 	ENDF(C(ffi_plan_fast_call))
 
 /* Count-based direct thunks for the pure-GP64 fast path: load avalue[0..N-1]
@@ -297,7 +298,7 @@ C(ffi_plan_fast_call):
    rax/xmm0 flow out as the {UINT64,double} return; C stores per return code.  */
 
 #define FFI_GP_HEAD				\
-	.cfi_startproc;				\
+	cfi_startproc;				\
 	_CET_ENDBR;				\
 	movq	%rsi, %r11;			\
 	movq	%rdi, %rax
@@ -307,12 +308,12 @@ C(ffi_plan_fast_call):
 #define FFI_GP_TAIL				\
 	xorl	%eax, %eax;			\
 	subq	$8, %rsp;			\
-	.cfi_adjust_cfa_offset 8;		\
+	cfi_adjust_cfa_offset(8);		\
 	call	*%r11;				\
 	addq	$8, %rsp;			\
-	.cfi_adjust_cfa_offset -8;		\
+	cfi_adjust_cfa_offset(-8);		\
 	ret;					\
-	.cfi_endproc
+	cfi_endproc
 
 	.balign	8
 	.globl	C(ffi_plan_gp0)
