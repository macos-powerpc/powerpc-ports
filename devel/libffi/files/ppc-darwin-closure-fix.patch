diff --git a/src/powerpc/ffi_darwin.c b/src/powerpc/ffi_darwin.c
index 01e2a437..a58dc8c1 100644
--- src/powerpc/ffi_darwin.c
+++ src/powerpc/ffi_darwin.c
@@ -60,11 +60,13 @@ struct ffi_aix_trampoline_struct {
 # define PPC_LD_S32		PPC_LD_R3
 # define PPC_LD_PTR		PPC_LD_R3
 # define PPC_LD_I64		PPC_LD_R3R4
+# define PPC_LD_STRUCT		10
 #else
 # define PPC_LD_U32		10
 # define PPC_LD_S32		11
 # define PPC_LD_PTR		PPC_LD_R3
 # define PPC_LD_I64		PPC_LD_R3
+# define PPC_LD_STRUCT		12
 #endif
 
 extern void ffi_closure_ASM (void);
@@ -1260,6 +1262,14 @@ ffi_closure_helper_common (ffi_cif* cif,
   long             i, avn;
   ffi_dblfl *      end_pfr = pfr + NUM_FPR_ARG_REGISTERS;
   unsigned         size_al;
+  int              struct_ret_by_value = 0;
+  /* ffi_closure_ASM's jump-table dispatch only has room for a small
+     integer return code (see PPC_LD_* above), so when the return code
+     is PPC_LD_STRUCT we hand back cif->rtype here, in the first slot of
+     the incoming gpr save area (which is otherwise dead by this point),
+     so the assembly can still special-case small-struct-by-value
+     returns the way it always has.  */
+  unsigned long *  pgr0 = pgr;
 #if defined(POWERPC_DARWIN64)
   unsigned 	   fpsused = 0;
 #endif
@@ -1275,12 +1285,16 @@ ffi_closure_helper_common (ffi_cif* cif,
 	  rvalue = (void *) *pgr;
 	  pgr++;
 	}
+      else
+	struct_ret_by_value = 1;
 #elif defined(DARWIN_PPC)
       if (cif->rtype->size > 4)
 	{
 	  rvalue = (void *) *pgr;
 	  pgr++;
 	}
+      else
+	struct_ret_by_value = 1;
 #else /* assume we return by ref.  */
       rvalue = (void *) *pgr;
       pgr++;
@@ -1480,7 +1494,13 @@ ffi_closure_helper_common (ffi_cif* cif,
   switch (cif->rtype->type)
     {
     case FFI_TYPE_VOID:
+      return PPC_LD_NONE;
     case FFI_TYPE_STRUCT:
+      if (struct_ret_by_value)
+	{
+	  *pgr0 = (unsigned long) cif->rtype;
+	  return PPC_LD_STRUCT;
+	}
       return PPC_LD_NONE;
     case FFI_TYPE_FLOAT:
       return PPC_LD_F32;
