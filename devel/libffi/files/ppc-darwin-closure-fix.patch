-	b	Lfinish
-#endif
 	nop
-
-/* case FFI_TYPE_SINT64  */
-Lret_type12:
-#if defined(__ppc64__)
+#else
 	lg	r3,0(r5)
 	b	Lfinish
 	nop
-#else
-	lwz	r3,0(r5)
-	lwz	r4,4(r5)
-	b	Lfinish
-#endif
 	nop
+#endif
 
