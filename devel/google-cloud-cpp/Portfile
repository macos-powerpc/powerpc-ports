PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1
PortGroup           openssl 1.0

github.setup        googleapis google-cloud-cpp 3.13.0 v
revision            0
categories          devel
license             BSD
maintainers         nomaintainer
description         C++ Idiomatic Clients for Google Cloud Platform services
long_description    {*}${description}

set googleapis_hash 14a161a98ef045be80c12ab69d924504a756f109
master_sites-append https://github.com/googleapis/googleapis/archive/${googleapis_hash}/:googleapis
distfiles-append    googleapis-${googleapis_hash}${extract.suffix}:googleapis

checksums           ${distname}${extract.suffix} \
                    rmd160  3a2365367ec4dbc48c67427676cb254fbd7d49a9 \
                    sha256  3fefa2ca821ec8dd26f2d5ffc89611e74259c76a459fce3fd3cf46013785e423 \
                    size    19086263 \
                    googleapis-${googleapis_hash}${extract.suffix} \
                    rmd160  90fe69fdb05029b93098bc445ff22c5a844d9a8c \
                    sha256  ce3cee2da77fbdff0e269bc520dc61e8b32efcdec7628b39b9e474a02bc951f6 \
                    size    13598771
github.tarball_from archive

post-extract {
    move ${workpath}/googleapis-${googleapis_hash} ${workpath}/googleapis
}

# https://github.com/freebsd/freebsd-ports/commit/b65191d7b294ccc6a3fd3e1a80902643101be8ba
patchfiles-append   patch-google_cloud_internal_async__read__write__stream__tracing.h \
                    patch-google_cloud_storage_internal_grpc_metrics__exporter__options.cc \
                    patch-google_cloud_opentelemetry_internal_monitored__resource.cc \
                    patch-google_cloud_opentelemetry_internal_recordable.cc \
                    patch-google_cloud_opentelemetry_internal_time__series.cc

# client.cc:30:32: error: call of overloaded 'MergeOptions(std::remove_reference<google::cloud::v3_13::Options&>::type, google::cloud::v3_13::Options&)' is ambiguous
patchfiles-append   patch-bigtable-gcc16-ambiguous-MergeOptions.diff

depends_build-append \
                    port:nlohmann-json \
                    path:bin/pkg-config:pkgconfig
depends_lib-append  port:abseil \
                    port:c-ares \
                    port:curl \
                    port:opentelemetry-cpp \
                    port:protobuf \
                    port:re2

compiler.cxx_standard   2017

configure.args-append   -DBUILD_SHARED_LIBS=ON \
                        -DBUILD_TESTING=OFF \
                        -DGOOGLE_CLOUD_CPP_WITH_MOCKS=OFF \
                        -DGOOGLE_CLOUD_CPP_OVERRIDE_GOOGLEAPIS_URL=${workpath}/googleapis

if {[string match *gcc* ${configure.compiler}] && ${configure.build_arch} in [list arm i386 ppc]} {
    configure.ldflags-append \
                        -latomic
}

variant cxx17 conflicts cxx20 description "Use C++17" {
    configure.args-append   -DCMAKE_CXX_STANDARD=17
}

variant cxx20 conflicts cxx17 description "Use C++20" {
    compiler.cxx_standard   2020
    configure.args-append   -DCMAKE_CXX_STANDARD=20
}

if ![variant_isset cxx17] {
    default_variants-append +cxx20
}
