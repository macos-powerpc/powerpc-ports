# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           openssl 1.0
PortGroup           legacysupport 1.1

if {${os.platform} eq "darwin" && ${configure.cxx_stdlib} eq "libc++"} {
    # filesystem
    legacysupport.newest_darwin_requires_legacy 16
    legacysupport.use_mp_libcxx yes
} else {
    legacysupport.newest_darwin_requires_legacy 8
}

github.setup        libcpr cpr 1.15.1
revision            0
categories          devel net
license             MIT
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer
description         C++ Requests: Curl for People
long_description    C++ Requests is a simple wrapper around libcurl.
homepage            https://docs.libcpr.org
checksums           rmd160  1e51b28ac13900659b564656ca9b13f790194338 \
                    sha256  c2fc62a030c4ca5d7c3517e8068531297f938bf4ab52bf951d4fc9bbc9222716 \
                    size    181812
github.tarball_from archive

depends_lib-append  port:curl

compiler.cxx_standard   2017

configure.args-append \
                    -DBUILD_SHARED_LIBS=ON \
                    -DCPR_BUILD_TESTS=OFF \
                    -DCPR_ENABLE_CPPCHECK=OFF \
                    -DCPR_ENABLE_LINTING=OFF \
                    -DCPR_ENABLE_SSL=ON \
                    -DCPR_FORCE_OPENSSL_BACKEND=ON \
                    -DCPR_GENERATE_COVERAGE=OFF \
                    -DCPR_USE_BOOST_FILESYSTEM=OFF \
                    -DCPR_USE_SYSTEM_CURL=ON

# https://github.com/libcpr/cpr/issues/1238
configure.cxxflags-append \
                    -Wno-error=deprecated-declarations

configure.pre_args-replace \
                    -DCMAKE_BUILD_WITH_INSTALL_RPATH:BOOL=ON \
                    -DCMAKE_BUILD_WITH_INSTALL_RPATH:BOOL=OFF

# FIXME: some test cases fail on powerpc:
# https://github.com/libcpr/cpr/issues/1088
variant tests description "Enable testing" {
    # clock_gettime in bundled mongoose
    legacysupport.newest_darwin_requires_legacy 16

    depends_build-append \
                    port:gtest

    configure.args-append \
                    -DCPR_USE_SYSTEM_GTEST=ON
    configure.args-replace \
                    -DCPR_BUILD_TESTS=OFF -DCPR_BUILD_TESTS=ON

    test.run        yes
}
