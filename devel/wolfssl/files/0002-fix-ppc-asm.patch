From 0bcef3ea1c2b6d50a9a76dbb768f4492534121c8 Mon Sep 17 00:00:00 2001
From: Sean Parkinson <sean@wolfssl.com>
Date: Tue, 24 Nov 2026 12:28:43 +1000
Subject: [PATCH] PPC32 ASM: fix PIC and Darwin builds

- configure: only pass -Wa,-mregnames for inline-reg when the
  assembler accepts it. Apple's as rejects it and takes rN names
  natively.
- Regenerate the PPC32 AES and SHA-512 asm so the inline forms no
  longer use r30/r31. GCC uses one of them as the PIC register (r30
  on Linux, r31 on Darwin), so shared and Darwin builds failed with
  "PIC register clobbered".
---
 configure.ac                                  |   12 +-
 wolfcrypt/src/port/ppc32/ppc32-aes-asm.S      | 1342 ++++++++---------
 wolfcrypt/src/port/ppc32/ppc32-aes-asm_c.c    | 1319 ++++++++--------
 wolfcrypt/src/port/ppc32/ppc32-aes-asm_cr.c   | 1316 ++++++++--------
 wolfcrypt/src/port/ppc32/ppc32-sha512-asm.S   |  346 +++--
 wolfcrypt/src/port/ppc32/ppc32-sha512-asm_c.c |  336 ++---
 .../src/port/ppc32/ppc32-sha512-asm_cr.c      |  336 ++---
 7 files changed, 2503 insertions(+), 2504 deletions(-)

diff --git a/configure.ac b/configure.ac
index 82c8a403317..4dcc4c5eca4 100644
--- a/configure.ac
+++ b/configure.ac
@@ -5204,9 +5204,15 @@ then
         AM_CCASFLAGS="$AM_CCASFLAGS -DWOLFSSL_PPC32_ASM"
     fi
     if test "$ENABLED_PPC32_ASM_INLINE_REG" = "yes"; then
-        # The inline-register variant names GPRs (r0..r31) in inline assembly,
-        # which the PowerPC assembler only accepts with -mregnames.
-        AM_CFLAGS="$AM_CFLAGS -DWOLFSSL_PPC32_ASM_INLINE_REG -Wa,-mregnames"
+        # The inline-register variant names GPRs (r0..r31) in inline assembly.
+        # GNU as only accepts those names with -mregnames; other assemblers
+        # (e.g. Apple's cctools as on Darwin) accept them natively and reject
+        # the option, so only pass it when the toolchain takes it.
+        AM_CFLAGS="$AM_CFLAGS -DWOLFSSL_PPC32_ASM_INLINE_REG"
+        AX_CHECK_COMPILE_FLAG([-Wa,-mregnames],
+            [AM_CFLAGS="$AM_CFLAGS -Wa,-mregnames"],
+            [],
+            [-Werror],[])
     fi
     if test "$ENABLED_PPC32_ASM_SMALL" = "yes"; then
         AM_CFLAGS="$AM_CFLAGS -DWOLFSSL_PPC32_ASM_SMALL"
