From 47cfe7162dd5745bce1a922c0cda41bc6a1c76a8 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Sat, 7 Nov 2026 13:27:09 +0800
Subject: [PATCH 5/5] macros.h: do not use pragmas inside functions with gcc <
 4.6

Signed-off-by: Sergey Fedorov <vital.had@gmail.com>
---
 include/openssl/macros.h | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/include/openssl/macros.h b/include/openssl/macros.h
index 2f69687e77..6f4c055dae 100644
--- a/include/openssl/macros.h
+++ b/include/openssl/macros.h
@@ -64,10 +64,15 @@
 #define OSSL_DEPRECATED_FOR(since, message) __attribute__((deprecated))
 #define OSSL_DEPRECATED_MESSAGE(message) __attribute__((deprecated))
 #endif
+#if __GNUC__ > 4 || (__GNUC__ == 4 && __GNUC_MINOR__ >= 6)
 #define OSSL_BEGIN_ALLOW_DEPRECATED \
     _Pragma("GCC diagnostic push")  \
         _Pragma("GCC diagnostic ignored \"-Wdeprecated-declarations\"")
 #define OSSL_END_ALLOW_DEPRECATED _Pragma("GCC diagnostic pop")
+#else
+#define OSSL_BEGIN_ALLOW_DEPRECATED
+#define OSSL_END_ALLOW_DEPRECATED
+#endif
 #elif defined(__SUNPRO_C)
 #if (__SUNPRO_C >= 0x5130)
 #define OSSL_DEPRECATED(since) __attribute__((deprecated))
-- 
2.56.0

