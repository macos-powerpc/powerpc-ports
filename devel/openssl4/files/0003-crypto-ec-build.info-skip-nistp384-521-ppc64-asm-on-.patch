From fd475331f860f392013bc7a9146b2116ee5cbd7c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 4 Nov 2026 03:33:02 +0000
Subject: [PATCH 3/4] crypto/ec/build.info: skip nistp384/521 ppc64 asm on
 MACOSX

ecp_nistp384-ppc64.pl and ecp_nistp521-ppc64.pl emit POWER9 VSX instructions
(lxv, stxv, lxsd, mtvsrdd, xxpermdi), which Apple's cctools assembler does not know,
so a darwin64-ppc build with enable-ec_nistp_64_gcc_128 fails to assemble.
Keep the C implementation for those two curves on MACOSX, matching how the other
POWER8+ modules are excluded.

Signed-off-by: Sergey Fedorov <vital.had@gmail.com>
---
 crypto/ec/build.info | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crypto/ec/build.info b/crypto/ec/build.info
index 6fe0a31932..09cc055e8d 100644
--- a/crypto/ec/build.info
+++ b/crypto/ec/build.info
@@ -45,7 +45,7 @@ IF[{- !$disabled{asm} -}]
   $ECASM_ppc32=
   $ECASM_ppc64=ecp_nistz256.c ecp_ppc.c ecp_nistz256-ppc64.s
   $ECDEF_ppc64=ECP_NISTZ256_ASM
-  IF[{- !$disabled{'ec_nistp_64_gcc_128'} -}]
+  IF[{- !$disabled{'ec_nistp_64_gcc_128'} && $target{sys_id} ne "MACOSX" -}]
     $ECASM_ppc64=$ECASM_ppc64 ecp_nistp384-ppc64.s ecp_nistp521-ppc64.s
     $ECDEF_ppc64=$ECDEF_ppc64 ECP_NISTP384_ASM ECP_NISTP521_ASM
     INCLUDE[ecp_nistp384.o]=..
