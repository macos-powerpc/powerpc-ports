From 66bdf7a598554e1aa282deafdc8a75725586d3f9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 11 Nov 2026 13:45:16 +0000
Subject: [PATCH 2/2] test_includes: use an absolute DYLD_LIBRARY_PATH on
 Darwin

conf_include_test changes into its data directory with chdir() before
it loads the provider config. shlib_wrap.sh sets DYLD_LIBRARY_PATH
relative to the starting directory, so after the chdir() dyld can no
longer use it to find libcrypto for the legacy module. On Mac OS X 10.6
the legacy provider fails to activate in this test ("Legacy provider
is missing"), while it loads fine in every other test that uses it.

Apply the workaround this recipe already uses for LIBPATH on AIX.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 test/recipes/90-test_includes.t | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/test/recipes/90-test_includes.t b/test/recipes/90-test_includes.t
index 412bdf6..edff00d 100644
--- a/test/recipes/90-test_includes.t
+++ b/test/recipes/90-test_includes.t
@@ -35,9 +35,12 @@ ok(run(test(["conf_include_test",  "-f", data_file("incdir.cnf")])), "test inclu
 SKIP: {
     skip "Skipping legacy test", 1
         if disabled("legacy");
-    # Ensure libcrypto can be resolved for the legacy provider on AIX.
+    # Ensure libcrypto can be resolved for the legacy provider on AIX
+    # and Darwin.
     local $ENV{LIBPATH} = abs_path(bldtop_dir("."))
         if config('target') =~ m|^aix|;
+    local $ENV{DYLD_LIBRARY_PATH} = abs_path(bldtop_dir("."))
+        if config('target') =~ m|^darwin|;
     ok(run(test(["conf_include_test", "-providers", data_file("includes-prov-dir.cnf")])),
        "test directory includes with provider configs");
 }
-- 
