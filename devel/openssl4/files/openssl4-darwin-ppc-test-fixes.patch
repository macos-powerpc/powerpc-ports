From 89bd332709f8dcf4a583336752ab7a265c924910 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 11 Nov 2026 13:45:16 +0000
Subject: [PATCH 1/2] test: accept any address form when parsing the s_server
 ACCEPT line

On Mac OS X 10.6, s_server reports its dual-stack listener as
"ACCEPT [::ffff:0.0.0.0]:PORT" instead of "ACCEPT [::]:PORT". The
recipes that read the port from this line only matched "0.0.0.0:" or
"[::]:", so the port stayed 0. The non-greedy pattern in
test_app_s_client_msg instead took the "0" of "0.0.0.0" as the port.
In both cases s_client connected to port 0 and the handshake subtests
failed with EADDRNOTAVAIL.

Use one greedy pattern that takes the digits after the last colon of
the address.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 test/recipes/20-test_app_s_client_msg.t  |  2 +-
 test/recipes/70-test_sslkeylogfile.t     |  5 +----
 test/recipes/82-test_ech_client_server.t |  5 +----
 test/recipes/82-test_ocsp_cert_chain.t   | 10 ++--------
 4 files changed, 5 insertions(+), 17 deletions(-)

diff --git a/test/recipes/20-test_app_s_client_msg.t b/test/recipes/20-test_app_s_client_msg.t
index 7feebc0..a1d56b0 100644
--- a/test/recipes/20-test_app_s_client_msg.t
+++ b/test/recipes/20-test_app_s_client_msg.t
@@ -63,7 +63,7 @@ sub run_case
         while (<$s_server_o>) {
             print($_);
             chomp;
-            if (/^ACCEPT \S+?:(\d+)/) {
+            if (/^ACCEPT \S+:(\d+)/) {
                 $server_port = $1;
                 last;
             } elsif (/^Using default/) {
diff --git a/test/recipes/70-test_sslkeylogfile.t b/test/recipes/70-test_sslkeylogfile.t
index 2be202f..34e670a 100644
--- a/test/recipes/70-test_sslkeylogfile.t
+++ b/test/recipes/70-test_sslkeylogfile.t
@@ -49,10 +49,7 @@ my $port = "0";
 while (<$s_server_o>) {
     print($_);
     chomp;
-    if (/^ACCEPT 0.0.0.0:(\d+)/) {
-        $port = $1;
-        last;
-    } elsif (/^ACCEPT \[::\]:(\d+)/) {
+    if (/^ACCEPT \S+:(\d+)/) {
         $port = $1;
         last;
     } elsif (/^Using default/) {
diff --git a/test/recipes/82-test_ech_client_server.t b/test/recipes/82-test_ech_client_server.t
index b988d8d..ab4c56f 100644
--- a/test/recipes/82-test_ech_client_server.t
+++ b/test/recipes/82-test_ech_client_server.t
@@ -135,10 +135,7 @@ sub start_ech_client_server
         while (<$s_server_o>) {
             print($_);
             chomp;
-            if (/^ACCEPT 0.0.0.0:(\d+)/) {
-                $s_server_port = $1;
-                last;
-            } elsif (/^ACCEPT \[::\]:(\d+)/) {
+            if (/^ACCEPT \S+:(\d+)/) {
                 $s_server_port = $1;
                 last;
             } elsif (/^Using default/) {
diff --git a/test/recipes/82-test_ocsp_cert_chain.t b/test/recipes/82-test_ocsp_cert_chain.t
index a0c3737..0332f40 100644
--- a/test/recipes/82-test_ocsp_cert_chain.t
+++ b/test/recipes/82-test_ocsp_cert_chain.t
@@ -70,10 +70,7 @@ sub run_test {
     while (<$ocsp_o>) {
         print($_);
         chomp;
-        if (/^ACCEPT 0.0.0.0:(\d+)/) {
-            $port = $1;
-            last;
-        } elsif (/^ACCEPT \[::\]:(\d+)/) {
+        if (/^ACCEPT \S+:(\d+)/) {
             $port = $1;
             last;
         } else {
@@ -99,10 +96,7 @@ sub run_test {
     while (<$s_server_o>) {
         print($_);
         chomp;
-        if (/^ACCEPT 0.0.0.0:(\d+)/) {
-            $port = $1;
-            last;
-        } elsif (/^ACCEPT \[::\]:(\d+)/) {
+        if (/^ACCEPT \S+:(\d+)/) {
             $port = $1;
             last;
         } elsif (/^Using default/) {
