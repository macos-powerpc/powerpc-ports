# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1
PortGroup           openssl 1.0

github.setup        open-telemetry opentelemetry-cpp 1.30.0 v
revision            0
categories          devel
license             Apache-2
maintainers         nomaintainer
description         OpenTelemetry C++ Client
long_description    {*}${description}

# https://github.com/open-telemetry/opentelemetry-cpp/tree/main/third_party
set otel_proto_hash 790608c4d51e6ffc12210b541e8514cbed9e91a4
master_sites-append https://github.com/open-telemetry/opentelemetry-proto/archive/${otel_proto_hash}/:otel_proto
distfiles-append    opentelemetry-proto-${otel_proto_hash}${extract.suffix}:otel_proto

checksums           ${distname}${extract.suffix} \
                    rmd160  d4b1ffca7a36f83235b74f85071185ebc0219526 \
                    sha256  85aae7a42d7b71d17e510ddebc85db622d9078cc6d29cf9fb7373014b063859f \
                    size    1602595 \
                    opentelemetry-proto-${otel_proto_hash}${extract.suffix} \
                    rmd160  2702576fde4237676025e431154864d29782476f \
                    sha256  b8331fd497a17008da3efdc2ccf25da19aa4653b62cfc49cf181f22373573bc8 \
                    size    121425
github.tarball_from archive

post-extract {
    delete -f ${worksrcpath}/third_party/opentelemetry-proto
    move ${workpath}/opentelemetry-proto-${otel_proto_hash} ${workpath}/opentelemetry-proto
}

depends_build-append \
                    port:nlohmann-json \
                    path:bin/pkg-config:pkgconfig

# rapidyaml not used atm: https://github.com/open-telemetry/opentelemetry-cpp/blob/d05c6a8a0cd6ccf249305e188557a2eff1970cc7/CMakeLists.txt#L442
# Keep it nevertheless, as FreeBSD does: https://github.com/freebsd/freebsd-ports/blob/9bfaba65fec1f2715e3b50fcba696adae33bcba6/devel/opentelemetry-cpp/Makefile#L16
depends_lib-append  port:abseil \
                    port:c-ares \
                    port:curl \
                    port:grpc \
                    port:prometheus-cpp \
                    port:protobuf \
                    port:rapidyaml \
                    port:re2

compiler.cxx_standard   2017

configure.args-append   -DBUILD_SHARED_LIBS=ON \
                        -DBUILD_TESTING=OFF \
                        -DOPENTELEMETRY_INSTALL=ON \
                        -DOTELCPP_MAINTAINER_MODE=OFF \
                        -DWITH_BENCHMARK=OFF \
                        -DWITH_CURL_LOGGING=ON \
                        -DWITH_ELASTICSEARCH=OFF \
                        -DWITH_EXAMPLES=OFF \
                        -DWITH_GSL=OFF \
                        -DOTELCPP_PROTO_PATH=${workpath}/opentelemetry-proto \
                        -DWITH_OTLP_GRPC=ON \
                        -DWITH_OTLP_HTTP=ON \
                        -DWITH_PROMETHEUS=ON

# https://github.com/open-telemetry/opentelemetry-cpp/issues/4773
if {[string match *gcc* ${configure.compiler}] && ${configure.build_arch} in [list arm i386 ppc]} {
    configure.ldflags-append \
                        -latomic
}

variant cxx17 conflicts cxx20 description "Use C++17" {
    configure.args-append   -DCMAKE_CXX_STANDARD=17
}

variant cxx20 conflicts cxx17 description "Use C++20" {
    compiler.cxx_standard   2020
    configure.args-append   -DCMAKE_CXX_STANDARD=20
}

if ![variant_isset cxx17] {
    default_variants-append +cxx20
}
