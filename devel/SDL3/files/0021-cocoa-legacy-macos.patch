diff --git src/video/cocoa/SDL_cocoaframebuffer.m src/video/cocoa/SDL_cocoaframebuffer.m
new file mode 100644
index 000000000..518f8c4ef
--- /dev/null
+++ src/video/cocoa/SDL_cocoaframebuffer.m
@@ -0,0 +1,250 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_COCOA
+
+#include "SDL_cocoavideo.h"
+#include "SDL_cocoaframebuffer.h"
+
+#include <pthread.h>
+
+#ifdef MAC_OS_X_VERSION_10_7 /* pre-10.7 SDKs don't expose the CALayer interface via Cocoa.h */
+#import <QuartzCore/QuartzCore.h>
+#endif
+
+/* The pixels are XRGB8888 in host byte order, which is exactly what
+   CoreGraphics reads for kCGImageAlphaNoneSkipFirst | kCGBitmapByteOrder32Host,
+   so the buffer is handed to CGImage without conversion.
+
+   Presentation: views that are layer-backed (macOS 10.8+ with the SDL3View
+   -wantsUpdateLayer path, all views on 10.14+) get the image as the layer
+   contents; classic views are drawn into directly under lockFocusIfCanDraw,
+   the AppKit way that also works from a secondary thread (mpv presents from
+   its VO thread on the legacy builds).  -[NSView drawRect:] only repaints
+   the buffer when AppKit asks (exposes, live resizes), via
+   Cocoa_DrawWindowFramebuffer, and sends no expose event for that: the app
+   has nothing to redraw, the buffer is what it last presented.
+
+   Threads: the presenting thread need not be the main thread (mpv presents
+   from its VO thread while its main thread runs the Cocoa runloop, which
+   delivers -drawRect: repaints).  One lock serializes the image swap and
+   the buffer teardown on the presenting thread against those repaints;
+   the swap never leaves the image pointer NULL, so a repaint always has a
+   complete frame to draw. */
+
+static pthread_mutex_t framebuffer_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* caller holds framebuffer_lock */
+static void Cocoa_FreeFramebufferLocked(SDL_CocoaWindowData *data)
+{
+#ifdef MAC_OS_X_VERSION_10_7
+    if (data.framebuffer_image) {
+        CALayer *layer = [data.sdlContentView layer];
+        if (layer && layer.contents == (__bridge id)data.framebuffer_image) {
+            layer.contents = nil;
+        }
+    }
+#endif
+    if (data.framebuffer_image) {
+        CGImageRelease(data.framebuffer_image);
+        data.framebuffer_image = NULL;
+    }
+    SDL_free(data.framebuffer_pixels);
+    data.framebuffer_pixels = NULL;
+    data.framebuffer_w = 0;
+    data.framebuffer_h = 0;
+    data.framebuffer_pitch = 0;
+}
+
+static CGImageRef Cocoa_CreateFramebufferImage(SDL_CocoaWindowData *data)
+{
+    const size_t size = (size_t)data.framebuffer_h * (size_t)data.framebuffer_pitch;
+    CGDataProviderRef provider;
+    CGColorSpaceRef colorspace;
+    CGImageRef image = NULL;
+
+    /* The provider references the live pixel buffer; no copy is made here,
+       CoreGraphics reads it when the image is drawn / committed. */
+    provider = CGDataProviderCreateWithData(NULL, data.framebuffer_pixels, size, NULL);
+    if (!provider) {
+        return NULL;
+    }
+    colorspace = CGColorSpaceCreateDeviceRGB();
+    if (colorspace) {
+        image = CGImageCreate((size_t)data.framebuffer_w, (size_t)data.framebuffer_h,
+                              8, 32, (size_t)data.framebuffer_pitch, colorspace,
+                              kCGImageAlphaNoneSkipFirst | kCGBitmapByteOrder32Host,
+                              provider, NULL, false, kCGRenderingIntentDefault);
+        CGColorSpaceRelease(colorspace);
+    }
+    CGDataProviderRelease(provider);
+    return image;
+}
+
+bool Cocoa_CreateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window, SDL_PixelFormat *format, void **pixels, int *pitch)
+{
+    SDL_OBJC_POOL {
+        SDL_CocoaWindowData *data = (__bridge SDL_CocoaWindowData *)window->internal;
+        int w, h;
+
+        SDL_GetWindowSizeInPixels(window, &w, &h);
+        if (w < 1 || h < 1) {
+            return SDL_SetError("Window has no pixels to draw into");
+        }
+
+        *format = SDL_PIXELFORMAT_XRGB8888;
+        *pitch = w * 4;
+        *pixels = SDL_calloc((size_t)h, (size_t)*pitch); /* starts out black, like the window */
+        if (!*pixels) {
+            return false;
+        }
+
+        pthread_mutex_lock(&framebuffer_lock);
+        Cocoa_FreeFramebufferLocked(data);
+        data.framebuffer_pixels = *pixels;
+        data.framebuffer_w = w;
+        data.framebuffer_h = h;
+        data.framebuffer_pitch = *pitch;
+        pthread_mutex_unlock(&framebuffer_lock);
+        return true;
+    }
+}
+
+bool Cocoa_UpdateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window, const SDL_Rect *rects, int numrects)
+{
+    SDL_OBJC_POOL {
+        SDL_CocoaWindowData *data = (__bridge SDL_CocoaWindowData *)window->internal;
+        NSView *view = data.sdlContentView;
+        CGImageRef image;
+        CGImageRef previous;
+
+        if (!data.framebuffer_pixels) {
+            return SDL_SetError("Window has no framebuffer");
+        }
+
+        /* A fresh image every time: CoreGraphics may cache what it read from
+           the provider, and the app has just changed the pixels. */
+        image = Cocoa_CreateFramebufferImage(data);
+        if (!image) {
+            return SDL_SetError("Couldn't create the framebuffer image");
+        }
+        pthread_mutex_lock(&framebuffer_lock);
+        previous = data.framebuffer_image;
+        data.framebuffer_image = image;
+        pthread_mutex_unlock(&framebuffer_lock);
+        if (previous) {
+            CGImageRelease(previous); /* a repaint in progress holds the lock until it is done with it */
+        }
+
+#ifdef MAC_OS_X_VERSION_10_7
+        {
+            CALayer *layer = [view layer];
+            if (layer) {
+                /* Layer-backed view: hand the image to Core Animation.  The
+                   transaction disables the implicit contents cross-fade, and
+                   the flush pushes it out now rather than at the end of the
+                   current runloop pass. */
+                [CATransaction begin];
+                [CATransaction setDisableActions:YES];
+                layer.contents = (__bridge id)image;
+                [CATransaction commit];
+                [CATransaction flush];
+                return true;
+            }
+        }
+#endif
+
+        /* Classic view: draw straight into the window's backing store,
+           clipped to the dirty rects (top-left pixel coordinates to
+           bottom-left points).  lockFocusIfCanDraw fails when the window
+           cannot be drawn into (hidden, miniaturized); AppKit repaints the
+           buffer through -drawRect: once it can. */
+        if ([view lockFocusIfCanDraw]) {
+#ifdef MAC_OS_X_VERSION_10_10
+            CGContextRef context = [[NSGraphicsContext currentContext] CGContext];
+#else
+            CGContextRef context = (CGContextRef)[[NSGraphicsContext currentContext] graphicsPort];
+#endif
+            if (context) {
+                const NSRect bounds = [view bounds];
+                const CGFloat sx = bounds.size.width / (CGFloat)data.framebuffer_w;
+                const CGFloat sy = bounds.size.height / (CGFloat)data.framebuffer_h;
+                bool isstack;
+                CGRect *clip = SDL_small_alloc(CGRect, numrects, &isstack);
+                if (clip) {
+                    int i;
+                    for (i = 0; i < numrects; ++i) {
+                        clip[i] = CGRectMake(rects[i].x * sx,
+                                             bounds.size.height - (rects[i].y + rects[i].h) * sy,
+                                             rects[i].w * sx,
+                                             rects[i].h * sy);
+                    }
+                    CGContextClipToRects(context, clip, numrects);
+                    SDL_small_free(clip, isstack);
+                }
+                CGContextSetInterpolationQuality(context, kCGInterpolationNone);
+                CGContextDrawImage(context, CGRectMake(0, 0, bounds.size.width, bounds.size.height), image);
+            }
+            [view unlockFocus];
+            [[view window] flushWindow];
+        }
+        return true;
+    }
+}
+
+bool Cocoa_DrawWindowFramebuffer(SDL_Window *window, CGContextRef context, CGRect bounds)
+{
+    SDL_CocoaWindowData *data = window ? (__bridge SDL_CocoaWindowData *)window->internal : nil;
+    bool drawn = false;
+
+    if (!data || !context) {
+        return false;
+    }
+    /* Under the lock: the presenting thread neither swaps the image nor
+       frees the pixels it reads while this draw is in progress. */
+    pthread_mutex_lock(&framebuffer_lock);
+    if (data.framebuffer_image) {
+        /* The view is not flipped, so the image lands upright; CoreGraphics
+           clips to the dirty region and scales pixels to points if needed. */
+        CGContextSetInterpolationQuality(context, kCGInterpolationNone);
+        CGContextDrawImage(context, bounds, data.framebuffer_image);
+        drawn = true;
+    }
+    pthread_mutex_unlock(&framebuffer_lock);
+    return drawn;
+}
+
+void Cocoa_DestroyWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_OBJC_POOL {
+        SDL_CocoaWindowData *data = (__bridge SDL_CocoaWindowData *)window->internal;
+
+        if (!data) {
+            return;
+        }
+        pthread_mutex_lock(&framebuffer_lock);
+        Cocoa_FreeFramebufferLocked(data);
+        pthread_mutex_unlock(&framebuffer_lock);
+    }
+}
+
+#endif // SDL_VIDEO_DRIVER_COCOA
