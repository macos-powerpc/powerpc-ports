+#else /* pre-10.6 SDK: the classic NSPasteboard API, which has no lazy data
+         providers and no UTI-based types.  Text is supported the way SDL 2
+         did it; other types come and go by their raw pasteboard type name. */
+
+static char **GetMimeTypes(int *pnformats)
+{
+    char **new_mime_types = NULL;
+    NSArray *types = [[NSPasteboard generalPasteboard] types];
+    int nformats = 0;
+    int formatsSz = 0;
+
+    *pnformats = 0;
+
+    for (NSString *type in types) {
+        if ([type isEqualToString:NSStringPboardType]) {
+            formatsSz += (int)sizeof(SDL_COCOA_TEXT_MIME_TYPE);
+            ++nformats;
+        }
+        formatsSz += (int)[type lengthOfBytesUsingEncoding:NSUTF8StringEncoding] + 1;
+        ++nformats;
+    }
+
+    if (nformats > 0) {
+        new_mime_types = SDL_AllocateTemporaryMemory((nformats + 1) * sizeof(char *) + formatsSz);
+        if (new_mime_types) {
+            int i = 0;
+            char *strPtr = (char *)(new_mime_types + nformats + 1);
+            for (NSString *type in types) {
+                NSUInteger len;
+                if ([type isEqualToString:NSStringPboardType]) {
+                    len = sizeof(SDL_COCOA_TEXT_MIME_TYPE);
+                    SDL_memcpy(strPtr, SDL_COCOA_TEXT_MIME_TYPE, len);
+                    new_mime_types[i++] = strPtr;
+                    strPtr += len;
+                }
+                len = [type lengthOfBytesUsingEncoding:NSUTF8StringEncoding] + 1;
+                SDL_memcpy(strPtr, [type UTF8String], len);
+                new_mime_types[i++] = strPtr;
+                strPtr += len;
+            }
+
+            new_mime_types[nformats] = NULL;
+            *pnformats = nformats;
+        }
+    }
+    return new_mime_types;
+}
+
+static bool IsTextMimeType(const char *mime_type)
+{
+    return (SDL_strcmp(mime_type, SDL_COCOA_TEXT_MIME_TYPE) == 0) || (SDL_strcmp(mime_type, "text/plain") == 0);
+}
+
+static NSString *GetPboardType(const char *mime_type)
+{
+    if (IsTextMimeType(mime_type)) {
+        return NSStringPboardType;
+    }
+    return [NSString stringWithUTF8String:mime_type]; /* raw pasteboard type names pass through */
+}
+
+bool Cocoa_SetClipboardData(SDL_VideoDevice *_this)
+{
+    SDL_OBJC_POOL {
+        SDL_CocoaVideoData *data = (__bridge SDL_CocoaVideoData *)_this->internal;
+        NSPasteboard *pasteboard = [NSPasteboard generalPasteboard];
+
+        if (_this->clipboard_callback) {
+            bool have_text = false;
+            int i;
+
+            /* No lazy providers before 10.6: fetch the text now. */
+            for (i = 0; i < _this->num_clipboard_mime_types; i++) {
+                if (IsTextMimeType(_this->clipboard_mime_types[i])) {
+                    size_t size = 0;
+                    const void *text = _this->clipboard_callback(_this->clipboard_userdata, _this->clipboard_mime_types[i], &size);
+                    if (text && size) {
+                        NSString *str = SDL_COCOA_AUTORELEASE([[NSString alloc] initWithBytes:text length:size encoding:NSUTF8StringEncoding]);
+                        [pasteboard declareTypes:[NSArray arrayWithObject:NSStringPboardType] owner:nil];
+                        [pasteboard setString:str forType:NSStringPboardType];
+                        have_text = true;
+                    }
+                    break;
+                }
+            }
+            if (!have_text) {
+                return SDL_SetError("Only text clipboard data is supported before Mac OS X 10.6");
+            }
+        } else {
+            [pasteboard declareTypes:[NSArray array] owner:nil]; /* clears the pasteboard */
+        }
+        data.clipboard_count = [pasteboard changeCount];
+    }
+    return true;
+}
+
+void *Cocoa_GetClipboardData(SDL_VideoDevice *_this, const char *mime_type, size_t *size)
+{
+    SDL_OBJC_POOL {
+        NSPasteboard *pasteboard = [NSPasteboard generalPasteboard];
+        NSString *availableType = [pasteboard availableTypeFromArray:[NSArray arrayWithObject:GetPboardType(mime_type)]];
+        void *data = NULL;
+        *size = 0;
+        if (availableType) {
+            NSData *itemData;
+            if ([availableType isEqualToString:NSStringPboardType]) {
+                itemData = [[pasteboard stringForType:NSStringPboardType] dataUsingEncoding:NSUTF8StringEncoding];
+            } else {
+                itemData = [pasteboard dataForType:availableType];
+            }
+            if (itemData != nil) {
+                NSUInteger length = [itemData length];
+                *size = (size_t)length;
+                data = SDL_malloc(*size + sizeof(Uint32));
+                if (data) {
+                    [itemData getBytes: data length: length];
+                    SDL_memset((Uint8 *)data + length, 0, sizeof(Uint32));
+                }
+            }
+        }
+        return data;
+    }
+}
+
+bool Cocoa_HasClipboardData(SDL_VideoDevice *_this, const char *mime_type)
+{
+    bool result = false;
+    SDL_OBJC_POOL {
+        NSPasteboard *pasteboard = [NSPasteboard generalPasteboard];
+        if ([pasteboard availableTypeFromArray:[NSArray arrayWithObject:GetPboardType(mime_type)]] != nil) {
+            result = true;
+        }
+    }
+    return result;
+}
+
+#endif /* MAC_OS_X_VERSION_10_6 */
+
+void Cocoa_CheckClipboardUpdate(SDL_CocoaVideoData *data)
+{
+    SDL_OBJC_POOL {
+        NSPasteboard *pasteboard;
+        NSInteger count;
+
+        pasteboard = [NSPasteboard generalPasteboard];
+        count = [pasteboard changeCount];
+        if (count != data.clipboard_count) {
+            if (count) {
+                int nformats = 0;
+                char **new_mime_types = GetMimeTypes(&nformats);
+                if (new_mime_types) {
+                    SDL_SendClipboardUpdate(false, new_mime_types, nformats);
+                }
+            }
+            data.clipboard_count = count;
+        }
+    }
+}
+
 #endif // SDL_VIDEO_DRIVER_COCOA
