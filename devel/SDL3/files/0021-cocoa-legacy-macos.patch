+#include "SDL_internal.h"
+
+#ifndef SDL_cocoacompat_h_
+#define SDL_cocoacompat_h_
+
+/* Compatibility layer that lets the Cocoa backend build in two modes:
+
+   - clang with Objective-C ARC against a current SDK (the upstream default;
+     everything here compiles away to the stock spelling), and
+   - GCC with manual retain/release against the 10.5/10.6 SDKs, for legacy
+     Mac OS X (PowerPC) where clang is not available.
+
+   GCC's Objective-C has no ARC, no blocks, no @autoreleasepool, no
+   @available and no instancetype; on top of that the pre-10.7 SDKs lack a
+   number of constants, functions and methods.  The rules used throughout
+   the backend:
+
+   - pools are spelled SDL_OBJC_POOL { ... } (src/SDL_objc_compat.h);
+   - ownership is expressed with the SDL_COCOA_* macros below, which are
+     no-ops under ARC;
+   - SDK availability is decided at compile time with the AvailabilityMacros
+     MAC_OS_X_VERSION_10_x defines ("#ifdef MAC_OS_X_VERSION_10_7" == building
+     against the 10.7 SDK or newer), never with the deployment target;
+   - blocks, dispatch, @try and @available stay behind __clang__. */
+
+#include <AvailabilityMacros.h>
+#include <Cocoa/Cocoa.h>
+
+#include "SDL_objc_compat.h" /* SDL_OBJC_POOL */
+
+#ifndef __has_feature
+#define __has_feature(x) 0
+#endif
+
+#if __has_feature(objc_arc)
+#define SDL_COCOA_ARC 1
+#else
+#define SDL_COCOA_ARC 0
+#endif
+
+#if !defined(__clang__)
+/* Make ARC bridge casts vanish: (__bridge NSWindow *)ptr -> (NSWindow *)ptr */
+#ifndef __bridge
+#define __bridge
+#endif
+#ifndef instancetype
+#define instancetype id
+#endif
+#ifndef nullable
+#define nullable
+#endif
+/* The code paths that actually use blocks are all guarded to clang, so
+   __block locals become plain locals.  Apple GCC predefines __block as a
+   built-in macro, hence the #undef. */
+#undef __block
+#define __block
+#endif /* !__clang__ */
+
+/* Building against a pre-10.7 SDK, or with GCC: the era of AppKit that
+   tolerated driving windows and GL contexts from a non-main thread, and
+   whose CoreVideo may not tick on the OS builds that need FORCE_OLD_API.
+   Such builds behave like SDL <= 2.0.9 did there: no marshalling of work to
+   the main thread (the main thread may not be running a runloop to service
+   it - e.g. mpv drives SDL from its vo thread), and vsync through
+   NSOpenGLCPSwapInterval rather than a display link. */
+#if !defined(__clang__) || !defined(MAC_OS_X_VERSION_10_7)
+#define SDL_COCOA_LEGACY_APPKIT 1
+#else
+#define SDL_COCOA_LEGACY_APPKIT 0
+#endif
+
+/* ARC ivar qualifier for the listener's back pointer to its window data. */
+#if SDL_COCOA_ARC
+#if MAC_OS_X_VERSION_MIN_REQUIRED >= 1070
+#define SDL_COCOA_WEAK __weak
+#else
+#define SDL_COCOA_WEAK __unsafe_unretained /* no zeroing weak refs before 10.7 */
+#endif
+#else
+#define SDL_COCOA_WEAK /* unretained plain pointer under MRR */
+#endif
+
+/* Ownership transfer between ObjC objects and void * internal pointers.
+   The 10.7+ SDKs provide CFBridgingRetain/CFBridgingRelease as inline
+   functions with the right MRR semantics; older SDKs need these.
+   CFBridgingRetain: +1 retain, returns a pointer.  CFBridgingRelease:
+   consumes that +1, returns the object (autoreleased under MRR).
+   The typedef keeps the casts working in scopes where a local shadows 'id'
+   (Cocoa_CreateSystemCursor's parameter is called id). */
+#if !SDL_COCOA_ARC && !defined(MAC_OS_X_VERSION_10_7)
+typedef id SDL_cocoa_id;
+#define CFBridgingRetain(obj)  ((void *)[(SDL_cocoa_id)(obj) retain])
+#define CFBridgingRelease(ptr) ((SDL_cocoa_id)[(SDL_cocoa_id)(ptr) autorelease])
+#endif
+
+/* Explicit retain/release/autorelease that compile away under ARC.
+   Used where MRR needs an ownership operation that ARC does implicitly.
+   Variadic because the argument is often a [bracketed message send] whose
+   commas square brackets do not hide from the preprocessor. */
+#if SDL_COCOA_ARC
+#define SDL_COCOA_RETAIN(...)      (__VA_ARGS__)
+#define SDL_COCOA_RELEASE(...)     do { } while (0)
+#define SDL_COCOA_AUTORELEASE(...) (__VA_ARGS__)
+#else
+#define SDL_COCOA_RETAIN(...)      [(__VA_ARGS__) retain]
+#define SDL_COCOA_RELEASE(...)     [(__VA_ARGS__) release]
+#define SDL_COCOA_AUTORELEASE(...) [(__VA_ARGS__) autorelease]
+#endif
+
+/* --- SDK fallbacks ------------------------------------------------------ */
+
+/* The 10.12 SDK renamed most AppKit enumerators; the old names are still
+   deprecated aliases in newer SDKs, so only map them for older ones.
+   #defines rather than static consts: GCC does not accept const variables
+   as switch case labels, and these are used in event-type switches. */
+#if MAC_OS_X_VERSION_MAX_ALLOWED < 101200
+#define NSEventTypeLeftMouseDown NSLeftMouseDown
+#define NSEventTypeLeftMouseUp NSLeftMouseUp
+#define NSEventTypeRightMouseDown NSRightMouseDown
+#define NSEventTypeRightMouseUp NSRightMouseUp
+#define NSEventTypeOtherMouseDown NSOtherMouseDown
+#define NSEventTypeOtherMouseUp NSOtherMouseUp
+#define NSEventTypeMouseMoved NSMouseMoved
+#define NSEventTypeLeftMouseDragged NSLeftMouseDragged
+#define NSEventTypeRightMouseDragged NSRightMouseDragged
+#define NSEventTypeOtherMouseDragged NSOtherMouseDragged
+#define NSEventTypeMouseEntered NSMouseEntered
+#define NSEventTypeMouseExited NSMouseExited
+#define NSEventTypeKeyDown NSKeyDown
+#define NSEventTypeKeyUp NSKeyUp
+#define NSEventTypeFlagsChanged NSFlagsChanged
+#define NSEventTypeApplicationDefined NSApplicationDefined
+#define NSEventTypeScrollWheel NSScrollWheel
+#define NSEventTypeTabletPoint NSTabletPoint
+#define NSEventTypeTabletProximity NSTabletProximity
+
+/* Pre-10.12 SDKs do not all have the NSEventMask typedef */
+#define NSEventMaskAny NSAnyEventMask
+
+#define NSEventModifierFlagCapsLock NSAlphaShiftKeyMask
+#define NSEventModifierFlagControl NSControlKeyMask
+#define NSEventModifierFlagCommand NSCommandKeyMask
+#define NSEventModifierFlagOption NSAlternateKeyMask
+
+/* -[NSEvent subtype] returns a short before the 10.12 SDK */
+typedef short NSEventSubtype;
+#define NSEventSubtypeMouseEvent NSMouseEventSubtype
+#define NSEventSubtypeTabletPoint NSTabletPointEventSubtype
+#define NSEventSubtypeTabletProximity NSTabletProximityEventSubtype
+
+typedef NSUInteger NSEventButtonMask;
+#define NSEventButtonMaskPenTip NSPenTipMask
+#define NSEventButtonMaskPenLowerSide NSPenLowerSideMask
+#define NSEventButtonMaskPenUpperSide NSPenUpperSideMask
+
+#define NSPointingDeviceTypeEraser NSEraserPointingDevice
+#define NSPointingDeviceTypePen NSPenPointingDevice
+
+#define NSWindowStyleMaskBorderless NSBorderlessWindowMask
+#define NSWindowStyleMaskTitled NSTitledWindowMask
+#define NSWindowStyleMaskClosable NSClosableWindowMask
+#define NSWindowStyleMaskMiniaturizable NSMiniaturizableWindowMask
+#define NSWindowStyleMaskResizable NSResizableWindowMask
+
+#define NSAlertStyleWarning NSWarningAlertStyle
+#define NSAlertStyleInformational NSInformationalAlertStyle
+#define NSAlertStyleCritical NSCriticalAlertStyle
+
+#define NSCompositingOperationCopy NSCompositeCopy
+#endif /* MAC_OS_X_VERSION_MAX_ALLOWED < 101200 */
+
+#if MAC_OS_X_VERSION_MAX_ALLOWED < 101300 /* the 10.13 SDK typedef'd pasteboard types */
+typedef NSString *NSPasteboardType;
+#endif
+
+#ifndef MAC_OS_X_VERSION_10_9
+typedef NSInteger NSModalResponse;
+/* Occlusion state is 10.9+; the observer never fires on older OS releases
+   and the code falls back to -isVisible there. */
+#define NSWindowDidChangeOcclusionStateNotification @"NSWindowDidChangeOcclusionStateNotification"
+#define NSWindowOcclusionStateVisible (1 << 1)
+#endif
+
+#ifndef MAC_OS_X_VERSION_10_7
+/* The fullscreen-Spaces machinery is compiled in unconditionally, but is
+   only ever exercised at runtime on 10.7+ (videodata.allow_spaces checks the
+   OS version).  Old SDKs lack these constants and notification-name symbols;
+   providing the raw values / literal strings keeps the code building, and
+   the observers simply never fire on OS releases that never post them. */
+#define NSWindowCollectionBehaviorFullScreenPrimary (1 << 7)
+#define NSWindowCollectionBehaviorFullScreenNone (1 << 9)
+#define NSApplicationPresentationFullScreen (1 << 10)
+#define NSApplicationPresentationHideDock (1 << 1)
+#define NSApplicationPresentationHideMenuBar (1 << 3)
+#define NSWindowDidChangeBackingPropertiesNotification @"NSWindowDidChangeBackingPropertiesNotification"
+#define NSWindowWillEnterFullScreenNotification @"NSWindowWillEnterFullScreenNotification"
+#define NSWindowDidEnterFullScreenNotification @"NSWindowDidEnterFullScreenNotification"
+#define NSWindowWillExitFullScreenNotification @"NSWindowWillExitFullScreenNotification"
+#define NSWindowDidExitFullScreenNotification @"NSWindowDidExitFullScreenNotification"
+#define NSBackingPropertyOldScaleFactorKey @"NSBackingPropertyOldScaleFactorKey"
+#endif
+
+#ifndef MAC_OS_X_VERSION_10_6
+#define NSWindowCollectionBehaviorManaged (1 << 2)
+#define NSWindowWillStartLiveResizeNotification @"NSWindowWillStartLiveResizeNotification"
+#define NSWindowDidEndLiveResizeNotification @"NSWindowDidEndLiveResizeNotification"
+/* NSApplicationPresentationOptions is only ever used by the 10.7+ spaces
+   delegate method, which is compiled out on older SDKs, but the typedef is
+   referenced by the delegate protocol declarations. */
+typedef NSUInteger NSApplicationPresentationOptions;
+/* The pasteboard type constants were introduced with the 10.6 SDK. */
+#define NSPasteboardTypeString NSStringPboardType
+#endif
+
+#ifndef NSAppKitVersionNumber10_6
+#define NSAppKitVersionNumber10_6 1038
+#endif
+#ifndef NSAppKitVersionNumber10_7
