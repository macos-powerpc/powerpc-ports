+#include "SDL_internal.h"
+
+#ifndef SDL_cocoaframebuffer_h_
+#define SDL_cocoaframebuffer_h_
+
+/* A plain software framebuffer for Cocoa windows, presented with
+   CoreGraphics.  SDL's generic code prefers a renderer-backed texture
+   framebuffer when an accelerated renderer (OpenGL, Metal) is available
+   and only falls back to this one when there is none - e.g. builds
+   without CGL - or when SDL_HINT_FRAMEBUFFER_ACCELERATION is "0". */
+
+extern bool Cocoa_CreateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window, SDL_PixelFormat *format, void **pixels, int *pitch);
+extern bool Cocoa_UpdateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window, const SDL_Rect *rects, int numrects);
+extern void Cocoa_DestroyWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window);
+
+/* Paints the current framebuffer image into a view drawing context, for
+   -[NSView drawRect:].  Returns false if the window has no framebuffer. */
+extern bool Cocoa_DrawWindowFramebuffer(SDL_Window *window, CGContextRef context, CGRect bounds);
+
