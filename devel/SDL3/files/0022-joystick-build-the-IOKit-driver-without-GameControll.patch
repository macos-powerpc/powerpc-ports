From ee0ca456408ce2070dcca0b6c9d6105a87e0468c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 25 Sep 2026 21:13:00 +0000
Subject: [PATCH] joystick: build the IOKit driver without
 GameController.framework

The MFi driver (src/joystick/apple) was compiled on every macOS build and
imports GameController.framework, which only exists on 10.9+, and uses ARC
qualifiers GCC does not know. Compile and register it on macOS only when
SDL_JOYSTICK_MFI is enabled (GameController and CoreHaptics found); the IOKit
driver alone handles HID joysticks and gamepads.

IOHIDDeviceGetService() is 10.6+; on older SDKs return MACH_PORT_NULL, which
both callers already handle (no 360Controller detection, no force feedback).
---
 CMakeLists.txt                          | 12 ++++++++----
 src/joystick/SDL_joystick.c             |  2 +-
 src/joystick/darwin/SDL_iokitjoystick.c | 11 +++++++++++
 3 files changed, 20 insertions(+), 5 deletions(-)

diff --git CMakeLists.txt CMakeLists.txt
index c1a7872..cc67ac3 100644
--- CMakeLists.txt
+++ CMakeLists.txt
@@ -2563,11 +2563,11 @@ elseif(APPLE)
   endif()
 
   if(SDL_JOYSTICK)
-    sdl_glob_sources(
-      "${SDL3_SOURCE_DIR}/src/joystick/apple/*.m"
-      "${SDL3_SOURCE_DIR}/src/joystick/apple/*.h"
-    )
     if(IOS OR TVOS OR VISIONOS OR WATCHOS)
+      sdl_glob_sources(
+        "${SDL3_SOURCE_DIR}/src/joystick/apple/*.m"
+        "${SDL3_SOURCE_DIR}/src/joystick/apple/*.h"
+      )
       set(SDL_JOYSTICK_MFI 1)
       if(IOS OR VISIONOS OR WATCHOS)
         set(SDL_FRAMEWORK_COREMOTION 1)
@@ -2600,6 +2600,10 @@ elseif(APPLE)
           int main() { return 0; }" HAVE_FRAMEWORK_COREHAPTICS)
       if(HAVE_FRAMEWORK_GAMECONTROLLER AND HAVE_FRAMEWORK_COREHAPTICS)
         # Only enable MFI if we also have CoreHaptics to ensure rumble works
+        sdl_glob_sources(
+          "${SDL3_SOURCE_DIR}/src/joystick/apple/*.m"
+          "${SDL3_SOURCE_DIR}/src/joystick/apple/*.h"
+        )
         set(SDL_JOYSTICK_MFI 1)
         set(SDL_FRAMEWORK_GAMECONTROLLER 1)
         set(SDL_FRAMEWORK_COREHAPTICS 1)
diff --git src/joystick/SDL_joystick.c src/joystick/SDL_joystick.c
index ccf6572..11db147 100644
--- src/joystick/SDL_joystick.c
+++ src/joystick/SDL_joystick.c
@@ -76,7 +76,7 @@ static SDL_JoystickDriver *SDL_joystick_drivers[] = {
 #ifdef SDL_JOYSTICK_IOKIT
     &SDL_DARWIN_JoystickDriver,
 #endif
-#if (defined(SDL_PLATFORM_MACOS) || defined(SDL_PLATFORM_IOS) || defined(SDL_PLATFORM_TVOS)) && !defined(SDL_JOYSTICK_DISABLED)
+#if ((defined(SDL_PLATFORM_MACOS) && defined(SDL_JOYSTICK_MFI)) || defined(SDL_PLATFORM_IOS) || defined(SDL_PLATFORM_TVOS)) && !defined(SDL_JOYSTICK_DISABLED)
     &SDL_IOS_JoystickDriver,
 #endif
 #ifdef SDL_JOYSTICK_ANDROID
diff --git src/joystick/darwin/SDL_iokitjoystick.c src/joystick/darwin/SDL_iokitjoystick.c
index b88258f..9ac917c 100644
--- src/joystick/darwin/SDL_iokitjoystick.c
+++ src/joystick/darwin/SDL_iokitjoystick.c
@@ -444,6 +444,17 @@ static int GetSteamVirtualGamepadSlot(Uint16 vendor_id, Uint16 product_id, const
     return slot;
 }
 
+#if defined(MAC_OS_X_VERSION_MAX_ALLOWED) && (MAC_OS_X_VERSION_MAX_ALLOWED < 1060)
+/* IOHIDDeviceGetService() is 10.6+. The service is only used to recognise the 360Controller
+   driver and to attach force feedback, and both callers accept MACH_PORT_NULL, so on 10.5
+   joysticks work without those two. */
+static io_service_t IOHIDDeviceGetService(IOHIDDeviceRef device)
+{
+    (void)device;
+    return MACH_PORT_NULL;
+}
+#endif
+
 static bool IsControlledBy360ControllerDriver(IOHIDDeviceRef hidDevice)
 {
     bool controlled_by_360controller = false;
