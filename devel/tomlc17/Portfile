github.tarball_from archive

post-patch {
    reinplace "s|/usr/local|${prefix}|" ${worksrcpath}/Makefile
    reinplace "s|static_assert|_Static_assert|g" ${worksrcpath}/src/tomlc17.c

    # https://github.com/cktan/tomlc17/issues/42
    fs-traverse f ${worksrcpath} {
        if {[file isfile ${f}] && [file extension ${f}] eq ""} {
            reinplace -q "s|-fsanitize=address\,undefined||g" ${f}
        }
    }
}

