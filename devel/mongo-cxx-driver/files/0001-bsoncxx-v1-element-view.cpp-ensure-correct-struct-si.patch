From 06267ff60aed92d2d966cc5ef5a4ce243a14b030 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Tue, 10 Nov 2026 09:45:38 +0800
Subject: [PATCH] bsoncxx/v1/element/view.cpp: ensure correct struct sizes

---
 src/bsoncxx/lib/bsoncxx/v1/element/view.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/bsoncxx/lib/bsoncxx/v1/element/view.cpp b/src/bsoncxx/lib/bsoncxx/v1/element/view.cpp
index d58b944b4a..c311e9c262 100644
--- src/bsoncxx/lib/bsoncxx/v1/element/view.cpp
+++ src/bsoncxx/lib/bsoncxx/v1/element/view.cpp
@@ -67,7 +67,7 @@ class alignas(BSONCXX_PRIVATE_MAX_ALIGN_T) view::impl {
     std::array<unsigned char, _padding_size> _padding = {}; // Reserved.
     BSONCXX_PRIVATE_WARNINGS_POP();
 
-    bool _is_valid = {}; // Last byte.
+    std::uint8_t _is_valid = {}; // Last byte.
 
    public:
     impl() = default;
@@ -77,7 +77,7 @@ class alignas(BSONCXX_PRIVATE_MAX_ALIGN_T) view::impl {
         std::uint32_t length,
         std::uint32_t offset,
         std::uint32_t keylen,
-        bool is_valid = true)
+        std::uint8_t is_valid = true)
         : _raw{raw}, _length{length}, _offset{offset}, _keylen{keylen}, _is_valid{is_valid} {}
 
     void check() const;
