 function gcc.update_ldflags(ldflags, attribute)
+    -- Only ever populated on Apple targets (see bee.lua's build script);
+    -- clang.lua has always handled this, but gcc flavor was previously
+    -- never actually selectable on macOS (globals.lua forced clang there),
+    -- so this path was simply never exercised. GCC's Darwin driver
+    -- understands -framework the same way clang's does.
+    if attribute.frameworks then
+        for _, framework in ipairs(attribute.frameworks) do
+            ldflags[#ldflags+1] = "-framework"
+            ldflags[#ldflags+1] = framework
+        end
+    end
     if attribute.crt == "dynamic" then
         ldflags[#ldflags+1] = "-lstdc++"
     else
