@@ -347,7 +347,14 @@
         if attribute.ldflags then
             tbl_append(ldflags, attribute.ldflags)
         end
-        if globals.compiler == "clang" and attribute.frameworks then
+        -- attribute.frameworks is only ever set inside macos/ios platform
+        -- blocks (never gated by compiler in the source data itself), so
+        -- gating it here by `compiler == "clang"` was wrong on its own
+        -- terms even before gcc became a real macOS option: it silently
+        -- dropped every framework a source_set declared (e.g. bee.lua's
+        -- source_bee) whenever some other compiler was selected, with no
+        -- corresponding check anywhere else to catch the gap.
+        if attribute.frameworks then
             for _, framework in ipairs(attribute.frameworks) do
                 ldflags[#ldflags+1] = "-framework"
                 ldflags[#ldflags+1] = framework
