PortSystem          1.0
PortGroup           github 1.0

github.setup        sahlberg libsmb2 6.2 libsmb2-
revision            0
categories          devel net
license             LGPL-2.1
maintainers         nomaintainer

description         SMB2/3 userspace client
long_description    {*}${description}
checksums           rmd160  a90c5961f500f10d75eb96ff541b4aa8e7c2cff8 \
                    sha256  8e1f9efc6b2e0f6546f0fe121ac0ddf4fc2f0908ae5a6bd1f185be7c9e0bcbb3 \
                    size    259518
github.tarball_from archive

# https://github.com/sahlberg/libsmb2/issues/476
patchfiles-append   patch-fix-kerberos.diff

use_autoreconf      yes
autoreconf.args     -fiv

configure.args-append \
                    --without-libkrb5

# Type redefinition
compiler.c_standard 2011

if [string match *clang* ${configure.compiler}] {
    configure.cflags-append \
                    -Wno-error=cast-align
}

variant gssapi description "Build with kerberos5" {
    depends_lib-append \
                    path:include/gssapi/gssapi.h:kerberos5

    configure.args-delete \
                    --without-libkrb5

    # The build forgets to link the library:
    configure.ldflags-append \
                    -lkrb5
}

default_variants    +gssapi
