github.setup        sahlberg libsmb2 27600bfec201accf59ed7d65530a9d0bde3756d5
version             6.2
revision            2
categories          devel net
license             LGPL-2.1
maintainers         nomaintainer

description         SMB2/3 userspace client
long_description    {*}${description}
checksums           rmd160  31927e3d33ef26b4aa5a9e1ce714d60e29075666 \
                    sha256  b1de3bdf5c1c0edb31920b7ea99dccd725d7c593aa62e8a865add3cac4ea0bb8 \
                    size    432168
github.tarball_from archive

patch.pre_args-replace  -p0 -p1

# https://github.com/sahlberg/libsmb2/pull/481
patchfiles-append   0001-Only-use-CommonCrypto-where-it-exists-fall-back-to-r.patch

# https://github.com/sahlberg/libsmb2/issues/476
patchfiles-append   0002-Only-use-Apple-s-GSS.framework-where-it-exists-fall-.patch

patchfiles-append   0003-Link-libkrb5-explicitly-when-it-s-separately-findabl.patch

# dcerpc-srvsvc.c:4305:18: error: declaration shadows a variable in the global scope [-Werror,-Wshadow]
patchfiles-append   0004-dcerpc-srvsvc-rename-local-timezone-variable-it-shad.patch

use_autoreconf      yes
autoreconf.args     -fiv

configure.args-append \
                    --without-libkrb5

# Type redefinition
compiler.c_standard 2011

if [string match *clang* ${configure.compiler}] {
    configure.cflags-append \
                    -Wno-error=cast-align
}

variant gssapi description "Build with kerberos5" {
    if {${os.platform} ne "darwin" || ${os.major} < 18} {
        depends_lib-append \
                    path:include/gssapi/gssapi.h:kerberos5
    }

    configure.args-delete \
                    --without-libkrb5
}

default_variants    +gssapi
