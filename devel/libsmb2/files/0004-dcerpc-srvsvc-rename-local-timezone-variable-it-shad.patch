From d9bff046faaa7ece63bc49cc940c4abd2d5547f1 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 00:52:52 +0000
Subject: [PATCH] dcerpc-srvsvc: rename local timezone variable, it shadows the
 POSIX global

srvsvc_TIME_OF_DAY_INFO_coder() declared a local uint32_t timezone,
shadowing the POSIX "extern long timezone" from <time.h>. Harmless in
practice (the local variable is what's actually used throughout the
function), but -Wshadow -Werror rejects it outright on a real macOS
10.15 + Xcode CLT build, where <time.h> declares timezone
unconditionally:

  dcerpc-srvsvc.c:4305:18: error: declaration shadows a variable in
  the global scope [-Werror,-Wshadow]

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HipnMZ4oFkNioWvpfRC64V
---
 libdcerpc/dcerpc-srvsvc.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/libdcerpc/dcerpc-srvsvc.c b/libdcerpc/dcerpc-srvsvc.c
index 96a0120..2768e5c 100644
--- a/libdcerpc/dcerpc-srvsvc.c
+++ b/libdcerpc/dcerpc-srvsvc.c
@@ -4302,7 +4302,9 @@ srvsvc_TIME_OF_DAY_INFO_coder(char *name, struct dcerpc_context *dce,
                               void *ptr)
 {
         struct srvsvc_TIME_OF_DAY_INFO *tod = ptr;
-        uint32_t timezone = 0;
+        /* Not named "timezone": that shadows the POSIX global of
+         * the same name declared by <time.h> on some platforms. */
+        uint32_t tz = 0;
 
         if (dcerpc_uint32_coder("Elapsedt", dce, pdu, iov, offset, &tod->elapsedt)) {
                 return -1;
@@ -4323,13 +4325,13 @@ srvsvc_TIME_OF_DAY_INFO_coder(char *name, struct dcerpc_context *dce,
                 return -1;
         }
         if (dcerpc_pdu_direction(pdu) == DCERPC_ENCODE) {
-                timezone = (uint32_t)tod->timezone;
+                tz = (uint32_t)tod->timezone;
         }
-        if (dcerpc_uint32_coder("Timezone", dce, pdu, iov, offset, &timezone)) {
+        if (dcerpc_uint32_coder("Timezone", dce, pdu, iov, offset, &tz)) {
                 return -1;
         }
         if (dcerpc_pdu_direction(pdu) == DCERPC_DECODE && !dcerpc_get_cr(pdu)) {
-                tod->timezone = (int32_t)timezone;
+                tod->timezone = (int32_t)tz;
         }
         if (dcerpc_uint32_coder("Tinterval", dce, pdu, iov, offset, &tod->tinterval)) {
                 return -1;
