From 6ce592367305f7399ec6f7ef8de2263bf52a3c7f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 00:25:49 +0000
Subject: [PATCH 1/3] Only use CommonCrypto where it exists, fall back to
 reference AES otherwise

aes.c/aes_apple.c/aes_apple.h unconditionally included
<CommonCrypto/CommonCrypto.h> whenever __APPLE__ was defined. That
header isn't reachable on every toolchain (e.g. MacPorts gcc targeting
an old SDK/PowerPC), which breaks the build with:

  aes_apple.c:25:10: fatal error: CommonCrypto/CommonCrypto.h: No such
  file or directory

It's also the wrong header regardless of reachability: CommonCrypto.h
is just a convenience umbrella that Apple only added starting with the
10.9 SDK. <CommonCrypto/CommonCryptor.h> is the header that actually
declares the Cryptor API used here (CCCryptorCreate/Update/Release,
CCCryptorStatus, CCCryptorRef, ...), and it has shipped since
CommonCrypto was introduced in the 10.5 SDK - verified against Apple's
actual SDK header listings from 10.5 through 11.3.

Also use kCCAlgorithmAES128 instead of kCCAlgorithmAES: the latter is
only defined from the 10.9 SDK onward too, as an alias (same enum
value, 0) for the original kCCAlgorithmAES128, which is present and
undeprecated at the compiler level on every SDK version checked.

Add a HAVE_COMMONCRYPTO_COMMONCRYPTOR_H header check to autoconf/cmake
and gate the include and the AES128_ECB_encrypt_apple
declaration/definition/call on __APPLE__ *and* that macro, falling back
to the portable reference AES implementation (aes_reference.c) when
CommonCryptor.h isn't reachable at all. On every Apple SDK from 10.5
onward, where CommonCryptor.h is present, this takes the exact same
optimized-AES code path as before.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HipnMZ4oFkNioWvpfRC64V
---
 cmake/ConfigureChecks.cmake |  9 +++++++++
 cmake/config.h.cmake        |  3 +++
 configure.ac                | 10 ++++++++++
 lib/aes.c                   |  7 +++++--
 lib/aes_apple.c             | 17 ++++++++++++-----
 lib/aes_apple.h             |  2 +-
 6 files changed, 40 insertions(+), 8 deletions(-)

diff --git a/cmake/ConfigureChecks.cmake b/cmake/ConfigureChecks.cmake
index 022a28c..e95c010 100644
--- a/cmake/ConfigureChecks.cmake
+++ b/cmake/ConfigureChecks.cmake
@@ -3,6 +3,15 @@ include(CheckIncludeFiles)
 check_include_file("arpa/inet.h" HAVE_ARPA_INET_H)
 check_include_file("dlfcn.h" HAVE_DLFCN_H)
 check_include_file("fcntl.h" HAVE_FCNTL_H)
+# CommonCrypto.framework is not always reachable on Apple platforms
+# (e.g. a toolchain that doesn't see Apple's framework headers at all).
+# Check for CommonCryptor.h, the header that actually declares the
+# Cryptor API aes_apple.c uses (unlike the CommonCrypto.h umbrella
+# header, which only exists from the 10.9 SDK onward, CommonCryptor.h
+# has shipped since CommonCrypto was introduced in the 10.5 SDK). aes.c
+# falls back to the portable reference AES implementation when it is
+# missing.
+check_include_file("CommonCrypto/CommonCryptor.h" HAVE_COMMONCRYPTO_COMMONCRYPTOR_H)
 if (ENABLE_GSSAPI)
 check_include_file("gssapi/gssapi.h" HAVE_GSSAPI_GSSAPI_H)
 endif()
diff --git a/cmake/config.h.cmake b/cmake/config.h.cmake
index 76eaded..202ba38 100644
--- a/cmake/config.h.cmake
+++ b/cmake/config.h.cmake
@@ -9,6 +9,9 @@
 /* Define to 1 if you have the <fcntl.h> header file. */
 #cmakedefine HAVE_FCNTL_H "@HAVE_FCNTL_H@"
 
+/* Define to 1 if you have the <CommonCrypto/CommonCryptor.h> header file. */
+#cmakedefine HAVE_COMMONCRYPTO_COMMONCRYPTOR_H "@HAVE_COMMONCRYPTO_COMMONCRYPTOR_H@"
+
 /* Define to 1 if you have the <sys/fcntl.h> header file. */
 #cmakedefine HAVE_SYS_FCNTL_H "@HAVE_SYS_FCNTL_H@"
 
diff --git a/configure.ac b/configure.ac
index ef2691a..57a41d0 100644
--- a/configure.ac
+++ b/configure.ac
@@ -100,6 +100,16 @@ AC_SUBST([LIBSOCKET])
 
 AC_CHECK_LIB([dl], [dlsym], [], [AC_MSG_ERROR([dlsym not found, libdl is required])])
 
+dnl  CommonCrypto.framework is not always reachable on Apple platforms
+dnl  (e.g. a toolchain that doesn't see Apple's framework headers at
+dnl  all). Check for CommonCryptor.h, the header that actually declares
+dnl  the Cryptor API aes_apple.c uses (unlike the CommonCrypto.h
+dnl  umbrella header, which only exists from the 10.9 SDK onward,
+dnl  CommonCryptor.h has shipped since CommonCrypto was introduced in
+dnl  the 10.5 SDK). aes.c falls back to the portable reference AES
+dnl  implementation when it is missing.
+AC_CHECK_HEADERS([CommonCrypto/CommonCryptor.h])
+
 dnl  Check for poll.h
 AC_CHECK_HEADERS([poll.h])
 
diff --git a/lib/aes.c b/lib/aes.c
index 672e8d1..fa2f77e 100644
--- a/lib/aes.c
+++ b/lib/aes.c
@@ -18,14 +18,17 @@
 
 #include "aes.h"
 
-#ifdef __APPLE__
+/* Use Apple's CommonCrypto only where it actually exists; otherwise fall
+ * back to the portable reference AES implementation, e.g. when building
+ * with a toolchain that doesn't see Apple's framework headers at all. */
+#if defined(__APPLE__) && defined(HAVE_COMMONCRYPTO_COMMONCRYPTOR_H)
 #include "aes_apple.h"
 #else
 #include "aes_reference.h"
 #endif
 
 void AES128_ECB_encrypt(uint8_t* input, const uint8_t* key, uint8_t *output) {
-#ifdef __APPLE__
+#if defined(__APPLE__) && defined(HAVE_COMMONCRYPTO_COMMONCRYPTOR_H)
 AES128_ECB_encrypt_apple(input, key, output);
 #else
 AES128_ECB_encrypt_reference(input, key, output);
diff --git a/lib/aes_apple.c b/lib/aes_apple.c
index 1f672dd..a03b1af 100644
--- a/lib/aes_apple.c
+++ b/lib/aes_apple.c
@@ -20,9 +20,16 @@
 
 #include "aes_apple.h"
 
-#ifdef __APPLE__
+/* Use Apple's CommonCrypto only where it actually exists; otherwise
+ * aes.c falls back to the portable reference AES implementation, e.g.
+ * when building with a toolchain that doesn't see Apple's framework
+ * headers at all. CommonCryptor.h (not the CommonCrypto.h umbrella,
+ * which only exists from the 10.9 SDK onward) is the actual header
+ * that declares the Cryptor API used below, and has shipped since
+ * CommonCrypto was introduced in the 10.5 SDK. */
+#if defined(__APPLE__) && defined(HAVE_COMMONCRYPTO_COMMONCRYPTOR_H)
 
-#include <CommonCrypto/CommonCrypto.h>
+#include <CommonCrypto/CommonCryptor.h>
 
 #define AES128_KEY_LEN 16
 #define AES128_BLOCK_SIZE 16
@@ -32,9 +39,9 @@ void AES128_ECB_encrypt_apple(const uint8_t *input, const uint8_t *key, uint8_t
 
     // Create an AES ECB encryption context
     CCCryptorStatus status = CCCryptorCreate(
-        kCCEncrypt,         
-        kCCAlgorithmAES,     
-        kCCOptionECBMode,     
+        kCCEncrypt,
+        kCCAlgorithmAES128,
+        kCCOptionECBMode,
         key,                   
         AES128_KEY_LEN,         
         NULL,                    
diff --git a/lib/aes_apple.h b/lib/aes_apple.h
index bed9013..c014dac 100644
--- a/lib/aes_apple.h
+++ b/lib/aes_apple.h
@@ -27,7 +27,7 @@
 #include <stdint.h>
 #endif
 
-#ifdef __APPLE__
+#if defined(__APPLE__) && defined(HAVE_COMMONCRYPTO_COMMONCRYPTOR_H)
 void AES128_ECB_encrypt_apple(const uint8_t* input, const uint8_t* key, uint8_t *output);
 #endif
 
