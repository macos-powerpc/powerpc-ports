                    0018-parser-report-argument-types-on-overload-resolution-failure.patch

compiler.cxx_standard   2011
compiler.openmp_version 2.5

# TODO: may need runtime dep on C++ compiler.

# NB: libatomic_ops is no longer needed. It used to be a *runtime* dependency
# because FreeOCL's OpenCL C pre-include headers (atomic.h, memfence.h)
# included <atomic_ops.h>, so every JIT kernel compile pulled it in.
# 0011-atomic-*.patch guards those includes with #ifndef __GNUC__ and uses
# the compiler's __atomic builtins instead, and every compiler MacPorts uses
# defines __GNUC__. (On a compiler that does not, FreeOCL was already broken:
# the atomic_* builtins used __sync_* unconditionally.)
if {[string match *gcc* ${configure.compiler}] && ${configure.build_arch} in [list arm i386 ppc]} {
    configure.ldflags-append \
                    -latomic
}

# C++11 is optional but enabled by default.
configure.args-append   -DFREEOCL_USE_CXX0X=ON

# https://github.com/zuzuf/freeocl/issues/25
configure.cppflags-append \
                        -DUSE_KHR_CL
