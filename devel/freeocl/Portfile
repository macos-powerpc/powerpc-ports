# Build with a modern toolchain, and parse real-world kernels.
# None of these are platform-specific.
patchfiles-append   0009-preprocessor-stringification.patch \
                    0010-stdlib-includes.patch \
                    0011-atomic-use-compiler-builtins-instead-of-libatomic-ops.patch \
                    0012-math-relational-do-not-redeclare-C-11-stdlib-float-math.patch \
                    0013-preprocessor-consume-newline-after-line-continuation.patch \
                    0014-parser-accept-static-and-extern-storage-class-specifiers.patch \
                    0015-parser-resolve-typedefs-when-computing-result-types.patch \
