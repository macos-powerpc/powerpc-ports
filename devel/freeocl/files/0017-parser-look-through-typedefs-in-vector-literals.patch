From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 7 Sep 2026 20:00:00 +0800
Subject: [PATCH] parser: look through typedefs when validating vector literals

(uint4)(x) where x is a typedef'd scalar was rejected with "vector literals
must take either 1 scalar or match vector type dimension": cast::validate()
resolved the element type with as<native_type>(), which is NULL for a
typedef, so the scalar-broadcast form failed its check. Code generation was
already correct -- it emits uint4::make(x), and vectors.h has the
single-scalar splat overload -- only the validation was wrong.

Add type::resolve_typedefs() to unwrap a typedef chain to the structural
type, carrying over any const found on the way, and use it here. This is the
third site to need such unwrapping, after compute_resulting_type and
overload matching.
---
--- a/src/parser/type.h
+++ b/src/parser/type.h
@@ -59,6 +59,11 @@
 
 	public:
 		static smartptr<type> compute_resulting_type(const smartptr<type> &t0, const smartptr<type> &t1);
+		// Looks through typedef chains to the underlying structural type, so a
+		// caller that needs a native_type/pointer_type/... sees one even when
+		// the declaration used a typedef. Any const picked up along the chain
+		// is carried over to the returned type.
+		static smartptr<type> resolve_typedefs(const smartptr<type> &t);
 	};
 }
 
--- a/src/parser/cast.cpp
+++ b/src/parser/cast.cpp
@@ -17,6 +17,7 @@
 */
 #include "cast.h"
 #include "native_type.h"
+#include "typedef.h"
 #include "binary.h"
 #include <sstream>
 #include <iostream>
@@ -63,7 +64,7 @@
 			const binary *bin = dynamic_cast<const binary*>(cur);
 			while(bin && bin->get_op() == ',')
 			{
-				const smartptr<type> &_type = bin->get_right()->get_type();
+				const smartptr<type> _type = type::resolve_typedefs(bin->get_right()->get_type());
 				const native_type *t = _type.as<native_type>();
 				if (!t)
 					return false;
@@ -73,7 +74,7 @@
 			}
 			if (!cur)
 				return false;
-			const smartptr<type> &_type = cur->get_type();
+			const smartptr<type> _type = type::resolve_typedefs(cur->get_type());
 			const native_type *t = _type.as<native_type>();
 			if (!t)
 				return false;
