From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 7 Sep 2026 20:00:00 +0800
Subject: [PATCH] parser: resolve typedefs in compute_resulting_type

compute_resulting_type() tested its operands with as<native_type>(), which
yields NULL for a typedef. Arithmetic on typedef'd scalars therefore fell
through to the "should not happen" path and produced void, which then broke
overload resolution of any call taking the result.

Unwrap type_def before the native_type test.
---
--- a/src/parser/type.cpp
+++ b/src/parser/type.cpp
@@ -18,6 +18,7 @@
 #include "type.h"
 #include "native_type.h"
 #include "pointer_type.h"
+#include "typedef.h"
 
 namespace FreeOCL
 {
@@ -25,8 +26,30 @@
 	{
 	}
 
+	smartptr<type> type::resolve_typedefs(const smartptr<type> &t)
+	{
+		smartptr<type> resolved = t;
+		bool b_const = false;
+		while (const type_def *td = resolved.as<type_def>())
+		{
+			b_const = b_const || resolved->is_const();
+			resolved = td->get_type();
+		}
+		if (resolved && b_const && !resolved->is_const())
+			return resolved->clone(true, resolved->get_address_space());
+		return resolved;
+	}
+
 	smartptr<type> type::compute_resulting_type(const smartptr<type> &t0, const smartptr<type> &t1)
 	{
+		// Resolve typedefs to their underlying type first, so arithmetic on
+		// typedef'd scalars (e.g. hashcat's u64 -> ulong) produces the correct
+		// result type instead of falling through to void.
+		if (const type_def *td0 = t0.as<type_def>())
+			return compute_resulting_type(td0->get_type(), t1);
+		if (const type_def *td1 = t1.as<type_def>())
+			return compute_resulting_type(t0, td1->get_type());
+
 		const native_type *n0 = t0.as<native_type>();
 		const native_type *n1 = t1.as<native_type>();
 		if (n0 && n1)
