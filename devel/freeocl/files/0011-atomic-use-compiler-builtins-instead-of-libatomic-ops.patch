-static inline __ulong atomic_sub(volatile __ulong *p, __ulong val)	{	return __sync_fetch_and_sub(p, val);	}
+static inline __long atomic_sub(volatile __long *p, __long val)	{	return __atomic_fetch_sub(p, val, __ATOMIC_SEQ_CST);	}
+static inline __ulong atomic_sub(volatile __ulong *p, __ulong val)	{	return __atomic_fetch_sub(p, val, __ATOMIC_SEQ_CST);	}
