--- a/include/FreeOCL/memfence.h
+++ b/include/FreeOCL/memfence.h
@@ -19,23 +19,40 @@
 #define __FREEOCL_OPENCL_C_PREINCLUDE_MEMFENCE_H__
 
 #include "sync.h"
+// On GCC/Clang use the compiler's built-in atomic fences (__atomic_*, C11
+// memory model) instead of requiring libatomic-ops. This mirrors the
+// __GNUC__ path already used in src/utils/threadpool.cpp.
+#ifndef __GNUC__
 #include "atomic_ops.h"
+#endif
 
 // Built-in memory fence functions
 
 static inline void mem_fence(cl_mem_fence_flags /*flags*/)
 {
+#ifdef __GNUC__
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+#else
 	AO_nop_full();
+#endif
 }
 
 static inline void read_mem_fence(cl_mem_fence_flags /*flags*/)
 {
+#ifdef __GNUC__
+	__atomic_thread_fence(__ATOMIC_ACQUIRE);
+#else
 	AO_nop_read();
+#endif
 }
 
 static inline void write_mem_fence(cl_mem_fence_flags /*flags*/)
 {
+#ifdef __GNUC__
+	__atomic_thread_fence(__ATOMIC_RELEASE);
+#else
 	AO_nop_write();
+#endif
 }
 
 #endif
