# The sole consumer of this port is abaddon, and its current release does not compile
# against libdave 1.3.0 release due to breaking API changes from
# https://github.com/discord/libdave/commit/6bc06a0a32badf6fe2114da081fc552621c24b34
# Therefore we use the commit immediately preceding the breakage.
github.setup        discord libdave 3eae2cdfe8d610709da46257b2d8b7f62bf53bc0
version             1.3.0
revision            0
categories          devel
license             GPL-3
maintainers         {@barracuda156 gmail.com:vital.had} openmaintainer
description         Libraries supporting Discord's Audio & Video End-to-End Encryption
long_description    {*}${description}.
homepage            https://daveprotocol.com
# distname            cpp
checksums           rmd160  a3f82d33d687b494f6b19c00230ea6466a3ac914 \
                    sha256  1de2e40629d0e8bc4bd55ec00f2f87211667cb92707de1c15280132d8d5cd453 \
                    size    134637
github.tarball_from archive

worksrcdir          ${worksrcpath}/cpp

