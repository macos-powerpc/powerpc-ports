if {${subport} eq "tree-sitter"} {
    PortGroup makefile 1.0

}

subport ${name}-cli {
    PortGroup       cargo 1.0

    revision        0

    # Built from the workspace root, whose default member is crates/cli.
    # The default feature qjs-rt embeds QuickJS through rquickjs with its bindgen feature, which needs
    # libclang at build time. Without it `tree-sitter generate` runs grammar.js with node, the default
    # --js-runtime anyway.
    build.args-append \
                    --no-default-features

    # Default to the NodeJS version we use.
    depends_run-append \
                    path:bin/node:nodejs22

    # tree-sitter compiles grammars at runtime (build, parse, test ...). Without CC in the environment it
    # uses the compiler it was built with instead of `cc`, which may not know -std=c11 (gcc-4.2 on 10.6),
    # so that compiler has to stay installed.
    patchfiles-append   patch-loader-default-cc.diff

    post-patch {
        reinplace "s|@CC@|${configure.cc}|" ${worksrcpath}/crates/loader/src/loader.rs
    }

    if {[portconfigure::compiler_is_port ${configure.compiler}]} {
        depends_run-append \
                    port:[portconfigure::compiler_port_name ${configure.compiler}]
    }

    destroot {
        xinstall -m 0755 \
            ${worksrcpath}/target/[cargo.rust_platform]/release/${name} \
            ${destroot}${prefix}/bin/
    }

    cargo.crates \
