From 3ac88a7e6c780a787b9eec3b7f83b3c56073eb6f Mon Sep 17 00:00:00 2001
From: barracuda156 <vital.had@gmail.com>
Date: Wed, 26 Aug 2026 17:48:33 +0000
Subject: [PATCH 16/21] ppc: fix icache flush and DebugBreak for Darwin

Use sys_icache_invalidate() (available since 10.5) instead of hand-rolled
dcbf/icbi loops: the CPU probe has no Darwin implementation, so the loop
would assume 128-byte cache lines, silently skipping 3/4 of the lines on
G4 (32-byte lines). It also avoids numeric-register asm syntax that the
cctools assembler rejects; same for the twge in DebugBreak.
---
 deps/v8/src/base/platform/platform-posix.cc |  5 +++++
 deps/v8/src/codegen/ppc/cpu-ppc.cc          | 12 ++++++++++++
 2 files changed, 17 insertions(+)

diff --git a/deps/v8/src/base/platform/platform-posix.cc b/deps/v8/src/base/platform/platform-posix.cc
index 5bfcc993..70b59a9c 100644
--- a/deps/v8/src/base/platform/platform-posix.cc
+++ b/deps/v8/src/base/platform/platform-posix.cc
@@ -420,7 +420,12 @@ void OS::DebugBreak() {
 #elif V8_HOST_ARCH_MIPS64
   asm("break");
 #elif V8_HOST_ARCH_PPC || V8_HOST_ARCH_PPC64
+#if V8_OS_MACOSX
+  // The cctools assembler requires symbolic register names.
+  asm("twge r2,r2");
+#else  // AIX, ELF
   asm("twge 2,2");
+#endif
 #elif V8_HOST_ARCH_IA32
   asm("int $3");
 #elif V8_HOST_ARCH_X64
diff --git a/deps/v8/src/codegen/ppc/cpu-ppc.cc b/deps/v8/src/codegen/ppc/cpu-ppc.cc
index 9559af77..82ce2ffc 100644
--- a/deps/v8/src/codegen/ppc/cpu-ppc.cc
+++ b/deps/v8/src/codegen/ppc/cpu-ppc.cc
@@ -8,6 +8,10 @@
 
 #include "src/codegen/cpu-features.h"
 
+#if V8_OS_MACOSX
+#include <libkern/OSCacheControl.h>  // sys_icache_invalidate, 10.5+
+#endif
+
 #define INSTR_AND_DATA_CACHE_COHERENCY LWSYNC
 
 namespace v8 {
@@ -15,6 +19,13 @@ namespace internal {
 
 void CpuFeatures::FlushICache(void* buffer, size_t size) {
 #if !defined(USE_SIMULATOR)
+#if V8_OS_MACOSX
+  // Let libSystem pick the cache line size: the runtime probe below has no
+  // Darwin implementation and would assume 128-byte lines, which is wrong
+  // on G4 (32-byte lines). Also avoids inline asm syntax issues with the
+  // cctools assembler.
+  sys_icache_invalidate(buffer, size);
+#else
   if (CpuFeatures::IsSupported(INSTR_AND_DATA_CACHE_COHERENCY)) {
     __asm__ __volatile__(
         "sync \n"
@@ -41,6 +52,7 @@ void CpuFeatures::FlushICache(void* buffer, size_t size) {
         : "r"(pointer));
   }
 
+#endif  // V8_OS_MACOSX
 #endif  // !USE_SIMULATOR
 }
 }  // namespace internal
