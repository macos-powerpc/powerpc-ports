From 827929f27f3d9a31879b8b504ae2087922cf7adb Mon Sep 17 00:00:00 2001
From: barracuda156 <vital.had@gmail.com>
Date: Wed, 26 Aug 2026 17:49:09 +0000
Subject: [PATCH 18/21] Fix some includes; unbreak inspector string-16.h with
 gcc

Missing <cstdint>/<memory>/<cinttypes> includes surface with newer
libstdc++. The string-16.h hash specialization guard assumed __APPLE__
implies libc++/clang; make it gcc-aware.
---
 deps/v8/src/base/logging.h                     | 1 +
 deps/v8/src/inspector/injected-script.h        | 1 +
 deps/v8/src/inspector/string-16.h              | 2 +-
 deps/v8/src/inspector/v8-runtime-agent-impl.cc | 2 +-
 deps/v8/src/inspector/v8-string-conversions.h  | 1 +
 5 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/deps/v8/src/base/logging.h b/deps/v8/src/base/logging.h
index f2f68725..ea5c91ba 100644
--- a/deps/v8/src/base/logging.h
+++ b/deps/v8/src/base/logging.h
@@ -8,6 +8,7 @@
 #include <cstring>
 #include <sstream>
 #include <string>
+#include <cstdint>
 
 #include "src/base/base-export.h"
 #include "src/base/build_config.h"
diff --git a/deps/v8/src/inspector/injected-script.h b/deps/v8/src/inspector/injected-script.h
index d007e912..080769f7 100644
--- a/deps/v8/src/inspector/injected-script.h
+++ b/deps/v8/src/inspector/injected-script.h
@@ -31,6 +31,7 @@
 #ifndef V8_INSPECTOR_INJECTED_SCRIPT_H_
 #define V8_INSPECTOR_INJECTED_SCRIPT_H_
 
+#include <memory>
 #include <unordered_map>
 #include <unordered_set>
 
diff --git a/deps/v8/src/inspector/string-16.h b/deps/v8/src/inspector/string-16.h
index c1dd5cb9..2473fb0c 100644
--- a/deps/v8/src/inspector/string-16.h
+++ b/deps/v8/src/inspector/string-16.h
@@ -149,7 +149,7 @@ String16 String16::concat(T... args) {
 
 }  // namespace v8_inspector
 
-#if !defined(__APPLE__) || defined(_LIBCPP_VERSION)
+#if !(defined(__APPLE__) && defined(__clang__)) || defined(_LIBCPP_VERSION)
 
 namespace std {
 template <>
diff --git a/deps/v8/src/inspector/v8-runtime-agent-impl.cc b/deps/v8/src/inspector/v8-runtime-agent-impl.cc
index a8aee0b7..9bfcc5dc 100644
--- a/deps/v8/src/inspector/v8-runtime-agent-impl.cc
+++ b/deps/v8/src/inspector/v8-runtime-agent-impl.cc
@@ -30,7 +30,7 @@
 
 #include "src/inspector/v8-runtime-agent-impl.h"
 
-#include <inttypes.h>
+#include <cinttypes>
 
 #include "src/debug/debug-interface.h"
 #include "src/inspector/injected-script.h"
diff --git a/deps/v8/src/inspector/v8-string-conversions.h b/deps/v8/src/inspector/v8-string-conversions.h
index c1d69c18..66b3564c 100644
--- a/deps/v8/src/inspector/v8-string-conversions.h
+++ b/deps/v8/src/inspector/v8-string-conversions.h
@@ -6,6 +6,7 @@
 #define V8_INSPECTOR_V8_STRING_CONVERSIONS_H_
 
 #include <string>
+#include <cstdint>
 
 // Conversion routines between UT8 and UTF16, used by string-16.{h,cc}. You may
 // want to use string-16.h directly rather than these.
