From 65cc761da67e0f740fe35ddcdc7c38360773e878 Mon Sep 17 00:00:00 2001
From: barracuda156 <vital.had@gmail.com>
Date: Wed, 26 Aug 2026 17:45:36 +0000
Subject: [PATCH 14/21] v8: use uint8_t for booleans visible to generated code
 or layout constants

On darwin-ppc, bool is 4 bytes by default (legacy Apple ABI), which breaks
V8's pervasive assumption of 1-byte bools in two ways:

1. ThreadLocalTop's two bool members grow the struct from 96 to 100 bytes,
   violating ThreadLocalTop::kSizeInBytes and shifting every subsequent
   IsolateData field away from its static layout constant.

2. Generated code reads C++ bool flags with 1-byte loads at offset 0. With
   a big-endian 4-byte bool the value byte is at offset 3, so such loads
   always read 0: Debug::is_active_, Debug::hook_on_function_call_,
   Isolate::promise_hook_or_async_event_delegate_,
   Isolate::promise_hook_or_debug_is_active_or_async_event_delegate_
   (these two gate promise hooks, i.e. Node's async_hooks), and
   Isolate::is_profiling_.

Use uint8_t for these members, following the existing upstream idiom
(Heap::is_marking_flag_, IsolateData::stack_is_iterable_ are already
uint8_t for exactly this reason). Also add the previously-missing static
assert for builtin_entry_table_, the one unchecked IsolateData field.

No behavior change on platforms with 1-byte bool.
---
 deps/v8/src/debug/debug.h                |  6 ++++--
 deps/v8/src/execution/isolate-data.h     |  2 ++
 deps/v8/src/execution/isolate.h          | 14 +++++++++-----
 deps/v8/src/execution/thread-local-top.h |  6 ++++--
 4 files changed, 19 insertions(+), 9 deletions(-)

diff --git a/deps/v8/src/debug/debug.h b/deps/v8/src/debug/debug.h
index eef89f93..3ba9e458 100644
--- a/deps/v8/src/debug/debug.h
+++ b/deps/v8/src/debug/debug.h
@@ -463,10 +463,12 @@ class V8_EXPORT_PRIVATE Debug {
   debug::DebugDelegate* debug_delegate_ = nullptr;
 
   // Debugger is active, i.e. there is a debug event listener attached.
-  bool is_active_;
+  // uint8_t: read with 1-byte loads from generated code; on darwin-ppc a
+  // big-endian 4-byte bool would always read as 0.
+  uint8_t is_active_;
   // Debugger needs to be notified on every new function call.
   // Used for stepping and read-only checks
-  bool hook_on_function_call_;
+  uint8_t hook_on_function_call_;
   // Suppress debug events.
   bool is_suppressed_;
   // Running liveedit.
diff --git a/deps/v8/src/execution/isolate-data.h b/deps/v8/src/execution/isolate-data.h
index 6c667751..b748c4e8 100644
--- a/deps/v8/src/execution/isolate-data.h
+++ b/deps/v8/src/execution/isolate-data.h
@@ -220,6 +220,8 @@ void IsolateData::AssertPredictableLayout() {
                 kExternalReferenceTableOffset);
   STATIC_ASSERT(offsetof(IsolateData, thread_local_top_) ==
                 kThreadLocalTopOffset);
+  STATIC_ASSERT(offsetof(IsolateData, builtin_entry_table_) ==
+                kBuiltinEntryTableOffset);
   STATIC_ASSERT(offsetof(IsolateData, builtins_) == kBuiltinsTableOffset);
   STATIC_ASSERT(offsetof(IsolateData, virtual_call_target_register_) ==
                 kVirtualCallTargetRegisterOffset);
diff --git a/deps/v8/src/execution/isolate.h b/deps/v8/src/execution/isolate.h
index 4eadb424..de49927f 100644
--- a/deps/v8/src/execution/isolate.h
+++ b/deps/v8/src/execution/isolate.h
@@ -422,7 +422,9 @@ using DebugObjectCache = std::vector<Handle<HeapObject>>;
   V(int, bytecode_and_metadata_size, 0)                                        \
   V(int, external_script_source_size, 0)                                       \
   /* true if being profiled. Causes collection of extra compile info. */       \
-  V(bool, is_profiling, false)                                                 \
+  /* uint8_t: read with 1-byte loads from generated code (CallApiCallback); */ \
+  /* on darwin-ppc a big-endian 4-byte bool would always read as 0. */         \
+  V(uint8_t, is_profiling, false)                                              \
   /* Number of CPU profilers running on the isolate. */                        \
   V(size_t, num_cpu_profilers, 0)                                              \
   /* true if a trace is being formatted through Error.prepareStackTrace. */    \
@@ -630,7 +632,7 @@ class Isolate final : private HiddenFactory {
   v8::TryCatch* try_catch_handler() {
     return thread_local_top()->try_catch_handler_;
   }
-  bool* external_caught_exception_address() {
+  uint8_t* external_caught_exception_address() {
     return &thread_local_top()->external_caught_exception_;
   }
 
@@ -1036,7 +1038,7 @@ class Isolate final : private HiddenFactory {
 
   Debug* debug() { return debug_; }
 
-  bool* is_profiling_address() { return &is_profiling_; }
+  uint8_t* is_profiling_address() { return &is_profiling_; }
   CodeEventDispatcher* code_event_dispatcher() const {
     return code_event_dispatcher_.get();
   }
@@ -1856,8 +1858,10 @@ class Isolate final : private HiddenFactory {
   debug::ConsoleDelegate* console_delegate_ = nullptr;
 
   debug::AsyncEventDelegate* async_event_delegate_ = nullptr;
-  bool promise_hook_or_async_event_delegate_ = false;
-  bool promise_hook_or_debug_is_active_or_async_event_delegate_ = false;
+  // uint8_t: read with 1-byte loads from CSA-generated builtins; on
+  // darwin-ppc a big-endian 4-byte bool would always read as 0.
+  uint8_t promise_hook_or_async_event_delegate_ = false;
+  uint8_t promise_hook_or_debug_is_active_or_async_event_delegate_ = false;
   int async_task_count_ = 0;
 
   v8::Isolate::AbortOnUncaughtExceptionCallback
diff --git a/deps/v8/src/execution/thread-local-top.h b/deps/v8/src/execution/thread-local-top.h
index 57166299..ff7fa1cb 100644
--- a/deps/v8/src/execution/thread-local-top.h
+++ b/deps/v8/src/execution/thread-local-top.h
@@ -106,13 +106,15 @@ class ThreadLocalTop {
   Address last_api_entry_ = kNullAddress;
 
   // Communication channel between Isolate::Throw and message consumers.
+  // uint8_t instead of bool: this struct's layout must match kSizeInBytes,
+  // which assumes 1-byte booleans; on darwin-ppc sizeof(bool) is 4.
   Object pending_message_obj_;
-  bool rethrowing_message_ = false;
+  uint8_t rethrowing_message_ = false;
 
   // Use a separate value for scheduled exceptions to preserve the
   // invariants that hold about pending_exception.  We may want to
   // unify them later.
-  bool external_caught_exception_ = false;
+  uint8_t external_caught_exception_ = false;
   Object scheduled_exception_;
 
   // Stack.
