PortSystem              1.0
PortGroup               active_variants 1.1
PortGroup               cmake 1.1
PortGroup               github 1.0
PortGroup               legacysupport 1.1

# clock_gettime, needed by the vendored libretro-common (features_cpu.c).
# TODO: the build can succeed without it, using internal fallback. Needs comparative testing.
# See https://github.com/libretro/libretro-common/blob/668749ae38a9e85744d1c15a652a1e8db8ab9e82/features/features_cpu.c
legacysupport.newest_darwin_requires_legacy 15

# Upstream borealis (natinusala) is dormant and its desktop support has
# rotted; xfangfang's fork, branch `wiliwili`, is the tree wiliwili itself
# vendors and the only one known to work on legacy systems. It has no
# releases, so this pins the commit wiliwili 1.6.0 uses, which was also
# the branch tip when the port was written (2026-04-25).
github.setup            xfangfang borealis 5f08b286f3df737f3321d2247a6fe633fcead03c
version                 20260425
revision                0
categories              devel graphics
maintainers             {@barracuda156 macos-powerpc.org:barracuda} openmaintainer
license                 Apache-2
description             Hardware accelerated UI library styled after the Nintendo Switch UI
long_description        borealis is a hardware accelerated, controller and touch friendly \
                        UI library written in C++, drawing via nanovg and laying out via \
                        yoga. This port installs xfangfang’s fork (the tree used by \
                        wiliwili) as a standalone static library, together with its \
                        resources and the flags needed to build against it.

checksums               rmd160  4a1ccb7a67a04743ec235fa601395f2e7820a630 \
                        sha256  ee7d7c8ba233cee10ba502638db83c4394d37e038119c05b4b0cfeefd765d700 \
                        size    7644427

github.tarball_from     archive
github.livecheck.branch wiliwili

# No submodule checkout is required: SDL and GLFW are the only submodules,
# and the port builds against MacPorts SDL2. (A GLFW backend would need
# the vendored xfangfang/glfw fork, whose IME preedit API mainline GLFW lacks,
# hence no glfw variant here.)

cmake.generator         Ninja
compiler.cxx_standard   2017

# Do not force a universal 10.15 build; adds MAC_CUSTOM_BUILD.
# This is the borealis half of the wiliwili port's
# 0002-Allow-customized-builds-on-macOS.patch.
patchfiles-append       0001-Allow-not-to-force-build-settings-for-macOS.patch

# Fix wrong clock.
# TODO: notice, this patch uses ppc_intrinsics.h, which requires our gcc build.
# TODO: see also https://github.com/libretro/libretro-common/issues/223
patchfiles-append       0002-fix-features_cpu.patch

# https://github.com/xfangfang/borealis/issues/114
patchfiles-append       0003-borealis-gl.patch

set libfmt_v            12
cmake.prefix_path-append \
                        ${prefix}/lib/libfmt${libfmt_v}/cmake

depends_build-append    path:bin/pkg-config:pkgconfig

depends_lib-append      port:libfmt${libfmt_v} \
                        port:libsdl2 \
                        port:tinyxml2 \
                        port:tweeny

# GL is required by borealis, so SDL2 must carry OpenGL support.
# Deal with that together with: https://github.com/macos-powerpc/powerpc-ports/issues/17
require_active_variants libsdl2 opengl

# borealis ships no install rules and its include tree is not namespaced
# (it has a generic compat/ directory next to borealis/), so everything
# goes under ${name} subdirectories and is exported through the
# pkg-config and CMake package files generated in post-destroot.
set brls_incdir         ${prefix}/include/${name}
set brls_libdir         ${prefix}/lib/${name}
set brls_datadir        ${prefix}/share/${name}

# Recorded for those generated files, since consumers of a static library
# have to be handed the same public flags the library was built with.
set brls_gl2            no
set brls_boost_fs       no

configure.args-append   -DBRLS_RESOURCES_DIR=${brls_datadir} \
                        -DMAC_CUSTOM_BUILD=ON \
                        -DPLATFORM_DESKTOP=ON \
                        -DUSE_BOOST_FILESYSTEM=OFF \
                        -DUSE_GL3=ON \
                        -DUSE_LIBROMFS=OFF \
                        -DUSE_SDL2=ON \
                        -DUSE_SHARED_LIB=ON \
                        -DUSE_SYSTEM_FMT=ON \
                        -DUSE_SYSTEM_SDL2=ON \
                        -DUSE_SYSTEM_TINYXML2=ON \
                        -DUSE_SYSTEM_TWEENY=ON

# The build does not pick needed flags:
configure.cppflags-append \
                        -I${prefix}/include/libfmt${libfmt_v}
configure.ldflags-append \
                        -L${prefix}/lib/libfmt${libfmt_v}

# Only the library; the top level project also defines the demo app, built
# by the +demo variant.
build.target            borealis

platform darwin {
    if {${os.major} < 13} {
        # Use OpenGL2 on legacy systems:
        configure.args-replace \
                        -DUSE_GL3=ON -DUSE_GL2=ON
        set brls_gl2    yes
    }

    if {${os.major} < 17 && ${configure.cxx_stdlib} eq "libc++"} {
        # Apple libc++ is crippled, fallback to Boost:
        PortGroup       boost 1.0

        boost.version   1.81

        configure.args-replace \
                        -DUSE_BOOST_FILESYSTEM=OFF -DUSE_BOOST_FILESYSTEM=ON
        set brls_boost_fs yes
    }
}

# Dummy variant to ensure dependencies pick the same.
variant opengl description "Ensure dependencies are installed with GL support" { }

variant demo description "Build and install the borealis demo application" {
    build.target-append borealis_demo

    post-destroot {
        xinstall -d ${destroot}${prefix}/bin
        xinstall -m 0755 ${cmake.build_dir}/borealis_demo \
            ${destroot}${prefix}/bin/borealis_demo
    }
}

default_variants        +opengl

destroot {
    # Headers, kept as the upstream include root so that the paths
    # the library's own headers use keep resolving.
    xinstall -d ${destroot}${brls_incdir}
    copy ${worksrcpath}/library/include/borealis.hpp \
         ${worksrcpath}/library/include/borealis \
         ${worksrcpath}/library/include/compat \
         ${destroot}${brls_incdir}

    # yoga is vendored and always compiled in; its headers sit at the same
    # include root, so <yoga/Yoga.h> keeps working for consumers too.
    xinstall -d ${destroot}${brls_incdir}/yoga/event
    xinstall -m 0644 \
        {*}[glob ${worksrcpath}/library/lib/extern/yoga/yoga/*.h] \
        ${destroot}${brls_incdir}/yoga
    xinstall -m 0644 \
        {*}[glob ${worksrcpath}/library/lib/extern/yoga/yoga/event/*.h] \
        ${destroot}${brls_incdir}/yoga/event

    # Static libraries. Upstream defines no install rules and does not set
    # an archive output directory, so collect what the build produced and
    # verify the two expected archives are among them.
    xinstall -d ${destroot}${brls_libdir}
    set brls_built  {}
    fs-traverse f ${cmake.build_dir} {
        if {[file isfile ${f}] && [file extension ${f}] eq ".a"} {
            xinstall -m 0644 ${f} ${destroot}${brls_libdir}
            lappend brls_built [file tail ${f}]
        }
    }
    foreach lib {libborealis.a libyogacore.a} {
        if {[lsearch -exact ${brls_built} ${lib}] == -1} {
            return -code error "${lib} was not built"
        }
    }

    # Resources (fonts, icons, i18n, XML layouts). borealis finds these
    # through the BRLS_RESOURCES define baked in at build time, which
    # -DBRLS_RESOURCES_DIR above points here.
    xinstall -d ${destroot}${brls_datadir}
    copy ${worksrcpath}/resources ${destroot}${brls_datadir}
    delete ${destroot}${brls_datadir}/resources/.gitignore

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} AUTHORS LICENSE NOTICE README.md \
        ${destroot}${prefix}/share/doc/${name}
}

post-destroot {
    # Flags a consumer needs: the include roots borealis adds to its own
    # target, the defines its public headers require (assets.hpp #errors
    # without BRLS_RESOURCES) and the full static link line.
    set brls_cflags [list -I${brls_incdir} \
                          -I${brls_incdir}/borealis/extern \
                          -I${brls_incdir}/borealis/extern/nanovg \
                          -I${prefix}/include/libfmt${libfmt_v} \
                          -I${prefix}/include/tweeny]

    set brls_defines [list __SDL2__ YG_ENABLE_EVENTS BOREALIS_USE_OPENGL]
    if {${brls_gl2}} {
        lappend brls_defines USE_GL2
    }

    set brls_libs [list ${brls_libdir}/libborealis.a \
                        ${brls_libdir}/libyogacore.a \
                        -L${prefix}/lib/libfmt${libfmt_v} -lfmt \
                        -L${prefix}/lib -ltinyxml2]

    if {${brls_boost_fs}} {
        lappend brls_libs -L[boost::lib_dir] -lboost_filesystem-mt
    }

    set brls_legacy_libs [legacysupport::get_library_link_flags]
    if {${brls_legacy_libs} ne ""} {
        lappend brls_libs {*}${brls_legacy_libs}
    }

    if {${os.platform} eq "darwin"} {
        # Mirrors the framework list in library/CMakeLists.txt.
        lappend brls_libs -lobjc \
            "-framework SystemConfiguration" "-framework Cocoa" \
            "-framework IOKit" "-framework CoreFoundation" \
            "-framework AppKit" "-framework Foundation" \
            "-framework CoreServices"
        if {[vercmp ${macosx_deployment_target} 10.6] >= 0} {
            lappend brls_libs "-framework CoreWLAN"
        }
        if {[vercmp ${macosx_deployment_target} 10.7] >= 0} {
            lappend brls_libs "-framework CoreGraphics"
        } else {
            lappend brls_libs "-framework ApplicationServices"
        }
    }

    # BRLS_RESOURCES has to expand to a string literal, and no quoting of
    # it survives `cc $(pkg-config --cflags borealis)`: the shell splits
    # words after command substitution but never removes quotes, so
    # the compiler is handed the quotes or backslashes verbatim. Ship
    # the define in a header force-included from Cflags instead; the path
    # is also available as `pkg-config --variable=resourcesdir borealis`.
    set brls_config_h ${brls_incdir}/${name}_config.h
    set cfg [open ${destroot}${brls_config_h} w 0644]
    puts ${cfg} "/* Generated by the MacPorts ${name} port -- do not edit. */"
    puts ${cfg} "#pragma once"
    puts ${cfg} ""
    puts ${cfg} "#ifndef BRLS_RESOURCES"
    puts ${cfg} "#define BRLS_RESOURCES \"${brls_datadir}/resources/\""
    puts ${cfg} "#endif"
    close ${cfg}

    # pkg-config: SDL2 comes in through Requires, everything else is
    # spelled out because libfmt${libfmt_v} and the vendored bits are not
    # in the default search paths.
    set brls_pc_cflags  ${brls_cflags}
    foreach def ${brls_defines} {
        lappend brls_pc_cflags -D${def}
    }
    lappend brls_pc_cflags -include ${brls_config_h}

    xinstall -d ${destroot}${prefix}/lib/pkgconfig
    set pc [open ${destroot}${prefix}/lib/pkgconfig/${name}.pc w 0644]
    puts ${pc} "# Generated by the MacPorts ${name} port."
    puts ${pc} "prefix=${prefix}"
    puts ${pc} "includedir=${brls_incdir}"
    puts ${pc} "libdir=${brls_libdir}"
    puts ${pc} "resourcesdir=${brls_datadir}/resources"
    puts ${pc} ""
    puts ${pc} "Name: ${name}"
    puts ${pc} "Description: ${description}"
    puts ${pc} "Version: ${version}"
    puts ${pc} "URL: ${homepage}"
    puts ${pc} "Requires: sdl2"
    puts ${pc} "Cflags: [join ${brls_pc_cflags}]"
    puts ${pc} "Libs: [join ${brls_libs}]"
    close ${pc}

    # CMake package config: same information, plus SDL2, as an imported
    # interface target. Paths are absolute on purpose -- this file is
    # generated for this prefix and never relocated.
    set brls_cmake_incdirs [list ${brls_incdir} \
                                 ${brls_incdir}/borealis/extern \
                                 ${brls_incdir}/borealis/extern/nanovg \
                                 ${prefix}/include/libfmt${libfmt_v} \
                                 ${prefix}/include/tweeny \
                                 ${prefix}/include/SDL2]
    set brls_cmake_defs ${brls_defines}
    lappend brls_cmake_defs "BRLS_RESOURCES=\\\"${brls_datadir}/resources/\\\""
    set brls_cmake_libs ${brls_libs}
    lappend brls_cmake_libs -L${prefix}/lib -lSDL2

    set brls_cmake_config {# Generated by the MacPorts @NAME@ port -- do not edit.

# Defines the imported target @NAME@::@NAME@ for the static library
# installed by MacPorts, carrying the include roots, public defines and
# link line it was built with.

if(TARGET @NAME@::@NAME@)
    return()
endif()

set(BOREALIS_VERSION "@VERSION@")
set(BOREALIS_RESOURCES_DIR "@RESOURCESDIR@")
set(BOREALIS_INCLUDE_DIRS "@INCDIRS@")
set(BOREALIS_COMPILE_DEFINITIONS "@DEFINES@")
set(BOREALIS_LIBRARIES "@LIBS@")

add_library(@NAME@::@NAME@ INTERFACE IMPORTED)
set_target_properties(@NAME@::@NAME@ PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${BOREALIS_INCLUDE_DIRS}"
    INTERFACE_COMPILE_DEFINITIONS "${BOREALIS_COMPILE_DEFINITIONS}"
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_LINK_LIBRARIES "${BOREALIS_LIBRARIES}")
}

    set brls_cmake_version {# Generated by the MacPorts @NAME@ port -- do not edit.
set(PACKAGE_VERSION "@VERSION@")
if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()
}

    set brls_cmake_map [list \
        @NAME@         ${name} \
        @VERSION@      ${version} \
        @RESOURCESDIR@ ${brls_datadir}/resources \
        @INCDIRS@      [join ${brls_cmake_incdirs} ";"] \
        @DEFINES@      [join ${brls_cmake_defs} ";"] \
        @LIBS@         [join ${brls_cmake_libs} ";"]]

    xinstall -d ${destroot}${prefix}/lib/cmake/${name}
    set cm [open ${destroot}${prefix}/lib/cmake/${name}/${name}-config.cmake w 0644]
    puts -nonewline ${cm} [string map ${brls_cmake_map} ${brls_cmake_config}]
    close ${cm}
    set cv [open ${destroot}${prefix}/lib/cmake/${name}/${name}-config-version.cmake w 0644]
    puts -nonewline ${cv} [string map ${brls_cmake_map} ${brls_cmake_version}]
    close ${cv}
}

notes "
borealis installs as a static library; nothing links it for you. Build\
against it either with pkg-config:

    pkg-config --cflags --libs borealis

or from CMake:

    find_package(borealis REQUIRED)
    target_link_libraries(myapp PRIVATE borealis::borealis)

Both carry the defines the public headers need. BRLS_RESOURCES, which\
points at ${prefix}/share/${name}/resources/ and is also compiled into\
the library, comes from the CMake package directly and from a force-included\
${prefix}/include/${name}/${name}_config.h under pkg-config. To ship your\
own copy of the resources tree, define BRLS_RESOURCES yourself before\
those flags; the installed path is also available as\
`pkg-config --variable=resourcesdir ${name}`.
"
