PortSystem          1.0
PortGroup           cmake   1.1
PortGroup           github  1.0

github.setup        simdjson simdjson 5.1.1 v
revision            0
categories          devel
license             Apache-2
maintainers         nomaintainer
homepage            https://simdjson.org
description         C++ library for parsing gigabytes of JSON per second
long_description    \
    The ${name} library uses commonly available SIMD instructions \
    and microparallel algorithms to parse JSON 4x faster than RapidJSON \
    and 25x faster than JSON for Modern C++.

github.tarball_from archive
checksums           ${distname}${extract.suffix} \
                    rmd160  76d1a1a0f7d0d9cc81f17ea39158b623acbfa9e9 \
                    sha256  d669fa399613c20bbf7705f057a72984331b223cd5e8d20666ef063dbf97f3e6 \
                    size    8817228

patchfiles          patch-build-flags-on-x86.diff \
                    patch-macho-compatibility-version.diff

# The library itself is built as C++17 (SIMDJSON_CXX_STANDARD).
compiler.cxx_standard   2017

configure.args-append \
                    -DBUILD_SHARED_LIBS=ON

# Upstream's release script bumps the soversion on every minor release,
# whatever the ABI does: 5.0.8 and 5.1.0 changed nothing the library shares
# with its dependents, while 5.0.7 changed the parser implementation's vtable
# and layout under the old soversion. Name the library after the major
# version instead and record additions in the Mach-O compatibility version:
# libsimdjson.5.dylib, current ${version}, compatibility <major>.<minor>.0.
# Before an update run files/simdjsonabi.py abi on the old and new source
# trees; if a reported difference is a real break, pin a new SOVERSION here
# (e.g. 5.2) and revbump devel/apache-arrow, lang/nodejs24 and
# www/ladybird-headless.
set simdjson_v          [split ${version} .]
configure.args-append   -DSIMDJSON_LIB_SOVERSION=[lindex ${simdjson_v} 0] \
                        -DSIMDJSON_LIB_VERSION=${version} \
                        -DSIMDJSON_LIB_MACHO_COMPATIBILITY_VERSION=[lindex ${simdjson_v} 0].[lindex ${simdjson_v} 1].0

# The "ppc64" kernel with plain-AltiVec replacements for its VSX/POWER8
# operations, enabled on 32-bit PowerPC (files/patch-altivec.diff, written
# for this port; validate with +tests before relying on it). -maltivec
# applies to the whole library, which is a single translation unit, so
# a G4 or later is required. The portable kernel stays in the library:
# SIMDJSON_FORCE_IMPLEMENTATION=fallback switches a process back to it.
variant altivec description "Use the AltiVec (VMX) kernel; requires a G4 or later" {
    patchfiles-append       patch-altivec.diff
    configure.cflags-append -maltivec
    configure.cxxflags-append \
                            -maltivec \
                            -DSIMDJSON_IMPLEMENTATION_FALLBACK=1
}

# The test suite (developer mode), offline: the simdjson-data corpus is
# a distfile, and what would need further downloads (tools, competition
# benchmarks) is skipped, as are the fuzzers. Run with port test.
set data_commit         351949906abde446f0314bf79606fb5d884f5be7
variant tests description {Build the test suite} {
    master_sites-append     https://github.com/simdjson/simdjson-data/archive/:data
    distfiles-append        ${data_commit}.zip:data
    checksums-append        ${data_commit}.zip \
                            rmd160  8c3f3b9e06ffc6a7654be244e28ef6adb41074f8 \
                            sha256  a2623f4cbe5ee988c00ff26549dd0e7738b25938fd4d6e5f1f7d10faf748a884 \
                            size    7188926
    extract.only            ${distname}${extract.suffix}
    depends_extract-append  bin:unzip:unzip

    post-extract {
        system -W ${workpath} "unzip -q ${distpath}/${data_commit}.zip"
    }

    configure.args-append   -DSIMDJSON_DEVELOPER_MODE=ON \
                            -DSIMDJSON_ALLOW_DOWNLOADS=OFF \
                            -DSIMDJSON_ENABLE_FUZZING=OFF \
                            -DCPM_simdjson-data_SOURCE=${workpath}/simdjson-data-${data_commit}

    # The test binaries must load the library from the build tree.
    configure.pre_args-replace \
                            -DCMAKE_BUILD_WITH_INSTALL_RPATH:BOOL=ON \
                            -DCMAKE_BUILD_WITH_INSTALL_RPATH:BOOL=OFF

    test.run                yes
}
