-#else
+#elif SIMDJSON_REGULAR_VISUAL_STUDIO
   answer.low = _umul128(value1, value2, &answer.high); // _umul128 not available on ARM64
+#else
+  // 32-bit without MSVC: no __uint128_t and no _umul128.  Same algorithm
+  // as umul128_generic in compile_time_json-inl.h.
+  uint64_t ad = uint64_t(uint32_t(value1 >> 32)) * uint32_t(value2);
+  uint64_t bd = uint64_t(uint32_t(value1)) * uint32_t(value2);
+  uint64_t adbc = ad + uint64_t(uint32_t(value1)) * uint32_t(value2 >> 32);
+  uint64_t adbc_carry = uint64_t(adbc < ad);
+  answer.low = bd + (adbc << 32);
+  answer.high = uint64_t(uint32_t(value1 >> 32)) * uint32_t(value2 >> 32) +
+                (adbc >> 32) + (adbc_carry << 32) + uint64_t(answer.low < bd);
 #endif // SIMDJSON_IS_ARM64
 #else // SIMDJSON_REGULAR_VISUAL_STUDIO || SIMDJSON_IS_32BITS
   __uint128_t r = (static_cast<__uint128_t>(value1)) * value2;
