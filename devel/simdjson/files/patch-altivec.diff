 using __m128i = __vector unsigned char;
 
+// This kernel predates VSX-less systems and used POWER7/POWER8 operations
+// (vec_vsx_ld/vec_vsx_st, vbpermq, the 2x64 vector type) unconditionally.
+// Apple PowerPC CPUs (G4/G5) have AltiVec/VMX only, so each such use now
+// carries a VMX replacement; the guards keep the original instructions on
+// every CPU that has them.
+//
+// VMX has no unaligned vector load: the classic lvx/lvsl/vperm idiom loads
+// the two 16-byte lines containing [ptr, ptr+15] and permutes.  lvx masks
+// its address to 16-byte alignment, so the idiom never touches memory
+// outside those lines; simdjson's SIMDJSON_PADDING contract (checked in
+// intrinsics.h) keeps that in-bounds at buffer ends, matching what
+// vec_vsx_ld already read.
+#ifndef __VSX__
+simdjson_inline __m128i vmx_loadu(const uint8_t *bytes) {
+  __m128i lo = vec_ld(0, bytes);
+  __m128i hi = vec_ld(15, bytes);
+  return vec_perm(lo, hi, vec_lvsl(0, bytes));
+}
+#endif
