+#ifndef SDL_cocoaframebuffer_h_
+#define SDL_cocoaframebuffer_h_
+
+/* A plain software framebuffer for Cocoa windows, presented with
+   CoreGraphics. SDL's generic code prefers a renderer-backed texture
+   framebuffer when an accelerated renderer (OpenGL, Metal) is available
+   and only falls back to this one when there is none - e.g. builds
+   without OpenGL - or when SDL_HINT_FRAMEBUFFER_ACCELERATION is "0". */
+
+extern int Cocoa_CreateWindowFramebuffer(_THIS, SDL_Window *window, Uint32 *format, void **pixels, int *pitch);
+extern int Cocoa_UpdateWindowFramebuffer(_THIS, SDL_Window *window, const SDL_Rect *rects, int numrects);
+extern void Cocoa_DestroyWindowFramebuffer(_THIS, SDL_Window *window);
+
+/* Paints the current framebuffer image into a view drawing context, for
+   -[NSView drawRect:]. Returns SDL_FALSE if the window has no framebuffer. */
+extern SDL_bool Cocoa_DrawWindowFramebuffer(SDL_Window *window, CGContextRef context, CGRect bounds);
+
+#endif /* SDL_cocoaframebuffer_h_ */
