From a7bb952294e9c853fe3dfb488a5be72a0e8af795 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 27 Nov 2026 02:58:04 +0000
Subject: [PATCH] fix enum_switch and enum_index for bool enums when
 sizeof(bool) == sizeof(int)

switch_t used int only when the underlying type was smaller than int.
On PowerPC Darwin sizeof(bool) is 4, so an enum with bool underlying
type got bool as its switch type, and fill_cases then applied ++/--
to bool, which is ill-formed since C++17. A bool also cannot hold the
distinct padding labels a switch page needs.

Use the integral-promoted underlying type instead, which is the type
a switch condition is converted to anyway.

Fixes #488

Assisted-by: Claude Opus 5.5
---
 include/magic_enum/magic_enum.hpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/magic_enum/magic_enum.hpp b/include/magic_enum/magic_enum.hpp
index 75d961f..2658497 100644
--- include/magic_enum/magic_enum.hpp
+++ include/magic_enum/magic_enum.hpp
@@ -1766,7 +1766,7 @@ constexpr decltype(auto) invoke_constant(F&& f, std::integral_constant<T, V>&& v
 }
 
 template <typename E>
-using switch_t = std::conditional_t<(sizeof(std::underlying_type_t<E>) < sizeof(int)), int, std::underlying_type_t<E>>;
+using switch_t = decltype(+std::declval<std::underlying_type_t<E>>());
 
 // Padding labels must be distinct from real cases and from each other.
 // Only the last page needs padding, so labels may reuse values from earlier pages.
