From b63639f3c717a20b4cd0a948fdf7c81a7a7df1bc Mon Sep 17 00:00:00 2001
From: neargye <neargye@gmail.com>
Date: Fri, 27 Nov 2026 14:03:45 +0400
Subject: [PATCH] fix portability issues with wide bool and char signedness

diff --git a/include/magic_enum/magic_enum.hpp b/include/magic_enum/magic_enum.hpp
index 75d961f14..36265b3ac 100644
--- include/magic_enum/magic_enum.hpp
+++ include/magic_enum/magic_enum.hpp
@@ -458,8 +458,9 @@ class static_str {
 
 template <typename Op = std::equal_to<>>
 class case_insensitive {
-  static constexpr char_type to_lower(char_type c) noexcept {
-    return (c >= char_type{'A'} && c <= char_type{'Z'}) ? static_cast<char_type>(c + (char_type{'a'} - char_type{'A'})) : c;
+  // Unsigned like std::char_traits, so the order does not depend on char signedness.
+  static constexpr auto to_lower(char_type c) noexcept {
+    return static_cast<std::make_unsigned_t<char_type>>((c >= char_type{'A'} && c <= char_type{'Z'}) ? static_cast<char_type>(c + (char_type{'a'} - char_type{'A'})) : c);
   }
 
  public:
@@ -1765,8 +1766,9 @@ constexpr decltype(auto) invoke_constant(F&& f, std::integral_constant<T, V>&& v
   }
 }
 
-template <typename E>
-using switch_t = std::conditional_t<(sizeof(std::underlying_type_t<E>) < sizeof(int)), int, std::underlying_type_t<E>>;
+// bool can be as wide as int, see #488.
+template <typename E, typename U = std::underlying_type_t<E>>
+using switch_t = std::conditional_t<std::is_same_v<U, bool> || (sizeof(U) < sizeof(int)), int, U>;
 
 // Padding labels must be distinct from real cases and from each other.
 // Only the last page needs padding, so labels may reuse values from earlier pages.
diff --git a/test/test_containers.cpp b/test/test_containers.cpp
index b4531e6a5..dbbd0fcd2 100644
--- test/test_containers.cpp
+++ test/test_containers.cpp
@@ -1596,6 +1596,9 @@ TEST_CASE("containers_set") {
   auto blue_ci_by_string = color_ci_name_set.find(blue_name_lower_string);
   REQUIRE(blue_ci_by_string != color_ci_name_set.end());
   REQUIRE(*blue_ci_by_string == Color::BLUE);
+  // Non-ASCII bytes sort after ASCII like name_less, whatever the signedness of char.
+  REQUIRE(name_bounds_set.upper_bound("\xE6") == name_bounds_set.end());
+  REQUIRE(color_ci_name_set.upper_bound("\xE6") == color_ci_name_set.end());
 
   magic_enum::containers::set<EquivalentNames, magic_enum::containers::name_less_case_insensitive> equivalent_name_set {EquivalentNames::A, EquivalentNames::a};
   REQUIRE(equivalent_name_set.size() == 2);
diff --git a/test/test_wchar_t.cpp b/test/test_wchar_t.cpp
index f6438c756..571255427 100644
--- test/test_wchar_t.cpp
+++ test/test_wchar_t.cpp
@@ -17,7 +17,7 @@
 #include "test_helpers.hpp"
 
 #include <array>
-#include <cctype>
+#include <cwctype>
 #include <iomanip>
 #include <sstream>
 
@@ -62,7 +62,7 @@ TEST_CASE("enum_cast") {
     constexpr auto cr = enum_cast<Color>(L"red");
     REQUIRE(cr.value() == Color::RED);
     REQUIRE(enum_cast<Color&>(L"GREEN").value() == Color::GREEN);
-    REQUIRE(enum_cast<Color>(L"blue", [](wchar_t lhs, wchar_t rhs) { return std::tolower(lhs) == std::tolower(rhs); }).value() == Color::BLUE);
+    REQUIRE(enum_cast<Color>(L"blue", [](wchar_t lhs, wchar_t rhs) { return std::towlower(static_cast<std::wint_t>(lhs)) == std::towlower(static_cast<std::wint_t>(rhs)); }).value() == Color::BLUE);
     REQUIRE_FALSE(enum_cast<Color>(L"None").has_value());
   }
 
