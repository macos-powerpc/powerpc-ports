Do not dereference a missing hwloc Core object

enforce_hwloc_2_5_runtime_linkage() passes the first HWLOC_OBJ_CORE
object to hwloc_get_obj_with_same_locality() without checking it. hwloc
does not report Core objects on every system (e.g. Mac OS X on PowerPC),
so this is a NULL dereference as soon as TCM is enabled or tbbbind is
loaded:
  EXC_BAD_ACCESS (SIGBUS) KERN_PROTECTION_FAILURE at 0x0
  libhwloc.15.dylib  hwloc_get_obj_with_same_locality + 56

The tbbbind hunk is a backport of upstream 2deef980 (#2194), which is
not in 2023.2.0. TCM has the same code and is still unguarded upstream.

diff --git src/tbbbind/tbb_bind.cpp src/tbbbind/tbb_bind.cpp
index 26fa6747..2adccea5 100644
--- src/tbbbind/tbb_bind.cpp
+++ src/tbbbind/tbb_bind.cpp
@@ -268,7 +268,9 @@ private:
         // this function calls the interface that is available in the HWLOC 2.5 only.
 #if HWLOC_API_VERSION >= 0x20500
         auto some_core = hwloc_get_next_obj_by_type(topology, HWLOC_OBJ_CORE, nullptr);
-        hwloc_get_obj_with_same_locality(topology, some_core, HWLOC_OBJ_CORE, nullptr, nullptr, 0);
+        if (some_core) {
+            hwloc_get_obj_with_same_locality(topology, some_core, HWLOC_OBJ_CORE, nullptr, nullptr, 0);
+        }
 #endif
     }
 
diff --git thread_composability_manager/src/detail/hwloc_utils.h thread_composability_manager/src/detail/hwloc_utils.h
index a2cc6e7f..bc6833db 100644
--- thread_composability_manager/src/detail/hwloc_utils.h
+++ thread_composability_manager/src/detail/hwloc_utils.h
@@ -286,7 +286,9 @@ private:
         // this function calls the interface that is available in the HWLOC 2.5 only.
 #if HWLOC_API_VERSION >= 0x20500
         auto some_core = hwloc_get_next_obj_by_type(topology, HWLOC_OBJ_CORE, nullptr);
-        hwloc_get_obj_with_same_locality(topology, some_core, HWLOC_OBJ_CORE, nullptr, nullptr, 0);
+        if (some_core) {
+            hwloc_get_obj_with_same_locality(topology, some_core, HWLOC_OBJ_CORE, nullptr, nullptr, 0);
+        }
 #endif
