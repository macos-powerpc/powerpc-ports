TCM: do not query CPU binding on macOS

hwloc has no CPU binding support on macOS, so hwloc_get_cpubind() fails
and leaves the process mask empty. TCM then sees a process concurrency
of 0 and hands out no resources once TCM_ENABLE=1. Use the complete
cpuset and nodeset on Apple, as tbbbind does when __TBB_CPUBIND_PRESENT
is 0.

diff --git thread_composability_manager/src/detail/hwloc_utils.h thread_composability_manager/src/detail/hwloc_utils.h
index a2cc6e7f..b7788d18 100644
--- thread_composability_manager/src/detail/hwloc_utils.h
+++ thread_composability_manager/src/detail/hwloc_utils.h
@@ -156,6 +156,7 @@ private:
 #endif
 
         // Getting process affinity mask
+#if !__APPLE__
         if ( intergroup_binding_allowed(groups_num) ) {
             process_cpu_affinity_mask  = hwloc_bitmap_dup(hwloc_topology_get_complete_cpuset (topology));
             process_node_affinity_mask = hwloc_bitmap_dup(hwloc_topology_get_complete_nodeset(topology));
@@ -169,6 +170,10 @@ private:
                                         process_node_affinity_mask);
             __TCM_ASSERT_EX(r >= 0, "hwloc_cpuset_to_nodeset error.");
         }
+#else
+        process_cpu_affinity_mask  = hwloc_bitmap_dup(hwloc_topology_get_complete_cpuset (topology));
+        process_node_affinity_mask = hwloc_bitmap_dup(hwloc_topology_get_complete_nodeset(topology));
+#endif
 
         number_of_processors_groups = groups_num;
     }
