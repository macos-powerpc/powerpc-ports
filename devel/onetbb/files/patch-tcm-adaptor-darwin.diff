Load TCM on macOS

tcm_adaptor.cpp defines the TCM library name only for Windows and
__unix__, which Darwin compilers do not define, so TBB tried to
dlopen("tcm") and never found it. Use libtcm.1.dylib, which is what
CMake produces for SOVERSION 1.

TCM is also loaded by bare name so that the system loader can search
for it. dyld resolves a bare leaf name only through DYLD_LIBRARY_PATH,
LD_LIBRARY_PATH and DYLD_FALLBACK_LIBRARY_PATH (older dyld also tries
the current directory), never the directory of the calling library,
so libtcm in a non-default prefix is not found. On Apple, build the
path from the libtbb location, as is done for tbbmalloc and tbbbind.

diff --git src/tbb/tcm_adaptor.cpp src/tbb/tcm_adaptor.cpp
index 098948bd..fb3de62f 100644
--- src/tbb/tcm_adaptor.cpp
+++ src/tbb/tcm_adaptor.cpp
@@ -83,6 +83,9 @@ static const dynamic_link_descriptor tcm_link_table[] = {
 #elif __unix__
 #define LIBRARY_EXTENSION ".so.1"
 #define LIBRARY_PREFIX "lib"
+#elif __APPLE__
+#define LIBRARY_EXTENSION ".1.dylib"
+#define LIBRARY_PREFIX "lib"
 #else
 #define LIBRARY_EXTENSION
 #define LIBRARY_PREFIX
@@ -245,9 +248,13 @@ tcm_result_t renegotiation_callback(tcm_permit_handle_t, void* client_ptr, tcm_c
 
 void tcm_adaptor::initialize() {
     constexpr std::size_t tcm_link_table_size = sizeof(tcm_link_table) / sizeof(tcm_link_table[0]);
+#if __APPLE__
+    constexpr int flags = DYNAMIC_LINK_DEFAULT;
+#else
     // Allow system loader to search for TCM in the environment rather than load it from certain
     // location.
     constexpr int flags = DYNAMIC_LINK_DEFAULT & ~DYNAMIC_LINK_BUILD_ABSOLUTE_PATH;
+#endif
     tcm_functions_loaded = dynamic_link(TCMLIB_NAME, tcm_link_table, tcm_link_table_size,
                                         /*handle*/nullptr, flags);
 }
