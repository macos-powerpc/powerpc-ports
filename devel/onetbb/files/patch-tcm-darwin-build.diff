Fix TCM build on macOS

TCM picks the GNU ld version script for every UNIX, which includes
macOS, so linking libtcm fails with ld64:
  ld: unknown options: --version-script=.../src/def/lin.def
Use an exported symbols list on Apple instead, as libtbb does. The TCM
API is extern "C", so one list serves both 32- and 64-bit.

GNU.cmake and Clang.cmake also pass -Wl,-z,relro,-z,now,-z,noexecstack,
which ld64 does not support; skip them on Apple, as TBB's GNU.cmake does.

See: https://github.com/uxlfoundation/oneTBB/issues/2241

diff --git thread_composability_manager/cmake/compilers/Clang.cmake thread_composability_manager/cmake/compilers/Clang.cmake
index 43337e76..2f0679c6 100644
--- thread_composability_manager/cmake/compilers/Clang.cmake
+++ thread_composability_manager/cmake/compilers/Clang.cmake
@@ -36,7 +36,10 @@ endif()
 
 set(TCM_LIB_COMPILE_FLAGS ${TCM_LIB_COMPILE_FLAGS} $<$<NOT:$<CONFIG:Debug>>:-flto>)
 
-set(TCM_LIB_LINK_FLAGS ${TCM_LIB_LINK_FLAGS} $<$<NOT:$<CONFIG:Debug>>:-flto> -Wl,-z,relro,-z,now,-z,noexecstack)
+set(TCM_LIB_LINK_FLAGS ${TCM_LIB_LINK_FLAGS} $<$<NOT:$<CONFIG:Debug>>:-flto>)
+if (NOT APPLE)
+    set(TCM_LIB_LINK_FLAGS ${TCM_LIB_LINK_FLAGS} -Wl,-z,relro,-z,now,-z,noexecstack)
+endif()
 if (WIN32)
    # The "/DEPENDENTLOADFLAG:0x2000" restricts the loader to look for dependencies in current
    # working directory only if it is in the so-called "Safe load list".
diff --git thread_composability_manager/cmake/compilers/GNU.cmake thread_composability_manager/cmake/compilers/GNU.cmake
index 067ea546..69193813 100644
--- thread_composability_manager/cmake/compilers/GNU.cmake
+++ thread_composability_manager/cmake/compilers/GNU.cmake
@@ -34,5 +34,8 @@ if (CMAKE_SYSTEM_PROCESSOR MATCHES "(AMD64|amd64|i.86|x86)")
     )
 endif()
 
-set(TCM_LIB_LINK_FLAGS ${TCM_LIB_LINK_FLAGS} $<$<NOT:$<CONFIG:Debug>>:-flto>  -Wl,-z,relro,-z,now,-z,noexecstack)
+set(TCM_LIB_LINK_FLAGS ${TCM_LIB_LINK_FLAGS} $<$<NOT:$<CONFIG:Debug>>:-flto>)
+if (NOT APPLE)
+    set(TCM_LIB_LINK_FLAGS ${TCM_LIB_LINK_FLAGS} -Wl,-z,relro,-z,now,-z,noexecstack)
+endif()
 set(TCM_COMPILE_DEFINITIONS "")
diff --git thread_composability_manager/src/CMakeLists.txt thread_composability_manager/src/CMakeLists.txt
index 9d3484d4..b9ddd23b 100644
--- thread_composability_manager/src/CMakeLists.txt
+++ thread_composability_manager/src/CMakeLists.txt
@@ -97,6 +97,9 @@ set_target_properties(tcm PROPERTIES
 if (WIN32 AND NOT MINGW)
     set(TCM_LINK_DEF_FILE_FLAG ${CMAKE_LINK_DEF_FILE_FLAG})
     set(TCM_DEF_FILE_PREFIX win)
+elseif (APPLE)
+    set(TCM_LINK_DEF_FILE_FLAG -Wl,-exported_symbols_list,)
+    set(TCM_DEF_FILE_PREFIX mac)
 elseif (UNIX)
     set(TCM_LINK_DEF_FILE_FLAG -Wl,--version-script=)
     set(TCM_DEF_FILE_PREFIX lin)
