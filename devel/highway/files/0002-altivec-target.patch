+// Two 32-bit halves of each of the 64-bit lanes {t0, t1}, in memory order.
+HWY_INLINE RawAltivec64 RawAltivec64FromU64(uint64_t t0, uint64_t t1) {
+  const unsigned int lo0 = static_cast<unsigned int>(t0 & 0xFFFFFFFFu);
+  const unsigned int hi0 = static_cast<unsigned int>(t0 >> 32);
+  const unsigned int lo1 = static_cast<unsigned int>(t1 & 0xFFFFFFFFu);
+  const unsigned int hi1 = static_cast<unsigned int>(t1 >> 32);
+#if HWY_IS_LITTLE_ENDIAN
+  const __vector unsigned int raw = {lo0, hi0, lo1, hi1};
+#else
+  const __vector unsigned int raw = {hi0, lo0, hi1, lo1};
+#endif
+  return RawAltivec64{raw};
+}
+
+HWY_INLINE uint64_t U64LaneFromRawAltivec64(RawAltivec64 raw, size_t i) {
+#if HWY_IS_LITTLE_ENDIAN
+  const uint64_t lo = raw.v[2 * i];
