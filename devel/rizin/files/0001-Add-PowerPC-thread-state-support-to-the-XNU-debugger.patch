+#if __POWERPC__
+static void xnu_thread_ppc_select_state(RzXnuDebug *ctx, xnu_thread_t *thread) {
+	RZ_REG_T *regs = &thread->gpr;
+	if (ctx->cpu == CPU_TYPE_POWERPC64) {
+		thread->flavor = PPC_THREAD_STATE64;
+		thread->count = PPC_THREAD_STATE64_COUNT;
+		thread->state_size = sizeof(regs->ts64);
+		thread->state = &regs->ts64;
+	} else {
+		thread->flavor = PPC_THREAD_STATE;
+		thread->count = PPC_THREAD_STATE_COUNT;
+		thread->state_size = sizeof(regs->ts32);
+		thread->state = &regs->ts32;
+	}
+}
+#endif
+
 RZ_IPI bool rz_xnu_thread_set_gpr(RzXnuDebug *ctx, xnu_thread_t *thread) {
 	rz_return_val_if_fail(ctx && thread, false);
 	kern_return_t rc;
