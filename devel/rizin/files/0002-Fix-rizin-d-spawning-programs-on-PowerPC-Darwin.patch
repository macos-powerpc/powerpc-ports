From d80dd1dce3a186ae77e22945e1abd6e70164fab6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 7 Nov 2026 04:17:22 +0000
Subject: [PATCH 2/2] Fix `rizin -d` spawning programs on PowerPC Darwin

* The fork path set `PT_SIGEXC` before any exception port existed, so the exec SIGTRAP was lost and the child ran free
* Use posix_spawn with START_SUSPENDED on ppc 10.5+, without the 10.8+ CLOEXEC_DEFAULT bits
* Ignore the pid of a failed posix_spawn, xnu-1228 reports the already exited child

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
Co-authored-by agent: Claude Code/Claude Opus 5.5
---
 librz/io/p/io_debug.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/librz/io/p/io_debug.c b/librz/io/p/io_debug.c
index d03148f..e943b51 100644
--- a/librz/io/p/io_debug.c
+++ b/librz/io/p/io_debug.c
@@ -26,9 +26,15 @@
 
 // POSIX_SPAWN_CLOEXEC_DEFAULT is available since macOS 10.7, but known to cause kernel panics until 10.8.
 #if __APPLE__ && defined(MAC_OS_X_VERSION_10_8)
-#define USE_POSIX_SPAWN 1
+#define USE_POSIX_SPAWN         1
+#define USE_POSIX_SPAWN_CLOEXEC 1
+// The fork path loses the exec SIGTRAP on ppc, posix_spawn with START_SUSPENDED exists since 10.5
+#elif __APPLE__ && __POWERPC__ && __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ >= 1050
+#define USE_POSIX_SPAWN         1
+#define USE_POSIX_SPAWN_CLOEXEC 0
 #else
-#define USE_POSIX_SPAWN 0
+#define USE_POSIX_SPAWN         0
+#define USE_POSIX_SPAWN_CLOEXEC 0
 #endif
 
 #include <signal.h>
@@ -276,11 +282,13 @@ static int fork_and_ptraceme_for_unix(RzIO *io, int bits, const char *cmd) {
 	posix_spawnattr_setsigdefault(&attr, &all_signals);
 
 	posix_spawn_file_actions_init(&fileActions);
+#if USE_POSIX_SPAWN_CLOEXEC
 	posix_spawn_file_actions_addinherit_np(&fileActions, STDIN_FILENO);
 	posix_spawn_file_actions_addinherit_np(&fileActions, STDOUT_FILENO);
 	posix_spawn_file_actions_addinherit_np(&fileActions, STDERR_FILENO);
 
 	ps_flags |= POSIX_SPAWN_CLOEXEC_DEFAULT;
+#endif
 	ps_flags |= POSIX_SPAWN_START_SUSPENDED;
 #define _POSIX_SPAWN_DISABLE_ASLR 0x0100
 	int ret;
@@ -309,6 +317,10 @@ static int fork_and_ptraceme_for_unix(RzIO *io, int bits, const char *cmd) {
 		posix_spawnattr_setbinpref_np(&attr, 1, &cpu, &copied);
 		ret = posix_spawnp(&p, rp->_args[0], &fileActions, &attr, rp->_args, NULL);
 		handle_posix_error(ret);
+		if (ret) {
+			// xnu-1228 reports the pid of the already exited child on failure
+			p = -1;
+		}
 	}
 	rz_str_argv_free(argv);
 	rz_run_free(rp);
-- 
