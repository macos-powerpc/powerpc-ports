From 86927672761e174da872addf0e494e21f2b2aa08 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 7 Nov 2026 04:32:35 +0000
Subject: [PATCH 3/3] Fix posix_spawn never being used for `rizin -d` on macOS

* `MAC_OS_X_VERSION_10_8` comes from AvailabilityMacros.h, which io_debug.c did not include, so the fork path was always used
* Builds with a 10.8+ SDK now spawn with START_SUSPENDED and CLOEXEC_DEFAULT as intended

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
Co-authored-by agent: Claude Code/Claude Opus 5.5
---
 librz/io/p/io_debug.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/librz/io/p/io_debug.c b/librz/io/p/io_debug.c
index e943b51..8f90bcc 100644
--- a/librz/io/p/io_debug.c
+++ b/librz/io/p/io_debug.c
@@ -24,6 +24,10 @@
 #if DEBUGGER && DEBUGGER_SUPPORTED
 #define MAGIC_EXIT 123
 
+#if __APPLE__
+#include <AvailabilityMacros.h>
+#endif
+
 // POSIX_SPAWN_CLOEXEC_DEFAULT is available since macOS 10.7, but known to cause kernel panics until 10.8.
 #if __APPLE__ && defined(MAC_OS_X_VERSION_10_8)
 #define USE_POSIX_SPAWN         1
-- 
2.43.0

