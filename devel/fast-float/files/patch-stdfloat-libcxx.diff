Use std::floatN_t only when <stdfloat> is available

GCC defines __STDCPP_FLOAT16_T__ and friends in C++23 mode whatever the C++
library, but libc++ has no <stdfloat>. fast_float includes the header only if
__has_include finds it, yet used the types whenever the macros were defined,
so with g++ -std=c++23 -stdlib=libc++ even float/double parsing failed to
compile ('float64_t' is not a member of 'std').

--- include/fast_float/float_common.h.orig
+++ include/fast_float/float_common.h
@@ -12,8 +12,13 @@
 #ifdef __has_include
 #if __has_include(<stdfloat>) && (__cplusplus > 202002L || (defined(_MSVC_LANG) && (_MSVC_LANG > 202002L)))
 #include <stdfloat>
+#define FASTFLOAT_HAS_STDFLOAT 1
 #endif
 #endif
+// GCC defines __STDCPP_FLOAT*_T__ also with libc++, which has no <stdfloat>.
+#ifndef FASTFLOAT_HAS_STDFLOAT
+#define FASTFLOAT_HAS_STDFLOAT 0
+#endif
 #include "constexpr_feature_detect.h"
 
 #define FASTFLOAT_VERSION_MAJOR 8
@@ -309,16 +314,16 @@
 struct is_supported_float_type
     : std::integral_constant<
           bool, std::is_same<T, double>::value || std::is_same<T, float>::value
-#ifdef __STDCPP_FLOAT64_T__
+#if FASTFLOAT_HAS_STDFLOAT && defined(__STDCPP_FLOAT64_T__)
                     || std::is_same<T, std::float64_t>::value
 #endif
-#ifdef __STDCPP_FLOAT32_T__
+#if FASTFLOAT_HAS_STDFLOAT && defined(__STDCPP_FLOAT32_T__)
                     || std::is_same<T, std::float32_t>::value
 #endif
-#ifdef __STDCPP_FLOAT16_T__
+#if FASTFLOAT_HAS_STDFLOAT && defined(__STDCPP_FLOAT16_T__)
                     || std::is_same<T, std::float16_t>::value
 #endif
-#ifdef __STDCPP_BFLOAT16_T__
+#if FASTFLOAT_HAS_STDFLOAT && defined(__STDCPP_BFLOAT16_T__)
                     || std::is_same<T, std::bfloat16_t>::value
 #endif
           > {
@@ -774,7 +779,7 @@
 }
 
