--- glib/gthread.c.orig
+++ glib/gthread.c
@@ -1183,9 +1183,17 @@
   {
     int32_t pcore_count = 0;
     size_t len = sizeof (pcore_count);
+    int count;
+
     if (sysctlbyname ("hw.perflevel0.logicalcpu", &pcore_count, &len, NULL, 0) == 0 &&
         pcore_count > 0)
       return pcore_count;
+
+    /* hw.perflevel0 only exists on macOS 12+; fall back for older systems
+     * and Intel/PowerPC Macs instead of returning 1 */
+    count = sysconf (_SC_NPROCESSORS_ONLN);
+    if (count > 0)
+      return count;
   }
 #elif defined(_SC_NPROCESSORS_ONLN) && defined(THREADS_POSIX) && defined(HAVE_PTHREAD_GETAFFINITY_NP)
   {
