+/* -[NSFileManager trashItemAtURL:resultingItemURL:error:] only exists on
+ * 10.8+. On older systems fall back to NSWorkspace's recycle operation.
+ * Also avoid @autoreleasepool, boxed expressions and dot syntax, so that
+ * this builds with older compilers (including GCC) and SDKs. */
 
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 1080
 static GIOErrorEnum
 ns_error_to_gio_error (NSError *error)
 {
-  switch (error.code)
+  switch ([error code])
     {
     case NSFileNoSuchFileError:
       return G_IO_ERROR_NOT_FOUND;
@@ -47,37 +60,113 @@
     }
 }
 
+static gboolean
+trash_with_file_manager (NSString      *ns_path,
+                         GCancellable  *cancellable,
+                         GError       **error)
+{
+  NSURL *url;
+  NSError *ns_error = nil;
+
+  url = [NSURL fileURLWithPath:ns_path];
+
+  if (![[NSFileManager defaultManager] trashItemAtURL:url resultingItemURL:NULL error:&ns_error])
+    {
+      if (g_cancellable_set_error_if_cancelled (cancellable, error))
+        return FALSE;
+
+      g_set_error_literal (error,
+                           G_IO_ERROR,
+                           ns_error_to_gio_error (ns_error),
+                           [[ns_error localizedDescription] UTF8String]);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+#endif
+
+#if MAC_OS_X_VERSION_MIN_REQUIRED < 1080
+static gboolean
+trash_with_workspace (NSString    *ns_path,
+                      const char  *path,
+                      GError     **error)
+{
+  GStatBuf buf;
+  NSArray *files;
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 1050
+  NSInteger tag = 0;
+#else
+  int tag = 0;
+#endif
+
+  /* NSWorkspace gives no error details, so catch the common cases first */
+  if (g_lstat (path, &buf) != 0)
+    {
+      int errsv = errno;
+
+      g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errsv),
+                   _("Error trashing file %s: %s"),
+                   path, g_strerror (errsv));
+      return FALSE;
+    }
+
+  files = [NSArray arrayWithObject:[ns_path lastPathComponent]];
+
+  if (![[NSWorkspace sharedWorkspace] performFileOperation:NSWorkspaceRecycleOperation
+                                                    source:[ns_path stringByDeletingLastPathComponent]
+                                               destination:@""
+                                                     files:files
+                                                       tag:&tag] || tag < 0)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                   _("Unable to trash file %s"), path);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+#endif
