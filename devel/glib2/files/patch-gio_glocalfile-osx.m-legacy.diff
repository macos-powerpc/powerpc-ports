-    NSError *ns_error = nil;
-    NSFileManager *file_manager;
-
-    url = [NSURL fileURLWithPath:@(path)];
-    file_manager = [NSFileManager defaultManager];
-
-    if (![file_manager trashItemAtURL:url resultingItemURL:NULL error:&ns_error])
-      {
-        if (g_cancellable_set_error_if_cancelled (cancellable, error))
-          return FALSE;
-
-        g_set_error_literal (error,
-                             G_IO_ERROR,
-                             ns_error_to_gio_error (ns_error),
-                             ns_error.localizedDescription.UTF8String);
-        return FALSE;
-      }
-  }
+  pool = [[NSAutoreleasePool alloc] init];
 
-  return TRUE;
+  ns_path = [[NSFileManager defaultManager] stringWithFileSystemRepresentation:path
+                                                                        length:strlen (path)];
+  if (ns_path == nil)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_FILENAME,
+                   _("Unable to trash file %s"), path);
+      ret = FALSE;
+    }
+  else
+    {
+#if MAC_OS_X_VERSION_MIN_REQUIRED >= 1080
