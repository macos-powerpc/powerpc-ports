From 08fe8ce6c179f54548be98705d4df72f8d013f02 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 28 Aug 2026 07:26:47 +0000
Subject: [PATCH 12/12] Mono.Net.Security: prefer btls over appletls when it is
 available

On macOS the default TLS provider was AppleTlsProvider whenever
MONO_FEATURE_APPLETLS is compiled in, with btls only reachable through
MONO_TLS_PROVIDER=btls.  That default is wrong on old macOS:
AppleTlsContext P/Invokes SSLCreateContext, which only exists in
SecureTransport on macOS 10.8+, and even where the older API exists it
tops out at TLS 1.0.  BTLS provides TLS 1.2.

Prefer btls for the "default"/"legacy" selection when the runtime
was built with it (IsBtlsSupported), falling back to appletls as
before.  Builds without btls are unaffected, and MONO_TLS_PROVIDER can
still select any provider explicitly.
---
 .../System/Mono.Net.Security/MonoTlsProviderFactory.cs | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/mcs/class/System/Mono.Net.Security/MonoTlsProviderFactory.cs b/mcs/class/System/Mono.Net.Security/MonoTlsProviderFactory.cs
index 21c3737..31be574 100644
--- a/mcs/class/System/Mono.Net.Security/MonoTlsProviderFactory.cs
+++ b/mcs/class/System/Mono.Net.Security/MonoTlsProviderFactory.cs
@@ -269,7 +269,7 @@ namespace Mono.Net.Security
 			}
 #endif
 
-			var defaultEntry = appleTlsEntry ?? btlsEntry;
+			var defaultEntry = btlsEntry ?? appleTlsEntry;
 			if (defaultEntry != null) {
 				providerRegistration.Add ("default", defaultEntry);
 				providerRegistration.Add ("legacy", defaultEntry);
@@ -311,13 +311,13 @@ namespace Mono.Net.Security
 			switch (type) {
 			case "default":
 			case "legacy":
-#if MONO_FEATURE_APPLETLS
-				if (Platform.IsMacOS)
-					goto case "apple";
-#endif
 #if MONO_FEATURE_BTLS
 				if (IsBtlsSupported ())
 					goto case "btls";
+#endif
+#if MONO_FEATURE_APPLETLS
+				if (Platform.IsMacOS)
+					goto case "apple";
 #endif
 				throw new NotSupportedException ("TLS Support not available.");
 #if MONO_FEATURE_APPLETLS
