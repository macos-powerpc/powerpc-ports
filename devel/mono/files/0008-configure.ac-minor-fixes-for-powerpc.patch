Subject: [PATCH 08/12] configure.ac: minor fixes for powerpc

---
 configure.ac | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/configure.ac b/configure.ac
index b386345..702069f 100644
--- a/configure.ac
+++ b/configure.ac
@@ -4565,6 +4565,11 @@ case "$host" in
 			BTLS_SUPPORTED=yes
 			BTLS_PLATFORM=powerpc
 			;;
+		  darwin*)
+			BTLS_SUPPORTED=no
+			BTLS_PLATFORM=powerpc
+			with_tls=pthread
+			;;
 		esac
 		;;
 	armv7k-*-darwin*)
