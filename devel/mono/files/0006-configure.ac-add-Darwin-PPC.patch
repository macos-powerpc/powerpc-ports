From 36c9aad65395515a0c0dfbdd2743aacb0f66fb6c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Sat, 6 May 2023 00:25:51 +0800
Subject: [PATCH 06/10] configure.ac: add Darwin PPC

[edited for 6.12.0.205: also widen powerpc-*-darwin* to powerpc*-*-darwin*
in the main arch case so a powerpc64-apple-darwin host reaches the
POWERPC64 target instead of falling through as unsupported.]
---
 configure.ac | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index 19b20127c..ea0009fb3 100644
--- a/configure.ac
+++ b/configure.ac
@@ -438,6 +438,14 @@ case "$host" in
 				RID="osx-x64"
 				COREARCH="x64"
 				;;
+			powerpc-*-darwin*)
+				COREARCH="ppc"
+				PPC32_LDFLAGS="-latomic"
+				LDFLAGS="$LDFLAGS $PPC32_LDFLAGS"
+				;;
+			powerpc64-*-darwin*)
+				COREARCH="ppc64"
+				;;
 			arm*-darwin*)
 				platform_ios=yes
 				has_dtrace=no
@@ -4489,7 +4497,7 @@ case "$host" in
 		esac
 		;;
 	macppc-*-openbsd* | powerpc*-*-linux* | powerpc-*-openbsd* | \
-        powerpc-*-sysv* | powerpc-*-darwin* | powerpc-*-netbsd* | \
+        powerpc-*-sysv* | powerpc*-*-darwin* | powerpc-*-netbsd* | \
         powerpc*-*-freebsd* | powerpc*-*-aix* | powerpc*-*-os400* )
 		if test "x$ac_cv_sizeof_void_p" = "x8"; then
 			TARGET=POWERPC64;
-- 
