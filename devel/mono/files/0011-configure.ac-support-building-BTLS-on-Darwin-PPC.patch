From b5763d6399228bf0e8c8e278a36f56162ce5ccca Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 8 Sep 2026 05:23:42 +0000
Subject: [PATCH 11/12] configure.ac: support building BTLS on Darwin PPC

BoringSSL's generic C paths already build on big-endian PowerPC (AIX
and os400 are supported configurations), so all Darwin needs is
-DOPENSSL_NO_ASM=1: there is no Mach-O PowerPC perlasm target and the
generic-C fallback is what the other big-endian platforms use anyway.

This does not change the default: BTLS_SUPPORTED stays off for Darwin
PPC, so btls is only built when configured with
--enable-btls --enable-btls-lib.
---
 configure.ac | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/configure.ac b/configure.ac
index d933189..034c34b 100644
--- a/configure.ac
+++ b/configure.ac
@@ -6029,6 +6029,10 @@ if test "x$enable_btls" = "xyes"; then
 			aix*|os400*)
 				btls_cflags="$btls_cflags -maix64 -mminimal-toc -pthread -D_ALL_SOURCE -D_THREAD_SAFE -D_REENTRANT"
 				BTLS_CMAKE_ARGS="$BTLS_CMAKE_ARGS -DCMAKE_AR=/usr/bin/ar -DCMAKE_C_ARCHIVE_CREATE=\"<CMAKE_AR> -X64 cr <TARGET> <LINK_FLAGS> <OBJECTS>\""
+				;;
+			darwin*)
+				# BoringSSL has no Mach-O PowerPC assembly, build plain C.
+				BTLS_CMAKE_ARGS="$BTLS_CMAKE_ARGS -DOPENSSL_NO_ASM=1"
 		esac
 		;;
 	android-armv5)
