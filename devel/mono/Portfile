# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               legacysupport 1.1

# clock_gettime
legacysupport.newest_darwin_requires_legacy 15

name                    mono
# please update msbuild when updating mono
version                 6.14.1
revision                0
epoch                   1
categories              devel lang mono
platforms               darwin
license                 {GPL-2 LGPL-2 MIT}
maintainers             {@barracuda156 macos-powerpc.org:barracuda} openmaintainer
description             Implementation of the .NET Development Framework
long_description        Mono is an effort to create an open source implementation of the .NET \
                        Development Framework including a C# compiler.

homepage                https://www.mono-project.com

# Mono is maintained by WineHQ since 2024 (https://gitlab.winehq.org/mono/mono,
# mirrored at https://github.com/wine-mono/mono). Release tarballs are
# published on dl.winehq.org; they vendor all git submodules and the monolite
# bootstrap compiler, so no network access and no pre-installed mono are
# needed to build. (The GitHub auto-generated archives lack the submodules.)
master_sites            https://dl.winehq.org/mono/sources/mono/
use_xz                  yes
checksums               rmd160  a4bb090ce3857f5143e5944965f3d63bfe19ea2b \
                        sha256  3024c97c0bc8cbcd611c401d5f994528704108ceb31f31b28dea4783004d0820 \
                        size    303688164

universal_variant       no
use_parallel_build      no

post-extract {
    # always bootstrap the class libraries with the bundled monolite,
    # never with a previously installed (possibly older) mono
    xinstall -d ${worksrcpath}/mcs/build/deps
    close [open ${worksrcpath}/mcs/build/deps/use-monolite w]
}

patch.pre_args-replace  -p0 -p1
patchfiles              patch-aot-compiler.c.diff

# 0001-0009: PowerPC/Darwin support, see: https://github.com/barracuda156/mono
#       (rebased from 6.12.0.205; 6.14.x continues the old mono main branch)
# 0010: make --disable-gss work, see: https://github.com/mono/mono/issues/20990
# 0011: allow building BTLS on Darwin PPC (used by the btls variant)
# 0012: prefer btls over appletls when built; appletls needs SecureTransport
#       APIs from macOS 10.8+ and never speaks more than TLS 1.0 (no-op
#       unless btls is actually built)
# patch-corefx-fsw-osx-mcs: downgrade C# 8 syntax in the macOS-only
#       FileSystemWatcher (upstream only ever compiled it with csc;
#       big-endian hosts build with mcs)
patchfiles-append       0001-utils-mono-proclib.c-unbreak-build-on-10.9.patch \
                        0002-utils-mono-context.h-unbreak-context-for-macOS-PPC.patch \
                        0003-mono-config-fix-PPC.patch \
                        0004-On-ppc-use-8-byte-__atomic-not-__sync.patch \
                        0005-sgen-archdep-fix-red-zone-for-ppc64.patch \
                        0006-configure.ac-add-Darwin-PPC.patch \
                        0007-utils-initial-mach-support-for-PPC.patch \
                        0008-configure.ac-minor-fixes-for-powerpc.patch \
                        0009-utils-mono-threads-mach.c-fix-for-missing-pthread_th.patch \
                        0010-configure.ac-make-GSS-support-optional-and-fix-its-d.patch \
                        0011-configure.ac-support-building-BTLS-on-Darwin-PPC.patch \
                        0012-Mono.Net.Security-prefer-btls-over-appletls-when-it-.patch

# Fix compiling corefx with C# 7.3:
patchfiles-append       patch-corefx-fsw-osx-mcs.diff

post-patch {
    # ensure we are UsingTheRightCompiler
    # (https://trac.macports.org/wiki/UsingTheRightCompiler)
    reinplace "s:__MACPORTS_CC__:${configure.cc}:g" \
        ${worksrcpath}/mono/mini/aot-compiler.c
}

# configure.ac and mono/utils/Makefile.am are patched
use_autoreconf          yes
autoreconf.args         -fvi

set py_ver              3.14
set py_ver_nodot        [string map {. {}} ${py_ver}]

depends_build-append    port:gettext \
                        path:bin/perl:perl5 \
                        path:bin/pkg-config:pkgconfig \
                        port:python${py_ver_nodot}

depends_lib-append      port:gettext-runtime \
                        port:libiconv \
                        port:zlib

configure.python        ${prefix}/bin/python${py_ver}

configure.args          --disable-boehm \
                        --disable-btls \
                        --disable-gss \
                        --enable-dtrace=no \
                        --enable-nls \
                        --with-csc=mcs \
                        --with-libgdiplus=${prefix}/lib/libgdiplus.dylib \
                        --with-mcs-docs=no \
                        --with-sigaltstack=no

compiler.cxx_standard   2011

# avoid conflict with port brotli (mono bundles its own copy)
configure.cppflags-delete -I${prefix}/include
configure.ldflags-delete  -L${prefix}/lib

if {${configure.build_arch} in [list ppc ppc64]} {
    # make sure endianness is never misdetected
    configure.args-append \
                        ac_cv_c_bigendian=yes
}

variant btls description "Build the BoringSSL-based TLS 1.2 provider and make it the default" {
    depends_build-append    path:bin/cmake:cmake
    depends_run-append      port:curl-ca-bundle

    configure.args-replace  --disable-btls --enable-btls
    configure.args-append   --enable-btls-lib

    patchfiles-append       patch-btls-no-ccache.diff

    notes-append "
btls keeps its own certificate store; import a CA bundle once with:
    ${prefix}/bin/cert-sync ${prefix}/share/curl/curl-ca-bundle.crt
The default TLS provider is btls; set MONO_TLS_PROVIDER=apple to use
SecureTransport instead (requires macOS 10.8 or later).
"
}

default_variants-append +btls

post-destroot {
    set docdir ${prefix}/share/doc/${name}

    xinstall -d ${destroot}${docdir}
    xinstall -m 0644 -W ${worksrcpath} COPYING.LIB LICENSE NEWS README.md \
        ${destroot}${docdir}
}

livecheck.type          regex
livecheck.url           ${master_sites}
livecheck.regex         ${name}-(\[0-9.\]+)\.tar\.xz
