+/// Get the macOS deployment target version of a PowerPC build
+///
+/// `MACOSX_DEPLOYMENT_TARGET` if it is set, else the default of `rustc_macosx_target_version`.
+/// Unlike for x86_64 and arm64 there is no rustc minimum to raise it to.
+fn macosx_powerpc_deployment_target(
+    target_triple: &str,
+    deploy_target: Option<&str>,
+) -> Result<(u16, u16)> {
+    let deploy_target = match deploy_target {
+        Some(deploy_target) => deploy_target,
+        None => return Ok(rustc_macosx_target_version(target_triple)),
+    };
+    let err_ctx = "MACOSX_DEPLOYMENT_TARGET is invalid";
+    let mut parts = deploy_target.split('.');
+    let major = parts.next().context(err_ctx)?;
+    let major: u16 = major.parse().context(err_ctx)?;
+    let minor = parts.next().context(err_ctx)?;
+    let minor: u16 = minor.parse().context(err_ctx)?;
+    Ok((major, minor))
+}
+
+/// macOS version of the running system, from the Darwin kernel release
+/// (Darwin 8 = 10.4, 9 = 10.5, 10 = 10.6, 20 = 11)
+fn host_macos_version() -> Option<(u16, u16)> {
+    let info = PlatformInfo::new().ok()?;
+    if info.sysname().to_string_lossy() != "Darwin" {
+        return None;
+    }
+    let release = info.release().to_string_lossy().into_owned();
+    let darwin: u16 = release.split('.').next()?.parse().ok()?;
+    if darwin >= 20 {
+        Some((darwin - 9, 0))
+    } else if darwin >= 5 {
+        Some((10, darwin - 4))
+    } else {
+        None
+    }
+}
