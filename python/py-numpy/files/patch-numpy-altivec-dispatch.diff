 }
 
+#if !HWY_HAVE_FLOAT64
+// Highway has no float64 vectors on this target (e.g. AltiVec without VSX);
+// provide a scalar specialization so ``double`` still has a working symbol at
+// link time and the primary template body above doesn't try to instantiate
+// ``VQSortStatic<double>``.
+template <>
+void NPY_CPU_DISPATCH_CURFX(QSort)<double>(double *arr, npy_intp size, bool reverse)
+{
+    if (reverse) {
+        sort::Quick<true>(arr, size);
+    }
+    else {
+        sort::Quick<false>(arr, size);
+    }
+}
+#endif // !HWY_HAVE_FLOAT64
