PortSystem          1.0
PortGroup           python 1.0

# also update py-pycryptodome
name                py-pycryptodomex
version             3.24.1
revision            0

license             BSD
maintainers         nomaintainer

description         Cryptographic library for Python
long_description    {*}${description}

homepage            https://www.pycryptodome.org

checksums           rmd160  9ef8f6fffe15c44e11e0606c8c326071b733e0fa \
                    sha256  09081666ffc599976c0b8b29caf2cf82212c0f05bed233c8f8ed53e4f6e1d356 \
                    size    4934627

python.versions     27 310 311 312 313 314 315

if {${subport} ne ${name}} {
    PortGroup       legacysupport 1.1

    # posix_memalign
    legacysupport.newest_darwin_requires_legacy 9

    platform darwin {
        # src/ec_ws.c: error: ‘for’ loop initial declaration used outside C99 mode
        # For 3.12 python PG should do this, but does not; and 3.13+ use modern gcc.
        if {${python.version} < 313} {
            configure.cflags-append \
                    -std=c99
        }
        if {${os.major} < 10} {
            configure.cflags-append \
                    -isystem${prefix}/include/LegacySupport -DHAVE_POSIX_MEMALIGN \
                    -Wl,-lMacportsLegacySupport
        }
        build.cmd-prepend \
                    CFLAGS="${configure.cflags} [get_canonical_archflags cc]"
    }

    test.run        yes
    python.test_framework
    test.cmd        ${python.bin} setup.py test
}
