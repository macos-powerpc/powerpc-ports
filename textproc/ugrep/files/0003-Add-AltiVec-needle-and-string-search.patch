+/// My homegrown "needle search" methods for pins
+#define ADV_PAT_PIN(N, INIT, COMP) \
+bool Matcher::advance_pattern_pin##N##_pma(size_t loc) \
+{ \
+  const char *chr = pat_->chr_; \
+  const uint16_t min = pat_->min_; \
+  const uint16_t lcp = pat_->lcp_; \
+  const uint16_t lcs = pat_->lcs_; \
+  INIT \
+  while (true) \
+  { \
+    const char *s = buf_ + loc + lcp; \
+    const char *e = buf_ + end_ + lcp - min + 1; \
+    simd_ldu_t ctlp = simd_ldu_init(s); \
+    simd_ldu_t ctls = simd_ldu_init(s + lcs - lcp); \
+    while (s <= e - 16) \
+    { \
+      __vector unsigned char vstrlcp = simd_ldu(s, ctlp); \
+      __vector unsigned char vstrlcs = simd_ldu(s + lcs - lcp, ctls); \
+      __vector unsigned char veqlcp = (__vector unsigned char)vec_cmpeq(vlcp0, vstrlcp); \
+      __vector unsigned char veqlcs = (__vector unsigned char)vec_cmpeq(vlcs0, vstrlcs); \
+      COMP \
+      __vector unsigned char vmask = vec_and(veqlcp, veqlcs); \
+      if (REFLEX_UNLIKELY(simd_mask_any(vmask))) \
+      { \
+        ADV_ALTIVEC_SCAN(vmask, static_cast<size_t>(s - lcp - buf_), \
+          if (REFLEX_UNLIKELY(k + Pattern::Const::PM_M > end_) || pat_->predict_match(&buf_[k])) \
+          { \
+            set_current(k); \
+            return true; \
+          } \
+        ) \
+      } \
+      s += 16; \
+    } \
+    s -= lcp; \
+    e = buf_ + end_ - (Pattern::Const::PM_M - 1); \
+    while (s < e) \
+    { \
+      if (pat_->predict_match(s++)) \
+      { \
+        size_t k = s - buf_ - 1; \
+        set_current(k); \
+        return true; \
+      } \
+    } \
+    loc = s - buf_; \
+    set_current_and_peek_more(loc); \
+    loc = cur_; \
+    if (loc + min > end_ && eof_) \
+      return false; \
+    if (loc + (Pattern::Const::PM_M - 1) >= end_) \
+      return true; \
+  } \
+}
