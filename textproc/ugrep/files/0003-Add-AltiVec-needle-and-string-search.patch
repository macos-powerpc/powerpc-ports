+/// My homegrown "needle search" methods for pins with min=0 or 1
+#define ADV_PAT_PIN_ONE(N, INIT, COMP) \
+bool Matcher::advance_pattern_pin##N##_one(size_t loc) \
+{ \
+  const char *chr = pat_->chr_; \
+  INIT \
+  while (true) \
+  { \
+    const char *s = buf_ + loc; \
+    const char *e = buf_ + end_; \
+    simd_ldu_t ctl = simd_ldu_init(s); \
+    while (s <= e - 16) \
+    { \
+      __vector unsigned char vstr = simd_ldu(s, ctl); \
+      __vector unsigned char veq = (__vector unsigned char)vec_cmpeq(v0, vstr); \
+      COMP \
+      if (REFLEX_UNLIKELY(simd_mask_any(veq))) \
+      { \
+        ADV_ALTIVEC_SCAN(veq, static_cast<size_t>(s - buf_), \
+          if (REFLEX_UNLIKELY(k + Pattern::Const::PM_M > end_) || pat_->predict_match(&buf_[k])) \
+          { \
+            set_current(k); \
+            return true; \
+          } \
+        ) \
+      } \
+      s += 16; \
+    } \
+    while (s < e - (Pattern::Const::PM_M - 1)) \
+    { \
+      if (pat_->predict_match(s++)) \
+      { \
+        size_t k = s - buf_ - 1; \
+        set_current(k); \
+        return true; \
+      } \
+    } \
+    loc = s - buf_; \
+    set_current_and_peek_more(loc); \
+    loc = cur_; \
+    if (loc + (Pattern::Const::PM_M - 1) >= end_) \
+      return true; \
+  } \
+}
