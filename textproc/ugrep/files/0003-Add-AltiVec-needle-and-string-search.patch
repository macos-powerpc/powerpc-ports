 namespace reflex {
 
+#if defined(HAVE_ALTIVEC)
+
+/// Scan a 16 byte compare mask for matching byte positions, AltiVec has no _mm_movemask_epi8() so the
+/// mask is stored and its bytes are scanned, BODY runs per match with k set to the position in buf_.
+/// Only reached when simd_mask_any() says there is a match, so the store stays off the hot path.
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#define ADV_ALTIVEC_SCAN_TEST 0x000000ff
+#define ADV_ALTIVEC_SCAN_STEP >>=
+#else
+#define ADV_ALTIVEC_SCAN_TEST 0xff000000
+#define ADV_ALTIVEC_SCAN_STEP <<=
+#endif
+
+#define ADV_ALTIVEC_SCAN(VMASK, BASE, BODY) \
+  do \
+  { \
+    simd_mask_t vres_; \
+    vres_.v = (VMASK); \
+    for (uint32_t w_ = 0; w_ < 4; ++w_) \
+    { \
+      uint32_t mask_ = vres_.u[w_]; \
+      if (mask_ != 0) \
+      { \
+        size_t k = (BASE) + 4 * w_; \
+        do \
+        { \
+          if ((mask_ & ADV_ALTIVEC_SCAN_TEST) != 0) { BODY } \
+          mask_ ADV_ALTIVEC_SCAN_STEP 8; \
+          ++k; \
+        } while (mask_ != 0); \
+      } \
+    } \
+  } while (0);
+
+#endif // HAVE_ALTIVEC
