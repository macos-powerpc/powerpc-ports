+// Implements the AltiVec/VMX string search scheme based on http://0x80.pl/articles/simd-friendly-karp-rabin.html
+bool Matcher::simd_advance_string_altivec(const char *& s, const char *e)
+{
+  const uint16_t lcp = pat_->lcp_;
+  const uint16_t lcs = pat_->lcs_;
+  const uint16_t len = pat_->len_;
+  const char *chr = pat_->chr_;
+  __vector unsigned char vlcp = simd_set1_u8(chr[lcp]);
+  __vector unsigned char vlcs = simd_set1_u8(chr[lcs]);
+  // the loops advance s by 16, so the alignment of both streams never changes: hoist the load controls
+  simd_ldu_t ctlp = simd_ldu_init(s);
+  simd_ldu_t ctls = simd_ldu_init(s + lcs - lcp);
+  while (s <= e - 16)
+  {
+    __vector unsigned char vlcpm = simd_ldu(s, ctlp);
+    __vector unsigned char vlcsm = simd_ldu(s + lcs - lcp, ctls);
+    __vector unsigned char vlcpeq = (__vector unsigned char)vec_cmpeq(vlcp, vlcpm);
+    __vector unsigned char vlcseq = (__vector unsigned char)vec_cmpeq(vlcs, vlcsm);
+    __vector unsigned char vmask = vec_and(vlcpeq, vlcseq);
+    if (REFLEX_UNLIKELY(simd_mask_any(vmask)))
+    {
+      ADV_ALTIVEC_SCAN(vmask, static_cast<size_t>(s - lcp - buf_),
+        if (std::memcmp(&buf_[k], chr, len) == 0)
+        {
+          set_current(k);
+          return true;
+        }
+      )
+    }
+    s += 16;
+  }
+  return false;
