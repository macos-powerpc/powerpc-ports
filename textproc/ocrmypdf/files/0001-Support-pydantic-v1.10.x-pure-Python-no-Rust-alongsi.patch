diff --git a/tests/test_pydantic_compat.py b/tests/test_pydantic_compat.py
new file mode 100644
index 0000000..cf8ba95
--- /dev/null
+++ b/tests/test_pydantic_compat.py
@@ -0,0 +1,87 @@
+# SPDX-FileCopyrightText: 2026 James R. Barlow
+# SPDX-License-Identifier: MPL-2.0
+
+"""Option-model behaviors that must hold on both pydantic v1 and v2.
+
+These pin down the places where the two pydantic majors disagree in ways that
+matter for option parsing (see ocrmypdf._pydantic_compat), so that a change to
+the option models cannot silently regress whichever major is not installed.
+"""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+import pytest
+
+from ocrmypdf._options import OcrOptions
+from ocrmypdf._pydantic_compat import PYDANTIC_V2, ConfigDict
+
+
+def make(**kwargs):
+    kwargs.setdefault('input_file', 'in.pdf')
+    kwargs.setdefault('output_file', 'out.pdf')
+    return OcrOptions(**kwargs)
+
+
+@pytest.mark.parametrize(
+    'value', ['-', 'in.pdf', b'in.pdf', Path('in.pdf'), io.BytesIO(b'')]
+)
+def test_file_arguments_keep_their_type(value):
+    """A str must stay a str: '-' is the stdin/stdout sentinel, not a Path."""
+    opts = OcrOptions(input_file=value, output_file=value, sidecar=value)
+    assert type(opts.input_file) is type(value)
+    assert type(opts.output_file) is type(value)
+    assert type(opts.sidecar) is type(value)
+
+
+@pytest.mark.parametrize('value', [None, 42, ['in.pdf']])
+def test_file_arguments_reject_other_types(value):
+    with pytest.raises(ValueError, match='input_file'):
+        OcrOptions(input_file=value, output_file='out.pdf')
+
+
+def test_file_arguments_are_required():
+    with pytest.raises(ValueError, match='output_file'):
+        OcrOptions(input_file='in.pdf')
+    with pytest.raises(ValueError, match='input_file'):
+        OcrOptions(output_file='out.pdf')
+
+
+def test_plugins_keep_str_and_path():
+    """Module names must stay str, or the plugin loader treats them as files."""
+    plugins = ['my_plugin_module', 'file_plugin.py', Path('p.py')]
+    opts = make(plugins=plugins)
+    # str != Path even for equal text, so equality also checks the types
+    assert opts.plugins == plugins
+
+    # ...including across the JSON round trip that ships options to workers
+    opts2 = OcrOptions.model_validate_json_safe(opts.model_dump_json_safe())
+    assert opts2.plugins == plugins
+
+
+def test_user_words_accepts_str():
+    assert make(user_words='w.txt').user_words == Path('w.txt')
+
+
+def test_assignment_is_validated():
+    opts = make()
+    opts.clean_final = True
+    assert opts.clean, "after-model validator did not re-run on assignment"
+    with pytest.raises(ValueError, match='jobs'):
+        opts.jobs = -1
+    opts.deskew = True
+    with pytest.raises(ValueError, match='redo'):
+        opts.mode = 'redo'
+
+
+def test_model_fields_is_a_class_attribute():
+    assert 'input_file' in OcrOptions.model_fields
+    assert 'extra_attrs' in OcrOptions.model_fields
+
+
+@pytest.mark.skipif(PYDANTIC_V2, reason='pydantic v1 shim only')
+def test_unmapped_config_key_fails_loudly():
+    with pytest.raises(NotImplementedError, match='json_schema_extra'):
+        ConfigDict(extra='forbid', json_schema_extra={})
