diff --git a/src/ocrmypdf/_pydantic_compat.py b/src/ocrmypdf/_pydantic_compat.py
new file mode 100644
index 0000000..2986afa
--- /dev/null
+++ b/src/ocrmypdf/_pydantic_compat.py
@@ -0,0 +1,235 @@
+# SPDX-FileCopyrightText: 2026 James R. Barlow
+# SPDX-License-Identifier: MPL-2.0
+
+"""Compatibility shim so option models run on pydantic v1 (>=1.10) or v2.
+
+pydantic v2 requires the ``pydantic-core`` Rust extension. On platforms or
+Python versions where no ``pydantic-core`` wheel is available and there is no
+Rust toolchain to build one, only the pure-Python/Cython pydantic v1.10.x
+line can be installed. This module re-exports the small subset of the
+pydantic v2 API that :mod:`ocrmypdf._options` and the built-in plugins use,
+backed by whichever major version is actually installed, so call sites can
+import ``BaseModel``, ``ConfigDict``, ``Field``, ``field_validator`` and
+``model_validator`` from here unconditionally.
+
+Only the features actually used elsewhere in ocrmypdf are implemented, and
+anything outside that subset raises ``NotImplementedError`` at import time
+rather than silently degrading, so that a rebase onto upstream that starts
+using more of the v2 API is noticed under v1 immediately:
+
+* ``field_validator`` supports ``mode='before'`` and ``mode='after'`` with
+  the ``(cls, value)`` signature.
+* ``model_validator`` supports ``mode='before'`` (given the raw input dict,
+  same signature in both versions) and ``mode='after'`` (given ``self``,
+  must return ``self``). pydantic v1 has no ``self``-based "after"
+  validator, so one is synthesized: it is registered as a v1
+  ``root_validator(skip_on_failure=True)`` operating on the field-value
+  dict, and the wrapped function is called with a proxy object that reads
+  and writes that dict as if it were attribute access, so validator method
+  bodies written against the v2 API do not need to change. pydantic v1 also
+  re-runs root validators on assignment when ``validate_assignment`` is set,
+  so this behaves the same as v2 for ``options.x = y`` too.
+* ``ConfigDict`` accepts the keys listed in ``_CONFIG_KEYS_V2_TO_V1``.
+* ``BaseModel`` gains ``model_fields`` (class attribute), ``model_dump()``
+  and ``model_validate()``.
+
+Two pydantic v1 semantics that no shim can paper over, and that the option
+models therefore avoid at the type-definition level:
+
+* A ``Union`` is validated first-match-wins with coercion, whereas v2 tries
+  every member for an exact type match first. So ``Path | str`` turns every
+  string into a ``Path`` under v1; order such unions ``str | Path``, and use
+  :func:`instance_of` where no ordering is right.
+* A field annotated ``Any`` is implicitly optional (default ``None``) under
+  v1, whereas v2 keeps it required. So ``Any`` is not a safe stand-in for
+  a union of arbitrary types; use :func:`instance_of` instead.
+
+pydantic's own error messages ("field required" vs "Field required",
+"ensure this value is greater than 0" vs "Input should be greater than 0")
+and the ``type`` codes in ``ValidationError.errors()`` differ between the
+two majors. Messages raised by our own validators are identical, and
+``_describe_options_error`` in :mod:`ocrmypdf.__main__` handles both shapes.
+"""
+
+from __future__ import annotations
+
+import pydantic
+
+__all__ = [
+    'PYDANTIC_V2',
+    'BaseModel',
+    'ConfigDict',
+    'Field',
+    'ValidationError',
+    'field_validator',
+    'instance_of',
+    'model_validator',
+]
+
+PYDANTIC_V2 = pydantic.VERSION.startswith('2.')
+
+if PYDANTIC_V2:
+    from pydantic import (
+        BaseModel,
+        ConfigDict,
+        Field,
+        ValidationError,
+        field_validator,
+        model_validator,
+    )
+else:
+    from pydantic import BaseModel as _BaseModelV1
+    from pydantic import Field, ValidationError
+    from pydantic import root_validator as _root_validator
+    from pydantic import validator as _validator
+    from pydantic.main import ModelMetaclass as _ModelMetaclassV1
+
+    # v2 ConfigDict key -> v1 class Config attribute. Keys that mean the same
+    # thing under both names map to themselves; anything not listed here is
+    # rejected rather than silently ignored by v1.
+    _CONFIG_KEYS_V2_TO_V1 = {
+        'arbitrary_types_allowed': 'arbitrary_types_allowed',
+        'extra': 'extra',
+        'frozen': 'frozen',
+        'populate_by_name': 'allow_population_by_field_name',
+        'str_strip_whitespace': 'anystr_strip_whitespace',
+        'title': 'title',
+        'use_enum_values': 'use_enum_values',
+        'validate_assignment': 'validate_assignment',
+        'validate_default': 'validate_all',
+    }
+
+    def ConfigDict(**kwargs: object) -> dict[str, object]:
+        """Stand-in for pydantic v2's ``ConfigDict``.
+
+        Returns a plain dict of v1 config attributes; ``_CompatMetaclass``
+        below turns it into the nested ``class Config`` that pydantic v1
+        expects.
+        """
+        unknown = kwargs.keys() - _CONFIG_KEYS_V2_TO_V1.keys()
+        if unknown:
+            raise NotImplementedError(
+                f"ConfigDict keys {sorted(unknown)} have no pydantic v1 mapping "
+                "in ocrmypdf._pydantic_compat"
+            )
+        return {_CONFIG_KEYS_V2_TO_V1[k]: v for k, v in kwargs.items()}
+
+    class _CompatMetaclass(_ModelMetaclassV1):
+        """Translate v2-style config into v1's nested ``class Config``.
+
+        A ``model_config = ConfigDict(...)`` class attribute is translated
+        before pydantic v1 processes the model body, since options like
+        ``arbitrary_types_allowed`` must be in effect while fields are being
+        prepared.
+        """
+
+        def __new__(mcs, name, bases, namespace, **kwargs):
+            model_config = namespace.pop('model_config', None)
+            if model_config:
+                config_namespace = (
+                    dict(vars(namespace['Config'])) if 'Config' in namespace else {}
+                )
+                config_namespace.update(model_config)
+                namespace['Config'] = type('Config', (), config_namespace)
+            return super().__new__(mcs, name, bases, namespace, **kwargs)
+
+        @property
+        def model_fields(cls):
+            # Defined on the metaclass, not the model body, so pydantic v1's
+            # field-inference scan (which only looks at the model body's
+            # namespace) never sees this as a candidate field.
+            return cls.__fields__
+
+    class BaseModel(_BaseModelV1, metaclass=_CompatMetaclass):
+        """v1 ``BaseModel`` that also answers to a few v2 method names."""
+
+        def model_dump(self, **kwargs):
+            return self.dict(**kwargs)
+
+        @classmethod
+        def model_validate(cls, obj):
+            return cls.parse_obj(obj)
+
+    def field_validator(*fields: str, mode: str = 'after', check_fields=None):
+        """v1 equivalent of pydantic v2's ``field_validator``."""
+        if mode not in ('before', 'after'):
+            raise NotImplementedError(
+                f"field_validator(mode={mode!r}) is not supported on pydantic v1"
+            )
+        kwargs = {} if check_fields is None else {'check_fields': check_fields}
+        return _validator(*fields, pre=(mode == 'before'), allow_reuse=True, **kwargs)
+
+    class _AfterValidatorProxy:
+        """Mimics ``self`` for a v2 ``mode='after'`` validator body.
+
+        Backed by the field-value dict a v1 root validator receives.
+        """
+
+        def __init__(self, values: dict) -> None:
+            object.__setattr__(self, '_values', values)
+
+        def __getattr__(self, name):
+            try:
+                return self._values[name]
+            except KeyError as exc:
+                raise AttributeError(name) from exc
+
+        def __setattr__(self, name, value) -> None:
+            self._values[name] = value
+
+    def model_validator(*, mode: str):
+        """v1 equivalent of pydantic v2's ``model_validator``.
+
+        ``mode='before'`` maps directly onto ``root_validator(pre=True)``.
+        ``mode='after'`` is synthesized on top of
+        ``root_validator(skip_on_failure=True)`` via ``_AfterValidatorProxy``
+        so that validator bodies written for the v2 ``self``-based API work
+        unchanged.
+        """
+        if mode == 'before':
+
+            def decorator(func):
+                return _root_validator(pre=True, allow_reuse=True)(func)
+
+            return decorator
+        elif mode == 'after':
+
+            def decorator(func):
+                def _wrapper(cls, values):
+                    proxy = _AfterValidatorProxy(values)
+                    func(proxy)
+                    return proxy._values
+
+                _wrapper.__name__ = func.__name__
+                _wrapper.__qualname__ = func.__qualname__
+                return _root_validator(skip_on_failure=True, allow_reuse=True)(_wrapper)
+
+            return decorator
+        raise NotImplementedError(
+            f"model_validator(mode={mode!r}) is not supported on pydantic v1"
+        )
+
+
+def instance_of(*types: type) -> type:
+    """A field type accepting an instance of any of ``types``, passed through as-is.
+
+    For pydantic v1 only. It is the v1 counterpart of a v2 union of arbitrary
+    types under ``arbitrary_types_allowed``: an ``isinstance`` check and no
+    coercion. Neither a v1 ``Union`` (first-match-wins, coercing) nor ``Any``
+    (implicitly optional) reproduces that; see the module docstring.
+    """
+    names = ', '.join(t.__name__ for t in types)
+
+    class InstanceOf:
+        @classmethod
+        def __get_validators__(cls):
+            yield cls.validate
+
+        @classmethod
+        def validate(cls, v):
+            if not isinstance(v, types):
+                raise TypeError(f'expected {names}; got {type(v).__name__}')
+            return v
+
+    InstanceOf.__name__ = InstanceOf.__qualname__ = f'InstanceOf[{names}]'
+    return InstanceOf
