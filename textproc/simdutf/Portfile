# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               github 1.0

github.setup            simdutf simdutf 9.3.3 v
revision                0
categories              textproc
maintainers             nomaintainer
license                 Apache-2 MIT
description             Unicode routines (UTF8, UTF16, UTF32) and Base64
long_description        {*}${description}
checksums               rmd160  bbe83b5cbaf506149574784b7ad0941431755b4a \
                        sha256  441e374e8629bd8469f6d5cde9f0fa17ef3ad158aeb077791606d8aa73b565ef \
                        size    3527945
github.tarball_from     archive

# The code is broken, upstream thinks that fixing bugs is not worth their time.
# https://github.com/simdutf/simdutf/issues/982
patchfiles              simdutf-char16_t-fix.patch

# Support altivec:
patchfiles-append       simdutf-9.1.2-altivec-combined.diff

compiler.cxx_standard   2017

set py_ver              3.14
set py_ver_nodot        [string map {. {}} ${py_ver}]

depends_build-append    port:python${py_ver_nodot}

depends_lib-append      port:libiconv

configure.args-append   -DBUILD_SHARED_LIBS=ON \
                        -DCPM_LOCAL_PACKAGES_ONLY=ON \
                        -DPython3_EXECUTABLE=${prefix}/bin/python${py_ver} \
                        -DSIMDUTF_ICONV=ON \
                        -DSIMDUTF_TOOLS=ON

platform darwin {
    if {${os.major} < 11 && ${configure.build_arch} in [list i386 x86_64]} {
      patchfiles-append patch-xgetbv-bytes.diff
      configure.cppflags-append \
                        -DSIMDUTF_IMPLEMENTATION_HASWELL=0 \
                        -DSIMDUTF_IMPLEMENTATION_ICELAKE=0
    }
}

# Required for tests to run:
configure.pre_args-replace \
                        -DCMAKE_BUILD_WITH_INSTALL_RPATH:BOOL=ON \
                        -DCMAKE_BUILD_WITH_INSTALL_RPATH:BOOL=OFF

# On powerpc: 100% tests passed, 0 tests failed out of 92
# Altivec build:
# Total Test time (real) = 524.83 sec
# Same v. 9.1.2, without Altivec patch:
# Total Test time (real) = 728.51 sec
# TODO: a few individual tests marginally lose with Altivec build, review that.
test.run                yes
