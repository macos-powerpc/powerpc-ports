--- include/simdutf/implementation.h.orig
+++ include/simdutf/implementation.h
@@ -107,13 +107,22 @@
 
 /**
  * like span_of_byte_like, but for an output span (intended to be written to)
+ *
+ * libstdc++'s copy-on-write std::string (the pre-C++11 side of its dual ABI,
+ * _GLIBCXX_USE_CXX11_ABI=0) declares the mutable data() noexcept(false)
+ * because it may have to unshare; do not demand noexcept from it there.
  */
+  #if defined(_GLIBCXX_USE_CXX11_ABI) && _GLIBCXX_USE_CXX11_ABI == 0
+    #define SIMDUTF_OUTPUT_DATA_NOEXCEPT
+  #else
+    #define SIMDUTF_OUTPUT_DATA_NOEXCEPT noexcept
+  #endif
 template <typename T>
 concept output_span_of_byte_like = requires(T &t) {
   { t.size() } noexcept -> std::convertible_to<std::size_t>;
-  { t.data() } noexcept -> is_pointer;
-  { *t.data() } noexcept -> is_byte_like;
-  { *t.data() } noexcept -> is_mutable;
+  { t.data() } SIMDUTF_OUTPUT_DATA_NOEXCEPT -> is_pointer;
+  { *t.data() } SIMDUTF_OUTPUT_DATA_NOEXCEPT -> is_byte_like;
+  { *t.data() } SIMDUTF_OUTPUT_DATA_NOEXCEPT -> is_mutable;
 };
 
