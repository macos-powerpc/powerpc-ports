set py_ver          3.14
set py_ver_nodot    [string map {. {}} ${py_ver}]
configure.python    ${prefix}/bin/python${py_ver}

post-patch {
    fs-traverse f ${worksrcpath}/filters {
        if {[string match *.py ${f}]} {
            reinplace -q "s|/usr/bin/env python3|${configure.python}|" ${f}
        }
    }
    reinplace -q "s|/usr/bin/python3|${configure.python}|" \
        ${worksrcpath}/desktop/hotrecoll.py
}

depends_build-append \
                    path:bin/pkg-config:pkgconfig \
                    port:python${py_ver_nodot}

depends_lib-append  port:aspell \
                    port:jsoncpp \
                    port:libiconv \
                    port:libmagic \
                    port:libxml2 \
                    port:libxslt \
                    port:simdutf \
                    port:xapian-core \
                    port:zlib

depends_run         port:antiword \
                    port:desktop-file-utils \
                    port:py${py_ver_nodot}-beautifulsoup4 \
                    port:py${py_ver_nodot}-lxml \
                    port:py${py_ver_nodot}-mutagen \
                    port:py${py_ver_nodot}-lxml \
                    port:py${py_ver_nodot}-py7zr \
                    port:py${py_ver_nodot}-rarfile \
                    port:py${py_ver_nodot}-yaml \
                    port:unrtf \
                    port:unzip

compiler.cxx_standard   2017

configure.args-append \
                    -Didxthreads=false \
                    -Dpython-aspell=false \
                    -Dpython-chm=false \
                    -Dpython-command=${configure.python} \
                    -Dpython-module=false \
                    -Dsemantic=true \
                    -Dsystemd=false \
                    -Dwebkit=false \
                    -Dwebpreview=false \
                    -Dx11mon=false

platform darwin {
    configure.args-append \
                    -Dinotify=false
}

pre-destroot {
    copy ${build.dir}/qtgui/recoll.app ${destroot}${applications_dir}/
}

post-activate {
    system "${prefix}/bin/update-desktop-database ${prefix}/share/applications"
}
