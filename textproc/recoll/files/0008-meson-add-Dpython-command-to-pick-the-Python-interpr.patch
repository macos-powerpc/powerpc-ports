From 3b79e1a444c3d13d44bac55c86e25dd920815290 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 2 Sep 2026 03:10:36 +0000
Subject: [PATCH 8/8] meson: add -Dpython-command to pick the Python
 interpreter explicitly

src/meson.build unconditionally looked up an unversioned "python3" and
required a matching pkg-config "python3" dependency, regardless of
whether the Python module/wrappers were even enabled. That fails, or
silently grabs the wrong install, on MacPorts, which has no unversioned
python3 unless python_select was run (e.g. we want
/opt/local/bin/python3.14 specifically).

Add a 'python-command' string option (default 'python3', unchanged
behavior elsewhere) and use it for py_mod.find_installation(). Also
switch py3_dep from an independent dependency('python3') pkg-config
probe to python.dependency() on the interpreter we actually found, so
it can't resolve to a different install. Same option is used as the
py3versions fallback (Debian-specific tool, absent elsewhere) in the
python/recoll, python/pychm and python/pyaspell extension builds.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Ddfj6DPA9L8P9ba1f3ULvn
---
 src/meson.build                 | 12 ++++++++++--
 src/meson_options.txt           |  4 ++++
 src/python/pyaspell/meson.build | 13 +++++++++----
 src/python/pychm/meson.build    | 13 +++++++++----
 src/python/recoll/meson.build   | 13 +++++++++----
 5 files changed, 41 insertions(+), 14 deletions(-)

diff --git a/src/meson.build b/src/meson.build
index d6db1667..66788bac 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -18,6 +18,11 @@
 #    undefined libiconv_open (defined by the local .h but does not exist in /usr libc).
 #    We use "libiconv = cc.find_library('libiconv', required:true,dirs:'/usr/local/lib')"
 #    instead, which works and results in actually using libiconv instead of the libc bundled iconv
+#
+# - MacPorts (and other systems with no unversioned "python3" on PATH): set
+#   "-Dpython-command=/opt/local/bin/python3.X" so the interpreter lookups (used even when the
+#   Python module/wrappers are disabled) find the right, specific install instead of failing or
+#   picking an arbitrary one.
 
 project(
     'recoll',
@@ -530,9 +535,12 @@ endif
 
 py_mod = import('python')
 python = py_mod.find_installation(
-    'python3',
+    get_option('python-command'),
 )
-py3_dep = dependency('python3', required: true)
+# Ask the found interpreter itself for its build flags (sysconfig-based) instead of doing an
+# independent pkg-config lookup for a generic "python3": that can fail, or silently pick a
+# different install, on a system with no unversioned python3, e.g. MacPorts.
+py3_dep = python.dependency(required: true)
 
 if get_option('python-module')
     subdir('python/recoll')
diff --git a/src/meson_options.txt b/src/meson_options.txt
index 16fca60c..29e3c9fe 100644
--- a/src/meson_options.txt
+++ b/src/meson_options.txt
@@ -8,6 +8,10 @@ option('python-chm', type: 'boolean', value: true,
        description: 'Build the libchm Python wrapper')
 option('python-aspell', type: 'boolean', value: true,
        description: 'build the aspell Python wrapper')
+option('python-command', type: 'string', value: 'python3',
+       description: 'Python interpreter to build/run against (name or full path). Needed when the ' +
+                     'system has no unversioned python3 on PATH, e.g. a MacPorts install where only ' +
+                     'python3.X exists: set to /opt/local/bin/python3.X')
 option('indexer', type: 'boolean', value: true,
        description: 'Build the recollindex indexer (else recoll is query-only)')
 option('xadump', type: 'boolean', value: false,
diff --git a/src/python/pyaspell/meson.build b/src/python/pyaspell/meson.build
index 91f8717a..76defeb2 100644
--- a/src/python/pyaspell/meson.build
+++ b/src/python/pyaspell/meson.build
@@ -11,17 +11,22 @@ if py3versions_cmd.found()
         check: true,
         capture: true,
         )
-    py3versions = py3vs.stdout().split()
+    py3names = []
+    foreach v : py3vs.stdout().split()
+        py3names += 'python' + v
+    endforeach
 else
-    py3versions = ['3',]
+    # py3versions is Debian-specific. Elsewhere (e.g. MacPorts, which has no unversioned python3
+    # unless python_select was run) build against exactly the interpreter configured via
+    # -Dpython-command, instead of guessing at a plain "python3".
+    py3names = [get_option('python-command'),]
 endif
 
 # Get the custom include directories from the command line option
 aspell_include_dir = get_option('aspell_include_dir')
 
 aspellexts = []
-foreach v : py3versions
-    py3_name = 'python' + v
+foreach py3_name : py3names
     python_installation = py_mod.find_installation(py3_name)
     py3_dep = python_installation.dependency()
     
diff --git a/src/python/pychm/meson.build b/src/python/pychm/meson.build
index 63531f02..4cff0ec7 100644
--- a/src/python/pychm/meson.build
+++ b/src/python/pychm/meson.build
@@ -11,17 +11,22 @@ if py3versions_cmd.found()
         check: true,
         capture: true,
         )
-    py3versions = py3vs.stdout().split()
+    py3names = []
+    foreach v : py3vs.stdout().split()
+        py3names += 'python' + v
+    endforeach
 else
-    py3versions = ['3',]
+    # py3versions is Debian-specific. Elsewhere (e.g. MacPorts, which has no unversioned python3
+    # unless python_select was run) build against exactly the interpreter configured via
+    # -Dpython-command, instead of guessing at a plain "python3".
+    py3names = [get_option('python-command'),]
 endif
 
 # Get the custom include directories from the command line option
 chm_include_dir = get_option('chm_include_dir')
 
 chmexts = []
-foreach v : py3versions
-    py3_name = 'python' + v
+foreach py3_name : py3names
     python_installation = py_mod.find_installation(py3_name)
     py3_dep = python_installation.dependency()
 
diff --git a/src/python/recoll/meson.build b/src/python/recoll/meson.build
index 5bb47bda..015f5137 100644
--- a/src/python/recoll/meson.build
+++ b/src/python/recoll/meson.build
@@ -18,15 +18,20 @@ if py3versions_cmd.found()
         check: true,
         capture: true,
         )
-    py3versions = py3vs.stdout().split()
+    py3names = []
+    foreach v : py3vs.stdout().split()
+        py3names += 'python' + v
+    endforeach
 else
-    py3versions = ['3',]
+    # py3versions is Debian-specific. Elsewhere (e.g. MacPorts, which has no unversioned python3
+    # unless python_select was run) build against exactly the interpreter configured via
+    # -Dpython-command, instead of guessing at a plain "python3".
+    py3names = [get_option('python-command'),]
 endif
 
 py_mod = import('python')
 extensions = []
-foreach v : py3versions
-    py3_name = 'python' + v
+foreach py3_name : py3names
     python_installation = py_mod.find_installation(py3_name)
     extensions += python_installation.extension_module(
         '_recoll',
