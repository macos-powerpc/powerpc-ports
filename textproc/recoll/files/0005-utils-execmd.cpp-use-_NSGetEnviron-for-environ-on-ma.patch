From 8b96076e795837336885598daff92fc840f01c23 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 2 Sep 2026 02:17:41 +0000
Subject: [PATCH 5/5] utils/execmd.cpp: use _NSGetEnviron() for environ on
 macOS

librecoll is built as a shared library, and plain "extern char
**environ" is not a resolvable symbol at link time for a dylib on
macOS (previously worked around in the port by disabling
-Db_lundef). _NSGetEnviron() from <crt_externs.h> is Apple's
supported way to access the environment from a shared library.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Ddfj6DPA9L8P9ba1f3ULvn
---
 src/utils/execmd.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/utils/execmd.cpp b/src/utils/execmd.cpp
index 9ba3510c..eff9ed01 100644
--- a/src/utils/execmd.cpp
+++ b/src/utils/execmd.cpp
@@ -64,7 +64,15 @@
 
 using namespace std;
 
+#ifdef __APPLE__
+// environ is not directly accessible from a shared library on macOS
+// (would need -Db_lundef=false / -undefined dynamic_lookup at link
+// time). _NSGetEnviron() is the supported way to get at it.
+#include <crt_externs.h>
+#define environ (*_NSGetEnviron())
+#else
 extern char **environ;
+#endif
 
 class ExecCmd::Internal {
 public:
