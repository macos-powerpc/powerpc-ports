From 0e999f6486d0d3275a517c5eb232fbdc9ad3dc5c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 2 Sep 2026 00:53:15 +0000
Subject: [PATCH 2/4] Mac OS X < 10.7: fallback for
 IOPSGetProvidingPowerSourceType() in powerstatus.cpp

IOPSGetProvidingPowerSourceType() only exists from 10.7. When the deployment target is older,
walk the IOPSCopyPowerSourcesList() entries and check kIOPSPowerSourceStateKey instead
(available since 10.2).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Voh3NXqrzFgK56iCnHqxZ2
---
 src/utils/powerstatus.cpp | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/src/utils/powerstatus.cpp b/src/utils/powerstatus.cpp
index ed6ee92b..31e864b6 100644
--- a/src/utils/powerstatus.cpp
+++ b/src/utils/powerstatus.cpp
@@ -64,6 +64,7 @@ static void systemgetpowerstatus()
 }
 #elif defined(__APPLE__)
 
+#include <AvailabilityMacros.h>
 #include <CoreFoundation/CoreFoundation.h>
 #include <IOKit/ps/IOPowerSources.h>
 #include <IOKit/ps/IOPSKeys.h>
@@ -76,10 +77,35 @@ static bool isRunningOnBattery()
         return false; // Assume AC power if unable to retrieve info
     }
 
+    bool onBattery = false;
+#if defined(MAC_OS_X_VERSION_MIN_REQUIRED) && (MAC_OS_X_VERSION_MIN_REQUIRED >= 1070)
     // Check power source state
     CFStringRef powerSourceState = IOPSGetProvidingPowerSourceType(snapshot);
-    bool onBattery =
+    onBattery =
         CFStringCompare(powerSourceState, CFSTR(kIOPSBatteryPowerValue), 0) == kCFCompareEqualTo;
+#else
+    // IOPSGetProvidingPowerSourceType() only exists from Mac OS X 10.7. On older systems, walk the
+    // power sources list and look for one currently delivering battery power.
+    CFArrayRef sources = IOPSCopyPowerSourcesList(snapshot);
+    if (sources) {
+        CFIndex count = CFArrayGetCount(sources);
+        for (CFIndex i = 0; i < count; i++) {
+            CFDictionaryRef desc =
+                IOPSGetPowerSourceDescription(snapshot, CFArrayGetValueAtIndex(sources, i));
+            if (!desc) {
+                continue;
+            }
+            CFStringRef state =
+                (CFStringRef)CFDictionaryGetValue(desc, CFSTR(kIOPSPowerSourceStateKey));
+            if (state &&
+                CFStringCompare(state, CFSTR(kIOPSBatteryPowerValue), 0) == kCFCompareEqualTo) {
+                onBattery = true;
+                break;
+            }
+        }
+        CFRelease(sources);
+    }
+#endif
 
     // Clean up
     CFRelease(snapshot);
-- 
