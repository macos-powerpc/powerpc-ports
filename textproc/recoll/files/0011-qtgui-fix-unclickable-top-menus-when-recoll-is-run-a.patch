From 3d590e788221cdd25c92995e67c81fa8dde7d787 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 2 Sep 2026 04:22:21 +0000
Subject: [PATCH 11/11] qtgui: fix unclickable top menus when recoll is run as
 a bare binary

Confirmed: launching the actual recoll.app bundle works fine; running
the extracted "recoll" binary from a shell (how the MacPorts install
runs, since qmkmk.sh copies it out of the bundle) has the menu bar
unresponsive until switching to another app and back - the classic
symptom of a process never being promoted to frontmost/foreground.

qt4-mac builds Carbon only on 32-bit 10.5; 64-bit 10.5 and every
10.6+ target (including Catalina) use Cocoa, each needing a different
activation call. QT_MAC_USE_COCOA (defined by Qt's own qconfig.h/
qglobal.h, re-derived per downstream compile since this qt4-mac
autodetects from 32/64-bitness) tells us which at compile time.

New file macactivateapp.mm (Objective-C++, needed for the Cocoa case)
branches on QT_MAC_USE_COCOA: Cocoa calls [[NSApplication
sharedApplication] activateIgnoringOtherApps:YES], Carbon calls
TransformProcessType()/SetFrontProcess() (ApplicationServices/
Processes.h). main.cpp just declares and calls
macBecomeForegroundApp(). recoll.pro.in compiles the new file
(OBJECTIVE_SOURCES, the traditional/most qmake-version-compatible
variable for .mm) and links both ApplicationServices and Cocoa
frameworks unconditionally - only the one actually referenced by the
active branch matters at link time, and both exist on every real
macOS install.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Ddfj6DPA9L8P9ba1f3ULvn
---
 src/qtgui/macactivateapp.mm | 27 +++++++++++++++++++++++++++
 src/qtgui/main.cpp          | 13 +++++++++++++
 src/qtgui/recoll.pro.in     | 10 ++++++++++
 4 files changed, 51 insertions(+)
 create mode 100644 src/qtgui/macactivateapp.mm

diff --git a/src/qtgui/macactivateapp.mm b/src/qtgui/macactivateapp.mm
new file mode 100644
index 00000000..55389905
--- /dev/null
+++ b/src/qtgui/macactivateapp.mm
@@ -0,0 +1,27 @@
+/* Make this process the frontmost/foreground application when launched as a bare executable
+ * outside a .app bundle (e.g. from a shell, which is how a package-manager-installed binary
+ * runs): otherwise it draws its window and menu bar but does not actually become frontmost, so
+ * the menu bar does not receive clicks until the user switches to another application and back.
+ *
+ * Qt4 on macOS builds Carbon on 32-bit 10.5, and Cocoa everywhere else (64-bit 10.5, and 10.6+):
+ * QT_MAC_USE_COCOA (defined by Qt's own qconfig.h/qglobal.h, re-derived per downstream compile
+ * when Qt was configured to autodetect) tells us which, and each backend needs a different call.
+ */
+#include <QtGlobal>
+
+#ifdef QT_MAC_USE_COCOA
+#import <Cocoa/Cocoa.h>
+#else
+#include <ApplicationServices/ApplicationServices.h>
+#endif
+
+void macBecomeForegroundApp()
+{
+#ifdef QT_MAC_USE_COCOA
+    [[NSApplication sharedApplication] activateIgnoringOtherApps:YES];
+#else
+    ProcessSerialNumber psn = {0, kCurrentProcess};
+    TransformProcessType(&psn, kProcessTransformToForegroundApplication);
+    SetFrontProcess(&psn);
+#endif
+}
diff --git a/src/qtgui/main.cpp b/src/qtgui/main.cpp
index f4ef5f7d..1876d72b 100644
--- a/src/qtgui/main.cpp
+++ b/src/qtgui/main.cpp
@@ -276,6 +276,15 @@ static std::string get_config(int argc, char **argv)
     return aconf.empty() ? econf : aconf;
 }
 
+#if defined(__APPLE__) && (QT_VERSION < QT_VERSION_CHECK(5, 0, 0))
+// Make recoll the frontmost/foreground application when launched as a bare executable outside
+// a .app bundle (e.g. from a shell, which is how the MacPorts-installed binary runs): otherwise it
+// draws its window and menu bar but doesn't receive menu clicks until the user switches to
+// another app and back. Implemented in macactivateapp.mm, which picks the right call for
+// whichever of Carbon (32-bit 10.5) or Cocoa (everywhere else) this Qt4 build actually uses.
+extern void macBecomeForegroundApp();
+#endif
+
 int main(int argc, char **argv)
 {
     pathut_setargv0(argv[0]);
@@ -319,6 +328,10 @@ int main(int argc, char **argv)
     QApplication app(argc, argv);
 #endif
 
+#if defined(__APPLE__) && (QT_VERSION < QT_VERSION_CHECK(5, 0, 0))
+    macBecomeForegroundApp();
+#endif
+
 #if defined(USING_WEBENGINE) || defined(USING_WEBKIT)
     // Prevent Webkit HTTP connections by setting a bogus proxy. This is for preventing network
     // accesses from webkit when it is used to implement the preview window. E.g. this is what
diff --git a/src/qtgui/recoll.pro.in b/src/qtgui/recoll.pro.in
index 32761433..ca8c3d59 100644
--- a/src/qtgui/recoll.pro.in
+++ b/src/qtgui/recoll.pro.in
@@ -518,5 +518,15 @@ greaterThan(QT_MAJOR_VERSION, 4) {
     # loads fine from the build directory (where qmkmk.sh links it against librecoll's absolute
     # build path) but fails at its installed location with "Library not loaded: @rpath/....dylib".
     QMAKE_LFLAGS += -Wl,-rpath,$$PREFIX/lib
+
+    lessThan(QT_MAJOR_VERSION, 5) {
+      # main.cpp calls macBecomeForegroundApp() (macactivateapp.mm) so the binary becomes the
+      # frontmost app when launched outside a .app bundle (see the comment there for why). Link
+      # both frameworks unconditionally rather than trying to mirror macactivateapp.mm's
+      # QT_MAC_USE_COCOA check here: only the one actually used gets referenced at link time, and
+      # both are present on every real macOS install (Cocoa.framework included, since 10.0).
+      OBJECTIVE_SOURCES += macactivateapp.mm
+      LIBS += -framework ApplicationServices -framework Cocoa
+    }
   }
 }
