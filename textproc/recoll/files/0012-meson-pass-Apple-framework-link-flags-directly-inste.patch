From f8f3382326c6b52ea2a62c1255b638aee6cd8eb5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 3 Sep 2026 06:35:16 +0000
Subject: [PATCH] meson: pass Apple framework link flags directly instead of
 looking them up

dependency('CoreServices', ...) and dependency('appleframeworks', ...)
go through meson's framework lookup, which fails with non-Apple
compilers such as MacPorts gcc. CoreServices, CoreFoundation and IOKit
have all been part of the system since long before any macOS version
we support (10.5+), so just pass the -framework link flags directly.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016W8kDK6GdE9NBZDsY569AF
---
 src/meson.build | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/meson.build b/src/meson.build
index 66788bac..ff5e256c 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -219,23 +219,25 @@ if cpp.has_function(
     recoll_conf.set('HAVE_KQUEUE', true)
 endif
 
-# Check for macOS (darwin)
+# Check for macOS (darwin). We don't bother looking up these frameworks: they have
+# been part of the system since long before any macOS version we support (10.5+), so
+# just pass the link flags directly. This also sidesteps meson's framework lookup,
+# which mishandles the flags it needs with non-Apple compilers such as MacPorts gcc.
 if host_machine.system() == 'darwin' and get_option('fsevents')
-    # Declare the Core Services framework dependency
-    core_services = dependency('CoreServices', required: true)
+    core_services = declare_dependency(link_args: ['-framework', 'CoreServices'])
     apple_core_services_found = true
 
     librecolldeps += core_services  # Add the CoreServices framework as a dependency
-    
+
     recoll_conf.set('RCL_USE_FSEVENTS', true)
     recoll_conf.set('RCL_MONITOR', true)
-else 
+else
     apple_core_services_found = false
 endif
 
 if host_machine.system() == 'darwin' and librecoll_needed
     # utils/powerstatus.cpp uses the IOKit power sources API (with CoreFoundation types)
-    librecolldeps += dependency('appleframeworks', modules: ['CoreFoundation', 'IOKit'])
+    librecolldeps += declare_dependency(link_args: ['-framework', 'CoreFoundation', '-framework', 'IOKit'])
 endif
 
 recoll_conf.set('HAVE_VSNPRINTF', cpp.has_function('vsnprintf'))
-- 
