From 8788af905a1214a40eef6bcd674effc51dd420ca Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 2 Sep 2026 02:57:23 +0000
Subject: [PATCH 7/7] qtgui: fix two more Qt5-only calls missed by the Qt4
 guard pass

Reported from an actual PPC/Qt4 build:
- QComboBox::currentData() (Qt 5.2+): replace with the equivalent
  itemData(currentIndex()), which works on every Qt version.
- QSplitter::replaceWidget() (Qt 5.9+): guard with QT_VERSION and
  reproduce it on older Qt via widget(1)/setParent(nullptr)/hide()
  followed by insertWidget(1, ...).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Ddfj6DPA9L8P9ba1f3ULvn
---
 src/qtgui/rclmain_w.cpp | 11 +++++++++++
 src/qtgui/uiprefs_w.cpp |  4 +++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/qtgui/rclmain_w.cpp b/src/qtgui/rclmain_w.cpp
index c93052b8..e713d89a 100644
--- a/src/qtgui/rclmain_w.cpp
+++ b/src/qtgui/rclmain_w.cpp
@@ -1491,5 +1491,16 @@ void RclMain::resultsSetFixedGeometry()
     reslist->setMaximumSize(QSize(w, h));
     scrollArea->setWidget(resultsLayoutWidget);
 
+#if (QT_VERSION >= QT_VERSION_CHECK(5, 9, 0))
     sideFiltersSPLT->replaceWidget(1, scrollArea);
+#else
+    // QSplitter::replaceWidget() only appeared in Qt 5.9. Reproduce it: detach whatever is
+    // currently at index 1 (without deleting it, same as replaceWidget()), then insert the new
+    // widget at that position.
+    if (QWidget *oldw = sideFiltersSPLT->widget(1)) {
+        oldw->setParent(nullptr);
+        oldw->hide();
+    }
+    sideFiltersSPLT->insertWidget(1, scrollArea);
+#endif
 }
diff --git a/src/qtgui/uiprefs_w.cpp b/src/qtgui/uiprefs_w.cpp
index 2cedbbc9..cf77d58a 100644
--- a/src/qtgui/uiprefs_w.cpp
+++ b/src/qtgui/uiprefs_w.cpp
@@ -584,7 +584,9 @@ void UIPrefsDialog::accept()
     prefs.singleapp = singleappCB->isChecked();
     prefs.ssearchCompletePassive = ssearchCompletePassiveCB->isChecked();
     prefs.previewLinesOverAnchor = previewLinesOverAnchorSB->value();
-    prefs.uilanguage = uilanguageCMB->currentData().toString();
+    // QComboBox::currentData() only appeared in Qt 5.2; itemData(currentIndex()) is equivalent
+    // and works on every Qt version we support.
+    prefs.uilanguage = uilanguageCMB->itemData(uilanguageCMB->currentIndex()).toString();
     prefs.colorscheme = colorschemeCMB->currentIndex();
     prefs.previewdarkbg = previewdarkbgCB->isChecked();
     prefs.startWithFragsToolOpen = startWithFragsToolOpenCB->isChecked();
