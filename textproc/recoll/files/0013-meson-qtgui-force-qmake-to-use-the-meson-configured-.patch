From ef1f00cbf3a491dd87bfe404bc6a57a9ae879bbb Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 3 Sep 2026 06:48:17 +0000
Subject: [PATCH] meson/qtgui: force qmake to use the meson-configured compiler
 on macOS

qmake's macx-g++ mkspec hardcodes the compiler bundled with the Xcode
version it targets (e.g. /usr/bin/g++-4.2 for old Qt 4 SDKs), ignoring
whatever compiler meson was configured with. This made the qtgui build
silently switch away from the MacPorts gcc used for the rest of the
build, then fail because that ancient compiler doesn't support the
-std=gnu++17/-Wno-register flags the Qt 4 .pro file needs.

Pass QMAKE_CC/QMAKE_CXX/QMAKE_LINK* explicitly to qmake, sourced from
meson's own compiler objects, so the whole build stays on one toolchain.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016W8kDK6GdE9NBZDsY569AF
---
 src/qtgui/meson.build | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/src/qtgui/meson.build b/src/qtgui/meson.build
index cd93dcad..5fbaabf6 100644
--- a/src/qtgui/meson.build
+++ b/src/qtgui/meson.build
@@ -53,12 +53,28 @@ qmkmk = find_program(meson.current_source_dir() / 'qmkmk.sh')
 
 infile = pro_file
 outfile = 'recoll'
-prefixoption = 'PREFIX=' + get_option('prefix')
+qmakevars = ['PREFIX=' + get_option('prefix')]
+if host_machine.system() == 'darwin'
+    # qmake's macx-g++ mkspec (used for the Qt 4 / PowerPC build) hardcodes the compiler
+    # that shipped with the Xcode version it targets (e.g. /usr/bin/g++-4.2), ignoring the
+    # compiler meson was configured with. Pass it through explicitly so the qmake/make build
+    # uses the same toolchain as the rest of recoll.
+    cxx_path = cpp.cmd_array()[0]
+    cc_path = cc.cmd_array()[0]
+    qmakevars += [
+        'QMAKE_CC=' + cc_path,
+        'QMAKE_CXX=' + cxx_path,
+        'QMAKE_LINK=' + cxx_path,
+        'QMAKE_LINK_SHLIB=' + cxx_path,
+        'QMAKE_LINK_C=' + cc_path,
+        'QMAKE_LINK_C_SHLIB=' + cc_path,
+    ]
+endif
 recoll = custom_target(
     'recoll',
     output: outfile,
     input: infile,
-    command: [qmkmk, '@INPUT@', prefixoption],
+    command: [qmkmk, '@INPUT@'] + qmakevars,
     depends: librecoll,
     install: true,
     install_dir: 'bin',
-- 
