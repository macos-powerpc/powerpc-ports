From 9195496e1eb094a5d167d2df8dee6312d815e3f7 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 2 Sep 2026 02:42:32 +0000
Subject: [PATCH 6/6] meson: prefer a system simdutf package over the vendored
 copy

Look up simdutf via pkg-config (dependency('simdutf', required: false))
in src/meson.build and use it, when found, instead of building the
~40k line vendored src/unac/simdutf.cpp inline into unac.cpp/
transcode.cpp. This lets MacPorts textproc/simdutf (whose PPC-specific
patch fixes it there) satisfy the dependency instead of compiling the
bundled amalgamation, which is untested on PowerPC.

Moved the vendored simdutf.cpp/.h (and their AUTHORS/LICENSE/README)
from unac/ to unac/vendor/, which is not on the general include path:
unac/ stays there for unacpp.h/unac.h, so leaving simdutf.h at that
level would let the fallback "#include <simdutf.h>" silently resolve
to the vendored file instead of the real system header. Falls back to
the vendored copy exactly as before when no system package is found.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Ddfj6DPA9L8P9ba1f3ULvn
---
 src/meson.build                            | 10 ++++++++++
 src/rclgrep/meson.build                    |  3 +++
 src/unac/unac.cpp                          | 13 +++++++++++--
 src/unac/{ => vendor}/AUTHORS-simdutf      |  0
 src/unac/{ => vendor}/CONTRIBUTORS-simdutf |  0
 src/unac/{ => vendor}/LICENSE-MIT-simdutf  |  0
 src/unac/{ => vendor}/README-simdutf.md    |  0
 src/unac/{ => vendor}/simdutf.cpp          |  0
 src/unac/{ => vendor}/simdutf.h            |  0
 src/utils/transcode.cpp                    |  6 +++++-
 11 files changed, 36 insertions(+), 9 deletions(-)
 rename src/unac/{ => vendor}/AUTHORS-simdutf (100%)
 rename src/unac/{ => vendor}/CONTRIBUTORS-simdutf (100%)
 rename src/unac/{ => vendor}/LICENSE-MIT-simdutf (100%)
 rename src/unac/{ => vendor}/README-simdutf.md (100%)
 rename src/unac/{ => vendor}/simdutf.cpp (100%)
 rename src/unac/{ => vendor}/simdutf.h (100%)

diff --git a/src/meson.build b/src/meson.build
index 6389d5fb..d6db1667 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -258,6 +258,16 @@ elif get_option('fam')
 endif
 recoll_conf.set('RCL_SPLIT_CAMELCASE', get_option('camelcase'))
 recoll_conf.set('USE_SIMDUTF', get_option('simdutf'))
+# Prefer a system/package simdutf (e.g. the MacPorts textproc/simdutf port) over building the
+# ~40k line vendored copy in unac/vendor/simdutf.cpp. Falls back to the vendored copy if not
+# found. Looked up unconditionally (cheap, required:false) so that simdutf_dep is always a
+# valid variable for the rclgrep subdir to reference below.
+simdutf_dep = dependency('simdutf', required: false)
+have_system_simdutf = get_option('simdutf') and simdutf_dep.found()
+recoll_conf.set('USE_SYSTEM_SIMDUTF', have_system_simdutf)
+if have_system_simdutf and librecoll_needed
+    librecolldeps += simdutf_dep
+endif
 
 cfile = configure_file(output: 'autoconfig.h', configuration: recoll_conf)
 
diff --git a/src/rclgrep/meson.build b/src/rclgrep/meson.build
index 05a65176..6c62fd34 100644
--- a/src/rclgrep/meson.build
+++ b/src/rclgrep/meson.build
@@ -76,6 +76,9 @@ endif
 if get_option('idxthreads')
     rclgrep_deps += dependency('threads')
 endif
+if have_system_simdutf
+    rclgrep_deps += simdutf_dep
+endif
 
 rclgrep = executable(
     'rclgrep',
diff --git a/src/unac/unac.cpp b/src/unac/unac.cpp
index 1f3c853b..525deba0 100644
--- a/src/unac/unac.cpp
+++ b/src/unac/unac.cpp
@@ -13040,8 +13040,17 @@ static std::mutex o_unac_mutex;
 #endif
 
 #ifdef USE_SIMDUTF
-#include "simdutf.cpp"
-#include "simdutf.h"
+#ifdef USE_SYSTEM_SIMDUTF
+// Use the package-provided simdutf (e.g. MacPorts textproc/simdutf) instead of building the
+// vendored copy in unac/vendor: its implementation lives in libsimdutf, linked in by
+// meson.build. The vendored simdutf.h/.cpp were moved to unac/vendor (out of the general
+// include path) so this angle-bracket include cannot accidentally resolve to them instead
+// of the real system header.
+#include <simdutf.h>
+#else
+#include "vendor/simdutf.cpp"
+#include "vendor/simdutf.h"
+#endif
 #endif
 
 static int run_iconv(iconv_t cd, bool from_utf16, const char* in, size_t in_length,
diff --git a/src/unac/AUTHORS-simdutf b/src/unac/vendor/AUTHORS-simdutf
similarity index 100%
rename from src/unac/AUTHORS-simdutf
rename to src/unac/vendor/AUTHORS-simdutf
diff --git a/src/unac/CONTRIBUTORS-simdutf b/src/unac/vendor/CONTRIBUTORS-simdutf
similarity index 100%
rename from src/unac/CONTRIBUTORS-simdutf
rename to src/unac/vendor/CONTRIBUTORS-simdutf
diff --git a/src/unac/LICENSE-MIT-simdutf b/src/unac/vendor/LICENSE-MIT-simdutf
similarity index 100%
rename from src/unac/LICENSE-MIT-simdutf
rename to src/unac/vendor/LICENSE-MIT-simdutf
diff --git a/src/unac/README-simdutf.md b/src/unac/vendor/README-simdutf.md
similarity index 100%
rename from src/unac/README-simdutf.md
rename to src/unac/vendor/README-simdutf.md
diff --git a/src/unac/simdutf.cpp b/src/unac/vendor/simdutf.cpp
similarity index 100%
rename from src/unac/simdutf.cpp
rename to src/unac/vendor/simdutf.cpp
diff --git a/src/unac/simdutf.h b/src/unac/vendor/simdutf.h
similarity index 100%
rename from src/unac/simdutf.h
rename to src/unac/vendor/simdutf.h
diff --git a/src/utils/transcode.cpp b/src/utils/transcode.cpp
index e28cc3f5..f8e939c5 100644
--- a/src/utils/transcode.cpp
+++ b/src/utils/transcode.cpp
@@ -27,7 +27,11 @@
 #include "transcode.h"
 #include "log.h"
 #include "rclutil.h"
-#include "simdutf.h"
+#ifdef USE_SYSTEM_SIMDUTF
+#include <simdutf.h>
+#else
+#include "vendor/simdutf.h"
+#endif
 
 using namespace std;
 
