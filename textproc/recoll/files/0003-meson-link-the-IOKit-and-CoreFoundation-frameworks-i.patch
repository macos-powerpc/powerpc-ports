From 2d22ef4e4ca62479c5fe2c33ec23185cc18e9e8e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 2 Sep 2026 00:57:38 +0000
Subject: [PATCH 3/4] meson: link the IOKit and CoreFoundation frameworks into
 librecoll on macOS

utils/powerstatus.cpp calls IOPSCopyPowerSourcesInfo() and friends, which live in IOKit. The
meson build only linked CoreServices (and only with -Dfsevents=true), so the shared librecoll
had undefined symbols on macOS.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Voh3NXqrzFgK56iCnHqxZ2
---
 src/meson.build | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/meson.build b/src/meson.build
index 5fa89f01..6389d5fb 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -228,6 +228,11 @@ else
     apple_core_services_found = false
 endif
 
+if host_machine.system() == 'darwin' and librecoll_needed
+    # utils/powerstatus.cpp uses the IOKit power sources API (with CoreFoundation types)
+    librecolldeps += dependency('appleframeworks', modules: ['CoreFoundation', 'IOKit'])
+endif
+
 recoll_conf.set('HAVE_VSNPRINTF', cpp.has_function('vsnprintf'))
 recoll_conf.set(
     'HAVE_POSIX_FADVISE',
-- 
