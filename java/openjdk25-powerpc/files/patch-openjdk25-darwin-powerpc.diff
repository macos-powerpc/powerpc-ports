+@interface JNFCoercionEntry : NSObject {
+@public
+    JNFTypeCoercion *coercion;
+    Class nsClass;
+    NSString *javaClassName;
+}
+- (id)initWithCoercion:(JNFTypeCoercion *)aCoercion nsClass:(Class)aNSClass javaClass:(NSString *)aJavaClassName;
+@end
+
+@implementation JNFCoercionEntry
+- (id)initWithCoercion:(JNFTypeCoercion *)aCoercion nsClass:(Class)aNSClass javaClass:(NSString *)aJavaClassName {
+    self = [super init];
+    if (self != nil) {
+        coercion = [aCoercion retain];
+        nsClass = aNSClass;
+        javaClassName = [aJavaClassName copy];
+    }
+    return self;
+}
+
+- (void)dealloc {
+    [coercion release];
+    [javaClassName release];
+    [super dealloc];
+}
+@end
+
+@interface JNFStringCoercion : NSObject
+@end
+
+@implementation JNFStringCoercion
+- (jobject)coerceNSObject:(id)obj withEnv:(JNIEnv *)env usingCoercer:(id)coercer {
+    (void)coercer;
+    return JNFNSToJavaString(env, (NSString *)obj);
+}
+
+- (id)coerceJavaObject:(jobject)obj withEnv:(JNIEnv *)env usingCoercer:(id)coercer {
+    (void)coercer;
+    return JNFJavaToNSString(env, (jstring)obj);
+}
+@end
+
+@interface JNFNumberCoercion : NSObject
+@end
+
+@implementation JNFNumberCoercion
+- (jobject)coerceNSObject:(id)obj withEnv:(JNIEnv *)env usingCoercer:(id)coercer {
+    (void)coercer;
+    NSNumber *number = (NSNumber *)obj;
+    const char *type = [number objCType];
+
+    if (type != NULL && strcmp(type, @encode(BOOL)) == 0) {
+        static JNF_CLASS_CACHE(jc_Boolean, "java/lang/Boolean");
+        static JNF_STATIC_MEMBER_CACHE(jm_valueOf, jc_Boolean, "valueOf", "(Z)Ljava/lang/Boolean;");
+        return JNFCallStaticObjectMethod(env, jm_valueOf, (jboolean)[number boolValue]);
+    }
+
+    static JNF_CLASS_CACHE(jc_Double, "java/lang/Double");
+    static JNF_CTOR_CACHE(jm_Double_ctor, jc_Double, "(D)V");
+    return JNFNewObject(env, jm_Double_ctor, (jdouble)[number doubleValue]);
+}
+
+- (id)coerceJavaObject:(jobject)obj withEnv:(JNIEnv *)env usingCoercer:(id)coercer {
+    (void)coercer;
+    return JNFJavaToNSNumber(env, obj);
+}
+@end
+
+@implementation JNFTypeCoercer
+- (id)init {
+    self = [super init];
+    if (self != nil) {
+        coercions = [[NSMutableArray alloc] init];
+    }
+    return self;
+}
+
+- (void)dealloc {
+    [coercions release];
+    [super dealloc];
+}
+
+- (void)addCoercion:(JNFTypeCoercion *)aCoercion forNSClass:(Class)aNSClass javaClass:(NSString *)aJavaClassName {
+    if (aCoercion == nil) return;
+    JNFCoercionEntry *entry = [[[JNFCoercionEntry alloc] initWithCoercion:aCoercion
+                                                                   nsClass:aNSClass
+                                                                 javaClass:aJavaClassName] autorelease];
+    [coercions addObject:entry];
+}
+
+- (JNFTypeCoercer *)deriveCoercer {
+    JNFTypeCoercer *derived = [[[JNFTypeCoercer alloc] init] autorelease];
+    [derived->coercions addObjectsFromArray:coercions];
+    return derived;
+}
+
+- (jobject)coerceNSObject:(id)obj withEnv:(JNIEnv *)env {
+    return [self coerceNSObject:obj withEnv:env usingCoercer:self];
+}
+
+- (jobject)coerceNSObject:(id)obj withEnv:(JNIEnv *)env usingCoercer:(id)coercer {
+    if (obj == nil || obj == [NSNull null]) return NULL;
+
+    for (JNFCoercionEntry *entry in coercions) {
+        if (entry->nsClass != Nil && [obj isKindOfClass:entry->nsClass]) {
+            return [entry->coercion coerceNSObject:obj withEnv:env usingCoercer:coercer];
+        }
+    }
+
+    return JNFNSToJavaString(env, [obj description]);
+}
+
+- (id)coerceJavaObject:(jobject)obj withEnv:(JNIEnv *)env {
+    return [self coerceJavaObject:obj withEnv:env usingCoercer:self];
+}
+
+- (id)coerceJavaObject:(jobject)obj withEnv:(JNIEnv *)env usingCoercer:(id)coercer {
+    if (env == NULL || obj == NULL) return nil;
+
+    for (JNFCoercionEntry *entry in coercions) {
+        if (entry->javaClassName == nil) continue;
+        jclass cls = (*env)->FindClass(env, [entry->javaClassName UTF8String]);
+        if (cls == NULL) {
+            if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);
+            continue;
+        }
+        jboolean matches = (*env)->IsInstanceOf(env, obj, cls);
+        (*env)->DeleteLocalRef(env, cls);
+        if (matches) {
+            return [entry->coercion coerceJavaObject:obj withEnv:env usingCoercer:coercer];
+        }
+    }
+
+    return JNFObjectToString(env, obj);
+}
+@end
+
+@implementation JNFDefaultCoercions
++ (JNFTypeCoercer *)defaultCoercer {
+    static JNFTypeCoercer *coercer = nil;
+    if (coercer == nil) {
+        coercer = [[JNFTypeCoercer alloc] init];
+        [self addStringCoercionTo:coercer];
+        [self addNumberCoercionTo:coercer];
+    }
+    return coercer;
+}
+
++ (void)addStringCoercionTo:(JNFTypeCoercer *)coercer {
+    [coercer addCoercion:[[[JNFStringCoercion alloc] init] autorelease]
+              forNSClass:[NSString class]
+               javaClass:@"java/lang/String"];
+}
+
