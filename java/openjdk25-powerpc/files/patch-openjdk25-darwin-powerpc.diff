+jlong JNFNSTimeIntervalToJavaMillis(NSTimeInterval interval) {
+    return (jlong)(interval * 1000.0);
+}
+
+NSString *JNFNormalizedNSStringForPath(JNIEnv *env, jstring path) {
+    return [JNFJavaToNSString(env, path) stringByStandardizingPath];
+}
+
+jstring JNFNormalizedJavaStringForPath(JNIEnv *env, NSString *path) {
+    return JNFNSToJavaString(env, [path stringByStandardizingPath]);
+}
+
+void JNFDumpJavaStack(JNIEnv *env) {
+    if (env == NULL) return;
+    jclass cls = (*env)->FindClass(env, "java/lang/Thread");
+    if (cls == NULL) return;
+    jmethodID mid = (*env)->GetStaticMethodID(env, cls, "dumpStack", "()V");
+    if (mid != NULL) (*env)->CallStaticVoidMethod(env, cls, mid);
+    (*env)->DeleteLocalRef(env, cls);
+}
+
+void *JNFNativeMethodEnter(JNIEnv *env) {
+    JNFRememberVM(env);
+    return [[NSAutoreleasePool alloc] init];
+}
+
+void JNFNativeMethodExit(void *token) {
+    [(NSAutoreleasePool *)token drain];
+}
+
+#define JNF_THREAD_ATTACHED_HERE (1u << 31)
+
+JNIEnv *JNFObtainEnv(JNFThreadContext *context) {
+    JNIEnv *env = NULL;
+    jint status;
+
+    if (gJavaVM == NULL) return NULL;
+
+    status = (*gJavaVM)->GetEnv(gJavaVM, (void **)&env, JNI_VERSION_1_2);
+    if (status == JNI_OK) return env;
+    if (status != JNI_EDETACHED) return NULL;
+
+    if (context != NULL && ((*context) & JNFThreadAttachAsDaemon)) {
+        if ((*gJavaVM)->AttachCurrentThreadAsDaemon(gJavaVM, (void **)&env, NULL) != 0) {
+            return NULL;
+        }
+    } else {
+        if ((*gJavaVM)->AttachCurrentThread(gJavaVM, (void **)&env, NULL) != 0) {
+            return NULL;
+        }
+    }
+
+    if (context != NULL) *context |= JNF_THREAD_ATTACHED_HERE;
+    return env;
+}
+
+void JNFReleaseEnv(JNIEnv *env, JNFThreadContext *context) {
+    (void)env;
+    if (gJavaVM != NULL && context != NULL && ((*context) & JNF_THREAD_ATTACHED_HERE)) {
+        (*gJavaVM)->DetachCurrentThread(gJavaVM);
+        *context &= ~JNF_THREAD_ATTACHED_HERE;
+    }
+}
+
+void JNFCheckAndRethrowException(JNIEnv *env) {
+    if (env != NULL && (*env)->ExceptionCheck(env)) {
+        @throw [JNFException exceptionWithName:@"JavaException" reason:@"Java exception pending" userInfo:nil];
+    }
+}
