+NSString *JNFJavaToNSString(JNIEnv *env, jstring str) {
+    if (env == NULL || str == NULL) return nil;
+    const jchar *chars = (*env)->GetStringChars(env, str, NULL);
+    if (chars == NULL) return nil;
+    jsize len = (*env)->GetStringLength(env, str);
+    NSString *result = [[[NSString alloc] initWithCharacters:(const unichar *)chars length:len] autorelease];
+    (*env)->ReleaseStringChars(env, str, chars);
+    return result;
+}
+
+jstring JNFNSToJavaString(JNIEnv *env, NSString *str) {
+    if (env == NULL || str == nil) return NULL;
+    NSUInteger len = [str length];
+    unichar *chars = (unichar *)malloc(sizeof(unichar) * len);
+    if (chars == NULL && len != 0) return NULL;
+    [str getCharacters:chars range:NSMakeRange(0, len)];
+    jstring result = (*env)->NewString(env, (const jchar *)chars, (jsize)len);
+    free(chars);
+    return result;
+}
+
+NSString *JNFObjectToString(JNIEnv *env, jobject obj) {
+    NSString *result = nil;
+    if (env == NULL || obj == NULL) return nil;
+
+    static JNF_CLASS_CACHE(jc_Object, "java/lang/Object");
+    static JNF_MEMBER_CACHE(jm_toString, jc_Object, "toString", "()Ljava/lang/String;");
+    jstring str = (jstring)JNFCallObjectMethod(env, obj, jm_toString);
+    if (str != NULL) {
+        result = [[JNFJavaToNSString(env, str) retain] autorelease];
+        (*env)->DeleteLocalRef(env, str);
+    }
+    return result;
+}
+
+NSNumber *JNFJavaToNSNumber(JNIEnv *env, jobject number) {
+    if (env == NULL || number == NULL) return nil;
+    static JNF_CLASS_CACHE(jc_Number, "java/lang/Number");
+    static JNF_MEMBER_CACHE(jm_doubleValue, jc_Number, "doubleValue", "()D");
+    static JNF_CLASS_CACHE(jc_Boolean, "java/lang/Boolean");
+    static JNF_MEMBER_CACHE(jm_booleanValue, jc_Boolean, "booleanValue", "()Z");
+    if (JNFIsInstanceOf(env, number, &jc_Boolean)) {
+        return [NSNumber numberWithBool:JNFCallBooleanMethod(env, number, jm_booleanValue)];
+    }
+    if (JNFIsInstanceOf(env, number, &jc_Number)) {
+        return [NSNumber numberWithDouble:JNFCallDoubleMethod(env, number, jm_doubleValue)];
+    }
+    return nil;
+}
