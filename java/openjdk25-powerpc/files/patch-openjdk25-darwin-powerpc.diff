+
+@implementation AWTRunnable
+- (id)initWithTarget:(id)target selector:(SEL)selector object:(id)object {
+    self = [super init];
+    if (self != nil) {
+        fTarget = [target retain];
+        fSelector = selector;
+        fObject = [object retain];
+    }
+    return self;
+}
+- (void)dealloc {
+    [fTarget release];
+    [fObject release];
+    [super dealloc];
+}
+- (void)run {
+    if (fTarget != nil && fSelector != NULL) {
+        [fTarget performSelector:fSelector withObject:fObject];
+    }
+}
+@end
+
