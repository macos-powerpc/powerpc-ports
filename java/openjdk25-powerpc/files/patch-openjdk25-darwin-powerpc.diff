 # All install-file and related macros automatically call DecodeSpace when needed.
 
-ifeq ($(call isTargetOs, macosx), true)
+ifeq ($(call isBuildOs, macosx), true)
+  # Leopard xattr lacks clear-all and no-follow options.
+  XATTR_HAS_CLEAR := $(shell $(XATTR) -h 2>&1 | $(GREP) -c -- "-c")
+  ifneq ($(XATTR_HAS_CLEAR), 0)
+    define clear-file-attributes
+	if [ -n "`$(XATTR) -ls '$(call DecodeSpace, $@)'`" ]; then \
+          $(CHMOD) -h u+w '$(call DecodeSpace, $@)'; \
+	  $(XATTR) -cs '$(call DecodeSpace, $@)'; \
+	fi
+    endef
+  else
+    define clear-file-attributes
+	if [ ! -h '$(call DecodeSpace, $@)' ]; then \
+	  $(XATTR) '$(call DecodeSpace, $@)' | while IFS= read -r attr; do \
+	    $(CHMOD) u+w '$(call DecodeSpace, $@)'; \
+	    $(XATTR) -d "$$attr" '$(call DecodeSpace, $@)' || exit $$?; \
+	  done; \
+	fi
+    endef
+  endif
   # On mac, extended attributes sometimes creep into the source files, which may later
   # cause the creation of ._* files which confuses testing. Clear these with xattr if
   # set. Some files get their write permissions removed after being copied to the
@@ -132,10 +151,7 @@ ifeq ($(call isTargetOs, macosx), true)
