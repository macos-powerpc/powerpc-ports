diff --git a/src/hotspot/os/bsd/clock_compat_bsd.hpp b/src/hotspot/os/bsd/clock_compat_bsd.hpp
new file mode 100644
--- /dev/null
+++ b/src/hotspot/os/bsd/clock_compat_bsd.hpp
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#ifndef OS_BSD_CLOCK_COMPAT_BSD_HPP
+#define OS_BSD_CLOCK_COMPAT_BSD_HPP
+
+#if defined(__APPLE__) && !defined(CLOCK_REALTIME)
+#include <errno.h>
+#include <mach/mach_time.h>
+#include <stdint.h>
+#include <sys/time.h>
+#include <time.h>
+
+typedef int clockid_t;
+#define CLOCK_REALTIME 0
+#define CLOCK_MONOTONIC 6
+
+static inline int clock_gettime(clockid_t clock, struct timespec* value) {
+  if (clock == CLOCK_REALTIME) {
+    struct timeval tv;
+    int status = gettimeofday(&tv, NULL);
+    if (status != 0) return status;
+    value->tv_sec = tv.tv_sec;
+    value->tv_nsec = tv.tv_usec * 1000;
+    return 0;
+  }
+  if (clock == CLOCK_MONOTONIC) {
+    mach_timebase_info_data_t scale;
+    if (mach_timebase_info(&scale) != KERN_SUCCESS || scale.denom == 0) {
+      errno = EINVAL;
+      return -1;
+    }
+    uint64_t ticks = mach_absolute_time();
+    uint64_t nanos = ticks / scale.denom * scale.numer
+        + ticks % scale.denom * scale.numer / scale.denom;
+    value->tv_sec = nanos / 1000000000ULL;
+    value->tv_nsec = nanos % 1000000000ULL;
+    return 0;
+  }
+  errno = EINVAL;
+  return -1;
+}
+#endif
+#endif
