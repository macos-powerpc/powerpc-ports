+static void JNFThrow(JNIEnv *env, const char *className, const char *reason) {
+    if (env == NULL || className == NULL) return;
+    jclass cls = (*env)->FindClass(env, className);
+    if (cls != NULL) {
+        (*env)->ThrowNew(env, cls, reason == NULL ? "" : reason);
+        (*env)->DeleteLocalRef(env, cls);
+    }
+}
+
+jclass JNFGetCachedClass(JNIEnv *env, JNFClassInfo *info) {
+    if (info == NULL || env == NULL) return NULL;
+    JNFRememberVM(env);
+    if (info->cls == NULL) {
+        jclass local = (*env)->FindClass(env, info->name);
+        if (local == NULL) return NULL;
+        info->cls = (*env)->NewGlobalRef(env, local);
+        (*env)->DeleteLocalRef(env, local);
+    }
+    return info->cls;
+}
+
+jmethodID JNFGetCachedMethod(JNIEnv *env, JNFMemberInfo *info) {
+    if (info == NULL || env == NULL) return NULL;
+    if (info->methodID == NULL) {
+        jclass cls = JNFGetCachedClass(env, info->classInfo);
+        if (cls == NULL) return NULL;
+        if (info->isConstructor) {
+            info->methodID = (*env)->GetMethodID(env, cls, "<init>", info->signature);
+        } else if (info->isStatic) {
+            info->methodID = (*env)->GetStaticMethodID(env, cls, info->name, info->signature);
+        } else {
+            info->methodID = (*env)->GetMethodID(env, cls, info->name, info->signature);
+        }
+    }
+    return info->methodID;
+}
+
+jfieldID JNFGetCachedField(JNIEnv *env, JNFMemberInfo *info) {
+    if (info == NULL || env == NULL) return NULL;
+    if (info->fieldID == NULL) {
+        jclass cls = JNFGetCachedClass(env, info->classInfo);
+        if (cls == NULL) return NULL;
+        if (info->isStatic) {
+            info->fieldID = (*env)->GetStaticFieldID(env, cls, info->name, info->signature);
+        } else {
+            info->fieldID = (*env)->GetFieldID(env, cls, info->name, info->signature);
+        }
+    }
+    return info->fieldID;
+}
