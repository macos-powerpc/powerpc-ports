name                openjdk25-powerpc
version             25.0.5.0.2
revision            0
categories          java lang devel
platforms           {darwin >= 9 < 10}
supported_archs     ppc ppc64
license             GPL-2
maintainers         nomaintainer
description         Experimental OpenJDK 25 for Mac OS X PowerPC
long_description    OpenJDK 25 for Mac OS X 10.5, with the Zero interpreter on \
                    PPC32 and the HotSpot server VM on PPC64 G5. Includes the \
                    legacy Cocoa/AWT port and PowerPC Foreign Function and Memory support.
homepage            https://openjdk.org/projects/jdk/25/

