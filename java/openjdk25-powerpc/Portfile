                    size    119792024


# Versioned bootstrap distfiles are immutable.
master_sites-append https://powerpc-ports.org/distfiles/openjdk25/bootstrap-2:bootstrap \
                    https://github.com/libffi/libffi/releases/download/v3.8.0:ffi
set bootstrap_file  openjdk25-bootstrap-2-darwin9-${configure.build_arch}.tar.gz
distfiles-append    ${bootstrap_file}:bootstrap libffi-3.8.0.tar.gz:ffi
if {${configure.build_arch} eq "ppc"} {
    checksums-append ${bootstrap_file} \
        rmd160 0f7432db50ea7d3b37172a9b2cd81ee39cf07a2f \
        sha256 621ad9de0d6eecfd78ec68a39770aa585a134d14c6db1f5ef874045265f49fde \
        size 127237328
}
if {${configure.build_arch} eq "ppc64"} {
    checksums-append ${bootstrap_file} \
        rmd160 99391a2f7661f44d64a027fc864f7dc7a1a07860 \
        sha256 95c9de5c7c78747f734e0c73cc0c57979a8c713301e91ed210b9fb88d87349b4 \
