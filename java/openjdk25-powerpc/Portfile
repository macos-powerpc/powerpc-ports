patchfiles          patch-openjdk25-darwin-powerpc.diff
patch.pre_args      -p1
universal_variant   no
use_xcode           yes
compiler.whitelist  macports-gcc-14
configure.compiler.add_deps no
configure.optflags  -O2
configure.ccache    no
compiler.cpath      {}
compiler.library_path {}
configure.cppflags  {}
configure.ldflags-delete -L${prefix}/lib
depends_build-append port:autoconf port:automake port:bash port:gmake \
                    path:bin/pkg-config:pkgconfig port:gcc14
depends_skip_archcheck-append autoconf automake bash gmake pkgconfig gcc14
if {${configure.build_arch} ne "ppc64"} {
    depends_lib-append port:libgcc
}

set boot_jdk        ${workpath}/jdk-bootstrap
set ffi_prefix      ${workpath}/libffi-private

set jdk_bundle      ${prefix}/Library/Java/JavaVirtualMachines/${name}.jdk
set jdk_home        ${jdk_bundle}/Contents/Home
set conf_name       ${name}-${configure.build_arch}
set image_path      ${worksrcpath}/build/${conf_name}/images/jdk
set pointer_bits    32
if {${configure.build_arch} eq "ppc64"} {
    set support_dir ${workpath}/gcc14-ppc64-support-1
    master_sites-append https://powerpc-ports.org/distfiles/openjdk25/native-build-support-1:gccsupport
    distfiles-append gcc14-ppc64-support-1.tar.gz:gccsupport
    checksums-append gcc14-ppc64-support-1.tar.gz \
        rmd160 e11173fedcd81d91e6267fc0cb7f7c696c2ac06b \
        sha256 aa5ba3f638539e7c523752791f676bc5020a170c3f4ea8cac9a54322c353b22a \
        size 1595429
    configure.cflags-append -B${support_dir}/
    configure.cxxflags-append -B${support_dir}/
    configure.ldflags-prepend -B${support_dir}/ -L${support_dir} -static-libstdc++ -static-libgcc
    set pointer_bits 64
    configure.cflags-append   -mcpu=970 -DPPC64_DIRECT_C_FUNCTIONS
    configure.cxxflags-append -mcpu=970 -DPPC64_DIRECT_C_FUNCTIONS
} else {
    configure.cflags-append   -mcpu=7400
    configure.cxxflags-append -mcpu=7400
    configure.ldflags-append  -L${prefix}/lib/libgcc -latomic
}

configure.cmd       ${prefix}/bin/bash ./configure
configure.pre_args  --prefix=${prefix}
configure.args      --with-conf-name=${conf_name} \
                    --with-debug-level=release \
                    --with-toolchain-type=gcc \
                    --with-target-bits=${pointer_bits} \
                    --with-boot-jdk=${boot_jdk} \
                    --with-native-debug-symbols=none \
                    --without-macosx-codesign \
                    --disable-warnings-as-errors \
                    --enable-precompiled-headers \
                    --disable-headless-only \
                    --with-jvm-features=-dtrace,-jvmci \
                    --with-extra-cflags="${configure.cflags}" \
                    --with-extra-cxxflags="${configure.cxxflags}" \
                    --with-extra-ldflags="${configure.ldflags}" \
                    --with-jobs=${buildmakejobs} \
                    --with-vendor-name="PPCPorts" \
                    --with-vendor-url="https://macos-powerpc.org" \
                    --with-vendor-bug-url="https://github.com/macos-powerpc/powerpc-ports/issues" \
                    --with-vendor-vm-bug-url="https://github.com/macos-powerpc/powerpc-ports/issues"
if {${configure.build_arch} eq "ppc64"} {
    configure.args-append --build=powerpc64-apple-darwin${os.major} \
                          --host=powerpc64-apple-darwin${os.major}
}
if {${configure.sdkroot} ne ""} {
    configure.args-append --with-sysroot=${configure.sdkroot}
}
configure.env-append CFLAGS= CXXFLAGS= OBJCFLAGS= CPPFLAGS= LDFLAGS= CPATH= LIBRARY_PATH=

variant zero conflicts server description {Build the Zero interpreter without a JIT} {
    configure.args-append --with-jvm-variants=zero \
                          --with-libffi=${ffi_prefix} --disable-libffi-bundling
}
variant server conflicts zero description {Build the PPC64 G5 HotSpot VM with C1 and C2} {
    configure.args-append --with-jvm-variants=server
}
variant debug description {Build HotSpot with assertions and debugging support} {
    configure.args-replace --with-debug-level=release --with-debug-level=fastdebug
}
if {![variant_isset zero] && ![variant_isset server]} {
    if {${configure.build_arch} eq "ppc64"} {
        default_variants-append +server
    } else {
        default_variants-append +zero
    }
}

post-patch {
    set automake_dir [lindex [lsort -command vercmp \
        [glob -directory ${prefix}/share automake-*]] end]
    copy -force ${automake_dir}/config.guess \
        ${worksrcpath}/make/autoconf/build-aux/autoconf-config.guess
    copy -force ${automake_dir}/config.sub \
        ${worksrcpath}/make/autoconf/build-aux/autoconf-config.sub
}

pre-configure {
    if {${os.platform} ne "darwin" || ${os.major} != 9} {
        return -code error "This port currently targets Mac OS X 10.5 PowerPC."
    }
    if {[variant_isset server] && ${configure.build_arch} ne "ppc64"} {
        return -code error "+server requires configure.build_arch=ppc64; PPC32 uses +zero."
    }
    foreach tool {java javac jar jlink jmod} {
        if {![file executable ${boot_jdk}/bin/${tool}]} {
            return -code error "Bootstrap archive is incomplete: missing bin/${tool}."
        }
    }
    if {[catch {exec ${boot_jdk}/bin/java -version 2>@1} boot_version] || \
        ![regexp {version "(24|25)([.+-]|")} ${boot_version}]} {
        return -code error "Bootstrap archive must contain a runnable native JDK 24 or 25."
    }

    if {[catch {exec ${boot_jdk}/bin/java --describe-module jdk.localedata 2>@1}]} {
        return -code error "Bootstrap JDK is missing jdk.localedata, required for locale-data generation."
    }

    if {[variant_isset zero]} {
        set ffi_build ${workpath}/libffi-build
        xinstall -d ${ffi_build}
        system -W ${ffi_build} "${configure.env} CC='${configure.cc}' CXX='${configure.cxx}' CFLAGS='${configure.cflags} -m${pointer_bits} -fPIC' LDFLAGS='${configure.ldflags} -m${pointer_bits}' ${prefix}/bin/bash ${workpath}/libffi-3.8.0/configure --prefix=${ffi_prefix} --libdir=${ffi_prefix}/lib --disable-shared --enable-static --disable-docs --disable-multi-os-directory --with-pic"
        system -W ${ffi_build} "${prefix}/bin/gmake -j${buildmakejobs}"
        system -W ${ffi_build} "${prefix}/bin/gmake install"
    }

}

build.env-append    CPATH= LIBRARY_PATH=
build.cmd           ${prefix}/bin/gmake
build.target        images
build.args          CONF=${conf_name} JOBS=${buildmakejobs}
use_parallel_build  no

destroot {
    foreach tool {java javac jar jlink jmod} {
        if {![file executable ${image_path}/bin/${tool}]} {
            return -code error "Incomplete JDK image: bin/${tool} is missing."
        }
    }
    xinstall -d ${destroot}${jdk_bundle}/Contents
    copy ${image_path} ${destroot}${jdk_home}
    if {${configure.build_arch} eq "ppc64"} {
        xinstall -d ${destroot}${jdk_home}/legal/gcc-runtime
        xinstall -m 644 ${support_dir}/COPYING3 ${support_dir}/COPYING.RUNTIME \
            ${destroot}${jdk_home}/legal/gcc-runtime
    }
    xinstall -m 644 ${filespath}/Info.plist ${destroot}${jdk_bundle}/Contents/Info.plist
    reinplace "s|@VERSION@|${version}|g" ${destroot}${jdk_bundle}/Contents/Info.plist
    reinplace "s|@ARCH@|${configure.build_arch}|g" ${destroot}${jdk_bundle}/Contents/Info.plist
    xinstall -d ${destroot}${jdk_bundle}/Contents/MacOS
    ln -s ../Home/lib/libjli.dylib ${destroot}${jdk_bundle}/Contents/MacOS/libjli.dylib
    xinstall -d ${destroot}/Library/Java/JavaVirtualMachines
    ln -s ${jdk_bundle} ${destroot}/Library/Java/JavaVirtualMachines/${name}.jdk
}
destroot.violate_mtree yes

test.run            yes
test {
    set classes ${workpath}/smoke-tests
    xinstall -d ${classes}
    foreach probe {Java25Bringup ByteReverseProbe ArrayCopyProbe BridgeProbe} {
        ui_info [exec ${image_path}/bin/javac -d ${classes} ${filespath}/${probe}.java 2>@1]
        ui_info [exec ${image_path}/bin/java -Djava.awt.headless=true -cp ${classes} ${probe} 2>@1]
    }
}

notes "
Experimental PowerPC port: PPC32 defaults to Zero; PPC64 defaults to HotSpot server.
Zero virtual threads use a native-thread fallback, not multiplexed continuations.
This port has not completed jtreg or Java compatibility certification.
Set JAVA_HOME=${jdk_home} to select it.

"
livecheck.type      none
