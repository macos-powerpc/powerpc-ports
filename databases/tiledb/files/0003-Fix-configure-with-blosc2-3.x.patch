From 2317c1466cb96f662c6cd7657521d0db1b15c174 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 15 Nov 2026 19:21:18 +0000
Subject: [PATCH] Fix configure with blosc2 3.x

Blosc2 3.x's Blosc2Config.cmake resolves LZ4 and zstd itself and its
Blosc2::blosc2_static link interface references LZ4::lz4 and either
zstd::libzstd_shared or zstd::libzstd.

When lz4 has no CMake config, Blosc2Config's find_dependency(LZ4 MODULE)
picks up TileDB's FindLZ4.cmake, which only defined lz4::lz4, so
generation fails with "target LZ4::lz4 not found". Define LZ4::lz4 in
the fallback path and make lz4::lz4 an alias of it.

When blosc2 was built without zstdConfig.cmake, its bundled FindZSTD
defines a standalone zstd::libzstd. A later find_package(zstd CONFIG)
then fails with "Some (but not all) targets in this export set were
already defined". Find zstd before Blosc2, so the official export set
is loaded first and blosc2's FindZSTD reuses its targets.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 cmake/Modules/FindLZ4.cmake | 9 ++++++---
 tiledb/CMakeLists.txt       | 2 +-
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git cmake/Modules/FindLZ4.cmake cmake/Modules/FindLZ4.cmake
index e6678dd..23c55c7 100644
--- cmake/Modules/FindLZ4.cmake
+++ cmake/Modules/FindLZ4.cmake
@@ -62,11 +62,14 @@ else()
     REQUIRED_VARS LZ4_LIBRARIES LZ4_INCLUDE_DIR
   )
 
-  if (LZ4_FOUND AND NOT TARGET lz4::lz4)
-    add_library(lz4::lz4 UNKNOWN IMPORTED)
-    set_target_properties(lz4::lz4 PROPERTIES
+  if (LZ4_FOUND AND NOT TARGET LZ4::lz4)
+    add_library(LZ4::lz4 UNKNOWN IMPORTED)
+    set_target_properties(LZ4::lz4 PROPERTIES
       IMPORTED_LOCATION "${LZ4_LIBRARIES}"
       INTERFACE_INCLUDE_DIRECTORIES "${LZ4_INCLUDE_DIR}"
     )
   endif()
+  if (LZ4_FOUND AND NOT TARGET lz4::lz4)
+    add_library(lz4::lz4 ALIAS LZ4::lz4)
+  endif()
 endif()
diff --git tiledb/CMakeLists.txt tiledb/CMakeLists.txt
index 3343e55..65cee31 100644
--- tiledb/CMakeLists.txt
+++ tiledb/CMakeLists.txt
@@ -543,13 +543,13 @@ endif()
 # Required dependencies. These come last as any prior dependencies relying on
 # these must be listed first for Linux. E.g. AWSSDK and Curl depend on Zlib,
 # which is installed here.
+find_package(zstd CONFIG REQUIRED)
 find_package(Blosc2 CONFIG REQUIRED)
 find_package(BZip2 REQUIRED)
 find_package(LZ4 MODULE REQUIRED)
 find_package(nlohmann_json CONFIG REQUIRED)
 find_package(spdlog REQUIRED)
 find_package(ZLIB REQUIRED)
-find_package(zstd CONFIG REQUIRED)
 target_link_libraries(TILEDB_CORE_OBJECTS_ILIB
   INTERFACE
     Blosc2::blosc2
