+#ifndef MONGO_CONFIG_WIREDTIGER_ENABLED
+namespace {
+struct WiredTigerUtil {
+    static constexpr StringData kConfigStringField = "configString"_sd;
+
+    static boost::optional<std::string> getConfigStringFromStorageOptions(
+        const BSONObj& options) {
+        if (auto wtElem = options["wiredTiger"]) {
+            if (auto configStringElem = wtElem.Obj().getField(kConfigStringField)) {
+                return configStringElem.String();
+            }
+        }
+        return boost::none;
+    }
+
+    static BSONObj setConfigStringToStorageOptions(const BSONObj& options,
+                                                   const std::string& configString) {
+        auto wtElem = options["wiredTiger"];
+        auto wtObj = wtElem ? wtElem.Obj() : BSONObj();
+        return options.addFields(
+            BSON("wiredTiger" << wtObj.addFields(BSON(kConfigStringField << configString))));
+    }
+
+    static Status checkTableCreationOptions(const BSONElement&) {
+        return Status::OK();
+    }
+};
+}  // namespace
+#endif
