From 1b51fc7fdc817983a2706867c87186f2e365df51 Mon Sep 17 00:00:00 2001
From: lexicalunit <lexicalunit@lexicalunit.com>
Date: Fri, 16 Oct 2026 14:48:48 -0700
Subject: [PATCH] Bind bool where it is wider than a byte

3.0.7 bound bool as SQL_C_BIT behind a static_assert that bool is one
byte, which stopped the library building at all on PowerPC Darwin, where
bool is four. A one-byte bool still binds as SQL_C_BIT; a wider one binds
as the unsigned integer C type of its own width, which ODBC converts to
and from SQL_BIT, so output parameters keep working. Reading a bool was
already independent of its width.

Fixes #579

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CHANGELOG.md        |  4 ++++
 nanodbc/nanodbc.cpp | 11 +++++++----
 nanodbc/nanodbc.h   |  3 ++-
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 2e8bf196..1f4a9965 100644
--- CHANGELOG.md
+++ CHANGELOG.md
@@ -1,5 +1,9 @@
 # ChangeLog
 
+## Unreleased
+
+- Binding `bool` builds where `bool` is wider than a byte, as on PowerPC Darwin. [`#579`](https://github.com/nanodbc/nanodbc/issues/579)
+
 ## v3.0.7
 
 - `transaction` drops its empty destructor, so moving one moves its handle rather than copying it.
diff --git a/nanodbc/nanodbc.cpp b/nanodbc/nanodbc.cpp
index f08efb2c..a62050e0 100644
--- nanodbc/nanodbc.cpp
+++ nanodbc/nanodbc.cpp
@@ -897,10 +897,13 @@ struct sql_ctype
 template <>
 struct sql_ctype<bool>
 {
-    // ODBC represents SQL_C_BIT as a single byte holding 0 or 1, which matches the
-    // representation of bool on every platform nanodbc supports.
-    static_assert(sizeof(bool) == 1, "binding bool as SQL_C_BIT requires a single byte bool");
-    static constexpr SQLSMALLINT value = SQL_C_BIT;
+    // SQL_C_BIT is one byte, so a wider bool binds as the unsigned integer of its width.
+    static_assert(
+        sizeof(bool) == 1 || sizeof(bool) == 2 || sizeof(bool) == 4,
+        "bool must be one, two or four bytes wide");
+    static constexpr SQLSMALLINT value = sizeof(bool) == 1   ? SQL_C_BIT
+                                         : sizeof(bool) == 2 ? SQL_C_USHORT
+                                                             : SQL_C_ULONG;
 };
 
 template <typename T>
diff --git a/nanodbc/nanodbc.h b/nanodbc/nanodbc.h
index 17fe8946..16fc7861 100644
--- nanodbc/nanodbc.h
+++ nanodbc/nanodbc.h
@@ -1225,7 +1225,8 @@ class statement
     ///            std::vector<std::vector<std::uint8_t>> overloads, and strings through
     ///            bind_strings().
     ///
-    /// \attention bool is bound as ODBC's SQL_C_BIT, and only the overloads that carry no
+    /// \attention bool is bound as ODBC's SQL_C_BIT, or as an unsigned integer of the same
+    ///            width where bool is wider than a byte, and only the overloads that carry no
     ///            null information are available for it. The null_sentry overload takes
     ///            `T const*` and the null flags overload takes `bool const*`, so for
     ///            T=bool the two collapse into one signature that neither an explicit
