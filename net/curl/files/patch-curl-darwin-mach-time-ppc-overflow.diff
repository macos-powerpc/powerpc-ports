--- lib/curlx/timeval.c	2026-09-26 05:16:06.739821515 +0000
+++ lib/curlx/timeval.c	2026-09-26 05:16:17.000126728 +0000
@@ -132,8 +132,13 @@
     (void)mach_timebase_info(&timebase);
 
   usecs = mach_absolute_time();
-  usecs *= timebase.numer; /* spellchecker:disable-line */
-  usecs /= timebase.denom;
+  /* On Intel and Apple silicon the timebase is 1/1 or small, but on PowerPC
+   * it is 1000000000 / <timebase frequency, tens of MHz>: multiplying first
+   * overflows 64 bits after a few minutes of uptime and the clock jumps back
+   * every ~9 minutes. Scale whole and fractional parts separately; neither
+   * intermediate can exceed 64 bits. */
+  usecs = (usecs / timebase.denom) * timebase.numer + /* spellchecker:disable-line */
+          (usecs % timebase.denom) * timebase.numer / timebase.denom;
   usecs /= 1000;
 
   pnow->tv_sec = usecs / 1000000;
