PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

github.setup        librats rasync 1.3.0
revision            0
categories          net p2p
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer
license             MIT
description         two-way directories synchronization over a peer-to-peer network
long_description    Real-time, {*}${description}.
checksums           rmd160  e005d44af07ab3c45ce53146a4e4e5bb8bf49c7f \
                    sha256  38d641e3f041446a34d7a3e3ff52c29811565181326cadb5605a91952a68638a \
                    size    441078
github.tarball_from archive
installs_libs       no

depends_lib-append  port:librats

compiler.cxx_standard   2017

patch.pre_args-replace  -p0 -p1

patchfiles-append    0001-system-librats.patch \
                     0002-32bit-be-hardening.patch

# RASYNC_LIBRATS_MIN_VERSION is a hack to accept librats from the port:
# it is not outdated, just upstream bakes in a wrong version number.
configure.args-append   -DRASYNC_BUILD_TESTS=OFF \
                        -DRASYNC_LIBRATS_MIN_VERSION=1.0.0 \
                        -DRASYNC_USE_SYSTEM_LIBRATS=ON

destroot {
    xinstall -m 755 ${cmake.build_dir}/bin/${name} ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/${name}
    copy ${worksrcpath}/README.md ${destroot}${prefix}/share/${name}
}
