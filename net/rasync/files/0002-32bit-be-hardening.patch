+
+// Counts picked so that count * entry-size wraps a 32-bit size_t to a few bytes —
+// which a few bytes of padding then satisfy. A bound check that multiplies lets
+// these through to a reserve() that throws; on 64-bit they were always refused.
+TEST(ManifestPatch, DecodeRejectsCountsThatWrapA32BitSize) {
+    BinaryWriter set;
+    set.u32(79536432u);                 // * 54 bytes per entry = 2^32 + 32
+    for (int i = 0; i < 40; ++i) set.u8(0);
+    EXPECT_FALSE(ManifestPatch::decode(set.take()).has_value());
+
+    BinaryWriter del;
+    del.u32(0);
+    del.u32(0x80000002u);               // * 2 bytes per path = 2^32 + 4
+    for (int i = 0; i < 8; ++i) del.u8(0);
+    EXPECT_FALSE(ManifestPatch::decode(del.take()).has_value());
+}
