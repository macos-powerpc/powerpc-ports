+// n * 20 bytes per block wraps a 32-bit size_t to 4, which the padding covers: a
+// bound check that multiplies passes this and the reserve() behind it throws.
+TEST(Delta, SignatureDecodeRejectsACountThatWrapsA32BitSize) {
+    BinaryWriter w;
+    w.u32(2048);
+    w.u64(0);
+    w.u32(0x0CCCCCCDu);                 // * 20 = 2^32 + 4
+    for (int i = 0; i < 8; ++i) w.u8(0);
+    EXPECT_FALSE(Signature::decode(w.take()).has_value());
+}
