+// ── pinned bytes ─────────────────────────────────────────────────────────────
+// The integration suite runs both peers in one process, so on a big-endian host
+// it shows BE talking to BE — never to the little-endian machines most peers are.
+// Exact bytes do: these were captured on x86-64, and a host that lays out any
+// field differently, or whose SHA-256 disagrees, fails here.
+
+TEST(ProtocolBytes, FolderTagIsPinned) {
+    EXPECT_EQ(proto::folder_tag("docs"), 0x84867af5u);
+}
+
+TEST(ProtocolBytes, ManifestPatchIsPinned) {
+    FileMeta m;
+    m.size  = 0x0102030405060708ull;
+    m.mtime = -2;
+    m.mode  = FileMeta::kExecutable;
+    for (size_t i = 0; i < m.hash.size(); ++i) m.hash[i] = static_cast<uint8_t>(i);
+    ManifestPatch p;
+    p.set.emplace_back("a/b", m);
+    p.removed.push_back("gone");
+
+    const Bytes want = {
+        0, 0, 0, 1,                                      // entries set
+        0, 3, 'a', '/', 'b',                             // path
+        1, 2, 3, 4, 5, 6, 7, 8,                          // size
+        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfe,  // mtime -2
+        0, 0, 0, 1,                                      // mode
+        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,  // hash
+        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+        0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
+        0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
+        0, 0, 0, 1,                                      // paths removed
+        0, 4, 'g', 'o', 'n', 'e',
+    };
+    EXPECT_EQ(p.encode(), want);
+}
+
+TEST(ProtocolBytes, SignatureIsPinned) {
+    const uint8_t abc[] = {'a', 'b', 'c'};
+    const Signature sig = signature_of(abc, sizeof(abc), 2048);
+    const Bytes want = {
+        0, 0, 0x08, 0,                                   // block size
+        0, 0, 0, 0, 0, 0, 0, 3,                          // file size
+        0, 0, 0, 1,                                      // blocks
+        0x02, 0x4a, 0x01, 0x26,                          // weak: b = 586, a = 294
+        0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,  // SHA-256("abc"), first 16
+        0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
+    };
+    EXPECT_EQ(sig.encode(), want);
+}
