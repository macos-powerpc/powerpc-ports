+    // time_t is still 32 bits on 32-bit Darwin and on 32-bit glibc before 2.34.
+    // Clamp an mtime it cannot hold rather than let the cast wrap 2040 into 1901,
+    // which `--conflict newer` would read as the oldest version there is. The
+    // limits are parenthesized for the same reason std::min is spelled out in
+    // send_gate.cpp: <windows.h> defines `min` and `max` as macros.
+    using time_type = decltype(t.modtime);
+    const auto clamped = static_cast<time_type>(
+        std::clamp<int64_t>(mtime, (std::numeric_limits<time_type>::min)(),
+                            (std::numeric_limits<time_type>::max)()));
+    t.actime = clamped;
+    t.modtime = clamped;
     RASYNC_UTIME(path.c_str(), &t);
 }
 
