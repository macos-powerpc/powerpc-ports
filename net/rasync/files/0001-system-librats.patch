build: allow linking an installed librats (RASYNC_USE_SYSTEM_LIBRATS)

-DRASYNC_USE_SYSTEM_LIBRATS=ON uses find_package(rats CONFIG) instead of
add_subdirectory(src/librats); the submodule need not be checked out. All
rasync targets now link rats::rats (exported by the package, aliased in the
bundled build). Minimum version defaults to the submodule pin (2.3.3), set
RASYNC_LIBRATS_MIN_VERSION= to accept any (tarball librats builds report 1.0.0).
An empty src/librats in bundled mode now fails configure with a hint.

Apply with: git apply <this file>   (base: 8856093)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a3e1c22..a74aaa7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -71,13 +71,35 @@ endif()
 set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR}/bin)
 
 option(RASYNC_BUILD_TESTS "Build the rasync test suite" ON)
+option(RASYNC_USE_SYSTEM_LIBRATS
+    "Link an installed librats (find_package(rats)) instead of building src/librats" OFF)
 
 # ── librats (P2P transport, discovery, crypto, fs) ───────────────────────────
-# Pulled in as a subproject; we don't want its own tests/tools built for us.
-set(RATS_BUILD_TESTS    OFF CACHE BOOL "" FORCE)
-set(RATS_BUILD_CLIENT   OFF CACHE BOOL "" FORCE)
-set(RATS_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
-add_subdirectory(src/librats)
+# Everything below links `rats::rats`, whichever way it was obtained: the
+# installed package exports that name, and the bundled build gets it as an alias.
+if(RASYNC_USE_SYSTEM_LIBRATS)
+    # The default is the release the submodule pins — the one rasync is tested
+    # against; ratsConfigVersion accepts anything newer within the same major.
+    # A librats built from a tarball without -DRATS_VERSION_OVERRIDE reports
+    # itself as 1.0.0, so set this empty to accept whatever is installed.
+    set(RASYNC_LIBRATS_MIN_VERSION 2.3.3 CACHE STRING
+        "Oldest installed librats accepted with RASYNC_USE_SYSTEM_LIBRATS (empty: any)")
+    find_package(rats ${RASYNC_LIBRATS_MIN_VERSION} CONFIG REQUIRED)
+    message(STATUS "librats: system ${rats_VERSION} (${rats_DIR})")
+else()
+    if(NOT EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/src/librats/CMakeLists.txt)
+        message(FATAL_ERROR
+            "src/librats is empty. Run `git submodule update --init --recursive`, "
+            "or configure with -DRASYNC_USE_SYSTEM_LIBRATS=ON to use an installed librats.")
+    endif()
+    # Pulled in as a subproject; we don't want its own tests/tools built for us.
+    set(RATS_BUILD_TESTS    OFF CACHE BOOL "" FORCE)
+    set(RATS_BUILD_CLIENT   OFF CACHE BOOL "" FORCE)
+    set(RATS_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+    add_subdirectory(src/librats)
+    add_library(rats::rats ALIAS rats)
+    message(STATUS "librats: bundled (src/librats)")
+endif()
 
 # ── rasync_core: pure, network-free sync logic (the unit-tested heart) ───────
 add_library(rasync_core STATIC
@@ -94,7 +116,7 @@ add_library(rasync_core STATIC
 # layer above — and the tests — reach it by the same `#include "version.h"`.
 target_include_directories(rasync_core PUBLIC src/rasync ${PROJECT_BINARY_DIR}/generated)
 # librats gives us SHA-256 + portable filesystem helpers; nothing more.
-target_link_libraries(rasync_core PUBLIC rats)
+target_link_libraries(rasync_core PUBLIC rats::rats)
 
 # ── rasync_net: the sync protocol + session, built on librats' Node ──────────
 if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/src/rasync/net/sync_session.cpp)
@@ -105,7 +127,7 @@ add_library(rasync_net STATIC
     src/rasync/net/sync_service.cpp
     src/rasync/net/sync_router.cpp
 )
-target_link_libraries(rasync_net PUBLIC rasync_core rats)
+target_link_libraries(rasync_net PUBLIC rasync_core rats::rats)
 endif()
 
 # ── rasync_app: CLI, terminal UI, daemon loop ────────────────────────────────
