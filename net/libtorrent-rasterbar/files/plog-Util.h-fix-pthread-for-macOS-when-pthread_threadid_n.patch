From 9c527f0339c7988f8ca23c72b68d37798e00a828 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Tue, 10 Nov 2026 06:54:53 +0800
Subject: [PATCH 1/2] Util.h: fix pthread for macOS when pthread_threadid_np is
 not defined

---
 include/plog/Util.h | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git include/plog/Util.h include/plog/Util.h
index ec319a1..52faeb2 100644
--- deps/libdatachannel/deps/plog/include/plog/Util.h
+++ deps/libdatachannel/deps/plog/include/plog/Util.h
@@ -87,6 +87,10 @@
 #   include <task.h>
 #endif
 
+#ifdef __APPLE__
+#   include <AvailabilityMacros.h>
+#endif
+
 #if PLOG_CHAR_IS_UTF8
 #   define PLOG_NSTR(x)    x
 #else
@@ -190,7 +194,11 @@ namespace plog
             return rtems_task_self();
 #elif defined(__APPLE__)
             uint64_t tid64;
+#if MAC_OS_X_VERSION_MIN_REQUIRED >= 1060 && !defined(__ppc__)
             pthread_threadid_np(NULL, &tid64);
+#else
+            tid64 = pthread_mach_thread_np(pthread_self());
+#endif
             return static_cast<unsigned int>(tid64);
 #else
             return 0;
