--- compat/mkostemp.c
+++ compat/mkostemp.c
@@ -0,0 +1,47 @@
+/*
+ * Public domain
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+/*
+ * Minimal mkostemp(3) replacement for platforms that only provide
+ * mkstemp(3) (e.g. macOS before 10.12). Only O_CLOEXEC is supported,
+ * since that is the only flag rpki-client ever passes.
+ *
+ * FD_CLOEXEC is applied unconditionally rather than gated on the
+ * flags value: on some platforms O_CLOEXEC is itself defined as 0
+ * (no atomic close-on-exec at open(2) time, e.g. legacy macOS via
+ * MacPorts' legacysupport), which makes "O_CLOEXEC requested" and
+ * "no flags" indistinguishable by the time they reach here. Since
+ * every caller in this tree only ever passes O_CLOEXEC, always
+ * applying FD_CLOEXEC - which needs no atomicity and works fine on
+ * those same legacy platforms - gives the intended behaviour either
+ * way instead of silently dropping it when O_CLOEXEC is 0.
+ */
+int
+mkostemp(char *template, int flags)
+{
+	int fd, fl, save_errno;
+
+	if (flags & ~O_CLOEXEC) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	if ((fd = mkstemp(template)) == -1)
+		return -1;
+
+	if ((fl = fcntl(fd, F_GETFD)) == -1 ||
+	    fcntl(fd, F_SETFD, fl | FD_CLOEXEC) == -1) {
+		save_errno = errno;
+		close(fd);
+		unlink(template);
+		errno = save_errno;
+		return -1;
+	}
+
+	return fd;
+}
