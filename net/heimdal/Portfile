# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

# 7.8.1 was prepared on heimdal-7-1-branch but never tagged or released.
github.setup        heimdal heimdal 1b4565a29fc5dbabf0b668aaf812f8cf5cf2ec0f
version             7.8.1
revision            0
categories          net security
license             BSD
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer
homepage            https://www.heimdal.software
description         Heimdal is a Kerberos 5 implementation
long_description    \
    Heimdal is an implementation of Kerberos 5 (and some more stuff) largely \
    written in Sweden (which was important when we started writing it, less so now).

checksums           rmd160  87f950b138eef1f82337abd076f1b0e4151ce245 \
                    sha256  6c576a36121dd43a53e9e0f3fd39ccd58213c50fc25b8fd138ab7221be5b7e99 \
                    size    13195234
github.tarball_from archive

set py_ver          3.14
set py_ver_nodot    [string map {. {}} ${py_ver}]
set perl_ver        5.34

depends_build       port:bison \
                    port:flex \
                    port:gettext \
                    bin:makeinfo:texinfo \
                    port:p${perl_ver}-json \
                    port:perl${perl_ver} \
                    path:bin/pkg-config:pkgconfig \
                    port:python${py_ver_nodot}

depends_lib-append  port:gettext-runtime \
                    port:libcomerr \
                    port:lmdb \
                    port:readline \
                    port:sqlite3

# Server must only accept the realm from kadmin clients.
patchfiles-append   patch-kadmind-params.diff

# https://bugs.freebsd.org/267884
patchfiles-append   patch-recvauth-nul.diff

# Backport of libtommath 7bbc1f8e (heimdal fd2d434dd) to the bundled copy.
patchfiles-append   patch-CVE-2023-36328.diff

configure.perl      ${prefix}/bin/perl${perl_ver}
configure.python    ${prefix}/bin/python${py_ver}

# https://github.com/heimdal/heimdal/issues/1450
post-patch {
    reinplace "s| perl | ${configure.perl} |g" \
        ${worksrcpath}/kcm/Makefile.am ${worksrcpath}/kdc/Makefile.am \
        ${worksrcpath}/lib/asn1/Makefile.am ${worksrcpath}/lib/gssapi/Makefile.am \
        ${worksrcpath}/lib/hdb/Makefile.am ${worksrcpath}/lib/hx509/Makefile.am \
        ${worksrcpath}/lib/kadm5/Makefile.am ${worksrcpath}/lib/krb5/Makefile.am \
        ${worksrcpath}/lib/ntlm/Makefile.am
}

use_autoreconf      yes

# Use a separate prefix to avoid conflicts with the port kerberos5
set hprefix         ${prefix}/libexec/heimdal
configure.pre_args  --prefix=${hprefix}

configure.args      \
    --disable-ndbm-db          \
    --disable-silent-rules     \
    --disable-static           \
    --enable-otp               \
    --enable-pthread-support   \
    --enable-shared            \
    --includedir=${hprefix}/include \
    --libdir=${hprefix}/lib    \
    --sysconfdir=${prefix}/etc \
    --with-hdbdir=${prefix}/var/heimdal \
    --with-libintl=${prefix}   \
    --with-readline=${prefix}  \
    --with-sqlite3=${prefix}   \
    --without-berkeley-db      \
    --without-libedit          \
    --without-openldap         \
    --without-openssl

if {${os.platform} eq "darwin" && ${os.major} < 11} {
    # CCCryptorCreateWithMode is 10.7+: keep CommonDigest, use hcrypto ciphers.
    configure.args-append \
                    ac_cv_header_CommonCrypto_CommonCryptor_h=no
}

if {${os.platform} eq "darwin" && ${os.major} < 10} {
    # No libdispatch before 10.6.
    configure.args-append \
                    ac_cv_prog_GCD_MIG=no
}

build.env-append    LC_CTYPE=C

variant openldap description \
    "Enable LDAP database support for keeping track of Kerberos information" {
    depends_lib-append      path:lib/libldap.dylib:openldap
    configure.args-replace  --without-openldap --with-openldap=${prefix}
}

variant openssl description \
    "Build OpenSSL-backed hcrypto, adding EC support for PKINIT and hx509" {
    depends_lib-append      path:lib/libssl.dylib:openssl
    configure.args-replace  --without-openssl --with-openssl=${prefix}
}

destroot.keepdirs   ${destroot}${prefix}/var/heimdal

test.run            yes
test.target         check

github.livecheck.branch heimdal-7-1-branch
