From 2b5384efdb3e29e90fc29a65f08f12873ce9612b Mon Sep 17 00:00:00 2001
From: got3nks <got3nks@users.noreply.github.com>
Date: Wed, 4 Nov 2026 10:45:18 +0100
Subject: [PATCH] fix(macos): build the Objective-C++ sources with GCC

GCC does not support __bridge, @autoreleasepool, @available, or for...in in Objective-C++.
---
 src/MacAppHelper.mm               | 27 +++++++++++++++------------
 src/ProtocolHandlerManager_mac.mm | 23 ++++++++++++-----------
 2 files changed, 27 insertions(+), 23 deletions(-)

diff --git a/src/MacAppHelper.mm b/src/MacAppHelper.mm
index cbef6b3975..7833675029 100644
--- a/src/MacAppHelper.mm
+++ b/src/MacAppHelper.mm
@@ -35,9 +35,12 @@
 	if (!table) {
 		return;
 	}
+	// GCC does not support @available, so its builds keep the default style.
+#ifdef __clang__
 	if (@available(macOS 11.0, *)) {
 		table.style = NSTableViewStyleFullWidth;
 	}
+#endif
 }
 
 extern "C" double mac_tab_view_buttons_mid_y(void *windowHandle)
@@ -50,8 +53,9 @@
 	[tabView layoutSubtreeIfNeeded];
 
 	// The buttons are a private segmented-control subview; its frame is the only public way to
-	// learn where AppKit placed them.
-	for (NSView *sub in tabView.subviews) {
+	// learn where AppKit placed them. GCC does not support for...in in Objective-C++.
+	NSEnumerator *subviews = [tabView.subviews objectEnumerator];
+	while (NSView *sub = [subviews nextObject]) {
 		if ([sub isKindOfClass:[NSSegmentedControl class]]) {
 			NSView *parent = tabView.superview;
 			NSRect r = [sub convertRect:sub.bounds toView:parent];
@@ -80,14 +84,13 @@ bool mac_reveal_in_finder(const char *path)
 	if (path == nullptr) {
 		return false;
 	}
-	@autoreleasepool {
-		NSString *file = [NSString stringWithUTF8String:path];
-		if (file == nil) {
-			return false;
-		}
-		// selectFile: with an empty root opens the enclosing folder and selects
-		// the file in it, which is the behaviour "Show in Finder" implies.
-		return [[NSWorkspace sharedWorkspace] selectFile:file
-							inFileViewerRootedAtPath:@""] ? true : false;
-	}
+	// GCC does not support @autoreleasepool.
+	NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+	NSString *file = [NSString stringWithUTF8String:path];
+	// selectFile: with an empty root opens the enclosing folder and selects
+	// the file in it, which is the behaviour "Show in Finder" implies.
+	const bool revealed = file != nil && [[NSWorkspace sharedWorkspace] selectFile:file
+							inFileViewerRootedAtPath:@""];
+	[pool drain];
+	return revealed;
 }
diff --git a/src/ProtocolHandlerManager_mac.mm b/src/ProtocolHandlerManager_mac.mm
index 00485d40fb..8ebecf115c 100644
--- a/src/ProtocolHandlerManager_mac.mm
+++ b/src/ProtocolHandlerManager_mac.mm
@@ -92,7 +92,7 @@ wxString MacReadHandler(HandlerTarget target)
 	if (handler == nullptr) {
 		return wxEmptyString;
 	}
-	wxString result = WxStringFromNSString((__bridge NSString *)handler);
+	wxString result = WxStringFromNSString((NSString *)handler);
 	CFRelease(handler);
 	return result;
 }
@@ -184,17 +184,18 @@ - (void)getUrl:(NSAppleEventDescriptor *)event withReplyEvent:(NSAppleEventDescr
 // already registered. NSAppleEventManager is available at library-load in Cocoa apps.
 __attribute__((constructor)) static void amule_install_url_handler_at_load(void)
 {
-	@autoreleasepool {
-		if (g_url_handler != nil) {
-			return;
-		}
-		g_url_handler = [[AmuleURLAppleEventHandler alloc] init];
-		[[NSAppleEventManager sharedAppleEventManager] setEventHandler:g_url_handler
-			andSelector:@selector(getUrl:withReplyEvent:)
-			forEventClass:kInternetEventClass
-			andEventID:kAEGetURL];
-		NSLog(@"[amuleurl] library-load: kAEGetURL handler installed");
+	if (g_url_handler != nil) {
+		return;
 	}
+	// GCC does not support @autoreleasepool.
+	NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+	g_url_handler = [[AmuleURLAppleEventHandler alloc] init];
+	[[NSAppleEventManager sharedAppleEventManager] setEventHandler:g_url_handler
+		andSelector:@selector(getUrl:withReplyEvent:)
+		forEventClass:kInternetEventClass
+		andEventID:kAEGetURL];
+	NSLog(@"[amuleurl] library-load: kAEGetURL handler installed");
+	[pool drain];
 }
 
 #endif // __APPLE__
