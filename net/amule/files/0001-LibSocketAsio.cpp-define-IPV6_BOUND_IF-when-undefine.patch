From 195479472dc40f4cf19afd2b20f14d17ff87cb04 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Wed, 4 Nov 2026 17:20:52 +0800
Subject: [PATCH] LibSocketAsio.cpp: define IPV6_BOUND_IF when undefined on
 macOS

Fixes: https://github.com/amule-org/amule/issues/2350
---
 src/LibSocketAsio.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/LibSocketAsio.cpp b/src/LibSocketAsio.cpp
index 1a989e547..5080e5723 100644
--- a/src/LibSocketAsio.cpp
+++ b/src/LibSocketAsio.cpp
@@ -105,6 +105,10 @@
 #include <cerrno>        // errno / EPERM
 #endif
 
+#if defined(__APPLE__) && !defined(IPV6_BOUND_IF)
+#define IPV6_BOUND_IF 125
+#endif
+
 using namespace boost::asio;
 using namespace boost::system; // for error_code
 // Keep one event loop per worker: posting a TCP write wakes only its owner.
-- 
