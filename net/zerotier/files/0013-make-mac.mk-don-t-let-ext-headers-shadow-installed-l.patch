From 89195bafd315bac220851b5dc7f8be724e75adbd Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:54:02 +0000
Subject: [PATCH 13/13] make-mac.mk: don't let ext/ headers shadow installed
 libraries

ext/ is on the include path via -isystem so that <nlohmann/json.hpp>,
<inja/inja.hpp> and <cpp-httplib/httplib.h> resolve to the bundled
copies. That also makes <miniupnpc/miniupnpc.h> resolve to the bundled
miniupnpc 2.0 headers whenever the installed library's include
directory is itself an -isystem path (as MacPorts arranges when a port
uses its openssl portgroup) or a compiler default (/usr/include,
/usr/local/include): with ZT_USE_SYSTEM_MINIUPNPC=1, PortMapper.cpp
then compiles against API 16 declarations while linking e.g. a 2.3.3
(API 21) library, so the UPNP_GetValidIGD() call silently passes the
wrong arguments. Confirmed with g++ -H: the ext/ header is picked over
the installed one.

Add ZT_PREFER_SYSTEM_HEADERS=1 to search ext/ with -idirafter instead,
i.e. after the compiler's and CPPFLAGS' include paths, so installed
headers win and ext/ is only the fallback, and make it the default when
ZT_USE_SYSTEM_MINIUPNPC=1. Otherwise -isystem ext/ is kept as before.

(Checked that OneService.cpp, the inja user, still compiles with the
bundled inja 3.3 against nlohmann-json 3.12 picked up this way.)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 make-mac.mk | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/make-mac.mk b/make-mac.mk
index edc8f400c..41b0f03d5 100644
--- a/make-mac.mk
+++ b/make-mac.mk
@@ -8,7 +8,7 @@ ifeq ($(origin CXX),default)
 endif
 TOPDIR=$(shell pwd)
 
-INCLUDES=-I$(shell pwd)/rustybits/target -isystem $(TOPDIR)/ext  -I$(TOPDIR)/ext/prometheus-cpp-lite-1.0/core/include -I$(TOPDIR)/ext-prometheus-cpp-lite-1.0/3rdparty/http-client-lite/include -I$(TOPDIR)/ext/prometheus-cpp-lite-1.0/simpleapi/include
+INCLUDES=-I$(shell pwd)/rustybits/target $(ZT_EXT_INCLUDE_FLAG) $(TOPDIR)/ext  -I$(TOPDIR)/ext/prometheus-cpp-lite-1.0/core/include -I$(TOPDIR)/ext-prometheus-cpp-lite-1.0/3rdparty/http-client-lite/include -I$(TOPDIR)/ext/prometheus-cpp-lite-1.0/simpleapi/include
 DEFS=
 LIBS=
 # Extra libraries for the final link (e.g. -latomic for 64-bit atomics on 32-bit PowerPC)
@@ -135,6 +135,7 @@ endif
 override DEFS+=-DMACOSX -DZT_USE_MINIUPNPC -D_DARWIN_C_SOURCE -D_BSD_SOURCE -D_DEFAULT_SOURCE
 ONE_OBJS+=osdep/PortMapper.o
 ifeq ($(ZT_USE_SYSTEM_MINIUPNPC),1)
+	ZT_PREFER_SYSTEM_HEADERS?=1
 	override DEFS+=-DZT_USE_SYSTEM_MINIUPNPC
 	MINIUPNPC_LIBS?=-lminiupnpc
 	LIBS+=$(MINIUPNPC_LIBS)
@@ -151,6 +152,14 @@ else
 	ONE_OBJS+=ext/libnatpmp/natpmp.o ext/libnatpmp/getgateway.o
 endif
 
+# Headers bundled in ext/ (nlohmann-json, inja, cpp-httplib, miniupnpc) are found via
+# -isystem, i.e. ahead of installed copies. ZT_PREFER_SYSTEM_HEADERS=1 searches ext/
+# after the compiler's and CPPFLAGS' include paths instead (-idirafter), so installed
+# libraries win and ext/ is only a fallback. ZT_USE_SYSTEM_MINIUPNPC=1 implies it,
+# since ext/miniupnpc/ would otherwise shadow the installed <miniupnpc/...> headers.
+ZT_PREFER_SYSTEM_HEADERS?=0
+ZT_EXT_INCLUDE_FLAG=$(if $(filter 1,$(ZT_PREFER_SYSTEM_HEADERS)),-idirafter,-isystem)
+
 # cpp-httplib (local control API) is the header in ext/ by default. Set
 # ZT_USE_SYSTEM_HTTPLIB=1 to use an installed <httplib.h> instead. For the compiled
 # library variant (the default HTTPLIB_LIBS), HTTPLIB_DEFS must carry the CPPHTTPLIB_*
-- 
