From 87dd47b4af61f5451258f11a4e6303e6d24d6072 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:38:25 +0000
Subject: [PATCH 04/13] make-mac.mk: honor toolchain and flags from the
 environment

make-mac.mk hardcoded clang, a universal x86_64+arm64 -arch pair,
-stdlib=libc++, -flto and -mmacosx-version-min=10.13, and derived
CXXFLAGS from CFLAGS with a plain assignment, so a packager (MacPorts,
or anyone building with GCC or for a single architecture) could not
supply their own compiler or flags without patching the file.

- CC/CXX default to clang/clang++ only if not set by the user.
- ARCH_FLAGS, STDLIB_FLAGS (-stdlib=libc++), ZT_LTO (-flto) and
  MACOS_VERSION_MIN (empty leaves the deployment target to the
  compiler/MACOSX_DEPLOYMENT_TARGET) are overridable.
- CFLAGS and CXXFLAGS are taken from the environment or command line
  when given (the old -O3 -fstack-protector-strong remains the default
  otherwise), with the build's own flags appended via override; CPPFLAGS
  and LDFLAGS are passed through, and LDLIBS is appended to the final
  link (e.g. -latomic on 32-bit PowerPC).
- MacEthernetTapAgent is built with the same CFLAGS/LDFLAGS instead of a
  separate hardcoded -O3/-arch/version-min line.

With no variables set, the daemon objects and link are built with the same
commands as before; MacEthernetTapAgent now also gets the common
warning/LTO/PIE flags and defines.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 make-mac.mk | 51 ++++++++++++++++++++++++++++++++++++---------------
 1 file changed, 36 insertions(+), 15 deletions(-)

diff --git a/make-mac.mk b/make-mac.mk
index e63fb7f88..60625cfa2 100644
--- a/make-mac.mk
+++ b/make-mac.mk
@@ -1,11 +1,24 @@
-CC=clang
-CXX=clang++
+# Toolchain: clang by default, but any CC/CXX given in the environment or on
+# the command line wins (e.g. MacPorts GCC on PowerPC).
+ifeq ($(origin CC),default)
+	CC=clang
+endif
+ifeq ($(origin CXX),default)
+	CXX=clang++
+endif
 TOPDIR=$(shell pwd)
 
 INCLUDES=-I$(shell pwd)/rustybits/target -isystem $(TOPDIR)/ext  -I$(TOPDIR)/ext/prometheus-cpp-lite-1.0/core/include -I$(TOPDIR)/ext-prometheus-cpp-lite-1.0/3rdparty/http-client-lite/include -I$(TOPDIR)/ext/prometheus-cpp-lite-1.0/simpleapi/include
 DEFS=
 LIBS=
-ARCH_FLAGS=-arch x86_64 -arch arm64
+# Extra libraries for the final link (e.g. -latomic for 64-bit atomics on 32-bit PowerPC)
+LDLIBS?=
+# Universal x86_64 + arm64 by default; set to e.g. "-arch x86_64" or "-m32" for a single architecture
+ARCH_FLAGS?=-arch x86_64 -arch arm64
+# C++ standard library selection; set empty for compilers without -stdlib (GCC)
+STDLIB_FLAGS?=-stdlib=libc++
+# Link-time optimization for release builds
+ZT_LTO?=1
 
 CODESIGN=echo
 PRODUCTSIGN=echo
@@ -54,20 +67,20 @@ endif
 # Use fast ASM Salsa20/12 for x64 processors
 override DEFS+=-DZT_USE_X64_ASM_SALSA2012
 CORE_OBJS+=ext/x64-salsa2012-asm/salsa2012.o
-CXXFLAGS=$(CFLAGS) -std=c++17 -stdlib=libc++
 
 # Build miniupnpc and nat-pmp as included libraries -- extra defs are required for these sources
 override DEFS+=-DMACOSX -DZT_SSO_SUPPORTED -DZT_USE_MINIUPNPC -DMINIUPNP_STATICLIB -D_DARWIN_C_SOURCE -DMINIUPNPC_SET_SOCKET_TIMEOUT -DMINIUPNPC_GET_SRC_ADDR -D_BSD_SOURCE -D_DEFAULT_SOURCE -DOS_STRING=\"Darwin/15.0.0\" -DMINIUPNPC_VERSION_STRING=\"2.0\" -DUPNP_VERSION_STRING=\"UPnP/1.1\" -DENABLE_STRNATPMPERR
 ONE_OBJS+=ext/libnatpmp/natpmp.o ext/libnatpmp/getgateway.o ext/miniupnpc/connecthostport.o ext/miniupnpc/igd_desc_parse.o ext/miniupnpc/minisoap.o ext/miniupnpc/minissdpc.o ext/miniupnpc/miniupnpc.o ext/miniupnpc/miniwget.o ext/miniupnpc/minixml.o ext/miniupnpc/portlistingparse.o ext/miniupnpc/receivedata.o ext/miniupnpc/upnpcommands.o ext/miniupnpc/upnpdev.o ext/miniupnpc/upnperrors.o ext/miniupnpc/upnpreplyparse.o osdep/PortMapper.o
 ifeq ($(ZT_CONTROLLER),1)
 	MACOS_VERSION_MIN=10.15
-	override CXXFLAGS=$(CFLAGS) -std=c++17 -stdlib=libc++
 	LIBS+=-L/opt/homebrew/lib -L/usr/local/opt/libpqxx/lib -L/usr/local/opt/libpq/lib -L/usr/local/opt/openssl/lib/ -lpqxx -lpq -lssl -lcrypto -lgssapi_krb5 ext/redis-plus-plus-1.1.1/install/macos/lib/libredis++.a ext/hiredis-0.14.1/lib/macos/libhiredis.a rustybits/target/libsmeeclient.a
 	override DEFS+=-DZT_CONTROLLER_USE_LIBPQ -DZT_CONTROLLER_USE_REDIS -DZT_CONTROLLER
 	INCLUDES+=-I/opt/homebrew/include -I/opt/homebrew/opt/libpq/include -I/usr/local/opt/libpq/include -I/usr/local/opt/libpqxx/include -Iext/hiredis-0.14.1/include/ -Iext/redis-plus-plus-1.1.1/install/macos/include/sw/ -Irustybits/target/
 else
-	MACOS_VERSION_MIN=10.13
+	# Set empty to leave the deployment target to the compiler / MACOSX_DEPLOYMENT_TARGET
+	MACOS_VERSION_MIN?=10.13
 endif
+MACOS_VERSION_MIN_FLAGS=$(if $(MACOS_VERSION_MIN),-mmacosx-version-min=$(MACOS_VERSION_MIN))
 
 # Build with address sanitization library for advanced debugging (clang)
 ifeq ($(ZT_SANITIZE),1)
@@ -77,23 +90,31 @@ ifeq ($(ZT_DEBUG_TRACE),1)
 	override DEFS+=-DZT_DEBUG_TRACE
 endif
 # Debug mode -- dump trace output, build binary with -g
+# CFLAGS/CXXFLAGS/CPPFLAGS/LDFLAGS from the environment or command line are
+# honored; ZT_OPT_FLAGS is only the default for CFLAGS/CXXFLAGS when unset, and
+# the flags the build needs (ZT_FLAGS) are always appended.
 ifeq ($(ZT_DEBUG),1)
 	ZT_TRACE=1
 	ARCH_FLAGS=
-	CFLAGS+=-Wall -g $(INCLUDES) $(DEFS) $(ARCH_FLAGS)
+	ZT_OPT_FLAGS=
+	ZT_FLAGS=-Wall -g $(INCLUDES) $(DEFS) $(ARCH_FLAGS)
 	STRIP=echo
 	EXTRA_CARGO_FLAGS=
 	RUST_VARIANT=debug
 	# The following line enables optimization for the crypto code, since
 	# C25519 in particular is almost UNUSABLE in heavy testing without it.
-node/Salsa20.o node/SHA512.o node/C25519.o node/Poly1305.o: CFLAGS = -Wall -O2 -g $(INCLUDES) $(DEFS)
+node/Salsa20.o node/SHA512.o node/C25519.o node/Poly1305.o: override CXXFLAGS += -O2
 else
-	CFLAGS?=-O3 -fstack-protector-strong
-	CFLAGS+=$(ARCH_FLAGS) -Wall -flto -fPIE -mmacosx-version-min=$(MACOS_VERSION_MIN) -DNDEBUG -Wno-unused-private-field $(INCLUDES) $(DEFS)
+	ZT_OPT_FLAGS=-O3 -fstack-protector-strong
+	ZT_FLAGS=$(ARCH_FLAGS) -Wall $(if $(filter 1,$(ZT_LTO)),-flto) -fPIE $(MACOS_VERSION_MIN_FLAGS) -DNDEBUG -Wno-unused-private-field $(INCLUDES) $(DEFS)
 	STRIP=strip
 	EXTRA_CARGO_FLAGS=--release
 	RUST_VARIANT=release
 endif
+CFLAGS?=$(ZT_OPT_FLAGS)
+CXXFLAGS?=$(ZT_OPT_FLAGS)
+override CFLAGS+=$(ZT_FLAGS)
+override CXXFLAGS+=$(ZT_FLAGS) -std=c++17 $(STDLIB_FLAGS)
 
 ifeq ($(ZT_TRACE),1)
 	override DEFS+=-DZT_TRACE
@@ -122,21 +143,21 @@ endif
 all: one
 
 ext/x64-salsa2012-asm/salsa2012.o:
-	as -arch x86_64 -mmacosx-version-min=$(MACOS_VERSION_MIN) -o ext/x64-salsa2012-asm/salsa2012.o ext/x64-salsa2012-asm/salsa2012.s
+	as -arch x86_64 $(MACOS_VERSION_MIN_FLAGS) -o ext/x64-salsa2012-asm/salsa2012.o ext/x64-salsa2012-asm/salsa2012.s
 
 mac-agent: FORCE
-	$(CC) -O3 $(ARCH_FLAGS) -mmacosx-version-min=$(MACOS_VERSION_MIN) -o MacEthernetTapAgent osdep/MacEthernetTapAgent.c
+	$(CC) $(CFLAGS) $(CPPFLAGS) $(LDFLAGS) -o MacEthernetTapAgent osdep/MacEthernetTapAgent.c
 	$(CODESIGN) -f --options=runtime -s $(CODESIGN_APP_CERT) MacEthernetTapAgent
 
 osdep/MacDNSHelper.o: osdep/MacDNSHelper.mm
-	$(CXX) $(CXXFLAGS) -c osdep/MacDNSHelper.mm -o osdep/MacDNSHelper.o
+	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -c osdep/MacDNSHelper.mm -o osdep/MacDNSHelper.o
 
 ifeq ($(ZT_CONTROLLER),1)
 one:	otel zeroidc smeeclient $(CORE_OBJS) $(ONE_OBJS) one.o mac-agent
 else
 one:	otel zeroidc $(CORE_OBJS) $(ONE_OBJS) one.o mac-agent
 endif
-	$(CXX) $(CXXFLAGS) -o zerotier-one $(CORE_OBJS) $(ONE_OBJS) one.o $(LIBS) rustybits/target/libzeroidc.a
+	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o zerotier-one $(CORE_OBJS) $(ONE_OBJS) one.o $(LIBS) rustybits/target/libzeroidc.a $(LDLIBS)
 	# $(STRIP) zerotier-one
 	ln -sf zerotier-one zerotier-idtool
 	ln -sf zerotier-one zerotier-cli
@@ -176,7 +197,7 @@ libzerotiercore.a:	$(CORE_OBJS)
 core: libzerotiercore.a
 
 selftest: $(CORE_OBJS) $(ONE_OBJS) selftest.o
-	$(CXX) $(CXXFLAGS) -o zerotier-selftest selftest.o $(CORE_OBJS) $(ONE_OBJS) $(LIBS) rustybits/target/libzeroidc.a
+	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o zerotier-selftest selftest.o $(CORE_OBJS) $(ONE_OBJS) $(LIBS) rustybits/target/libzeroidc.a $(LDLIBS)
 	$(STRIP) zerotier-selftest
 
 zerotier-selftest: selftest
-- 
