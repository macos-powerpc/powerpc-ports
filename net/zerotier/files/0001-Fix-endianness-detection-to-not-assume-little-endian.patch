From a343f9d1e380ce1c00b7531f79043f0611e986b3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 30 Jul 2026 05:42:26 +0000
Subject: [PATCH 01/13] Fix endianness detection to not assume little-endian on
 Apple

node/Constants.hpp force-defined __BYTE_ORDER as little-endian for any
__APPLE__ (or __WINDOWS__) target that didn't already have it defined.
On modern x86_64/arm64 Macs <machine/endian.h> defines it first so this
never fired, but it's a silent-wrong-answer trap for a big-endian
PowerPC macOS target where the byte order actually differs.

Derive it instead from __BYTE_ORDER__/__ORDER_BIG_ENDIAN__/
__ORDER_LITTLE_ENDIAN__, which GCC and Clang predefine on every target
they support regardless of which platform header got included. Keep
the old hardcoded values as a last-resort fallback for a toolchain
with neither.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Uyf9W4DHSECakoviiAFU3M
---
 node/Constants.hpp | 21 ++++++++++++++++-----
 1 file changed, 16 insertions(+), 5 deletions(-)

diff --git a/node/Constants.hpp b/node/Constants.hpp
index 6baf8c7fe..b150370e7 100644
--- a/node/Constants.hpp
+++ b/node/Constants.hpp
@@ -152,15 +152,26 @@
 #endif
 #endif
 
-// Assume little endian if not defined
-#if (defined(__APPLE__) || defined(__WINDOWS__)) && (! defined(__BYTE_ORDER))
-#undef __BYTE_ORDER
-#undef __LITTLE_ENDIAN
-#undef __BIG_ENDIAN
+// If the platform hasn't already told us the byte order (e.g. via
+// <endian.h> or <machine/endian.h> above), derive it from the compiler's
+// own byte-order builtins. __BYTE_ORDER__/__ORDER_BIG_ENDIAN__/
+// __ORDER_LITTLE_ENDIAN__ are predefined by GCC and Clang on every target
+// they support, independent of which platform headers got included --
+// unlike a hardcoded little-endian assumption, this gives the correct
+// answer on big-endian targets (e.g. PowerPC).
+#if ! defined(__BYTE_ORDER)
+#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && defined(__ORDER_LITTLE_ENDIAN__)
+#define __BIG_ENDIAN	__ORDER_BIG_ENDIAN__
+#define __LITTLE_ENDIAN __ORDER_LITTLE_ENDIAN__
+#define __BYTE_ORDER	__BYTE_ORDER__
+#else
+// Last-resort fallback for a toolchain with neither the platform headers
+// nor the compiler builtins above.
 #define __BIG_ENDIAN	4321
 #define __LITTLE_ENDIAN 1234
 #define __BYTE_ORDER	1234
 #endif
+#endif
 
 #ifdef __WINDOWS__
 #define ZT_PATH_SEPARATOR	'\\'
