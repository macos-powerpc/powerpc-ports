From 42bea4d6db16262fa8d56b0ec91a2322cd0ce3d2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:46:14 +0000
Subject: [PATCH 11/13] Allow MacEthernetTapAgent to live outside the ZeroTier
 home

On macOS 10.13+ MacEthernetTap runs the MacEthernetTapAgent helper,
which it only looks for in the ZeroTier home directory
(/Library/Application Support/ZeroTier/One), where the official
installer puts it. Packaged installs (e.g. MacPorts) keep binaries under
their own prefix and do not install into the home directory, which the
daemon creates and manages at runtime.

Add ZT_MAC_TAP_AGENT_PATH (absolute path, with a make-mac.mk option) to
look for the agent there first, falling back to the home directory. The
packaged copy is preferred so that an agent left behind in the home
directory by a different install can't be paired with this daemon.
Without the define nothing changes.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 make-mac.mk              |  7 +++++++
 osdep/MacEthernetTap.cpp | 13 +++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/make-mac.mk b/make-mac.mk
index 18823a6c8..d414ca405 100644
--- a/make-mac.mk
+++ b/make-mac.mk
@@ -180,6 +180,13 @@ endif
 ifneq ($(ZT_MAC_KEXT_TAP_PATH),)
 	override DEFS+=-DZT_MAC_KEXT_TAP_PATH=\"$(ZT_MAC_KEXT_TAP_PATH)\"
 endif
+
+# Tap driver helper for macOS 10.13+ (feth). zerotier-one runs it from the home
+# directory by default; set ZT_MAC_TAP_AGENT_PATH (absolute) to where a package
+# installs it instead.
+ifneq ($(ZT_MAC_TAP_AGENT_PATH),)
+	override DEFS+=-DZT_MAC_TAP_AGENT_PATH=\"$(ZT_MAC_TAP_AGENT_PATH)\"
+endif
 ifeq ($(ZT_CONTROLLER),1)
 	MACOS_VERSION_MIN=10.15
 	LIBS+=-L/opt/homebrew/lib -L/usr/local/opt/libpqxx/lib -L/usr/local/opt/libpq/lib -L/usr/local/opt/openssl/lib/ -lpqxx -lpq -lssl -lcrypto -lgssapi_krb5 ext/redis-plus-plus-1.1.1/install/macos/lib/libredis++.a ext/hiredis-0.14.1/lib/macos/libhiredis.a rustybits/target/libsmeeclient.a
diff --git a/osdep/MacEthernetTap.cpp b/osdep/MacEthernetTap.cpp
index 772e61e68..8cea9f5f1 100644
--- a/osdep/MacEthernetTap.cpp
+++ b/osdep/MacEthernetTap.cpp
@@ -89,11 +89,24 @@ MacEthernetTap::MacEthernetTap(
 	OSUtils::ztsnprintf(mtustr, sizeof(mtustr), "%u", mtu);
 	OSUtils::ztsnprintf(metricstr, sizeof(metricstr), "%u", metric);
 
+#ifdef ZT_MAC_TAP_AGENT_PATH
+	// Packaged installs can keep the agent with the other binaries (absolute path) instead
+	// of in the ZeroTier home; that copy is preferred so the two always match.
+	std::string agentPath(ZT_MAC_TAP_AGENT_PATH);
+	if (! OSUtils::fileExists(agentPath.c_str())) {
+		agentPath = homePath;
+		agentPath.push_back(ZT_PATH_SEPARATOR);
+		agentPath.append("MacEthernetTapAgent");
+	}
+	if (! OSUtils::fileExists(agentPath.c_str()))
+		throw std::runtime_error("MacEthernetTapAgent not present in " ZT_MAC_TAP_AGENT_PATH " or ZeroTier home");
+#else
 	std::string agentPath(homePath);
 	agentPath.push_back(ZT_PATH_SEPARATOR);
 	agentPath.append("MacEthernetTapAgent");
 	if (! OSUtils::fileExists(agentPath.c_str()))
 		throw std::runtime_error("MacEthernetTapAgent not present in ZeroTier home");
+#endif
 
 	Mutex::Lock _gl(globalTapCreateLock);	// only make one at a time
 
