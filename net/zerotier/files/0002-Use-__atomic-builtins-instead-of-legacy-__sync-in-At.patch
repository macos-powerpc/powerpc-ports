From 4a26561fa2a0b6cbb7ae0038c684902cee31bdc9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 30 Jul 2026 06:19:05 +0000
Subject: [PATCH 02/13] Use __atomic builtins instead of legacy __sync in
 AtomicCounter

node/AtomicCounter.hpp used GCC's old __sync_* builtins (lock-based,
implied full barrier, predating C++11's memory model). Switch to the
__atomic_* family at __ATOMIC_SEQ_CST, which is sequentially
consistent -- behaviorally equivalent to what __sync always provided --
but is the properly specified, better-supported builtin family across
architectures including PowerPC, where __sync's codegen has
historically been less reliable than __atomic's.

AtomicCounter backs SharedPtr's reference count, so correctness here
matters: verified load()/operator++()/operator--() against expected
values after the change.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Uyf9W4DHSECakoviiAFU3M
---
 node/AtomicCounter.hpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/node/AtomicCounter.hpp b/node/AtomicCounter.hpp
index b70b3dd98..3f3c2e346 100644
--- a/node/AtomicCounter.hpp
+++ b/node/AtomicCounter.hpp
@@ -28,7 +28,7 @@ class AtomicCounter {
 	inline int load() const
 	{
 #ifdef __GNUC__
-		return __sync_or_and_fetch(const_cast<int*>(&_v), 0);
+		return __atomic_load_n(const_cast<const int*>(&_v), __ATOMIC_SEQ_CST);
 #else
 		return _v.load();
 #endif
@@ -37,7 +37,7 @@ class AtomicCounter {
 	inline int operator++()
 	{
 #ifdef __GNUC__
-		return __sync_add_and_fetch(&_v, 1);
+		return __atomic_add_fetch(&_v, 1, __ATOMIC_SEQ_CST);
 #else
 		return ++_v;
 #endif
@@ -46,7 +46,7 @@ class AtomicCounter {
 	inline int operator--()
 	{
 #ifdef __GNUC__
-		return __sync_sub_and_fetch(&_v, 1);
+		return __atomic_sub_fetch(&_v, 1, __ATOMIC_SEQ_CST);
 #else
 		return --_v;
 #endif
-- 
