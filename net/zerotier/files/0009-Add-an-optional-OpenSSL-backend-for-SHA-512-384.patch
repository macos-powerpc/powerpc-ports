From b476cef59dcdf70c98757f6cc186b96b3eba6153 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:44:19 +0000
Subject: [PATCH 09/13] Add an optional OpenSSL backend for SHA-512/384

SHA512.hpp uses CommonCrypto on Apple and the portable implementation in
SHA512.cpp everywhere else. Add ZT_USE_OPENSSL_SHA512 to use OpenSSL's
EVP digests instead, on any platform, plus a make-mac.mk option that
defines it and links -lcrypto (OPENSSL_LIBS).

CommonCrypto remains the default on Apple -- its CC_SHA512/CC_SHA384
functions have been in libSystem since Mac OS X 10.4, so they are
available on every macOS this builds for, including PowerPC 10.5/10.6.
This is for packagers who would rather use an OpenSSL they already ship
and keep up to date.

Checked by building a standalone test against system OpenSSL: the
NIST SHA-512("abc") and SHA-384("abc") vectors match, and SHA512,
two-part SHA384, HMACSHA384 and KBKDFHMACSHA384 produce identical output
to the portable implementation over a range of input lengths.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 make-mac.mk     |  8 ++++++++
 node/SHA512.hpp | 28 ++++++++++++++++++++++++++--
 2 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/make-mac.mk b/make-mac.mk
index c17a115b5..f1bfb9204 100644
--- a/make-mac.mk
+++ b/make-mac.mk
@@ -161,6 +161,14 @@ ifeq ($(ZT_USE_SYSTEM_HTTPLIB),1)
 	HTTPLIB_LIBS?=-lcpp-httplib
 	LIBS+=$(HTTPLIB_LIBS)
 endif
+
+# SHA-512/384 come from CommonCrypto by default; set ZT_USE_OPENSSL_SHA512=1 to use
+# OpenSSL's libcrypto instead (found via CPPFLAGS/LDFLAGS, or override OPENSSL_LIBS).
+ifeq ($(ZT_USE_OPENSSL_SHA512),1)
+	override DEFS+=-DZT_USE_OPENSSL_SHA512
+	OPENSSL_LIBS?=-lcrypto
+	LIBS+=$(OPENSSL_LIBS)
+endif
 ifeq ($(ZT_CONTROLLER),1)
 	MACOS_VERSION_MIN=10.15
 	LIBS+=-L/opt/homebrew/lib -L/usr/local/opt/libpqxx/lib -L/usr/local/opt/libpq/lib -L/usr/local/opt/openssl/lib/ -lpqxx -lpq -lssl -lcrypto -lgssapi_krb5 ext/redis-plus-plus-1.1.1/install/macos/lib/libredis++.a ext/hiredis-0.14.1/lib/macos/libhiredis.a rustybits/target/libsmeeclient.a
diff --git a/node/SHA512.hpp b/node/SHA512.hpp
index abd525ec5..4af71a86d 100644
--- a/node/SHA512.hpp
+++ b/node/SHA512.hpp
@@ -11,7 +11,12 @@
 
 #include "Constants.hpp"
 
-#ifdef __APPLE__
+// Build with -DZT_USE_OPENSSL_SHA512 (and link libcrypto) to use OpenSSL's EVP
+// SHA-512/384 on any platform, in place of CommonCrypto on Apple or the portable
+// implementation in SHA512.cpp elsewhere.
+#if defined(ZT_USE_OPENSSL_SHA512)
+#include <openssl/evp.h>
+#elif defined(__APPLE__)
 #include <CommonCrypto/CommonDigest.h>
 #endif
 
@@ -24,8 +29,27 @@
 
 namespace ZeroTier {
 
+#if defined(ZT_USE_OPENSSL_SHA512)
+#define ZT_HAVE_NATIVE_SHA512 1
+static ZT_INLINE void SHA512(void* digest, const void* data, unsigned int len)
+{
+	EVP_Digest(data, len, reinterpret_cast<unsigned char*>(digest), nullptr, EVP_sha512(), nullptr);
+}
+static ZT_INLINE void SHA384(void* digest, const void* data, unsigned int len)
+{
+	EVP_Digest(data, len, reinterpret_cast<unsigned char*>(digest), nullptr, EVP_sha384(), nullptr);
+}
+static ZT_INLINE void SHA384(void* digest, const void* data0, unsigned int len0, const void* data1, unsigned int len1)
+{
+	EVP_MD_CTX* ctx = EVP_MD_CTX_new();
+	EVP_DigestInit_ex(ctx, EVP_sha384(), nullptr);
+	EVP_DigestUpdate(ctx, data0, len0);
+	EVP_DigestUpdate(ctx, data1, len1);
+	EVP_DigestFinal_ex(ctx, reinterpret_cast<unsigned char*>(digest), nullptr);
+	EVP_MD_CTX_free(ctx);
+}
 // SHA384 and SHA512 are actually in the standard libraries on MacOS and iOS
-#ifdef __APPLE__
+#elif defined(__APPLE__)
 #define ZT_HAVE_NATIVE_SHA512 1
 static ZT_INLINE void SHA512(void* digest, const void* data, unsigned int len)
 {
