From fa8d54cf49cba18eee1fb0844013f8c1ef7fe7e2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:42:42 +0000
Subject: [PATCH 08/13] Allow building against a system cpp-httplib

OneService included the bundled ext/cpp-httplib/httplib.h (0.15.3)
unconditionally. Add ZT_USE_SYSTEM_HTTPLIB to include an installed
<httplib.h> instead -- the same switch the CMake build on dev makes
under CMAKE_BUILD -- and a matching make-mac.mk option.

The bundled copy's one local change (routing() made public) is only
used by the ZT_EXTOSDEP management socket on Linux, so macOS builds do
not depend on it. OneService.cpp compiles unchanged against cpp-httplib
0.58.0, with and without CPPHTTPLIB_OPENSSL_SUPPORT/ZLIB_SUPPORT.

Distributions typically ship cpp-httplib as the compiled library
variant, whose header only matches the library when the consumer
defines the same CPPHTTPLIB_* feature macros it was built with (they
change struct layouts, e.g. Request gains an SSL pointer). Those are
only exported through its CMake package, so make-mac.mk takes them in
HTTPLIB_DEFS; HTTPLIB_LIBS defaults to -lcpp-httplib.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 make-mac.mk            | 11 +++++++++++
 service/OneService.cpp |  4 ++++
 2 files changed, 15 insertions(+)

diff --git a/make-mac.mk b/make-mac.mk
index 062d03b7d..c17a115b5 100644
--- a/make-mac.mk
+++ b/make-mac.mk
@@ -150,6 +150,17 @@ else
 	override DEFS+=-DENABLE_STRNATPMPERR
 	ONE_OBJS+=ext/libnatpmp/natpmp.o ext/libnatpmp/getgateway.o
 endif
+
+# cpp-httplib (local control API) is the header in ext/ by default. Set
+# ZT_USE_SYSTEM_HTTPLIB=1 to use an installed <httplib.h> instead. For the compiled
+# library variant (the default HTTPLIB_LIBS), HTTPLIB_DEFS must carry the CPPHTTPLIB_*
+# feature macros it was built with -- its CMake package exports them -- so the
+# header's declarations match the library.
+ifeq ($(ZT_USE_SYSTEM_HTTPLIB),1)
+	override DEFS+=-DZT_USE_SYSTEM_HTTPLIB $(HTTPLIB_DEFS)
+	HTTPLIB_LIBS?=-lcpp-httplib
+	LIBS+=$(HTTPLIB_LIBS)
+endif
 ifeq ($(ZT_CONTROLLER),1)
 	MACOS_VERSION_MIN=10.15
 	LIBS+=-L/opt/homebrew/lib -L/usr/local/opt/libpqxx/lib -L/usr/local/opt/libpq/lib -L/usr/local/opt/openssl/lib/ -lpqxx -lpq -lssl -lcrypto -lgssapi_krb5 ext/redis-plus-plus-1.1.1/install/macos/lib/libredis++.a ext/hiredis-0.14.1/lib/macos/libhiredis.a rustybits/target/libsmeeclient.a
diff --git a/service/OneService.cpp b/service/OneService.cpp
index d5d086058..274f85307 100644
--- a/service/OneService.cpp
+++ b/service/OneService.cpp
@@ -42,7 +42,11 @@
 #include "../version.h"
 #include "OneService.hpp"
 
+#ifdef ZT_USE_SYSTEM_HTTPLIB
+#include <httplib.h>
+#else
 #include <cpp-httplib/httplib.h>
+#endif
 
 #ifdef ZT_OPENTELEMETRY_ENABLED
 #include "opentelemetry/exporters/memory/in_memory_data.h"
-- 
