From 666296f2bbf3d7d51db31a7b7b83e778b8b66a48 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:37:01 +0000
Subject: [PATCH 03/13] Support miniupnpc API 18+ in PortMapper

miniupnpc 2.2.8 (API version 18) added a WAN address out parameter to
UPNP_GetValidIGD(), so building against a current system miniupnpc
(e.g. 2.3.3, API 21) with ZT_USE_SYSTEM_MINIUPNPC fails with "too few
arguments to function". Pass a NULL buffer on API 18+ -- the external
address is already fetched separately with UPNP_GetExternalIPAddress()
right after -- and keep the old call for the bundled miniupnpc 2.0
(API 16).

API 18 also split the return codes (2 now means "connected, but private
WAN address"), but only a non-zero result is tested here, so behavior is
unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 osdep/PortMapper.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/osdep/PortMapper.cpp b/osdep/PortMapper.cpp
index 3585c330a..46122786a 100644
--- a/osdep/PortMapper.cpp
+++ b/osdep/PortMapper.cpp
@@ -222,7 +222,13 @@ class PortMapperImpl {
 					OSUtils::ztsnprintf(inport, sizeof(inport), "%d", localPort);
 
 					int foundValidIGD = 0;
-					if ((foundValidIGD = UPNP_GetValidIGD(devlist, &urls, &data, lanaddr, sizeof(lanaddr))) && (lanaddr[0])) {
+#if defined(MINIUPNPC_API_VERSION) && (MINIUPNPC_API_VERSION >= 18)
+					// API 18 (miniupnpc 2.2.8) added a WAN address out parameter; we query that separately below
+					foundValidIGD = UPNP_GetValidIGD(devlist, &urls, &data, lanaddr, sizeof(lanaddr), (char*)0, 0);
+#else
+					foundValidIGD = UPNP_GetValidIGD(devlist, &urls, &data, lanaddr, sizeof(lanaddr));
+#endif
+					if ((foundValidIGD) && (lanaddr[0])) {
 #ifdef ZT_PORTMAPPER_TRACE
 						PM_TRACE("PortMapper: UPnP: my LAN IP address: %s" ZT_EOL_S, lanaddr);
 #endif
