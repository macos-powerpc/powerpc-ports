From f64cd085be6bd5018bf7303baf6b0e8274a4121a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:46:58 +0000
Subject: [PATCH 12/13] make-mac.mk: add an install target

macOS builds only had the mac-dist-pkg installer target, so packagers
had to hand-copy the binaries. Add a conventional install target, as
make-linux.mk has: zerotier-one in $(SBINDIR) with the zerotier-cli and
zerotier-idtool symlinks, and the man pages under $(MANDIR), all below
$(DESTDIR)$(PREFIX) (default /usr/local). MacEthernetTapAgent is
installed to ZT_MAC_TAP_AGENT_PATH when that is set, since that is
where zerotier-one will then look for it; otherwise it is left to the
installer that puts it in the ZeroTier home, as before.

zerotier-one's state directory (/Library/Application Support/ZeroTier/One)
is created by the daemon itself, so nothing is installed there.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 make-mac.mk | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/make-mac.mk b/make-mac.mk
index d414ca405..edc8f400c 100644
--- a/make-mac.mk
+++ b/make-mac.mk
@@ -372,6 +372,26 @@ docker-release:	_buildx
 clean:
 	rm -rf MacEthernetTapAgent *.dSYM build-* *.a *.pkg *.dmg *.o node/*.o nonfree/controller/*.o service/*.o osdep/*.o ext/http-parser/*.o $(CORE_OBJS) $(ONE_OBJS) zerotier-one zerotier-idtool zerotier-selftest zerotier-cli zerotier doc/node_modules zt1_update_$(ZT_BUILD_PLATFORM)_$(ZT_BUILD_ARCHITECTURE)_* rustybits/target/ ext/opentelemetry-cpp-${OTEL_VERSION}/localinstall ext/opentelemetry-cpp-${OTEL_VERSION}/build
 
+# Plain Unix-style install for packagers (the official installer is mac-dist-pkg).
+# zerotier-one keeps its state in /Library/Application Support/ZeroTier/One, which it
+# creates itself. MacEthernetTapAgent is only installed if ZT_MAC_TAP_AGENT_PATH says
+# where zerotier-one will look for it.
+PREFIX?=/usr/local
+SBINDIR?=$(PREFIX)/sbin
+MANDIR?=$(PREFIX)/share/man
+
+install: FORCE
+	install -d $(DESTDIR)$(SBINDIR) $(DESTDIR)$(MANDIR)/man1 $(DESTDIR)$(MANDIR)/man8
+	install -m 755 zerotier-one $(DESTDIR)$(SBINDIR)/zerotier-one
+	ln -sf zerotier-one $(DESTDIR)$(SBINDIR)/zerotier-cli
+	ln -sf zerotier-one $(DESTDIR)$(SBINDIR)/zerotier-idtool
+	install -m 644 doc/zerotier-one.8 $(DESTDIR)$(MANDIR)/man8/zerotier-one.8
+	install -m 644 doc/zerotier-cli.1 doc/zerotier-idtool.1 $(DESTDIR)$(MANDIR)/man1/
+ifneq ($(ZT_MAC_TAP_AGENT_PATH),)
+	install -d $(DESTDIR)$(dir $(ZT_MAC_TAP_AGENT_PATH))
+	install -m 755 MacEthernetTapAgent $(DESTDIR)$(ZT_MAC_TAP_AGENT_PATH)
+endif
+
 ifeq (${ZT_OTEL},1)
 otel:
 	cd ext/opentelemetry-cpp-1.21.0 && mkdir -p localinstall && cmake -B build -S . -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$(shell pwd)/ext/opentelemetry-cpp-1.21.0/localinstall -DCMAKE_OSX_ARCHITECTURES="arm64;x86_64" -DCMAKE_OSX_DEPLOYMENT_TARGET=${MACOS_VERSION_MIN} -DBUILD_TESTING=OFF -DOPENTELEMETRY_INSTALL=ON -DWITH_BENCHMARK=OFF -DWITH_EXAMPLES=OFF -DWITH_FUNC_TESTS=OFF
