From 133e70281fa3915f555e115752e0c035f006b9dd Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:39:33 +0000
Subject: [PATCH 05/13] make-mac.mk: detect the target architecture

The x86_64 Salsa20/12 assembly was always assembled and linked, and
ZT_BUILD_ARCHITECTURE was hardcoded to 2 (x64), regardless of what was
being built. That only worked because the only supported build was a
universal x86_64+arm64 binary.

Probe the compiler's predefined macros (with the user's CFLAGS and
ARCH_FLAGS) for a single-architecture build and derive both from the
result: x86_64 -> 2 and the asm, arm64 -> 4, ppc -> 7 (POWER32),
ppc64 -> 8 (POWER64), i386 -> 1. A universal build (several -arch
flags, which -E rejects) keeps the historical behaviour: architecture
code 2, and the asm whenever ARCH_FLAGS includes x86_64.
ZT_TARGET_ARCH and ZT_USE_X64_ASM_SALSA can be set to override the
probe.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 make-mac.mk | 42 +++++++++++++++++++++++++++++++++++++++---
 1 file changed, 39 insertions(+), 3 deletions(-)

diff --git a/make-mac.mk b/make-mac.mk
index 60625cfa2..267197b04 100644
--- a/make-mac.mk
+++ b/make-mac.mk
@@ -29,7 +29,41 @@ NOTARIZE_APPLE_ID=null
 NOTARIZE_TEAM_ID=null
 
 ZT_BUILD_PLATFORM=3
-ZT_BUILD_ARCHITECTURE=2
+
+# Target architecture, from the compiler's predefined macros. A universal build
+# (several -arch flags) can't be probed this way and keeps the historical x86_64
+# settings. Set ZT_TARGET_ARCH to skip the probe.
+ifeq ($(ZT_TARGET_ARCH),)
+ifeq ($(filter-out 0 1,$(words $(filter -arch,$(CFLAGS) $(ARCH_FLAGS)))),)
+	ZT_TARGET_MACROS:=$(shell $(CC) $(CFLAGS) $(ARCH_FLAGS) -dM -E -x c /dev/null 2>/dev/null | grep -E -o '__(x86_64|arm64|ppc64|ppc|i386)__')
+endif
+ifneq ($(filter __x86_64__,$(ZT_TARGET_MACROS)),)
+	ZT_TARGET_ARCH=x86_64
+else ifneq ($(filter __arm64__,$(ZT_TARGET_MACROS)),)
+	ZT_TARGET_ARCH=arm64
+else ifneq ($(filter __ppc64__,$(ZT_TARGET_MACROS)),)
+	ZT_TARGET_ARCH=ppc64
+else ifneq ($(filter __ppc__,$(ZT_TARGET_MACROS)),)
+	ZT_TARGET_ARCH=ppc
+else ifneq ($(filter __i386__,$(ZT_TARGET_MACROS)),)
+	ZT_TARGET_ARCH=i386
+endif
+endif
+ifeq ($(ZT_TARGET_ARCH),x86_64)
+	ZT_BUILD_ARCHITECTURE=2
+	ZT_USE_X64_ASM_SALSA?=1
+else ifeq ($(ZT_TARGET_ARCH),arm64)
+	ZT_BUILD_ARCHITECTURE=4
+else ifeq ($(ZT_TARGET_ARCH),ppc64)
+	ZT_BUILD_ARCHITECTURE=8
+else ifeq ($(ZT_TARGET_ARCH),ppc)
+	ZT_BUILD_ARCHITECTURE=7
+else ifeq ($(ZT_TARGET_ARCH),i386)
+	ZT_BUILD_ARCHITECTURE=1
+else
+	ZT_BUILD_ARCHITECTURE=2
+	ZT_USE_X64_ASM_SALSA?=$(if $(findstring x86_64,$(ARCH_FLAGS)),1,0)
+endif
 ZT_VERSION_MAJOR=$(shell cat version.h | grep -F VERSION_MAJOR | cut -d ' ' -f 3)
 ZT_VERSION_MINOR=$(shell cat version.h | grep -F VERSION_MINOR | cut -d ' ' -f 3)
 ZT_VERSION_REV=$(shell cat version.h | grep -F VERSION_REVISION | cut -d ' ' -f 3)
@@ -65,8 +99,10 @@ ifeq ($(ZT_OFFICIAL_RELEASE),1)
 endif
 
 # Use fast ASM Salsa20/12 for x64 processors
-override DEFS+=-DZT_USE_X64_ASM_SALSA2012
-CORE_OBJS+=ext/x64-salsa2012-asm/salsa2012.o
+ifeq ($(ZT_USE_X64_ASM_SALSA),1)
+	override DEFS+=-DZT_USE_X64_ASM_SALSA2012
+	CORE_OBJS+=ext/x64-salsa2012-asm/salsa2012.o
+endif
 
 # Build miniupnpc and nat-pmp as included libraries -- extra defs are required for these sources
 override DEFS+=-DMACOSX -DZT_SSO_SUPPORTED -DZT_USE_MINIUPNPC -DMINIUPNP_STATICLIB -D_DARWIN_C_SOURCE -DMINIUPNPC_SET_SOCKET_TIMEOUT -DMINIUPNPC_GET_SRC_ADDR -D_BSD_SOURCE -D_DEFAULT_SOURCE -DOS_STRING=\"Darwin/15.0.0\" -DMINIUPNPC_VERSION_STRING=\"2.0\" -DUPNP_VERSION_STRING=\"UPnP/1.1\" -DENABLE_STRNATPMPERR
-- 
