From b889d4b20698d529fdbb48cb88f1ee30a7e98c33 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:41:29 +0000
Subject: [PATCH 07/13] make-mac.mk: optionally link system miniupnpc and
 libnatpmp

macOS builds always compiled the copies of miniupnpc and libnatpmp
bundled in ext/, while make-linux.mk already links installed libraries
when present and osdep/PortMapper.cpp has had ZT_USE_SYSTEM_MINIUPNPC /
ZT_USE_SYSTEM_NATPMP paths for that all along.

Add ZT_USE_SYSTEM_MINIUPNPC=1 and ZT_USE_SYSTEM_NATPMP=1 to use them on
macOS too (headers and libraries found via CPPFLAGS/LDFLAGS, with
MINIUPNPC_LIBS / NATPMP_LIBS to override the link flags), e.g. for
MacPorts. The miniupnpc- and libnatpmp-specific build defines are now
only passed when the bundled sources are compiled; the general
-DMACOSX/-D_DARWIN_C_SOURCE/-D_BSD_SOURCE/-D_DEFAULT_SOURCE stay global.
The default build is unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 make-mac.mk | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/make-mac.mk b/make-mac.mk
index f04caa4c7..062d03b7d 100644
--- a/make-mac.mk
+++ b/make-mac.mk
@@ -128,9 +128,28 @@ ifeq ($(ZT_USE_X64_ASM_SALSA),1)
 	CORE_OBJS+=ext/x64-salsa2012-asm/salsa2012.o
 endif
 
-# Build miniupnpc and nat-pmp as included libraries -- extra defs are required for these sources
-override DEFS+=-DMACOSX -DZT_USE_MINIUPNPC -DMINIUPNP_STATICLIB -D_DARWIN_C_SOURCE -DMINIUPNPC_SET_SOCKET_TIMEOUT -DMINIUPNPC_GET_SRC_ADDR -D_BSD_SOURCE -D_DEFAULT_SOURCE -DOS_STRING=\"Darwin/15.0.0\" -DMINIUPNPC_VERSION_STRING=\"2.0\" -DUPNP_VERSION_STRING=\"UPnP/1.1\" -DENABLE_STRNATPMPERR
-ONE_OBJS+=ext/libnatpmp/natpmp.o ext/libnatpmp/getgateway.o ext/miniupnpc/connecthostport.o ext/miniupnpc/igd_desc_parse.o ext/miniupnpc/minisoap.o ext/miniupnpc/minissdpc.o ext/miniupnpc/miniupnpc.o ext/miniupnpc/miniwget.o ext/miniupnpc/minixml.o ext/miniupnpc/portlistingparse.o ext/miniupnpc/receivedata.o ext/miniupnpc/upnpcommands.o ext/miniupnpc/upnpdev.o ext/miniupnpc/upnperrors.o ext/miniupnpc/upnpreplyparse.o osdep/PortMapper.o
+# UPnP and NAT-PMP port mapping. miniupnpc and nat-pmp are built in from ext/ by
+# default (extra defs are required for these sources); set ZT_USE_SYSTEM_MINIUPNPC=1
+# and/or ZT_USE_SYSTEM_NATPMP=1 to link installed libraries instead, found via
+# CPPFLAGS/LDFLAGS (MINIUPNPC_LIBS / NATPMP_LIBS override the link flags).
+override DEFS+=-DMACOSX -DZT_USE_MINIUPNPC -D_DARWIN_C_SOURCE -D_BSD_SOURCE -D_DEFAULT_SOURCE
+ONE_OBJS+=osdep/PortMapper.o
+ifeq ($(ZT_USE_SYSTEM_MINIUPNPC),1)
+	override DEFS+=-DZT_USE_SYSTEM_MINIUPNPC
+	MINIUPNPC_LIBS?=-lminiupnpc
+	LIBS+=$(MINIUPNPC_LIBS)
+else
+	override DEFS+=-DMINIUPNP_STATICLIB -DMINIUPNPC_SET_SOCKET_TIMEOUT -DMINIUPNPC_GET_SRC_ADDR -DOS_STRING=\"Darwin/15.0.0\" -DMINIUPNPC_VERSION_STRING=\"2.0\" -DUPNP_VERSION_STRING=\"UPnP/1.1\"
+	ONE_OBJS+=ext/miniupnpc/connecthostport.o ext/miniupnpc/igd_desc_parse.o ext/miniupnpc/minisoap.o ext/miniupnpc/minissdpc.o ext/miniupnpc/miniupnpc.o ext/miniupnpc/miniwget.o ext/miniupnpc/minixml.o ext/miniupnpc/portlistingparse.o ext/miniupnpc/receivedata.o ext/miniupnpc/upnpcommands.o ext/miniupnpc/upnpdev.o ext/miniupnpc/upnperrors.o ext/miniupnpc/upnpreplyparse.o
+endif
+ifeq ($(ZT_USE_SYSTEM_NATPMP),1)
+	override DEFS+=-DZT_USE_SYSTEM_NATPMP
+	NATPMP_LIBS?=-lnatpmp
+	LIBS+=$(NATPMP_LIBS)
+else
+	override DEFS+=-DENABLE_STRNATPMPERR
+	ONE_OBJS+=ext/libnatpmp/natpmp.o ext/libnatpmp/getgateway.o
+endif
 ifeq ($(ZT_CONTROLLER),1)
 	MACOS_VERSION_MIN=10.15
 	LIBS+=-L/opt/homebrew/lib -L/usr/local/opt/libpqxx/lib -L/usr/local/opt/libpq/lib -L/usr/local/opt/openssl/lib/ -lpqxx -lpq -lssl -lcrypto -lgssapi_krb5 ext/redis-plus-plus-1.1.1/install/macos/lib/libredis++.a ext/hiredis-0.14.1/lib/macos/libhiredis.a rustybits/target/libsmeeclient.a
