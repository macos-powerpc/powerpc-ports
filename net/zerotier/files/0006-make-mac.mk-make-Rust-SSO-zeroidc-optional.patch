From 9272d97c6458fa984c06302580504550ea49cb09 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 07:40:45 +0000
Subject: [PATCH 06/13] make-mac.mk: make Rust (SSO/zeroidc) optional

Every macOS build unconditionally defined ZT_SSO_SUPPORTED and ran cargo
for x86_64-apple-darwin and aarch64-apple-darwin, then linked the lipo'd
libzeroidc.a. There is no Rust target for PowerPC (or any other Mac
architecture besides those two), so the daemon could not be built for
them at all, and there was no way to opt out of Rust elsewhere either.

Add ZT_SSO_SUPPORTED, defaulting to 1 only where Rust has a macOS target
(x86_64, arm64, and the universal build) and 0 otherwise -- matching how
make-linux.mk and the CMake build only enable SSO per architecture. When
it is 0, -DZT_SSO_SUPPORTED is not defined (so OneService compiles out
all zeroidc use via ZT_SSO_ENABLED) and nothing from rustybits/ is built
or linked.

When enabled, zeroidc is built for each triple in ZT_RUST_TARGETS
(defaulting to the slice(s) being built) and merged with lipo, or copied
if there is only one; an empty list builds for the host. CARGO selects
the cargo executable. Together these leave room for building it with an
alternative Rust toolchain later (e.g. mrustc on PowerPC).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 make-mac.mk | 43 ++++++++++++++++++++++++++++++++++++-------
 1 file changed, 36 insertions(+), 7 deletions(-)

diff --git a/make-mac.mk b/make-mac.mk
index 267197b04..f04caa4c7 100644
--- a/make-mac.mk
+++ b/make-mac.mk
@@ -64,6 +64,30 @@ else
 	ZT_BUILD_ARCHITECTURE=2
 	ZT_USE_X64_ASM_SALSA?=$(if $(findstring x86_64,$(ARCH_FLAGS)),1,0)
 endif
+
+# SSO/OIDC support is the Rust zeroidc library from rustybits/, built with cargo
+# for each of ZT_RUST_TARGETS and merged with lipo (an empty list builds for the
+# host). It is on by default only where Rust has a macOS target; set
+# ZT_SSO_SUPPORTED=0 to build without Rust, or 1 (plus ZT_RUST_TARGETS / CARGO
+# as needed) to force it.
+CARGO?=cargo
+ifeq ($(ZT_TARGET_ARCH),x86_64)
+	ZT_SSO_SUPPORTED?=1
+	ZT_RUST_TARGETS?=x86_64-apple-darwin
+else ifeq ($(ZT_TARGET_ARCH),arm64)
+	ZT_SSO_SUPPORTED?=1
+	ZT_RUST_TARGETS?=aarch64-apple-darwin
+else ifeq ($(ZT_TARGET_ARCH),)
+	ZT_SSO_SUPPORTED?=1
+	ZT_RUST_TARGETS?=x86_64-apple-darwin aarch64-apple-darwin
+else
+	ZT_SSO_SUPPORTED?=0
+endif
+ifeq ($(ZT_SSO_SUPPORTED),1)
+	override DEFS+=-DZT_SSO_SUPPORTED
+	ZEROIDC_LIB=rustybits/target/libzeroidc.a
+	ZEROIDC_SLICES=$(if $(ZT_RUST_TARGETS),$(foreach t,$(ZT_RUST_TARGETS),target/$(t)/$(RUST_VARIANT)/libzeroidc.a),target/$(RUST_VARIANT)/libzeroidc.a)
+endif
 ZT_VERSION_MAJOR=$(shell cat version.h | grep -F VERSION_MAJOR | cut -d ' ' -f 3)
 ZT_VERSION_MINOR=$(shell cat version.h | grep -F VERSION_MINOR | cut -d ' ' -f 3)
 ZT_VERSION_REV=$(shell cat version.h | grep -F VERSION_REVISION | cut -d ' ' -f 3)
@@ -105,7 +129,7 @@ ifeq ($(ZT_USE_X64_ASM_SALSA),1)
 endif
 
 # Build miniupnpc and nat-pmp as included libraries -- extra defs are required for these sources
-override DEFS+=-DMACOSX -DZT_SSO_SUPPORTED -DZT_USE_MINIUPNPC -DMINIUPNP_STATICLIB -D_DARWIN_C_SOURCE -DMINIUPNPC_SET_SOCKET_TIMEOUT -DMINIUPNPC_GET_SRC_ADDR -D_BSD_SOURCE -D_DEFAULT_SOURCE -DOS_STRING=\"Darwin/15.0.0\" -DMINIUPNPC_VERSION_STRING=\"2.0\" -DUPNP_VERSION_STRING=\"UPnP/1.1\" -DENABLE_STRNATPMPERR
+override DEFS+=-DMACOSX -DZT_USE_MINIUPNPC -DMINIUPNP_STATICLIB -D_DARWIN_C_SOURCE -DMINIUPNPC_SET_SOCKET_TIMEOUT -DMINIUPNPC_GET_SRC_ADDR -D_BSD_SOURCE -D_DEFAULT_SOURCE -DOS_STRING=\"Darwin/15.0.0\" -DMINIUPNPC_VERSION_STRING=\"2.0\" -DUPNP_VERSION_STRING=\"UPnP/1.1\" -DENABLE_STRNATPMPERR
 ONE_OBJS+=ext/libnatpmp/natpmp.o ext/libnatpmp/getgateway.o ext/miniupnpc/connecthostport.o ext/miniupnpc/igd_desc_parse.o ext/miniupnpc/minisoap.o ext/miniupnpc/minissdpc.o ext/miniupnpc/miniupnpc.o ext/miniupnpc/miniwget.o ext/miniupnpc/minixml.o ext/miniupnpc/portlistingparse.o ext/miniupnpc/receivedata.o ext/miniupnpc/upnpcommands.o ext/miniupnpc/upnpdev.o ext/miniupnpc/upnperrors.o ext/miniupnpc/upnpreplyparse.o osdep/PortMapper.o
 ifeq ($(ZT_CONTROLLER),1)
 	MACOS_VERSION_MIN=10.15
@@ -193,7 +217,7 @@ one:	otel zeroidc smeeclient $(CORE_OBJS) $(ONE_OBJS) one.o mac-agent
 else
 one:	otel zeroidc $(CORE_OBJS) $(ONE_OBJS) one.o mac-agent
 endif
-	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o zerotier-one $(CORE_OBJS) $(ONE_OBJS) one.o $(LIBS) rustybits/target/libzeroidc.a $(LDLIBS)
+	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o zerotier-one $(CORE_OBJS) $(ONE_OBJS) one.o $(LIBS) $(ZEROIDC_LIB) $(LDLIBS)
 	# $(STRIP) zerotier-one
 	ln -sf zerotier-one zerotier-idtool
 	ln -sf zerotier-one zerotier-cli
@@ -201,7 +225,7 @@ endif
 
 zerotier-one: one
 
-zeroidc: rustybits/target/libzeroidc.a
+zeroidc: $(ZEROIDC_LIB)
 
 ifeq ($(ZT_CONTROLLER),1)
 smeeclient: rustybits/target/libsmeeclient.a
@@ -212,10 +236,15 @@ rustybits/target/libsmeeclient.a:	FORCE
 	cd rustybits && lipo -create target/x86_64-apple-darwin/$(RUST_VARIANT)/libsmeeclient.a target/aarch64-apple-darwin/$(RUST_VARIANT)/libsmeeclient.a -output target/libsmeeclient.a
 endif
 
+ifeq ($(ZT_SSO_SUPPORTED),1)
 rustybits/target/libzeroidc.a:	FORCE
-	cd rustybits && MACOSX_DEPLOYMENT_TARGET=$(MACOS_VERSION_MIN) cargo build -p zeroidc --target=x86_64-apple-darwin $(EXTRA_CARGO_FLAGS)
-	cd rustybits && MACOSX_DEPLOYMENT_TARGET=$(MACOS_VERSION_MIN) cargo build -p zeroidc --target=aarch64-apple-darwin $(EXTRA_CARGO_FLAGS)
-	cd rustybits && lipo -create target/x86_64-apple-darwin/$(RUST_VARIANT)/libzeroidc.a target/aarch64-apple-darwin/$(RUST_VARIANT)/libzeroidc.a -output target/libzeroidc.a
+ifeq ($(ZT_RUST_TARGETS),)
+	cd rustybits && $(if $(MACOS_VERSION_MIN),MACOSX_DEPLOYMENT_TARGET=$(MACOS_VERSION_MIN)) $(CARGO) build -p zeroidc $(EXTRA_CARGO_FLAGS)
+else
+	for t in $(ZT_RUST_TARGETS); do (cd rustybits && $(if $(MACOS_VERSION_MIN),MACOSX_DEPLOYMENT_TARGET=$(MACOS_VERSION_MIN)) $(CARGO) build -p zeroidc --target=$$t $(EXTRA_CARGO_FLAGS)) || exit 1; done
+endif
+	cd rustybits && $(if $(word 2,$(ZEROIDC_SLICES)),lipo -create $(ZEROIDC_SLICES) -output,cp -f $(ZEROIDC_SLICES)) target/libzeroidc.a
+endif
 
 central-controller:
 	make ARCH_FLAGS="-arch x86_64" ZT_CONTROLLER=1 one
@@ -233,7 +262,7 @@ libzerotiercore.a:	$(CORE_OBJS)
 core: libzerotiercore.a
 
 selftest: $(CORE_OBJS) $(ONE_OBJS) selftest.o
-	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o zerotier-selftest selftest.o $(CORE_OBJS) $(ONE_OBJS) $(LIBS) rustybits/target/libzeroidc.a $(LDLIBS)
+	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o zerotier-selftest selftest.o $(CORE_OBJS) $(ONE_OBJS) $(LIBS) $(ZEROIDC_LIB) $(LDLIBS)
 	$(STRIP) zerotier-selftest
 
 zerotier-selftest: selftest
