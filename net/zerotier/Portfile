# Header-only.
depends_build-append \
                    port:nlohmann-json

depends_lib-append  port:cpp-httplib \
                    port:libnatpmp \
                    port:miniupnpc

# OpenSSL's headers are needed to match a cpp-httplib built with OpenSSL support
# (its default); libcrypto itself is only linked with +openssl.
openssl.depends_type    build

# Without feth (before 10.13) the virtual Ethernet devices come from tuntaposx's
# tap kext, which zerotier-one loads when needed.
if {${os.platform} eq "darwin" && ${os.major} < 17} {
    depends_run-append  port:tuntaposx
}

# Still built from the copies bundled in ext/:
# - prometheus-cpp-lite: ZeroTier's copy carries its own changes (histograms,
#   32-bit counters, restarting its thread when daemonizing); stock 1.0 and 2.0
#   do not build with this release:
#   https://github.com/zerotier/ZeroTierOne/issues/2570
#   https://github.com/zerotier/ZeroTierOne/issues/2571
# - http-parser: bundled on purpose upstream, distribution versions are not
#   API-compatible.
# - inja and the OpenTelemetry C++ API: header-only, not available as ports.

use_configure       no

set agent_path      ${prefix}/libexec/${name}/MacEthernetTapAgent

# make-mac.mk options, for both build and destroot. The Rust part (SSO/OIDC
# login via rustybits/zeroidc) is not built.
set zt_make_args    [list \
                        ZT_TARGET_ARCH=${configure.build_arch} \
                        ZT_SSO_SUPPORTED=0 \
                        ZT_LTO=0 \
                        ZT_USE_SYSTEM_MINIUPNPC=1 \
                        ZT_USE_SYSTEM_NATPMP=1 \
                        ZT_USE_SYSTEM_HTTPLIB=1 \
                        ZT_PREFER_SYSTEM_HEADERS=1 \
                        ZT_MAC_KEXT_TAP_NAME=tap \
                        ZT_MAC_KEXT_TAP_PATH=${prefix}/Library/Extensions/tap.kext \
                        ZT_MAC_TAP_AGENT_PATH=${agent_path} \
                        MACOS_VERSION_MIN=${macosx_deployment_target} \
                        PREFIX=${prefix}]

build.args-append   {*}${zt_make_args}
destroot.args-append \
                    {*}${zt_make_args}

# The CPPHTTPLIB_* feature macros an installed (compiled) cpp-httplib was built
# with, as -D flags: its header only matches the library with the same ones.
# They are only exported through its CMake package, as generator expressions of
# the forms $<$<BOOL:v>:MACRO> and $<$<AND:$<PLATFORM_ID:p>,$<BOOL:v>...>:MACRO>.
proc zerotier_httplib_defs {targets_file} {
    set fd [open ${targets_file} r]
    set data [read ${fd}]
    close ${fd}
    if {![regexp {INTERFACE_COMPILE_DEFINITIONS "([^"]*)"} ${data} -> value]} {
        return ""
    }
    set defs [list]
    foreach item [split [string map {\\$ $} ${value}] \;] {
        if {[regexp {^[A-Za-z_][A-Za-z0-9_]*(=.*)?$} ${item}]} {
            lappend defs -D${item}
        } elseif {[regexp {^\$<\$<(BOOL:[^>]*)>:([A-Za-z0-9_]+)>$} ${item} -> cond macro]
                || [regexp {^\$<\$<AND:(.*)>:([A-Za-z0-9_]+)>$} ${item} -> cond macro]} {
            set on 1
            foreach c [split [string map {$< "" > ""} ${cond}] ,] {
                if {[regexp {^BOOL:(.*)$} ${c} -> v]} {
                    set v [string toupper ${v}]
                    if {${v} in {"" 0 OFF NO N FALSE IGNORE NOTFOUND} || [string match *-NOTFOUND ${v}]} {
                        set on 0
                    }
                } elseif {[regexp {^PLATFORM_ID:(.*)$} ${c} -> p]} {
                    if {${p} ne "Darwin"} {
                        set on 0
                    }
                } else {
                    return -code error "unhandled condition '${c}' in ${targets_file}"
                }
            }
            if {${on}} {
                lappend defs -D${macro}
            }
        } elseif {${item} ne ""} {
            return -code error "unhandled compile definition '${item}' in ${targets_file}"
        }
    }
    return [join ${defs}]
}

configure.cppflags-append \
                    -D__STDC_FORMAT_MACROS

platform darwin {
    configure.cppflags-append \
                    -D__ASSERT_MACROS_DEFINE_VERSIONS_WITHOUT_UNDERSCORES=0
}

pre-build {
    set stdlib_flags ""
    if {[string match *clang* ${configure.cxx}] && ${configure.cxx_stdlib} ne ""} {
        set stdlib_flags -stdlib=${configure.cxx_stdlib}
    }
    build.env-append \
                    CC=${configure.cc} \
                    CXX=${configure.cxx} \
                    "CFLAGS=${configure.cflags}" \
                    "CXXFLAGS=${configure.cxxflags}" \
                    "CPPFLAGS=${configure.cppflags}" \
                    "LDFLAGS=${configure.ldflags}"
    build.args-append \
                    ARCH_FLAGS="[get_canonical_archflags cc]" \
                    STDLIB_FLAGS="${stdlib_flags}" \
                    HTTPLIB_DEFS="[zerotier_httplib_defs ${prefix}/lib/cmake/httplib/httplibTargets.cmake]"
    # 64-bit std::atomic (the bundled prometheus-cpp-lite's histograms) needs
    # libatomic on 32-bit PowerPC.
    if {${configure.build_arch} eq "ppc"} {
        build.args-append \
                    LDLIBS=-latomic
    }
}

post-destroot {
    if {${os.platform} eq "darwin" && ${configure.cxx_stdlib} ne "libc++"} {
        # Only zerotier-one is the real binary, two other are symlinks to it.
        move ${destroot}${prefix}/sbin/${name}-one ${destroot}${prefix}/sbin/${name}-one-orig
        xinstall -m 0755 ${filespath}/${name}-one ${destroot}${prefix}/sbin
    }

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} README.md RELEASE-NOTES.md LICENSE.txt LICENSE-MPL.txt ${docdir}
}

variant openssl description {Use OpenSSL instead of CommonCrypto for SHA-512/384} {
    openssl.depends_type    lib
    build.args-append       ZT_USE_OPENSSL_SHA512=1
}

startupitem.create      yes
startupitem.executable  ${prefix}/sbin/zerotier-one

notes "
To start the ZeroTier One service now and at every boot, run:

    sudo port load ${name}

then join networks with 'sudo zerotier-cli join <network id>'.\
 Its state (node identity, network configurations, authtoken.secret)\
 is kept in /Library/Application Support/ZeroTier/One.
"

if {${os.platform} eq "darwin" && ${os.major} < 17} {
    notes-append "
On this macOS version the virtual network interfaces are tuntaposx tap\
 devices (tap0, tap1, ...), shared with any other software using them.\
 zerotier-one loads ${prefix}/Library/Extensions/tap.kext if needed; to\
 load it at boot instead, run 'sudo port load tuntaposx'.
"
}
