From a57de31bec8455a870fdb8def0c5b9b4686f97ea Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Thu, 17 Sep 2026 02:02:04 +0800
Subject: [PATCH] Val.h: ensure sizeof(ZValElement) remains correct regardless
 of sizeof(bool)

Fixes: https://github.com/zeek/zeek/issues/5897
---
 src/Val.h | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/Val.h b/src/Val.h
index 48e7d899abd..2eab81b2a42 100644
--- src/Val.h
+++ src/Val.h
@@ -1301,8 +1301,9 @@ class ZValElement {
     }
 
 private:
-    bool is_set = false;
-    bool is_managed = false;
+    // Use uint8_t instead of bool, since sizeof(bool) is not guaranteed to be 1.
+    uint8_t is_set = 0;
+    uint8_t is_managed = 0;
     TypeTag tag = TYPE_ERROR;
     // 5 bytes of padding here.
     ZVal zval;
