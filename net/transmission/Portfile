extract.only        ${distname}${extract.suffix}

post-extract {
    set tar [findBinary tar ${portutil::autoconf::tar_command}]
    system -W ${workpath} "${tar} -zxf ${distpath}/dht-${dht_hash}${extract.suffix}"
    system -W ${workpath} "${tar} -zxf ${distpath}/sigslot-${ss_hash}${extract.suffix}"
    system -W ${workpath} "${tar} -zxf ${distpath}/small-${small_hash}${extract.suffix}"
    system -W ${workpath} "${tar} -zxf ${distpath}/libutp-${utp_hash}${extract.suffix}"
    system -W ${workpath} "${tar} -zxf ${distpath}/wide-integer-${wi_hash}${extract.suffix}"
    foreach dep {dht sigslot small libutp wide-integer} {
        delete -f ${worksrcpath}/third-party/${dep}
    }
    move ${workpath}/dht-${dht_hash} ${worksrcpath}/third-party/dht
    move ${workpath}/sigslot-${ss_hash} ${worksrcpath}/third-party/sigslot
    move ${workpath}/small-${small_hash} ${worksrcpath}/third-party/small
    move ${workpath}/libutp-${utp_hash} ${worksrcpath}/third-party/libutp
    move ${workpath}/wide-integer-${wi_hash} ${worksrcpath}/third-party/wide-integer
}

# Do not remove this as it allows transmission and this port to share files
dist_subdir         transmission

