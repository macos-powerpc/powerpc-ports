distfiles-append    dht-${dht_hash}${extract.suffix}:dht
distfiles-append    sigslot-${ss_hash}${extract.suffix}:ss
distfiles-append    small-${small_hash}${extract.suffix}:small
distfiles-append    libutp-${utp_hash}${extract.suffix}:utp
distfiles-append    wide-integer-${wi_hash}${extract.suffix}:wi

