PortGroup           openssl 1.0

# Restore Qt front-end on top of upstream 4.1.4-2026.10.23
# https://github.com/transmission/transmission/commit/a6d907d9ea2313143af714d7830feb6c1b60b84c
github.setup        barracuda156 transmission 8a9be43e52b7aa604da8d8a38815c84c31251b0f
version             4.1.4
revision            0
conflicts           ${github.project}-gtk ${github.project}-qt ${github.project}-x11
categories          net x11 p2p
platforms           {darwin >= 9}
license             {GPL-2 OpenSSLException}
maintainers         {@barracuda156 gmail.com:vital.had} openmaintainer
description         Lightweight BitTorrent client
long_description    Transmission is a free, light-weight BitTorrent client. \
                    It features a simple, intuitive interface on top of an efficient, \
                    cross-platform back-end. Transmission is open-source (MIT license) \
                    and runs on Mac OS X (Qt or GTK+ interfaces), Linux/NetBSD/FreeBSD/OpenBSD \
                    (GTK+ interface) and BeOS (native interface).

homepage            https://transmissionbt.com
github.tarball_from archive
github.livecheck.branch 4.1.x

