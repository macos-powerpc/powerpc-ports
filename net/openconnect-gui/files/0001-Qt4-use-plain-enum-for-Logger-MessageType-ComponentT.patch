From caa9db90a3860e50a5020ca1640067391b481f44 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 12 Aug 2026 18:18:35 +0000
Subject: [PATCH 1/4] Qt4: use plain enum for Logger::MessageType/ComponentType

Qt4's moc cannot parse C++11 scoped enums, and Q_DECLARE_FLAGS/QFlags
requires an unscoped enum for its implicit int conversion. All call
sites already qualify enumerators as MessageType::X / ComponentType::X,
which remains valid for a plain enum nested in a class, so this is
behavior-preserving under Qt5/6 too.

Part of Qt4 buildability work for the macOS PowerPC port (see
https://github.com/macos-powerpc/powerpc-ports/blob/main/net/openconnect-gui/files/patch-fix-qt4.diff
for the equivalent v1.3-era patch).
---
 src/logger.h | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/logger.h b/src/logger.h
index 1417561..bcc1c27 100644
--- a/src/logger.h
+++ b/src/logger.h
@@ -9,7 +9,10 @@ class Logger : public QObject {
     Q_OBJECT
 
 public:
-    enum class MessageType {
+    /* Plain (unscoped) enums, not 'enum class': Qt4's moc cannot parse
+     * C++11 scoped enums, and Q_DECLARE_FLAGS/QFlags requires an
+     * unscoped enum for its implicit int conversion. */
+    enum MessageType {
         DEBUG,
         NORMAL,
         INFO,
@@ -18,7 +21,7 @@ public:
     };
     Q_DECLARE_FLAGS(MessageTypes, MessageType)
 
-    enum class ComponentType {
+    enum ComponentType {
         OCONNECT,
         GNUTLS,
         VPNC,
-- 
