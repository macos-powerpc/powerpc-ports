+def handle_termination_signal(*args):
+    # Ctrl+C: go through the regular quit path, so the downloads are saved and
+    # aria2c is shut down cleanly. A second signal (or a quit that takes too
+    # long) stops Varia the hard way.
+    try:
+        if myapp.win.terminating == False:
+            GLib.idle_add(myapp.win.quit_action_received, myapp)
+            GLib.timeout_add(10000, stop_subprocesses_and_exit)
+            return
+    except:
+        pass
+
+    stop_subprocesses_and_exit()
+
 def stop_subprocesses_and_exit(*args):
-    print("*** Varia has stopped ***")
-    
-    if "tray_process_global" in locals() and tray_process_global.poll() is None:
-        tray_process_global.kill()
-        myapp.win.tray_connection_thread_stop = True
-    
+    print("*** Varia has stopped ***", flush=True)
+
+    # From here on, another Ctrl+C (or another SIGTERM) should end Varia at once:
+    try:
+        signal.signal(signal.SIGINT, signal.SIG_DFL)
+        signal.signal(signal.SIGTERM, signal.SIG_DFL)
+    except:
+        pass
+
+    try:
+        win = myapp.win
+    except:
+        win = None
+
+    if win is not None:
+        win.terminating = True
+
+        # Kill the tray icon process:
+        try:
+            if win.tray_process and win.tray_process.poll() is None:
+                win.tray_process.kill()
+                win.tray_connection_thread_stop = True
+        except:
+            pass
+
+        # Stop aria2c. It is only bound to Varia's lifetime on Linux (PDEATHSIG)
+        # and Windows (job object), so elsewhere it has to be stopped here:
+        try:
+            aria2c_subprocess = getattr(win.aria2_instance, "aria2c_subprocess", None)
+
+            if aria2c_subprocess is not None and aria2c_subprocess.poll() is None:
+                aria2c_subprocess.terminate()
+
+                try:
+                    aria2c_subprocess.wait(timeout=3)
+                except:
+                    aria2c_subprocess.kill()
+        except:
+            pass
+
+        try:
+            win.destroy()
+        except:
+            pass
+
     try:
-        myapp.win.destroy()
         myapp.quit()
-        sys.exit()
-    
     except:
-        return
+        pass
+
+    # os._exit() instead of sys.exit(): the download threads and libtorrent can
+    # still be busy, and a regular interpreter shutdown waits for them - which
+    # is what used to leave Varia running after it said it had stopped.
+    os._exit(0)
 
