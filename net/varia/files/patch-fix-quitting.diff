-from gi.repository import GLib
+from gi.repository import GLib, Gdk
+
+def gdk_backend_is_macos():
+    # Varia's macOS specific interface (the native menubar and the native window
+    # buttons) only exists with GTK's macOS backend. A GTK that was built for X11
+    # (MacPorts, XQuartz) has no global menubar to put the menu in, so there the
+    # same in-window buttons as on Linux are needed - without them there is no
+    # way to reach the menu, or to quit Varia.
+    if os.name == 'nt' or os.uname().sysname != 'Darwin':
+        return False
+
+    backend = os.environ.get("GDK_BACKEND", "").lower()
+
+    if backend != "":
+        return backend in ("macos", "quartz")
+
+    try:
+        display = Gdk.Display.get_default()
+        return (display is None) or ("Macos" in display.__gtype__.name)
+    except:
+        return True # Assume the macOS backend, which is what the official build uses
 
