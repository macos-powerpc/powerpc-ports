       geoip_ptr = ::GeoIP_new(GEOIP_STANDARD);
+      if (geoip_ptr == nullptr)
+        log::warning(
+            logcat, "GeoIP database could not be opened; geoip based peer filtering is disabled");
     }
 
     ~Pimpl()
     {
-      ::GeoIP_delete(geoip_ptr);
+      if (geoip_ptr)
+        ::GeoIP_delete(geoip_ptr);
     }
 
