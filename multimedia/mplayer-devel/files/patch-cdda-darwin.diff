diff --git a/configure b/configure
index 4deb3f1..d6a9dfa 100755
--- configure
+++ configure
@@ -6546,12 +6546,34 @@ fi
 echores "$_libcdio"
 
 echocheck "cdparanoia"
+def_cdda_find_a_cdrom='#undef CONFIG_CDDA_FIND_A_CDROM'
 if test "$_cdparanoia" = auto ; then
     _cdparanoia=no
+    # stream_cdda.c calls cdda_identify_scsi() on NetBSD, and both
+    # cdda_identify() and cdda_identify_scsi() everywhere else (the choice
+    # between them is a runtime branch, so both symbols are always linked
+    # in); check for the ones that will actually be needed, not just
+    # paranoia_cachemodel_size(), or a libcdda_interface that is missing one
+    # of them only fails at the very end of a full build.
+    if netbsd ; then
+      _cdda_stmt='paranoia_cachemodel_size(NULL, 0); cdda_identify_scsi(NULL, NULL, 0, NULL)'
+    else
+      _cdda_stmt='paranoia_cachemodel_size(NULL, 0); cdda_identify(NULL, 0, NULL); cdda_identify_scsi(NULL, NULL, 0, NULL)'
+    fi
     for inc_tmp in "" "-I/usr/include/cdda" "-I/usr/local/include/cdda" ; do
-      statement_check_broken cdda_interface.h cdda_paranoia.h 'paranoia_cachemodel_size(NULL, 0)' $inc_tmp -lcdda_interface -lcdda_paranoia &&
+      statement_check_broken cdda_interface.h cdda_paranoia.h "$_cdda_stmt" $inc_tmp -lcdda_interface -lcdda_paranoia &&
         _cdparanoia=yes && extra_cflags="$extra_cflags $inc_tmp" && break
     done
+    # Some cdparanoia forks (notably the IOKit-based one used on Darwin)
+    # never implement cdda_identify()/cdda_identify_scsi() at all and
+    # provide cdda_find_a_cdrom() instead, which enumerates drives itself
+    # rather than taking a device path.
+    if test "$_cdparanoia" = no ; then
+      for inc_tmp in "" "-I/usr/include/cdda" "-I/usr/local/include/cdda" ; do
+        statement_check_broken cdda_interface.h cdda_paranoia.h 'paranoia_cachemodel_size(NULL, 0); cdda_find_a_cdrom(0, NULL)' $inc_tmp -lcdda_interface -lcdda_paranoia &&
+          _cdparanoia=yes && def_cdda_find_a_cdrom='#define CONFIG_CDDA_FIND_A_CDROM 1' && extra_cflags="$extra_cflags $inc_tmp" && break
+      done
+    fi
 fi
 if test "$_cdparanoia" = yes ; then
     _cdda='yes'
@@ -9262,6 +9284,7 @@ $(ff_config_enable "$cpuexts_all" "$cpuexts_inline" "#" "HAVE" "_INLINE")
 $def_bluray
 $def_cddb
 $def_cdparanoia
+$def_cdda_find_a_cdrom
 $def_dvdnav
 $def_dvdread
 $def_libcdio
