--- Makefile.orig
+++ Makefile
@@ -731,8 +731,19 @@
 %.o: %.cpp
 	$(CC) $(CC_DEPFLAGS) $(CXXFLAGS) $(CXX_C) $(CXX_O) $<
 
+# MPlayer's own Objective-C sources are compiled with $(MPOBJCC), which
+# defaults to $(CC). Being able to point it at a different compiler matters on
+# old Mac OS X: the rest of the tree (the bundled FFmpeg above all) needs a C11
+# compiler, while modern GCC's Objective-C code generation does not work
+# against the legacy 32-bit Objective-C runtime. Only this Makefile is
+# affected, the bundled FFmpeg compiles its own .m files with its own rules.
+MPOBJCC     ?= $(CC)
+# Another compiler need not understand the C standard flag picked for $(CC);
+# gnu99 is the newest one Xcode's GCC knows and is enough for these sources.
+MPOBJCFLAGS ?= $(if $(filter $(MPOBJCC),$(CC)),$(CFLAGS),$(filter-out -std=%,$(CFLAGS)) -std=gnu99)
+
 %.o: %.m
-	$(CC) $(CC_DEPFLAGS) $(CFLAGS) $(CC_C) $(CC_O) $<
+	$(MPOBJCC) $(CC_DEPFLAGS) $(MPOBJCFLAGS) $(CC_C) $(CC_O) $<
 
 %-rc.o: %.rc
 	$(WINDRES) -I. $(WINDRES_O) $<
