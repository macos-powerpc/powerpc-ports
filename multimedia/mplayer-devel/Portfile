# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           xcodeversion 1.0

name                mplayer-devel
conflicts           MPlayer

# svn info svn://svn.mplayerhq.hu/mplayer/trunk
# This is 2026.07.27, the current head of trunk.
# Starting with r38456, 2024.04.09, trunk follows the modern FFmpeg API and
# needs a C11 compiler, so Xcode's GCC can no longer build it. It is still
# needed for the Objective-C parts, see the darwin block below.
version             38688

# https://git.videolan.org/?p=ffmpeg.git;a=shortlog;h=refs/heads/release/7.1
# MPlayer expects the release/7.1 branch, see FFBRANCH in its configure.
# A release tag off that branch is pinned rather than an arbitrary branch
# commit: it is just as reproducible, and it is the only way to get away with
# a depth-1 clone. n7.1.5 is 2026.06.19.
set ffmpeg_tag      n7.1.5
set ffmpeg_ver      3a0867c2bfda4a4d4309ca1a8cbdc6175e67f587

categories          multimedia audio
license             GPL-2+
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer

description         Versatile movie player - development version
long_description    ${name} plays most movie files in popular and less popular formats. \
                    This version tracks a recent upstream mplayer commit.

homepage            https://www.mplayerhq.hu

fetch.type          svn
depends_fetch-append \
                    path:bin/git:git
worksrcdir          trunk

fetch {
    system "svn export -r${version} --ignore-externals svn://svn.mplayerhq.hu/mplayer/trunk ${worksrcpath}/"

    system "git clone -b ${ffmpeg_tag} --depth 1 git://git.videolan.org/ffmpeg.git ${worksrcpath}/ffmpeg"
    # No-op unless the tag has been moved since this port was last updated,
    # in which case it fails loudly instead of building something else.
    system "cd ${worksrcpath}/ffmpeg && git checkout -f ${ffmpeg_ver}"
}

# TODO: is this one needed?
# Fix i386 builds:
patchfiles          patch-mplayer-i386.diff

# Still needed.
# libao2/ao_coreaudio.c:176: error: 'kAudioFileEndOfFileError' undeclared (first use in this function)
patchfiles-append   patch-libao2.diff

# Upstream code is broken with ffmpeg version that it uses...
patchfiles-append   patch-ao_coreaudio-avfifo7.diff

# ...as well as with cdparanoia
patchfiles-append   patch-cdda-darwin.diff

# r38636 gave the definition of vo_osx_swap_buffers() a prototype-style unnamed
# parameter, which is only valid in C23:
# libvo/osx_objc_common.m:116: error: parameter name omitted
patchfiles-append   patch-libvo-objc.diff

# Adds MPOBJCC/MPOBJCFLAGS so MPlayer's own Objective-C sources can be built
# with a compiler other than ${configure.cc}, see the darwin block below.
patchfiles-append   patch-Makefile-objc.diff

# Use a portable form for asserts in ffmpeg:
patchfiles-append   patch-static_assert.diff

depends_build-append \
                    path:bin/pkg-config:pkgconfig

if {${configure.build_arch} in [list i386 x86_64]} {
    depends_build-append \
                    port:yasm
}

depends_lib-append  port:aom \
                    port:bzip2 \
                    port:cdparanoia \
                    port:dav1d \
                    port:faac \
                    port:faad2 \
                    path:lib/pkgconfig/fontconfig.pc:fontconfig \
                    path:lib/pkgconfig/freetype2.pc:freetype \
                    port:fribidi \
                    path:lib/pkgconfig/gnutls.pc:gnutls \
                    port:lame \
                    port:libbluray \
                    port:libdv \
                    port:libdvdnav \
                    port:libdvdread \
                    port:libiconv \
                    path:include/turbojpeg.h:libjpeg-turbo \
                    port:libmad \
                    port:libmng \
                    port:libpng \
                    port:libtheora \
                    port:libvorbis \
                    path:lib/pkgconfig/vpx.pc:libvpx \
                    port:libxml2 \
                    port:lzo2 \
                    port:ncurses \
                    port:openjpeg \
                    path:lib/libspeex.dylib:speex \
                    port:x264 \
                    port:XviD \
                    port:zlib

# cdparanoia, libbluray, libdvdnav and libdvdread buy DVD (with menus),
# Blu-ray and audio CD support; MPlayer's own CDDB client needs no library of
# its own, but only does anything once a CD backend is there.
# All four features are left to autodetection rather than passed as --enable-*:
# for dvdread, configure picks up the pkg-config cflags and libs only inside
# its autodetect branch, so forcing it on would define CONFIG_DVDREAD without
# ever adding -ldvdread.

# The bundled FFmpeg requires a C11 compiler now.
compiler.c_standard 2011

# Leopard needs Xcode 3.1 for /usr/bin/gcc-4.2, see the darwin block below.
minimum_xcodeversions {9 3.1}

# https://trac.macports.org/ticket/70804
if {${os.platform} eq "darwin" && ${os.major} > 22} {
    configure.cflags-append \
                    -Wno-error=incompatible-function-pointer-types \
                    -Wno-error=int-conversion
}

configure.args      --cc=${configure.cc} \
                    --host-cc=${configure.cc} \
                    --enable-freetype \
                    --enable-menu

platform darwin {
    # MPlayer's own GUI on macOS - the Cocoa/CoreVideo video output in libvo -
    # is Objective-C, and that is the one part a modern GCC must not compile:
    # the code it generates for the legacy 32-bit Objective-C runtime of
    # 10.5/10.6 makes the player crash on launch. Xcode's GCC gets it right but
    # can no longer build the rest of the tree (see compiler.c_standard above),
    # so it is used for the .m files alone. Both compilers share the plain C
    # ABI, so the objects link together fine.
    # This deliberately covers MPlayer's own sources only: the bundled FFmpeg
    # keeps its own build rules and $(CC), and every other dependency is built
    # by its own port.
    if {${os.major} <= 10} {
        set objc_cc ""
        foreach cc {/usr/bin/gcc-4.2 /usr/bin/gcc-4.0} {
            if {[file executable ${cc}]} {
                set objc_cc ${cc}
                break
            }
        }

        if {${objc_cc} ne ""} {
            build.args-append \
                    MPOBJCC=${objc_cc}
            destroot.args-append \
                    MPOBJCC=${objc_cc}
        } else {
            pre-build {
                ui_warn "No Xcode GCC found, Objective-C code will be built with ${configure.compiler}, which may produce broken executables."
            }
        }
    }
}

platform darwin powerpc {
    variant G4 conflicts G5 description "Optimize for G4" {
        configure.cflags-append \
                    -mtune=G4 -mcpu=G4
    }

    variant G5 conflicts G4 description "Optimize for G5" {
        configure.cflags-append \
                    -mcpu=970 -mtune=970

        # https://github.com/iains/gcc-14-branch/issues/24
        if {${configure.build_arch} ne "ppc64"} {
            configure.cflags-append \
                    -mno-powerpc64
        }
    }
}

# These autodetect a library that is not in depends_lib, so leaving them on
# auto would make the build depend on whatever else happens to be installed.
# Two of them do not merely add a feature:
#   libcdio, once found, forcibly turns cdparanoia off
#   tremor, once found, forcibly replaces libvorbis
foreach option {
    crystalhd libcdio libilbc libopencore_amrnb libopencore_amrwb libopus librtmp tremor
} {
    configure.args-append --disable-${option}
}

# TODO: if we properly support Linux or *BSD, these must be adjusted.
foreach option {

3dfx aa alsa apple-ir arts bl caca dart dga1 dga2 direct3d directfb \
directx dvb dxr2 dxr3 enca esd fbdev ggi ggiwmh gif gui jack joystick kai kva \
ladspa liba52 libbs2b libdca libgsm libmpeg2 libnut lirc lircc live macosx-finder \
mga mpg123 musepack nas nemesi openal ossaudio pulse pvr radio radio-capture \
s3fb sdl sgiaudio smb sndio sunaudio svga tdfxfb tdfxvid toolame tv-bsdbt848 tv-dshow \
tv-v4l1 tv-v4l2 twolame v4l2 vcd vdpau vesa vidix vm vstream wii win32dll win32waveout \
x11 xf86keysym xinerama xmga xmms xshape xss xv xvr100 zr

} {
    configure.args-append --disable-${option}
}
