# implicit declaration of function '_tzcnt_u32' is invalid in C99
# uses newer intrinsic functions
compiler.blacklist  {clang < 700} {*gcc-[34].*}

# Disables detection by compiler capability.
if {${os.platform} eq "darwin" && ${os.major} < 11 && \
${configure.build_arch} in [list i386 x86_64]} {
    configure.env-append \
        ax_cv_check_cflags___mavx2=no \
        ax_cv_check_cflags___mbmi=no \
        ax_cv_check_cflags___mbmi2=no \
        ax_cv_check_cflags___mlzcnt=no \
        ax_cv_check_cflags___mpopcnt=no \
        ax_cv_check_cflags___mabm=no \
        ax_cv_check_cflags___msse4_1=no
}

# On 10a190 either drop the patch or use libdispatch-legacy port.
# On 10.6.8 ppc this works.
# Adds method of detecting number of CPUs on Tiger.
# Does not force use of _xgetbv on intel IF avx and or avx2 is disabled.
patchfiles-append    patch-enable-dispatch.diff src_strategyselector.c.diff
