github.tarball_from releases

# implicit declaration of function '_tzcnt_u32' is invalid in C99
# uses newer intrinsic functions
compiler.blacklist  {clang < 700} {*gcc-[34].*}

# Patches configure.ac to include --disable-avx2 and --disable-sse4.1 options.
if {${os.platform} eq "darwin" && ${os.major} < 11 && \
${configure.build_arch} in [list i386 x86_64]} {
    patchfiles-append configure.ac_optional-optimizations.diff
    use_autoreconf      yes
    autoreconf.args     -fiv
    configure.args-append --disable-avx2 --disable-sse4.1
}

# On 10a190 either drop the patch or use libdispatch-legacy port.
# On 10.6.8 ppc this works.
# Adds method of detecting number of CPUs on Tiger, and does not force use of _xgetbv
# on intel IF avx2 is disabled.
patchfiles-append \
    patch-enable-dispatch.diff \
    src_strategyselector.c.diff
