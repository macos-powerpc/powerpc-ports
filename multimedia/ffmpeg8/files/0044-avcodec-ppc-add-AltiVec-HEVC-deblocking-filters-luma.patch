 libavcodec/ppc/hevcdsp.c                  |  22 +
 libavcodec/ppc/hevcdsp_deblock_template.c | 732 ++++++++++++++++++++++
 2 files changed, 754 insertions(+)
 create mode 100644 libavcodec/ppc/hevcdsp_deblock_template.c

diff --git a/libavcodec/ppc/hevcdsp.c b/libavcodec/ppc/hevcdsp.c
index 602a1c3..ef313cd 100644
--- a/libavcodec/ppc/hevcdsp.c
+++ b/libavcodec/ppc/hevcdsp.c
@@ -119,6 +119,7 @@ static void ff_hevc_idct_32x32_10_altivec(int16_t *c, int l) { idct_altivec(c, 3
 #if HAVE_BIGENDIAN
 #include "hevcdsp_sao_template.c"
 #include "hevcdsp_inter_template.c"
+#include "hevcdsp_deblock_template.c"
 #endif
 #undef BIT_DEPTH
 
@@ -127,6 +128,7 @@ static void ff_hevc_idct_32x32_10_altivec(int16_t *c, int l) { idct_altivec(c, 3
 #if HAVE_BIGENDIAN
 #include "hevcdsp_sao_template.c"
 #include "hevcdsp_inter_template.c"
+#include "hevcdsp_deblock_template.c"
 #endif
 #undef BIT_DEPTH
 
@@ -390,6 +392,24 @@ static void put_hevc_qpel_hv_altivec(int16_t *dst, const uint8_t *src,
         }                                                                      \
     } while (0)
 
+/*
+ * Deblocking: the one HEVC stage that had no PowerPC path at all. The
+ * kernels honour no_p/no_q, so they also serve the _c slots that
+ * deblocking_filter_CTB() uses when pcm_loop_filter_disabled or
+ * transquant_bypass is in effect (the other architectures leave those on C).
+ */
+#define DEBLOCK_SET(depth)                                                     \
+    do {                                                                       \
+        c->hevc_h_loop_filter_luma     = ff_hevc_h_loop_filter_luma_ ## depth ## _altivec;   \
+        c->hevc_v_loop_filter_luma     = ff_hevc_v_loop_filter_luma_ ## depth ## _altivec;   \
+        c->hevc_h_loop_filter_chroma   = ff_hevc_h_loop_filter_chroma_ ## depth ## _altivec; \
+        c->hevc_v_loop_filter_chroma   = ff_hevc_v_loop_filter_chroma_ ## depth ## _altivec; \
+        c->hevc_h_loop_filter_luma_c   = ff_hevc_h_loop_filter_luma_ ## depth ## _altivec;   \
+        c->hevc_v_loop_filter_luma_c   = ff_hevc_v_loop_filter_luma_ ## depth ## _altivec;   \
+        c->hevc_h_loop_filter_chroma_c = ff_hevc_h_loop_filter_chroma_ ## depth ## _altivec; \
+        c->hevc_v_loop_filter_chroma_c = ff_hevc_v_loop_filter_chroma_ ## depth ## _altivec; \
+    } while (0)
+
 av_cold void ff_hevc_dsp_init_ppc(HEVCDSPContext *c, const int bit_depth)
 {
 #if HAVE_ALTIVEC
@@ -437,6 +457,7 @@ av_cold void ff_hevc_dsp_init_ppc(HEVCDSPContext *c, const int bit_depth)
             c->put_hevc_qpel[i][1][0] = put_hevc_qpel_v_altivec;
             c->put_hevc_qpel[i][1][1] = put_hevc_qpel_hv_altivec;
         }
+        DEBLOCK_SET(8);
     }
     if (bit_depth == 10) {
         c->add_residual[1] = ff_hevc_add_residual8x8_10_altivec;
@@ -450,6 +471,7 @@ av_cold void ff_hevc_dsp_init_ppc(HEVCDSPContext *c, const int bit_depth)
         c->sao_edge_filter[0] = c->sao_edge_filter[1] = c->sao_edge_filter[2] =
         c->sao_edge_filter[3] = c->sao_edge_filter[4] = ff_hevc_sao_edge_filter_10_altivec;
         MC_SET(10);
+        DEBLOCK_SET(10);
     }
 #endif /* HAVE_BIGENDIAN */
 #endif /* HAVE_ALTIVEC */
diff --git a/libavcodec/ppc/hevcdsp_deblock_template.c b/libavcodec/ppc/hevcdsp_deblock_template.c
new file mode 100644
index 0000000..60cf663
--- /dev/null
+++ b/libavcodec/ppc/hevcdsp_deblock_template.c
@@ -0,0 +1,732 @@
+/*
+ * AltiVec-optimized HEVC deblocking filters
+ * Copyright (c) 2026 Sergey Fedorov
+ *
