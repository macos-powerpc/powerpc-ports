From c796d06e7c278f0f673d0a7004e639ec533d8e93 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Wed, 9 Sep 2026 04:33:31 +0000
Subject: [PATCH] Qt4: use UTF-8 for implicit C-string conversions

The code base relies on Qt5's behaviour where converting a QByteArray or a
const char * to QString decodes UTF-8. In Qt4 those conversions go through
QString::fromAscii(), which is Latin-1 unless QTextCodec::setCodecForCStrings
was called. Playlist readers (PLS/M3U/XSPF) build the URL and title from raw
bytes that way while the writers emit toUtf8(), so every save/load cycle
decoded UTF-8 as Latin-1 and re-encoded it: each non-ASCII byte became two.
After ~26 launches a playlist with one CJK character reached 256 MB and the
next start died with std::bad_alloc while loading it.

Set the C-string, tr() and locale codecs to UTF-8 at the top of main(),
which is the Qt4 idiom for a UTF-8 code base and also fixes the same
mangling for network responses, yt-dlp output and tag text.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TT6KirfnBKdTErka33cSUn
---
 src/gui/Main.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/gui/Main.cpp b/src/gui/Main.cpp
index 7f15a2da..eefbd4a8 100644
--- a/src/gui/Main.cpp
+++ b/src/gui/Main.cpp
@@ -35,6 +35,9 @@
 #endif
 // Qt4: No QVersionNumber (added in Qt5.6)
 #include <QApplication>
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+    #include <QTextCodec>
+#endif
 #include <QImageReader>
 #include <QTreeWidget>
 #include <QMessageBox>
@@ -775,6 +778,15 @@ int main(int argc, char *argv[])
     signal(SIGSEGV, signal_handler);
     signal(SIGTERM, signal_handler);
     atexit(exitProcedure);
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+    // Qt4: implicit "QByteArray -> QString" and "const char * -> QString" conversions go
+    // through QString::fromAscii(), which is Latin-1 unless a codec is set. The code base
+    // assumes UTF-8 everywhere, as Qt5 guarantees. Without this, every save/load cycle of
+    // non-ASCII text (e.g. playlist titles) is re-encoded and doubles in size.
+    QTextCodec::setCodecForCStrings(QTextCodec::codecForName("UTF-8"));
+    QTextCodec::setCodecForTr(QTextCodec::codecForName("UTF-8"));
+    QTextCodec::setCodecForLocale(QTextCodec::codecForName("UTF-8"));
+#endif
 
 #ifdef Q_OS_ANDROID
     qputenv("QT_ANDROID_ENABLE_RIGHT_MOUSE_FROM_LONG_PRESS", "1");
