From 4c23ec971fc72c5db902386b3b093216d029177f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Wed, 9 Sep 2026 01:43:41 +0000
Subject: [PATCH] Qt4: set the GL viewport before every paint in the OpenGL
 renderer

OpenGLCommon never calls glViewport. Under Qt5 that is fine because
QOpenGLWidget and QOpenGLWindow set the viewport to the surface size
before every paintGL. QGLWidget does no such thing (its default resizeGL
is empty), so in the Qt4 build the viewport kept whatever size the
context had when it was first attached to a drawable. After leaving full
screen the video was drawn into a stale, full-screen sized viewport and
came out distorted.

Set the viewport at the start of paintGL in both Qt4 classes. Doing it
per paint instead of in resizeGL also covers reparenting, which can
reset the viewport without a resize event.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TT6KirfnBKdTErka33cSUn
---
 src/qmplay2/opengl/OpenGLWidgetQt4.cpp | 4 ++++
 src/qmplay2/opengl/OpenGLWindowQt4.cpp | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/src/qmplay2/opengl/OpenGLWidgetQt4.cpp b/src/qmplay2/opengl/OpenGLWidgetQt4.cpp
index b81fa6c7..d8f5f799 100644
--- a/src/qmplay2/opengl/OpenGLWidgetQt4.cpp
+++ b/src/qmplay2/opengl/OpenGLWidgetQt4.cpp
@@ -62,6 +62,10 @@ void OpenGLWidget::initializeGL()
 }
 void OpenGLWidget::paintGL()
 {
+    // Qt4: QGLWidget never sets the viewport (QOpenGLWidget does it before every
+    // paintGL). Do it here rather than in resizeGL, because reparenting the widget
+    // (e.g. leaving full screen) can reset the viewport without a resize event.
+    glViewport(0, 0, width(), height());
     glClear(GL_COLOR_BUFFER_BIT);
     OpenGLCommon::paintGL();
 }
diff --git a/src/qmplay2/opengl/OpenGLWindowQt4.cpp b/src/qmplay2/opengl/OpenGLWindowQt4.cpp
index 6e3d86d2..1fab7aec 100644
--- a/src/qmplay2/opengl/OpenGLWindowQt4.cpp
+++ b/src/qmplay2/opengl/OpenGLWindowQt4.cpp
@@ -109,6 +109,10 @@ void OpenGLWindow::paintGL()
     // Qt4: Use isVisible() instead of isExposed()
     if (isVisible())
     {
+        // Qt4: QGLWidget never sets the viewport (QOpenGLWindow does it before every
+        // paintGL). Do it here rather than in resizeGL, because reparenting the widget
+        // (e.g. leaving full screen) can reset the viewport without a resize event.
+        glViewport(0, 0, width(), height());
         glClear(GL_COLOR_BUFFER_BIT);
         OpenGLCommon::paintGL();
     }
