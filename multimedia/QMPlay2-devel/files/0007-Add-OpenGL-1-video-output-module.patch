diff --git a/src/modules/OpenGL1/CMakeLists.txt b/src/modules/OpenGL1/CMakeLists.txt
new file mode 100644
index 00000000..a1cdce72
--- /dev/null
+++ b/src/modules/OpenGL1/CMakeLists.txt
@@ -0,0 +1,57 @@
+cmake_minimum_required(VERSION 3.16)
+project(OpenGL1)
+
+set(OpenGL1_HDR
+    OpenGL1Writer.hpp
+    OpenGL1.hpp
+)
+
+set(OpenGL1_SRC
+    OpenGL1Writer.cpp
+    OpenGL1.cpp
+)
+
+set(OpenGL1_RESOURCES
+    icon.qrc
+)
+
+# Fixed-function GL entry points (glBegin, glTexImage2D, ...) are called directly,
+# so link the system OpenGL library/framework explicitly.
+find_package(OpenGL REQUIRED)
+
+add_library(${PROJECT_NAME} MODULE
+    ${OpenGL1_HDR}
+    ${OpenGL1_SRC}
+    ${OpenGL1_RESOURCES}
+)
+
+if(BUILD_WITH_QT4)
+    # Qt4: QGLWidget and QGLShaderProgram live in QtOpenGL, which is found
+    # together with the other Qt4 components by the top-level CMakeLists.txt.
+    target_link_libraries(${PROJECT_NAME}
+        PRIVATE
+        ${QT_QTOPENGL_LIBRARY}
+    )
+else()
+    # Qt5: QGLWidget still exists in the QtOpenGL module (removed in Qt6).
+    find_package(Qt5OpenGL 5.15.2 REQUIRED)
+    target_link_libraries(${PROJECT_NAME}
+        PRIVATE
+        Qt5::OpenGL
+    )
+endif()
+
+target_link_libraries(${PROJECT_NAME}
+    PRIVATE
+    ${OPENGL_LIBRARIES}
+)
+
+libqmplay2_set_target_params()
+
+if(USE_PCH)
+    target_precompile_headers(${PROJECT_NAME} PRIVATE
+        ${OpenGL1_HDR}
+    )
+endif()
+
+install(TARGETS ${PROJECT_NAME} LIBRARY DESTINATION ${MODULES_INSTALL_PATH})
