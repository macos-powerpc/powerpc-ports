+#pragma once
+
+/*
+    Fixed-function OpenGL 1.x video output.
+
+    This is a "legacy renderer" video writer module (like QPainter or XVideo):
+    it does not depend on the OpenGL 2 renderer built into libqmplay2 and it
+    only needs QtOpenGL (QGLWidget), which exists in Qt4 and Qt5.
+
+    Two rendering paths are chosen at run time:
+      - shader path: the three Y/Cb/Cr planes are uploaded as luminance
+        textures and converted to RGB by a small GLSL fragment shader
+        (needs fragment shaders and multitexturing);
+      - CPU path: swscale converts the frame to RGB32 on the CPU, and the
+        GPU only scales and displays the single RGB texture. This path needs
+        nothing beyond OpenGL 1.2 (GL_BGRA, packed pixels, clamp to edge).
+
+    Textures are allocated with power-of-two sizes when the driver has no
+    GL_ARB_texture_non_power_of_two, and the image is uploaded into the
+    top-left corner with glTexSubImage2D, so no CPU-side resampling is ever
+    needed to satisfy the power-of-two requirement.
+*/
+
+#include <VideoWriter.hpp>
+#include <Functions.hpp>
+#include <ImgScaler.hpp>
+#include <Frame.hpp>
+
+#include <QtOpenGL/QGLWidget>
+#include <QImage>
+
+#ifndef APIENTRY
+    #define APIENTRY
+#endif
+
+class QGLShaderProgram;
+class OpenGL1Writer;
+
+class OpenGL1Drawable final : public QGLWidget
+{
+    typedef void (APIENTRY *GLActiveTextureFn)(GLenum);
+
+    struct Texture
+    {
+        GLuint id = 0;
+        GLint internalFormat = 0;
+        GLenum format = 0;
+        GLenum type = 0;
+        GLint filter = 0;
+        int bytesPerPixel = 1;
+        quint8 fill = 0;
+        int texW = 0, texH = 0; // Allocated size (power of two if NPOT textures are unsupported)
+        int w = 0, h = 0;       // Used size
+    };
+
+public:
+    OpenGL1Drawable(OpenGL1Writer &writer);
+    ~OpenGL1Drawable();
+
+    void clr();
+    void draw(const Frame &newVideoFrame, QMPlay2OSDList &&osdList);
+
+    void resizeEvent(QResizeEvent *e) override;
+
+    // Video equalizer values, set by the writer
+    bool videoEqChanged = true;
+    float contrast = 1.0f, saturation = 1.0f, brightness = 0.0f, hue = 0.0f; // Shader path
+    int contrastInt = 100, brightnessInt = 0; // CPU path
+
+private:
+    void initializeGL() override;
+    void resizeGL(int w, int h) override;
+    void paintGL() override;
+
+    bool event(QEvent *e) override;
+
+    void initShaders();
+    void applySwapInterval();
+
+    void setupTexture(Texture &tex, GLuint id, GLint internalFormat, GLenum format, GLenum type, int bytesPerPixel, quint8 fill, GLint filter);
+    void ensureTexture(Texture &tex, int w, int h);
+    void uploadTexture(Texture &tex, const void *data, int rowLengthPixels);
+    void drawVideoQuad(const Texture &tex, int flip);
+
+    bool paintVideoShaders();
+    bool paintVideoCPU();
+    void paintOSD();
+    void updateColorMatrix(const Frame &frame);
+
+    OpenGL1Writer &writer;
+
+    int W = 0, H = 0, X = 0, Y = 0;
+
+    // Capabilities
+    bool m_hasNPOT = false;
+    GLint m_maxTexSize = 0;
+    GLenum m_rgbFormat = 0, m_rgbType = 0;
+
+    // Shader path
+    QGLShaderProgram *m_program = nullptr;
+    GLActiveTextureFn m_glActiveTexture = nullptr;
+    bool m_shadersOK = false;
+    int m_lastColorSpace = -1;
+    int m_lastLimited = -1;
+
+    Texture m_texY, m_texU, m_texV, m_texRGB, m_texOSD;
+    bool m_texturesCreated = false;
+
+    // CPU path
+    ImgScaler m_imgScaler;
+    quint8 *m_rgbBuffer = nullptr;
+    int m_rgbW = 0, m_rgbH = 0;
+
+    Frame m_videoFrame;
+    bool m_hasNewFrame = false;
+
+    QMPlay2OSDList m_osdList;
+    Functions::OsdIdList m_osdIds;
+    QImage m_osdImg;
+};
+
+/**/
+
+class OpenGL1Writer final : public VideoWriter
+{
+    friend class OpenGL1Drawable;
+public:
+    OpenGL1Writer(Module &);
+private:
+    ~OpenGL1Writer();
+
+    bool set() override;
+
+    bool readyWrite() const override;
+
+    bool processParams(bool *paramsCorrected) override;
+
+    AVPixelFormats supportedPixelFormats() const override;
+
+    void writeVideo(const Frame &videoFrame, QMPlay2OSDList &&osdList) override;
+
+    QString name() const override;
+
+    bool open() override;
+
+    /**/
+
+    int outW = -1, outH = -1, flip = 0;
+    double aspect_ratio = 0.0, zoom = 0.0;
+    bool vSync = true, useShaders = true;
+
+    OpenGL1Drawable *drawable = nullptr;
+};
+
+#define OpenGL1WriterName "OpenGL 1"
