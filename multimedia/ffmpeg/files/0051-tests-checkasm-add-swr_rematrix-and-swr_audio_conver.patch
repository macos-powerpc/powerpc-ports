+ *
+ * You should have received a copy of the GNU General Public License along
+ * with FFmpeg; if not, write to the Free Software Foundation, Inc.,
+ * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "checkasm.h"
+
+#include "libavutil/avassert.h"
+#include "libavutil/channel_layout.h"
+#include "libavutil/mem_internal.h"
+#include "libavutil/opt.h"
+#include "libavutil/samplefmt.h"
+
+#include "libswresample/swresample.h"
+#include "libswresample/swresample_internal.h"
+
+/* Every plane buffer holds GUARD_BYTES of random data on each side of the
+ * region a call may touch, so an out-of-window read can never fault and an
+ * out-of-window write is always caught by the guard comparison below.
+ * MAX_OFF is the number of distinct 16-byte residues an S16P (2 byte)
+ * sample offset can land on; FLTP (4 byte) only needs 4 of them. */
+#define GUARD_BYTES 32
+#define MAX_LEN     256
+#define MAX_OFF     8
+#define MAX_ELEM    4
+#define PLANE_BYTES (GUARD_BYTES + (MAX_OFF + MAX_LEN) * MAX_ELEM + GUARD_BYTES)
+
+static int residues(enum AVSampleFormat fmt)
+{
+    return fmt == AV_SAMPLE_FMT_S16P ? 8 : 4;
+}
+
+static int elem_size(enum AVSampleFormat fmt)
+{
+    return fmt == AV_SAMPLE_FMT_S16P ? 2 : 4;
+}
+
+static void fill_input(uint8_t *buf, int bytes, enum AVSampleFormat fmt)
+{
+    int i;
+
+    if (fmt == AV_SAMPLE_FMT_S16P) {
+        int16_t *p = (int16_t *)buf;
+        for (i = 0; i < bytes / 2; i++)
+            p[i] = (int16_t)(rnd() & 0xffff);
+    } else {
+        float *p = (float *)buf;
+        for (i = 0; i < bytes / 4; i++)
+            p[i] = (float)((rnd() / (double)UINT_MAX - 0.5) * 2);
+    }
+}
+
+static void fill_guard(uint8_t *buf, int bytes)
+{
+    uint32_t *p = (uint32_t *)buf;
+    int i;
+
+    for (i = 0; i < bytes / 4; i++)
+        p[i] = (uint32_t)rnd();
+}
+
+/* Compare two PLANE_BYTES sized output buffers after one ref/new call pair.
+ * pre_bytes is the byte offset the call's output window starts at; for S16P
+ * the whole buffer must be bit-exact, for FLTP only the window may differ
+ * (by up to 1e-6) while both guards must stay byte-identical. */
+static void compare_buffers(int is_s16p, const uint8_t *dst0, const uint8_t *dst1,
+                            int total_bytes, int pre_bytes, int window_len,
+                            const char *ctx)
+{
+    if (is_s16p) {
+        if (memcmp(dst0, dst1, total_bytes)) {
+            int i, first = -1;
+            for (i = 0; i < total_bytes; i++)
+                if (dst0[i] != dst1[i]) { first = i; break; }
+            fail();
+            fprintf(stderr, "%s: s16p mismatch at byte %d\n", ctx, first);
+        }
+    } else {
+        int window_bytes = window_len * 4;
+        int post_bytes   = total_bytes - pre_bytes - window_bytes;
+        const float *w0  = (const float *)(dst0 + pre_bytes);
+        const float *w1  = (const float *)(dst1 + pre_bytes);
+        int guard_bad = memcmp(dst0, dst1, pre_bytes) ||
+                        memcmp(dst0 + pre_bytes + window_bytes,
+                               dst1 + pre_bytes + window_bytes, post_bytes);
+        int win_bad = !float_near_abs_eps_array(w0, w1, 1e-6f, window_len);
+
+        if (guard_bad || win_bad) {
+            int i, first = -1;
+            if (win_bad)
+                for (i = 0; i < window_len; i++)
+                    if (fabsf(w0[i] - w1[i]) > 1e-6f) { first = i; break; }
+            fail();
+            fprintf(stderr, "%s: fltp mismatch (guard=%d win=%d first_idx=%d)\n",
+                    ctx, guard_bad, win_bad, first);
+        }
+    }
+}
+
+static struct SwrContext *alloc_ctx(enum AVSampleFormat fmt,
+                                    const AVChannelLayout *in_layout,
+                                    const AVChannelLayout *out_layout,
+                                    const double *matrix, int stride)
+{
+    struct SwrContext *s = swr_alloc();
+
+    if (!s)
+        return NULL;
+
+    av_opt_set_chlayout(s, "in_chlayout",  in_layout,  0);
+    av_opt_set_chlayout(s, "out_chlayout", out_layout, 0);
+    av_opt_set_sample_fmt(s, "in_sample_fmt",       fmt, 0);
+    av_opt_set_sample_fmt(s, "out_sample_fmt",      fmt, 0);
+    av_opt_set_sample_fmt(s, "internal_sample_fmt", fmt, 0);
+    av_opt_set_int(s, "in_sample_rate",  48000, 0);
+    av_opt_set_int(s, "out_sample_rate", 48000, 0);
+
+    if (matrix && swr_set_matrix(s, matrix, stride) < 0) {
+        swr_free(&s);
+        return NULL;
+    }
+
+    if (swr_init(s) < 0) {
+        swr_free(&s);
+        return NULL;
+    }
+
+    return s;
+}
+
+static void run_mix_1_1(const char *base_name, enum AVSampleFormat fmt,
+                        const char *fmt_name, const double *matrix)
+{
+    AVChannelLayout stereo_in  = AV_CHANNEL_LAYOUT_STEREO;
+    AVChannelLayout stereo_out = AV_CHANNEL_LAYOUT_STEREO;
+    static const int lens[] = { 16, 32, 64, 256 };
+    DECLARE_ALIGNED(16, uint8_t, in_planes)[2][PLANE_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, dst0)[PLANE_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, dst1)[PLANE_BYTES];
+    struct SwrContext *s;
+    mix_1_1_func_type *fn;
+    const void *tab_ref, *tab_new;
+    int r, elem, is_s16p = fmt == AV_SAMPLE_FMT_S16P;
+    char name[64];
+
+    s = alloc_ctx(fmt, &stereo_in, &stereo_out, matrix, 2);
+    if (!s)
+        return;
+
+    av_assert0(s->matrix_ch[0][0] == 1);
+    av_assert0(s->matrix_ch[1][0] == 1);
+
+    fn      = s->mix_1_1_simd ? s->mix_1_1_simd : s->mix_1_1_f;
+    tab_ref = s->native_matrix;
+    tab_new = s->mix_1_1_simd ? s->native_simd_matrix : s->native_matrix;
+
+    r    = residues(fmt);
+    elem = elem_size(fmt);
+    snprintf(name, sizeof(name), "swr_rematrix_%s_%s", base_name, fmt_name);
+
+    if (check_func(fn, "%s", name)) {
+        declare_func(void, void *, const void *, const void *, integer, integer);
+        int li, oi, row;
+
+        for (li = 0; li < FF_ARRAY_ELEMS(lens); li++) {
+            int len = lens[li];
+
+            for (oi = 0; oi <= r; oi++) {
+                int out_off = oi < r ? oi           : 0;
+                int in_off  = oi < r ? (oi + 1) % r : 0;
+
+                fill_input(in_planes[0], PLANE_BYTES, fmt);
+                fill_input(in_planes[1], PLANE_BYTES, fmt);
+
+                for (row = 0; row < 2; row++) {
+                    integer index = 2 * row + row;   /* nb_in*out_i + in_i, diagonal */
+                    uint8_t *out_ref, *out_new;
+                    const uint8_t *in_ptr;
+                    char ctx[160];
+
+                    fill_guard(dst0, PLANE_BYTES);
+                    memcpy(dst1, dst0, PLANE_BYTES);
+
+                    out_ref = dst0 + GUARD_BYTES + out_off * elem;
+                    out_new = dst1 + GUARD_BYTES + out_off * elem;
+                    in_ptr  = in_planes[row] + GUARD_BYTES + in_off * elem;
+
+                    call_ref(out_ref, in_ptr, tab_ref, index, (integer)len);
+                    call_new(out_new, in_ptr, tab_new, index, (integer)len);
+
+                    snprintf(ctx, sizeof(ctx),
+                            "%s: len=%d out_off=%d in_off=%d row=%d",
+                            name, len, out_off, in_off, row);
+                    compare_buffers(is_s16p, dst0, dst1, PLANE_BYTES,
+                                   GUARD_BYTES + out_off * elem, len, ctx);
+                }
+            }
+        }
+
+        fill_input(in_planes[0], PLANE_BYTES, fmt);
+        bench_new(dst1, in_planes[0], tab_new, (integer)0, (integer)lens[FF_ARRAY_ELEMS(lens) - 1]);
+    }
+
+    swr_free(&s);
+}
+
+static void run_mix_2_1(const char *base_name, enum AVSampleFormat fmt,
+                        const char *fmt_name, const double *matrix)
+{
+    AVChannelLayout in_layout  = AV_CHANNEL_LAYOUT_STEREO;
+    AVChannelLayout out_layout = AV_CHANNEL_LAYOUT_MONO;
+    static const int lens[] = { 16, 32, 64, 256 };
+    DECLARE_ALIGNED(16, uint8_t, in_planes)[2][PLANE_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, dst0)[PLANE_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, dst1)[PLANE_BYTES];
+    struct SwrContext *s;
+    mix_2_1_func_type *fn;
+    const void *tab_ref, *tab_new;
+    int r, elem, is_s16p = fmt == AV_SAMPLE_FMT_S16P;
+    char name[64];
+
+    s = alloc_ctx(fmt, &in_layout, &out_layout, matrix, 2);
+    if (!s)
+        return;
+
+    av_assert0(s->matrix_ch[0][0] == 2);
+
+    fn      = s->mix_2_1_simd ? s->mix_2_1_simd : s->mix_2_1_f;
+    tab_ref = s->native_matrix;
+    tab_new = s->mix_2_1_simd ? s->native_simd_matrix : s->native_matrix;
+
+    r    = residues(fmt);
+    elem = elem_size(fmt);
+    snprintf(name, sizeof(name), "swr_rematrix_%s_%s", base_name, fmt_name);
+
+    if (check_func(fn, "%s", name)) {
+        declare_func(void, void *, const void *, const void *, const void *,
+                    integer, integer, integer);
+        int li, oi;
+
+        for (li = 0; li < FF_ARRAY_ELEMS(lens); li++) {
+            int len = lens[li];
+
+            for (oi = 0; oi <= r; oi++) {
+                int out_off = oi < r ? oi               : 0;
+                int in1_off = oi < r ? (oi + 1) % r     : 0;
+                int in2_off = oi < r ? (oi * 3 + 2) % r : 0;
+                uint8_t *out_ref, *out_new;
+                const uint8_t *in1_ptr, *in2_ptr;
+                char ctx[160];
+
+                fill_input(in_planes[0], PLANE_BYTES, fmt);
+                fill_input(in_planes[1], PLANE_BYTES, fmt);
+                fill_guard(dst0, PLANE_BYTES);
+                memcpy(dst1, dst0, PLANE_BYTES);
+
+                out_ref = dst0 + GUARD_BYTES + out_off * elem;
+                out_new = dst1 + GUARD_BYTES + out_off * elem;
+                in1_ptr = in_planes[0] + GUARD_BYTES + in1_off * elem;
+                in2_ptr = in_planes[1] + GUARD_BYTES + in2_off * elem;
+
+                call_ref(out_ref, in1_ptr, in2_ptr, tab_ref,
+                        (integer)0, (integer)1, (integer)len);
+                call_new(out_new, in1_ptr, in2_ptr, tab_new,
+                        (integer)0, (integer)1, (integer)len);
+
+                snprintf(ctx, sizeof(ctx),
+                        "%s: len=%d out_off=%d in1_off=%d in2_off=%d",
+                        name, len, out_off, in1_off, in2_off);
+                compare_buffers(is_s16p, dst0, dst1, PLANE_BYTES,
+                               GUARD_BYTES + out_off * elem, len, ctx);
+            }
+        }
+
+        fill_input(in_planes[0], PLANE_BYTES, fmt);
+        fill_input(in_planes[1], PLANE_BYTES, fmt);
+        bench_new(dst1, in_planes[0], in_planes[1], tab_new,
+                 (integer)0, (integer)1, (integer)lens[FF_ARRAY_ELEMS(lens) - 1]);
+    }
+
+    swr_free(&s);
+}
+
+static void run_mix_any(int nb_in, enum AVSampleFormat fmt, const char *fmt_name)
+{
+    AVChannelLayout in_layout;
+    AVChannelLayout out_layout = AV_CHANNEL_LAYOUT_STEREO;
+    static const int lens[] = { 1, 2, 3, 4, 5, 7, 8, 15, 16, 17, 31, 64, 100 };
+    DECLARE_ALIGNED(16, uint8_t, in_planes)[8][PLANE_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, out0)[2][PLANE_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, out1)[2][PLANE_BYTES];
+    struct SwrContext *s;
+    mix_any_func_type *fn;
+    const void *table;
+    int r, elem, is_s16p = fmt == AV_SAMPLE_FMT_S16P;
+    int nb_planes = nb_in + 2;
+    char name[64];
+
+    in_layout = nb_in == 6 ? (AVChannelLayout)AV_CHANNEL_LAYOUT_5POINT1
+                          : (AVChannelLayout)AV_CHANNEL_LAYOUT_7POINT1;
+
+    s = alloc_ctx(fmt, &in_layout, &out_layout, NULL, 0);
+    if (!s)
+        return;
+
+    av_assert0(s->mix_any_f != NULL);
+
+    fn    = s->mix_any_f;
+    table = s->native_matrix;
+
+    r    = residues(fmt);
+    elem = elem_size(fmt);
+    snprintf(name, sizeof(name), "swr_rematrix_mix%dto2_%s", nb_in, fmt_name);
+
+    if (check_func(fn, "%s", name)) {
+        declare_func(void, uint8_t *const *, const uint8_t *const *, const void *, integer);
+        int li, oi, p;
+
+        for (li = 0; li < FF_ARRAY_ELEMS(lens); li++) {
+            int len = lens[li];
+
+            for (oi = 0; oi <= r; oi++) {
+                uint8_t *out_ref[2], *out_new[2];
+                const uint8_t *in_ptrs[8];
+                int off[10];
+                char ctx[160];
+
+                for (p = 0; p < nb_planes; p++)
+                    off[p] = oi < r ? (oi + p) % r : 0;
+
+                for (p = 0; p < nb_in; p++)
+                    fill_input(in_planes[p], PLANE_BYTES, fmt);
+                fill_guard(out0[0], PLANE_BYTES);
+                fill_guard(out0[1], PLANE_BYTES);
+                memcpy(out1[0], out0[0], PLANE_BYTES);
+                memcpy(out1[1], out0[1], PLANE_BYTES);
+
+                out_ref[0] = out0[0] + GUARD_BYTES + off[0] * elem;
+                out_ref[1] = out0[1] + GUARD_BYTES + off[1] * elem;
+                out_new[0] = out1[0] + GUARD_BYTES + off[0] * elem;
+                out_new[1] = out1[1] + GUARD_BYTES + off[1] * elem;
+                for (p = 0; p < nb_in; p++)
+                    in_ptrs[p] = in_planes[p] + GUARD_BYTES + off[2 + p] * elem;
+
+                call_ref(out_ref, in_ptrs, table, (integer)len);
+                call_new(out_new, in_ptrs, table, (integer)len);
+
+                snprintf(ctx, sizeof(ctx), "%s: len=%d out0_off=%d out1_off=%d",
+                        name, len, off[0], off[1]);
+                compare_buffers(is_s16p, out0[0], out1[0], PLANE_BYTES,
+                               GUARD_BYTES + off[0] * elem, len, ctx);
+                compare_buffers(is_s16p, out0[1], out1[1], PLANE_BYTES,
+                               GUARD_BYTES + off[1] * elem, len, ctx);
+            }
+        }
+
+        {
+            uint8_t *out_new[2];
+            const uint8_t *in_ptrs[8];
+
+            for (p = 0; p < nb_in; p++)
+                fill_input(in_planes[p], PLANE_BYTES, fmt);
+            out_new[0] = out1[0];
+            out_new[1] = out1[1];
+            for (p = 0; p < nb_in; p++)
+                in_ptrs[p] = in_planes[p];
+            bench_new(out_new, in_ptrs, table, (integer)lens[FF_ARRAY_ELEMS(lens) - 1]);
+        }
+    }
+
+    swr_free(&s);
+}
+
+void checkasm_check_swr_rematrix(void)
+{
+    static const struct {
+        enum AVSampleFormat fmt;
+        const char *name;
+    } formats[] = {
+        { AV_SAMPLE_FMT_S16P, "s16p" },
+        { AV_SAMPLE_FMT_FLTP, "fltp" },
+    };
+    static const double matrix_mix11[4]      = {  0.5,  0.0, 0.0, -0.75 };
+    static const double matrix_mix11_clip[4] = {  1.5,  0.0, 0.0, -1.25 };
+    static const double matrix_mix21[2]      = {  0.625, -0.25 };
+    static const double matrix_mix21_clip[2] = {  1.25,   0.5 };
+    int i;
+
+    for (i = 0; i < FF_ARRAY_ELEMS(formats); i++) {
+        run_mix_1_1("mix_1_1",      formats[i].fmt, formats[i].name, matrix_mix11);
+        run_mix_1_1("mix_1_1_clip", formats[i].fmt, formats[i].name, matrix_mix11_clip);
+        run_mix_2_1("mix_2_1",      formats[i].fmt, formats[i].name, matrix_mix21);
+        run_mix_2_1("mix_2_1_clip", formats[i].fmt, formats[i].name, matrix_mix21_clip);
+        run_mix_any(6, formats[i].fmt, formats[i].name);
+        run_mix_any(8, formats[i].fmt, formats[i].name);
+    }
+
+    report("swr_rematrix");
+}
