+ *
+ * FFmpeg is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with FFmpeg; if not, write to the Free Software Foundation, Inc.,
+ * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "checkasm.h"
+
+#include "libavutil/avassert.h"
+#include "libavutil/mem_internal.h"
+#include "libavutil/samplefmt.h"
+
+#include "libswresample/audioconvert.h"
+
+#include "config.h"
+
+#define MAX_LEN 256
+#define MAX_CHANNELS 6
+/* 64 trailing guard bytes so an out-of-window write is caught even at MAX_LEN */
+#define PLANE_BYTES  (MAX_LEN * 4 + 64)
+#define PACKED_BYTES (MAX_LEN * MAX_CHANNELS * 4 + 64)
+
+/* AudioConvert has no C twin for ctx->simd_f, so this test-local function
+ * replicates swri_audio_convert()'s per-channel conv_f calling convention
+ * and stands in as the reference implementation. */
+static AudioConvert *ref_ctx;
+static int ref_channels;
+static enum AVSampleFormat ref_in_fmt, ref_out_fmt;
+
+static void ref_convert(uint8_t **dst, const uint8_t **src, int len)
+{
+    int in_planar  = av_sample_fmt_is_planar(ref_in_fmt);
+    int out_planar = av_sample_fmt_is_planar(ref_out_fmt);
+    int ibps = av_get_bytes_per_sample(ref_in_fmt);
+    int obps = av_get_bytes_per_sample(ref_out_fmt);
+
+    if (in_planar == out_planar) {
+        ref_ctx->conv_f(dst[0], src[0], ibps, obps, dst[0] + obps * len);
+    } else {
+        int ch;
+        for (ch = 0; ch < ref_channels; ch++) {
+            int is = in_planar  ? ibps : ref_channels * ibps;
+            int os = out_planar ? obps : ref_channels * obps;
+            const uint8_t *pi = in_planar  ? src[ch] : src[0] + ch * ibps;
+            uint8_t *po       = out_planar ? dst[ch] : dst[0] + ch * obps;
+            ref_ctx->conv_f(po, pi, is, os, po + os * len);
+        }
+    }
+}
+
+static void randomize_buf(uint8_t *buf, int bytes, enum AVSampleFormat fmt)
+{
+    int i;
+
+    switch (av_get_packed_sample_fmt(fmt)) {
+    case AV_SAMPLE_FMT_S16: {
+        int16_t *p = (int16_t *)buf;
+        for (i = 0; i < bytes / 2; i++)
+            p[i] = (int16_t)(rnd() & 0xffff);
+        break;
+    }
+    case AV_SAMPLE_FMT_S32: {
+        int32_t *p = (int32_t *)buf;
+        for (i = 0; i < bytes / 4; i++)
+            p[i] = (int32_t)rnd();
+        break;
+    }
+    case AV_SAMPLE_FMT_FLT: {
+        float *p = (float *)buf;
+        for (i = 0; i < bytes / 4; i++)
+            p[i] = (float)((rnd() / (double)UINT_MAX - 0.5) * 3.0);
+        break;
+    }
+    default:
+        av_assert0(0);
+    }
+}
+
+static void randomize_words(uint8_t *buf, int bytes)
+{
+    uint32_t *p = (uint32_t *)buf;
+    int i;
+
+    for (i = 0; i < bytes / 4; i++)
+        p[i] = (uint32_t)rnd();
+}
+
+#if ARCH_ARM || ARCH_AARCH64
+static int int16_near_array(const int16_t *a, const int16_t *b, int tol, int len)
+{
+    int i;
+    for (i = 0; i < len; i++) {
+        int d = (int)a[i] - (int)b[i];
+        if (d < -tol || d > tol)
+            return 0;
+    }
+    return 1;
+}
+#endif
+
+/* Compare two total_bytes sized output buffers (a whole plane, or the whole
+ * packed frame buffer) after one ref/new call pair. Only the first
+ * active_bytes were declared as this call's output window (frames elements
+ * for the ARM/AArch64 tolerance path); anything beyond that is trailing
+ * guard and must stay byte-identical either way. */
+static void compare_out(int is_f2i16, const uint8_t *dst0, const uint8_t *dst1,
+                        int total_bytes, int active_bytes, int frames,
+                        const char *ctx)
+{
+    int post_bytes = total_bytes - active_bytes;
+    int guard_bad = memcmp(dst0 + active_bytes, dst1 + active_bytes, post_bytes) != 0;
+    int win_bad;
+
+#if ARCH_ARM || ARCH_AARCH64
+    if (is_f2i16)
+        win_bad = !int16_near_array((const int16_t *)dst0, (const int16_t *)dst1, 1, frames);
+    else
+        win_bad = memcmp(dst0, dst1, active_bytes) != 0;
+#else
+    (void)is_f2i16;
+    (void)frames;
+    win_bad = memcmp(dst0, dst1, active_bytes) != 0;
+#endif
+
+    if (guard_bad || win_bad) {
+        fail();
+        fprintf(stderr, "%s: mismatch (guard=%d window=%d)\n", ctx, guard_bad, win_bad);
+    }
+}
+
+static void run_case(enum AVSampleFormat in_fmt, enum AVSampleFormat out_fmt,
+                     int channels)
+{
+    static const int lens[] = { 16, 32, 48, 64, 256 };
+    int in_planar  = av_sample_fmt_is_planar(in_fmt);
+    int out_planar = av_sample_fmt_is_planar(out_fmt);
+    int ibps = av_get_bytes_per_sample(in_fmt);
+    int obps = av_get_bytes_per_sample(out_fmt);
+    int is_f2i16 = (av_get_packed_sample_fmt(in_fmt)  == AV_SAMPLE_FMT_FLT) &&
+                  (av_get_packed_sample_fmt(out_fmt) == AV_SAMPLE_FMT_S16);
+    DECLARE_ALIGNED(16, uint8_t, src_planes)[MAX_CHANNELS][PLANE_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, src_packed)[PACKED_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, dst0_planes)[MAX_CHANNELS][PLANE_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, dst1_planes)[MAX_CHANNELS][PLANE_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, dst0_packed)[PACKED_BYTES];
+    DECLARE_ALIGNED(16, uint8_t, dst1_packed)[PACKED_BYTES];
+    AudioConvert *ctx;
+    simd_func_type *fn;
+
+    if (in_fmt == out_fmt)
+        return;
+
+    ctx = swri_audio_convert_alloc(out_fmt, in_fmt, channels, NULL, 0);
+    if (!ctx)
+        return;
+
+    ref_ctx      = ctx;
+    ref_channels = channels;
+    ref_in_fmt   = in_fmt;
+    ref_out_fmt  = out_fmt;
+
+    fn = ctx->simd_f ? ctx->simd_f : ref_convert;
+
+    if (check_func(fn, "swr_convert_%s_to_%s_%dch",
+                  av_get_sample_fmt_name(in_fmt),
+                  av_get_sample_fmt_name(out_fmt), channels)) {
+        declare_func(void, uint8_t **, const uint8_t **, int);
+        int li;
+
+        for (li = 0; li < FF_ARRAY_ELEMS(lens); li++) {
+            int frames = lens[li];
+            uint8_t *dst0[SWR_CH_MAX] = { 0 }, *dst1[SWR_CH_MAX] = { 0 };
+            const uint8_t *src[SWR_CH_MAX] = { 0 };
+            int ch;
+            char ctxbuf[96];
+
+            /* Fill the whole (over-provisioned) input buffers, not just the
+             * active window: some kernels may prefetch or process in blocks
+             * wider than the requested length. */
+            if (in_planar) {
+                for (ch = 0; ch < channels; ch++)
+                    randomize_buf(src_planes[ch], PLANE_BYTES, in_fmt);
+            } else {
+                randomize_buf(src_packed, PACKED_BYTES, in_fmt);
+            }
+
+            if (out_planar) {
+                for (ch = 0; ch < channels; ch++) {
+                    randomize_words(dst0_planes[ch], PLANE_BYTES);
+                    memcpy(dst1_planes[ch], dst0_planes[ch], PLANE_BYTES);
+                }
+            } else {
+                randomize_words(dst0_packed, PACKED_BYTES);
+                memcpy(dst1_packed, dst0_packed, PACKED_BYTES);
+            }
+
+            snprintf(ctxbuf, sizeof(ctxbuf), "swr_convert_%s_to_%s_%dch: frames=%d",
+                    av_get_sample_fmt_name(in_fmt), av_get_sample_fmt_name(out_fmt),
+                    channels, frames);
+
+            if (in_planar == out_planar) {
+                int planes = out_planar ? channels : 1;
+                int count  = out_planar ? frames : frames * channels;
+                int p;
+
+                for (p = 0; p < planes; p++) {
+                    dst0[0] = out_planar ? dst0_planes[p] : dst0_packed;
+                    dst1[0] = out_planar ? dst1_planes[p] : dst1_packed;
+                    src[0]  = in_planar  ? src_planes[p]  : src_packed;
+
+                    call_ref(dst0, src, count);
+                    call_new(dst1, src, count);
+                }
+
+                if (out_planar) {
+                    for (p = 0; p < planes; p++)
+                        compare_out(is_f2i16, dst0_planes[p], dst1_planes[p],
+                                   PLANE_BYTES, frames * obps, frames, ctxbuf);
+                } else {
+                    compare_out(is_f2i16, dst0_packed, dst1_packed,
+                               PACKED_BYTES, frames * channels * obps,
+                               frames * channels, ctxbuf);
+                }
+            } else {
+                for (ch = 0; ch < channels; ch++) {
+                    dst0[ch] = out_planar ? dst0_planes[ch] : dst0_packed + ch * obps;
+                    dst1[ch] = out_planar ? dst1_planes[ch] : dst1_packed + ch * obps;
+                    src[ch]  = in_planar  ? src_planes[ch]  : src_packed  + ch * ibps;
+                }
+
+                call_ref(dst0, src, frames);
+                call_new(dst1, src, frames);
+
+                if (out_planar) {
+                    for (ch = 0; ch < channels; ch++)
+                        compare_out(is_f2i16, dst0_planes[ch], dst1_planes[ch],
+                                   PLANE_BYTES, frames * obps, frames, ctxbuf);
+                } else {
+                    compare_out(is_f2i16, dst0_packed, dst1_packed,
+                               PACKED_BYTES, frames * channels * obps,
+                               frames * channels, ctxbuf);
+                }
+            }
+        }
+
+        {
+            int frames = lens[FF_ARRAY_ELEMS(lens) - 1];
+            uint8_t *dst[SWR_CH_MAX] = { 0 };
+            const uint8_t *src[SWR_CH_MAX] = { 0 };
+            int ch;
+
+            if (in_planar == out_planar) {
+                dst[0] = out_planar ? dst1_planes[0] : dst1_packed;
+                src[0] = in_planar  ? src_planes[0]  : src_packed;
+                bench_new(dst, src, out_planar ? frames : frames * channels);
+            } else {
+                for (ch = 0; ch < channels; ch++) {
+                    dst[ch] = out_planar ? dst1_planes[ch] : dst1_packed + ch * obps;
+                    src[ch] = in_planar  ? src_planes[ch]  : src_packed  + ch * ibps;
+                }
+                bench_new(dst, src, frames);
+            }
+        }
+    }
+
+    swri_audio_convert_free(&ctx);
+}
+
+void checkasm_check_swr_audio_convert(void)
+{
+    static const enum AVSampleFormat all_fmts[] = {
+        AV_SAMPLE_FMT_S16, AV_SAMPLE_FMT_S16P,
+        AV_SAMPLE_FMT_S32, AV_SAMPLE_FMT_S32P,
+        AV_SAMPLE_FMT_FLT, AV_SAMPLE_FMT_FLTP,
+    };
+    static const enum AVSampleFormat planar_fmts[] = {
+        AV_SAMPLE_FMT_S16P, AV_SAMPLE_FMT_S32P, AV_SAMPLE_FMT_FLTP,
+    };
+    static const int channel_counts[] = { 1, 2, 6 };
+    int ci;
+
+    for (ci = 0; ci < FF_ARRAY_ELEMS(channel_counts); ci++) {
+        int channels = channel_counts[ci];
+        const enum AVSampleFormat *fmts = channels == 1 ? planar_fmts : all_fmts;
+        int nb_fmts = channels == 1 ? FF_ARRAY_ELEMS(planar_fmts)
+                                    : FF_ARRAY_ELEMS(all_fmts);
+        int i, j;
+
+        for (i = 0; i < nb_fmts; i++)
+            for (j = 0; j < nb_fmts; j++)
+                run_case(fmts[i], fmts[j], channels);
+    }
+
+    report("swr_audio_convert");
+}
