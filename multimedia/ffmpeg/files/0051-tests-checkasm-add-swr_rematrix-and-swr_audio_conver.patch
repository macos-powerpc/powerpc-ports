diff --git a/tests/checkasm/swr_audio_convert.c b/tests/checkasm/swr_audio_convert.c
new file mode 100644
index 0000000..4ac25d0
--- /dev/null
+++ b/tests/checkasm/swr_audio_convert.c
@@ -0,0 +1,311 @@
+/*
