diff --git a/tests/checkasm/sw_yuv2yuv.c b/tests/checkasm/sw_yuv2yuv.c
index 6a03801..fcc0c87 100644
--- a/tests/checkasm/sw_yuv2yuv.c
+++ b/tests/checkasm/sw_yuv2yuv.c
@@ -18,6 +18,7 @@
 
 #include <string.h>
 
+#include "libavutil/avassert.h"
 #include "libavutil/common.h"
 #include "libavutil/intreadwrite.h"
 #include "libavutil/mem_internal.h"
@@ -269,6 +270,326 @@ static void check_packed422(int src_pix_fmt, int dst_pix_fmt)
 #undef DST_SIZE
 }
 
+/*
+ * Oracle for the AltiVec scaler-path packed 4:2:2 packers (yuv2packed1/2/X
+ * for yuyv422/uyvy422/yvyu422, libswscale/ppc/yuv2yuv_altivec.c).
+ *
+ * Unlike check_packed422 above, these three functions are picked from the
+ * *scaled* dispatch table (libswscale/output.c, registered unconditionally
+ * for these three dst formats, no SWS_BITEXACT/SWS_FULL_CHR_H_INT/needAlpha
+ * gate -- see libswscale/output.c:3800-3813). The context is built with
+ * SWS_BITEXACT so that no unscaled special converter (C or the sub-task-1
+ * AltiVec one) is selected for convert_unscaled, which would otherwise
+ * short-circuit sws_init_context() before it reaches ff_sws_init_scale()
+ * (see utils.c:1623-1637); ff_sws_init_scale() is also called explicitly
+ * here to defend against that early-return in general (as check_yuv2yuvX in
+ * sw_scale.c already does), and the pointers are asserted non-NULL.
+ *
+ * The C references clip only when bit 8 of the pre-clip result is set
+ * (`(Y1|Y2|U|V) & 0x100`), i.e. only when the true saturating result would
+ * be in [-256, 511]; outside that window the C stores the low byte of an
+ * unclamped int and is not a meaningful oracle. Inputs are therefore kept
+ * inside that window per variant:
+ *   - _1 and _2: any int16_t value is safe (verified range [-256, 256] and
+ *     [-256, 255] respectively for the formulas involved).
+ *   - _X: inputs are masked to non-negative 15-bit (& 0x7FFF) -- the test
+ *     filter has one tap of 8191 and the rest -(4096/(n-1)), which for
+ *     negative inputs could push the pre-shift sum outside the window.
+ */
+static void p422_design_filter(int16_t *filt, int n)
+{
+    if (n == 1) {
+        filt[0] = 4096;
+        return;
+    }
+    for (int i = 0; i < n; i++)
+        filt[i] = -(4096 / (n - 1));
+    filt[rnd() % n] = 8191;
+}
+
+#define P422_MAXW      1920
+#define P422_LUM_N     (P422_MAXW + 1 + 8 + 32)
+#define P422_CHR_N     ((P422_MAXW + 1) / 2 + 8 + 32)
+#define P422_DST_N     4096
+#define P422_MAX_LINES 16
+
+static const int p422_widths[] = {
+    2, 8, 16, 17, 31, 32, 33, 48, 63, 64, 640, 853, 854, 1080, 1366, 1919, 1920
+};
+static const int p422_src_offsets[] = { 0, 1, 3, 5 };
+static const int p422_dst_offsets[] = { 0, 4, 6, 8, 12 };
+
+static SwsInternal *p422_get_context(enum AVPixelFormat dst_fmt, SwsContext **swsp)
+{
+    SwsContext *sws = sws_alloc_context();
+    SwsInternal *c;
+
+    sws->src_format = AV_PIX_FMT_YUV420P;
+    sws->dst_format = dst_fmt;
+    sws->flags      = SWS_BILINEAR | SWS_BITEXACT | SWS_ACCURATE_RND;
+    sws->src_w = sws->dst_w = sws->src_h = sws->dst_h = 64;
+
+    if (sws_init_context(sws, NULL, NULL) < 0) {
+        fail();
+        sws_freeContext(sws);
+        *swsp = NULL;
+        return NULL;
+    }
+
+    c = sws_internal(sws);
+    ff_sws_init_scale(c);
+    av_assert0(c->yuv2packed1 && c->yuv2packed2 && c->yuv2packedX);
+
+    *swsp = sws;
+    return c;
+}
+
+static void check_yuv2packed422_1(enum AVPixelFormat dst_fmt)
+{
+    static const int uvalphas[] = { 0, 2048, 4096 };
+
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(dst_fmt);
+    SwsContext *sws;
+    SwsInternal *c;
+
+    declare_func(void, SwsInternal *c, const int16_t *lumSrc,
+                 const int16_t *chrUSrc[2], const int16_t *chrVSrc[2],
+                 const int16_t *alpSrc, uint8_t *dest,
+                 int dstW, int uvalpha, int y);
+
+    LOCAL_ALIGNED_16(int16_t, lum0, [P422_LUM_N]);
+    LOCAL_ALIGNED_16(int16_t, u0,   [P422_CHR_N]);
+    LOCAL_ALIGNED_16(int16_t, u1,   [P422_CHR_N]);
+    LOCAL_ALIGNED_16(int16_t, v0,   [P422_CHR_N]);
+    LOCAL_ALIGNED_16(int16_t, v1,   [P422_CHR_N]);
+    LOCAL_ALIGNED_16(uint8_t, dst0, [P422_DST_N]);
+    LOCAL_ALIGNED_16(uint8_t, dst1, [P422_DST_N]);
+
+    randomize_buffers((uint8_t *)lum0, P422_LUM_N * sizeof(int16_t));
+    randomize_buffers((uint8_t *)u0,   P422_CHR_N * sizeof(int16_t));
+    randomize_buffers((uint8_t *)u1,   P422_CHR_N * sizeof(int16_t));
+    randomize_buffers((uint8_t *)v0,   P422_CHR_N * sizeof(int16_t));
+    randomize_buffers((uint8_t *)v1,   P422_CHR_N * sizeof(int16_t));
+
+    c = p422_get_context(dst_fmt, &sws);
+    if (!c)
+        return;
+
+    for (int ai = 0; ai < FF_ARRAY_ELEMS(uvalphas); ai++) {
+        int uvalpha = uvalphas[ai];
+        if (check_func(c->yuv2packed1, "yuv2%s_1_%d", desc->name, uvalpha)) {
+            for (int oi = 0; oi < FF_ARRAY_ELEMS(p422_src_offsets); oi++) {
+                int off = p422_src_offsets[oi];
+                const int16_t *lumSrc  = lum0 + off;
+                const int16_t *chrU[2] = { u0 + off, u1 + off };
+                const int16_t *chrV[2] = { v0 + off, v1 + off };
+
+                for (int wi = 0; wi < FF_ARRAY_ELEMS(p422_widths); wi++) {
+                    int w = p422_widths[wi];
+
+                    for (int di = 0; di < FF_ARRAY_ELEMS(p422_dst_offsets); di++) {
+                        int doff = p422_dst_offsets[di];
+
+                        memset(dst0, 0x55, P422_DST_N);
+                        memset(dst1, 0x55, P422_DST_N);
+
+                        call_ref(c, lumSrc, chrU, chrV, NULL, dst0 + doff, w, uvalpha, 0);
+                        call_new(c, lumSrc, chrU, chrV, NULL, dst1 + doff, w, uvalpha, 0);
+
+                        if (memcmp(dst0, dst1, P422_DST_N))
+                            fail();
+                    }
+                }
+            }
+            {
+                const int16_t *chrU[2] = { u0, u1 };
+                const int16_t *chrV[2] = { v0, v1 };
+                bench_new(c, lum0, chrU, chrV, NULL, dst1, 1920, uvalpha, 0);
+            }
+        }
+    }
+
+    sws_freeContext(sws);
+}
+
+static void check_yuv2packed422_2(enum AVPixelFormat dst_fmt)
+{
+    static const int alphas[][2] = {
+        { 0, 0 }, { 2048, 2048 }, { 4096, 4096 }, { 1234, 3000 }, { 4096, 0 },
+    };
+
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(dst_fmt);
+    SwsContext *sws;
+    SwsInternal *c;
+
+    declare_func(void, SwsInternal *c, const int16_t *lumSrc[2],
+                 const int16_t *chrUSrc[2], const int16_t *chrVSrc[2],
+                 const int16_t *alpSrc[2], uint8_t *dest,
+                 int dstW, int yalpha, int uvalpha, int y);
+
+    LOCAL_ALIGNED_16(int16_t, lum0, [P422_LUM_N]);
+    LOCAL_ALIGNED_16(int16_t, lum1, [P422_LUM_N]);
+    LOCAL_ALIGNED_16(int16_t, u0,   [P422_CHR_N]);
+    LOCAL_ALIGNED_16(int16_t, u1,   [P422_CHR_N]);
+    LOCAL_ALIGNED_16(int16_t, v0,   [P422_CHR_N]);
+    LOCAL_ALIGNED_16(int16_t, v1,   [P422_CHR_N]);
+    LOCAL_ALIGNED_16(uint8_t, dst0, [P422_DST_N]);
+    LOCAL_ALIGNED_16(uint8_t, dst1, [P422_DST_N]);
+
+    randomize_buffers((uint8_t *)lum0, P422_LUM_N * sizeof(int16_t));
+    randomize_buffers((uint8_t *)lum1, P422_LUM_N * sizeof(int16_t));
+    randomize_buffers((uint8_t *)u0,   P422_CHR_N * sizeof(int16_t));
+    randomize_buffers((uint8_t *)u1,   P422_CHR_N * sizeof(int16_t));
+    randomize_buffers((uint8_t *)v0,   P422_CHR_N * sizeof(int16_t));
+    randomize_buffers((uint8_t *)v1,   P422_CHR_N * sizeof(int16_t));
+
+    c = p422_get_context(dst_fmt, &sws);
+    if (!c)
+        return;
+
+    for (int ai = 0; ai < FF_ARRAY_ELEMS(alphas); ai++) {
+        int yalpha = alphas[ai][0], uvalpha = alphas[ai][1];
+        if (check_func(c->yuv2packed2, "yuv2%s_2_%d_%d", desc->name, yalpha, uvalpha)) {
+            for (int oi = 0; oi < FF_ARRAY_ELEMS(p422_src_offsets); oi++) {
+                int off = p422_src_offsets[oi];
+                const int16_t *lumSrc[2] = { lum0 + off, lum1 + off };
+                const int16_t *chrU[2]   = { u0 + off, u1 + off };
+                const int16_t *chrV[2]   = { v0 + off, v1 + off };
+
+                for (int wi = 0; wi < FF_ARRAY_ELEMS(p422_widths); wi++) {
+                    int w = p422_widths[wi];
+
+                    for (int di = 0; di < FF_ARRAY_ELEMS(p422_dst_offsets); di++) {
+                        int doff = p422_dst_offsets[di];
+
+                        memset(dst0, 0x55, P422_DST_N);
+                        memset(dst1, 0x55, P422_DST_N);
+
+                        call_ref(c, lumSrc, chrU, chrV, NULL, dst0 + doff, w, yalpha, uvalpha, 0);
+                        call_new(c, lumSrc, chrU, chrV, NULL, dst1 + doff, w, yalpha, uvalpha, 0);
+
+                        if (memcmp(dst0, dst1, P422_DST_N))
+                            fail();
+                    }
+                }
+            }
+            {
+                const int16_t *lumSrc[2] = { lum0, lum1 };
+                const int16_t *chrU[2]   = { u0, u1 };
+                const int16_t *chrV[2]   = { v0, v1 };
+                bench_new(c, lumSrc, chrU, chrV, NULL, dst1, 1920, yalpha, uvalpha, 0);
+            }
+        }
+    }
+
+    sws_freeContext(sws);
+}
+
+static void check_yuv2packed422_X(enum AVPixelFormat dst_fmt)
+{
+    static const int fs_pairs[][2] = {
+        { 1, 1 }, { 2, 2 }, { 3, 1 }, { 4, 3 }, { 8, 8 }, { 16, 16 }, { 5, 16 },
+    };
+
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(dst_fmt);
+    SwsContext *sws;
+    SwsInternal *c;
+    const int16_t *lumSrc[P422_MAX_LINES];
+    const int16_t *chrU[P422_MAX_LINES];
+    const int16_t *chrV[P422_MAX_LINES];
+
+    declare_func(void, SwsInternal *c, const int16_t *lumFilter,
+                 const int16_t **lumSrc, int lumFilterSize,
+                 const int16_t *chrFilter, const int16_t **chrUSrc,
+                 const int16_t **chrVSrc, int chrFilterSize,
+                 const int16_t **alpSrc, uint8_t *dest, int dstW, int y);
+
+    LOCAL_ALIGNED_16(int16_t, lum_buf,  [P422_MAX_LINES], [P422_LUM_N]);
+    LOCAL_ALIGNED_16(int16_t, u_buf,    [P422_MAX_LINES], [P422_CHR_N]);
+    LOCAL_ALIGNED_16(int16_t, v_buf,    [P422_MAX_LINES], [P422_CHR_N]);
+    LOCAL_ALIGNED_16(uint8_t, dst0,     [P422_DST_N]);
+    LOCAL_ALIGNED_16(uint8_t, dst1,     [P422_DST_N]);
