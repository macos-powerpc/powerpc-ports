+                    }
+                }
+            }
+            {
+                int l;
+                for (l = 0; l < lfs; l++)
+                    lumSrc[l] = lum_buf[l];
+                for (l = 0; l < cfs; l++) {
+                    chrU[l] = u_buf[l];
+                    chrV[l] = v_buf[l];
+                }
+                bench_new(c, lum_filt, lumSrc, lfs, chr_filt, chrU, chrV, cfs,
+                          NULL, dst1, 1920, 0);
+            }
+        }
+    }
+
+    sws_freeContext(sws);
