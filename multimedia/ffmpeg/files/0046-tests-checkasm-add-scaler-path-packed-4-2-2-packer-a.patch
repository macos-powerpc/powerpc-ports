+                    chrV[l] = v_buf[l] + off;
+                }
+
+                for (int wi = 0; wi < FF_ARRAY_ELEMS(p422_widths); wi++) {
+                    int w = p422_widths[wi];
+
+                    for (int di = 0; di < FF_ARRAY_ELEMS(p422_dst_offsets); di++) {
