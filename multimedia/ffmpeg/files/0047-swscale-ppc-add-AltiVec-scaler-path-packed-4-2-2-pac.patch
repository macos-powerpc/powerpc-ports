+/*
+ * Registers the scaler-path packed 4:2:2 packers (yuv2packed1/2/X) defined
+ * above. Mirrors the C dispatch in libswscale/output.c:3800-3813 exactly:
+ * no SWS_BITEXACT / SWS_FULL_CHR_H_INT / needAlpha gate, because the
+ * bit-exactness argument in the file comment above holds unconditionally.
+ * Called from ff_sws_init_swscale_ppc() (swscale_altivec.c) after that
+ * function's own cpu-flags check, so no separate check is done here beyond
+ * the compile-time HAVE_ALTIVEC/HAVE_BIGENDIAN gate (this project's only
+ * target, 32-bit big-endian G4/G5, always has HAVE_BIGENDIAN true; the
+ * extra check only guards a hypothetical little-endian PPC build, which
+ * this codebase's own classic-AltiVec element-order assumptions -- shared
+ * with every other kernel in this file -- would not survive either).
+ */
+av_cold void ff_sws_init_yuv2packed422_ppc(SwsInternal *c)
+{
+#if HAVE_ALTIVEC && HAVE_BIGENDIAN
+    switch (c->opts.dst_format) {
+    case AV_PIX_FMT_YUYV422:
+        c->yuv2packed1 = yuv2yuyv422_1_altivec;
+        c->yuv2packed2 = yuv2yuyv422_2_altivec;
+        c->yuv2packedX = yuv2yuyv422_X_altivec;
+        break;
+    case AV_PIX_FMT_YVYU422:
+        c->yuv2packed1 = yuv2yvyu422_1_altivec;
+        c->yuv2packed2 = yuv2yvyu422_2_altivec;
+        c->yuv2packedX = yuv2yvyu422_X_altivec;
+        break;
+    case AV_PIX_FMT_UYVY422:
+        c->yuv2packed1 = yuv2uyvy422_1_altivec;
+        c->yuv2packed2 = yuv2uyvy422_2_altivec;
+        c->yuv2packedX = yuv2uyvy422_X_altivec;
+        break;
+    }
+#endif /* HAVE_ALTIVEC && HAVE_BIGENDIAN */
+}
