                 CHROMA_MC8_ALTIVEC_CORE_SIMPLE;
@@ -191,18 +253,17 @@ static void PREFIX_h264_chroma_mc4_altivec(uint8_t * dst, const uint8_t * src,
                                            ptrdiff_t stride, int h,
                                            int x, int y)
 {
