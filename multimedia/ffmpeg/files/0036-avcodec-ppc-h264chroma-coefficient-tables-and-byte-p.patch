+/* Other users of this template (VC-1) do not define a store: keep the
+ * original read-modify-write for them, so nothing outside H.264 chroma
+ * changes. */
+#ifndef CHROMA_MC8_STORE
+# define CHROMA_MC8_STORE_IS_LOCAL 1
+# define CHROMA_MC8_STORE(psum, dst, fperm)                              \
+    do {                                                                 \
+        vec_u8 vd_ = vec_ld(0, (dst));                                   \
+        vec_u8 pp_ = (vec_u8)vec_pack(psum, psum);                       \
+        vec_u8 vf_ = vec_perm(vd_, pp_, (fperm));                        \
+        vec_u8 fs_;                                                      \
+        OP_U8_ALTIVEC(fs_, vf_, vd_);                                    \
+        vec_st(fs_, 0, (dst));                                           \
+    } while (0)
+#endif
