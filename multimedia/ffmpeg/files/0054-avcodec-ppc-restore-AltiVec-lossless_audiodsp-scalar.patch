+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config.h"
+
+#include "libavutil/attributes.h"
+#include "libavutil/cpu.h"
+#include "libavutil/ppc/cpu.h"
+#include "libavutil/ppc/util_altivec.h"
+
+#include "libavcodec/lossless_audiodsp.h"
+
+/*
+ * AltiVec scalarproduct_and_madd_int16, restored for big-endian AltiVec after
+ * upstream removed the file (35464ad9ebe1, "remove broken AltiVec acceleration
+ * for lossless audio") because the original was broken. Three defects of the
+ * original are fixed here so this passes checkasm llauddsp bit-exactly:
+ *
+ *   1. The horizontal reduction used vec_sums (vsumsws), which SATURATES, while
+ *      the C reference accumulates an unsigned that wraps mod 2^32. With
+ *      full-range int16 inputs the four lane sums overflow int32 and the
+ *      saturating combine diverged from C (the "fails sporadically" symptom,
+ *      seed-dependent and endian-independent). Reduced here with modular
+ *      vec_add + vec_sld rotates instead.
+ *
+ *   2. The big-endian load prefetched two aligned quadwords ahead
+ *      (vec_ld(32, src)), reading a full 16-byte block past the end of v2/v3
+ *      on the final iteration (the UB/address-sanitizer trigger). Each 16-int16
+ *      window is read here with the standard unaligned_load splice, which never
+ *      touches beyond the aligned block holding the window's last byte.
+ *
+ *   3. A single vec_lvsl derived from v2 was reused to align v3, which is only
+ *      correct when v2 and v3 share the same alignment mod 16. WMA Lossless
+ *      passes prevvalues+recent and lms_updates+recent from two independent
+ *      arrays, so their residues differ; unaligned_load recomputes the permute
+ *      per source here.
+ *
+ * v1 is 16-byte aligned by contract (APE f->coeffs, WMALL DECLARE_ALIGNED(16)
+ * coefs, checkasm LOCAL_ALIGNED_16), so it keeps aligned loads/stores. order is
+ * a multiple of 16 for every real caller (APE filter orders 16/32/64/256/1280,
+ * WMALL FFALIGN(order,16)) and for checkasm (BUF_SIZE 1088), matching the
+ * "multiple of 16, or pad" contract in the header.
+ *
+ * The int32 variant (24-bit WMA Lossless) needs a 32x32->64 widening MAC that
+ * classic AltiVec lacks, so it is deliberately left on the C reference.
+ */
+
+#if HAVE_ALTIVEC && HAVE_BIGENDIAN
+static int32_t scalarproduct_and_madd_int16_altivec(int16_t *v1,
+                                                    const int16_t *v2,
+                                                    const int16_t *v3,
+                                                    int order, int mul)
+{
+    vec_s16 *pv1 = (vec_s16 *) v1;
+    register vec_s16 muls = { mul, mul, mul, mul, mul, mul, mul, mul };
+    vec_s32 res = vec_splat_s32(0);
+    int32_t ires;
+    int i;
+
+    for (i = 0; i < order; i += 16) {
+        vec_s16 i0 = pv1[0];
+        vec_s16 i1 = pv1[1];
+        vec_s16 t0 = (vec_s16) unaligned_load( 0, (const uint8_t *) v2);
+        vec_s16 t1 = (vec_s16) unaligned_load(16, (const uint8_t *) v2);
+        vec_s16 u0 = (vec_s16) unaligned_load( 0, (const uint8_t *) v3);
+        vec_s16 u1 = (vec_s16) unaligned_load(16, (const uint8_t *) v3);
+
+        /* res += v1[k] * v2[k], modular (vmsumshm), matching the C
+         * "unsigned res +=" wrap; i0/i1 are the pre-update v1, read before
+         * the store below exactly as the C reads *v1 before *v1 +=. */
+        res = vec_msum(t0, i0, res);
+        res = vec_msum(t1, i1, res);
+
+        /* v1[k] += mul * v3[k]; vmladduhm keeps the low 16 bits, matching the
+         * int16 truncation of the C store. */
+        pv1[0] = vec_mladd(u0, muls, i0);
+        pv1[1] = vec_mladd(u1, muls, i1);
+
+        pv1 += 2;
+        v2  += 16;
+        v3  += 16;
+    }
+
+    /* modular horizontal sum of the four lanes, then splat so the vec_ste
+     * lane pick is independent of &ires alignment */
+    res = vec_add(res, vec_sld(res, res, 8));
+    res = vec_add(res, vec_sld(res, res, 4));
+    res = vec_splat(res, 0);
+    vec_ste(res, 0, &ires);
+
+    return ires;
+}
+#endif /* HAVE_ALTIVEC && HAVE_BIGENDIAN */
+
+av_cold void ff_llauddsp_init_ppc(LLAudDSPContext *c)
+{
+#if HAVE_ALTIVEC && HAVE_BIGENDIAN
+    if (!PPC_ALTIVEC(av_get_cpu_flags()))
+        return;
+
+    c->scalarproduct_and_madd_int16 = scalarproduct_and_madd_int16_altivec;
+#endif /* HAVE_ALTIVEC && HAVE_BIGENDIAN */
+}
