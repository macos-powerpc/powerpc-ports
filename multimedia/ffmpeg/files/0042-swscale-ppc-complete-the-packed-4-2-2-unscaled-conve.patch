+++ b/libswscale/ppc/yuv2yuv_altivec.c
@@ -55,14 +55,50 @@ static av_always_inline void store16_unaligned(vec_u8 v, uint8_t *p)
     vec_st(tmp1, 0, p);
 }
 
-static int yv12toyuy2_unscaled_altivec(SwsInternal *c, const uint8_t *const src[],
-                                       const int srcStride[], int srcSliceY,
-                                       int srcSliceH, uint8_t *const dstParam[],
-                                       const int dstStride_a[])
+/*
+ * Planar (4:2:0 or 4:2:2) -> packed 4:2:2 unscaled converter, shared by all
+ * four (src, dst byte order) combinations. vertLumPerChroma selects the
+ * vertical chroma layout (2 for yuv420p/yuva420p: chroma lines duplicated
+ * across 2 luma rows; 1 for yuv422p: one chroma line per luma row -- same
+ * meaning as the vertLumPerChroma parameter of yuvPlanartoyuy2_c/touyvy_c in
+ * rgb2rgb_template.c). uyvy selects the packed byte order. Both are
+ * compile-time constants at every call site (the thin wrappers below), so
+ * this being av_always_inline lets the compiler fold away the dead half of
+ * every `uyvy ? : ` branch and the vertLumPerChroma masking, producing the
+ * same specialized code the old hand-duplicated functions had.
+ *
+ * dst/dstStride and the src plane pointers may have ANY byte alignment;
+ * only width % 2 matters (an odd width drops its last luma pixel, matching
+ * the C reference's chromWidth = width >> 1). Every load either recomputes
+ * its own unaligned shift per access (no permute-vector reuse across rows
+ * or stride-separated pointers -- ysrc/usrc/vsrc's alignment mod 16 is not
+ * assumed constant) and only ever touches the aligned words that hold the
+ * bytes actually needed (the second vec_ld of every pair is at
+ * offset + bytes_needed - 1, never a full word past that). Each row picks
+ * an aligned or unaligned-splice store path once, valid for every store in
+ * that row since every store offset within a row is a multiple of 16 (so
+ * dst's 16-byte alignment residue is constant across the whole row).
+ *
+ * Row structure, matching the C reference's per-row byte count exactly
+ * (4 * (width >> 1) bytes, nothing more, nothing less):
+ *   1) main loop, 32 luma pixels (16 chroma samples of each of u/v) per
+ *      iteration while i + 32 <= width;
+ *   2) secondary loop, 8 luma pixels (4 chroma samples each) per iteration
+ *      while i + 8 <= (width & ~1);
+ *   3) scalar tail, one pixel PAIR at a time (0..3 pairs left, since both
+ *      loops above only ever advance i by multiples of 8) for the
+ *      remainder of (width & ~1), written byte-by-byte in the target
+ *      order -- exactly the C reference's per-pair store, nothing wider.
+ */
+static av_always_inline int planar_to_packed422_altivec(SwsInternal *c,
+                                                         const uint8_t *const src[],
+                                                         const int srcStride[],
+                                                         int srcSliceY, int srcSliceH,
+                                                         uint8_t *const dstParam[],
+                                                         const int dstStride_a[],
+                                                         int vertLumPerChroma, int uyvy)
 {
     uint8_t *dst = dstParam[0] + dstStride_a[0] * srcSliceY;
-    // yv12toyuy2(src[0], src[1], src[2], dst, c->opts.src_w, srcSliceH,
-    //            srcStride[0], srcStride[1], dstStride[0]);
     const uint8_t *ysrc   = src[0];
     const uint8_t *usrc   = src[1];
     const uint8_t *vsrc   = src[2];
@@ -71,63 +107,64 @@ static int yv12toyuy2_unscaled_altivec(SwsInternal *c, const uint8_t *const src[
     const int lumStride   = srcStride[0];
     const int chromStride = srcStride[1];
     const int dstStride   = dstStride_a[0];
-    const int vertLumPerChroma       = 2;
     register unsigned int y;
 
-    /* This code assumes:
-     *
-     * 1) width is a multiple of 16
-     * 2) lum & chrom stride are multiples of 8
-     *
-     * dst/dstStride and the src plane pointers may have any alignment --
-     * every load/store below either recomputes its own unaligned-shift
-     * (no reuse of a permute vector across rows or stride-separated
-     * pointers) or takes the aligned fast path per row.
-     */
-
     for (y = 0; y < height; y++) {
         int i;
         const int dst_aligned = !((uintptr_t)dst & 15);
-        for (i = 0; i < width - 31; i += 32) {
-            const unsigned int j          = i >> 1;
-            vector unsigned char v_y1     = unaligned_load(i, ysrc);
-            vector unsigned char v_y2     = unaligned_load(i + 16, ysrc);
-            vector unsigned char v_u      = unaligned_load(j, usrc);
-            vector unsigned char v_v      = unaligned_load(j, vsrc);
-            vector unsigned char v_uv_a   = vec_mergeh(v_u, v_v);
-            vector unsigned char v_uv_b   = vec_mergel(v_u, v_v);
-            vector unsigned char v_yuy2_0 = vec_mergeh(v_y1, v_uv_a);
-            vector unsigned char v_yuy2_1 = vec_mergel(v_y1, v_uv_a);
-            vector unsigned char v_yuy2_2 = vec_mergeh(v_y2, v_uv_b);
-            vector unsigned char v_yuy2_3 = vec_mergel(v_y2, v_uv_b);
+
+        for (i = 0; i + 32 <= width; i += 32) {
+            const unsigned int j        = i >> 1;
+            vector unsigned char v_y1   = unaligned_load(i, ysrc);
+            vector unsigned char v_y2   = unaligned_load(i + 16, ysrc);
+            vector unsigned char v_u    = unaligned_load(j, usrc);
+            vector unsigned char v_v    = unaligned_load(j, vsrc);
+            vector unsigned char v_uv_a = vec_mergeh(v_u, v_v);
+            vector unsigned char v_uv_b = vec_mergel(v_u, v_v);
+            vector unsigned char v_out0 = uyvy ? vec_mergeh(v_uv_a, v_y1) : vec_mergeh(v_y1, v_uv_a);
+            vector unsigned char v_out1 = uyvy ? vec_mergel(v_uv_a, v_y1) : vec_mergel(v_y1, v_uv_a);
+            vector unsigned char v_out2 = uyvy ? vec_mergeh(v_uv_b, v_y2) : vec_mergeh(v_y2, v_uv_b);
+            vector unsigned char v_out3 = uyvy ? vec_mergel(v_uv_b, v_y2) : vec_mergel(v_y2, v_uv_b);
             if (dst_aligned) {
-                vec_st(v_yuy2_0, (i << 1), dst);
-                vec_st(v_yuy2_1, (i << 1) + 16, dst);
-                vec_st(v_yuy2_2, (i << 1) + 32, dst);
-                vec_st(v_yuy2_3, (i << 1) + 48, dst);
+                vec_st(v_out0, (i << 1), dst);
+                vec_st(v_out1, (i << 1) + 16, dst);
+                vec_st(v_out2, (i << 1) + 32, dst);
+                vec_st(v_out3, (i << 1) + 48, dst);
             } else {
-                store16_unaligned(v_yuy2_0, dst + (i << 1));
-                store16_unaligned(v_yuy2_1, dst + (i << 1) + 16);
-                store16_unaligned(v_yuy2_2, dst + (i << 1) + 32);
-                store16_unaligned(v_yuy2_3, dst + (i << 1) + 48);
+                store16_unaligned(v_out0, dst + (i << 1));
+                store16_unaligned(v_out1, dst + (i << 1) + 16);
+                store16_unaligned(v_out2, dst + (i << 1) + 32);
+                store16_unaligned(v_out3, dst + (i << 1) + 48);
             }
         }
-        if (i < width) {
-            const unsigned int j          = i >> 1;
-            vector unsigned char v_y1     = unaligned_load(i, ysrc);
-            vector unsigned char v_u      = vec_perm(vec_ld(j, usrc), vec_ld(j + 7, usrc), vec_lvsl(j, usrc));
-            vector unsigned char v_v      = vec_perm(vec_ld(j, vsrc), vec_ld(j + 7, vsrc), vec_lvsl(j, vsrc));
-            vector unsigned char v_uv_a   = vec_mergeh(v_u, v_v);
-            vector unsigned char v_yuy2_0 = vec_mergeh(v_y1, v_uv_a);
-            vector unsigned char v_yuy2_1 = vec_mergel(v_y1, v_uv_a);
-            if (dst_aligned) {
-                vec_st(v_yuy2_0, (i << 1), dst);
-                vec_st(v_yuy2_1, (i << 1) + 16, dst);
+
+        for (; i + 8 <= (width & ~1); i += 8) {
+            const unsigned int j        = i >> 1;
+            vector unsigned char v_y    = vec_perm(vec_ld(i, ysrc), vec_ld(i + 7, ysrc), vec_lvsl(i, ysrc));
+            vector unsigned char v_u    = vec_perm(vec_ld(j, usrc), vec_ld(j + 3, usrc), vec_lvsl(j, usrc));
+            vector unsigned char v_v    = vec_perm(vec_ld(j, vsrc), vec_ld(j + 3, vsrc), vec_lvsl(j, vsrc));
+            vector unsigned char v_uv   = vec_mergeh(v_u, v_v);
+            vector unsigned char v_out  = uyvy ? vec_mergeh(v_uv, v_y) : vec_mergeh(v_y, v_uv);
+            if (dst_aligned)
+                vec_st(v_out, (i << 1), dst);
+            else
+                store16_unaligned(v_out, dst + (i << 1));
+        }
+
+        for (; i < (width & ~1); i += 2) {
+            const unsigned int j = i >> 1;
+            uint8_t y0 = ysrc[i], y1 = ysrc[i + 1];
+            uint8_t u  = usrc[j], v = vsrc[j];
+            uint8_t *d = dst + (i << 1);
+            if (uyvy) {
+                d[0] = u;  d[1] = y0;
+                d[2] = v;  d[3] = y1;
             } else {
-                store16_unaligned(v_yuy2_0, dst + (i << 1));
-                store16_unaligned(v_yuy2_1, dst + (i << 1) + 16);
+                d[0] = y0; d[1] = u;
+                d[2] = y1; d[3] = v;
             }
         }
+
         if ((y & (vertLumPerChroma - 1)) == vertLumPerChroma - 1) {
             usrc += chromStride;
             vsrc += chromStride;
@@ -139,87 +176,40 @@ static int yv12toyuy2_unscaled_altivec(SwsInternal *c, const uint8_t *const src[
     return srcSliceH;
 }
 
+static int yv12toyuy2_unscaled_altivec(SwsInternal *c, const uint8_t *const src[],
+                                       const int srcStride[], int srcSliceY,
+                                       int srcSliceH, uint8_t *const dstParam[],
+                                       const int dstStride_a[])
+{
+    return planar_to_packed422_altivec(c, src, srcStride, srcSliceY, srcSliceH,
+                                       dstParam, dstStride_a, 2, 0);
+}
+
