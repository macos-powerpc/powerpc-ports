From c71bb44d34f650063bde391ad676e1d6c95dc6e0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 22 Sep 2026 20:01:11 +0000
Subject: [PATCH] swscale/ppc: register the AltiVec horizontal scalers per
 filter size

hLumFilterSize and hChrFilterSize are final by the time ff_sws_init_scale()
runs (initFilter() in utils.c precedes it), and on PPC the filter designer
only produces filterSize 4 (minFilterSize < 5 -> filterAlign 4) or a
multiple of 8 (filterAlign 8), so hyScale/hcScale can be chosen per size
the way the x86 init already does.

Real-hardware checkasm --bench, hscale_*__fs_N rows, six dstW values per
figure (G4: the 2026-09-22 run of the full series on the 9.0.2 port; 970:
the 2026-09-10 and 2026-09-22 runs, fs 4 also the 2026-08 run):

  8-bit hScale_real_altivec (vector paths for 4/8/16, scalar otherwise)
    fs 4        G4 0.86x, 970 0.65-0.97x            -> C
    fs 8        G4 1.39x, 970 1.07-1.42x            -> AltiVec
    fs 16       G4 2.03x, 970 1.42-1.53x            -> AltiVec
    other       its scalar path, 0.82-1.02x on both -> C
  16-bit hScale16To15/16To19_altivec (vector paths for 4 and N*8)
    fs 4        G4 0.79-0.90x (24 rows)             -> C on the G4
                970 1.12-1.96x                      -> AltiVec
    fs N*8      G4 1.5-2.9x, 970 1.7-3.6x           -> AltiVec
    other       its scalar path, 0.97-1.01x on both -> C

filterSize 4 is every upscale on PPC, so the 8-bit fs-4 path was a real
playback loss on both CPUs. The 8-bit kernel is now registered only for
filterSize 8 and 16; the 16-bit kernels for multiples of 8 on every CPU
and additionally for filterSize 4 under _ARCH_PWR4 (970). The losing
paths stay compiled; only their registration is gated, per the series
rule.

checkasm sw_scale sets hLumFilterSize == hChrFilterSize per size and
re-runs ff_sws_init_scale(), so the gated sizes simply drop out of the
hscale rows: 8-bit fs 4/12/32/40 (24 rows) and 16-bit fs 12 (24 rows) on
both CPUs, 16-bit fs 4 (24 rows) on the G4 -> expected pass counts
1350 -> 1302 (970), 1367 -> 1295 (G4).

Registration-only change, not compiled here (user decision 2026-09-22:
no compile step for gate-only patches; the qemu harness says nothing
about real-hardware performance).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 libswscale/ppc/swscale_altivec.c | 53 ++++++++++++++++++++++++++++++--
 1 file changed, 50 insertions(+), 3 deletions(-)

diff --git a/libswscale/ppc/swscale_altivec.c b/libswscale/ppc/swscale_altivec.c
index c2366e05d7..f90e1b3cd2 100644
--- a/libswscale/ppc/swscale_altivec.c
+++ b/libswscale/ppc/swscale_altivec.c
@@ -444,6 +444,24 @@ yuv2plane1_float(yuv2plane1_float_bswap_altivec, uint32_t, BE)
 
 #endif /* HAVE_ALTIVEC */
 
+#if HAVE_ALTIVEC && HAVE_BIGENDIAN
+/* Per-filter-size registration predicates; see the bench table in
+ * ff_sws_init_swscale_ppc(). */
+static int hscale8_use_altivec(int filterSize)
+{
+    return filterSize == 8 || filterSize == 16;
+}
+
+static int hscale16_use_altivec(int filterSize)
+{
+#ifdef _ARCH_PWR4
+    if (filterSize == 4)
+        return 1;
+#endif
+    return filterSize >= 8 && !(filterSize & 7);
+}
+#endif
+
 av_cold void ff_sws_init_swscale_ppc(SwsInternal *c)
 {
 #if HAVE_ALTIVEC
@@ -455,12 +473,41 @@ av_cold void ff_sws_init_swscale_ppc(SwsInternal *c)
     ff_sws_init_yuv2packed422_ppc(c);
 
 #if HAVE_BIGENDIAN
+    /* The horizontal scalers are registered per filter size: hLumFilterSize
+     * and hChrFilterSize are final by the time ff_sws_init_scale() runs
+     * (initFilter() in utils.c precedes it), and on PPC the filter designer
+     * only ever produces filterSize 4 (minFilterSize < 5) or a multiple of 8
+     * (filterAlign 8).  Real-hardware checkasm --bench, hscale_*__fs_N rows,
+     * six dstW values per figure, G4 and 970 (2026-09-22; the
+     * 970 fs_4 figure spans three runs):
+     *
+     *   8-bit hScale_real_altivec (vector paths for 4/8/16, scalar otherwise)
+     *     fs 4        G4 0.86x, 970 0.65-0.97x            -> C
+     *     fs 8        G4 1.39x, 970 1.07-1.42x            -> AltiVec
+     *     fs 16       G4 2.03x, 970 1.42-1.53x            -> AltiVec
+     *     other       its scalar path, 0.82-1.02x on both -> C
+     *   16-bit hScale16To15/16To19_altivec (vector paths for 4 and N*8)
+     *     fs 4        G4 0.79-0.90x (24 rows)             -> C on the G4
+     *                 970 1.12-1.96x                      -> AltiVec
+     *     fs N*8      G4 1.5-2.9x, 970 1.7-3.6x           -> AltiVec
+     *     other       its scalar path, 0.97-1.01x on both -> C
+     *
+     * The losing paths stay compiled; only their registration is gated. */
     if (c->srcBpc == 8 && c->dstBpc <= 14) {
-        c->hyScale = c->hcScale = hScale_real_altivec;
+        if (hscale8_use_altivec(c->hLumFilterSize))
+            c->hyScale = hScale_real_altivec;
+        if (hscale8_use_altivec(c->hChrFilterSize))
+            c->hcScale = hScale_real_altivec;
     }
     if (c->srcBpc != 8) {
-        c->hyScale = c->hcScale = c->dstBpc > 14 ? hScale16To19_altivec
-                                                 : hScale16To15_altivec;
+        void (*hscale16)(SwsInternal *c, int16_t *dst, int dstW,
+                         const uint8_t *src, const int16_t *filter,
+                         const int32_t *filterPos, int filterSize) =
+            c->dstBpc > 14 ? hScale16To19_altivec : hScale16To15_altivec;
+        if (hscale16_use_altivec(c->hLumFilterSize))
+            c->hyScale = hscale16;
+        if (hscale16_use_altivec(c->hChrFilterSize))
+            c->hcScale = hscale16;
     }
     if (!is16BPS(dstFormat) && !isNBPS(dstFormat) && !isSemiPlanarYUV(dstFormat) && !isDataInHighBits(dstFormat) &&
         dstFormat != AV_PIX_FMT_GRAYF32BE && dstFormat != AV_PIX_FMT_GRAYF32LE &&
-- 
