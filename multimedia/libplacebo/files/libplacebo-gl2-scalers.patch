+// Sampleable only. The 32-bit variants are registered first so that LUTs
+// which only need nearest sampling get full precision, and without the
+// linear flag because the GPUs of that era (NV4x/G7x, R5xx) filter 16-bit
+// floats at most.
+static const struct gl_format formats_luminance_float_gl2[] = {
+    {GL_LUMINANCE32F_ARB,       GL_LUMINANCE,       FLT, FMT("luminance32f",       32, FLOAT, S)},
+    {GL_LUMINANCE_ALPHA32F_ARB, GL_LUMINANCE_ALPHA, FLT, FMT("luminance_alpha32f", 32, FLOAT, S)},
+    {GL_LUMINANCE16F_ARB,       GL_LUMINANCE,       FLT, FMT("luminance16f",       16, FLOAT, S|L)},
+    {GL_LUMINANCE_ALPHA16F_ARB, GL_LUMINANCE_ALPHA, FLT, FMT("luminance_alpha16f", 16, FLOAT, S|L)},
+};
+
 // 16-bit floating point texture formats
 static const struct gl_format formats_float16[] = {
     {GL_R16F,           R,     FLT,  FMT("r16f",    16, FLOAT, S|L|F)},
@@ -661,8 +695,11 @@ bool gl_setup_formats(struct pl_gpu_t *gpu)
             if (has_texture_rg) {
                 DO_FORMATS(formats_float32);
             } else {
-                // Only RGB/RGBA float textures
+                // RGB/RGBA float textures
                 DO_FORMATS(formats_float32_gl2);
+                DO_FORMATS(formats_float16_gl2);
+                // 1/2-component float textures through GL_LUMINANCE(_ALPHA)
+                DO_FORMATS(formats_luminance_float_gl2);
                 // Plus vertex-only 1/2 component formats for vertex attributes
                 DO_FORMATS(formats_vertex_gl2_1_2comp);
             }
