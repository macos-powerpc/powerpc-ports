+// 16-bit float RGB/RGBA formats for GL 2.0 (GL_ARB_texture_float), uploaded
+// from 32-bit floats like upstream's rgb16f/rgba16f. Not renderable either.
+static const struct gl_format formats_float16_gl2[] = {
+    {GL_RGB16F,         RGB,   FLT, FMT("rgb16f",  16, FLOAT, S|L)},
+    {GL_RGBA16F,        RGBA,  FLT, FMT("rgba16f", 16, FLOAT, S|L)},
