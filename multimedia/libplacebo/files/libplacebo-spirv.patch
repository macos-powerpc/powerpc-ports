glsl/meson: look up glslang and SPIRV through the default library search

Add libglslang to the glslang dependency list up front, and search for
SPIRV without the static:/dirs: restrictions so it is found from the
MacPorts prefix.

Rebased macports libplacebo-spirv.patch onto v7.387.0 (applies cleanly).

diff --git a/src/glsl/meson.build b/src/glsl/meson.build
index c9a85429..bfd02c7d 100644
--- a/src/glsl/meson.build
+++ b/src/glsl/meson.build
@@ -30,6 +30,7 @@ if glslang_req.auto() and shaderc.found()
 elif not glslang_req.disabled()
 
   glslang_deps = [
+    cxx.find_library('glslang', required: false),
     cxx.find_library('glslang-default-resource-limits', required: false)
   ]
 
@@ -49,7 +50,7 @@ elif not glslang_req.disabled()
     static   = arg[0]
     required = arg[1]
 
-    spirv = cxx.find_library('SPIRV', required: required, static: static, dirs: vulkan_lib_dirs)
+    spirv = cxx.find_library('SPIRV', required: required)
 
     if not spirv.found()
       continue
