+// textureSize() requires GLSL 130. On older targets the texture dimensions
+// are known when the shader is generated, so pass them in as a uniform
+// instead. Returns NULL_IDENT when textureSize() is available.
+static ident_t sh_tex_size_wh(pl_shader sh, int w, int h)
+{
+    if (sh_glsl(sh).version >= 130)
+        return NULL_IDENT;
+
+    return sh_var(sh, (struct pl_shader_var) {
+        .var  = pl_var_vec2("tex_size"),
+        .data = &(float[2]) { w, h },
+    });
