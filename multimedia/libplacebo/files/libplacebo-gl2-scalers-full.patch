+    {GL_LUMINANCE32F_ARB,       GL_LUMINANCE,       FLT, FMT("luminance32f",       32, FLOAT, S)},
+    {GL_LUMINANCE_ALPHA32F_ARB, GL_LUMINANCE_ALPHA, FLT, FMT("luminance_alpha32f", 32, FLOAT, S)},
+    {GL_LUMINANCE16F_ARB,       GL_LUMINANCE,       FLT, FMT("luminance16f",       16, FLOAT, S|L)},
+    {GL_LUMINANCE_ALPHA16F_ARB, GL_LUMINANCE_ALPHA, FLT, FMT("luminance_alpha16f", 16, FLOAT, S|L)},
+};
+
 // 16-bit floating point texture formats
