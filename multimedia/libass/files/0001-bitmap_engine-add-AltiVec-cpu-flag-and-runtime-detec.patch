From 494342ca92afefdd619be7d888a37729def41c95 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 22 Sep 2026 22:48:43 +0000
Subject: [PATCH 1/7] bitmap_engine: add AltiVec cpu flag and runtime detection

Adds ASS_CPU_FLAG_PPC_ALTIVEC under the new ARCH_PPC, the matching
runtime probe (getauxval/elf_aux_info on ELF systems, sysctlbyname on
Darwin, __ALTIVEC__ as a last resort) and a dispatch branch selecting the
_altivec engine.  The whole block is compiled out until a build system
defines ARCH_PPC, which happens once the backend sources are in place.
---
 libass/ass_bitmap_engine.c | 42 ++++++++++++++++++++++++++++++++++++++
 libass/ass_bitmap_engine.h |  2 ++
 2 files changed, 44 insertions(+)

diff --git a/libass/ass_bitmap_engine.c b/libass/ass_bitmap_engine.c
index 847adc4..87979b9 100644
--- a/libass/ass_bitmap_engine.c
+++ b/libass/ass_bitmap_engine.c
@@ -24,6 +24,19 @@
 #include "ass_bitmap_engine.h"
 #include "x86/cpuid.h"
 
+#if CONFIG_ASM && ARCH_PPC
+#if defined(__APPLE__)
+#include <sys/sysctl.h>
+#elif defined(HAVE_GETAUXVAL) || defined(HAVE_ELF_AUX_INFO)
+#include <sys/auxv.h>
+// glibc gets this from <bits/hwcap.h>, but it is a stable kernel ABI
+// constant and other libcs do not necessarily declare it.
+#ifndef PPC_FEATURE_HAS_ALTIVEC
+#define PPC_FEATURE_HAS_ALTIVEC 0x10000000
+#endif
+#endif
+#endif
+
 
 #define RASTERIZER_PROTOTYPES(tile_size, suffix) \
     FillSolidTileFunc     ass_fill_solid_tile     ## tile_size ## _ ## suffix; \
@@ -155,6 +168,29 @@ unsigned ass_get_cpu_flags(unsigned mask)
 
 #if ARCH_AARCH64
     flags = ASS_CPU_FLAG_ARM_NEON;
+#endif
+
+#if CONFIG_ASM && ARCH_PPC
+
+#if defined(__APPLE__)
+    int has_altivec = 0;
+    size_t len = sizeof(has_altivec);
+    if (!sysctlbyname("hw.optional.altivec", &has_altivec, &len, NULL, 0) && has_altivec)
+        flags |= ASS_CPU_FLAG_PPC_ALTIVEC;
+#elif defined(HAVE_GETAUXVAL)
+    if (getauxval(AT_HWCAP) & PPC_FEATURE_HAS_ALTIVEC)
+        flags |= ASS_CPU_FLAG_PPC_ALTIVEC;
+#elif defined(HAVE_ELF_AUX_INFO)
+    unsigned long hwcap = 0;
+    if (!elf_aux_info(AT_HWCAP, &hwcap, sizeof(hwcap)) && (hwcap & PPC_FEATURE_HAS_ALTIVEC))
+        flags |= ASS_CPU_FLAG_PPC_ALTIVEC;
+#elif defined(__ALTIVEC__)
+    // No runtime check available.  This file is not built with -maltivec,
+    // so __ALTIVEC__ can only come from the user's own CFLAGS, in which
+    // case every object may already contain AltiVec code.
+    flags |= ASS_CPU_FLAG_PPC_ALTIVEC;
+#endif
+
 #endif
 
     return flags & mask;
@@ -193,6 +229,12 @@ BitmapEngine ass_bitmap_engine_init(unsigned mask)
         ALL_FUNCTIONS(4, 16, neon)
         return engine;
     }
+#elif ARCH_PPC
+    if (flags & ASS_CPU_FLAG_PPC_ALTIVEC) {
+        ALL_PROTOTYPES(16, altivec)
+        ALL_FUNCTIONS(4, 16, altivec)
+        return engine;
+    }
 #endif
 #endif
 
diff --git a/libass/ass_bitmap_engine.h b/libass/ass_bitmap_engine.h
index 68d7aa8..8da059b 100644
--- a/libass/ass_bitmap_engine.h
+++ b/libass/ass_bitmap_engine.h
@@ -95,6 +95,8 @@ enum {
     ASS_CPU_FLAG_X86_AVX2      = 0x0004,
 #elif ARCH_AARCH64
     ASS_CPU_FLAG_ARM_NEON      = 0x0001,
+#elif ARCH_PPC
+    ASS_CPU_FLAG_PPC_ALTIVEC   = 0x0001,
 #endif
     ASS_CPU_FLAG_ALL           = 0x0FFF,
     ASS_FLAG_LARGE_TILES       = 0x1000,
