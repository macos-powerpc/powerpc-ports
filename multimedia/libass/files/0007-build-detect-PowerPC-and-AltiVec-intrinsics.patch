From e5551e585b1384e01886ed91ef831d36faabf007 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 22 Sep 2026 22:48:44 +0000
Subject: [PATCH 7/7] build: detect PowerPC and AltiVec intrinsics

Enable the backend when the target is big-endian PowerPC and the
compiler accepts <altivec.h> with -maltivec -mabi=altivec.  Only
libass/ppc/*.c get those flags -- in meson through the existing ass_asm
convenience library, in automake through a new one, since that is the
only way to give per-file CFLAGS there -- so the baseline objects stay
free of vector instructions and the library keeps running on PowerPC
CPUs without a vector unit.
---
 configure.ac               | 59 +++++++++++++++++++++++++++++++++++++-
 libass/Makefile_library.am | 15 ++++++++++
 libass/meson.build         | 12 +++++++-
 meson.build                | 46 +++++++++++++++++++++++++++++
 4 files changed, 130 insertions(+), 2 deletions(-)

diff --git a/configure.ac b/configure.ac
index 27676b3..57840e5 100644
--- a/configure.ac
+++ b/configure.ac
@@ -16,7 +16,13 @@ AM_PROG_AS
 AC_CHECK_HEADERS_ONCE([iconv.h])
 
 # Checks for library functions.
-AC_CHECK_FUNCS([strdup strndup])
+AC_CHECK_FUNCS([strdup strndup getauxval elf_aux_info])
+
+# Checks for characteristics of the host.
+# Passing actions keeps this from defining WORDS_BIGENDIAN, which is unused;
+# it is expanded unconditionally so that it is not run inside a shell case.
+AC_C_BIGENDIAN([ass_bigendian=yes], [ass_bigendian=no],
+               [ass_bigendian=no], [ass_bigendian=no])
 
 # Query configuration parameters and set their description
 AC_ARG_ENABLE([test], AS_HELP_STRING([--enable-test],
@@ -287,6 +293,9 @@ AS_IF([test "x$enable_asm" != xno], [
             BITS=64
             BITTYPE=64
         ],
+        [powerpc-*|powerpcle-*|powerpc64-*|powerpc64le-*], [
+            cpu_family="ppc"
+        ],
         [ # default
             AC_MSG_NOTICE([Assembly optimizations are not yet supported on this architecture; disabling.])
         ]
@@ -353,6 +362,49 @@ AS_IF([test "x$enable_asm" != xno], [
                 ]
             )
             can_asm=true
+        ],
+        [ppc], [
+            dnl# The AltiVec backend is plain C with <altivec.h> intrinsics,
+            dnl# but it is written for big-endian PowerPC only.
+            AS_IF([test "x$ass_bigendian" != xyes], [
+                AC_MSG_NOTICE([AltiVec optimizations require a big-endian PowerPC target; disabling.])
+            ], [
+                ALTIVEC_CFLAGS=""
+                AX_CHECK_COMPILE_FLAG([-maltivec],
+                    [ALTIVEC_CFLAGS="$ALTIVEC_CFLAGS -maltivec"])
+                AX_CHECK_COMPILE_FLAG([-mabi=altivec],
+                    [ALTIVEC_CFLAGS="$ALTIVEC_CFLAGS -mabi=altivec"])
+                saved_CFLAGS="$CFLAGS"
+                CFLAGS="$CFLAGS $ALTIVEC_CFLAGS"
+                AC_MSG_CHECKING([for AltiVec intrinsics])
+                AC_COMPILE_IFELSE([
+                    AC_LANG_PROGRAM(
+                        [[#include <altivec.h>]],
+                        [[
+                            unsigned char out@<:@16@:>@ __attribute__((aligned(16)));
+                            __vector unsigned char v =
+                                vec_adds(vec_splat_u8(1), vec_splat_u8(2));
+                            __vector signed short a =
+                                (__vector signed short) vec_mergeh(vec_splat_u8(0), v);
+                            __vector signed int p =
+                                vec_add(vec_mule(a, a), vec_mulo(a, a));
+                            __vector unsigned char r =
+                                (__vector unsigned char) vec_packs(p, p);
+                            r = vec_perm(r, v, vec_lvsl(0, out));
+                            vec_st(r, 0, out);
+                            return out@<:@0@:>@;
+                        ]]
+                    )
+                ], [
+                    AC_MSG_RESULT([yes])
+                    can_asm=true
+                ], [
+                    AC_MSG_RESULT([no])
+                    AC_MSG_WARN([AltiVec intrinsics are not supported; ASM functions are disabled.])
+                    ALTIVEC_CFLAGS=""
+                ])
+                CFLAGS="$saved_CFLAGS"
+            ])
         ]
     )
 ])
@@ -366,6 +418,7 @@ AS_IF([test x"$enable_asm" = xyes && test x"$can_asm" != xtrue], [
 ## Tell Makefiles which assembler and flags to use
 AC_SUBST([ASFLAGS], ["$ASFLAGS"])
 AC_SUBST([AS], ["$AS"])
+AC_SUBST([ALTIVEC_CFLAGS], ["$ALTIVEC_CFLAGS"])
 
 ## Relay package configuration to libass.pc.in
 AS_IF([test "x$enable_shared" != xno], [
@@ -387,6 +440,7 @@ AM_CONDITIONAL([ASM], [test "x$can_asm" = xtrue])
 AM_CONDITIONAL([X86], [test "x$cpu_family" = xx86])
 AM_CONDITIONAL([X86_64], [test "x$cpu_family" = xx86 && test "x$BITS" = x64])
 AM_CONDITIONAL([AARCH64], [test "x$cpu_family" = xaarch64])
+AM_CONDITIONAL([PPC], [test "x$cpu_family" = xppc])
 
 AM_CONDITIONAL([ENABLE_LARGE_TILES], [test "x$enable_large_tiles" = xyes])
 
@@ -413,6 +467,9 @@ AM_COND_IF([ASM], [
     AM_COND_IF([AARCH64], [
         AC_DEFINE(ARCH_AARCH64, 1, [targeting a 64-bit arm host architecture])
     ])
+    AM_COND_IF([PPC], [
+        AC_DEFINE(ARCH_PPC, 1, [targeting a PowerPC host architecture])
+    ])
 ], [
     AC_DEFINE(CONFIG_ASM, 0, [ASM enabled])
 ])
diff --git a/libass/Makefile_library.am b/libass/Makefile_library.am
index ec7bff9..5928828 100644
--- a/libass/Makefile_library.am
+++ b/libass/Makefile_library.am
@@ -48,6 +48,21 @@ libass_libass_internal_la_SOURCES += \
     libass/aarch64/blur.S \
     libass/aarch64/asm.S
 endif
+if PPC
+# A separate convenience library is the only way to compile just these
+# sources with -maltivec: the rest of libass must stay free of vector
+# instructions so it keeps running on PowerPC CPUs without AltiVec.
+noinst_LTLIBRARIES += libass/libass_altivec.la
+libass_libass_altivec_la_SOURCES = \
+    libass/ppc/altivec_utils.h \
+    libass/ppc/rasterizer_altivec.c \
+    libass/ppc/rasterizer_altivec_template.h \
+    libass/ppc/blend_bitmaps_altivec.c \
+    libass/ppc/be_blur_altivec.c \
+    libass/ppc/blur_altivec.c
+libass_libass_altivec_la_CFLAGS = $(AM_CFLAGS) $(ALTIVEC_CFLAGS)
+libass_libass_internal_la_LIBADD = libass/libass_altivec.la
+endif
 endif
 
 if FONTCONFIG
diff --git a/libass/meson.build b/libass/meson.build
index 9eda958..c2bb98e 100644
--- a/libass/meson.build
+++ b/libass/meson.build
@@ -37,6 +37,12 @@ src_aarch64 = files(
     'aarch64/blur.S',
     'aarch64/rasterizer.S',
 )
+src_ppc = files(
+    'ppc/be_blur_altivec.c',
+    'ppc/blend_bitmaps_altivec.c',
+    'ppc/blur_altivec.c',
+    'ppc/rasterizer_altivec.c',
+)
 src_fontconfig = files('ass_fontconfig.c')
 src_directwrite = files('ass_directwrite.c')
 src_coretext = files('ass_coretext.c')
@@ -88,6 +94,8 @@ if enable_asm
         asm_sources = src_x86
     elif generic_cpu_family == 'aarch64'
         asm_sources = src_aarch64
+    elif generic_cpu_family in ['ppc', 'ppc64']
+        asm_sources = src_ppc
     endif
 
     if asm_is_nasm
@@ -97,8 +105,10 @@ if enable_asm
             'ass_asm',
             config_h,
             sources: asm_sources,
-            c_args: asm_args,
+            c_args: asm_args + simd_c_args,
             include_directories: incs,
+            # the AltiVec sources are plain C and include libass headers
+            dependencies: deps,
         )
         libass_link_with += asm_lib
     endif
diff --git a/meson.build b/meson.build
index 91a0435..98f1d5c 100644
--- a/meson.build
+++ b/meson.build
@@ -247,6 +247,9 @@ enable_asm = false
 # used in libass/meson.build
 asm_is_nasm = false
 asm_args = []
+# extra C flags for SIMD sources compiled as C (e.g. AltiVec intrinsics);
+# these must never leak into the baseline objects or checkasm
+simd_c_args = []
 
 # ASM architecture variables
 asm_option = get_option('asm')
@@ -323,6 +326,49 @@ if not asm_option.disabled()
         if host_system == 'darwin'
             asm_args += '-DPREFIX'
         endif
+    elif generic_cpu_family in ['ppc', 'ppc64']
+        # The AltiVec backend is written with <altivec.h> intrinsics and only
+        # the libass/ppc/*.c files are compiled with -maltivec, so the baseline
+        # objects stay usable on PowerPC CPUs without a vector unit.
+        altivec_args = cc.get_supported_arguments(['-maltivec', '-mabi=altivec'])
+        altivec_snippet = '''#include <altivec.h>
+            int probe(unsigned char *out);
+            int probe(unsigned char *out)
+            {
+                __vector unsigned char v = vec_adds(vec_splat_u8(1), vec_splat_u8(2));
+                __vector signed short a =
+                    (__vector signed short) vec_mergeh(vec_splat_u8(0), v);
+                __vector signed int p = vec_add(vec_mule(a, a), vec_mulo(a, a));
+                __vector unsigned char r = (__vector unsigned char) vec_packs(p, p);
+                r = vec_perm(r, v, vec_lvsl(0, out));
+                vec_st(r, 0, out);
+                return out[0];
+            }
+        '''
+        if host_machine.endian() != 'big'
+            warning(
+                'The PowerPC AltiVec backend currently requires a big-endian ' +
+                'target; disabling assembly optimizations.',
+            )
+        elif cc.compiles(
+            altivec_snippet,
+            args: altivec_args,
+            name: 'AltiVec intrinsics',
+        )
+            enable_asm = true
+            conf.set('ARCH_PPC', 1)
+            simd_c_args = altivec_args
+            if cc.has_header_symbol('sys/auxv.h', 'getauxval', args: cc_features)
+                conf.set('HAVE_GETAUXVAL', 1)
+            elif cc.has_header_symbol('sys/auxv.h', 'elf_aux_info', args: cc_features)
+                conf.set('HAVE_ELF_AUX_INFO', 1)
+            endif
+        else
+            warning(
+                'The compiler does not support AltiVec intrinsics; ' +
+                'disabling assembly optimizations.',
+            )
+        endif
     else
         warning(
             'Assembly optimizations are not yet supported for the "@0@" architecture; disabling.'.format(
-- 
2.43.0

