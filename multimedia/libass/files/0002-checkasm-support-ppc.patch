From e178628e7f5f519768455836bd02202d759a9273 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 22 Sep 2026 22:48:43 +0000
Subject: [PATCH 2/7] checkasm: support ppc

Register the AltiVec cpu flag and widen the time base reader from
ARCH_PPC64LE to ARCH_PPC; mfspr 268/269 is equally valid on 32-bit
PowerPC.  No checkasm_checked_call is needed: the backend is generated
by the C compiler, so the generic declare_new/call_new fallback applies.
---
 checkasm/checkasm.c | 2 ++
 checkasm/checkasm.h | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/checkasm/checkasm.c b/checkasm/checkasm.c
index 857938b..a7a0327 100644
--- a/checkasm/checkasm.c
+++ b/checkasm/checkasm.c
@@ -76,6 +76,8 @@ static const struct {
     { "AVX2",               "avx2",      ASS_CPU_FLAG_X86_AVX2 },
 #elif ARCH_AARCH64
     { "NEON",               "neon",      ASS_CPU_FLAG_ARM_NEON },
+#elif ARCH_PPC
+    { "AltiVec",            "altivec",   ASS_CPU_FLAG_PPC_ALTIVEC },
 #endif
     { 0 }
 };
diff --git a/checkasm/checkasm.h b/checkasm/checkasm.h
index 3cd7c24..a6233bd 100644
--- a/checkasm/checkasm.h
+++ b/checkasm/checkasm.h
@@ -156,7 +156,7 @@ static inline uint64_t readtime(void) {
     return cycle_counter;
 }
 #define readtime readtime
-#elif ARCH_PPC64LE
+#elif ARCH_PPC
 static inline uint64_t readtime(void) {
     uint32_t tbu, tbl, temp;
 
