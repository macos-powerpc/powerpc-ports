+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#include "config.h"
+#include "ass_compat.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "ass_utils.h"
+
+#include "altivec_utils.h"
+
+
+#define ALIGNMENT  16
+
+/*
+ * dst of add_bitmaps/imul_bitmaps and both sources of mul_bitmaps may be
+ * unaligned, but vec_st can only write aligned quadwords.  The loops below
+ * therefore iterate over the *aligned* 16-byte blocks covering the row
+ * segment and shift the source into place instead.  Bytes of the first and
+ * last block that fall outside [dst, dst + width) are turned into a no-op by
+ * masking the source to zero there:
+ *   add:  dst + 0                 == dst
+ *   imul: (dst * 255 + 255) >> 8  == dst
+ * For mul_bitmaps, whose dst is aligned but which must write zeros past
+ * width (like the C and NEON versions do), the result is masked instead.
+ *
+ * Rows start aligned and strides are multiples of 16, so rounding the row
+ * segment outwards to block boundaries never leaves the row.
+ */
+
+static inline const uint8_t *align_down(const uint8_t *p)
+{
+    return (const uint8_t *) ((uintptr_t) p & ~(uintptr_t) (ALIGNMENT - 1));
+}
+
+/* The aligned block at a, or zero if it lies entirely outside [lo, end).
+ * Such a block only ever feeds output bytes that are masked away, and
+ * skipping it keeps the loads inside the source bitmap. */
+static inline v_u8 load_block(const uint8_t *a, const uint8_t *lo,
+                              const uint8_t *end)
+{
+    if (a < lo || a >= end)
+        return ass_zero_u8();
+    return vec_ld(0, a);
+}
+
+static inline v_u8 edge_mask(size_t k, size_t chunks, size_t head, size_t tail)
+{
+    if (k == 0)
+        return ass_byte_mask((int) head, chunks == 1 ? (int) tail : ALIGNMENT);
+    if (k + 1 == chunks)
+        return ass_byte_mask(0, (int) tail);
+    return (v_u8) vec_splat_s8(-1);
+}
+
+
+void ass_add_bitmaps_altivec(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                             const uint8_t *restrict src, ptrdiff_t src_stride,
+                             size_t width, size_t height)
+{
+    ASSUME(!(dst_stride % ALIGNMENT));
+    ASSUME(!(src_stride % ALIGNMENT));
+    ASSUME(width > 0 && height > 0);
+
+    size_t head = (uintptr_t) dst & (ALIGNMENT - 1);
+    size_t chunks = (head + width + ALIGNMENT - 1) / ALIGNMENT;
+    size_t tail = head + width - ALIGNMENT * (chunks - 1);
+
+    uint8_t *dp0 = dst - head;
+    const v_u8 perm = vec_lvsl(0, src - head);
+    const uint8_t *sa0 = align_down(src - head);
+    const uint8_t *lo = align_down(src), *end = src + width;
+
+    for (size_t y = 0; y < height; y++) {
+        const uint8_t *sa = sa0;
+        uint8_t *dp = dp0;
+        v_u8 cur = load_block(sa, lo, end);
+        for (size_t k = 0; k < chunks; k++) {
+            v_u8 nxt = load_block(sa + ALIGNMENT, lo, end);
+            v_u8 s = vec_and(vec_perm(cur, nxt, perm),
+                             edge_mask(k, chunks, head, tail));
+            vec_st(vec_adds(vec_ld(0, dp), s), 0, dp);
+            cur = nxt;
+            sa += ALIGNMENT;
+            dp += ALIGNMENT;
+        }
+        dp0 += dst_stride;
+        sa0 += src_stride;
+        lo  += src_stride;
+        end += src_stride;
+    }
+}
+
+void ass_imul_bitmaps_altivec(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                              const uint8_t *restrict src, ptrdiff_t src_stride,
+                              size_t width, size_t height)
+{
+    ASSUME(!(dst_stride % ALIGNMENT));
+    ASSUME(!(src_stride % ALIGNMENT));
+    ASSUME(width > 0 && height > 0);
+
+    size_t head = (uintptr_t) dst & (ALIGNMENT - 1);
+    size_t chunks = (head + width + ALIGNMENT - 1) / ALIGNMENT;
+    size_t tail = head + width - ALIGNMENT * (chunks - 1);
+
+    uint8_t *dp0 = dst - head;
+    const v_u8 perm = vec_lvsl(0, src - head);
+    const uint8_t *sa0 = align_down(src - head);
+    const uint8_t *lo = align_down(src), *end = src + width;
+    const v_u16 bias = vec_splats((unsigned short) 255);
+
+    for (size_t y = 0; y < height; y++) {
+        const uint8_t *sa = sa0;
+        uint8_t *dp = dp0;
+        v_u8 cur = load_block(sa, lo, end);
+        for (size_t k = 0; k < chunks; k++) {
+            v_u8 nxt = load_block(sa + ALIGNMENT, lo, end);
+            v_u8 s = vec_and(vec_perm(cur, nxt, perm),
+                             edge_mask(k, chunks, head, tail));
+            v_u8 n = vec_nor(s, s);  // 255 - src, and 255 (identity) outside
+            v_u8 d = vec_ld(0, dp);
+            v_u16 rl = vec_mladd(ass_unpack_lo_u8(d), ass_unpack_lo_u8(n), bias);
+            v_u16 rh = vec_mladd(ass_unpack_hi_u8(d), ass_unpack_hi_u8(n), bias);
+            vec_st(ass_pack_hi8(rl, rh), 0, dp);
+            cur = nxt;
+            sa += ALIGNMENT;
+            dp += ALIGNMENT;
+        }
+        dp0 += dst_stride;
+        sa0 += src_stride;
+        lo  += src_stride;
+        end += src_stride;
+    }
+}
+
+void ass_mul_bitmaps_altivec(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                             const uint8_t *restrict src1, ptrdiff_t src1_stride,
+                             const uint8_t *restrict src2, ptrdiff_t src2_stride,
+                             size_t width, size_t height)
+{
+    ASSUME(!((uintptr_t) dst % ALIGNMENT) && !(dst_stride % ALIGNMENT));
+    ASSUME(!(src1_stride % ALIGNMENT));
+    ASSUME(!(src2_stride % ALIGNMENT));
+    ASSUME(width > 0 && height > 0);
+
+    size_t chunks = (width + ALIGNMENT - 1) / ALIGNMENT;
+    size_t tail = width - ALIGNMENT * (chunks - 1);
+
+    const v_u8 perm1 = vec_lvsl(0, src1), perm2 = vec_lvsl(0, src2);
+    const uint8_t *sa1 = align_down(src1), *sa2 = align_down(src2);
+    const uint8_t *lo1 = sa1, *end1 = src1 + width;
+    const uint8_t *lo2 = sa2, *end2 = src2 + width;
+    const v_u16 bias = vec_splats((unsigned short) 255);
+
+    for (size_t y = 0; y < height; y++) {
+        const uint8_t *a1 = sa1, *a2 = sa2;
+        uint8_t *dp = dst;
+        v_u8 cur1 = load_block(a1, lo1, end1);
+        v_u8 cur2 = load_block(a2, lo2, end2);
+        for (size_t k = 0; k < chunks; k++) {
+            v_u8 nxt1 = load_block(a1 + ALIGNMENT, lo1, end1);
+            v_u8 nxt2 = load_block(a2 + ALIGNMENT, lo2, end2);
+            v_u8 s1 = vec_perm(cur1, nxt1, perm1);
+            v_u8 s2 = vec_perm(cur2, nxt2, perm2);
+            v_u16 rl = vec_mladd(ass_unpack_lo_u8(s1), ass_unpack_lo_u8(s2), bias);
+            v_u16 rh = vec_mladd(ass_unpack_hi_u8(s1), ass_unpack_hi_u8(s2), bias);
+            v_u8 r = ass_pack_hi8(rl, rh);
+            if (k + 1 == chunks)
+                r = vec_and(r, ass_byte_mask(0, (int) tail));
+            vec_st(r, 0, dp);
+            cur1 = nxt1;
+            cur2 = nxt2;
+            a1 += ALIGNMENT;
+            a2 += ALIGNMENT;
+            dp += ALIGNMENT;
+        }
+        dst  += dst_stride;
+        sa1  += src1_stride;
+        lo1  += src1_stride;
+        end1 += src1_stride;
+        sa2  += src2_stride;
+        lo2  += src2_stride;
+        end2 += src2_stride;
+    }
+}
