backward.hpp: PowerPC Darwin support

1. SignalHandling: take the fault address from srr0 on Apple/PowerPC
   (upstream bombela/backward-cpp commit d1184af).
2. libunwind StackTraceImpl: build Apple's unw_context_t from the signal
   mcontext for 32-bit ppc and resume from the link register on a bad
   function pointer call (replaces bombela/backward-cpp PR #359).

--- contrib/backward-cpp/backward.hpp
+++ contrib/backward-cpp/backward.hpp
@@ -1014,6 +1014,50 @@
       }
       _stacktrace[index] = reinterpret_cast<void *>(ctx.data[16]);
       ++index;
+#elif defined(__APPLE__) && defined(__ppc__)
+      // Apple's libunwind (Mac OS X 10.6; 32-bit PowerPC only) keeps the
+      // register state in an opaque unw_context_t. Its layout for ppc is
+      // defined by unw_getcontext.s and Registers_ppc in Apple's libunwind
+      // source: a Mach ppc_thread_state_t at offset 0, immediately followed
+      // by a ppc_float_state_t (offset 160) and the 32 vector registers
+      // (offset 424). The signal's mcontext carries the very same Mach
+      // structures, so they can be copied over verbatim. The vector
+      // registers play no part in unwinding (and the kernel only saves them
+      // if the thread used AltiVec), so those recorded by unw_getcontext
+      // are left alone.
+      ppc_thread_state_t ss = uctx->uc_mcontext->__ss;
+
+      // libunwind treats the IP of a context as a return address: it looks
+      // up the unwind info of the function containing it and applies the
+      // CFI rows that start before it.
+      if (uctx->uc_mcontext->__es.__exception == 4) {
+        // XNU records the PowerPC exception vector that led to the signal
+        // in the exception state; 4 is the instruction storage interrupt
+        // (vector 0x400, T_INSTRUCTION_ACCESS in osfmk/ppc/exception.h),
+        // raised when the instruction at srr0 could not be fetched: a call
+        // through a bad function pointer. The callee never ran, so the
+        // return address is still in the link register; resume from the
+        // call site in the caller, stepping back into the call instruction
+        // like libunwind itself does with return addresses. (XNU fills
+        // si_addr from the stale data address register for this kind of
+        // fault, so unlike on other architectures srr0 cannot simply be
+        // compared with error_addr().)
+        ss.__srr0 = ss.__lr - 1;
+        _stacktrace[index] = reinterpret_cast<void *>(ss.__srr0);
+      } else {
+        // srr0 is the faulting instruction itself, which has not executed:
+        // report it as is, but move the IP of the context past its first
+        // byte so that a CFI row starting right at srr0 is applied too
+        // (the same adjustment libgcc makes for signal frames).
+        _stacktrace[index] = reinterpret_cast<void *>(ss.__srr0);
+        ss.__srr0 += 1;
+      }
+      ++index;
+
+      unw_getcontext(&ctx);
+      memcpy(&ctx, &ss, sizeof(ss));
+      memcpy(reinterpret_cast<char *>(&ctx) + sizeof(ss),
+             &uctx->uc_mcontext->__fs, sizeof(ppc_float_state_t));
 #elif defined(__APPLE__)
       unw_getcontext(&ctx)
           // TODO: Convert the ucontext_t to libunwind's unw_context_t like
@@ -4227,6 +4271,8 @@
 #elif defined(__mips__)
     error_addr = reinterpret_cast<void *>(
         reinterpret_cast<struct sigcontext *>(&uctx->uc_mcontext)->sc_pc);
+#elif defined(__APPLE__) && defined(__POWERPC__)
+    error_addr = reinterpret_cast<void *>(uctx->uc_mcontext->__ss.__srr0);
 #elif defined(__ppc__) || defined(__powerpc) || defined(__powerpc__) ||        \
     defined(__POWERPC__)
     error_addr = reinterpret_cast<void *>(uctx->uc_mcontext.regs->nip);
