From 0d5c06fd1a854bf42c78d08e7ac54d247ccf554e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 02:53:34 +0000
Subject: [PATCH 22/36] MessageListWidget: fix Qt4 fallback for the
 search-options QAction

The Qt4 branch (QT_VERSION < 5.2.0, no QLineEdit::addAction()) was
mined from v0.6 nearly verbatim, but v0.6's m_searchOptions was a
QToolButton -- a real widget, usable directly in a QHBoxLayout and
with .width()/.setCursor(). v0.7 redesigned it as a QAction (needed
for the Qt5.2+ addAction() call in the sibling branch, and for the
setMenu()/setEnabled() calls elsewhere in this file that now expect a
QAction), which doesn't compile as a layout widget on Qt4 at all
("cannot initialize a parameter of type 'QWidget *' with an lvalue of
type 'QAction *'", plus QAction having neither width() nor
setCursor()).

Fixed by giving the Qt4 branch its own QToolButton that stands in for
m_searchOptions via setDefaultAction() -- the same mechanism
QToolBar::addAction() uses internally, available on Qt4 and Qt5 alike.
It keeps icon/tooltip/enabled state synced with the QAction
automatically (so slotAutoEnableDisableSearch()'s existing
m_searchOptions->setEnabled() call needs no changes to also reach this
button), with the popup menu wired explicitly via setMenu() since
setDefaultAction() alone doesn't guarantee that part.
---
 src/Gui/MessageListWidget.cpp | 20 ++++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/src/Gui/MessageListWidget.cpp b/src/Gui/MessageListWidget.cpp
index 3e976596..53c212b3 100644
--- a/src/Gui/MessageListWidget.cpp
+++ b/src/Gui/MessageListWidget.cpp
@@ -116,18 +116,30 @@ MessageListWidget::MessageListWidget(QWidget *parent) :
         optionsMenu->popup(m_quickSearchText->mapToGlobal(QPoint(0, m_quickSearchText->height())), nullptr);
     });
 #else
+    // Unlike Qt 5.2+'s QLineEdit::addAction(), Qt4 has no way to embed a QAction directly into a
+    // line edit, so m_searchOptions (a QAction, needed for the Qt5 branch above and for the
+    // setMenu()/setEnabled() calls elsewhere in this file) needs a real QToolButton standing in for
+    // it here. QToolButton::setDefaultAction() -- the same mechanism QToolBar::addAction() uses
+    // internally -- keeps the button's icon/tooltip/enabled state (and its popup menu, set below)
+    // synced with m_searchOptions for the lifetime of this widget, so slotAutoEnableDisableSearch()'s
+    // m_searchOptions->setEnabled() call further down needs no changes to reach this button too.
     delete m_quickSearchText->layout();
     QHBoxLayout *hlayout = new QHBoxLayout(m_quickSearchText);
     hlayout->setContentsMargins(0, 0, 0, 0);
-    hlayout->addWidget(m_searchOptions);
+    QToolButton *searchOptionsButton = new QToolButton(m_quickSearchText);
+    searchOptionsButton->setAutoRaise(true);
+    searchOptionsButton->setPopupMode(QToolButton::InstantPopup);
+    searchOptionsButton->setDefaultAction(m_searchOptions);
+    searchOptionsButton->setMenu(m_searchOptions->menu());
+    hlayout->addWidget(searchOptionsButton);
     hlayout->addStretch();
     hlayout->addWidget(m_quickSearchText->clearButton());
     hlayout->activate(); // this processes the layout and ensures the toolbutton has it's final dimensions
     if (qApp->keyboardInputDirection() == Qt::LeftToRight)
-        m_quickSearchText->setTextMargins(m_searchOptions->width(), 0, 0, 0);
+        m_quickSearchText->setTextMargins(searchOptionsButton->width(), 0, 0, 0);
     else // ppl. in N Africa and the middle east write the wrong direction...
-        m_quickSearchText->setTextMargins(0, 0, m_searchOptions->width(), 0);
-    m_searchOptions->setCursor(Qt::ArrowCursor); // inherits I-Beam from lineedit otherwise
+        m_quickSearchText->setTextMargins(0, 0, searchOptionsButton->width(), 0);
+    searchOptionsButton->setCursor(Qt::ArrowCursor); // inherits I-Beam from lineedit otherwise
 #endif
 
     QVBoxLayout *layout = new QVBoxLayout(this);
