+/** @short Handle rowsInserted() of the underlying model while waiting for the top-level message to become available
+
+This is only used for the lazy path in TopLevelMessage::fetchChildren(), where the top-level message part isn't
+available yet at the time it's first requested.
+*/
+void MessageModel::handleTopLevelRowsInserted(const QModelIndex &idx)
+{
+    if (idx == m_message) {
+        disconnect(m_insertRows);
+        Q_ASSERT(m_message.isValid());
+        m_rootPart->m_childrenState = MessagePart::FetchingState::NONE;
+        beginInsertRows(QModelIndex(), 0, 0);
+        m_rootPart->fetchChildren(this);
+        endInsertRows();
+    }
+}
+
 QModelIndex MessageModel::index(int row, int column, const QModelIndex &parent) const
 {
     Q_ASSERT(!parent.isValid() || parent.model() == this);
