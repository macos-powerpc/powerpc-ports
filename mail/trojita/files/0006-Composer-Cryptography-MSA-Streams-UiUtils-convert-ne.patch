+/** @short Tiny helper QObject whose sole purpose is to clear the icon cache when the app is about to quit
+
+Old-style (string-based) connect() cannot target a lambda, so this small private helper stands in for one.
+*/
+class IconCacheClearer : public QObject
+{
+    Q_OBJECT
+public:
+    IconCacheClearer()
+    {
