From 00c4026e0f1674f785025d69130e4c0d229bd2d9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 03:03:18 +0000
Subject: [PATCH 23/36] Qt4Compat: support the empty-argument
 QStringLiteral()/QByteArrayLiteral()

QStringLiteral() (empty parens) is one macro argument that's an empty
token sequence, not zero arguments -- Qt5's real macro handles this
via adjacent string-literal concatenation with a "" prefix, producing
a valid empty literal. Our shim didn't, so QStringLiteral() expanded
to QString::fromUtf8() -- invalid, since fromUtf8()'s first parameter
has no default. Added the same "" prefix trick to both macros.
---
 src/Common/Qt4Compat.h | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/Common/Qt4Compat.h b/src/Common/Qt4Compat.h
index 6e00276b..d7a880fe 100644
--- a/src/Common/Qt4Compat.h
+++ b/src/Common/Qt4Compat.h
@@ -35,8 +35,13 @@ closest Qt4 equivalent here and force-include this header on the Qt4 build only.
 #if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
 #include <QByteArray>
 #include <QString>
-#define QStringLiteral(str) QString::fromUtf8(str)
-#define QByteArrayLiteral(str) QByteArray(str)
+// The "" str prefix mirrors Qt5's real QStringLiteral()/QByteArrayLiteral(), which are defined
+// so that QStringLiteral() (an empty argument, not zero arguments -- the preprocessor treats
+// MACRO() as one empty argument) still expands to a valid empty literal via adjacent
+// string-literal concatenation. Without it, QStringLiteral() would expand to
+// QString::fromUtf8(), which doesn't compile: fromUtf8()'s first parameter has no default.
+#define QStringLiteral(str) QString::fromUtf8("" str)
+#define QByteArrayLiteral(str) QByteArray("" str)
 #endif
 
 #endif // TROJITA_COMMON_QT4COMPAT_H
