index 13ef7ca2..9c271119 100644
--- a/src/Gui/LineEdit.h
+++ b/src/Gui/LineEdit.h
@@ -22,12 +22,12 @@ class LineEdit : public QLineEdit
 public:
     explicit LineEdit(const QString &text, QWidget *parent = 0);
     explicit LineEdit(QWidget *parent = 0);
-#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+#if QT_VERSION < 0x050000
     QToolButton *clearButton();
 #endif
     bool isHistoryEnabled();
     void setHistoryEnabled(bool enabled = true);
-#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+#if QT_VERSION < 0x050000
     virtual QSize sizeHint() const;
 #endif
 
@@ -39,7 +39,7 @@ protected:
     void keyReleaseEvent(QKeyEvent *ke);
 
 private Q_SLOTS:
-#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+#if QT_VERSION < 0x050000
     void updateClearButton(const QString &text);
 #endif
     void learnEntry();
@@ -47,7 +47,7 @@ private Q_SLOTS:
     void doEmitTextEditingFinished();
 
 private:
-#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+#if QT_VERSION < 0x050000
     void init();
     QToolButton *m_clearButton;
 #endif
