From e60b09871bb97e7721698c21298fb3d1e43d80e0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 02:19:13 +0000
Subject: [PATCH 17/36] MessageModel: guard
 layoutAboutToBeChanged/layoutChanged for Qt4

QAbstractItemModel::layoutAboutToBeChanged()/layoutChanged() take no
arguments under Qt4; the (const QList<QPersistentModelIndex> &parents,
LayoutChangeHint hint) overload used here is Qt5-only. Guarded both
emit sites, falling back to the plain no-arg form on Qt4 -- which is
also what every other layoutAboutToBeChanged()/layoutChanged() emit
site in the rest of the codebase already uses (this pair in
MessageModel.cpp, part of the new-in-v0.7 Cryptography model, was the
only place using the Qt5 parents-list overload).

PartWidget.cpp already carried a comment about this exact Qt4/Qt5
signature difference from the earlier connect-conversion pass (on the
connect() side, receiving this same signal) but the corresponding
emit sites here weren't fixed at the time.
---
 src/Cryptography/MessageModel.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/Cryptography/MessageModel.cpp b/src/Cryptography/MessageModel.cpp
index 75d672f1..4dfffa69 100644
--- a/src/Cryptography/MessageModel.cpp
+++ b/src/Cryptography/MessageModel.cpp
@@ -179,7 +179,14 @@ void MessageModel::replaceMeWithSubtree(const QModelIndex &parent, MessagePart *
     Q_ASSERT(it->second->row() == partToReplace->row());
     Q_ASSERT(partToReplace->row() == tree->row());
 
+#if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0)
     emit layoutAboutToBeChanged(QList<QPersistentModelIndex>() << parent);
+#else
+    // QAbstractItemModel::layoutAboutToBeChanged() takes no arguments under Qt4; the
+    // (parents, hint) overload used above is Qt5-only. See PartWidget.cpp's connect to
+    // the sibling layoutChanged() signal for the same note.
+    emit layoutAboutToBeChanged();
+#endif
 
     auto oldIndexes = persistentIndexList();
     auto newIndexes = oldIndexes;
@@ -194,7 +201,11 @@ void MessageModel::replaceMeWithSubtree(const QModelIndex &parent, MessagePart *
     tree->m_parent = part;
     MessagePart::Ptr partGoingAway = std::move(it->second);
     it->second = std::move(tree);
+#if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0)
     emit layoutChanged(QList<QPersistentModelIndex>() << parent);
+#else
+    emit layoutChanged();
+#endif
 
     emit dataChanged(parent, parent);
 
