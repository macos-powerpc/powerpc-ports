From 044e2dd4618a07507d1f0b9cbfec4453567f0c69 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 02:26:17 +0000
Subject: [PATCH 19/36] tests: force QByteArray materialization in the
 cClient() macro

Same QStringBuilder class of bug as the earlier ComposerAttachments.cpp
fix, but hitting via the test macro this time: cClient(data) passes
data straight into QString::fromUtf8(data), and Qt4's QStringBuilder
can't reliably resolve its generic conversion operator to the raw
const char* that overload needs once data is a multi-level builder
chain (e.g. `a + b + c` chained across three QByteArrays) -- confirmed
failing on tests/Utils/LibMailboxSync.cpp's UID SEARCH UID query
builder. cClient() is used with +-concatenated arguments at ~25 call
sites across the test suite; wrapping data in QByteArray(...) inside
the macro itself materializes any such chain once, fixing all of them
at the source instead of patching each call site as it surfaces.
---
 tests/Utils/LibMailboxSync.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/Utils/LibMailboxSync.h b/tests/Utils/LibMailboxSync.h
index 7e19f77b..62d6907f 100644
--- a/tests/Utils/LibMailboxSync.h
+++ b/tests/Utils/LibMailboxSync.h
@@ -163,7 +163,7 @@ char *toString(const NetDataRegexp &x);
 #define cClient(data) \
 { \
     TROJITA_CLIENT_LOOP \
-    QCOMPARE(QString::fromUtf8(SOCK->writtenStuff()), QString::fromUtf8(data));\
+    QCOMPARE(QString::fromUtf8(SOCK->writtenStuff()), QString::fromUtf8(QByteArray(data)));\
 }
 
 // Be careful with this; a QRegExp only supports single-line patterns.
