From a4f0d1f736ecd76c8b81fd06dab304bbdba32ea9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 01:23:21 +0000
Subject: [PATCH 10/36] Qt4 compat: shim QByteArrayLiteral, register
 QMap<QByteArray,QByteArray> metatype

Two gaps the original Phase 2 audit missed, both surfaced by an actual
Qt4 compile:

- QByteArrayLiteral() is Qt5-only, same as QStringLiteral(); add it to
  the existing Qt4Compat.h shim.
- Qt5 auto-derives QMetaType for template containers (QMap<K,V>, etc.)
  of already-registered value types; Qt4 has no such mechanism and
  needs an explicit Q_DECLARE_METATYPE/qRegisterMetaType, same as the
  codebase already does for the sibling QList<QByteArray>. Needed by
  MailboxTree.cpp's QVariant::fromValue(m_bodyFldParam).
---
 src/Common/MetaTypes.cpp | 1 +
 src/Common/MetaTypes.h   | 2 ++
 src/Common/Qt4Compat.h   | 8 +++++---
 3 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/Common/MetaTypes.cpp b/src/Common/MetaTypes.cpp
index 83811be6..7290fe4f 100644
--- a/src/Common/MetaTypes.cpp
+++ b/src/Common/MetaTypes.cpp
@@ -29,6 +29,7 @@ namespace Common {
 void registerMetaTypes()
 {
     qRegisterMetaType<QList<QByteArray>>();
+    qRegisterMetaType<QMap<QByteArray, QByteArray>>();
     qRegisterMetaType<QList<QSslCertificate>>();
     qRegisterMetaType<QList<QSslError>>();
     qRegisterMetaType<QModelIndex>();
diff --git a/src/Common/MetaTypes.h b/src/Common/MetaTypes.h
index ded79114..9d4d4220 100644
--- a/src/Common/MetaTypes.h
+++ b/src/Common/MetaTypes.h
@@ -22,6 +22,7 @@
 #ifndef COMMON_METATYPES_H
 #define COMMON_METATYPES_H
 
+#include <QMap>
 #include <QMetaType>
 #include <QModelIndex>
 #include <QSslCertificate>
@@ -36,6 +37,7 @@ Q_DECLARE_METATYPE(QList<QSslError>)
 #endif
 Q_DECLARE_METATYPE(QModelIndex)
 Q_DECLARE_METATYPE(QList<QByteArray>)
+Q_DECLARE_METATYPE(QMap<QByteArray, QByteArray>)
 Q_DECLARE_METATYPE(Common::ConnectionMethod)
 
 namespace Common {
diff --git a/src/Common/Qt4Compat.h b/src/Common/Qt4Compat.h
index 8ba54a2e..6e00276b 100644
--- a/src/Common/Qt4Compat.h
+++ b/src/Common/Qt4Compat.h
@@ -25,16 +25,18 @@
 
 /** @short Force-included (see CMakeLists.txt) ahead of every Qt4 translation unit
 
-QStringLiteral() is Qt5-only; the whole codebase uses it pervasively as a UTF-8, no-allocation
-string constant. Rather than touching every call site, shim it to the closest Qt4 equivalent
-here and force-include this header on the Qt4 build only.
+QStringLiteral()/QByteArrayLiteral() are Qt5-only; the codebase uses them pervasively as
+no-allocation constant literals. Rather than touching every call site, shim them to the
+closest Qt4 equivalent here and force-include this header on the Qt4 build only.
 */
 
 #include <QtGlobal>
 
 #if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+#include <QByteArray>
 #include <QString>
 #define QStringLiteral(str) QString::fromUtf8(str)
+#define QByteArrayLiteral(str) QByteArray(str)
 #endif
 
 #endif // TROJITA_COMMON_QT4COMPAT_H
