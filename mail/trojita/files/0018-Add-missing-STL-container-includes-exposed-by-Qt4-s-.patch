From 4efd595fa5976211f4ec286fdb95539bb5c22346 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 02:26:11 +0000
Subject: [PATCH 18/36] Add missing STL container includes exposed by Qt4's
 header graph

Same class of bug as MessageModel.h's earlier missing <vector>: each
of these files uses an STL container whose header was only ever
visible via some other header's transitive include on Qt5, and Qt4's
different header graph doesn't happen to provide it:
- src/Gui/EmbeddedWebView.h: std::map, no <map>
- src/Cryptography/GpgMe++.h: std::vector, no <vector>
- src/Imap/Model/ThreadingMsgListModel.cpp: std::vector, no <vector>
- src/UiUtils/PlainTextFormatter.cpp: std::vector, no <vector>
- src/Cryptography/MimeticUtils.cpp: std::list, no <list> (only
  compiled under WITH_MIMETIC, currently off, but fixed proactively
  since real crypto support is a real target, not just disabled for
  convenience)

Found via a project-wide sweep (every std::{map,set,vector,
unordered_map,unordered_set,list,deque,array,stack,queue} usage in
src/ cross-checked against its own and its paired header's includes)
rather than waiting for each to surface as a separate build error.
---
 src/Cryptography/GpgMe++.h               | 1 +
 src/Cryptography/MimeticUtils.cpp        | 1 +
 src/Gui/EmbeddedWebView.h                | 1 +
 src/Imap/Model/ThreadingMsgListModel.cpp | 1 +
 src/UiUtils/PlainTextFormatter.cpp       | 1 +
 5 files changed, 5 insertions(+)

diff --git a/src/Cryptography/GpgMe++.h b/src/Cryptography/GpgMe++.h
index c9611875..125dc2a1 100644
--- a/src/Cryptography/GpgMe++.h
+++ b/src/Cryptography/GpgMe++.h
@@ -25,6 +25,7 @@
 
 #include <future>
 #include <memory>
+#include <vector>
 #include <QDateTime>
 #include <QModelIndex>
 #include "Cryptography/MessagePart.h"
diff --git a/src/Cryptography/MimeticUtils.cpp b/src/Cryptography/MimeticUtils.cpp
index ea58701f..a8028ad3 100644
--- a/src/Cryptography/MimeticUtils.cpp
+++ b/src/Cryptography/MimeticUtils.cpp
@@ -21,6 +21,7 @@
    along with this program.  If not, see <http://www.gnu.org/licenses/>.
 */
 
+#include <list>
 #include <sstream>
 #include <mimetic/mimetic.h>
 #include "Cryptography/MimeticUtils.h"
diff --git a/src/Gui/EmbeddedWebView.h b/src/Gui/EmbeddedWebView.h
index b9a610dc..26dad22a 100644
--- a/src/Gui/EmbeddedWebView.h
+++ b/src/Gui/EmbeddedWebView.h
@@ -22,6 +22,7 @@
 #ifndef EMBEDDEDWEBVIEW_H
 #define EMBEDDEDWEBVIEW_H
 
+#include <map>
 #include <QWebPluginFactory>
 #include <QWebView>
 
diff --git a/src/Imap/Model/ThreadingMsgListModel.cpp b/src/Imap/Model/ThreadingMsgListModel.cpp
index 5e66e1e4..451184d5 100644
--- a/src/Imap/Model/ThreadingMsgListModel.cpp
+++ b/src/Imap/Model/ThreadingMsgListModel.cpp
@@ -22,6 +22,7 @@
 
 #include "ThreadingMsgListModel.h"
 #include <algorithm>
+#include <vector>
 #include <QBuffer>
 #include <QDebug>
 #include "Imap/Tasks/SortTask.h"
diff --git a/src/UiUtils/PlainTextFormatter.cpp b/src/UiUtils/PlainTextFormatter.cpp
index e327de4c..d2a292a4 100644
--- a/src/UiUtils/PlainTextFormatter.cpp
+++ b/src/UiUtils/PlainTextFormatter.cpp
@@ -22,6 +22,7 @@
 */
 
 #include <limits>
+#include <vector>
 #include <QColor>
 #include <QDateTime>
 #include <QFileInfo>
