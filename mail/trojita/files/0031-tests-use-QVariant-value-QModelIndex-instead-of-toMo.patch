From 4e016ca3abdc4ddf0415c770575f138dc3b10423 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 03:33:55 +0000
Subject: [PATCH 31/36] tests: use QVariant::value<QModelIndex>() instead of
 toModelIndex()

Same fix as d66905d7 (SimplePartWidget.cpp), just missed in tests/
because that sweep only searched src/. QVariant::toModelIndex() is
Qt 5.5+ only; .value<QModelIndex>() is the portable equivalent since
QModelIndex has always been a registered metatype. 23 call sites
across the two files, all the same QCOMPARE(...toModelIndex(), ...)
shape. Confirmed via grep across both src/ and tests/ this time that
no instances remain anywhere.
---
 tests/Imap/test_Imap_BodyParts.cpp            |  4 +-
 .../Imap/test_Imap_SelectedMailboxUpdates.cpp | 42 +++++++++----------
 2 files changed, 23 insertions(+), 23 deletions(-)

diff --git a/tests/Imap/test_Imap_BodyParts.cpp b/tests/Imap/test_Imap_BodyParts.cpp
index cf4f0a42..4eb9dd7d 100644
--- a/tests/Imap/test_Imap_BodyParts.cpp
+++ b/tests/Imap/test_Imap_BodyParts.cpp
@@ -275,8 +275,8 @@ void BodyPartsTest::testFetchingRawParts()
     QSignalSpy dataChangedSpy(model, SIGNAL(dataChanged(QModelIndex,QModelIndex)));
 
 #define CHECK_DATACHANGED(ROW, INDEX) \
-    QCOMPARE(dataChangedSpy[ROW][0].toModelIndex(), INDEX); \
-    QCOMPARE(dataChangedSpy[ROW][1].toModelIndex(), INDEX);
+    QCOMPARE(dataChangedSpy[ROW][0].value<QModelIndex>(), INDEX); \
+    QCOMPARE(dataChangedSpy[ROW][1].value<QModelIndex>(), INDEX);
 
     QModelIndex part, rawPart;
     QByteArray fakePartData = "Canary 1";
