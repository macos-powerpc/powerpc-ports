From c159891877398eef1cd58251174d3ffd59692383 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 03:39:08 +0000
Subject: [PATCH 32/36] tests: fix QSKIP() single-argument calls for Qt4

Qt4's QSKIP(statement, mode) requires a second argument (SkipSingle/
SkipAll); Qt5 dropped it, so QSKIP(msg) alone only works there. This
codebase already has the right dual-Qt idiom for it
(test_Composer_Submission.cpp:319-323, pre-existing, untouched by this
series) -- mirrored it for the 5 sites that were still using the
Qt5-only single-argument form (1 in test_Cryptography_MessageModel.cpp,
4 in test_Cryptography_PGP.cpp).

The malformed macro invocation was also the root cause of the
seemingly unrelated "unknown type name TROJITA_HEADLESS_TEST" error
further down in the same MessageModel.cpp file -- once QSKIP's
macro-argument-count error broke the function body's parse, the rest
of the translation unit went with it; no separate fix was needed for
that once QSKIP was corrected.
---
 .../test_Cryptography_MessageModel.cpp           |  4 ++++
 tests/Cryptography/test_Cryptography_PGP.cpp     | 16 ++++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/tests/Cryptography/test_Cryptography_MessageModel.cpp b/tests/Cryptography/test_Cryptography_MessageModel.cpp
index 1a0c3018..736eb9e9 100644
--- a/tests/Cryptography/test_Cryptography_MessageModel.cpp
+++ b/tests/Cryptography/test_Cryptography_MessageModel.cpp
@@ -379,7 +379,11 @@ void CryptographyMessageModelTest::testLocalMimeParsing()
     cEmpty();
     QVERIFY(errorSpy->isEmpty());
 #else
+#if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0)
     QSKIP("Mimetic not available, cannot test LocalMimeMessageParser");
+#else
+    QSKIP("Mimetic not available, cannot test LocalMimeMessageParser", SkipSingle);
+#endif
 #endif
 }
 
diff --git a/tests/Cryptography/test_Cryptography_PGP.cpp b/tests/Cryptography/test_Cryptography_PGP.cpp
index f967d617..aea73bba 100644
--- a/tests/Cryptography/test_Cryptography_PGP.cpp
+++ b/tests/Cryptography/test_Cryptography_PGP.cpp
@@ -137,7 +137,11 @@ void CryptographyPGPTest::testDecryption()
     QCOMPARE(data.child(1, 0).data(Imap::Mailbox::RolePartMimeType).toString(), QLatin1String("application/octet-stream"));
     cEmpty();
 
+#if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0)
     QSKIP("Some tests were skipped because this build doesn't have GpgME++ support");
+#else
+    QSKIP("Some tests were skipped because this build doesn't have GpgME++ support", SkipSingle);
+#endif
 #endif
 }
 
@@ -237,7 +241,11 @@ void CryptographyPGPTest::testDecryptWithoutEnvelope()
     cEmpty();
     QVERIFY(errorSpy->empty());
 #else
+#if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0)
     QSKIP("Cannot test without GpgME++ support");
+#else
+    QSKIP("Cannot test without GpgME++ support", SkipSingle);
+#endif
 #endif
 }
 
@@ -336,7 +344,11 @@ void CryptographyPGPTest::testVerification()
     QCOMPARE(data.child(1, 0).data(Imap::Mailbox::RolePartMimeType).toString(), QLatin1String("application/octet-stream"));
     cEmpty();
 
+#if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0)
     QSKIP("Some tests were skipped because this build doesn't have GpgME++ support");
+#else
+    QSKIP("Some tests were skipped because this build doesn't have GpgME++ support", SkipSingle);
+#endif
 #endif
 }
 
@@ -450,7 +462,11 @@ void CryptographyPGPTest::testMalformed()
 
     cEmpty();
 
+#if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0)
     QSKIP("Some tests were skipped because this build doesn't have GpgME++ support");
+#else
+    QSKIP("Some tests were skipped because this build doesn't have GpgME++ support", SkipSingle);
+#endif
 #endif
 }
 
