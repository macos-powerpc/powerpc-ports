From 8421ac32b232fe7ee38cdd10ecc72d5b92634df4 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 03:43:03 +0000
Subject: [PATCH 34/36] Fix headless_test.h include accidentally landing inside
 #ifdef TROJITA_HAVE_MIMETIC

My own mistake in f6b8e3ed: the #include "Utils/headless_test.h" was
inserted right after LocalMimeParser.h without noticing it sat inside
an #ifdef TROJITA_HAVE_MIMETIC block. With WITH_MIMETIC=OFF (this
build's current config), the whole block -- include and all -- gets
preprocessed away, so TROJITA_HEADLESS_TEST was never actually defined
in this translation unit despite the earlier fix looking complete.
Moved it to the unconditional include section. Checked the other 4
files touched by that same commit -- none of them had their include
land inside a conditional block, only this one.
---
 tests/Cryptography/test_Cryptography_MessageModel.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/Cryptography/test_Cryptography_MessageModel.cpp b/tests/Cryptography/test_Cryptography_MessageModel.cpp
index 736eb9e9..4c4cb9ee 100644
--- a/tests/Cryptography/test_Cryptography_MessageModel.cpp
+++ b/tests/Cryptography/test_Cryptography_MessageModel.cpp
@@ -31,12 +31,12 @@
 #include "Cryptography/MessagePart.h"
 #ifdef TROJITA_HAVE_MIMETIC
 #include "Cryptography/LocalMimeParser.h"
-#include "Utils/headless_test.h"
 #endif
 #include "Imap/data.h"
 #include "Imap/Model/ItemRoles.h"
 #include "Imap/Model/MailboxTree.h"
 #include "Streams/FakeSocket.h"
+#include "Utils/headless_test.h"
 
 /** @short Verify passthrough of existing MIME parts without modifications */
 void CryptographyMessageModelTest::testImapMessageParts()
-- 
