From 542b3beff03639f673551a05c9b2b04f8e0ace14 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 01:30:58 +0000
Subject: [PATCH 11/36] Fix Q_DECLARE_METATYPE macro-comma error for
 QMap<QByteArray,QByteArray>
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Q_DECLARE_METATYPE is a single-argument function-like macro; the
unparenthesized comma inside QMap<QByteArray, QByteArray> split into
two macro arguments, breaking the preprocessor parse for the rest of
the file (cascading into a bogus error on the next Q_DECLARE_METATYPE
line too). Not Qt4-specific — introduced in the previous commit and
would have broken the Qt5 build the same way. Fixed with a typedef,
the standard workaround for this macro limitation.
---
 src/Common/MetaTypes.h | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/Common/MetaTypes.h b/src/Common/MetaTypes.h
index 9d4d4220..8bd9712a 100644
--- a/src/Common/MetaTypes.h
+++ b/src/Common/MetaTypes.h
@@ -37,7 +37,10 @@ Q_DECLARE_METATYPE(QList<QSslError>)
 #endif
 Q_DECLARE_METATYPE(QModelIndex)
 Q_DECLARE_METATYPE(QList<QByteArray>)
-Q_DECLARE_METATYPE(QMap<QByteArray, QByteArray>)
+// Q_DECLARE_METATYPE is a single-argument macro; the unparenthesized comma in
+// QMap<QByteArray, QByteArray> would otherwise split into two macro arguments.
+typedef QMap<QByteArray, QByteArray> ByteArrayMap;
+Q_DECLARE_METATYPE(ByteArrayMap)
 Q_DECLARE_METATYPE(Common::ConnectionMethod)
 
 namespace Common {
-- 
2.43.0

