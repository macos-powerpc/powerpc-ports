From 970e81b14075bd0a9ab68b7cf390f53f8c7a2c60 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 01:51:16 +0000
Subject: [PATCH 12/36] Cryptography: fix Qt4 build of the always-compiled
 MessageModel/MessagePart

src/Cryptography/{MessageModel,MessagePart,PartReplacer}.cpp are added
to libCryptography_SOURCES unconditionally (CMakeLists.txt:362-366),
regardless of WITH_CRYPTO_MESSAGES/WITH_GPGMEPP -- only GpgMe++.cpp
and the Mimetic-based local parser are actually gated. So this model,
which provides the MIME-tree delegate even with crypto verification
compiled out, needs to build on Qt4 too, unlike the rest of the
directory.

Two real gaps:
- MessageModel.h used std::vector without including <vector> (only
  ever visible via a transitive include Qt5's header graph happened
  to pull in; Qt4's doesn't).
- QMetaObject::Connection doesn't exist on Qt4. Replaced storing the
  connection handle with the classic 4-argument disconnect(sender,
  SIGNAL, receiver, SLOT), which is dual-Qt safe by construction and
  needs no #if guard, mirroring how the connect side already uses
  SIGNAL()/SLOT() strings post-Phase-3 conversion.

GpgMe++.h has the same QMetaObject::Connection pattern but is legitimately
out of scope: GpgMe++.cpp only enters the build when WITH_GPGMEPP is ON,
which requires KF5::Gpgmepp (Qt5-tied, per design) and won't be true for
the Qt4 port.
---
 src/Cryptography/MessageModel.cpp | 2 +-
 src/Cryptography/MessageModel.h   | 2 +-
 src/Cryptography/MessagePart.cpp  | 4 ++--
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/Cryptography/MessageModel.cpp b/src/Cryptography/MessageModel.cpp
index 9939f833..75d672f1 100644
--- a/src/Cryptography/MessageModel.cpp
+++ b/src/Cryptography/MessageModel.cpp
@@ -70,7 +70,7 @@ available yet at the time it's first requested.
 void MessageModel::handleTopLevelRowsInserted(const QModelIndex &idx)
 {
     if (idx == m_message) {
-        disconnect(m_insertRows);
+        disconnect(m_message.model(), SIGNAL(rowsInserted(QModelIndex,int,int)), this, SLOT(handleTopLevelRowsInserted(QModelIndex)));
         Q_ASSERT(m_message.isValid());
         m_rootPart->m_childrenState = MessagePart::FetchingState::NONE;
         beginInsertRows(QModelIndex(), 0, 0);
diff --git a/src/Cryptography/MessageModel.h b/src/Cryptography/MessageModel.h
index 45fbd732..4709bcf3 100644
--- a/src/Cryptography/MessageModel.h
+++ b/src/Cryptography/MessageModel.h
@@ -24,6 +24,7 @@
 #ifndef CRYPTOGRAPHY_MESSAGEMODEL_H
 #define CRYPTOGRAPHY_MESSAGEMODEL_H
 
+#include <vector>
 #include <QHash>
 #include <QPersistentModelIndex>
 
@@ -95,7 +96,6 @@ private:
     QHash<QPersistentModelIndex, MessagePart*> m_map;
     MessagePart::Ptr m_rootPart;
     std::vector<std::shared_ptr<PartReplacer>> m_partHandlers;
-    QMetaObject::Connection m_insertRows;
 
     friend class TopLevelMessage;
     friend class ProxyMessagePart;
diff --git a/src/Cryptography/MessagePart.cpp b/src/Cryptography/MessagePart.cpp
index d29fd76e..2fb29092 100644
--- a/src/Cryptography/MessagePart.cpp
+++ b/src/Cryptography/MessagePart.cpp
@@ -181,8 +181,8 @@ void TopLevelMessage::fetchChildren(MessageModel *model)
         } else {
             // The upstream model is loading its stuff, okay, let's do it asynchronously.
             m_childrenState = FetchingState::LOADING;
-            model->m_insertRows = model->connect(model->m_message.model(), SIGNAL(rowsInserted(QModelIndex,int,int)),
-                                                 model, SLOT(handleTopLevelRowsInserted(QModelIndex)));
+            model->connect(model->m_message.model(), SIGNAL(rowsInserted(QModelIndex,int,int)),
+                           model, SLOT(handleTopLevelRowsInserted(QModelIndex)));
         }
     }
 }
