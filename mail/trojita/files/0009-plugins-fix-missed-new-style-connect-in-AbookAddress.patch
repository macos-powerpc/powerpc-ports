From d065cb9625bec831d237f4163284bc15a0a8318e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 01:17:06 +0000
Subject: [PATCH 09/36] plugins: fix missed new-style connect in
 AbookAddressbook
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

connect (m_filesystemWatcher, &QFileSystemWatcher::fileChanged, ...)
was missed by the earlier grep-based sweep because of the space
between "connect" and "(" — caught by an actual Qt4 compile
(fileChanged is a protected signal on QFileSystemWatcher, which the
old-style string macros can still bind to since they bypass normal
C++ access control via moc).
---
 src/Plugins/AbookAddressbook/AbookAddressbook.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/Plugins/AbookAddressbook/AbookAddressbook.cpp b/src/Plugins/AbookAddressbook/AbookAddressbook.cpp
index a1448c24..f803a67b 100644
--- a/src/Plugins/AbookAddressbook/AbookAddressbook.cpp
+++ b/src/Plugins/AbookAddressbook/AbookAddressbook.cpp
@@ -119,7 +119,7 @@ AbookAddressbook::AbookAddressbook(QObject *parent): AddressbookPlugin(parent),
 
     m_filesystemWatcher = new QFileSystemWatcher(this);
     m_filesystemWatcher->addPath(QDir::homePath() + QLatin1String("/.abook/addressbook"));
-    connect (m_filesystemWatcher, &QFileSystemWatcher::fileChanged, this, &AbookAddressbook::scheduleAbookUpdate);
+    connect(m_filesystemWatcher, SIGNAL(fileChanged(QString)), this, SLOT(scheduleAbookUpdate()));
 }
 
 AbookAddressbook::~AbookAddressbook()
