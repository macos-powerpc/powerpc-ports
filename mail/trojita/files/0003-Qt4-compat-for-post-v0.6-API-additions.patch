 src/Common/Qt4Compat.h               | 40 ++++++++++++++++++++++++++++
 src/Composer/ComposerAttachments.cpp |  6 +----
 src/Composer/MessageComposer.cpp     |  6 +----
 src/Gui/AttachmentView.cpp           |  6 +----
 src/Gui/Window.cpp                   | 39 ++++++++++++++++++---------
 src/Gui/Window.h                     |  3 +++
 src/UiUtils/PartWalker_impl.h        |  6 +----
 8 files changed, 81 insertions(+), 32 deletions(-)
 create mode 100644 src/Common/Qt4Compat.h

