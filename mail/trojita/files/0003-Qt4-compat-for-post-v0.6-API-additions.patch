 add_definitions(-DQT_USE_FAST_OPERATOR_PLUS)
 add_definitions(-DQT_USE_FAST_CONCATENATION)
 
+if(NOT WITH_QT5 AND NOT MSVC)
+    # QStringLiteral() is Qt5-only; force-include a one-line shim ahead of every translation
+    # unit instead of touching the (many) call sites, which are meant to stay source-compatible
+    # with Qt5 unchanged.
+    set(CMAKE_CXX_FLAGS "-include ${CMAKE_CURRENT_SOURCE_DIR}/src/Common/Qt4Compat.h ${CMAKE_CXX_FLAGS}")
+endif()
+
