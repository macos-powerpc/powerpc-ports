+void MainWindow::slotLinkHovered(const QString &url)
+{
+    if (url.isEmpty()) {
+        QToolTip::hideText();
+    } else {
+        // indirection due to https://bugs.kde.org/show_bug.cgi?id=363783
+        m_hoveredLink = url;
+        QTimer::singleShot(250, this, SLOT(slotShowHoveredLinkTooltip()));
+    }
+}
+
+void MainWindow::slotShowHoveredLinkTooltip()
+{
+    QToolTip::showText(QCursor::pos(), tr("Link target: %1").arg(UiUtils::Formatting::htmlEscaped(m_hoveredLink)));
+}
