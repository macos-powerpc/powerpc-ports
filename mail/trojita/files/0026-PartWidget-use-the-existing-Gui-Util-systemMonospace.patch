From b2b49c0e8af20101ecd13920fd25bff282673a61 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 03:14:47 +0000
Subject: [PATCH 26/36] PartWidget: use the existing
 Gui::Util::systemMonospaceFont() helper

QFontDatabase::systemFont(QFontDatabase::FixedFont) is Qt 5.2+ only.
Gui::Util::systemMonospaceFont() (src/Gui/Util.cpp) already wraps this
exact call with a working Qt4 fallback and is used everywhere else in
the codebase (ComposerTextEdit.cpp, SettingsDialog.cpp,
SimplePartWidget.cpp) -- this was the one remaining direct call that
bypassed it. Confirmed via grep it's now the only
QFontDatabase::systemFont call left in src/, and that's inside the
helper's own Qt5 branch.
---
 src/Gui/PartWidget.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/Gui/PartWidget.cpp b/src/Gui/PartWidget.cpp
index afa52240..1d3a58b2 100644
--- a/src/Gui/PartWidget.cpp
+++ b/src/Gui/PartWidget.cpp
@@ -193,7 +193,7 @@ PartStatusWidget::PartStatusWidget(QWidget *parent)
     m_details->hide();
 
     m_text->setAlignment(Qt::AlignLeft | Qt::AlignVCenter);
-    m_details->setFont(QFontDatabase::systemFont(QFontDatabase::FixedFont));
+    m_details->setFont(Gui::Util::systemMonospaceFont());
     m_details->setWordWrap(true);
     m_details->setTextInteractionFlags(Qt::TextSelectableByMouse);
 }
