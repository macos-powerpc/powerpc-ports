From 82debad83a61fb0e4295f673fbf878f1aa2c39cf Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 03:26:59 +0000
Subject: [PATCH 29/36] cmake: resolve QtMimeTypes's library via find_library
 instead of pkg-config's bare names

Correction to the previous commit's fix (4ad2cf87): adding a -L search
path for QTMIMETYPES_LIBRARY_DIRS made the bare -lQtCore that
pkg_check_modules() pulls in (via the .pc file's own Requires: on
QtCore) *resolve*, but that link was never actually needed -- Qt4's
own libraries are already linked via the absolute ${QT_QTCORE_LIBRARY}
paths elsewhere in this file. Worse, satisfying the bare name that way
risks silently linking a second, potentially different, copy of
QtCore if it resolves against some other Qt4 install found via that
search path.

Switched to find_library(QTMIMETYPES_LIBRARY NAMES QtMimeTypes HINTS
${QTMIMETYPES_LIBRARY_DIRS}), which always yields a single clean
absolute path to just the QtMimeTypes library itself, sidestepping the
whole bare-name/redundant-Qt-lib problem regardless of how it's found.
Renamed the variable throughout (QTMIMETYPES_LIBRARIES ->
QTMIMETYPES_LIBRARY, singular) so it can't be confused with
pkg_check_modules()'s own same-named output, which is no longer used
for linking at all -- only its include dirs and, as a HINT, its
library search path.
---
 CMakeLists.txt | 26 ++++++++++++--------------
 1 file changed, 12 insertions(+), 14 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index bd1c1326..45b584d7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -115,23 +115,21 @@ else()
     find_package(PkgConfig)
     if(PKG_CONFIG_FOUND)
         pkg_check_modules(QTMIMETYPES QtMimeTypes)
-        if(QTMIMETYPES_FOUND)
-            # pkg_check_modules() only puts bare names (e.g. "QtMimeTypes;QtCore", pulled in via
-            # the .pc file's own Qt dependency) into QTMIMETYPES_LIBRARIES; the matching -L search
-            # path is a separate variable that target_link_libraries() below has no way to see.
-            # Qt4 lives in a non-standard location on this target (MacPorts' qt4-mac), so without
-            # this the linker can't resolve the bare -lQtCore et al. it gets handed.
-            link_directories(${QTMIMETYPES_LIBRARY_DIRS})
-        endif()
     endif()
-    if(NOT QTMIMETYPES_FOUND)
+    if(NOT QTMIMETYPES_INCLUDE_DIRS)
         find_path(QTMIMETYPES_INCLUDE_DIRS NAMES qmimedatabase.h PATH_SUFFIXES QtMimeTypes)
-        find_library(QTMIMETYPES_LIBRARIES NAMES QtMimeTypes)
     endif()
-    if(NOT QTMIMETYPES_INCLUDE_DIRS OR NOT QTMIMETYPES_LIBRARIES)
+    # Resolve the library ourselves rather than trusting pkg_check_modules()'s QTMIMETYPES_LIBRARIES
+    # wholesale: the .pc file's own Qt dependency (its Requires: on QtCore) ends up in there as a
+    # bare "-lQtCore", which is both redundant (Qt4's own libraries are already linked via the
+    # absolute ${QT_QTCORE_LIBRARY} paths below) and risky (a second, potentially different, QtCore
+    # if that bare name happened to resolve against some other Qt4 install on the search path).
+    # find_library() always yields a single clean absolute path to just QtMimeTypes itself.
+    find_library(QTMIMETYPES_LIBRARY NAMES QtMimeTypes HINTS ${QTMIMETYPES_LIBRARY_DIRS})
+    if(NOT QTMIMETYPES_INCLUDE_DIRS OR NOT QTMIMETYPES_LIBRARY)
         message(FATAL_ERROR "QtMimeTypes (port devel/qt4-mimetypes, https://github.com/d1vanov/qt4-mimetypes) is required for the Qt4 build")
     endif()
-    message(STATUS "Found QtMimeTypes (includes at ${QTMIMETYPES_INCLUDE_DIRS}, lib at ${QTMIMETYPES_LIBRARIES})")
+    message(STATUS "Found QtMimeTypes (includes at ${QTMIMETYPES_INCLUDE_DIRS}, lib at ${QTMIMETYPES_LIBRARY})")
     include_directories(${QTMIMETYPES_INCLUDE_DIRS})
 endif()
 
@@ -721,7 +719,7 @@ target_link_libraries(Composer Common MSA Streams UiUtils qwwsmtpclient)
 if(WITH_QT5)
     qt5_use_modules(Composer Gui Network)
 else()
-    target_link_libraries(Composer ${QT_QTCORE_LIBRARY} ${QT_QTGUI_LIBRARY} ${QT_QTNETWORK_LIBRARY} ${QTMIMETYPES_LIBRARIES})
+    target_link_libraries(Composer ${QT_QTCORE_LIBRARY} ${QT_QTGUI_LIBRARY} ${QT_QTNETWORK_LIBRARY} ${QTMIMETYPES_LIBRARY})
 endif()
 
 add_library(Imap STATIC ${libImap_SOURCES})
@@ -861,7 +859,7 @@ if(WITH_DESKTOP)
         qt5_use_modules(DesktopGui Network WebKitWidgets)
         qt5_use_modules(trojita Widgets Network)
     else()
-        target_link_libraries(DesktopGui ${QT_QTCORE_LIBRARY} ${QT_QTGUI_LIBRARY} ${QT_QTNETWORK_LIBRARY} ${QT_QTWEBKIT_LIBRARY} ${QTMIMETYPES_LIBRARIES})
+        target_link_libraries(DesktopGui ${QT_QTCORE_LIBRARY} ${QT_QTGUI_LIBRARY} ${QT_QTNETWORK_LIBRARY} ${QT_QTWEBKIT_LIBRARY} ${QTMIMETYPES_LIBRARY})
         target_link_libraries(trojita ${QT_QTGUI_LIBRARY} ${QT_QTCORE_LIBRARY})
     endif()
 endif()
