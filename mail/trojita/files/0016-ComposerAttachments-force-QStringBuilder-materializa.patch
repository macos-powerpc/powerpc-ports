From 9f46700d544c3a1b518df971e07982b959a73b6b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 02:14:39 +0000
Subject: [PATCH 16/36] ComposerAttachments: force QStringBuilder
 materialization before !=

subject + QLatin1String(".eml") != preferredName doesn't compile on
Qt4: with QT_USE_QSTRINGBUILDER (set globally in CMakeLists.txt), the
concatenation produces a lazy QStringBuilder<QString,QLatin1String>
expression rather than a QString. Qt5's qstringbuilder.h defines
generic operator==/!= for comparing a builder expression directly
against a QString; Qt4's doesn't, so the comparison has no viable
operator. Wrapping the concatenation in QString(...) forces
materialization before the comparison -- works identically on both
Qt versions, just skips the lazy-evaluation optimization for this one
site.

Swept the rest of src/ for the same pattern (a `+` string
concatenation compared inline with == or != without an intervening
QString) -- no other instances found.
---
 src/Composer/ComposerAttachments.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/Composer/ComposerAttachments.cpp b/src/Composer/ComposerAttachments.cpp
index fbdb48bb..ddabec6b 100644
--- a/src/Composer/ComposerAttachments.cpp
+++ b/src/Composer/ComposerAttachments.cpp
@@ -237,7 +237,7 @@ QString ImapMessageAttachmentItem::caption() const
     if (!index.isValid())
         return MessageComposer::tr("Message not available");
     QString subject = index.data(RoleMessageSubject).toString();
-    if (!preferredName.isEmpty() && subject + QLatin1String(".eml") != preferredName) {
+    if (!preferredName.isEmpty() && QString(subject + QLatin1String(".eml")) != preferredName) {
         return MessageComposer::tr("%1\n(%2)").arg(preferredName, subject);
     } else {
         return subject;
