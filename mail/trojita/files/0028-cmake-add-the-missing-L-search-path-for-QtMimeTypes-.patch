From 4ad2cf87953d1f984f9553f6598e0b35622e94b0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 03:24:32 +0000
Subject: [PATCH 28/36] cmake: add the missing -L search path for QtMimeTypes'
 own Qt dependency

pkg_check_modules(QTMIMETYPES QtMimeTypes) puts bare library names
(e.g. "QtMimeTypes;QtCore" -- the .pc file's Qt dependency pulled in
via its own Requires/Libs) into QTMIMETYPES_LIBRARIES; the matching
-L search path lands in the separate QTMIMETYPES_LIBRARY_DIRS
variable, which nothing consumed. Linking failed ("library not found
for -lQtCore") because Qt4 lives in a non-standard location on the
target (MacPorts' qt4-mac, /opt/local/libexec/qt4/lib) with no
standard-path -L flag covering it -- the correct absolute-path
libQtCore.dylib was already on the link line via ${QT_QTCORE_LIBRARY}
elsewhere, but ld fails on the first unresolvable -lQtCore before ever
reaching it. Added link_directories(${QTMIMETYPES_LIBRARY_DIRS}) right
after the pkg-config call, early enough in the file to apply to every
target defined afterward. Only needed for the pkg-config path -- the
find_library() fallback a few lines down already produces an absolute
path in QTMIMETYPES_LIBRARIES, no -L needed there.
---
 CMakeLists.txt | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c6ea8f29..bd1c1326 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -115,6 +115,14 @@ else()
     find_package(PkgConfig)
     if(PKG_CONFIG_FOUND)
         pkg_check_modules(QTMIMETYPES QtMimeTypes)
+        if(QTMIMETYPES_FOUND)
+            # pkg_check_modules() only puts bare names (e.g. "QtMimeTypes;QtCore", pulled in via
+            # the .pc file's own Qt dependency) into QTMIMETYPES_LIBRARIES; the matching -L search
+            # path is a separate variable that target_link_libraries() below has no way to see.
+            # Qt4 lives in a non-standard location on this target (MacPorts' qt4-mac), so without
+            # this the linker can't resolve the bare -lQtCore et al. it gets handed.
+            link_directories(${QTMIMETYPES_LIBRARY_DIRS})
+        endif()
     endif()
     if(NOT QTMIMETYPES_FOUND)
         find_path(QTMIMETYPES_INCLUDE_DIRS NAMES qmimedatabase.h PATH_SUFFIXES QtMimeTypes)
