From 26c0cf6a3c1486c998c09426d2246487ca844391 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 02:07:07 +0000
Subject: [PATCH 14/36] Cryptography: bring GpgMe++ (real crypto verification)
 into Qt4 scope

Corrects a wrong assumption from the previous commit: GpgME++'s actual
C++/Qt bindings are not inherently Qt5-tied. Only the CMake detection
was, since it went through KF5Gpgmepp -- a KDE Frameworks 5 package,
always built against Qt5. Upstream gpgme (not KDE) ships its own
Qt-version-agnostic "Gpgmepp" CMake package and gpgmepp.pc, confirmed
present on the target MacPorts environment.

- CMakeLists.txt: use KF5Gpgmepp on Qt5, upstream Gpgmepp on Qt4; drop
  WITH_QT5 from WITH_CRYPTO_MESSAGES's dependency list. The Qt4-side
  find_package/target names (Gpgmepp::Gpgmepp, Gpgmepp::QGpgme) are a
  best-effort guess pending a real WITH_GPGMEPP=ON Qt4 build to verify
  against -- flagged with comments at both call sites. WITH_GPGMEPP
  stays OFF/AUTO by default so this doesn't affect the build until
  someone opts in.
- GpgMe++.h/.cpp: same QMetaObject::Connection issue as the previous
  MessageModel fix (doesn't exist on Qt4). Replaced the 3 connect/
  disconnect pairs for m_dataChanged with the classic 4-argument
  disconnect(sender, SIGNAL, receiver, SLOT), using the m_sourceIndex
  member (same underlying model as the connect-time sourceItemIndex
  parameter) since no per-connection handle is needed anymore.

Verified the option-dependency cascade itself with a standalone cmake
run of TrojitaOption.cmake against the user's exact flags: unaffected
for the current WITH_GPGMEPP=OFF build, and correctly resolves
WITH_CRYPTO_MESSAGES=AUTO for a hypothetical future Qt4 build with
WITH_MIMETIC=ON WITH_GPGMEPP=ON.
---
 CMakeLists.txt               | 31 ++++++++++++++++++++++++++-----
 src/Cryptography/GpgMe++.cpp | 18 +++++++++---------
 src/Cryptography/GpgMe++.h   |  1 -
 3 files changed, 35 insertions(+), 15 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 95dc18c8..c6ea8f29 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -134,8 +134,22 @@ trojita_plugin_option(WITH_QTKEYCHAIN_PLUGIN "Build Qtkeychain password plugin"
 trojita_find_package(Git "" "" "" "")
 
 trojita_find_package(Mimetic "" "http://www.codesink.org/mimetic_mime_library.html" "C++ MIME Library" "Required for client-side MIME parsing" WITH_MIMETIC)
-trojita_find_package(KF5Gpgmepp "" "https://quickgit.kde.org/?p=gpgmepp.git" "C++ bindings for gpgme" "Needed for encrypted/signed e-mails" WITH_GPGMEPP)
-trojita_option(WITH_CRYPTO_MESSAGES "Enable support for encrypted messages" AUTO "WITH_MIMETIC;WITH_GPGMEPP;WITH_QT5")
+if(WITH_QT5)
+    trojita_find_package(KF5Gpgmepp "" "https://quickgit.kde.org/?p=gpgmepp.git" "C++ bindings for gpgme" "Needed for encrypted/signed e-mails" WITH_GPGMEPP)
+else()
+    # KF5Gpgmepp is a KDE Frameworks 5 package and thus Qt5-only. The C++ bindings
+    # themselves have no such restriction -- upstream gpgme (not KDE) ships its own
+    # CMake package "Gpgmepp" (confirmed as e.g. <prefix>/lib/cmake/Gpgmepp/ on MacPorts,
+    # alongside a gpgmepp.pc) which is Qt-version-agnostic for the plain C++ bindings;
+    # the Qt integration bits used here (QGpgME::QByteArrayDataProvider) come from the
+    # separate qgpgme library, built against whichever Qt version gpgme was configured
+    # for. This has not been exercised against a real Qt4 gpgme install -- WITH_GPGMEPP
+    # stays OFF/AUTO in practice until it has; if the target names below don't match
+    # what your gpgme install exports, adjust them (and the target names used in the
+    # Cryptography target_link_libraries() call further down) accordingly.
+    trojita_find_package(Gpgmepp "" "https://www.gnupg.org/related_software/gpgme/" "C++ bindings for gpgme" "Needed for encrypted/signed e-mails" WITH_GPGMEPP)
+endif()
+trojita_option(WITH_CRYPTO_MESSAGES "Enable support for encrypted messages" AUTO "WITH_MIMETIC;WITH_GPGMEPP")
 
 if(WIN32)
     trojita_find_package(MakeNSIS "" "http://nsis.sourceforge.net" "Nullsoft Scriptable Install System" "Needed for building Windows installer" WITH_NSIS)
@@ -725,10 +739,17 @@ if(WITH_MIMETIC)
 endif()
 if(WITH_CRYPTO_MESSAGES)
   if(WITH_GPGMEPP)
-    if (WIN32)
-      target_link_libraries(Cryptography KF5::Gpgmepp KF5::QGpgme)
+    if(WITH_QT5)
+      if (WIN32)
+        target_link_libraries(Cryptography KF5::Gpgmepp KF5::QGpgme)
+      else()
+        target_link_libraries(Cryptography KF5::Gpgmepp-pthread KF5::QGpgme)
+      endif()
     else()
-      target_link_libraries(Cryptography KF5::Gpgmepp-pthread KF5::QGpgme)
+      # Target names for the non-KF5 upstream Gpgmepp package, mirroring the KF5::
+      # ones above; not yet verified against a real build (see the WITH_GPGMEPP
+      # find_package(Gpgmepp) comment above WITH_CRYPTO_MESSAGES).
+      target_link_libraries(Cryptography Gpgmepp::Gpgmepp Gpgmepp::QGpgme)
     endif()
   endif()
 endif()
