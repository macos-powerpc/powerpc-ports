From 234bea24a7cf0990d431ad38fc68a38b1a1aafe5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 03:03:25 +0000
Subject: [PATCH 24/36] Replace QStringRef convenience methods unavailable on
 Qt4

QStringRef gained a large batch of QString-mirroring convenience
methods (toInt, contains, left/right/mid, etc.) in Qt5; Qt4's is
limited to the original avoid-a-copy basics (comparison, append,
construction, toString/string/position/length). Three real gaps:
- Imap/Model/Model.cpp: .midRef(...).contains(...)
- tests/Imap/test_Imap_Threading.cpp: .midRef(...).toInt()
- tests/Composer/test_Composer_Submission.cpp (EXTRACT_TARILING_NUMBER
  macro, 7 call sites): .leftRef(...).toInt()

Fixed by switching each to the QString-returning form (.mid()/.left())
instead of the QStringRef-returning one -- dual-Qt safe (identical
behavior on Qt5, just gives up the copy-avoidance micro-optimization).

Swept for other .leftRef()/.rightRef()/.midRef() call sites across
src/ and tests/: the remaining ones (comparison operators, .append(),
implicit QStringRef->QString conversion via +) all use QStringRef
functionality that's been present since Qt 4.3, not Qt5-added
convenience methods -- left unchanged.
---
 src/Imap/Model/Model.cpp                    | 2 +-
 tests/Composer/test_Composer_Submission.cpp | 2 +-
 tests/Imap/test_Imap_Threading.cpp          | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/Imap/Model/Model.cpp b/src/Imap/Model/Model.cpp
index 2bf8f300..28a14448 100644
--- a/src/Imap/Model/Model.cpp
+++ b/src/Imap/Model/Model.cpp
@@ -330,7 +330,7 @@ void Model::finalizeList(Parser *parser, TreeItemMailbox *mailboxPtr)
             // rubbish, ignore
             it = listResponses.erase(it);
         } else if (it->mailbox.startsWith(prefix)) {
-            if (!mailboxPtr->separator().isEmpty() && it->mailbox.midRef(prefix.length()).contains(mailboxPtr->separator())) {
+            if (!mailboxPtr->separator().isEmpty() && it->mailbox.mid(prefix.length()).contains(mailboxPtr->separator())) {
                 // This is about a mailbox which is nested deeper beneath the current thing (e.g., we're listing A.B.%,
                 // and the current response is A.B.C.1), so let's assume that it's some else's LIST response.
                 // The separator/delimiter checking is (hopefully) correct -- see https://tools.ietf.org/html/rfc3501#page-70 .
diff --git a/tests/Composer/test_Composer_Submission.cpp b/tests/Composer/test_Composer_Submission.cpp
index 7c26314d..2691356a 100644
--- a/tests/Composer/test_Composer_Submission.cpp
+++ b/tests/Composer/test_Composer_Submission.cpp
@@ -399,7 +399,7 @@ void ComposerSubmissionTest::helperAttachImapMessage(const uint uid)
     bool numberOk = false; \
     QString numericPart = sentSoFar.mid(expected.size()); \
     QCOMPARE(numericPart.right(3), QString::fromUtf8("}\r\n")); \
-    int num = numericPart.leftRef(numericPart.size() - 3).toInt(&numberOk); \
+    int num = numericPart.left(numericPart.size() - 3).toInt(&numberOk); \
     QVERIFY(numberOk); \
     NUM = num; \
 }
diff --git a/tests/Imap/test_Imap_Threading.cpp b/tests/Imap/test_Imap_Threading.cpp
index dc9987c8..43c0d419 100644
--- a/tests/Imap/test_Imap_Threading.cpp
+++ b/tests/Imap/test_Imap_Threading.cpp
@@ -187,7 +187,7 @@ void ImapModelThreadingTest::testThreadDeletionsAdditions()
         } else if (whichOne[0] == QLatin1Char('+')) {
             // New additions. The number specifies the number of new arrivals.
             Q_ASSERT(whichOne.size() > 1);
-            int newArrivals = whichOne.midRef(1).toInt();
+            int newArrivals = whichOne.mid(1).toInt();
             Q_ASSERT(newArrivals > 0);
 
             for (int i = 0; i < newArrivals; ++i) {
