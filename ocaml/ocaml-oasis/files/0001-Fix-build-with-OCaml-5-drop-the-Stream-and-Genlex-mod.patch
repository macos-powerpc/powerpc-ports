+(** Minimal replacement for the [Genlex] module of the standard library, which
+    has been removed in OCaml 5.0. It only provides what OASIS needs: a
+    tokenizer that lexes a whole string at once, keeping track of the line
+    number each token starts on.
+
+    The lexing rules are the ones of [Genlex.make_lexer], restricted to what
+    can appear in the files OASIS parses ('setup.data', 'setup.log', variable
+    expansions and source patterns).
+*)
+module Genlex =
+struct
+
+  type token =
+    | Kwd of string
+    | Ident of string
+    | Int of int
+    | Float of float
+    | String of string
+    | Char of char
+
+
+  (* Raised on a malformed token, replaces [Stream.Error]. *)
+  exception Error of string
+
+
+  let is_blank =
+    function
+      | ' ' | '\n' | '\r' | '\t' | '\026' | '\012' -> true
+      | _ -> false
+
+
+  let is_digit c = c >= '0' && c <= '9'
+
+
+  let is_alpha c =
+    (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c = '_' || c >= '\192'
+
+
+  let is_alphanum c = is_alpha c || is_digit c || c = '\''
+
+
+  let is_symbol =
+    function
+      | '!' | '%' | '&' | '$' | '#' | '+' | '-' | '/' | ':' | '<' | '=' | '>'
+      | '?' | '@' | '\\' | '~' | '^' | '|' | '*' -> true
+      | _ -> false
+
+
+  (** [tokenize_full keywords str] returns the list of tokens of [str], each of
+      them paired with the line number (starting at 1) it begins on.
+  *)
+  let tokenize_full keywords str =
+    let len = String.length str in
+    let pos = ref 0 in
+    let line = ref 1 in
+    let acc = ref [] in
+    let buf = Buffer.create 13 in
+    let error fmt = Printf.ksprintf (fun s -> raise (Error s)) fmt in
+    let peek off =
+      let idx = !pos + off in
+      if idx < len then Some str.[idx] else None
+    in
+    let junk () =
+      if !pos < len then begin
+        if str.[!pos] = '\n' then incr line;
+        incr pos
+      end
+    in
+    let next () =
+      match peek 0 with
+        | Some c -> junk (); c
+        | None -> error "Unexpected end of input"
+    in
+    (* Accumulate in [buf] as long as [f] holds. *)
+    let gather f =
+      Buffer.clear buf;
+      let continue = ref true in
+      while !continue do
+        match peek 0 with
+          | Some c when f c -> Buffer.add_char buf c; junk ()
+          | _ -> continue := false
+      done;
+      Buffer.contents buf
+    in
+    let ident_or_keyword id =
+      if List.mem id keywords then Kwd id else Ident id
+    in
+    let keyword_or_error c =
+      let s = String.make 1 c in
+      if List.mem s keywords then Kwd s
+      else error "Illegal character %s" s
+    in
+    (* Skip a comment, they can be nested. *)
+    let rec comment () =
+      match peek 0, peek 1 with
+        | Some '(', Some '*' -> junk (); junk (); comment (); comment ()
+        | Some '*', Some ')' -> junk (); junk ()
+        | None, _ -> error "Unterminated comment"
+        | Some _, _ -> junk (); comment ()
+    in
+    (* Lex the escape sequence following a '\\'. *)
+    let escape () =
+      match next () with
+        | 'n' -> '\n'
+        | 'r' -> '\r'
+        | 't' -> '\t'
+        | c when is_digit c ->
+          let digit () =
+            match peek 0 with
+              | Some c when is_digit c -> junk (); Char.code c - 48
+              | _ -> error "Invalid decimal escape sequence"
+          in
+          (* Beware: OCaml does not specify the evaluation order of
+             arguments, force it with let bindings. *)
+          let d2 = digit () in
+          let d3 = digit () in
+          let n = ((Char.code c - 48) * 100) + (d2 * 10) + d3 in
+          if n > 255 then error "Invalid decimal escape sequence \\%d" n;
+          Char.chr n
+        | c -> c
+    in
+    let string_literal () =
+      Buffer.clear buf;
+      let continue = ref true in
+      while !continue do
+        match peek 0 with
+          | Some '"' -> junk (); continue := false
+          | Some '\\' -> junk (); Buffer.add_char buf (escape ())
+          | Some c -> junk (); Buffer.add_char buf c
+          | None -> error "Unterminated string"
+      done;
+      Buffer.contents buf
+    in
+    let char_literal () =
+      let c =
+        match peek 0 with
+          | Some '\\' -> junk (); escape ()
+          | Some c -> junk (); c
+          | None -> error "Unterminated character literal"
+      in
+      if peek 0 <> Some '\'' then error "Unterminated character literal";
+      junk ();
+      c
+    in
+    (* Lex a number, [prefix] holds the already consumed '-' if any. *)
+    let number prefix =
+      let integer = prefix ^ gather is_digit in
+      let fractional =
+        if peek 0 = Some '.' then begin
+          junk ();
+          "." ^ gather is_digit
+        end else begin
+          ""
+        end
+      in
+      let exponent =
+        match peek 0 with
+          | Some ('e' | 'E') ->
+            junk ();
+            let sign =
+              match peek 0 with
+                | Some ('+' | '-' as c) -> junk (); String.make 1 c
+                | _ -> ""
+            in
+            "e" ^ sign ^ gather is_digit
+          | _ -> ""
+      in
+      let s = integer ^ fractional ^ exponent in
+      if fractional = "" && exponent = "" then begin
+        try Int (int_of_string s) with Failure _ -> error "Invalid integer %s" s
+      end else begin
+        try Float (float_of_string s)
+        with Failure _ -> error "Invalid float %s" s
+      end
+    in
+    while !pos < len do
+      let start_line = !line in
+      let tok =
+        match str.[!pos] with
+          | c when is_blank c -> junk (); None
+          | '(' when peek 1 = Some '*' -> junk (); junk (); comment (); None
+          | '"' -> junk (); Some (String (string_literal ()))
+          | '\'' -> junk (); Some (Char (char_literal ()))
+          | c when is_digit c -> Some (number "")
+          | '-' when (match peek 1 with Some c -> is_digit c | None -> false) ->
+            junk (); Some (number "-")
+          | c when is_alpha c -> Some (ident_or_keyword (gather is_alphanum))
+          | c when is_symbol c -> Some (ident_or_keyword (gather is_symbol))
+          | c -> junk (); Some (keyword_or_error c)
+      in
+      match tok with
+        | Some tok -> acc := (tok, start_line) :: !acc
+        | None -> ()
+    done;
+    List.rev !acc
+
+
+  (** See {!tokenize_full}, without the line numbers. *)
+  let tokenize keywords str = List.map fst (tokenize_full keywords str)
+
+end
+
+
