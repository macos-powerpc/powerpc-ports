PortSystem          1.0
PortGroup           github 1.0
PortGroup           ocaml 1.1

name                ocaml-cstruct
github.setup        mirage ${name} 6.3.0 v
revision            0
categories          ocaml devel lang
license             ISC
maintainers         {landonf @landonf} openmaintainer

description         Access C-like structures directly from OCaml
long_description    Cstruct is a library and syntax extension to make it \
                    easier to access C-like structures directly from OCaml. \
                    It supports both reading and writing to these structures, \
                    and they are accessed via the Bigarray module.

use_bzip2           yes
extract.suffix      .tbz

distname            cstruct-${version}
checksums           rmd160  6af74f793470f1b4771e9d6b44f570518cb5c897 \
                    sha256  956b249ddfb55fd23584c1767af28f6487033d364888217a14275d898ebd7754 \
                    size    242601
github.tarball_from releases

# Does it actually need bigarray-compat?
depends_lib-append  port:ocaml-bigarray-compat \
                    port:ocaml-fmt

subport ${name}-async {
    depends_lib     port:ocaml-async \
                    port:ocaml-async_unix \
                    port:ocaml-core \
                    port:ocaml-cstruct
}

subport ${name}-lwt {
    depends_lib     port:ocaml-cstruct \
                    port:ocaml-lwt
}

ocaml.build_type    dune
