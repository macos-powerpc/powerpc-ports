Pass string positions as offsets in the text editor's Line::insert and Line::erase.

LineIterator holds std::string::const_iterator members. With the old libstdc++
ABI (_GLIBCXX_USE_CXX11_ABI=0) std::string is the copy-on-write implementation,
whose insert and erase only take a mutable iterator as position, so GCC rejects
the calls:

  error: no matching function for call to 'std::basic_string<char>::insert(
  hex::ui::strConstIter&, hex::ui::strConstIter&, hex::ui::strConstIter&)'

Compute the offset from cbegin(), which does not unshare a copy-on-write string,
and use begin() + offset for insert and the (pos, n) overload of erase. The same
code is valid with the C++11 ABI, so nothing changes otherwise.

diff --git a/plugins/ui/source/ui/text_editor/support.cpp b/plugins/ui/source/ui/text_editor/support.cpp
index 7f5f188..8fa46d7 100644
--- a/plugins/ui/source/ui/text_editor/support.cpp
+++ b/plugins/ui/source/ui/text_editor/support.cpp
@@ -399,18 +399,23 @@ namespace hex::ui {
         if (iter == end())
             append(beginLine, endLine);
         else {
-            m_chars.insert(iter.m_charsIter, beginLine.m_charsIter, endLine.m_charsIter);
-            m_colors.insert(iter.m_colorsIter, beginLine.m_colorsIter, endLine.m_colorsIter);
-            m_flags.insert(iter.m_flagsIter, beginLine.m_flagsIter, endLine.m_flagsIter);
+            // Positions as offsets: the copy-on-write std::string of the old libstdc++ ABI
+            // only takes a mutable iterator as insert position.
+            const auto charsPos = iter.m_charsIter - m_chars.cbegin();
+            const auto colorsPos = iter.m_colorsIter - m_colors.cbegin();
+            const auto flagsPos = iter.m_flagsIter - m_flags.cbegin();
+            m_chars.insert(m_chars.begin() + charsPos, beginLine.m_charsIter, endLine.m_charsIter);
+            m_colors.insert(m_colors.begin() + colorsPos, beginLine.m_colorsIter, endLine.m_colorsIter);
+            m_flags.insert(m_flags.begin() + flagsPos, beginLine.m_flagsIter, endLine.m_flagsIter);
             m_colorized = false;
             m_lineMaxColumn = -1;
         }
     }
 
     void Line::erase(LineIterator begin) {
-        m_chars.erase(begin.m_charsIter);
-        m_colors.erase(begin.m_colorsIter);
-        m_flags.erase(begin.m_flagsIter);
+        m_chars.erase(begin.m_charsIter - m_chars.cbegin(), 1);
+        m_colors.erase(begin.m_colorsIter - m_colors.cbegin(), 1);
+        m_flags.erase(begin.m_flagsIter - m_flags.cbegin(), 1);
         m_colorized = false;
         m_lineMaxColumn = -1;
     }
@@ -420,9 +425,9 @@ namespace hex::ui {
             count = m_chars.size() - (begin.m_charsIter - m_chars.begin());
         else
             count = std::min(count, (u64) (m_chars.size() - (begin.m_charsIter - m_chars.begin())));
-        m_chars.erase(begin.m_charsIter, begin.m_charsIter + count);
-        m_colors.erase(begin.m_colorsIter, begin.m_colorsIter + count);
-        m_flags.erase(begin.m_flagsIter, begin.m_flagsIter + count);
+        m_chars.erase(begin.m_charsIter - m_chars.cbegin(), count);
+        m_colors.erase(begin.m_colorsIter - m_colors.cbegin(), count);
+        m_flags.erase(begin.m_flagsIter - m_flags.cbegin(), count);
         m_colorized = false;
         m_lineMaxColumn = -1;
     }
