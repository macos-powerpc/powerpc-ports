Drop constexpr from ASTNode's defaulted constructor, destructor and copy
constructor in the pattern language.

ASTNode has a std::string member. With the old libstdc++ ABI
(_GLIBCXX_USE_CXX11_ABI=0) std::string is the copy-on-write implementation,
whose constructors and destructor are not constexpr, so GCC rejects the
explicitly defaulted members:

  error: explicitly defaulted function 'constexpr pl::core::ast::ASTNode::ASTNode()'
  cannot be declared 'constexpr' because the implicit declaration is not 'constexpr'

ASTNode is polymorphic and is never constructed in a constant expression,
so removing constexpr changes nothing else.

diff --git a/lib/external/pattern_language/lib/include/pl/core/ast/ast_node.hpp b/lib/external/pattern_language/lib/include/pl/core/ast/ast_node.hpp
index e7e0703..2a8b3ee 100644
--- a/lib/external/pattern_language/lib/include/pl/core/ast/ast_node.hpp
+++ b/lib/external/pattern_language/lib/include/pl/core/ast/ast_node.hpp
@@ -20,9 +20,9 @@ namespace pl::core::ast {
     public:
         using FunctionResult = std::optional<Token::Literal>;
 
-        constexpr ASTNode() = default;
-        constexpr virtual ~ASTNode() = default;
-        constexpr ASTNode(const ASTNode &) = default;
+        ASTNode() = default;
+        virtual ~ASTNode() = default;
+        ASTNode(const ASTNode &) = default;
 
         [[nodiscard]] const Location& getLocation() const;
         void setLocation(const Location &location);
