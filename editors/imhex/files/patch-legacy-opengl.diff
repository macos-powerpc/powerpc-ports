 #endif
 
 #include <stdlib.h>
+// IMHEX PATCH BEGIN
+#include <stdio.h>
+// IMHEX PATCH END
 
 #define ARRAY_SIZE(x)  (sizeof(x) / sizeof((x)[0]))
 
@@ -6475,10 +6478,23 @@ static int parse_version(void)
 {
     if (!glGetIntegerv)
         return GL3W_ERROR_INIT;
+    // IMHEX PATCH BEGIN
+    version.major = 0;
+    version.minor = 0;
+    // IMHEX PATCH END
     glGetIntegerv(GL_MAJOR_VERSION, &version.major);
     glGetIntegerv(GL_MINOR_VERSION, &version.minor);
-    if (version.major < 3)
+    // IMHEX PATCH BEGIN
+    // Desktop GL 2.x has no GL_MAJOR_VERSION / GL_MINOR_VERSION queries, the GL_VERSION string starts with "<major>.<minor>" instead
+    if (version.major == 0 && version.minor == 0 && glGetString)
+    {
+        const char *gl_version = (const char *)glGetString(GL_VERSION);
+        if (gl_version)
+            sscanf(gl_version, "%d.%d", &version.major, &version.minor);
+    }
+    if (version.major < 2)
         return GL3W_ERROR_OPENGL_VERSION;
+    // IMHEX PATCH END
     return GL3W_OK;
 }
 
@@ -6507,8 +6523,10 @@ void imgl3wShutdown(void)
 
 int imgl3wIsSupported(int major, int minor)
 {
-    if (major < 3)
+    // IMHEX PATCH BEGIN
+    if (major < 2)
         return 0;
+    // IMHEX PATCH END
     if (version.major == major)
         return version.minor >= minor;
     return version.major >= major;
