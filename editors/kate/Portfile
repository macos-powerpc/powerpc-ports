# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1
PortGroup           qt4 1.0

# Kate 4.14 (the last Qt 4 based Kate) built against plain Qt 4, without
# kdelibs, kdeinit, D-Bus or X11: Kate.app (the MDI editor) and KWrite.app.
name                kate
set upstream_ver    4.14.3
set patch_level     2
# Sources: branch qt4-pure of the fork below (KDE/kate with its full history;
# the KDE/4.14 branch head f17e4c99 plus the port's commits), fetched as
# GitHub's archive of a tag, or of a commit hash while a fix is iterated
# before tagging. packaging/macports/sync-port.sh in the tree writes the
# github.setup, version, revision and checksums lines (see BUILDING-QT4.md).
github.setup        barracuda156 kate-qt4 ${upstream_ver}.qt4.${patch_level} v
# Temporary mismatch with patch_level intended:
version             ${upstream_ver}.1
revision            0
epoch               1
categories          editors aqua
license             {LGPL-2+ GPL-2+}
maintainers         nomaintainer
description         Kate and KWrite text editors built on plain Qt 4, without KDE libraries
long_description    Kate is the KDE advanced text editor: multiple documents and views, \
                    sessions, a document tree, syntax highlighting for hundreds of \
                    languages, code folding, vi mode and scripting. KWrite is its \
                    single-document shell. This port builds the Kate 4.14 code base \
                    against Qt 4 only: the kdelibs pieces it needs are replaced by \
                    a small in-tree compatibility layer, so there is no kdelibs, kdeinit, \
                    ksycoca, D-Bus or X11 dependency. Installs Kate.app and KWrite.app, \
                    with the current upstream set of syntax highlighting definitions \
                    and the multi-file search plugin.
homepage            https://kate-editor.org

checksums           rmd160  29b91a53722469b8280e2f650c299ed5271c4cc6 \
                    sha256  3770c4bdcb220d00a8b49f70d16cb6a3279a8831f83d3cedf1bd59f8784c981f \
                    size    6066345
github.tarball_from archive

# Perl and Python 3 run upstream's generators for the derived syntax
# highlighting definitions (part/syntax/generators) at build time
set python_branch   3.14
depends_build-append \
                    port:makeicns \
                    path:bin/perl:perl5 \
                    port:python[string map {. {}} ${python_branch}]

# pcre2 is the regular expression engine of syntax highlighting and search
depends_lib-append  port:bzip2 \
                    port:pcre2 \
                    port:zlib

# Kate 4.14 is C++98 code; DO NOT require C++11 here.

configure.args-append \
                    -DBUILD_TESTING=OFF \
                    -DKATE_BUILD_ADDONS=ON \
                    -DKATE_BUILD_KATE=ON \
                    -DKATE_BUILD_KWRITE=ON \
                    -DKATE_INSTALL_BUNDLE_DIR=${applications_dir} \
                    -DPERL_EXECUTABLE=${prefix}/bin/perl5 \
                    -DPYTHON_EXECUTABLE=${prefix}/bin/python${python_branch}

# qt4-mac may be installed in concurrent mode under ${prefix}/libexec/qt4
configure.args-append \
                    -DQT_QMAKE_EXECUTABLE=${qt_qmake_cmd}

livecheck.type      none
