+void KWriteApp::openRequestedUrl(const QUrl &url)
+{
+  if (url.isEmpty())
+    return;
+
+  KWrite *window = qobject_cast<KWrite*>(activeWindow());
+  if (!window)
+    window = new KWrite();
+
+  // KWrite::slotOpen() reuses the window when its document is untouched
+  window->slotOpen(KUrl(url));
+}
+
 KWriteApp::~KWriteApp()
 {
