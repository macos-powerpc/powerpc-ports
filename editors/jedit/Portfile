PortSystem              1.0
PortGroup               app 1.0

name                    jedit
version                 5.7.0
revision                1
categories              editors java
license                 GPL-2+
maintainers             nomaintainer
description             Programmer's text editor
long_description        jEdit is an extensible Java text editor with syntax highlighting, macros and plugins.
homepage                https://www.jedit.org/
supported_archs         noarch

master_sites            sourceforge:project/jedit/jedit/${version}:source \
                        https://repo.maven.apache.org/maven2/com/google/code/findbugs/jsr305/3.0.2/:annotations
distfiles               jedit${version}source.tar.bz2:source \
                        jsr305-3.0.2.jar:annotations
checksums               jedit5.7.0source.tar.bz2 \
                        rmd160 c4cb604cfb1026f9838ca00ea290d06d492c287b \
                        sha256 8e71e9fbd5e535e6164d57545f7490d3b351eac7cec6041bee14b4fc3baffdc5 \
                        size 2633539 \
                        jsr305-3.0.2.jar \
                        rmd160 ccc0324a502bf85b0de0b83777da8be3ef6f31a6 \
                        sha256 766ad2a0783f2687962c8ad74ceecc38a28b9f72a2d085ee438b7813e928d0c7 \
                        size 19936
extract.only            jedit${version}source.tar.bz2
use_bzip2               yes
worksrcdir              jEdit
use_configure           no

depends_build           port:apache-ant
# Use the same JDK for compilation and the installed launcher.
depends_lib             port:openjdk25-powerpc
set java_home           ${prefix}/Library/Java/JavaVirtualMachines/openjdk25-powerpc.jdk/Contents/Home

post-extract {
    copy ${filespath}/build-port.xml ${worksrcpath}/build-port.xml
    copy ${distpath}/jsr305-3.0.2.jar ${worksrcpath}/annotations.jar
}
build.cmd               ${prefix}/bin/ant
build.args              -f build-port.xml
build.target            build
build.env               JAVA_HOME=${java_home}
use_parallel_build      no

app.name                jEdit
app.executable          ${workpath}/jedit-app
app.icon                icons/icon.icns
app.identifier          org.jedit.jEdit

pre-destroot {
    copy ${filespath}/jedit-app ${workpath}/jedit-app
    reinplace "s|@PREFIX@|${prefix}|g" ${workpath}/jedit-app
}

destroot {
    xinstall -d ${destroot}${prefix}/share/java/jedit
    copy {*}[glob ${worksrcpath}/build/port/*] ${destroot}${prefix}/share/java/jedit
    xinstall -m 755 ${filespath}/jedit ${destroot}${prefix}/bin/jedit
    reinplace "s|@JAVA_HOME@|${java_home}|g" ${destroot}${prefix}/bin/jedit
    reinplace "s|@PREFIX@|${prefix}|g" ${destroot}${prefix}/bin/jedit
    xinstall -d ${destroot}${prefix}/share/doc/jedit
    xinstall -m 644 ${worksrcpath}/doc/COPYING.txt ${destroot}${prefix}/share/doc/jedit
}
