From 58cbc701c0df2cb9b40b1afd678c40bb9380d1ed Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 23 Aug 2026 06:30:33 +0000
Subject: [PATCH 2/2] qt-types-gen.py: Guard initializer_list ctor generation
 for Qt5+

QMap/QList gained std::initializer_list constructors only in Qt 5.1,
so the generated fake types (e.g. AddressingNormalizationMap) fail to
compile under Qt4 with "no matching function for call to QMap::QMap".

Introduced by c5fad064 alongside the Qt5-only build, uncovered while
restoring Qt4 support for 0.9.8.
---
 tools/qt-types-gen.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tools/qt-types-gen.py b/tools/qt-types-gen.py
index 6df92bdd..6ee697ab 100644
--- a/tools/qt-types-gen.py
+++ b/tools/qt-types-gen.py
@@ -561,7 +561,9 @@ struct %(visibility)s %(fake)s : public %(real)s
 {
     %(fake)s() : %(real)s() {}
     %(fake)s(const %(real)s& a) : %(real)s(a) {}
+#if QT_VERSION >= QT_VERSION_CHECK(5, 1, 0)
     %(fake)s(std::initializer_list<%(stdtype)s> a) : %(real)s(a) {}
+#endif
 
     %(fake)s& operator=(const %(real)s& a)
     {
