PortSystem          1.0
PortGroup           cmake   1.1
PortGroup           github  1.0

github.setup        facebook openzl 0.3.0 v
revision            0
categories          archivers
license             BSD
maintainers         nomaintainer

description         OpenZL delivers high compression ratios while preserving high speed, \
                    a level of performance that is out of reach for generic compressors.
long_description    {*}${description}
homepage            https://openzl.org

checksums           rmd160  304ff6ee9f5b010fe133c46cacc6166f0b36df7b \
                    sha256  6e105e5c49187ebf63e0bf62fb3ecb22b628248c0bf55bd40ace434721f394f5 \
                    size    19023632
github.tarball_from archive

# https://github.com/facebook/openzl/issues/342
# 32-bit: HeapMeta padding, 64-bit bit containers for the FSE/Huffman decoder
# and the FF bitstream (partition, quantize, bitpack), Huffman16 flush cadence.
patchfiles-append   patch-32-bit.diff

# Big-endian: byte-swap in conversion codecs instead of aborting, native-order
# bitpack, LE-only partition fast paths and partition+bitpack decoder fusion.
patchfiles-append   patch-big-endian.diff

# Allow building zli without the xgboost-based ML selector trainer,
# which is otherwise git-cloned and built at build time.
patchfiles-append   patch-optional-xgboost.diff

compiler.c_standard 2011

depends_build-append \
                    path:bin/pkg-config:pkgconfig

depends_lib-append  port:lz4 \
                    port:zstd

configure.ldflags-append \
                    -llz4 \
                    -lzstd

# At the moment only an executable is installed.
configure.args-append \
                    -DOPENZL_BUILD_SHARED_LIBS=OFF \
                    -DOPENZL_BUILD_EXAMPLES=OFF \
                    -DOPENZL_ENABLE_XGBOOST=OFF

destroot {
    set builddir    ${worksrcpath}/../build
    xinstall ${builddir}/cli/zli ${destroot}${prefix}/bin
}
