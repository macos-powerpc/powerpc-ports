--- tools/CMakeLists.txt.orig
+++ tools/CMakeLists.txt
@@ -9,6 +9,9 @@
 set(OPENZL_BUILD_SDDL_TOOLS OFF)
 set(OPENZL_BUILD_TRAINING_TOOLS OFF)
 set(OPENZL_BUILD_ML_SELECTOR OFF)
+# The ML selector trainer pulls xgboost via ExternalProject (git clone at
+# build time). Everything else, including zli, builds fine without it.
+option(OPENZL_ENABLE_XGBOOST "Build the xgboost-based ML selector trainer" ON)
 
 if(NOT DEFINED OPENZL_BUILD_LOGGER)
   set(OPENZL_BUILD_LOGGER OFF)
@@ -20,7 +23,7 @@
   set(OPENZL_BUILD_SDDL_TOOLS ON)
   set(OPENZL_BUILD_TRAINING_TOOLS ON)
   # xgboost has no Emscripten/WASM build
-  if(NOT EMSCRIPTEN)
+  if(NOT EMSCRIPTEN AND OPENZL_ENABLE_XGBOOST)
     set(OPENZL_BUILD_ML_SELECTOR ON)
   endif()
 endif()
@@ -30,7 +33,7 @@
   set(OPENZL_BUILD_LOGGER ON)
   set(OPENZL_BUILD_SDDL_TOOLS ON)
   set(OPENZL_BUILD_TRAINING_TOOLS ON)
-  if(NOT EMSCRIPTEN)
+  if(NOT EMSCRIPTEN AND OPENZL_ENABLE_XGBOOST)
     set(OPENZL_BUILD_ML_SELECTOR ON)
   endif()
 endif()
