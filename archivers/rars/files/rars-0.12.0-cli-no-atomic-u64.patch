     pub(crate) fn new(out_dir: &Path) -> std::io::Result<Self> {
-        static NEXT: AtomicU64 = AtomicU64::new(0);
+        // A per-process sequence number: `AtomicUsize`, as 32-bit targets (PowerPC, MIPS, older ARM) have no
+        // `AtomicU64`, and the counter only has to differ between attempts within one process
+        static NEXT: AtomicUsize = AtomicUsize::new(0);
