 #include <errno.h>
 #include <fcntl.h>
+#ifndef F_DUPFD_CLOEXEC
+/* Missing before POSIX.1-2008 (e.g. macOS < 10.7): dup, then set FD_CLOEXEC */
+static int blosc_dupfd_cloexec(int fd) {
+  int newfd = fcntl(fd, F_DUPFD, 0);
+  if (newfd >= 0) {
+    fcntl(newfd, F_SETFD, FD_CLOEXEC);
+  }
+  return newfd;
+}
+#define BLOSC_DUPFD_CLOEXEC(fd) blosc_dupfd_cloexec(fd)
+#else
+#define BLOSC_DUPFD_CLOEXEC(fd) fcntl(fd, F_DUPFD_CLOEXEC, 0)
+#endif
