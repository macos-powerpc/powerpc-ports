From 93ee29bbc77f342e1d41e4f27ca7e15e5e928762 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 20 Nov 2026 04:53:28 +0000
Subject: [PATCH] Support for big-endian targets in scalar builds.

- The compressed format stays little-endian, so archives are interchangeable between little- and big-endian hosts.
- The range coder lays out its low/carry union and writes its 16-bit words in little-endian order on big-endian targets.
- Block headers, coder and LZP sub-block headers, BWT indexes and the bsc file and block headers are stored through little-endian load/store helpers.
- Big-endian targets build with LIBBSC_CPU_FEATURE_NONE only; AArch64 big-endian takes the scalar code paths, and SIMD on a big-endian target is rejected at compile time.

Assisted-by: Claude Opus 5.5
---
 bsc.cpp                          | 12 +++--
 libbsc/coder/coder.cpp           | 32 ++++++------
 libbsc/coder/common/rangecoder.h |  9 ++++
 libbsc/libbsc/libbsc.cpp         | 84 ++++++++++++++++----------------
 libbsc/lzp/lzp.cpp               | 26 +++++-----
 libbsc/platform/platform.h       | 55 +++++++++++++++++++--
 6 files changed, 138 insertions(+), 80 deletions(-)

diff --git a/bsc.cpp b/bsc.cpp
index 21bcf32..88c0f53 100644
--- a/bsc.cpp
+++ b/bsc.cpp
@@ -539,7 +539,8 @@ void compression_omp(char * input_name, FILE * fInput, BSC_FILEHANDLE hInput, BS
         {
             BSC_LOCK(BSC_LOCK_OUTPUT);
 
-            BSC_BLOCK_HEADER header = {blockOffset, recordSize, sortingContexts};
+            BSC_BLOCK_HEADER header = {0, recordSize, sortingContexts};
+            bsc_store_le64((unsigned char *)&header.blockOffset, blockOffset);
 
             if (fwrite(&header, sizeof(BSC_BLOCK_HEADER), 1, fOutput) != 1)
             {
@@ -638,7 +639,8 @@ void Compression(char * argv[])
     outFileSize += (int)(sizeof(bscFileSign));
 
     int nBlocks = paramBlockSize > 0 ? (int)((inFileSize + paramBlockSize - 1) / paramBlockSize) : 0;
-    if (fwrite(&nBlocks, sizeof(nBlocks), 1, fOutput) != 1)
+    unsigned char nBlocksLE[sizeof(nBlocks)]; bsc_store_le32(nBlocksLE, nBlocks);
+    if (fwrite(nBlocksLE, sizeof(nBlocksLE), 1, fOutput) != 1)
     {
         fprintf(stderr, "IO error on file: %s!\n", argv[3]);
         exit(1);
@@ -753,7 +755,7 @@ void decompression_omp(char * input_name, FILE * fInput, BSC_FILEHANDLE hInput,
                     bsc_exit(2);
                 }
 
-                blockOffset = (BSC_FILEOFFSET)header.blockOffset;
+                blockOffset = (BSC_FILEOFFSET)bsc_load_le64((const unsigned char *)&header.blockOffset);
 
                 unsigned char bscBlockHeader[LIBBSC_HEADER_SIZE];
 
@@ -977,11 +979,13 @@ void Decompression(char * argv[])
     }
 
     int nBlocks = 0, nBlocksRead = 0;
-    if (fread(&nBlocks, sizeof(nBlocks), 1, fInput) != 1)
+    unsigned char nBlocksLE[sizeof(nBlocks)];
+    if (fread(nBlocksLE, sizeof(nBlocksLE), 1, fInput) != 1)
     {
         fprintf(stderr, "This is not bsc archive!\n");
         exit(1);
     }
+    nBlocks = bsc_load_le32(nBlocksLE);
 
     BSC_FILEHANDLE hInput  = bsc_open_positional(fInput, false);
     BSC_FILEHANDLE hOutput = bsc_open_positional(fOutput, true);
