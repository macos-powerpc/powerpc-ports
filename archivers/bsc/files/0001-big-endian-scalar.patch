         }
     }
 
@@ -369,8 +369,8 @@ int bsc_coder_compress_parallel(const unsigned char * input, unsigned char * out
                     }
                     else
                     {
-                        bsc_unaligned_store<int>(output + 1 + 8 * blockId + 0, blockSize);
-                        bsc_unaligned_store<int>(output + 1 + 8 * blockId + 4, compressionResult[blockId]);
+                        bsc_store_le32(output + 1 + 8 * blockId + 0, blockSize);
+                        bsc_store_le32(output + 1 + 8 * blockId + 4, compressionResult[blockId]);
                     }
 
                     #pragma omp ordered
@@ -418,8 +418,8 @@ int bsc_coder_compress_parallel(const unsigned char * input, unsigned char * out
                             output[0] = nBlocks;
                             for (int blockId = 0; blockId < nBlocks; ++blockId)
                             {
-                                bsc_unaligned_store<int>(output + 1 + 8 * blockId + 0, compressedSize[blockId]);
-                                bsc_unaligned_store<int>(output + 1 + 8 * blockId + 4, compressionResult[blockId]);
+                                bsc_store_le32(output + 1 + 8 * blockId + 0, compressedSize[blockId]);
+                                bsc_store_le32(output + 1 + 8 * blockId + 4, compressionResult[blockId]);
                             }
 
                             result = total;
@@ -508,14 +508,14 @@ int bsc_coder_decompress(const unsigned char * input, unsigned char * output, in
 
             for (int p = 0; p < blockId; ++p)
             {
-                inputSize  = bsc_unaligned_load<int>(input + 1 + 8 * p + 4);
-                outputSize = bsc_unaligned_load<int>(input + 1 + 8 * p + 0);
+                inputSize  = bsc_load_le32(input + 1 + 8 * p + 4);
+                outputSize = bsc_load_le32(input + 1 + 8 * p + 0);
 
                 inputPtr += inputSize; outputPtr += outputSize;
             }
 
-            inputSize  = bsc_unaligned_load<int>(input + 1 + 8 * blockId + 4);
-            outputSize = bsc_unaligned_load<int>(input + 1 + 8 * blockId + 0);
+            inputSize  = bsc_load_le32(input + 1 + 8 * blockId + 4);
+            outputSize = bsc_load_le32(input + 1 + 8 * blockId + 0);
 
             if (inputSize != outputSize)
             {
@@ -551,14 +551,14 @@ int bsc_coder_decompress(const unsigned char * input, unsigned char * output, in
 
             for (int p = 0; p < blockId; ++p)
             {
-                inputSize  = bsc_unaligned_load<int>(input + 1 + 8 * p + 4);
-                outputSize = bsc_unaligned_load<int>(input + 1 + 8 * p + 0);
+                inputSize  = bsc_load_le32(input + 1 + 8 * p + 4);
+                outputSize = bsc_load_le32(input + 1 + 8 * p + 0);
 
                 inputPtr += inputSize; outputPtr += outputSize;
             }
 
-            inputSize  = bsc_unaligned_load<int>(input + 1 + 8 * blockId + 4);
-            outputSize = bsc_unaligned_load<int>(input + 1 + 8 * blockId + 0);
+            inputSize  = bsc_load_le32(input + 1 + 8 * blockId + 4);
