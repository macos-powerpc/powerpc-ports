--- a/libbsc/coder/common/rangecoder.h
+++ b/libbsc/coder/common/rangecoder.h
@@ -44,8 +44,13 @@ private:
     {
         struct u
         {
+#if defined(LIBBSC_BIG_ENDIAN)
+            unsigned int carry;
+            unsigned int low32;
+#else
             unsigned int low32;
             unsigned int carry;
+#endif
         } u;
         unsigned long long low;
     } ari;
@@ -70,6 +75,8 @@ private:
     {
 #if defined(LIBBSC_x86_64) || defined(LIBBSC_AArch64)
         *ari_output++ = s;
+#elif defined(LIBBSC_BIG_ENDIAN)
+        bsc_unaligned_store<unsigned short>((unsigned char *)ari_output++, bsc_byteswap_uint16(s));
 #else
         bsc_unaligned_store<unsigned short>((unsigned char *)ari_output++, s);
 #endif
@@ -79,6 +86,8 @@ private:
     {
 #if defined(LIBBSC_x86_64) || defined(LIBBSC_AArch64)
         return *ari_input++;
+#elif defined(LIBBSC_BIG_ENDIAN)
+        return bsc_byteswap_uint16(bsc_unaligned_load<unsigned short>((const unsigned char *)ari_input++));
 #else
         return bsc_unaligned_load<unsigned short>((const unsigned char *)ari_input++);
 #endif
