# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1
PortGroup           openssl 1.0
PortGroup           qt4 1.0

legacysupport.newest_darwin_requires_legacy 15
openssl.branch      3

# Branch ppc of the fork, the same tree ladybird-headless builds: upstream 22e8e99d4c
# (2026-03-19) with the portability changes, including upstream's UI/Qt ported to Qt 4.
# The version is the date of the base, not the tag: revbump with every tag.
github.setup        barracuda156 ladybird 20260319.6 ppc-
version             20260319
revision            1
name                ladybird-qt
categories          www aqua
license             BSD
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer

description         Qt frontend for the Ladybird web browser
long_description    A browser window for the Ladybird engine of ladybird-headless, \
                    built with Qt 4 as a Mac OS X application bundle: tabs, \
                    location bar with autocompletion, bookmarks bar, find in page, \
                    zoom, context menus, JavaScript dialogs and file pickers. It \
                    shares the engine libraries, helper processes and resources \
                    of ladybird-headless, which it is built against. The frontend \
                    is upstream’s Qt UI of March 2026, ported from Qt 6 to Qt 4.

homepage            https://ladybird.org

checksums           rmd160  79aa995a12abbdabee005f03d0cccc329ca9fb5c \
                    sha256  04840a93003f05f9b9d707347c9477e6fa43f50c33926fb44db24e41f27d9167 \
                    size    35084826
github.tarball_from archive

# Only the frontend is used; the engine headers and libraries come from ladybird-headless.
# GitHub names the top directory of a tag archive <project>-<tag>.
set archive_topdir  ${github.project}-${github.tag_prefix}${github.version}
extract.post_args-append \
                    ${archive_topdir}/UI/Qt \
                    ${archive_topdir}/UI/Icons \
                    ${archive_topdir}/UI/Info.plist \
                    ${archive_topdir}/LICENSE

cmake.source_dir    ${worksrcpath}/UI/Qt
cmake.generator     Ninja

compiler.cxx_standard   2023
compiler.blacklist-append {clang < 1900}

depends_build-append \
                    port:makeicns

depends_lib-append  port:ladybird-headless

configure.args-append \
                    -DQT_QMAKE_EXECUTABLE=${qt_qmake_cmd} \
                    -DLADYBIRD_APPLICATIONS_DIR=${applications_dir}

post-destroot {
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/LICENSE ${destroot}${prefix}/share/doc/${name}

    set app_executable ${applications_dir}/Ladybird.app/Contents/MacOS/Ladybird
    xinstall -d ${destroot}${prefix}/bin
    if {${configure.cxx_stdlib} eq "libc++"} {
        ln -s ${app_executable} ${destroot}${prefix}/bin/ladybird-qt
    } else {
        set wrapper [open ${destroot}${prefix}/bin/ladybird-qt w 0755]
        puts ${wrapper} "#!/bin/bash"
        puts ${wrapper} "DYLD_LIBRARY_PATH=${prefix}/lib/libgcc\${DYLD_LIBRARY_PATH:+:\$DYLD_LIBRARY_PATH}"
        puts ${wrapper} "export DYLD_LIBRARY_PATH"
        puts ${wrapper} "exec \"${app_executable}\" \"\$@\""
        close ${wrapper}
    }
}

notes "
Ladybird.app is in ${applications_dir}. From a terminal, run\
${prefix}/bin/ladybird-qt \[URL\]. A second invocation opens its URLs in\
the running browser, unless it is given --force-new-process.
"

if {${configure.cxx_stdlib} ne "libc++"} {
    notes-append "
    Launching the app bundle directly does not work currently. Run `ladybird-qt` from the terminal.
    "
}

livecheck.type      none
