# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1
PortGroup           openssl 1.0

legacysupport.newest_darwin_requires_legacy 10

github.setup        barracuda156 shigoku 300ce83c9852273b438febe4b79ce8603764889e
version             0.2.2
revision            1
categories          www multimedia anime manga
license             GPL-3+
maintainers         {@barracuda156 macos-powerpc.org:barracuda}
description         Terminal anime browser/player (C++23 port of sabigoku) with added \
                    support for manga
long_description    ${name} is a keyboard-driven terminal UI for browsing anime \
                    via AniList/MAL, resolving streams through pluggable providers \
                    and playing them in mpv/mplayer — with Kitty-/sixel-graphics cover \
                    art, SQLite-backed resume/watch history and truecolor rendering. \
                    ${name}-manga is a TUI manga browser with SDL-based reader.

checksums           rmd160  42e0b93ea35d52b7e8e4d5114f6a043160f024c5 \
                    sha256  f340ce23f1d60fe7087e4855d9faf27fd573cc4c2271f489196ff7b1f5e23f82 \
                    size    3628945
github.tarball_from archive

installs_libs       no

depends_build-append \
                    port:nlohmann-json \
                    path:bin/pkg-config:pkgconfig

depends_lib-append  port:curl \
                    port:libarchive \
                    port:libsdl2 \
                    port:sqlite3 \
                    port:webp

# fzf++ used with CLI
depends_run-append  port:curl-impersonate \
                    path:bin/fzf:fzfpp \
                    path:bin/mpv:mpv-devel

compiler.cxx_standard   2023

configure.args-append \
                    -DCMAKE_BUILD_TYPE=Release \
                    -DSHIGOKU_BUILD_TESTS=OFF \
                    -DSHIGOKU_SYSTEM_DOCTEST=OFF \
                    -DSHIGOKU_SYSTEM_NLOHMANN_JSON=ON \
                    -DSHIGOKU_SYSTEM_STB=OFF \
                    -DSHIGOKU_SYSTEM_TL_EXPECTED=OFF \
                    -DSHIGOKU_WERROR=OFF \
                    -DWITH_MUPDF=OFF \
                    -DWITH_TUI=ON

variant js description "Use JS runtime for providers needing it" {
    depends_run-append \
                    path:bin/node:nodejs22
}

variant pdf description "Support pdf/epub viewing" {
    depends_lib-append \
                    port:mupdf
    configure.args-replace \
                    -DWITH_MUPDF=OFF -DWITH_MUPDF=ON
}

default_variants    +pdf

# Our powerpc NodeJS has only been tested on 10.6.
if {${os.platform} ne "darwin" || ${os.major} >= 10} {
    default_variants-append +js
}

test.run            yes

notes "
It is recommended to use a terminal emulator with support for images (kitty/iterm/sixel),
such as contour, mlterm, iTerm2, bobcat, foot or sakura.
"
