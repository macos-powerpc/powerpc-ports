# Upstream defaults to IINA on macOS when ANI_CLI_PLAYER is unset; this
# project prefers mpv (already a run-dependency) so the port does not pull
# in IINA.app as an additional dependency.
patchfiles          patch-no-iina-default-macos.diff
# https://github.com/vorlie/ani-cli-rs/issues/43
patchfiles-append   patch-hls_relay-atomic.diff

destroot {
    xinstall -m 0755 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/${name} \
        ${destroot}${prefix}/bin/

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 \
        ${worksrcpath}/README.md \
        ${worksrcpath}/LICENSE \
        ${destroot}${prefix}/share/doc/${name}/
}

