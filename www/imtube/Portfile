PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1

github.setup        DanielMartensson ImTube ca01fe09c038defb05f6c15116da42327c7eaf5b
name                [string tolower ${github.project}]
version             2026.08.20
revision            2
categories          www multimedia
license             MIT
maintainers         {@barracuda156 gmail.com:vital.had} openmaintainer

description         Youtube player in ImGui
long_description    ${name} is a Dear ImGui YouTube-style browser and player \
                    built on yt-dlp and GStreamer. This port carries a local \
                    patch that replaces upstream's SDL3/GLES/Vulkan-only \
                    stack with a legacy-OpenGL (fixed-function) path over \
                    SDL2, so it runs on G4 and G5 Power Macs under Mac OS X \
                    10.4-10.5, alongside every platform upstream supports.
checksums           rmd160  86c3535a29f7e200e74fa6e031c1da014181cb1d \
                    sha256  13ce394c92f4e585697aca62f746f4ec02171756840b2db78f81c878ca79bcfd \
                    size    3504284
github.tarball_from archive

patch.pre_args-replace -p0 -p1

patchfiles-append   0001-ppc-G4-G5-port-SDL2-GLFW-platform-layer-and-legacy-f.patch \
                    0002-render-GL_APPLE_ycbcr_422-upload-path-for-video-fram.patch \
                    0003-settings-preferred-video-codec-H.264-VP9-AV1-with-de.patch \
                    0004-playback-GStreamer-QoS-handling-YUV-pack-path-and-a-.patch \
                    0005-play-a-local-media-file-command-line-argument-or-a-p.patch \
                    0006-download-progress-reporting-and-the-A-V-lag-indicato.patch \
                    0007-show-the-codecs-and-decoders-decodebin-picked-prefer.patch \
                    0008-trim-the-player-control-panel.patch \
                    0009-seek-inside-a-local-file.patch \
                    0010-glfw-survive-a-NULL-video-mode-when-entering-fullscr.patch \
                    0011-core-make-ffmpeg-resume-a-dropped-input-connection-s.patch \
                    0012-core-advertise-GstVideoMeta-on-the-appsink-allocatio.patch \
                    0013-Space-pauses-resumes-and-Settings-opens-over-the-run.patch \
                    0014-keep-the-ImGui-layout-file-in-HOME-instead-of-the-wo.patch \
                    0015-settings-offer-2160p-4K-and-default-a-G4-to-480p.patch

configure.args-append \
                    -DIMTUBE_ALLOW_FETCH=NO \
                    -DIMTUBE_BUILD_IMGUI_DEMO=NO \
                    -DIMTUBE_IMGUI=system \
                    -DIMTUBE_RENDERER=gl2 \
                    -DIMTUBE_WITH_CURL=ON

compiler.cxx_standard 2020

depends_build-append \
                    port:nlohmann-json \
                    path:bin/pkg-config:pkgconfig

depends_lib-append  port:curl \
                    port:gettext-runtime \
                    path:lib/pkgconfig/glib-2.0.pc:glib2 \
                    port:gstreamer1 \
                    port:gstreamer1-gst-plugins-base \
                    port:imgui

# Codec/container support: nothing in the build links against these, but
# without at least one of them GStreamer can open a pipeline and produce
# no video. gst-libav (ffmpeg) covers H.264/AAC; good/bad/ugly cover
# the webm/VP9/Opus formats yt-dlp also hands back.
depends_run-append  port:gstreamer1-gst-libav \
                    port:gstreamer1-gst-plugin-dav1ddec \
                    port:gstreamer1-gst-plugins-bad \
                    port:gstreamer1-gst-plugins-good \
                    port:yt-dlp

variant glfw conflicts sdl2 sdl3 description "Use GLFW windowing" {
    depends_lib-append \
                    path:lib/pkgconfig/glfw3.pc:glfw
    configure.args-append \
                    -DIMTUBE_PLATFORM=glfw
}

variant sdl2 conflicts glfw sdl3 description "Use SDL2 windowing" {
    depends_lib-append \
                    port:libsdl2
    configure.args-append \
                    -DIMTUBE_PLATFORM=sdl2
}

variant sdl3 conflicts glfw sdl2 description "Use SDL3 windowing" {
    depends_lib-append \
                    port:SDL3
    configure.args-append \
                    -DIMTUBE_PLATFORM=sdl3
}

# TODO: switch the default to glfw, at least for 10.6+.
if {![variant_isset glfw] && ![variant_isset sdl3]} {
    default_variants +sdl2
}

test.run            yes
test.target         test
