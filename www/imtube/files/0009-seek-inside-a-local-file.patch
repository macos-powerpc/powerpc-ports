From 8cf4986532162a7f92a9f37257cdf76376ec7308 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 19 Sep 2026 18:30:13 +0000
Subject: [PATCH 09/15] seek inside a local file

---
 src/core/GStreamerPlayer.cpp | 15 +++++++++++++++
 src/core/GStreamerPlayer.h   |  5 +++++
 2 files changed, 20 insertions(+)

diff --git a/src/core/GStreamerPlayer.cpp b/src/core/GStreamerPlayer.cpp
index 999c558..f2f58d6 100644
--- a/src/core/GStreamerPlayer.cpp
+++ b/src/core/GStreamerPlayer.cpp
@@ -98,6 +98,7 @@ bool GStreamerPlayer::start(const std::string& url, bool live, int max_height, c
     m_max_height = max_height;
     m_ytdlp_binary = ytdlp_binary;
     m_start_offset_ms = 0;
+    m_local_duration_ms = 0;
 
     /* --- Byte source: a local file, or yt-dlp's stdout ----------------------- */
     m_local_path.clear();
@@ -493,10 +494,22 @@ bool GStreamerPlayer::get_position_and_duration(int64_t* pos_ms, int64_t* dur_ms
      * total length until EOS, so the demuxer's duration only ever shows the
      * last parsed cluster. Use the metadata duration when we know it, and fall
      * back to the demuxer's answer otherwise (live streams, raw URLs). */
+    /* A local file's container carries its full length (mp4 moov, matroska
+     * SegmentInfo); the initial pipeline reads it from the start of the file.
+     * Keep that answer, because every pipeline after a seek reads ffmpeg's
+     * re-based pipe instead, whose demuxer's duration is only the clusters
+     * parsed so far: position over that would pin the slider at the right
+     * and show a nonsense total. */
+    if (!m_local_path.empty() && m_start_offset_ms == 0 && m_local_duration_ms == 0 &&
+        dur_ok && dur > 0)
+        m_local_duration_ms = (int64_t)(dur / GST_MSECOND);
+
     if (dur_ms)
     {
         if (m_known_duration_ms > 0)
             *dur_ms = m_known_duration_ms;
+        else if (m_local_duration_ms > 0)
+            *dur_ms = m_local_duration_ms;
         else
             *dur_ms = dur_ok ? (int64_t)(dur / GST_MSECOND) + m_start_offset_ms : -1;
     }
@@ -927,8 +940,10 @@ void GStreamerPlayer::link_branch(GstPad* pad, bool is_video)
             gst_bin_remove(GST_BIN(m_pipeline), chain[i]);
         }
         if (!is_video)
+        {
             m_volume_elem = nullptr;
             m_audio_sink = nullptr;
+        }
         return;
     }
 
diff --git a/src/core/GStreamerPlayer.h b/src/core/GStreamerPlayer.h
index 6518c12..853e722 100644
--- a/src/core/GStreamerPlayer.h
+++ b/src/core/GStreamerPlayer.h
@@ -176,6 +176,11 @@ private:
     std::atomic<bool> m_paused{false};
     std::atomic<bool> m_eos{false};
     int64_t m_known_duration_ms = 0;
+    /* A local file's full length, read from its container by the initial
+     * (unseeked) pipeline and kept across seeks: after a seek the source is
+     * ffmpeg's re-based pipe, whose demuxer only knows the clusters parsed so
+     * far. Cached lazily by the const position query, hence mutable. */
+    mutable int64_t m_local_duration_ms = 0;
     std::atomic<bool> m_started{false};
     bool m_live = false;
 
