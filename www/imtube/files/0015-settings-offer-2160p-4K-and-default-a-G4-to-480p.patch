Subject: [PATCH 15/15] settings: offer 2160p (4K), and default a G4 to 480p

---
 README.md           | 13 ++++++++-----
 src/ui/ImTubeUI.cpp | 25 +++++++++++++++----------
 2 files changed, 23 insertions(+), 15 deletions(-)

diff --git a/README.md b/README.md
index 6555c0d..b53c677 100644
--- a/README.md
+++ b/README.md
@@ -21,7 +21,7 @@ render abstraction with a **legacy OpenGL** (fixed function, default) and an
 
 * YouTube search and URL playback
 * Video browsing with thumbnails (libcurl downloader, decoded in a worker thread)
-* Streaming playback up to 1080p, with a seekable progress bar
+* Streaming playback up to 2160p (4K), with a seekable progress bar
 * Play / pause / stop (`Space` toggles pause), mute + volume slider, playback speed (0.5x – 2x)
 * Fullscreen mode (`F11`, `Esc` to leave)
 * Subtitles (fetched by yt-dlp, parsed from VTT/SRT, drawn over the video)
@@ -284,13 +284,16 @@ library) plus the backend sources under `share/imgui/backends`. The port's
 GLFW instead of SDL2: `-DIMTUBE_PLATFORM=glfw` (GLFW 3.2 or newer for
 fullscreen and idle waits; older 3.x still builds).
 
-On a G4 the first-launch stream resolution is 360p (a G5 gets 720p; 1080p
+On a G4 the first-launch stream resolution is 480p (a G5 gets 720p; 1080p
 H.264 is beyond a dual 2 GHz 970, the player then shows how far the picture
 is behind the sound); change it
-under Settings, the choice is persisted. Settings also holds the preferred
+under Settings, which offers 240p through 2160p and persists the choice.
+A frame wider than the GPU's largest texture is scaled down by videoscale
+before upload, so 1440p and 2160p buy nothing on a GPU capped at 2048 px.
+Settings also holds the preferred
 video codec (H.264, VP9 or AV1, a preference with fallback to whatever the
 video has; YouTube's H.264 ladder ends at 1080p, so VP9 or AV1 is the way to
-1440p). Each option shows the GStreamer decoder that would handle it and is
+1440p and 2160p). Each option shows the GStreamer decoder that would handle it and is
 greyed out when none is installed; the decoders decodebin actually picks are
 printed at playback start as `[gst] decoder: ...`. `IMTUBE_GL_FORCE_POT=1` in the
 environment forces the power-of-two texture path on a GPU that does not need
@@ -366,7 +369,7 @@ ctest --test-dir build --output-on-failure
 | `IMTUBE_RENDERER` | `gl2` | `gl2` (legacy OpenGL, fixed function) or `gles` (OpenGL ES 3.2) |
 | `IMTUBE_IMGUI` | `auto` | Dear ImGui source: `auto` (system when pkg-config finds `imgui`, else vendored), `system`, `vendored` |
 | `IMTUBE_MACOS_GL` | `framework` | macOS only, `gl2` renderer: `framework` (system OpenGL.framework, matches the Cocoa driver) or `x11` (Mesa `libGL` for `SDL_VIDEODRIVER=x11` under XQuartz) |
-| `IMTUBE_DEFAULT_RESOLUTION` | `0` | First-launch stream resolution; `0` picks per machine (360p on a G4, 1080p elsewhere) |
+| `IMTUBE_DEFAULT_RESOLUTION` | `0` | First-launch stream resolution; `0` picks per machine (480p on a G4, 720p on a G5, 1080p elsewhere) |
 | `IMTUBE_LTO` | `ON` | Link-time optimisation for native Release builds |
 | `IMTUBE_ALLOW_FETCH` | `ON` | Fetch SDL3 / nlohmann_json when missing (`OFF` when cross-compiling; pass `OFF` for package builds) |
 | `IMTUBE_EMBEDDED` | `OFF` | STM32MPU tuning (single H.264 stream, no tests) |
diff --git a/src/ui/ImTubeUI.cpp b/src/ui/ImTubeUI.cpp
index 6684ac1..7694532 100644
--- a/src/ui/ImTubeUI.cpp
+++ b/src/ui/ImTubeUI.cpp
@@ -162,18 +162,19 @@ int ImTubeUI::default_resolution()
 #if defined(IMTUBE_DEFAULT_RESOLUTION) && (IMTUBE_DEFAULT_RESOLUTION > 0)
     return IMTUBE_DEFAULT_RESOLUTION;
 #elif defined(__APPLE__) && (defined(__ppc__) || defined(__ppc64__))
-    /* A G4 decodes 360p H.264 in software at best, and below 360p yt-dlp
-     * streams a single progressive file so no ffmpeg merge competes for the
-     * CPU. A G5 (PowerPC 970) keeps up with 720p; at 1080p avdec_h264 falls
-     * behind real time on a dual 2 GHz 970 (with QoS the picture drops to a
-     * slideshow, without it the audio track ends ahead of the picture).
+    /* A G4 plays 480p H.264 in software; the step up from 360p costs an
+     * ffmpeg merge of the DASH video and audio tracks (only at 360p and below
+     * does yt-dlp still hand out a single progressive file), which the G4
+     * absorbs. A G5 (PowerPC 970) keeps up with 720p; at 1080p avdec_h264
+     * falls behind real time on a dual 2 GHz 970 (with QoS the picture drops
+     * to a slideshow, without it the audio track ends ahead of the picture).
      * Settings persist the user's own choice afterwards. */
     int subtype = 0;
     size_t len = sizeof(subtype);
     if (sysctlbyname("hw.cpusubtype", &subtype, &len, nullptr, 0) == 0 &&
         subtype == CPU_SUBTYPE_POWERPC_970)
         return 720;
-    return 360;
+    return 480;
 #else
     return 1080;
 #endif
@@ -1655,7 +1656,7 @@ void ImTubeUI::render_settings_tab()
     if (ImGui::CollapsingHeader("Streaming", ImGuiTreeNodeFlags_DefaultOpen))
     {
         ImGui::TextUnformatted("Default stream resolution:");
-        const int resolutions[] = { 240, 360, 480, 720, 1080, 1440 };
+        const int resolutions[] = { 240, 360, 480, 720, 1080, 1440, 2160 };
         bool first_radio = true;
         for (int r : resolutions)
         {
@@ -1672,7 +1673,11 @@ void ImTubeUI::render_settings_tab()
         ImGui::TextColored(kColTextDim,
             "Resolution used by yt-dlp when streaming videos (%dp default on this machine). "
             "Above 360p YouTube streams require ffmpeg to merge the DASH video and audio tracks; "
-            "a G4 copes with 360p at most, a G5 with 720p (1080p drops frames).", default_resolution());
+            "a G4 copes with 480p, a G5 with 720p (1080p drops frames). 1440p and 2160p are "
+            "VP9/AV1 only, and a frame wider than the GPU's largest texture (%d px here) is "
+            "scaled down before upload, which costs CPU without showing more.",
+            default_resolution(),
+            m_backend != nullptr ? m_backend->max_texture_size() : 0);
 
         ImGui::Spacing();
         ImGui::TextUnformatted("Preferred video codec:");
@@ -1698,8 +1703,8 @@ void ImTubeUI::render_settings_tab()
         }
         ImGui::TextColored(kColTextDim,
             "A preference, not a requirement: yt-dlp asks for this codec at the chosen resolution and "
-            "takes any codec when a video lacks it. YouTube offers H.264 up to 1080p; 1440p exists only "
-            "as VP9 or AV1. Hover an option for the GStreamer decoder that handles it.");
+            "takes any codec when a video lacks it. YouTube offers H.264 up to 1080p; 1440p and 2160p "
+            "exist only as VP9 or AV1. Hover an option for the GStreamer decoder that handles it.");
     }
 
     if (ImGui::CollapsingHeader("Recording", ImGuiTreeNodeFlags_DefaultOpen))
