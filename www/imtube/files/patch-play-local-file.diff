+std::string YtDlpHelper::local_file_path(const std::string& s)
+{
+    static const char kPrefix[] = "file://";
+    if (s.compare(0, sizeof(kPrefix) - 1, kPrefix) == 0)
+        return s.substr(sizeof(kPrefix) - 1);
+    return s;
+}
+
+bool YtDlpHelper::is_local_file(const std::string& s)
+{
+    if (s.empty())
+        return false;
+    const std::string path = local_file_path(s);
+    if (path.empty())
+        return false;
+    const bool path_like = path[0] == '/' || path.compare(0, 2, "./") == 0 ||
+                           path.compare(0, 3, "../") == 0 || path.size() != s.size();
+    if (!path_like)
+        return false;
+    struct stat st;
+    return stat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode);
+}
