+/* Allocate and fill a tiny 4:2:2 Y'CbCr texture with `type` and report
+ * whether the driver accepted it. The video format is chosen before the
+ * stream starts and cannot change afterwards, so an advertised extension
+ * is not taken on trust. */
+bool probe_ycbcr422(GLenum type)
+{
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ; /* discard stale errors so the probe only sees its own */
+
+    GLuint tex = 0;
+    glGenTextures(1, &tex);
+    if (tex == 0)
+        return false;
+
+    /* 2x2 pixels of video black: Cb=128, Y=16, Cr=128, Y=16 per pair. */
+    const uint8_t pixels[2 * 2 * 2] = { 128, 16, 128, 16, 128, 16, 128, 16 };
+    glBindTexture(GL_TEXTURE_2D, tex);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, 2, 2, 0, GL_YCBCR_422_APPLE, type, pixels);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 2, 2, GL_YCBCR_422_APPLE, type, pixels);
+    const bool ok = glGetError() == GL_NO_ERROR;
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glDeleteTextures(1, &tex);
+    return ok;
+}
+
 } /* namespace */
 
