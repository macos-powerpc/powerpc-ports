+/* glTexImage2D / glTexSubImage2D arguments for each pixel layout. */
+struct GlLayout {
+    GLint internal_format;
+    GLenum format;
+    GLenum type;
+};
+
+GlLayout layout_for(PixelFormat format, uint32_t ycbcr_type)
+{
+    switch (format)
+    {
+    case PixelFormat::Packed32:
+        /* GL_BGRA + GL_UNSIGNED_INT_8_8_8_8_REV: Apple's own documented
+         * no-swizzle upload path (their OpenGL driver's native pixel format),
+         * and exactly the byte layout GStreamer calls "ARGB" on the
+         * big-endian PowerPC target this backend exists for (see PixelFormat
+         * in RenderTexture.h), so the decoder's output can be handed straight
+         * to glTexSubImage2D with no CPU-side channel swizzle. */
+        return { GL_RGBA8, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV };
+
+    case PixelFormat::YCbCr422:
+        /* GL_APPLE_ycbcr_422: the driver keeps the 4:2:2 data as it is and
+         * the GPU converts to RGB while sampling. The spec asks for an RGB
+         * internal format (the data is RGB information, just encoded). The
+         * 16-bit <type> decides which byte of each pair is luminance; it is
+         * chosen by Gl2Context for the host's byte order. */
+        return { GL_RGB, GL_YCBCR_422_APPLE, (GLenum)ycbcr_type };
+
+    default:
+        return { GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE };
+    }
+}
+
 } /* namespace */
 
