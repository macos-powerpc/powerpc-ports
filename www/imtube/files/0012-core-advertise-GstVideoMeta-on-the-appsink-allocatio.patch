From a9cb5a50f9d80c310b161afd528c56155bae1999 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 19 Sep 2026 18:30:19 +0000
Subject: [PATCH 12/15] core: advertise GstVideoMeta on the appsink allocation query

---
 src/core/GStreamerPlayer.cpp | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/src/core/GStreamerPlayer.cpp b/src/core/GStreamerPlayer.cpp
index f2f58d6..f5c5559 100644
--- a/src/core/GStreamerPlayer.cpp
+++ b/src/core/GStreamerPlayer.cpp
@@ -315,6 +315,35 @@ bool GStreamerPlayer::start_pipeline()
     gst_app_sink_set_caps(m_appsink, vcaps);
     gst_caps_unref(vcaps);
 
+    /* Answer the video decoder's ALLOCATION query ourselves. The branch in
+     * front of appsink (queue, videoconvert, videoscale, capsfilter) is
+     * passthrough for I420 and forwards the query here untouched, and appsink
+     * only answers it through a propose-allocation callback (GStreamer >=
+     * 1.24), so by default the query fails. An unanswered query makes the
+     * decoder assume downstream reads the plain I420 layout: dav1ddec then
+     * copies every frame out of the padded buffers dav1d decodes into (one
+     * 5.5 MB memcpy per 1440p frame). Advertising GstVideoMeta lets it hand
+     * its buffers over as they are; pull_frame() already maps them with
+     * gst_video_frame_map() and pack_i420_to_422() follows the per-plane
+     * strides, so padded buffers need nothing else. A pad probe rather than
+     * the appsink callback keeps this independent of the GStreamer version.
+     * GST_PAD_PROBE_HANDLED makes the query succeed with what was added. */
+    {
+        GstPad* sinkpad = gst_element_get_static_pad(appsink_elem, "sink");
+        gst_pad_add_probe(
+            sinkpad,
+            (GstPadProbeType)(GST_PAD_PROBE_TYPE_QUERY_DOWNSTREAM | GST_PAD_PROBE_TYPE_PUSH),
+            +[](GstPad*, GstPadProbeInfo* info, gpointer) -> GstPadProbeReturn {
+                GstQuery* query = GST_PAD_PROBE_INFO_QUERY(info);
+                if (GST_QUERY_TYPE(query) != GST_QUERY_ALLOCATION)
+                    return GST_PAD_PROBE_OK;
+                gst_query_add_allocation_meta(query, GST_VIDEO_META_API_TYPE, nullptr);
+                return GST_PAD_PROBE_HANDLED;
+            },
+            nullptr, nullptr);
+        gst_object_unref(sinkpad);
+    }
+
     {
         std::lock_guard<std::mutex> lk(m_mutex);
         m_video_codec_name.clear();
