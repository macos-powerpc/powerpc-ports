glfw: do not dereference a NULL video mode when entering fullscreen

glfwGetVideoMode() returns NULL when the Cocoa backend cannot read the
current display mode, which is the case on Mac OS X 10.6 for PowerPC
(its CoreGraphics stubs the 10.6 CGDisplayMode API).  set_fullscreen()
then read mode->refreshRate through the NULL pointer and crashed with
SIGBUS at address 0x14 inside toggle_fullscreen().  Check the monitor
and the mode, print a notice and stay windowed instead.

--- a/src/platform/GlfwPlatform.cpp
+++ b/src/platform/GlfwPlatform.cpp
@@ -165,11 +165,23 @@
 
     if (on)
     {
+        /* Passing the monitor's current mode keeps GLFW from switching the
+         * display resolution. Either query can fail: glfwGetVideoMode()
+         * returns NULL when the Cocoa backend cannot read the current mode
+         * (Mac OS X 10.6 on PowerPC, whose CoreGraphics stubs the 10.6
+         * CGDisplayMode API; GLFW reports it through the error callback
+         * above). Without a mode there is nothing to hand to
+         * glfwSetWindowMonitor(), so stay windowed rather than crash. */
+        GLFWmonitor* monitor = glfwGetPrimaryMonitor();
+        const GLFWvidmode* mode = monitor != nullptr ? glfwGetVideoMode(monitor) : nullptr;
+        if (mode == nullptr)
+        {
+            std::fprintf(stderr, "[glfw] fullscreen unavailable: no video mode for the primary monitor\n");
+            return;
+        }
+
         glfwGetWindowPos(m_window, &m_windowed_x, &m_windowed_y);
         glfwGetWindowSize(m_window, &m_windowed_w, &m_windowed_h);
-
-        GLFWmonitor* monitor = glfwGetPrimaryMonitor();
-        const GLFWvidmode* mode = glfwGetVideoMode(monitor);
         glfwSetWindowMonitor(m_window, monitor, 0, 0, mode->width, mode->height, mode->refreshRate);
     }
     else
