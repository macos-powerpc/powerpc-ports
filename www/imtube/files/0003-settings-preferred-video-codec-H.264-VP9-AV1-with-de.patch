+namespace {
+
+/* yt-dlp format filter for the preferred codec. yt-dlp reports vcodec as
+ * "avc1.64001F", "vp9" or "vp09.00.40.08" (both spellings are in use, hence
+ * the two-letter prefix; VP8 is long gone from YouTube) and "av01.0.08M.08". */
+const char* codec_filter(VideoCodec codec)
+{
+    switch (codec)
+    {
+    case VideoCodec::VP9: return "[vcodec^=vp]";
+    case VideoCodec::AV1: return "[vcodec^=av01]";
+    default:              return "[vcodec^=avc1]";
+    }
+}
+
+/* Merged DASH video+audio alternatives at <= max_height, best first: the
+ * preferred codec, then H.264 (the codec every machine decodes fastest;
+ * without this step yt-dlp's own ordering would rank VP9 above it), then any
+ * codec. Above 360p YouTube only offers separate tracks, hence the merge. */
+std::string merged_alternatives(int max_height, VideoCodec codec)
+{
+    char fmt[256];
+    if (codec == VideoCodec::H264)
+        snprintf(fmt, sizeof(fmt), "bv*[height<=%d]%s+ba/bv*[height<=%d]+ba",
+                 max_height, codec_filter(VideoCodec::H264), max_height);
+    else
+        snprintf(fmt, sizeof(fmt), "bv*[height<=%d]%s+ba/bv*[height<=%d]%s+ba/bv*[height<=%d]+ba",
+                 max_height, codec_filter(codec), max_height, codec_filter(VideoCodec::H264), max_height);
+    return fmt;
+}
+
+/* Desktop playback selector: the merged alternatives, then a progressive
+ * file. H.264 at 360p and below keeps the single progressive file for
+ * instant playback; progressive files are H.264 only, so a VP9/AV1
+ * preference always goes the merged route. */
+std::string playback_selector(int max_height, VideoCodec codec)
+{
+    const char* f = codec_filter(codec);
+    char fmt[320];
+    if (max_height <= 360 && codec == VideoCodec::H264)
+        snprintf(fmt, sizeof(fmt), "b[height<=%d]%s/b[height<=%d]/b/best",
+                 max_height, f, max_height);
+    else
+        snprintf(fmt, sizeof(fmt), "%s/b[height<=%d]%s/b[height<=%d]/b/best",
+                 merged_alternatives(max_height, codec).c_str(), max_height, f, max_height);
+    return fmt;
+}
+
+/* Direct-URL selector for seeking: the same tracks playback_selector() picks,
+ * so a jump keeps the codec and resolution. */
+std::string direct_url_selector(int max_height, VideoCodec codec)
+{
+    const char* f = codec_filter(codec);
+    char fmt[320];
+    snprintf(fmt, sizeof(fmt), "%s/b[height<=%d]%s/b[height<=%d]/b",
+             merged_alternatives(max_height, codec).c_str(), max_height, f, max_height);
+    return fmt;
+}
+
+} /* namespace */
