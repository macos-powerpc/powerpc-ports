+void ImTubeUI::probe_decoders()
+{
+    if (m_decoders_probed)
+        return;
+    m_decoders_probed = true;
+    m_codec_decoders[(int)VideoCodec::H264] = GStreamerPlayer::decoder_for("video/x-h264");
+    m_codec_decoders[(int)VideoCodec::VP9] = GStreamerPlayer::decoder_for("video/x-vp9");
+    m_codec_decoders[(int)VideoCodec::AV1] = GStreamerPlayer::decoder_for("video/x-av1");
+
+    if (m_codec_decoders[(int)m_video_codec].empty() && m_video_codec != VideoCodec::H264)
+    {
+        std::fprintf(stderr, "[imtube] no GStreamer decoder for the preferred codec '%s'; using h264\n",
+                     video_codec_key(m_video_codec));
+        m_video_codec = VideoCodec::H264;
+    }
+}
