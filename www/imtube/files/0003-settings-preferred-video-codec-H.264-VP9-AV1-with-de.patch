+/* decodebin "element-added": print the decoders it autoplugs (it picks them
+ * by rank from the registry; ImTube never chooses one), e.g.
+ * "[gst] decoder: avdec_h264 (libav H.264 decoder)". Demuxers and parsers
+ * are added through the same signal and skipped here. */
+static void on_decodebin_element_added(GstBin* bin, GstElement* element, gpointer user_data)
+{
+    (void)bin;
+    (void)user_data;
+    GstElementFactory* factory = gst_element_get_factory(element);
+    if (factory == nullptr)
+        return;
+    const gchar* klass = gst_element_factory_get_metadata(factory, GST_ELEMENT_METADATA_KLASS);
+    if (klass == nullptr || strstr(klass, "Decoder") == nullptr)
+        return;
+    const gchar* longname = gst_element_factory_get_metadata(factory, GST_ELEMENT_METADATA_LONGNAME);
+    fprintf(stderr, "[gst] decoder: %s (%s)\n",
+            gst_plugin_feature_get_name(GST_PLUGIN_FEATURE(factory)),
+            longname != nullptr ? longname : "");
+}
+
+std::string GStreamerPlayer::decoder_for(const char* caps_string)
+{
+    if (caps_string == nullptr || !ensure_gst_initialized())
+        return std::string();
+
+    GstCaps* caps = gst_caps_from_string(caps_string);
+    if (caps == nullptr)
+        return std::string();
+
+    /* The same pool decodebin draws from: video decoders ranked MARGINAL or
+     * better (rank NONE is never autoplugged), best rank first. */
+    GList* decoders = gst_element_factory_list_get_elements(
+        GST_ELEMENT_FACTORY_TYPE_DECODER | GST_ELEMENT_FACTORY_TYPE_MEDIA_VIDEO, GST_RANK_MARGINAL);
+    GList* usable = gst_element_factory_list_filter(decoders, caps, GST_PAD_SINK, FALSE);
+    usable = g_list_sort(usable, gst_plugin_feature_rank_compare_func);
+
+    std::string name;
+    if (usable != nullptr)
+        name = gst_plugin_feature_get_name(GST_PLUGIN_FEATURE(usable->data));
+
+    gst_plugin_feature_list_free(usable);
+    gst_plugin_feature_list_free(decoders);
+    gst_caps_unref(caps);
+    return name;
+}
+
