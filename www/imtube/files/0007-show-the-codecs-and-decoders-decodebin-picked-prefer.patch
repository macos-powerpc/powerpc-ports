 }
 
-/* decodebin "element-added": print the decoders it autoplugs (it picks them
- * by rank from the registry; ImTube never chooses one), e.g.
+/* Human label for the compressed format a decoder factory accepts, from its
+ * sink pad template ("video/x-h264" -> "H.264"). Falls back to the media
+ * type itself for anything not in the short list. */
+static std::string codec_label_for_factory(GstElementFactory* factory)
+{
+    std::string label;
+    for (const GList* l = gst_element_factory_get_static_pad_templates(factory); l != nullptr; l = l->next)
+    {
+        GstStaticPadTemplate* templ = static_cast<GstStaticPadTemplate*>(l->data);
+        if (templ->direction != GST_PAD_SINK)
+            continue;
+        GstCaps* caps = gst_static_caps_get(&templ->static_caps);
+        if (caps == nullptr)
+            continue;
+        if (gst_caps_get_size(caps) > 0)
+        {
+            const GstStructure* st = gst_caps_get_structure(caps, 0);
+            const char* name = gst_structure_get_name(st);
+            if (strcmp(name, "video/x-h264") == 0)      label = "H.264";
+            else if (strcmp(name, "video/x-h265") == 0) label = "H.265";
+            else if (strcmp(name, "video/x-vp9") == 0)  label = "VP9";
+            else if (strcmp(name, "video/x-vp8") == 0)  label = "VP8";
+            else if (strcmp(name, "video/x-av1") == 0)  label = "AV1";
+            else if (strcmp(name, "audio/x-opus") == 0) label = "Opus";
+            else if (strcmp(name, "audio/x-vorbis") == 0) label = "Vorbis";
+            else if (strcmp(name, "audio/mpeg") == 0)
+            {
+                int ver = 0;
+                label = (gst_structure_get_int(st, "mpegversion", &ver) && ver == 1) ? "MP3" : "AAC";
+            }
+            else
+                label = name;
+        }
+        gst_caps_unref(caps);
+        if (!label.empty())
+            break;
+    }
+    return label;
+}
+
+/* decodebin "element-added": record and print the decoders it autoplugs (it
+ * picks them by rank from the registry; ImTube never chooses one), e.g.
  * "[gst] decoder: avdec_h264 (libav H.264 decoder)". Demuxers and parsers
- * are added through the same signal and skipped here. */
+ * are added through the same signal and skipped here. Runs on a streaming
+ * thread; the names are read by the UI under m_mutex. */
 static void on_decodebin_element_added(GstBin* bin, GstElement* element, gpointer user_data)
 {
     (void)bin;
-    (void)user_data;
     GstElementFactory* factory = gst_element_get_factory(element);
     if (factory == nullptr)
         return;
@@ -155,11 +206,34 @@ static void on_decodebin_element_added(GstBin* bin, GstElement* element, gpointe
     if (klass == nullptr || strstr(klass, "Decoder") == nullptr)
         return;
     const gchar* longname = gst_element_factory_get_metadata(factory, GST_ELEMENT_METADATA_LONGNAME);
-    fprintf(stderr, "[gst] decoder: %s (%s)\n",
-            gst_plugin_feature_get_name(GST_PLUGIN_FEATURE(factory)),
-            longname != nullptr ? longname : "");
+    const char* name = gst_plugin_feature_get_name(GST_PLUGIN_FEATURE(factory));
+    fprintf(stderr, "[gst] decoder: %s (%s)\n", name, longname != nullptr ? longname : "");
+
+    GStreamerPlayer* self = static_cast<GStreamerPlayer*>(user_data);
+    if (self != nullptr)
+        self->note_decoder(strstr(klass, "Video") != nullptr, codec_label_for_factory(factory), name);
 }
 
+void GStreamerPlayer::note_decoder(bool video, const std::string& codec, const std::string& decoder)
+{
+    std::lock_guard<std::mutex> lk(m_mutex);
+    if (video)
+    {
+        m_video_codec_name = codec;
+        m_video_decoder_name = decoder;
+    }
+    else
+    {
+        m_audio_codec_name = codec;
+        m_audio_decoder_name = decoder;
+    }
+}
+
+std::string GStreamerPlayer::video_codec_name() const   { std::lock_guard<std::mutex> lk(m_mutex); return m_video_codec_name; }
+std::string GStreamerPlayer::video_decoder_name() const { std::lock_guard<std::mutex> lk(m_mutex); return m_video_decoder_name; }
+std::string GStreamerPlayer::audio_codec_name() const   { std::lock_guard<std::mutex> lk(m_mutex); return m_audio_codec_name; }
+std::string GStreamerPlayer::audio_decoder_name() const { std::lock_guard<std::mutex> lk(m_mutex); return m_audio_decoder_name; }
+
 std::string GStreamerPlayer::decoder_for(const char* caps_string)
 {
     if (caps_string == nullptr || !ensure_gst_initialized())
@@ -240,7 +314,15 @@ bool GStreamerPlayer::start_pipeline()
     gst_app_sink_set_caps(m_appsink, vcaps);
     gst_caps_unref(vcaps);
 
-    g_signal_connect(decodebin, "element-added", G_CALLBACK(on_decodebin_element_added), nullptr);
+    {
+        std::lock_guard<std::mutex> lk(m_mutex);
+        m_video_codec_name.clear();
+        m_video_decoder_name.clear();
+        m_audio_codec_name.clear();
+        m_audio_decoder_name.clear();
+    }
+    m_frame_fps = 0.0;
+    g_signal_connect(decodebin, "element-added", G_CALLBACK(on_decodebin_element_added), this);
 
     /* Room for the video branch to run behind briefly without blocking the
      * demuxer (and with it the audio): decodebin's default limits for the
@@ -945,6 +1027,7 @@ bool GStreamerPlayer::pull_frame()
                 DBG("pull_frame: got %dx%d frame", info.width, info.height);
                 m_frame_w = info.width;
                 m_frame_h = info.height;
+                m_frame_fps = (info.fps_n > 0 && info.fps_d > 0) ? (double)info.fps_n / (double)info.fps_d : 0.0;
                 if (GST_VIDEO_FRAME_FORMAT(&vframe) == GST_VIDEO_FORMAT_I420 &&
                     is_packed_422(m_video_format))
                 {
diff --git a/src/core/GStreamerPlayer.h b/src/core/GStreamerPlayer.h
index 43a8745..6518c12 100644
--- a/src/core/GStreamerPlayer.h
+++ b/src/core/GStreamerPlayer.h
@@ -120,6 +120,20 @@ public:
     /* Bytes between the starts of consecutive rows of frame_pixels() (the
      * decoder may pad rows); pass it to RenderTexture::upload(). */
     int frame_stride() const { return m_frame_stride; }
+    /* Nominal frame rate of the decoded stream (0 when unknown). */
+    double frame_fps() const { return m_frame_fps; }
+
+    /* What is actually being played, as decodebin set it up: codec labels
+     * ("H.264", "AV1", "Opus", ...) and the decoder elements handling them.
+     * Empty until the pipeline has autoplugged. Shown in the player view so
+     * the stream in use is never a guess. */
+    /* Called by the decodebin hook for each decoder it adds. */
+    void note_decoder(bool video, const std::string& codec, const std::string& decoder);
+
+    std::string video_codec_name() const;
+    std::string video_decoder_name() const;
+    std::string audio_codec_name() const;
+    std::string audio_decoder_name() const;
 
     /* Process pending bus messages (EOS/ERROR). Call from the main thread. */
     void pump_bus();
@@ -205,6 +219,11 @@ private:
     mutable std::mutex m_mutex;
     std::string m_error;
 
+    /* Filled by the decodebin element-added hook (streaming thread). */
+    std::string m_video_codec_name, m_video_decoder_name;
+    std::string m_audio_codec_name, m_audio_decoder_name;
+    double m_frame_fps = 0.0;
+
     /* Latest decoded frame in the negotiated layout (set_video_format();
      * owned here, written by the main thread). */
     std::vector<uint8_t> m_frame;
diff --git a/src/ui/ImTubeUI.cpp b/src/ui/ImTubeUI.cpp
index f7f0e28..683f05c 100644
--- a/src/ui/ImTubeUI.cpp
+++ b/src/ui/ImTubeUI.cpp
@@ -923,6 +923,44 @@ void ImTubeUI::render_video_view()
     }
     ImGui::SameLine();
     ImGui::TextColored(kColTextDim, "Resolution: %dp", m_resolution);
+    /* What is actually being played, as decodebin set it up: never a guess. */
+    {
+        const std::string vcodec = m_player.video_codec_name();
+        const std::string vdec = m_player.video_decoder_name();
+        const std::string acodec = m_player.audio_codec_name();
+        const std::string adec = m_player.audio_decoder_name();
+        const int fw = m_player.frame_width();
+        const int fh = m_player.frame_height();
+        const double fps = m_player.frame_fps();
+        std::string stream;
+        if (!vcodec.empty())
+        {
+            stream = vcodec;
+            if (fw > 0 && fh > 0)
+                stream += " " + std::to_string(fw) + "x" + std::to_string(fh);
+            if (fps > 0.0)
+            {
+                char fpsbuf[32];
+                std::snprintf(fpsbuf, sizeof(fpsbuf), " %.3g fps", fps);
+                stream += fpsbuf;
+            }
+            if (!vdec.empty())
+                stream += " via " + vdec;
+        }
+        if (!acodec.empty())
+        {
+            if (!stream.empty())
+                stream += "  |  ";
+            stream += acodec;
+            if (!adec.empty())
+                stream += " via " + adec;
+        }
+        if (!stream.empty())
+        {
+            ImGui::SameLine();
+            ImGui::TextColored(kColTextDim, "Stream: %s", stream.c_str());
+        }
+    }
     /* A decoder that cannot keep up is invisible otherwise: late frames are
      * still displayed and look smooth, while the audio track quietly ends
      * ahead of the picture. */
