--- /dev/null
+++ b/src/platform/GlfwPlatform.cpp
@@ -0,0 +1,226 @@
+#include "platform/GlfwPlatform.h"
+
+#include "imgui_impl_glfw.h"
+
+#include <cstdio>
+
+namespace imtube {
+
+namespace {
+
+/* GLFW_VERSION_MAJOR/MINOR come from whichever <GLFW/glfw3.h> this was
+ * compiled against, so this is a build-time, not run-time, capability
+ * check (matches the "guard with version macros" approach used for the
+ * ImGui GLFW backend itself). */
+#define IMTUBE_GLFW_VERSION (GLFW_VERSION_MAJOR * 1000 + GLFW_VERSION_MINOR * 100)
+
+void glfw_error_callback(int error, const char* description)
+{
+    std::fprintf(stderr, "[glfw] error %d: %s\n", error, description);
+}
+
+} /* namespace */
+
+const char* GlfwPlatform::name() const
+{
+    static char buf[64];
+    int major = 0, minor = 0, rev = 0;
+    glfwGetVersion(&major, &minor, &rev);
+
+    /* The windowing platform (cocoa, x11, wayland, ...) decides which GL
+     * library owns the context, so it belongs in every diagnostic line.
+     * glfwGetPlatform() is 3.4+; it returns GLFW_PLATFORM_NULL (0) before
+     * glfwInit(), which is reported as "not initialised". */
+    const char* platform = "";
+#if IMTUBE_GLFW_VERSION >= 3400
+    switch (glfwGetPlatform())
+    {
+    case GLFW_PLATFORM_COCOA:   platform = " (cocoa)"; break;
+    case GLFW_PLATFORM_X11:     platform = " (x11)"; break;
+    case GLFW_PLATFORM_WAYLAND: platform = " (wayland)"; break;
+    case GLFW_PLATFORM_WIN32:   platform = " (win32)"; break;
+    default:                    platform = " (not initialised)"; break;
+    }
+#endif
+    std::snprintf(buf, sizeof(buf), "GLFW %d.%d.%d%s", major, minor, rev, platform);
+    return buf;
+}
+
+bool GlfwPlatform::init(const char* title, int width, int height, ContextKind kind)
+{
+    glfwSetErrorCallback(glfw_error_callback);
+
+    if (!glfwInit())
+    {
+        std::fprintf(stderr, "glfwInit() failed\n");
+        return false;
+    }
+
+    if (kind == ContextKind::OpenGLES3)
+    {
+        glfwWindowHint(GLFW_CLIENT_API, GLFW_OPENGL_ES_API);
+        glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
+        glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 2);
+    }
+    else /* ContextKind::OpenGL: no version/profile hint -> legacy context. */
+    {
+        glfwWindowHint(GLFW_CLIENT_API, GLFW_OPENGL_API);
+    }
+    /* GLFW_DOUBLEBUFFER defaults to true and GLFW_SRGB_CAPABLE defaults to
+     * false; both already match what the SDL platforms request explicitly,
+     * so nothing more to set here. */
+
+    m_window = glfwCreateWindow(width, height, title, nullptr, nullptr);
+    if (m_window == nullptr)
+    {
+        std::fprintf(stderr, "glfwCreateWindow() failed\n");
+        return false;
+    }
+
+    glfwMakeContextCurrent(m_window);
+    glfwSwapInterval(1); /* best-effort vsync */
+
+    std::fprintf(stderr, "[platform] %s\n", name());
+    return true;
+}
+
+void GlfwPlatform::shutdown()
+{
+    /* Defensive: an ImGui platform backend still bound to m_window must go
+     * first, in case a caller skipped the normal shutdown_imgui() step. */
+    if (m_imgui_initialized)
+        shutdown_imgui();
+
+    if (m_window != nullptr)
+    {
+        glfwDestroyWindow(m_window);
+        m_window = nullptr;
+    }
+    glfwTerminate(); /* safe even if glfwInit() was never called or already terminated */
+}
+
+bool GlfwPlatform::init_imgui()
+{
+    if (!ImGui_ImplGlfw_InitForOpenGL(m_window, true /* install_callbacks */))
+    {
+        std::fprintf(stderr, "Error: ImGui_ImplGlfw_InitForOpenGL() failed\n");
+        return false;
+    }
+    m_imgui_initialized = true;
+    return true;
+}
+
+void GlfwPlatform::shutdown_imgui()
+{
+    if (!m_imgui_initialized)
+        return;
+    ImGui_ImplGlfw_Shutdown();
+    m_imgui_initialized = false;
+}
+
+void GlfwPlatform::new_frame()
+{
+    ImGui_ImplGlfw_NewFrame();
+}
+
+bool GlfwPlatform::pump_events(int timeout_ms)
+{
+#if IMTUBE_GLFW_VERSION >= 3200
+    if (timeout_ms > 0)
+        glfwWaitEventsTimeout(timeout_ms / 1000.0);
+    else
+        glfwPollEvents();
+#else
+    (void)timeout_ms; /* GLFW < 3.2 has no wait-with-timeout; busy-poll instead */
+    glfwPollEvents();
+#endif
+
+    return !(glfwWindowShouldClose(m_window) || m_quit_requested);
+}
+
+void GlfwPlatform::swap_buffers()
+{
+    if (m_window != nullptr)
+        glfwSwapBuffers(m_window);
+}
+
+void GlfwPlatform::request_quit()
+{
+    m_quit_requested = true;
+    if (m_window != nullptr)
+        glfwSetWindowShouldClose(m_window, GLFW_TRUE);
+#if IMTUBE_GLFW_VERSION >= 3100
+    glfwPostEmptyEvent(); /* wakes a thread blocked in glfwWaitEventsTimeout() */
+#endif
+}
+
+void GlfwPlatform::set_fullscreen(bool on)
+{
+    if (m_window == nullptr)
+        return;
+
+#if IMTUBE_GLFW_VERSION >= 3200
+    if (on == is_fullscreen())
+        return;
+
+    if (on)
+    {
+        glfwGetWindowPos(m_window, &m_windowed_x, &m_windowed_y);
+        glfwGetWindowSize(m_window, &m_windowed_w, &m_windowed_h);
+
+        GLFWmonitor* monitor = glfwGetPrimaryMonitor();
+        const GLFWvidmode* mode = glfwGetVideoMode(monitor);
+        glfwSetWindowMonitor(m_window, monitor, 0, 0, mode->width, mode->height, mode->refreshRate);
+    }
+    else
+    {
+        glfwSetWindowMonitor(m_window, nullptr, m_windowed_x, m_windowed_y,
+                              m_windowed_w, m_windowed_h, 0);
+    }
+#else
+    (void)on;
+    if (!m_fullscreen_warned)
+    {
+        std::fprintf(stderr, "[glfw] fullscreen toggle requires GLFW 3.2+ (running %s); ignoring\n", name());
+        m_fullscreen_warned = true;
+    }
+#endif
+}
+
+bool GlfwPlatform::is_fullscreen() const
+{
+    if (m_window == nullptr)
+        return false;
+    return glfwGetWindowMonitor(m_window) != nullptr;
+}
+
+void GlfwPlatform::set_title(const char* title)
+{
+    if (m_window != nullptr)
+        glfwSetWindowTitle(m_window, title);
+}
+
+void GlfwPlatform::get_window_pos(int* x, int* y) const
+{
+    if (m_window != nullptr)
+        glfwGetWindowPos(m_window, x, y);
+}
+
+void GlfwPlatform::get_window_size(int* w, int* h) const
+{
+    if (m_window != nullptr)
+        glfwGetWindowSize(m_window, w, h);
+}
+
+void GlfwPlatform::get_framebuffer_size(int* w, int* h) const
+{
+    if (m_window != nullptr)
+        glfwGetFramebufferSize(m_window, w, h);
+}
+
+void* GlfwPlatform::native_window() const
+{
+    return m_window;
+}
+
+} /* namespace imtube */
diff --git a/src/platform/GlfwPlatform.h b/src/platform/GlfwPlatform.h
new file mode 100644
index 0000000..595881e
--- /dev/null
+++ b/src/platform/GlfwPlatform.h
@@ -0,0 +1,68 @@
+#pragma once
+
+/* GLFW windowing platform (CMake IMTUBE_PLATFORM=glfw), the alternative to
+ * SDL2 for the same legacy-OpenGL path. The PowerPC MacPorts tree carries a
+ * current GLFW (3.5.x, Cocoa), which has everything used here; the code
+ * still compiles against GLFW 3.0 because a handful of calls only exist from
+ * 3.1 or 3.2 onward (glfwPostEmptyEvent, glfwWaitEventsTimeout,
+ * glfwSetWindowMonitor): GlfwPlatform.cpp guards those behind a
+ * compile-time version check and degrades gracefully (poll instead of
+ * wait-with-timeout; no fullscreen toggle) on an older library. */
+
+#include "platform/Platform.h"
+
+#include <GLFW/glfw3.h>
+
+namespace imtube {
+
+class GlfwPlatform : public Platform {
+public:
+    GlfwPlatform() = default;
+    ~GlfwPlatform() override { shutdown(); }
+
+    GlfwPlatform(const GlfwPlatform&) = delete;
+    GlfwPlatform& operator=(const GlfwPlatform&) = delete;
+
+    const char* name() const override;
+
+    bool init(const char* title, int width, int height, ContextKind kind) override;
+    void shutdown() override;
+
+    bool init_imgui() override;
+    void shutdown_imgui() override;
+    void new_frame() override;
+
+    bool pump_events(int timeout_ms) override;
+    void swap_buffers() override;
+    void request_quit() override;
+
+    void set_fullscreen(bool on) override;
+    bool is_fullscreen() const override;
+
+    void set_title(const char* title) override;
+
+    void get_window_pos(int* x, int* y) const override;
+    void get_window_size(int* w, int* h) const override;
+    void get_framebuffer_size(int* w, int* h) const override;
+
+    void* native_window() const override;
+
+private:
+    GLFWwindow* m_window = nullptr;
+    bool m_imgui_initialized = false;
+    bool m_quit_requested = false;
+
+    /* Windowed geometry saved on entering fullscreen and restored on
+     * leaving it (GLFW models fullscreen as "the window now occupies a
+     * monitor"; there is no separate borderless-window state to fall back
+     * to, so the caller - us - has to remember where the window was). */
+    int m_windowed_x = 0;
+    int m_windowed_y = 0;
+    int m_windowed_w = 0;
+    int m_windowed_h = 0;
+
+    /* Print the "GLFW is too old for fullscreen" note only once. */
+    bool m_fullscreen_warned = false;
+};
+
+} /* namespace imtube */
diff --git a/src/platform/Platform.h b/src/platform/Platform.h
new file mode 100644
index 0000000..93d7d35
--- /dev/null
+++ b/src/platform/Platform.h
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <memory>
+
+namespace imtube {
+
+/* Which kind of drawing surface the renderer needs the platform to create. */
+enum class ContextKind {
+    OpenGL,     /* legacy desktop OpenGL: no version/profile request, fixed function is enough */
+    OpenGLES3   /* OpenGL ES 3.2 (GlesContext) */
+};
+
+/* Windowing layer: window, input events, GL context and the Dear ImGui
+ * *platform* backend (ImGui_ImplSDL2/SDL3/Glfw). The rendering backend
+ * (RenderBackend) never talks to the windowing library except through this
+ * interface, so SDL2, SDL3 and GLFW are interchangeable at build time
+ * (CMake: IMTUBE_PLATFORM=sdl2|sdl3|glfw).
+ *
+ * Lifecycle, driven by App:
+ *   1. init(title, w, h, kind)      window (+ GL context made current for GL kinds)
+ *   2. RenderBackend::init(*this)
+ *   3. ImGui::CreateContext()
+ *   4. init_imgui()                 ImGui platform backend
+ *   5. RenderBackend::init_imgui()
+ *   6. per frame: pump_events() -> RenderBackend::new_frame() -> new_frame()
+ *                 -> ImGui::NewFrame() ... ImGui::Render()
+ *                 -> RenderBackend::render() -> RenderBackend::present() -> swap_buffers()
+ *   7. RenderBackend::shutdown() -> shutdown_imgui() -> ImGui::DestroyContext() -> shutdown()
+ *
+ * All functions are main-thread only. */
+class Platform {
+public:
+    virtual ~Platform() = default;
+
+    /* Human-readable name with the runtime library version and, once init()
+     * has run, the video driver / windowing platform in use, e.g.
+     * "SDL 2.30.9 (cocoa)". The driver is what decides which GL library owns
+     * the context, so it is part of every diagnostic line. */
+    virtual const char* name() const = 0;
+
+    /* Create the window and the GL context of the requested kind, and make
+     * the context current on the calling thread (vsync requested best-effort). */
+    virtual bool init(const char* title, int width, int height, ContextKind kind) = 0;
+
+    /* Destroy the GL context and window and quit the library. Idempotent. */
+    virtual void shutdown() = 0;
+
+    /* ImGui platform backend. Call after ImGui::CreateContext(). */
+    virtual bool init_imgui() = 0;
+    virtual void shutdown_imgui() = 0;
+
+    /* ImGui platform NewFrame (ImGui_ImplXXX_NewFrame()). */
+    virtual void new_frame() = 0;
+
+    /* Wait up to timeout_ms for input (0 = just poll), then process every
+     * pending event, feeding them to the ImGui platform backend. Returns false
+     * once the user asked to quit (window close button or request_quit()). */
+    virtual bool pump_events(int timeout_ms) = 0;
+
+    /* Present the GL back buffer. */
+    virtual void swap_buffers() = 0;
+
+    /* Make the next pump_events() return false (and wake it if waiting). */
+    virtual void request_quit() = 0;
+
+    /* Borderless fullscreen on the window's display. */
+    virtual void set_fullscreen(bool on) = 0;
+    virtual bool is_fullscreen() const = 0;
+
+    virtual void set_title(const char* title) = 0;
+
+    /* Window position/size in screen coordinates (debug geometry dumps). */
+    virtual void get_window_pos(int* x, int* y) const = 0;
+    virtual void get_window_size(int* w, int* h) const = 0;
+
+    /* Drawable size in pixels (swapchain recreation). */
+    virtual void get_framebuffer_size(int* w, int* h) const = 0;
+
+    /* Native window handle (SDL_Window* or GLFWwindow*) for code that must
+     * talk to the windowing library directly. No current renderer needs it. */
+    virtual void* native_window() const = 0;
+};
+
+/* Creates the compile-time-selected platform (SdlPlatform unless
+ * IMTUBE_PLATFORM_GLFW is defined). Defined in App.cpp. */
+std::unique_ptr<Platform> create_platform();
+
+} /* namespace imtube */
diff --git a/src/platform/SdlPlatform.cpp b/src/platform/SdlPlatform.cpp
new file mode 100644
index 0000000..02ca4c0
--- /dev/null
+++ b/src/platform/SdlPlatform.cpp
@@ -0,0 +1,343 @@
+#include "platform/SdlPlatform.h"
+
+#if defined(IMTUBE_PLATFORM_SDL2)
+#include "imgui_impl_sdl2.h"
+#elif defined(IMTUBE_PLATFORM_SDL3)
+#include "imgui_impl_sdl3.h"
+#endif
+
+#include <cstdio>
+#include <cstring>
+
+namespace imtube {
+
+namespace {
+
+/* ---- the handful of spots where SDL2 and SDL3 disagree ----------------
+ * Everything else below (attribute setting, window pos/size queries, GL
+ * swap, title, fullscreen-flag test, ...) has an identical signature and
+ * meaning in both libraries and is called directly, without a wrapper. */
+
+#if defined(IMTUBE_PLATFORM_SDL2)
+
+/* SDL2: SDL_CreateWindow(title, x, y, w, h, flags); flags is Uint32. */
+SDL_Window* create_window(const char* title, int w, int h, Uint32 flags)
+{
+    return SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, w, h, flags);
+}
+
+/* SDL2: 0 on success. */
+bool gl_make_current(SDL_Window* window, SDL_GLContext ctx)
+{
+    return SDL_GL_MakeCurrent(window, ctx) == 0;
+}
+
+void gl_destroy_context(SDL_GLContext ctx)
+{
+    SDL_GL_DeleteContext(ctx);
+}
+
+/* SDL2 has no borderless-fullscreen bit of its own; FULLSCREEN_DESKTOP is
+ * SDL2's non-video-mode-switching fullscreen and is what we want here. */
+void set_window_fullscreen(SDL_Window* window, bool on)
+{
+    SDL_SetWindowFullscreen(window, on ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+}
+
+void get_drawable_size(SDL_Window* window, int* w, int* h)
+{
+    SDL_GL_GetDrawableSize(window, w, h);
+}
+
+bool imgui_init_for_opengl(SDL_Window* window, SDL_GLContext ctx)
+{
+    return ImGui_ImplSDL2_InitForOpenGL(window, ctx);
+}
+
+void imgui_shutdown() { ImGui_ImplSDL2_Shutdown(); }
+void imgui_new_frame() { ImGui_ImplSDL2_NewFrame(); }
+void imgui_process_event(const SDL_Event* event) { ImGui_ImplSDL2_ProcessEvent(event); }
+
+#else /* IMTUBE_PLATFORM_SDL3 */
+
+/* SDL3: SDL_CreateWindow(title, w, h, flags); no x/y (always centered by
+ * the window manager); flags is the wider SDL_WindowFlags. */
+SDL_Window* create_window(const char* title, int w, int h, SDL_WindowFlags flags)
+{
+    return SDL_CreateWindow(title, w, h, flags);
+}
+
+/* SDL3: true on success. */
+bool gl_make_current(SDL_Window* window, SDL_GLContext ctx)
+{
+    return SDL_GL_MakeCurrent(window, ctx);
+}
+
+void gl_destroy_context(SDL_GLContext ctx)
+{
+    SDL_GL_DestroyContext(ctx);
+}
+
+/* SDL3 folded FULLSCREEN_DESKTOP into a plain bool: there is only one
+ * fullscreen mode and the window manager decides how it looks. */
+void set_window_fullscreen(SDL_Window* window, bool on)
+{
+    SDL_SetWindowFullscreen(window, on);
+}
+
+void get_drawable_size(SDL_Window* window, int* w, int* h)
+{
+    SDL_GetWindowSizeInPixels(window, w, h);
+}
+
+bool imgui_init_for_opengl(SDL_Window* window, SDL_GLContext ctx)
+{
+    return ImGui_ImplSDL3_InitForOpenGL(window, ctx);
+}
+
+void imgui_shutdown() { ImGui_ImplSDL3_Shutdown(); }
+void imgui_new_frame() { ImGui_ImplSDL3_NewFrame(); }
+void imgui_process_event(const SDL_Event* event) { ImGui_ImplSDL3_ProcessEvent(event); }
+
+#endif
+
+} /* namespace */
+
+const char* SdlPlatform::name() const
+{
+    static char buf[64];
+    /* The video driver (cocoa, x11, wayland, ...) decides which GL library
+     * owns the context, so it belongs in every diagnostic line. Null until
+     * SDL_Init(); same call in SDL2 and SDL3. */
+    const char* driver = SDL_GetCurrentVideoDriver();
+#if defined(IMTUBE_PLATFORM_SDL2)
+    SDL_version v;
+    SDL_GetVersion(&v);
+    std::snprintf(buf, sizeof(buf), "SDL %d.%d.%d (%s)", v.major, v.minor, v.patch,
+                  driver != nullptr ? driver : "no video driver");
+#else
+    const int v = SDL_GetVersion();
+    std::snprintf(buf, sizeof(buf), "SDL %d.%d.%d (%s)",
+                  SDL_VERSIONNUM_MAJOR(v), SDL_VERSIONNUM_MINOR(v), SDL_VERSIONNUM_MICRO(v),
+                  driver != nullptr ? driver : "no video driver");
+#endif
+    return buf;
+}
+
+bool SdlPlatform::init(const char* title, int width, int height, ContextKind kind)
+{
+#if defined(IMTUBE_PLATFORM_SDL2)
+    if (SDL_Init(SDL_INIT_VIDEO) != 0)
+#else
+    if (!SDL_Init(SDL_INIT_VIDEO))
+#endif
+    {
+        std::fprintf(stderr, "SDL_Init: %s\n", SDL_GetError());
+        return false;
+    }
+    SDL_SetHint(SDL_HINT_VIDEO_X11_NET_WM_BYPASS_COMPOSITOR, "0");
+
+    /* GL attributes must be requested before SDL_CreateWindow(); both
+     * libraries share this attribute set/enum, only the SRGB hint differs. */
+    if (kind == ContextKind::OpenGLES3)
+    {
+        SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+        SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+        SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 2);
+    }
+    /* ContextKind::OpenGL: no version/profile request at all, which is what
+     * yields the legacy desktop context on Mac OS X 10.4-10.5 (and a
+     * compatibility context elsewhere). */
+
+    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+
+    /* ImGui writes already-sRGB-encoded colours; a linear (non-sRGB) default
+     * framebuffer is required or the GPU re-encodes on write and visibly
+     * brightens the whole UI. */
+    SDL_GL_SetAttribute(SDL_GL_FRAMEBUFFER_SRGB_CAPABLE, 0);
+#if defined(IMTUBE_PLATFORM_SDL3)
+    SDL_SetHint(SDL_HINT_OPENGL_FORCE_SRGB_FRAMEBUFFER, "0"); /* no SDL2 equivalent */
+#endif
+
+#if defined(IMTUBE_PLATFORM_SDL2)
+    const Uint32 flags = SDL_WINDOW_RESIZABLE | SDL_WINDOW_OPENGL;
+#else
+    const SDL_WindowFlags flags = SDL_WINDOW_RESIZABLE | SDL_WINDOW_OPENGL;
+#endif
+
+    m_window = create_window(title, width, height, flags);
+    if (m_window == nullptr)
+    {
+        std::fprintf(stderr, "SDL_CreateWindow: %s\n", SDL_GetError());
+        return false;
+    }
+
+    m_gl_context = SDL_GL_CreateContext(m_window);
+    if (m_gl_context == nullptr)
+    {
+        std::fprintf(stderr, "SDL_GL_CreateContext: %s\n", SDL_GetError());
+        return false;
+    }
+    if (!gl_make_current(m_window, m_gl_context))
+    {
+        std::fprintf(stderr, "SDL_GL_MakeCurrent: %s\n", SDL_GetError());
+        return false;
+    }
+    SDL_GL_SetSwapInterval(1); /* best-effort vsync; ignore failure */
+
+    std::fprintf(stderr, "[platform] %s\n", name());
+    return true;
+}
+
+void SdlPlatform::shutdown()
+{
+    /* Defensive: an ImGui platform backend still bound to m_window must go
+     * first, in case a caller skipped the normal shutdown_imgui() step. */
+    if (m_imgui_initialized)
+        shutdown_imgui();
+
+    if (m_gl_context != nullptr)
+    {
+        gl_destroy_context(m_gl_context);
+        m_gl_context = nullptr;
+    }
+    if (m_window != nullptr)
+    {
+        SDL_DestroyWindow(m_window);
+        m_window = nullptr;
+    }
+    SDL_Quit(); /* safe even if SDL_Init() was never called or already quit */
+}
+
+bool SdlPlatform::init_imgui()
+{
+    if (m_window == nullptr || m_gl_context == nullptr)
+        return false;
+
+    if (!imgui_init_for_opengl(m_window, m_gl_context))
+    {
+        std::fprintf(stderr, "Error: ImGui SDL platform backend init failed\n");
+        return false;
+    }
+    m_imgui_initialized = true;
+    return true;
+}
+
+void SdlPlatform::shutdown_imgui()
+{
+    if (!m_imgui_initialized)
+        return;
+    imgui_shutdown();
+    m_imgui_initialized = false;
+}
+
+void SdlPlatform::new_frame()
+{
+    imgui_new_frame();
+}
+
+void SdlPlatform::process_event(const SDL_Event& event)
+{
+    imgui_process_event(&event);
+
+#if defined(IMTUBE_PLATFORM_SDL2)
+    if (event.type == SDL_QUIT)
+        m_quit_requested = true;
+    else if (event.type == SDL_WINDOWEVENT &&
+             event.window.event == SDL_WINDOWEVENT_CLOSE &&
+             event.window.windowID == SDL_GetWindowID(m_window))
+        m_quit_requested = true;
+#else
+    if (event.type == SDL_EVENT_QUIT)
+        m_quit_requested = true;
+    else if (event.type == SDL_EVENT_WINDOW_CLOSE_REQUESTED &&
+             event.window.windowID == SDL_GetWindowID(m_window))
+        m_quit_requested = true;
+#endif
+}
+
+bool SdlPlatform::pump_events(int timeout_ms)
+{
+    SDL_Event event;
+
+    /* SDL_WaitEventTimeout returns non-zero/true when it dequeued an event
+     * (int 1 in SDL2, bool true in SDL3 - both truthy here); a plain
+     * timeout returns zero/false and event is left untouched. */
+    if (timeout_ms > 0 && SDL_WaitEventTimeout(&event, timeout_ms))
+        process_event(event);
+
+    while (SDL_PollEvent(&event))
+        process_event(event);
+
+    return !m_quit_requested;
+}
+
+void SdlPlatform::swap_buffers()
+{
+    if (m_window != nullptr)
+        SDL_GL_SwapWindow(m_window);
+}
+
+void SdlPlatform::request_quit()
+{
+    m_quit_requested = true;
+
+    /* Push a quit event so a thread blocked in SDL_WaitEventTimeout() (in
+     * pump_events()) wakes up immediately instead of waiting out the
+     * timeout. */
+    SDL_Event event;
+    std::memset(&event, 0, sizeof(event));
+#if defined(IMTUBE_PLATFORM_SDL2)
+    event.type = SDL_QUIT;
+#else
+    event.type = SDL_EVENT_QUIT;
+#endif
+    SDL_PushEvent(&event);
+}
+
+void SdlPlatform::set_fullscreen(bool on)
+{
+    if (m_window != nullptr)
+        set_window_fullscreen(m_window, on);
+}
+
+bool SdlPlatform::is_fullscreen() const
+{
+    if (m_window == nullptr)
+        return false;
+    /* SDL_WINDOW_FULLSCREEN_DESKTOP (SDL2) always carries the plain
+     * SDL_WINDOW_FULLSCREEN bit too, so this single test works for both
+     * libraries and both of SDL2's fullscreen styles. */
+    return (SDL_GetWindowFlags(m_window) & SDL_WINDOW_FULLSCREEN) != 0;
+}
+
+void SdlPlatform::set_title(const char* title)
+{
+    if (m_window != nullptr)
+        SDL_SetWindowTitle(m_window, title);
+}
+
+void SdlPlatform::get_window_pos(int* x, int* y) const
+{
+    if (m_window != nullptr)
+        SDL_GetWindowPosition(m_window, x, y);
+}
+
+void SdlPlatform::get_window_size(int* w, int* h) const
+{
+    if (m_window != nullptr)
+        SDL_GetWindowSize(m_window, w, h);
+}
+
+void SdlPlatform::get_framebuffer_size(int* w, int* h) const
+{
+    if (m_window != nullptr)
+        get_drawable_size(m_window, w, h);
+}
+
+void* SdlPlatform::native_window() const
+{
+    return m_window;
+}
+
+} /* namespace imtube */
diff --git a/src/platform/SdlPlatform.h b/src/platform/SdlPlatform.h
new file mode 100644
index 0000000..205ee86
--- /dev/null
+++ b/src/platform/SdlPlatform.h
@@ -0,0 +1,71 @@
+#pragma once
+
+/* SDL windowing platform (CMake IMTUBE_PLATFORM=sdl2|sdl3).
+ *
+ * One source serves both SDL generations; the build defines exactly one of
+ *   IMTUBE_PLATFORM_SDL2  ->  #include <SDL.h>,      links libSDL2
+ *   IMTUBE_PLATFORM_SDL3  ->  #include <SDL3/SDL.h>, links libSDL3
+ * The two libraries disagree on a handful of return-value conventions and a
+ * few call shapes (SDL_Init: int 0-success vs. bool; SDL_CreateWindow's
+ * parameter list; SDL2's umbrella SDL_WINDOWEVENT vs. SDL3's flat
+ * SDL_EVENT_WINDOW_*; ...). SdlPlatform.cpp keeps every such difference
+ * behind small #if blocks or tiny static helper functions so the shared
+ * control flow (init order, event pump, shutdown order) is written once.
+ * SDL2 is the primary target: it is what runs on PowerPC Macs on 10.4/10.5. */
+
+#include "platform/Platform.h"
+
+#if defined(IMTUBE_PLATFORM_SDL2)
+#include <SDL.h>
+#elif defined(IMTUBE_PLATFORM_SDL3)
+#include <SDL3/SDL.h>
+#else
+#error "SdlPlatform.h requires IMTUBE_PLATFORM_SDL2 or IMTUBE_PLATFORM_SDL3 to be defined"
+#endif
+
+namespace imtube {
+
+class SdlPlatform : public Platform {
+public:
+    SdlPlatform() = default;
+    ~SdlPlatform() override { shutdown(); }
+
+    SdlPlatform(const SdlPlatform&) = delete;
+    SdlPlatform& operator=(const SdlPlatform&) = delete;
+
+    const char* name() const override;
+
+    bool init(const char* title, int width, int height, ContextKind kind) override;
+    void shutdown() override;
+
+    bool init_imgui() override;
+    void shutdown_imgui() override;
+    void new_frame() override;
+
+    bool pump_events(int timeout_ms) override;
+    void swap_buffers() override;
+    void request_quit() override;
+
+    void set_fullscreen(bool on) override;
+    bool is_fullscreen() const override;
+
+    void set_title(const char* title) override;
+
+    void get_window_pos(int* x, int* y) const override;
+    void get_window_size(int* w, int* h) const override;
+    void get_framebuffer_size(int* w, int* h) const override;
+
+    void* native_window() const override;
+
+private:
+    /* Feed one SDL_Event to the ImGui platform backend and update
+     * m_quit_requested for a quit/close-button event. */
+    void process_event(const SDL_Event& event);
+
+    SDL_Window* m_window = nullptr;
+    SDL_GLContext m_gl_context = nullptr;
+    bool m_imgui_initialized = false;
+    bool m_quit_requested = false;
+};
+
+} /* namespace imtube */
diff --git a/src/render/Gl2Context.cpp b/src/render/Gl2Context.cpp
new file mode 100644
index 0000000..c71fc5b
--- /dev/null
+++ b/src/render/Gl2Context.cpp
@@ -0,0 +1,149 @@
+#include "render/Gl2Context.h"
+
+#include "render/Gl2Texture.h"
+#include "render/GlHeaders.h"
+
+#include "imgui_impl_opengl2.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace imtube {
+
+namespace {
+
+/* True if `extensions` (a space-separated GL_EXTENSIONS string) contains
+ * `name` as a standalone token, not merely as a substring. A plain strstr()
+ * would also match a hypothetical longer extension that happens to start
+ * with the same characters (e.g. some future "GL_ARB_texture_non_power_of_
+ * two_ext"), so every candidate match is checked for a space or a string
+ * boundary on both sides before it counts. `extensions` may be null (some
+ * contexts return null instead of an empty string); that means "unknown", so
+ * treat it as not present. */
+bool has_extension_token(const char* extensions, const char* name)
+{
+    if (extensions == nullptr || name == nullptr || name[0] == '\0')
+        return false;
+
+    const size_t name_len = strlen(name);
+    const char* p = extensions;
+    for (;;)
+    {
+        const char* found = strstr(p, name);
+        if (found == nullptr)
+            return false;
+
+        const bool start_ok = (found == extensions) || (found[-1] == ' ');
+        const bool end_ok = (found[name_len] == '\0') || (found[name_len] == ' ');
+        if (start_ok && end_ok)
+            return true;
+
+        p = found + name_len;
+    }
+}
+
+} /* namespace */
+
+bool Gl2Context::init(Platform& platform)
+{
+    /* The platform already made the GL context current. GL_VERSION is never
+     * null on a current context, so a null here means the libGL this binary
+     * is linked against is not the one that owns the platform's context (the
+     * calls land in a library with no current context and every one of them
+     * silently fails). The classic case is macOS: the Cocoa driver's context
+     * belongs to the system OpenGL.framework, but a build that linked Mesa's
+     * X11 libGL (what find_package(OpenGL) returns under MacPorts' cmake once
+     * the mesa port is installed) prints "glGetString called without a
+     * rendering context" and shows a black window. Fail here with the
+     * explanation instead. */
+    const GLubyte* version_str = glGetString(GL_VERSION);
+    if (version_str == nullptr)
+    {
+        fprintf(stderr,
+                "Error: glGetString(GL_VERSION) returned NULL although %s created a GL context:\n"
+                "  the OpenGL library this binary is linked against is not the one behind that\n"
+                "  context. On macOS the Cocoa video driver needs the system OpenGL.framework\n"
+                "  (cmake -DIMTUBE_MACOS_GL=framework, the default); Mesa's X11 libGL only works\n"
+                "  with -DIMTUBE_MACOS_GL=x11 and SDL_VIDEODRIVER=x11 under XQuartz.\n",
+                platform.name());
+        return false;
+    }
+
+    const GLubyte* renderer_str = glGetString(GL_RENDERER);
+    const GLubyte* extensions_str = glGetString(GL_EXTENSIONS);
+
+    const char* renderer = renderer_str ? reinterpret_cast<const char*>(renderer_str) : "unknown renderer";
+    const char* version = reinterpret_cast<const char*>(version_str);
+    const char* extensions = extensions_str ? reinterpret_cast<const char*>(extensions_str) : nullptr;
+
+    GLint max_tex = 0;
+    glGetIntegerv(GL_MAX_TEXTURE_SIZE, &max_tex);
+    m_max_texture_size = max_tex > 0 ? (int)max_tex : 0;
+
+    /* Do not infer NPOT support from the GL version: GL 2.0 makes it
+     * mandatory on paper, but Apple's 10.4/10.5 drivers for the R300/NV3x
+     * generation (Radeon 9600/X800, GeForce FX) report 2.0 without listing
+     * GL_ARB_texture_non_power_of_two, and hardware without it would fall
+     * back to software rendering. The extension string is the signal that
+     * matches Apple's own capability tables. IMTUBE_GL_FORCE_POT forces the
+     * padded path for testing on capable hardware. */
+    m_npot = has_extension_token(extensions, "GL_ARB_texture_non_power_of_two");
+    if (getenv("IMTUBE_GL_FORCE_POT") != nullptr)
+        m_npot = false;
+
+    char line[256];
+    snprintf(line, sizeof(line), "%s, GL %s, max texture %d, NPOT %s",
+             renderer, version, m_max_texture_size, m_npot ? "yes" : "no");
+    m_description = line;
+    fprintf(stderr, "[gl2] %s\n", m_description.c_str());
+
+    m_initialized = true;
+    return true;
+}
+
+bool Gl2Context::init_imgui()
+{
+    if (!m_initialized)
+        return false;
+
+    if (!ImGui_ImplOpenGL2_Init())
+    {
+        fprintf(stderr, "Error: ImGui_ImplOpenGL2_Init() failed\n");
+        return false;
+    }
+    m_imgui_initialized = true;
+    return true;
+}
+
+void Gl2Context::shutdown()
+{
+    if (m_imgui_initialized)
+    {
+        ImGui_ImplOpenGL2_Shutdown();
+        m_imgui_initialized = false;
+    }
+    m_initialized = false;
+}
+
+void Gl2Context::new_frame()
+{
+    ImGui_ImplOpenGL2_NewFrame();
+}
+
+void Gl2Context::render(ImDrawData* draw_data)
+{
+    glClearColor(0.06f, 0.06f, 0.07f, 1.0f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    /* imgui_impl_opengl2 sets its own viewport/scissor/ortho projection from
+     * draw_data, and legacy GL has no persistent shader/VAO state to restore
+     * around it, so there is nothing else to set up here. */
+    ImGui_ImplOpenGL2_RenderDrawData(draw_data);
+}
+
+std::unique_ptr<RenderTexture> Gl2Context::create_texture(int width, int height)
+{
+    return std::make_unique<Gl2Texture>(width, height, /*pad_to_pot=*/!m_npot, m_max_texture_size);
+}
+
+} /* namespace imtube */
diff --git a/src/render/Gl2Context.h b/src/render/Gl2Context.h
new file mode 100644
index 0000000..5efaacf
--- /dev/null
+++ b/src/render/Gl2Context.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include "render/RenderBackend.h"
+
+#include <string>
+
+namespace imtube {
+
+class Gl2Texture;
+
+/* Legacy (fixed-function) OpenGL renderer backend for ImGui.
+ *
+ * Target: G4/G5 Power Macs running Mac OS X 10.4/10.5. Their GPUs span
+ * Rage 128, GeForce 2/4 MX and Radeon 7500/9200 (no shaders at all) up to
+ * Radeon 9600/X800 and GeForce FX/6800 (GLSL only via ARB extensions, and
+ * often no non-power-of-two textures, see Gl2Texture). The same code runs
+ * unmodified on Linux/Mesa and on any modern box handing out a legacy or
+ * compatibility GL context, so it is not exclusively a PowerPC code path.
+ *
+ * Fixed-function was chosen over the shader-based backend (GlesContext)
+ * because it is the one path every card in that range supports:
+ * imgui_impl_opengl2 draws with GL 1.1 client-side vertex arrays
+ * (glVertexPointer/glTexCoordPointer/glColorPointer), no VBOs, no shaders,
+ * no framebuffer objects. The UI is a few thousand vertices, so the cost of
+ * the legacy path is negligible. */
+class Gl2Context : public RenderBackend {
+public:
+    Gl2Context() = default;
+    ~Gl2Context() override { shutdown(); }
+
+    Gl2Context(const Gl2Context&) = delete;
+    Gl2Context& operator=(const Gl2Context&) = delete;
+
+    const char* name() const override { return "OpenGL (fixed function)"; }
+    const char* description() const override { return m_description.c_str(); }
+    ContextKind context_kind() const override { return ContextKind::OpenGL; }
+
+    bool init(Platform& platform) override;
+    bool init_imgui() override;
+    void shutdown() override;
+    bool is_initialized() const override { return m_initialized; }
+
+    void new_frame() override;
+    void render(ImDrawData* draw_data) override;
+
+    std::unique_ptr<RenderTexture> create_texture(int width, int height) override;
+    int max_texture_size() const override { return m_max_texture_size; }
+    PixelFormat preferred_video_format() const override { return PixelFormat::Packed32; }
+
+private:
+    std::string m_description;
+    int m_max_texture_size = 0;
+
+    /* True when GL_ARB_texture_non_power_of_two is present and
+     * IMTUBE_GL_FORCE_POT is not set; false (the safe default) otherwise.
+     * Passed to every Gl2Texture so it knows whether to pad allocations up to
+     * a power of two. */
+    bool m_npot = false;
+
+    bool m_initialized = false;
+    bool m_imgui_initialized = false;
+};
+
+} /* namespace imtube */
diff --git a/src/render/Gl2Texture.cpp b/src/render/Gl2Texture.cpp
new file mode 100644
index 0000000..05499c4
--- /dev/null
+++ b/src/render/Gl2Texture.cpp
@@ -0,0 +1,130 @@
+#include "render/Gl2Texture.h"
+
+#include "render/GlHeaders.h"
+
+#include <cstdio>
+#include <vector>
+
+namespace imtube {
+
+namespace {
+
+/* Smallest power of two that is >= value, minimum 1. Legacy GL textures
+ * without GL_ARB_texture_non_power_of_two must have power-of-two width and
+ * height, so Gl2Texture rounds its allocation up to this when asked to. */
+int next_pow2(int value)
+{
+    if (value <= 1)
+        return 1;
+
+    int p = 1;
+    while (p < value)
+        p <<= 1;
+    return p;
+}
+
+} /* namespace */
+
+Gl2Texture::Gl2Texture(int width, int height, bool pad_to_pot, int max_texture_size)
+    : m_width(width), m_height(height)
+{
+    if (m_width <= 0 || m_height <= 0)
+    {
+        fprintf(stderr, "[gl2] texture: invalid size %dx%d\n", m_width, m_height);
+        return;
+    }
+
+    m_alloc_w = pad_to_pot ? next_pow2(m_width) : m_width;
+    m_alloc_h = pad_to_pot ? next_pow2(m_height) : m_height;
+
+    if (max_texture_size > 0 && (m_alloc_w > max_texture_size || m_alloc_h > max_texture_size))
+    {
+        fprintf(stderr, "[gl2] texture: %dx%d (allocation %dx%d) exceeds max texture size %d\n",
+                m_width, m_height, m_alloc_w, m_alloc_h, max_texture_size);
+        return;
+    }
+
+    glGenTextures(1, &m_texture);
+    if (m_texture == 0)
+    {
+        fprintf(stderr, "[gl2] texture: glGenTextures failed for %dx%d\n", m_width, m_height);
+        return;
+    }
+
+    glBindTexture(GL_TEXTURE_2D, m_texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+
+    if (m_alloc_w != m_width || m_alloc_h != m_height)
+    {
+        /* The padding strip is inside the sampled area: bilinear filtering
+         * blends into it right at the image's right/bottom edge. Zero it so
+         * that blend is black instead of whatever the driver left behind in
+         * freshly allocated GPU memory. */
+        std::vector<uint8_t> blank(static_cast<size_t>(m_alloc_w) * static_cast<size_t>(m_alloc_h) * 4, 0);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, m_alloc_w, m_alloc_h, 0,
+                     GL_RGBA, GL_UNSIGNED_BYTE, blank.data());
+    }
+    else
+    {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, m_alloc_w, m_alloc_h, 0,
+                     GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    }
+
+    glBindTexture(GL_TEXTURE_2D, 0);
+}
+
+bool Gl2Texture::upload(const uint8_t* pixels, PixelFormat format)
+{
+    if (m_texture == 0 || pixels == nullptr)
+        return false;
+
+    glBindTexture(GL_TEXTURE_2D, m_texture);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+
+    /* Packed32 means GL_BGRA + GL_UNSIGNED_INT_8_8_8_8_REV: this is Apple's
+     * own documented no-swizzle upload path (their OpenGL driver's native
+     * pixel format), and it is exactly the byte layout GStreamer calls
+     * "ARGB" on the big-endian PowerPC target this backend exists for (see
+     * PixelFormat in RenderTexture.h) - so the decoder's output can be
+     * handed straight to glTexSubImage2D with no CPU-side channel swizzle. */
+    GLenum gl_format = GL_RGBA;
+    GLenum gl_type = GL_UNSIGNED_BYTE;
+    if (format == PixelFormat::Packed32)
+    {
+        gl_format = GL_BGRA;
+        gl_type = GL_UNSIGNED_INT_8_8_8_8_REV;
+    }
+
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, m_width, m_height, gl_format, gl_type, pixels);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    return true;
+}
+
+ImVec2 Gl2Texture::uv1() const
+{
+    if (m_alloc_w <= 0 || m_alloc_h <= 0)
+        return ImVec2(1.0f, 1.0f);
+
+    return ImVec2(static_cast<float>(m_width) / static_cast<float>(m_alloc_w),
+                   static_cast<float>(m_height) / static_cast<float>(m_alloc_h));
+}
+
+void Gl2Texture::destroy()
+{
+    if (m_texture != 0)
+    {
+        glDeleteTextures(1, &m_texture);
+        m_texture = 0;
+    }
+    m_width = 0;
+    m_height = 0;
+    m_alloc_w = 0;
+    m_alloc_h = 0;
+}
+
+} /* namespace imtube */
diff --git a/src/render/Gl2Texture.h b/src/render/Gl2Texture.h
new file mode 100644
index 0000000..d2536af
--- /dev/null
+++ b/src/render/Gl2Texture.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include "render/RenderTexture.h"
+
+#include <cstdint>
+
+namespace imtube {
+
+/* A texture for the legacy (fixed-function) GL backend.
+ *
+ * Many drivers in the Gl2Context target range (see its header comment) have
+ * no non-power-of-two texture support, so this class can allocate a
+ * power-of-two-sized texture larger than the image and only sample the
+ * image's corner of it. Callers never see the allocation size: width()/
+ * height() report the image size, and uv1() gives the bottom-right texture
+ * coordinate to pass to ImGui so the padding never shows up on screen. */
+class Gl2Texture : public RenderTexture {
+public:
+    /* `pad_to_pot` requests power-of-two padding (Gl2Context sets it to true
+     * whenever the driver lacks GL_ARB_texture_non_power_of_two).
+     * `max_texture_size` is GL_MAX_TEXTURE_SIZE (0 = unknown/unchecked); the
+     * texture is left invalid if the allocation would exceed it. */
+    Gl2Texture(int width, int height, bool pad_to_pot, int max_texture_size);
+    ~Gl2Texture() override { destroy(); }
+
+    Gl2Texture(const Gl2Texture&) = delete;
+    Gl2Texture& operator=(const Gl2Texture&) = delete;
+
+    bool upload(const uint8_t* pixels, PixelFormat format = PixelFormat::RGBA8) override;
+    bool valid() const override { return m_texture != 0; }
+    int width() const override { return m_width; }
+    int height() const override { return m_height; }
+    ImTextureID imgui_id() const override { return (ImTextureID)(intptr_t)m_texture; }
+    ImVec2 uv1() const override;
+
+private:
+    void destroy();
+
+    uint32_t m_texture = 0;
+    int m_width = 0;
+    int m_height = 0;
+
+    /* Allocation size: equal to width()/height() unless padded to a power of
+     * two. */
+    int m_alloc_w = 0;
+    int m_alloc_h = 0;
+};
+
+} /* namespace imtube */
diff --git a/src/render/GlHeaders.h b/src/render/GlHeaders.h
new file mode 100644
index 0000000..cabe29c
--- /dev/null
+++ b/src/render/GlHeaders.h
@@ -0,0 +1,44 @@
+#pragma once
+
+/* Desktop OpenGL declarations for the fixed-function backend (Gl2Context,
+ * Gl2Texture). Both .cpp files include this instead of a raw <GL/gl.h> so the
+ * platform #ifdef and the legacy-enum fallbacks live in exactly one place.
+ *
+ * Apple's OpenGL framework predates the Khronos GL/gl.h + GL/glext.h layout
+ * used everywhere else (Linux/Mesa) and ships its own headers instead. We
+ * only ever call GL 1.2 core entry points here (no VBOs, no shaders, no
+ * extension function pointers), so there is nothing to load: every symbol we
+ * use is exported directly by libGL / the OpenGL framework and declared by
+ * the platform's own gl.h. GL_GLEXT_PROTOTYPES is therefore not needed on
+ * Linux either. */
+/* On macOS the library we link decides the headers: the system
+ * OpenGL.framework (IMTUBE_MACOS_GL=framework, the default, matching the
+ * Cocoa video driver) or Mesa (IMTUBE_MACOS_GL=x11, which defines
+ * IMTUBE_GL_X11 and pairs with SDL_VIDEODRIVER=x11 under XQuartz). See
+ * cmake/ImTubeDeps.cmake. GL_SILENCE_DEPRECATION keeps the 10.14+ SDK
+ * headers from flagging every GL call. */
+#if defined(__APPLE__) && !defined(IMTUBE_GL_X11)
+#ifndef GL_SILENCE_DEPRECATION
+#define GL_SILENCE_DEPRECATION
+#endif
+#include <OpenGL/gl.h>
+#include <OpenGL/glext.h>
+#else
+#include <GL/gl.h>
+#endif
+
+/* A handful of very old or minimal GL headers omit enums that every real
+ * driver still understands (they are core as of GL 1.2 / EXT_bgra). Define
+ * them ourselves if missing so this backend always builds; the values are
+ * fixed by the Khronos registry and never change. */
+#ifndef GL_BGRA
+#define GL_BGRA 0x80E1
+#endif
+
+#ifndef GL_UNSIGNED_INT_8_8_8_8_REV
+#define GL_UNSIGNED_INT_8_8_8_8_REV 0x8367
+#endif
+
+#ifndef GL_CLAMP_TO_EDGE
+#define GL_CLAMP_TO_EDGE 0x812F
+#endif
