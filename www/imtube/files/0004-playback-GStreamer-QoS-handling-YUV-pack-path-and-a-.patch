+/* The other GL_APPLE_ycbcr_422 16-bit type: the two differ only in which
+ * byte of a pair is luminance, so the byte-swapped layout takes the
+ * opposite type on the same host. */
+GLenum other_ycbcr_type(uint32_t type)
+{
+    return type == GL_UNSIGNED_SHORT_8_8_APPLE ? GL_UNSIGNED_SHORT_8_8_REV_APPLE
+                                               : GL_UNSIGNED_SHORT_8_8_APPLE;
+}
+
 /* glTexImage2D / glTexSubImage2D arguments for each pixel layout. */
 struct GlLayout {
     GLint internal_format;
@@ -48,9 +57,13 @@ GlLayout layout_for(PixelFormat format, uint32_t ycbcr_type)
          * the GPU converts to RGB while sampling. The spec asks for an RGB
          * internal format (the data is RGB information, just encoded). The
          * 16-bit <type> decides which byte of each pair is luminance; it is
-         * chosen by Gl2Context for the host's byte order. */
+         * chosen by Gl2Context for the host's byte order (UYVY). */
         return { GL_RGB, GL_YCBCR_422_APPLE, (GLenum)ycbcr_type };
 
+    case PixelFormat::YCbCr422Rev:
+        /* YUY2: byte-swapped pairs, so the opposite type. */
+        return { GL_RGB, GL_YCBCR_422_APPLE, other_ycbcr_type(ycbcr_type) };
+
     default:
