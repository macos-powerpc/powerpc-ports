+/* Host byte order, for composing packed pixel words (same rule as
+ * render/RenderTexture.h, kept local so core/ does not include render/). */
+#if defined(__BIG_ENDIAN__) || (defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__))
+static constexpr bool kHostBigEndian = true;
+#else
+static constexpr bool kHostBigEndian = false;
+#endif
+
+/* True for the packed 4:2:2 layouts ImTube packs itself (see pull_frame()). */
+static bool is_packed_422(const std::string& gst_format)
+{
+    return gst_format == "UYVY" || gst_format == "YUY2";
+}
+
+/* I420 -> packed 4:2:2 (UYVY, or YUY2 when `rev`) with tight rows. Each
+ * chroma row serves the two luma rows it covers, exactly what videoconvert's
+ * own I420->UYVY path does. Done here rather than by videoconvert so the
+ * pipeline stays passthrough from the decoder (one pass over the frame less)
+ * and so the byte order is spelled out on every host: videoconvert's ORC
+ * programs build 16-bit values and leave the memory order to the ORC
+ * backend, which on a big-endian machine is one thing for the AltiVec JIT
+ * and another for the C fallback. */
+static void pack_i420_to_422(const GstVideoFrame& f, bool rev, std::vector<uint8_t>& out)
+{
+    const int w = GST_VIDEO_FRAME_WIDTH(&f);
+    const int h = GST_VIDEO_FRAME_HEIGHT(&f);
+    const uint8_t* yp = static_cast<const uint8_t*>(GST_VIDEO_FRAME_PLANE_DATA(&f, 0));
+    const uint8_t* up = static_cast<const uint8_t*>(GST_VIDEO_FRAME_PLANE_DATA(&f, 1));
+    const uint8_t* vp = static_cast<const uint8_t*>(GST_VIDEO_FRAME_PLANE_DATA(&f, 2));
+    const int ys = GST_VIDEO_FRAME_PLANE_STRIDE(&f, 0);
+    const int us = GST_VIDEO_FRAME_PLANE_STRIDE(&f, 1);
+    const int vs = GST_VIDEO_FRAME_PLANE_STRIDE(&f, 2);
+    const size_t row_bytes = (size_t)w * 2;
+    out.resize(row_bytes * (size_t)h);
+
+    for (int y = 0; y < h; ++y)
+    {
+        const uint8_t* Y = yp + (size_t)y * ys;
+        const uint8_t* U = up + (size_t)(y >> 1) * us;
+        const uint8_t* V = vp + (size_t)(y >> 1) * vs;
+        uint8_t* d = out.data() + (size_t)y * row_bytes;
+
+        if ((w & 1) == 0)
+        {
+            /* One 32-bit store per pixel pair; the word is composed so that
+             * its bytes land in memory as U,Y0,V,Y1 (or Y0,U,Y1,V) on either
+             * host. Rows are a multiple of 4 bytes for even widths. */
+            uint32_t* dw = reinterpret_cast<uint32_t*>(d);
+            for (int x = 0; x < w; x += 2)
+            {
+                const uint32_t y0 = Y[x], y1 = Y[x + 1], u = U[x >> 1], v = V[x >> 1];
+                uint32_t word;
+                if (!rev)
+                    word = kHostBigEndian ? (u << 24) | (y0 << 16) | (v << 8) | y1
+                                          : (y1 << 24) | (v << 16) | (y0 << 8) | u;
+                else
+                    word = kHostBigEndian ? (y0 << 24) | (u << 16) | (y1 << 8) | v
+                                          : (v << 24) | (y1 << 16) | (u << 8) | y0;
+                *dw++ = word;
+            }
+        }
+        else
+        {
+            /* Odd width (never from YouTube): byte stores, last pixel's luma
+             * duplicated to complete the final pair. */
+            for (int x = 0; x < w; x += 2)
+            {
+                const uint8_t y0 = Y[x], y1 = (x + 1 < w) ? Y[x + 1] : Y[x];
+                const uint8_t u = U[x >> 1], v = V[x >> 1];
+                if (!rev) { d[0] = u; d[1] = y0; d[2] = v; d[3] = y1; }
+                else      { d[0] = y0; d[1] = u; d[2] = y1; d[3] = v; }
+                d += 4;
+            }
+        }
+    }
+}
