 namespace imtube {
 
@@ -30,6 +34,79 @@ namespace {
  * on a G4 is a whole core. Input wakes the loop immediately. */
 constexpr int kIdleWaitMs = 50;
 
+/* ImGui's built-in font covers Latin only and draws every other glyph as
+ * '?'. Merge a system font with CJK coverage behind it. ImGui 1.92 loads
+ * glyphs on demand, so the atlas only grows for the characters actually
+ * shown and a large font costs its file size in memory, nothing more. The
+ * candidates are tried in order and the first that loads wins; the
+ * broad-coverage, moderately sized Arial Unicode comes before the huge
+ * PingFang/STHeiti collections. IMTUBE_CJK_FONT=<path> replaces the list,
+ * IMTUBE_CJK_FONT=none skips it. */
+void load_cjk_fallback_font()
+{
+    ImGuiIO& io = ImGui::GetIO();
+    /* The base font, added explicitly so the fallback has something to
+     * merge into (ImGui would otherwise add it lazily at the first frame). */
+    io.Fonts->AddFontDefault();
+
+    std::vector<std::string> candidates;
+    if (const char* env = std::getenv("IMTUBE_CJK_FONT"))
+    {
+        if (std::strcmp(env, "none") == 0)
+            return;
+        if (*env != '\0')
+            candidates.push_back(env);
+    }
+    if (candidates.empty())
+    {
+#ifdef __APPLE__
+        candidates = {
+            "/Library/Fonts/Arial Unicode.ttf",                     /* 10.5 - 10.14 */
+            "/System/Library/Fonts/Supplemental/Arial Unicode.ttf", /* 10.15+ */
+            "/System/Library/Fonts/AppleSDGothicNeo.ttc",           /* 10.8+: Hangul */
+            "/System/Library/Fonts/AppleGothic.ttf",                /* 10.5: Hangul */
+            "/System/Library/Fonts/\xe5\x8d\x8e\xe6\x96\x87\xe9\xbb\x91\xe4\xbd\x93.ttf", /* 10.5: STHeiti (Han) */
+            "/System/Library/Fonts/STHeiti Light.ttc",              /* 10.6+: Han */
+            "/System/Library/Fonts/Osaka.ttf",                      /* Japanese */
+            "/System/Library/Fonts/PingFang.ttc",                   /* 10.11+: Han, large */
+        };
+#else
+        candidates = {
+            "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
+            "/usr/share/fonts/truetype/droid/DroidSansFallback.ttf",
+            "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
+            "/usr/share/fonts/truetype/wqy/wqy-microhei.ttc",
+            "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
+            "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc",
+        };
+#endif
+    }
+
+    ImFontConfig cfg;
+    cfg.MergeMode = true;
+    cfg.PixelSnapH = true;
+    for (const std::string& path : candidates)
+    {
+        /* Skip absent files before ImGui sees them (its loader treats a
+         * missing file as a caller error in debug builds). */
+        FILE* probe = std::fopen(path.c_str(), "rb");
+        if (probe == nullptr)
+            continue;
+        std::fclose(probe);
+
+        /* Size 0 = the style's base size; a font ImGui's parser rejects
+         * (or that fails to read) comes back as NULL and the next is tried. */
+        if (io.Fonts->AddFontFromFileTTF(path.c_str(), 0.0f, &cfg) != nullptr)
+        {
+            std::fprintf(stderr, "[fonts] CJK fallback: %s\n", path.c_str());
+            return;
+        }
+        std::fprintf(stderr, "[fonts] could not load %s, trying the next candidate\n", path.c_str());
+    }
+    std::fprintf(stderr, "[fonts] no CJK fallback font found; non-Latin text shows as '?' "
+                         "(IMTUBE_CJK_FONT=<file.ttf> to point at one)\n");
+}
+
 } /* namespace */
 
 /* Compile-time choice of platform (see CMakeLists.txt). */
@@ -85,6 +162,7 @@ bool App::init()
     ImGui::CreateContext();
     ImGui::GetIO().IniFilename = "imgui.ini";
     ImGui::StyleColorsDark();
+    load_cjk_fallback_font();
 
     if (!m_platform->init_imgui())
     {
