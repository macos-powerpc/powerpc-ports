 {
-    std::string caps = "video/x-raw,format=" + m_video_format;
+    /* The packed 4:2:2 layouts are produced by pull_frame() from the
+     * decoder's native I420, so the pipeline is asked for I420 and
+     * videoconvert/videoscale pass frames through untouched. */
+    const std::string pipeline_format = is_packed_422(m_video_format) ? "I420" : m_video_format;
+    std::string caps = "video/x-raw,format=" + pipeline_format;
     if (m_max_frame_dim > 0)
     {
         /* An int range lets videoscale pick the largest size that fits while
@@ -779,15 +879,31 @@ bool GStreamerPlayer::pull_frame()
         if (gst_video_info_from_caps(&info, caps))
         {
             GstBuffer* buffer = gst_sample_get_buffer(sample);
-            GstMapInfo map;
-            if (gst_buffer_map(buffer, &map, GST_MAP_READ))
+            GstVideoFrame vframe;
+            /* gst_video_frame_map() honours the decoder's GstVideoMeta (plane
+             * offsets and strides of padded pool buffers), which a raw
+             * gst_buffer_map() would not. */
+            if (gst_video_frame_map(&vframe, &info, buffer, GST_MAP_READ))
             {
                 DBG("pull_frame: got %dx%d frame", info.width, info.height);
                 m_frame_w = info.width;
                 m_frame_h = info.height;
-                m_frame_stride = GST_VIDEO_INFO_PLANE_STRIDE(&info, 0);
-                m_frame.assign(map.data, map.data + map.size);
-                gst_buffer_unmap(buffer, &map);
+                if (GST_VIDEO_FRAME_FORMAT(&vframe) == GST_VIDEO_FORMAT_I420 &&
+                    is_packed_422(m_video_format))
+                {
+                    pack_i420_to_422(vframe, m_video_format == "YUY2", m_frame);
+                    m_frame_stride = m_frame_w * 2;
+                }
+                else
+                {
+                    /* A packed single-plane layout (RGBA/ARGB/BGRA): copy the
+                     * plane as is, padding rows included, and report its stride. */
+                    const uint8_t* src = static_cast<const uint8_t*>(GST_VIDEO_FRAME_PLANE_DATA(&vframe, 0));
+                    const int stride = GST_VIDEO_FRAME_PLANE_STRIDE(&vframe, 0);
+                    m_frame_stride = stride;
+                    m_frame.assign(src, src + (size_t)stride * (size_t)m_frame_h);
+                }
+                gst_video_frame_unmap(&vframe);
                 got = true;
                 m_saw_frame = true;
             }
