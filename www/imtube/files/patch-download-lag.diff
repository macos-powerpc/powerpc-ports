+int64_t GStreamerPlayer::video_lag_ms() const
+{
+    if (m_pipeline == nullptr || m_appsink == nullptr || m_audio_sink == nullptr)
+        return 0;
+    gint64 a = 0, v = 0;
+    if (!gst_element_query_position(m_audio_sink, GST_FORMAT_TIME, &a) ||
+        !gst_element_query_position(GST_ELEMENT_CAST(m_appsink), GST_FORMAT_TIME, &v))
+        return 0;
+    return a > v ? (int64_t)((a - v) / GST_MSECOND) : 0;
+}
