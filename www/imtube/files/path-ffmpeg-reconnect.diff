core: make ffmpeg resume a dropped input connection (sound cut at ~1:30)

A merged stream above 360p is two googlevideo HTTPS connections read by
ffmpeg and muxed on the fly.  ffmpeg drains the small audio stream only as
fast as it interleaves it, the server resets the stalled connection after
roughly a minute and a half ("IO error: Connection reset by peer" on
input #1 in the yt-dlp log), and ffmpeg muxes the rest of the video
without audio.  Tell ffmpeg's HTTP reader to reconnect with a Range
request at the current offset: through --downloader-args for the yt-dlp
launched merge, and directly in the ffmpeg command used for seeks.

--- a/src/core/YtDlpHelper.cpp
+++ b/src/core/YtDlpHelper.cpp
@@ -437,6 +437,40 @@
     return fmt;
 }
 
+/* ffmpeg's HTTP reader gives up on an input whose connection dies. That is
+ * what cuts the sound of a merged stream after about a minute and a half:
+ * the muxer drains the small audio stream only as fast as it interleaves
+ * it with the video, the googlevideo server sees a transfer that no longer
+ * progresses and resets the connection, and ffmpeg then muxes the rest of
+ * the video without audio. With these options ffmpeg resumes the input
+ * with a Range request at the current offset instead (up to ~30 s of
+ * retries). They go in front of each -i, in the yt-dlp case through
+ * --downloader-args with the "ffmpeg_i" key. */
+const char* const kFfmpegReconnectOpts[] = {
+    "-reconnect", "1",
+    "-reconnect_streamed", "1",
+    "-reconnect_on_network_error", "1",
+    "-reconnect_delay_max", "30",
+};
+
+void push_ffmpeg_reconnect_opts(std::vector<std::string>& args)
+{
+    for (const char* opt : kFfmpegReconnectOpts)
+        args.push_back(opt);
+}
+
+std::string ffmpeg_reconnect_downloader_args()
+{
+    std::string s = "ffmpeg_i:";
+    for (size_t i = 0; i < sizeof(kFfmpegReconnectOpts) / sizeof(kFfmpegReconnectOpts[0]); i++)
+    {
+        if (i > 0)
+            s += ' ';
+        s += kFfmpegReconnectOpts[i];
+    }
+    return s;
+}
+
 } /* namespace */
 
 int YtDlpHelper::launch_stream(const std::string& url, bool live, int max_height,
@@ -448,6 +482,10 @@
     args.push_back("--no-playlist");
     args.push_back("--socket-timeout");
     args.push_back("20");
+    /* Only used when yt-dlp merges through ffmpeg (every stream above 360p);
+     * ignored by its native downloader. */
+    args.push_back("--downloader-args");
+    args.push_back(ffmpeg_reconnect_downloader_args());
 
     if (live)
     {
@@ -654,10 +692,12 @@
     {
         /* Full-resolution seek: restart the DASH video and audio at the target
