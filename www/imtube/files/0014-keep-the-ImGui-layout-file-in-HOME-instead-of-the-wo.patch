From 5f96ad430ba0368afa74c2f779331db316df55b8 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 19 Sep 2026 18:30:39 +0000
Subject: [PATCH 14/15] keep the ImGui layout file in $HOME instead of the
 working directory

Dear ImGui writes its window/table layout to io.IniFilename, and ImTube set
that to the bare name "imgui.ini". ImGui uses the string verbatim, so the
file landed in whatever directory ImTube happened to be started from: a new
one per directory, none of them found again from anywhere else, and a stray
file dropped into any tree the app was launched in.

Point it at the directory that already holds the settings, the lists and the
subtitle/thumbnail caches ($HOME/.cache/imtube, /tmp/imtube-cache without
a HOME - never the working directory), and make that directory's creation
create its parents: a fresh account has no ~/.cache (Mac OS X never makes
one), where the single mkdir() of the leaf failed with ENOENT and left the
settings and the lists unsaved as well.
---
 README.md                | 10 +++++++---
 src/app/App.cpp          | 16 +++++++++++++++-
 src/core/YtDlpHelper.cpp | 15 ++++++++++++++-
 src/core/YtDlpHelper.h   |  5 ++++-
 4 files changed, 40 insertions(+), 6 deletions(-)

diff --git a/README.md b/README.md
index 93ad75d..6555c0d 100644
--- a/README.md
+++ b/README.md
@@ -151,9 +151,13 @@ the player controls.
 
 ### Persistence
 
-History, liked/watch-later flags and the URL cache are stored in
-`~/.cache/imtube/lists.json` (mirrors FLTube's userdata layout). Downloads default
-to `~/Downloads`.
+Everything ImTube keeps between runs lives under `~/.cache/imtube` (created with
+its parents on first use, `/tmp/imtube-cache` when `HOME` is unset): history,
+liked/watch-later flags and the URL cache in `lists.json` (mirrors FLTube's
+userdata layout), the Settings tab in `settings.json`, the Dear ImGui window
+layout in `imgui.ini` and the thumbnail and subtitle caches. Nothing is written
+relative to the working directory, so ImTube behaves the same started from
+anywhere. Downloads default to `~/Downloads`.
 
 ---
 
diff --git a/src/app/App.cpp b/src/app/App.cpp
index a249fd7..2ca388c 100644
--- a/src/app/App.cpp
+++ b/src/app/App.cpp
@@ -1,5 +1,6 @@
 #include "app/App.h"
 
+#include "core/YtDlpHelper.h"
 #include "platform/Platform.h"
 #include "render/RenderBackend.h"
 #include "ui/ImTubeUI.h"
@@ -31,6 +32,19 @@ namespace imtube {
 
 namespace {
 
+/* Where Dear ImGui keeps its window layout. ImGui uses IniFilename verbatim,
+ * so the stock "imgui.ini" is written into whatever directory ImTube happened
+ * to be started from - a new file per directory, and none of them found again
+ * from anywhere else. Keep it with the rest of ImTube's state under $HOME
+ * (YtDlpHelper::cache_dir(), which falls back to /tmp, never to the working
+ * directory). ImGui only stores the pointer, so the string has to outlive the
+ * context: it is a function-local static. */
+const char* imgui_ini_path()
+{
+    static const std::string path = YtDlpHelper::cache_dir() + "/imgui.ini";
+    return path.c_str();
+}
+
 /* How long the loop sleeps waiting for input when nothing on screen moves.
  * Keeps an idle ImTube from redrawing a static page at the vsync rate, which
  * on a G4 is a whole core. Input wakes the loop immediately. */
@@ -162,7 +176,7 @@ bool App::init()
 
     IMGUI_CHECKVERSION();
     ImGui::CreateContext();
-    ImGui::GetIO().IniFilename = "imgui.ini";
+    ImGui::GetIO().IniFilename = imgui_ini_path();
     ImGui::StyleColorsDark();
     load_cjk_fallback_font();
 
diff --git a/src/core/YtDlpHelper.cpp b/src/core/YtDlpHelper.cpp
index ffd9974..0ad0dc9 100644
--- a/src/core/YtDlpHelper.cpp
+++ b/src/core/YtDlpHelper.cpp
@@ -781,8 +781,21 @@ std::string YtDlpHelper::cache_dir()
 {
     const char* home = getenv("HOME");
     std::string dir = home && *home ? std::string(home) + "/.cache/imtube" : "/tmp/imtube-cache";
+
+    /* Create the parents too. A fresh account has no ~/.cache (Mac OS X never
+     * creates one), and a lone mkdir() of the leaf then fails with ENOENT,
+     * which would leave the settings, the lists and the ImGui layout unsaved.
+     * Failures on a parent are not reported: the leaf mkdir below reports the
+     * one that matters. */
+    for (size_t slash = dir.find('/', 1); slash != std::string::npos;
+         slash = dir.find('/', slash + 1))
+    {
+        const std::string parent = dir.substr(0, slash);
+        mkdir(parent.c_str(), 0755);
+    }
+
     if (mkdir(dir.c_str(), 0755) != 0 && errno != EEXIST)
-        fprintf(stderr, "[imtube] cannot create cache dir '%s'\n", dir.c_str());
+        fprintf(stderr, "[imtube] cannot create state dir '%s'\n", dir.c_str());
     return dir;
 }
 
diff --git a/src/core/YtDlpHelper.h b/src/core/YtDlpHelper.h
index bf1d3c4..08d124d 100644
--- a/src/core/YtDlpHelper.h
+++ b/src/core/YtDlpHelper.h
@@ -151,7 +151,10 @@ public:
     std::vector<std::string> fetch_subtitles(const std::string& url,
                                              const std::string& video_id);
 
-    /* Directory where per-video extras (subtitles, ...) are cached on disk. */
+    /* Directory holding everything ImTube keeps between runs: the settings,
+     * the lists, the ImGui layout and the per-video extras (subtitles, ...).
+     * "$HOME/.cache/imtube" ("/tmp/imtube-cache" without a HOME), created
+     * with its parents on first use. Never relative to the working dir. */
     static std::string cache_dir();
 
 private:
