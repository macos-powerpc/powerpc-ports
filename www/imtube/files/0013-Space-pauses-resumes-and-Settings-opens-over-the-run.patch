+void ImTubeUI::render_settings_overlay()
+{
+    ImGuiIO& io = ImGui::GetIO();
+    const ImVec2 size(std::min(io.DisplaySize.x - 60.0f, 720.0f),
+                      std::min(io.DisplaySize.y - 90.0f, 560.0f));
+    ImGui::SetNextWindowSize(size, ImGuiCond_Appearing);
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f),
+                            ImGuiCond_Appearing, ImVec2(0.5f, 0.5f));
+
+    bool open = true;
+    if (ImGui::Begin("Settings", &open,
+                     ImGuiWindowFlags_NoCollapse
+#ifdef IMGUI_HAS_DOCK
+                     | ImGuiWindowFlags_NoDocking /* vendored docking branch only */
+#endif
+                     ))
+    {
+        ImGui::TextColored(kColTextDim,
+            "Playback keeps running behind this window. Resolution and codec apply to the "
+            "next video; everything else takes effect right away.");
+        ImGui::Separator();
+
+        /* The settings themselves, in a scrolling area so the Close button
+         * stays reachable on a short window. */
+        ImGui::BeginChild("##settings_overlay_body",
+                          ImVec2(0.0f, -ImGui::GetFrameHeightWithSpacing()));
+        render_settings_tab();
+        ImGui::EndChild();
+
+        ImGui::Separator();
+        if (ImGui::Button("Close", ImVec2(76, 0)))
+            open = false;
+        ImGui::SameLine();
+        ImGui::TextColored(kColTextDim, "Esc closes this window; Space pauses the video.");
+
+        const ImVec2 win_min = ImGui::GetWindowPos();
+        m_dbg.settings_x = win_min.x;
+        m_dbg.settings_y = win_min.y;
+        m_dbg.settings_open = true;
+    }
+    ImGui::End();
+
+    m_settings_overlay = open;
+}
+
 } /* namespace imtube */
