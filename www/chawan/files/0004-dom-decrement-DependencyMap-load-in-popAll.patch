From e58406cf046975971707906c12e3091893894a7a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 08:03:40 +0000
Subject: [PATCH] dom: decrement DependencyMap load in popAll

popAll removed items from the table without decrementing load, so the
table kept growing as if the items were still there.

Assisted-By: Claude Opus 5.5 (1M context)
---
 src/html/dom.nim | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/html/dom.nim b/src/html/dom.nim
index b7a5e0f7..edb7ee32 100644
--- a/src/html/dom.nim
+++ b/src/html/dom.nim
@@ -6077,6 +6077,7 @@ iterator getAll(map: DependencyMap; element: Element): lent Element =
 
 iterator popAll(map: var DependencyMap; element: Element): Element =
   for it in map.tab.tabPopAll(element, hash(element)):
+    dec map.load
     yield cast[Element](it.value)
 
 proc del(map: var DependencyMap; key, value: Element) =
