From e58406cf046975971707906c12e3091893894a7a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 08:03:40 +0000
Subject: [PATCH] tabutil: fix tabPopAll when popping multiple items

When tabPopAll removed more than one item in a single pass, it shifted
the following items into the most recent hole only, leaving the earlier
holes empty.  An item behind such a hole whose home is before it becomes
unreachable, e.g. popping X from

  [A(X) @0, B(X) @1, C(Y, home 0) @2]

leaves slot 0 empty and C at slot 1, so lookups of Y stop at slot 0.

This affects DependencyMap.popAll, where the same key routinely has
several values.  Do a regular backwards shift deletion after each popped
item instead, and explicitly clear the final hole.

Assisted-By: Claude Opus 5.5 (1M context)
---
 src/utils/tabutil.nim | 35 +++++++++++++++++++++--------------
 1 file changed, 21 insertions(+), 14 deletions(-)

diff --git a/src/utils/tabutil.nim b/src/utils/tabutil.nim
index fc85aac9..6b805ffb 100644
--- a/src/utils/tabutil.nim
+++ b/src/utils/tabutil.nim
@@ -45,20 +45,27 @@ iterator tabPopAll*[K, V](tab: var seq[V]; item: K; keyh: Hash): V {.inline.} =
   ## Pop all items in the table.
   ## Warning: it is incorrect to break/return inside the loop.
   mixin tabHashFast, tabKeyEq, tabIsEmpty
-  var j = -1
-  for i, it in tab.mtabPairs(keyh):
-    if tabIsEmpty(it):
-      break # not found
-    if tabKeyEq(it, item):
-      yield move(it)
-      j = i
-    elif j >= 0:
-      let k = tabHashFast(it) and (tab.len - 1)
-      if i == k: # already at home
-        break
-      # backwards shift
-      tab[j] = move(it)
-      j = i
+  if tab.len > 0:
+    let mask = tab.len - 1
+    var i = keyh and mask
+    while not tabIsEmpty(tab[i]):
+      if not tabKeyEq(tab[i], item):
+        i = (i + 1) and mask
+        continue
+      yield move(tab[i])
+      # Backwards shift the following items into the hole, until an empty
+      # slot or an item that is already at home.  (Shifting into the last
+      # hole after popping several items would leave earlier holes behind,
+      # making the items after them unreachable.)
+      var j = i
+      while true:
+        let k = (j + 1) and mask
+        if tabIsEmpty(tab[k]) or (tabHashFast(tab[k]) and mask) == k:
+          break
+        tab[j] = move(tab[k])
+        j = k
+      tab[j] = default(V)
+      # slot i now holds the next item (or is empty), so check it again
 
 template tabDelImpl*[K, V](tab: var seq[V]; load: var int; item: K;
     keyh: Hash) =
