From e58406cf046975971707906c12e3091893894a7a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 08:03:40 +0000
Subject: [PATCH] chahash: fix load32le on big-endian and in the VM

littleEndian32 writes 4 bytes to the start of its destination, which was
a uint64.  On big-endian systems the first 4 bytes are the high half, so
load32le returned the value shifted left by 32, and ChibiHash computed
a different (lower quality) hash than on little-endian systems.  Load into
a uint32 instead.

The nimvm branch was also wrong: it ignored `i` and shifted uint8 values
(so `p[1] shl 8` etc. were always 0), so compile-time hashes did not match
runtime ones.  Widen first and index from `i`.

Runtime results on little-endian systems are unchanged.

Assisted-By: Claude Opus 5.5 (1M context)
---
 src/utils/chahash.nim | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/utils/chahash.nim b/src/utils/chahash.nim
index 7fd51ef5..0b50e1f3 100644
--- a/src/utils/chahash.nim
+++ b/src/utils/chahash.nim
@@ -9,12 +9,15 @@ type Hash* = int
 {.push overflowChecks: off.}
 proc load32le(p: openArray[uint8]; i: int): uint64 =
   when nimvm:
-    return p[0] or (p[1] shl 8) or (p[2] shl 16) or (p[3] shl 24)
-  var x: uint64
+    return uint64(p[i]) or (uint64(p[i + 1]) shl 8) or
+      (uint64(p[i + 2]) shl 16) or (uint64(p[i + 3]) shl 24)
+  # Must be a 32-bit variable: on big-endian systems, littleEndian32 into
+  # the first 4 bytes of a uint64 would fill its high half.
+  var x: uint32
   {.push boundChecks: off.}
   littleEndian32(addr x, unsafeAddr p[i])
   {.pop.}
-  x
+  uint64(x)
 
 proc load64le(p: openArray[uint8]; i: int): uint64 =
   load32le(p, i) or (load32le(p, i + 4) shl 32)
