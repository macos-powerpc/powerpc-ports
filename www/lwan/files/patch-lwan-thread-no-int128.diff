Don't require 128-bit integers for the request ID PRNG.

__uint128_t only exists on 64-bit targets, so lwan 0.7 fails to build for
32-bit ones (e.g. ppc):

  lwan-thread.c:120:17: error: unknown type name '__uint128_t'

Without __SIZEOF_INT128__, keep the 128-bit state in two 64-bit halves and
do the multiplication by hand.  The generator is unchanged: it produces the
same sequence as the __uint128_t one from the same state.  64-bit targets
build the same code as before.

https://github.com/lpereira/lwan/issues/385

--- src/lib/lwan-thread.c.orig
+++ src/lib/lwan-thread.c
@@ -116,6 +116,37 @@
 
     return ATOMIC_INC(value);
 }
+#elif !defined(__SIZEOF_INT128__)
+/* No 128-bit integers on 32-bit targets: same generator as below, with the
+ * state kept in two 64-bit halves. */
+static __thread struct {
+    uint64_t hi, lo;
+} lehmer64_state;
+
+static void lwan_random_seed_prng_for_thread(const struct lwan_thread *t)
+{
+    if (lwan_getentropy(&lehmer64_state, sizeof(lehmer64_state), 0) < 0) {
+        lwan_status_warning("Couldn't get proper entropy for PRNG, using fallback seed");
+        uintptr_t ptr = (uintptr_t)t;
+        lehmer64_state.hi = lehmer64_state.lo | fnv1a_64(&ptr, sizeof(ptr));
+        lehmer64_state.lo = fnv1a_64(&t->epoll_fd, sizeof(t->epoll_fd));
+    }
+}
+
+uint64_t lwan_random_uint64()
+{
+    const uint64_t m = 0xda942042e4dd58b5ull;
+    const uint64_t lo = lehmer64_state.lo;
+    /* High half of the 128-bit product lo * m, from 32-bit pieces */
+    const uint64_t p0 = (lo & 0xffffffff) * (m & 0xffffffff);
+    const uint64_t p1 = (lo >> 32) * (m & 0xffffffff) + (p0 >> 32);
+    const uint64_t p2 = (lo & 0xffffffff) * (m >> 32) + (p1 & 0xffffffff);
+    const uint64_t lo_m_hi = (lo >> 32) * (m >> 32) + (p1 >> 32) + (p2 >> 32);
+
+    lehmer64_state.hi = lehmer64_state.hi * m + lo_m_hi;
+    lehmer64_state.lo = lo * m;
+    return lehmer64_state.hi;
+}
 #else
 static __thread __uint128_t lehmer64_state;
 
