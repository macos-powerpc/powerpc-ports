Build the bundled libucontext properly for Darwin/PowerPC: not in
freestanding mode (the Darwin ports use the system ucontext_t), with the
same compiler and arch flags as lwan, and compile lwan with _XOPEN_SOURCE
so that ucontext_t has the same, complete layout everywhere.

Also make the installed libucontext headers visible outside src/lib, and
build them before the tools that include lwan-coro.h (mimegen, configdump,
bin2hex).  lwan 0.7 only adds them to src/lib, so the tools fail to build
wherever lwan-coro.h uses libucontext.

Finally, link libucontext into liblwan.dylib too.  lwan 0.7 only adds it
to ADDITIONAL_LIBRARIES in the parent scope, after lwan-shared has been
linked with that variable, so the shared library is left with undefined
references to libucontext: unnoticed in a Linux .so, a link error on
Darwin.

--- CMakeLists.txt.orig
+++ CMakeLists.txt
@@ -354,6 +354,20 @@
 
 if (NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^x86_64|amd64|aarch64")
 	set(LWAN_HAVE_LIBUCONTEXT 1)
+
+	# lwan-coro.h includes libucontext.h, which the libucontext target in
+	# src/lib installs here.  The tools in src/bin/tools need it too.
+	include_directories(${CMAKE_BINARY_DIR}/usr/include)
+
+	if (APPLE)
+		check_c_source_compiles("#if !defined(__ppc__) && !defined(__ppc64__)\n#error Not PowerPC\n#endif\nint main(void) { return 0; }" LWAN_DARWIN_PPC)
+		if (LWAN_DARWIN_PPC)
+			# libucontext uses the system ucontext_t on Darwin/PowerPC, which
+			# only has room for the machine context with _XOPEN_SOURCE.  Every
+			# source file sees it through lwan-coro.h.
+			add_definitions("-D_XOPEN_SOURCE" "-D_DARWIN_C_SOURCE")
+		endif ()
+	endif ()
 endif ()
 
 include_directories(src/lib)
--- src/lib/CMakeLists.txt.orig
+++ src/lib/CMakeLists.txt
@@ -150,14 +150,44 @@
 
 	include(ExternalProject)
 
+	if (LWAN_DARWIN_PPC)
+		# The Darwin/PowerPC ports of libucontext use the system ucontext_t,
+		# so they can't be built in freestanding mode.  They also have to be
+		# built with the same compiler, and for the same architecture, as Lwan.
+		list(LENGTH CMAKE_OSX_ARCHITECTURES LIBUCONTEXT_NUM_ARCHS)
+		if (LIBUCONTEXT_NUM_ARCHS GREATER 1)
+			message(FATAL_ERROR "libucontext can't be built for several architectures at once")
+		endif ()
+		if (CMAKE_SIZEOF_VOID_P EQUAL 8)
+			set(LIBUCONTEXT_ARCH ppc64)
+		else ()
+			set(LIBUCONTEXT_ARCH ppc)
+		endif ()
+
+		set(LIBUCONTEXT_CFLAGS "-O2 ${CMAKE_C_FLAGS}")
+		foreach (arch ${CMAKE_OSX_ARCHITECTURES})
+			set(LIBUCONTEXT_CFLAGS "${LIBUCONTEXT_CFLAGS} -arch ${arch}")
+		endforeach ()
+		if (CMAKE_OSX_SYSROOT AND CMAKE_C_SYSROOT_FLAG)
+			set(LIBUCONTEXT_CFLAGS "${LIBUCONTEXT_CFLAGS} ${CMAKE_C_SYSROOT_FLAG} ${CMAKE_OSX_SYSROOT}")
+		endif ()
+		if (CMAKE_OSX_DEPLOYMENT_TARGET AND CMAKE_C_OSX_DEPLOYMENT_TARGET_FLAG)
+			set(LIBUCONTEXT_CFLAGS "${LIBUCONTEXT_CFLAGS} ${CMAKE_C_OSX_DEPLOYMENT_TARGET_FLAG}${CMAKE_OSX_DEPLOYMENT_TARGET}")
+		endif ()
+
+		set(LIBUCONTEXT_MAKE_ARGS ARCH=${LIBUCONTEXT_ARCH} "CC=${CMAKE_C_COMPILER}" "CFLAGS=${LIBUCONTEXT_CFLAGS}")
+	else ()
+		set(LIBUCONTEXT_MAKE_ARGS FREESTANDING=yes)
+	endif ()
+
 	ExternalProject_Add(libucontext
 		SOURCE_DIR ${CMAKE_SOURCE_DIR}/src/3rdparty/libucontext
 
 		BUILD_IN_SOURCE ON
 
 		CONFIGURE_COMMAND ""
-		BUILD_COMMAND make libucontext.a FREESTANDING=yes
-		INSTALL_COMMAND make install-static install-headers DESTDIR=${CMAKE_BINARY_DIR} FREESTANDING=yes
+		BUILD_COMMAND make libucontext.a ${LIBUCONTEXT_MAKE_ARGS}
+		INSTALL_COMMAND make install-static install-headers DESTDIR=${CMAKE_BINARY_DIR} ${LIBUCONTEXT_MAKE_ARGS}
 
 		BUILD_BYPRODUCTS ${CMAKE_BINARY_DIR}/usr/lib/libucontext.a
 
@@ -167,7 +197,11 @@
 	add_dependencies(lwan-static libucontext)
 
 	set(ADDITIONAL_LIBRARIES ${CMAKE_BINARY_DIR}/usr/lib/libucontext.a ${ADDITIONAL_LIBRARIES} PARENT_SCOPE)
-	include_directories(${CMAKE_BINARY_DIR}/usr/include)
+
+	# That only reaches the parent scope, after lwan-shared has been linked
+	# with ADDITIONAL_LIBRARIES, so liblwan itself would be left with
+	# undefined references to libucontext, which Darwin does not allow.
+	target_link_libraries(lwan-shared ${CMAKE_BINARY_DIR}/usr/lib/libucontext.a)
 else ()
 	message(STATUS "Using built-in context switching routines for ${CMAKE_SYSTEM_PROCESSOR} processors")
 endif ()
--- src/bin/tools/CMakeLists.txt.orig
+++ src/bin/tools/CMakeLists.txt
@@ -44,5 +44,13 @@
 
 	add_executable(statuslookupgen statuslookupgen.c)
 
+	if (LWAN_HAVE_LIBUCONTEXT)
+		# These include lwan-coro.h, so the libucontext headers have to be
+		# installed before they are compiled.
+		add_dependencies(mimegen libucontext)
+		add_dependencies(configdump libucontext)
+		add_dependencies(bin2hex libucontext)
+	endif ()
+
 	export(TARGETS statuslookupgen weighttp configdump mimegen bin2hex FILE ${CMAKE_BINARY_DIR}/ImportExecutables.cmake)
 endif ()
