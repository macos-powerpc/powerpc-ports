+	lwz	r12, SS_XER + 4(r11)
+	rldimi	r12, r0, 32, 0
+	mtxer	r12
+	lwz	r0, SS_LR(r11)
+	lwz	r12, SS_LR + 4(r11)
+	rldimi	r12, r0, 32, 0
+	mtlr	r12
+	ld	r0, SS_SRR0(r11)
