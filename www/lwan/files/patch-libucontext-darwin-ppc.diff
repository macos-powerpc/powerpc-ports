@@ -33,14 +35,26 @@
 # endif
 #endif
 
+/* On PowerPC, the Mach-O assembler starts a comment at ';' and separates
+ * statements with '@' instead. */
+#if defined(__MACH__) && (defined(__ppc__) || defined(__ppc64__))
 #define FUNC(__proc)					\
-	.global PROC_NAME(__proc);			\
+	.globl PROC_NAME(__proc) @			\
+	.align  2 @					\
+	TYPE(__proc)					\
+	ENT(__proc)					\
+PROC_NAME(__proc):					\
+	SETUP_FRAME(__proc)
+#else
+#define FUNC(__proc)					\
+	.globl PROC_NAME(__proc);			\
 	.align  2;					\
 	TYPE(__proc)					\
 	ENT(__proc)					\
 PROC_NAME(__proc):					\
 	SETUP_FRAME(__proc)
-#ifdef __clang__
+#endif
+#if defined(__clang__) || defined(__MACH__)
 #define END(__proc)
 #else
 #define END(__proc)					\
