+++ src/3rdparty/libucontext/arch/ppc/darwin/defs.h
@@ -0,0 +1,97 @@
+#ifndef __ARCH_PPC_DARWIN_DEFS_H
+#define __ARCH_PPC_DARWIN_DEFS_H
+
+/*
+ * Darwin (Mac OS X) 32-bit PowerPC ucontext_t, as declared by
+ * <sys/_structs.h>, <ppc/_structs.h> and <mach/ppc/_structs.h> when
+ * _XOPEN_SOURCE is defined:
+ *
+ *   struct __darwin_ucontext {
+ *     int                            uc_onstack;          0
+ *     __darwin_sigset_t              uc_sigmask;          4
+ *     struct __darwin_sigaltstack    uc_stack;            8  (12 bytes)
+ *     struct __darwin_ucontext      *uc_link;            20
+ *     __darwin_size_t                uc_mcsize;          24
+ *     struct __darwin_mcontext      *uc_mcontext;        28
+ *     struct __darwin_mcontext       __mcontext_data;    32  (1032 bytes)
+ *   };                                      sizeof = 1064
+ *
+ *   struct __darwin_mcontext {
+ *     struct __darwin_ppc_exception_state  __es;          0  (32 bytes)
+ *     struct __darwin_ppc_thread_state     __ss;         32  (160 bytes)
+ *     struct __darwin_ppc_float_state      __fs;        192  (264 bytes)
+ *     struct __darwin_ppc_vector_state     __vs;        456  (576 bytes)
+ *   };                                      sizeof = 1032
+ *
+ * This is also what the kernel hands to signal handlers: uc_mcontext then
+ * points at a struct of the same shape on the signal stack, and uc_mcsize
+ * tells whether __vs has been filled in (bsd/dev/ppc/unix_signal.c).
+ */
+
+#define REG_SZ			(4)
+
+/* offsets within ucontext_t */
+#define UC_ONSTACK		(0)
+#define UC_SIGMASK		(4)
+#define UC_STACK		(8)
+#define UC_LINK			(20)
+#define UC_MCSIZE		(24)
+#define UC_MCONTEXT		(28)
+#define UC_MCONTEXT_DATA	(32)
+#define UCONTEXT_SIZE		(1064)
+
+/* offsets within struct __darwin_mcontext */
+#define MCONTEXT_SIZE		(1032)
+#define MC_ES			(0)
+#define MC_SS			(32)
+#define MC_FS			(192)
+#define MC_VS			(456)
+
+/* struct __darwin_ppc_thread_state */
+#define SS_SRR0			(MC_SS + 0)
+#define SS_SRR1			(MC_SS + 4)
+#define SS_R(n)			(MC_SS + 8 + REG_SZ * (n))
+#define SS_CR			(MC_SS + 136)
+#define SS_XER			(MC_SS + 140)
+#define SS_LR			(MC_SS + 144)
+#define SS_CTR			(MC_SS + 148)
+#define SS_MQ			(MC_SS + 152)
+#define SS_VRSAVE		(MC_SS + 156)
+
+/* struct __darwin_ppc_float_state */
+#define FS_F(n)			(MC_FS + 8 * (n))
+#define FS_FPSCR_PAD		(MC_FS + 256)
+#define FS_FPSCR		(MC_FS + 260)
+
+/* struct __darwin_ppc_vector_state */
+#define VS_VR(n)		(MC_VS + 16 * (n))
+#define VS_VSCR			(MC_VS + 512)
+#define VS_VRVALID		(MC_VS + 544)
+
+/*
+ * uc_mcsize values used by the kernel: UC_FLAVOR_SIZE when the thread never
+ * touched AltiVec, UC_FLAVOR_VEC_SIZE (== MCONTEXT_SIZE) when __vs is valid.
+ */
+#define UC_FLAVOR_SIZE		(456)
+#define UC_FLAVOR_VEC_SIZE	(1032)
+
+/*
+ * The comm page is mapped at the same address in every process, and its
+ * _COMM_PAGE_CPU_CAPABILITIES word tells whether the CPU has AltiVec
+ * (osfmk/ppc/cpu_capabilities.h).  0xffff8020, as a signed 16-bit
+ * immediate so that a single li produces it.
+ */
+#define COMM_PAGE_CPU_CAPABILITIES	(-32736)
+#define kHasAltivec			(0x00000001)
+
+/*
+ * Register used to hand uc_link to the trampoline.  It has to be
+ * callee-saved, and on Darwin it must not be r30 (frame pointer) or
+ * r31 (PIC base), which the trampoline's prologue may clobber.
+ */
+#define FETCH_LINKPTR(dest) \
+	asm("mr %0, r14" : "=r" ((dest)))
+
+#include "common-defs.h"
+
+#endif
