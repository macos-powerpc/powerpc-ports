+	lfd	f0, FS_F(0)(r11)
+	lfd	f1, FS_F(1)(r11)
+	lfd	f2, FS_F(2)(r11)
+	lfd	f3, FS_F(3)(r11)
+	lfd	f4, FS_F(4)(r11)
+	lfd	f5, FS_F(5)(r11)
+	lfd	f6, FS_F(6)(r11)
+	lfd	f7, FS_F(7)(r11)
+	lfd	f8, FS_F(8)(r11)
+	lfd	f9, FS_F(9)(r11)
+	lfd	f10, FS_F(10)(r11)
+	lfd	f11, FS_F(11)(r11)
+	lfd	f12, FS_F(12)(r11)
+	lfd	f13, FS_F(13)(r11)
+	lfd	f14, FS_F(14)(r11)
+	lfd	f15, FS_F(15)(r11)
+	lfd	f16, FS_F(16)(r11)
+	lfd	f17, FS_F(17)(r11)
+	lfd	f18, FS_F(18)(r11)
+	lfd	f19, FS_F(19)(r11)
+	lfd	f20, FS_F(20)(r11)
