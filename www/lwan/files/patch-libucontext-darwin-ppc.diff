+	ld	r9, 128 + 8(r10)
+	std	r0, 0(r12)
+	std	r9, 8(r12)
+	lvx	v28, 0, r12
+
+	ld	r0, 144(r10)
+	ld	r9, 144 + 8(r10)
+	std	r0, 0(r12)
+	std	r9, 8(r12)
+	lvx	v29, 0, r12
+
+	ld	r0, 160(r10)
+	ld	r9, 160 + 8(r10)
+	std	r0, 0(r12)
+	std	r9, 8(r12)
+	lvx	v30, 0, r12
