Add the Darwin (Mac OS X 10.5/10.6) ppc and ppc64 ports to the bundled
libucontext 1.2, backported from the darwin-ppc series for libucontext
1.5.2: arch/ppc{,64}/darwin, a Makefile that builds them on Darwin (the
32-bit port with -force_cpusubtype_ALL, as its AltiVec code only runs on
CPUs that have it), Mach-O friendly assembler macros (on PowerPC, cctools
as starts a comment at ';', so FUNC() separates statements with '@'),
and a greg_t / _XOPEN_SOURCE fix in bits.h.

--- src/3rdparty/libucontext/Makefile.orig
+++ src/3rdparty/libucontext/Makefile
@@ -16,6 +16,26 @@
 ifeq ($(ARCH),$(filter $(ARCH),arm64))
 	override ARCH = aarch64
 endif
+# Darwin reports "Power Macintosh" for both the 32-bit and the 64-bit PowerPC
+# userland, so ask the compiler which one it is targeting.
+ifeq ($(ARCH),Power Macintosh)
+	override ARCH := $(shell if $(CC) $(CFLAGS) -dM -E - </dev/null 2>/dev/null | grep -q __ppc64__; then echo ppc64; else echo ppc; fi)
+endif
+
+# Architectures whose Darwin implementation is separate from the Linux one
+# keep it in a darwin/ subdirectory.
+ARCH_DIR := arch/${ARCH}
+ifeq ($(shell uname),Darwin)
+ifneq ($(wildcard arch/${ARCH}/darwin),)
+	ARCH_DIR := arch/${ARCH}/darwin
+endif
+endif
+
+# The 32-bit Darwin swapcontext uses AltiVec only when the CPU has it, so it
+# must be assembled for every PowerPC, not just for ppc7400 and later.
+ifeq ($(ARCH_DIR),arch/ppc/darwin)
+	ASFLAGS = -Wa,-force_cpusubtype_ALL
+endif
 
 prefix = /usr
 libdir = ${prefix}/lib
@@ -25,12 +45,13 @@
 pkgconfigdir = ${prefix}/lib/pkgconfig
 
 CFLAGS ?= -ggdb3 -O2 -Wall
-CPPFLAGS := -Iinclude -Iarch/${ARCH} -Iarch/common
+CPPFLAGS := -Iinclude -I${ARCH_DIR} -Iarch/common
 ifneq ($(shell uname),Darwin)
 	EXPORT_UNPREFIXED := yes
 else
 	# Darwin does not support aliases
 	EXPORT_UNPREFIXED := no
+	CPPFLAGS += -D_XOPEN_SOURCE
 endif
 FREESTANDING := no
 
@@ -55,8 +76,8 @@
 	CPPFLAGS += -DEXPORT_UNPREFIXED
 endif
 
-LIBUCONTEXT_C_SRC = $(wildcard arch/${ARCH}/*.c)
-LIBUCONTEXT_S_SRC = $(wildcard arch/${ARCH}/*.S)
+LIBUCONTEXT_C_SRC = $(wildcard ${ARCH_DIR}/*.c)
+LIBUCONTEXT_S_SRC = $(wildcard ${ARCH_DIR}/*.S)
 
 ifeq ($(shell test -d arch/${ARCH}/include; echo $?),0)
 	CPPFLAGS += -Iarch/${ARCH}/include
--- src/3rdparty/libucontext/arch/common/common-defs.h.orig
+++ src/3rdparty/libucontext/arch/common/common-defs.h
@@ -17,9 +17,11 @@
 # define ENT(__proc)
 #endif
 
+/* .type/.size/.end are ELF-only; neither clang's integrated assembler nor
+ * the Mach-O assembler accept them. */
 #ifndef TYPE
-# ifdef __clang__
-#  define TYPE(__proc) // .type not supported
+# if defined(__clang__) || defined(__MACH__)
+#  define TYPE(__proc)
