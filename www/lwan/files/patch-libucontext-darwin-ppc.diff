+/*
+ * Copyright (c) 2026 Sergey Fedorov
+ *
+ * Permission to use, copy, modify, and/or distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * This software is provided 'as is' and without any warranty, express or
+ * implied.  In no event shall the authors be liable for any damages arising
+ * from the use of this software.
+ */
+
+/* _STRUCT_MCONTEXT64 is only visible with _DARWIN_C_SOURCE */
+#define _DARWIN_C_SOURCE 1
+#ifndef _XOPEN_SOURCE
+# define _XOPEN_SOURCE 1
+#endif
+
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "defs.h"
+#include <libucontext/libucontext.h>
+
+
+extern void libucontext_trampoline(void);
+
+
+/* the assembly relies on this layout */
+_Static_assert(sizeof(libucontext_ucontext_t) == UCONTEXT_SIZE, "UCONTEXT_SIZE is invalid");
+_Static_assert(offsetof(libucontext_ucontext_t, uc_mcsize) == UC_MCSIZE, "UC_MCSIZE is invalid");
+_Static_assert(offsetof(libucontext_ucontext_t, uc_mcontext) == UC_MCONTEXT, "UC_MCONTEXT is invalid");
+_Static_assert(offsetof(libucontext_ucontext_t, __mcontext_data) == UC_MCONTEXT_DATA, "UC_MCONTEXT_DATA is invalid");
+_Static_assert(sizeof(_STRUCT_MCONTEXT) == MCONTEXT_SIZE, "MCONTEXT_SIZE is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __ss.__srr0) == SS_SRR0, "SS_SRR0 is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __ss.__r0) == SS_R(0), "SS_R is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __ss.__r31) == SS_R(31), "SS_R is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __ss.__cr) == SS_CR, "SS_CR is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __ss.__xer) == SS_XER, "SS_XER is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __ss.__lr) == SS_LR, "SS_LR is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __ss.__ctr) == SS_CTR, "SS_CTR is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __ss.__vrsave) == SS_VRSAVE, "SS_VRSAVE is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __fs.__fpregs[0]) == FS_F(0), "FS_F is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __fs.__fpscr_pad) == FS_FPSCR_PAD, "FS_FPSCR_PAD is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __fs.__fpscr) == FS_FPSCR, "FS_FPSCR is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __vs.__save_vr[0]) == VS_VR(0), "VS_VR is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __vs.__save_vscr) == VS_VSCR, "VS_VSCR is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __vs.__save_vrvalid) == VS_VRVALID, "VS_VRVALID is invalid");
+_Static_assert(offsetof(_STRUCT_MCONTEXT, __vs) == UC_FLAVOR_SIZE, "UC_FLAVOR_SIZE is invalid");
+
+
+/*
+ * Darwin 32-bit PowerPC stack frame, as seen by the called function:
+ *
+ *    0(sp)  back chain
+ *    4(sp)  CR save word
+ *    8(sp)  LR save word
+ *   12(sp)  reserved
+ *   16(sp)  reserved
+ *   20(sp)  reserved (TOC save word)
+ *   24(sp)  parameter area: at least 8 words, argument i lives at 24 + 4*i
+ *
+ * The stack pointer must be 16-byte aligned.
+ */
+#define LINKAGE_AREA	(24)
+#define PARAM_AREA_MIN	(8)
+
+
+void
+libucontext_makecontext(libucontext_ucontext_t *ucp, void (*func)(), int argc, ...)
+{
+	_STRUCT_MCONTEXT *mc = &ucp->__mcontext_data;
+	libucontext_greg_t *sp, *params;
+	size_t frame;
+	va_list va;
+	int i;
+
+	ucp->uc_mcontext = &ucp->__mcontext_data;
+
+	/* linkage area plus parameter area, rounded up to the stack alignment */
+	frame = LINKAGE_AREA + REG_SZ * (size_t) (argc > PARAM_AREA_MIN ? argc : PARAM_AREA_MIN);
+	frame = (frame + 15) & ~(size_t) 15;
+
+	sp = (libucontext_greg_t *) (((uintptr_t) ucp->uc_stack.ss_sp + ucp->uc_stack.ss_size) & ~(uintptr_t) 15);
+	sp = (libucontext_greg_t *) ((uintptr_t) sp - frame);
+	params = (libucontext_greg_t *) ((uintptr_t) sp + LINKAGE_AREA);
+
+	/* terminate the back chain for unwinders */
+	sp[0] = 0;
+
+	mc->__ss.__srr0 = (uintptr_t) func;
+	mc->__ss.__lr   = (uintptr_t) &libucontext_trampoline;
+	mc->__ss.__r1   = (uintptr_t) sp;
+	mc->__ss.__r14  = (uintptr_t) ucp->uc_link;
+
+	va_start(va, argc);
+
+	for (i = 0; i < argc; i++) {
+		libucontext_greg_t arg = va_arg(va, libucontext_greg_t);
+
+		switch (i) {
+		case 0: mc->__ss.__r3  = arg; break;
+		case 1: mc->__ss.__r4  = arg; break;
+		case 2: mc->__ss.__r5  = arg; break;
+		case 3: mc->__ss.__r6  = arg; break;
+		case 4: mc->__ss.__r7  = arg; break;
+		case 5: mc->__ss.__r8  = arg; break;
+		case 6: mc->__ss.__r9  = arg; break;
+		case 7: mc->__ss.__r10 = arg; break;
+		default: params[i] = arg; break;
+		}
+	}
+
+	va_end(va);
+}
