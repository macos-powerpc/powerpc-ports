+#ifndef __ARCH_PPC64_DARWIN_DEFS_H
+#define __ARCH_PPC64_DARWIN_DEFS_H
+
+/*
+ * Darwin (Mac OS X) 64-bit PowerPC ucontext_t.  <sys/_structs.h> declares the
+ * same struct __darwin_ucontext for LP64:
+ *
+ *   struct __darwin_ucontext {
+ *     int                            uc_onstack;          0
+ *     __darwin_sigset_t              uc_sigmask;          4
+ *     struct __darwin_sigaltstack    uc_stack;            8  (24 bytes)
+ *     struct __darwin_ucontext      *uc_link;            32
+ *     __darwin_size_t                uc_mcsize;          40
+ *     struct __darwin_mcontext      *uc_mcontext;        48
+ *     struct __darwin_mcontext       __mcontext_data;    56  (1032 bytes)
+ *   };                                      sizeof = 1088
+ *
+ * but struct __darwin_mcontext only has room for 32-bit registers.  What a
+ * 64-bit process really receives from the kernel in a signal handler, and
+ * what sigreturn expects back, is a struct __darwin_mcontext64:
+ *
+ *   struct __darwin_mcontext64 {
+ *     struct __darwin_ppc_exception_state64 __es;         0  (32 bytes)
+ *     struct __darwin_ppc_thread_state64    __ss;        32  (304 bytes)
+ *     struct __darwin_ppc_float_state       __fs;       336  (264 bytes)
+ *     struct __darwin_ppc_vector_state      __vs;       600  (576 bytes)
+ *   };                                      sizeof = 1176
+ *
+ * which does not fit in __mcontext_data.  The 64-bit exception, thread and
+ * float state (600 bytes) does fit, so those are kept in the kernel's layout,
+ * and the callee-saved vector registers go in the remaining space right
+ * after the float state.  uc_mcsize tells the two vector layouts apart: a
+ * context created by libucontext carries sizeof(__mcontext_data) (1032),
+ * one created by the kernel carries UC_FLAVOR64_SIZE (600, no vector state)
+ * or UC_FLAVOR64_VEC_SIZE (1176, __vs valid).
+ */
+
+#define REG_SZ			(8)
+
+/* offsets within ucontext_t */
+#define UC_ONSTACK		(0)
+#define UC_SIGMASK		(4)
+#define UC_STACK		(8)
+#define UC_LINK			(32)
+#define UC_MCSIZE		(40)
+#define UC_MCONTEXT		(48)
+#define UC_MCONTEXT_DATA	(56)
+#define UCONTEXT_SIZE		(1088)
+
+/* sizes of the machine contexts */
+#define MCONTEXT_SIZE		(1032)	/* struct __darwin_mcontext, the embedded buffer */
+#define MCONTEXT64_SIZE		(1176)	/* struct __darwin_mcontext64 */
+#define UC_FLAVOR64_SIZE	(600)
+#define UC_FLAVOR64_VEC_SIZE	MCONTEXT64_SIZE
+
+/* offsets within struct __darwin_mcontext64 */
+#define MC_ES			(0)
+#define MC_SS			(32)
+#define MC_FS			(336)
+#define MC_VS			(600)
+
+/* struct __darwin_ppc_thread_state64, which is packed to 4 bytes */
+#define SS_SRR0			(MC_SS + 0)
+#define SS_SRR1			(MC_SS + 8)
+#define SS_R(n)			(MC_SS + 16 + REG_SZ * (n))
+#define SS_CR			(MC_SS + 272)
+#define SS_XER			(MC_SS + 276)
+#define SS_LR			(MC_SS + 284)
+#define SS_CTR			(MC_SS + 292)
+#define SS_VRSAVE		(MC_SS + 300)
+
+/* struct __darwin_ppc_float_state */
+#define FS_F(n)			(MC_FS + 8 * (n))
+#define FS_FPSCR_PAD		(MC_FS + 256)
+#define FS_FPSCR		(MC_FS + 260)
+
+/* struct __darwin_ppc_vector_state, as laid out by the kernel */
+#define VS_VR(n)		(MC_VS + 16 * (n))
+#define VS_VSCR			(MC_VS + 512)
+#define VS_VRVALID		(MC_VS + 544)
+
+/* libucontext's own vector save area: v20..v31 followed by VSCR */
+#define LVS_VR(n)		(MC_VS + 16 * ((n) - 20))
+#define LVS_VSCR		(MC_VS + 192)
+#define LVS_END			(MC_VS + 208)
+
+/* distance from the v20 slot to the VSCR slot, the same in both layouts */
+#define VSCR_FROM_V20		(192)
+
+/*
+ * Register used to hand uc_link to the trampoline.  It has to be
+ * callee-saved, and on Darwin it must not be r30 (frame pointer) or
+ * r31 (PIC base), which the trampoline's prologue may clobber.
+ */
+#define FETCH_LINKPTR(dest) \
+	asm("mr %0, r14" : "=r" ((dest)))
+
+#include "common-defs.h"
+
+#endif
