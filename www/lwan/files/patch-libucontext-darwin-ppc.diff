+ * int libucontext_swapcontext(libucontext_ucontext_t *oucp,
+ *                             const libucontext_ucontext_t *ucp);
+ *
+ * This is also the backend for libucontext_getcontext (ucp == NULL, save
+ * only) and libucontext_setcontext (oucp == NULL, restore only).
