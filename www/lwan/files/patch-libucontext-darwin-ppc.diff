+	ld	r0, 0(r12)
+	ld	r9, 8(r12)
+	std	r0, 64(r10)
+	std	r9, 64 + 8(r10)
+
+	stvx	v25, 0, r12
+	ld	r0, 0(r12)
+	ld	r9, 8(r12)
+	std	r0, 80(r10)
+	std	r9, 80 + 8(r10)
