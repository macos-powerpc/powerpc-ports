+	srdi	r12, r0, 32
+	stw	r12, SS_LR(r11)
+	stw	r0, SS_LR + 4(r11)
+	li	r0, 0
+	std	r0, SS_R(3)(r11)
+	mfcr	r0
+	stw	r0, SS_CR(r11)
+
+	/* non-volatile GPRs */
+	std	r1, SS_R(1)(r11)
+	std	r2, SS_R(2)(r11)
+	std	r13, SS_R(13)(r11)
+	std	r14, SS_R(14)(r11)
+	std	r15, SS_R(15)(r11)
+	std	r16, SS_R(16)(r11)
+	std	r17, SS_R(17)(r11)
+	std	r18, SS_R(18)(r11)
+	std	r19, SS_R(19)(r11)
+	std	r20, SS_R(20)(r11)
+	std	r21, SS_R(21)(r11)
+	std	r22, SS_R(22)(r11)
+	std	r23, SS_R(23)(r11)
+	std	r24, SS_R(24)(r11)
+	std	r25, SS_R(25)(r11)
+	std	r26, SS_R(26)(r11)
+	std	r27, SS_R(27)(r11)
+	std	r28, SS_R(28)(r11)
+	std	r29, SS_R(29)(r11)
+	std	r30, SS_R(30)(r11)
+	std	r31, SS_R(31)(r11)
