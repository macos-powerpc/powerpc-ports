+ * implied.  In no event shall the authors be liable for any damages arising
+ * from the use of this software.
+ */
+
+#include "defs.h"
+
+	.text
+
+/*
+ * int libucontext_swapcontext(libucontext_ucontext_t *oucp,
+ *                             const libucontext_ucontext_t *ucp);
+ *
+ * This is also the backend for libucontext_getcontext (ucp == NULL, save
+ * only) and libucontext_setcontext (oucp == NULL, restore only).
+ *
+ * Saving records the callee-saved state at the point of the call, so that
+ * resuming the context looks like returning 0 from this function.  Restoring
+ * loads the whole thread state, so that a context built by the kernel for a
+ * signal handler can be resumed as well; the one exception is CTR, which is
+ * needed for the final jump.
+ */
+FUNC(libucontext_swapcontext)
+	cmpwi	r3, 0
+	beq	Lrestore
+
+	/* oucp->uc_mcontext = &oucp->__mcontext_data */
+	addi	r11, r3, UC_MCONTEXT_DATA
+	stw	r11, UC_MCONTEXT(r3)
+	li	r0, MCONTEXT_SIZE
+	stw	r0, UC_MCSIZE(r3)
+
+	/* resume at our return address, returning 0 */
+	mflr	r0
+	stw	r0, SS_SRR0(r11)
+	stw	r0, SS_LR(r11)
+	li	r0, 0
+	stw	r0, SS_R(3)(r11)
+	mfcr	r0
+	stw	r0, SS_CR(r11)
+
+	/* non-volatile GPRs */
+	stw	r1, SS_R(1)(r11)
+	stw	r2, SS_R(2)(r11)
+	stw	r13, SS_R(13)(r11)
+	stw	r14, SS_R(14)(r11)
+	stw	r15, SS_R(15)(r11)
+	stw	r16, SS_R(16)(r11)
+	stw	r17, SS_R(17)(r11)
+	stw	r18, SS_R(18)(r11)
+	stw	r19, SS_R(19)(r11)
+	stw	r20, SS_R(20)(r11)
+	stw	r21, SS_R(21)(r11)
+	stw	r22, SS_R(22)(r11)
+	stw	r23, SS_R(23)(r11)
+	stw	r24, SS_R(24)(r11)
+	stw	r25, SS_R(25)(r11)
+	stw	r26, SS_R(26)(r11)
+	stw	r27, SS_R(27)(r11)
+	stw	r28, SS_R(28)(r11)
+	stw	r29, SS_R(29)(r11)
+	stw	r30, SS_R(30)(r11)
+	stw	r31, SS_R(31)(r11)
+
+#ifndef FORCE_SOFT_FLOAT
+	/* FPSCR and non-volatile FPRs */
+	mffs	f0
+	stfd	f0, FS_FPSCR_PAD(r11)
+	stfd	f14, FS_F(14)(r11)
+	stfd	f15, FS_F(15)(r11)
+	stfd	f16, FS_F(16)(r11)
+	stfd	f17, FS_F(17)(r11)
+	stfd	f18, FS_F(18)(r11)
+	stfd	f19, FS_F(19)(r11)
+	stfd	f20, FS_F(20)(r11)
+	stfd	f21, FS_F(21)(r11)
+	stfd	f22, FS_F(22)(r11)
+	stfd	f23, FS_F(23)(r11)
+	stfd	f24, FS_F(24)(r11)
+	stfd	f25, FS_F(25)(r11)
+	stfd	f26, FS_F(26)(r11)
+	stfd	f27, FS_F(27)(r11)
+	stfd	f28, FS_F(28)(r11)
+	stfd	f29, FS_F(29)(r11)
+	stfd	f30, FS_F(30)(r11)
+	stfd	f31, FS_F(31)(r11)
+
+	/* VRSAVE and non-volatile VRs, if this CPU has AltiVec */
+	li	r12, COMM_PAGE_CPU_CAPABILITIES
+	lwz	r12, 0(r12)
+	andi.	r12, r12, kHasAltivec
+	beq	Lsaved
+
+	mfspr	r0, 256
+	stw	r0, SS_VRSAVE(r11)
+
+	/*
+	 * The vector save area is only 4-byte aligned, while stvx and lvx need a
+	 * 16-byte aligned address, so go through a scratch quadword in the red
+	 * zone below the stack pointer.
+	 */
+	rlwinm	r12, r1, 0, 0, 27
+	addi	r12, r12, -16
+
+	mfvscr	v0
+	stvx	v0, 0, r12
+	lfd	f0, 0(r12)
+	lfd	f1, 8(r12)
+	stfd	f0, VS_VSCR(r11)
+	stfd	f1, VS_VSCR + 8(r11)
+
+	stvx	v20, 0, r12
+	lfd	f0, 0(r12)
+	lfd	f1, 8(r12)
+	stfd	f0, VS_VR(20)(r11)
+	stfd	f1, VS_VR(20) + 8(r11)
+
+	stvx	v21, 0, r12
+	lfd	f0, 0(r12)
+	lfd	f1, 8(r12)
+	stfd	f0, VS_VR(21)(r11)
+	stfd	f1, VS_VR(21) + 8(r11)
+
+	stvx	v22, 0, r12
+	lfd	f0, 0(r12)
+	lfd	f1, 8(r12)
+	stfd	f0, VS_VR(22)(r11)
+	stfd	f1, VS_VR(22) + 8(r11)
+
+	stvx	v23, 0, r12
+	lfd	f0, 0(r12)
+	lfd	f1, 8(r12)
+	stfd	f0, VS_VR(23)(r11)
+	stfd	f1, VS_VR(23) + 8(r11)
+
+	stvx	v24, 0, r12
+	lfd	f0, 0(r12)
+	lfd	f1, 8(r12)
+	stfd	f0, VS_VR(24)(r11)
+	stfd	f1, VS_VR(24) + 8(r11)
+
+	stvx	v25, 0, r12
+	lfd	f0, 0(r12)
+	lfd	f1, 8(r12)
+	stfd	f0, VS_VR(25)(r11)
+	stfd	f1, VS_VR(25) + 8(r11)
+
+	stvx	v26, 0, r12
+	lfd	f0, 0(r12)
+	lfd	f1, 8(r12)
+	stfd	f0, VS_VR(26)(r11)
+	stfd	f1, VS_VR(26) + 8(r11)
