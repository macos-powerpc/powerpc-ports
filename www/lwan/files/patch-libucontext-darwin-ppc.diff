+	ld	r15, SS_R(15)(r11)
+	ld	r16, SS_R(16)(r11)
+	ld	r17, SS_R(17)(r11)
+	ld	r18, SS_R(18)(r11)
+	ld	r19, SS_R(19)(r11)
+	ld	r20, SS_R(20)(r11)
+	ld	r21, SS_R(21)(r11)
+	ld	r22, SS_R(22)(r11)
+	ld	r23, SS_R(23)(r11)
+	ld	r24, SS_R(24)(r11)
+	ld	r25, SS_R(25)(r11)
+	ld	r26, SS_R(26)(r11)
+	ld	r27, SS_R(27)(r11)
+	ld	r28, SS_R(28)(r11)
+	ld	r29, SS_R(29)(r11)
+	ld	r30, SS_R(30)(r11)
+	ld	r31, SS_R(31)(r11)
+	ld	r0, SS_R(0)(r11)
+	ld	r3, SS_R(3)(r11)
+	ld	r11, SS_R(11)(r11)
