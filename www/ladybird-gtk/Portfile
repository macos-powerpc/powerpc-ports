# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1
PortGroup           openssl 1.0

legacysupport.newest_darwin_requires_legacy 15
legacysupport.redirect_bins ladybird-gtk

openssl.branch      3

# Branch ppc of the fork, the same tree ladybird-headless builds: upstream 22e8e99d4c
# (2026-03-19) with the portability changes, plus upstream's UI/Gtk and our adaptations.
# The version is the date of upstream's GTK frontend, not the tag: revbump with every tag.
github.setup        barracuda156 ladybird 20260319.3 ppc-
version             20260417
revision            1
name                ladybird-gtk
categories          www gnome
license             BSD
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer

description         GTK4 frontend for the Ladybird web browser
long_description    A browser window for the Ladybird engine of ladybird-headless, \
                    built with GTK4 and libadwaita: tabs, location bar with \
                    autocompletion, find in page, zoom, context menus, JavaScript \
                    dialogs and file pickers. It runs on the X11 or Wayland backend \
                    of GTK and shares the engine libraries, helper processes and \
                    resources of ladybird-headless, which it is built against. \
                    The frontend is the GTK UI that upstream carried from April to \
                    July 2026, adapted to the engine of ladybird-headless.

homepage            https://ladybird.org

checksums           rmd160  9c045517a5d471a87b6193f9fa3f48b8be99be60 \
                    sha256  def0869d18958ff5c87604e59ed5933e3df2f2b19cd94896cd21266f9c295e02 \
                    size    35013665
github.tarball_from archive

# Only the frontend is used; the engine headers and libraries come from ladybird-headless.
# GitHub names the top directory of a tag archive <project>-<tag>.
set archive_topdir  ${github.project}-${github.tag_prefix}${github.version}
extract.post_args-append \
                    ${archive_topdir}/UI/Gtk \
                    ${archive_topdir}/LICENSE \
                    ${archive_topdir}/Meta/CMake/freedesktop/org.ladybird.Ladybird.svg

cmake.source_dir    ${worksrcpath}/UI/Gtk
cmake.generator     Ninja

compiler.cxx_standard   2023
compiler.blacklist-append {clang < 1900}

depends_build-append \
                    path:bin/pkg-config:pkgconfig \
                    path:bin/glib-compile-resources:glib2 \
                    path:bin/xmllint:libxml2

depends_lib-append  path:lib/pkgconfig/glib-2.0.pc:glib2 \
                    path:lib/pkgconfig/gtk4.pc:gtk4 \
                    port:ladybird-headless \
                    path:lib/pkgconfig/libadwaita-1.pc:libadwaita

depends_run-append  port:adwaita-icon-theme

post-destroot {
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/LICENSE ${destroot}${prefix}/share/doc/${name}
}

post-activate {
    system "${prefix}/bin/gtk4-update-icon-cache -f -t ${prefix}/share/icons/hicolor"
}

notes "
Run ${prefix}/bin/ladybird-gtk \[URL\] in an X11 or Wayland session\
 (DISPLAY or WAYLAND_DISPLAY set). With a D-Bus session bus, a second\
 invocation opens its URLs in the running browser.
"

notes-append "
You may need to export GSK_RENDERER=cairo to the environment, since GTK4 removed support for older OpenGL.
Also, Mesa EGL is unstable via llvmpipe and slow via softpipe, so Cairo just works better.
"

livecheck.type      none
