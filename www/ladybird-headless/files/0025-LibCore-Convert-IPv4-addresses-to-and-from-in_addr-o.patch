From 3153f7502d2cd6af495eb3bc394f8f092d3efbf6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 25 Sep 2026 22:17:11 +0000
Subject: [PATCH 25/26] LibCore: Convert IPv4 addresses to and from in_addr
 octet by octet

IPv4Address keeps the first octet in the low byte of its u32 on every
host, which is also network order in memory only on little-endian ones.
The four places that copied raw s_addr bits in or out therefore reversed
the address on big-endian hosts: every name the system resolver looked
up became d.c.b.a, so RequestServer handed curl the wrong IP and the
request hung until the connect timeout, and sockets connected or bound
to parsed addresses went to the reversed one.

Build the IPv4Address from the s_addr bytes, and write s_addr from its
octets. On little-endian hosts the bits are unchanged. LibDNS and LibURL
already read and write addresses by value and need no change.
---
 Libraries/LibCore/Socket.cpp        | 5 +++--
 Libraries/LibCore/SocketAddress.cpp | 5 ++++-
 Libraries/LibCore/TCPServer.cpp     | 2 +-
 Libraries/LibCore/UDPServer.cpp     | 2 +-
 4 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/Libraries/LibCore/Socket.cpp b/Libraries/LibCore/Socket.cpp
index 899e1867..e897a98c 100644
--- a/Libraries/LibCore/Socket.cpp
+++ b/Libraries/LibCore/Socket.cpp
@@ -85,8 +85,9 @@ ErrorOr<Vector<Variant<IPv4Address, IPv6Address>>> Socket::resolve_host(ByteStri
 
         if (result.ai_family == AF_INET) {
             auto* socket_address = bit_cast<struct sockaddr_in*>(result.ai_addr);
-            NetworkOrdered<u32> const network_ordered_address { socket_address->sin_addr.s_addr };
-            addresses.append(IPv4Address { network_ordered_address });
+            // s_addr holds the octets in network order, while IPv4Address keeps the first octet in its low byte on
+            // every host; going through the octets keeps big-endian hosts from reversing the address.
+            addresses.append(IPv4Address { bit_cast<u8 const*>(&socket_address->sin_addr.s_addr) });
         }
     }
 
diff --git a/Libraries/LibCore/SocketAddress.cpp b/Libraries/LibCore/SocketAddress.cpp
index 3321700b..77ead19d 100644
--- a/Libraries/LibCore/SocketAddress.cpp
+++ b/Libraries/LibCore/SocketAddress.cpp
@@ -107,7 +107,10 @@ sockaddr_in SocketAddress::to_sockaddr_in() const
     sockaddr_in address {};
     address.sin_family = AF_INET;
     address.sin_port = htons(port());
-    address.sin_addr.s_addr = ipv4_address().to_in_addr_t();
+    // Byte by byte: to_in_addr_t() is only in network order on little-endian hosts.
+    auto const ipv4 = ipv4_address();
+    u8 const octets[4] = { ipv4[0], ipv4[1], ipv4[2], ipv4[3] };
+    memcpy(&address.sin_addr.s_addr, octets, sizeof(octets));
     return address;
 }
 
diff --git a/Libraries/LibCore/TCPServer.cpp b/Libraries/LibCore/TCPServer.cpp
index cfedab32..8578f3ac 100644
--- a/Libraries/LibCore/TCPServer.cpp
+++ b/Libraries/LibCore/TCPServer.cpp
@@ -108,7 +108,7 @@ Optional<IPv4Address> TCPServer::local_address() const
     if (getsockname(m_fd, (sockaddr*)&address, &len) != 0)
         return {};
 
-    return IPv4Address(address.sin_addr.s_addr);
+    return IPv4Address(bit_cast<u8 const*>(&address.sin_addr.s_addr));
 }
 
 Optional<u16> TCPServer::local_port() const
diff --git a/Libraries/LibCore/UDPServer.cpp b/Libraries/LibCore/UDPServer.cpp
index d77ec459..4334100a 100644
--- a/Libraries/LibCore/UDPServer.cpp
+++ b/Libraries/LibCore/UDPServer.cpp
@@ -87,7 +87,7 @@ Optional<IPv4Address> UDPServer::local_address() const
     if (getsockname(m_fd, (sockaddr*)&address, &len) != 0)
         return {};
 
-    return IPv4Address(address.sin_addr.s_addr);
+    return IPv4Address(bit_cast<u8 const*>(&address.sin_addr.s_addr));
 }
 
 Optional<u16> UDPServer::local_port() const
