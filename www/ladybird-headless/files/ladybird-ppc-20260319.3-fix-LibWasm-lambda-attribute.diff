From 7db37fb9668fb3d5a85b229be835f4ef2607a094 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 27 Sep 2026 15:05:16 +0000
Subject: [PATCH] LibWasm: Put the attribute of the br_if slow path lambda
 where GCC takes it

"LibWasm: Add runtime checks to nostack br/br_if" wrote the out-of-line
branch as

    [](...) NEVER_INLINE static { ... }

NEVER_INLINE is a GNU attribute. Clang takes GNU attributes of a lambda
only before its specifiers, GCC only after them, so GCC stopped at
"static" and the file did not compile. The standard attribute syntax
does not help: [[gnu::noinline]] after the specifiers belongs to the
function type, and GCC accepts but ignores it before the parameter list,
which would inline the slow path into the handler it is meant to stay
out of.

Keep the order for Clang and put the attribute after "static" for GCC.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp b/Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp
index 13f967867..7b44a3f6f 100644
--- Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp
+++ Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp
@@ -1949,7 +1949,12 @@ HANDLE_INSTRUCTION(synthetic_br_if_nostack)
     auto current = configuration.value_stack().size();
     if (current != expected) [[unlikely]] {
         // This branch is definitely taken, but we have to tailcall a different function so we don't pollute this one with vector reallocation nonsense.
+#ifdef AK_COMPILER_CLANG
         return [](HANDLER_PARAMS(DECOMPOSE_PARAMS)) NEVER_INLINE static {
+#else
+        // GCC takes a GNU attribute of a lambda only after its specifiers.
+        return [](HANDLER_PARAMS(DECOMPOSE_PARAMS)) static NEVER_INLINE {
+#endif
             short_ip.current_ip_value = interpreter.branch_to_label<true>(configuration, instruction->arguments().unsafe_get<Instruction::BranchArgs>().label, short_ip.current_ip_value).value();
             TAILCALL return continue_(HANDLER_PARAMS(DECOMPOSE_PARAMS_NAME_ONLY));
         }(HANDLER_PARAMS(DECOMPOSE_PARAMS_NAME_ONLY));
