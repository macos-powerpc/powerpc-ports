From a4bd0b04804dcf86ebc67c4b891dc4bb30e79e3f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 26 Sep 2026 04:44:24 +0000
Subject: [PATCH 35/35] LibMedia: Keep the Matroska segment size 64-bit on
 32-bit hosts

The segment size is read as a u64 EBML variable-size integer but stored
in a size_t. On a 32-bit host the "unknown size" value that live and
MediaRecorder WebM files use (all data bits set) truncates to
0xFFFFFFFF, position + size then wraps below the current position, and
the scan for top-level elements stops at once, so those files fail to
load.

Store it as u64.
---
 Libraries/LibMedia/Containers/Matroska/Reader.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Libraries/LibMedia/Containers/Matroska/Reader.h b/Libraries/LibMedia/Containers/Matroska/Reader.h
index 54fbf4e8..85bb57c0 100644
--- a/Libraries/LibMedia/Containers/Matroska/Reader.h
+++ b/Libraries/LibMedia/Containers/Matroska/Reader.h
@@ -71,7 +71,8 @@ private:
     Optional<EBMLHeader> m_header;
 
     size_t m_segment_contents_position { 0 };
-    size_t m_segment_contents_size { 0 };
+    // NB: u64 even where size_t is 32-bit: an unknown-size segment reads as 2^56 - 1, and position + size must not wrap.
+    u64 m_segment_contents_size { 0 };
 
     HashMap<u32, size_t> m_seek_entries;
     size_t m_last_top_level_element_position { 0 };
