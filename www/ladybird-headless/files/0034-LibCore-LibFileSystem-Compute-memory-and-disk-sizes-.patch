From 4b1cbe332d6e4e410177eac0104e87f0a46dec51 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 26 Sep 2026 04:44:23 +0000
Subject: [PATCH 34/35] LibCore+LibFileSystem: Compute memory and disk sizes in
 64 bits

physical_memory_bytes() multiplied sysconf(_SC_PHYS_PAGES) by
PAGE_SIZE, and disk_space() multiplied statvfs block counts by
f_frsize, before widening the result to u64. On a 32-bit host these are
32-bit products: 2 GiB or more of RAM overflows navigator.deviceMemory's
input, and any disk with more than 4 GiB free or total reports a
wrapped size, which the HTTP disk cache uses to size itself.

Widen the first operand to u64. Nothing changes on 64-bit hosts.
---
 Libraries/LibCore/System.cpp           | 3 ++-
 Libraries/LibFileSystem/FileSystem.cpp | 5 +++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/Libraries/LibCore/System.cpp b/Libraries/LibCore/System.cpp
index 3ca58fda..5a80e2e0 100644
--- a/Libraries/LibCore/System.cpp
+++ b/Libraries/LibCore/System.cpp
@@ -712,7 +712,8 @@ unsigned hardware_concurrency()
 
 u64 physical_memory_bytes()
 {
-    return sysconf(_SC_PHYS_PAGES) * PAGE_SIZE;
+    // NB: sysconf() returns a long, which is 32-bit on 32-bit hosts; multiply in u64.
+    return static_cast<u64>(sysconf(_SC_PHYS_PAGES)) * PAGE_SIZE;
 }
 
 ErrorOr<ByteString> current_executable_path()
diff --git a/Libraries/LibFileSystem/FileSystem.cpp b/Libraries/LibFileSystem/FileSystem.cpp
index b3ca9dcd..ceefb170 100644
--- a/Libraries/LibFileSystem/FileSystem.cpp
+++ b/Libraries/LibFileSystem/FileSystem.cpp
@@ -387,8 +387,9 @@ ErrorOr<DiskSpace> compute_disk_space(LexicalPath const& path)
         return Error::from_syscall("statvfs"sv, errno);
 
     return DiskSpace {
-        .free_bytes = stats.f_bavail * stats.f_frsize,
-        .total_bytes = stats.f_blocks * stats.f_frsize,
+        // NB: fsblkcnt_t and f_frsize can both be 32-bit (e.g. on 32-bit macOS); multiply in u64.
+        .free_bytes = static_cast<u64>(stats.f_bavail) * stats.f_frsize,
+        .total_bytes = static_cast<u64>(stats.f_blocks) * stats.f_frsize,
     };
 #endif
 }
