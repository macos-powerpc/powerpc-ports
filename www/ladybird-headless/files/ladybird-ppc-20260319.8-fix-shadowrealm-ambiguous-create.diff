From d8f5670f70f903faa6efe25533d7a88c6c939cd4 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 13 Oct 2026 06:14:48 +0000
Subject: [PATCH] LibJS: Pick the capturing overload for ShadowRealm's import
 error thrower

c9b669320 (pick of 8a9d5ee1a) adds NativeFunction::create() overloads
that take a NativeFunctionPointer. A captureless lambda converts both to
that pointer and to AK::Function, so the call that makes the TypeError
thrower in shadow_realm_import_value() became ambiguous. Upstream had
removed ShadowRealm before that commit, so its fix never touched this
file. Wrap the lambda in Function<...> as the same commit does for
UniversalGlobalScope, which keeps the function object what it was
before the pick.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libraries/LibJS/Runtime/ShadowRealm.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Libraries/LibJS/Runtime/ShadowRealm.cpp b/Libraries/LibJS/Runtime/ShadowRealm.cpp
index dca4bcaa8..a121d29a0 100644
--- Libraries/LibJS/Runtime/ShadowRealm.cpp
+++ Libraries/LibJS/Runtime/ShadowRealm.cpp
@@ -296,9 +296,9 @@ ThrowCompletionOr<Value> shadow_realm_import_value(VM& vm, Utf16FlyString specif
 
     // NOTE: Even though the spec tells us to use %ThrowTypeError%, it's not observable if we actually do.
     // Throw a nicer TypeError forwarding the import error message instead (we know the argument is an Error object).
-    auto throw_type_error = NativeFunction::create(realm, {}, [](auto& vm) -> ThrowCompletionOr<Value> {
+    auto throw_type_error = NativeFunction::create(realm, {}, Function<ThrowCompletionOr<Value>(VM&)> { [](auto& vm) -> ThrowCompletionOr<Value> {
         return vm.template throw_completion<TypeError>(vm.argument(0).as_object().get_without_side_effects(vm.names.message).as_string().utf8_string());
-    });
+    } });
 
     // 13. Return PerformPromiseThen(innerCapability.[[Promise]], onFulfilled, callerRealm.[[Intrinsics]].[[%ThrowTypeError%]], promiseCapability).
     return as<Promise>(inner_capability->promise().ptr())->perform_then(on_fulfilled, throw_type_error, promise_capability);
