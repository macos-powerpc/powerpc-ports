From 55f30e37778c32b84a9aea6a281138b327ce5dd0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 13 Oct 2026 09:06:38 +0000
Subject: [PATCH] LibWeb: Pass the realm to the MediaSource duration truncation
 error

acc6293ad (pick of 590403e6c) throws InvalidStateError with the
realm-less create() that upstream added in 4be9c6d3c (wrapper
architecture). We did not pick that commit, so our DOMException
factories still take the realm first, as every other call in this file does.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libraries/LibWeb/MediaSourceExtensions/MediaSource.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Libraries/LibWeb/MediaSourceExtensions/MediaSource.cpp b/Libraries/LibWeb/MediaSourceExtensions/MediaSource.cpp
index feb83c5ca..4c7584055 100644
--- Libraries/LibWeb/MediaSourceExtensions/MediaSource.cpp
+++ Libraries/LibWeb/MediaSourceExtensions/MediaSource.cpp
@@ -384,7 +384,7 @@ WebIDL::ExceptionOr<void> MediaSource::run_duration_change_algorithm(double new_
     // NOTE: Duration reductions that would truncate currently buffered media are disallowed. When truncation is
     //       necessary, use remove() to reduce the buffered range before updating duration.
     if (new_duration < highest_presentation_timestamp.to_seconds_f64())
-        return WebIDL::InvalidStateError::create("Duration would truncate buffered coded frames"_utf16);
+        return WebIDL::InvalidStateError::create(realm(), "Duration would truncate buffered coded frames"_utf16);
 
     // 3. Let highest end time be the largest track buffer ranges end time across all the track buffers across all
     //    SourceBuffer objects in sourceBuffers.
