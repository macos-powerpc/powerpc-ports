From 9d7a690875ba62f197cd132ab7c79d925f379ed5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 24 Sep 2026 22:16:24 +0000
Subject: [PATCH 16/21] AK: Look up ak_assertion_handler with dlsym() on legacy
 macOS

AK declares ak_assertion_handler weak and links with
-U _ak_assertion_handler so that a test executable can provide it. The
dyld of Mac OS X 10.5 and 10.6 does not treat that reference as weak and
refuses to load liblagom-ak when nothing defines the symbol:

  dyld: Symbol not found: _ak_assertion_handler
    Expected in: dynamic lookup

With LADYBIRD_LEGACY_MACOS, find the handler with
dlsym(RTLD_DEFAULT, ...) when an assertion fails, as the Windows code
does with GetProcAddress(), and drop the -U link option.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 AK/Assertions.cpp | 10 ++++++++--
 AK/CMakeLists.txt |  2 +-
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/AK/Assertions.cpp b/AK/Assertions.cpp
index b4ddb26a..43d820db 100644
--- a/AK/Assertions.cpp
+++ b/AK/Assertions.cpp
@@ -136,14 +136,20 @@ NEVER_INLINE void ak_trap(void)
     __builtin_trap();
 }
 
-#ifndef AK_OS_WINDOWS
+#if defined(AK_OS_MACOS) && defined(LADYBIRD_LEGACY_MACOS)
+// The dyld of Mac OS X 10.5 and 10.6 refuses to load an image whose weak, dynamically looked up
+// ak_assertion_handler is missing, so look the handler up at run time instead.
+#    include <dlfcn.h>
+#elif !defined(AK_OS_WINDOWS)
 [[gnu::weak]] void ak_assertion_handler(char const* message);
 #endif
 
 using AssertionHandlerFunc = void (*)(char const*);
 static AssertionHandlerFunc get_custom_assertion_handler()
 {
-#ifndef AK_OS_WINDOWS
+#if defined(AK_OS_MACOS) && defined(LADYBIRD_LEGACY_MACOS)
+    return reinterpret_cast<AssertionHandlerFunc>(dlsym(RTLD_DEFAULT, "ak_assertion_handler"));
+#elif !defined(AK_OS_WINDOWS)
     return ak_assertion_handler;
 #else
     // Windows doesn't support weak symbols as nicely as ELF platforms.
diff --git a/AK/CMakeLists.txt b/AK/CMakeLists.txt
index b0dbd0b4..75bbac3a 100644
--- a/AK/CMakeLists.txt
+++ b/AK/CMakeLists.txt
@@ -100,7 +100,7 @@ if (WIN32)
     if (ENABLE_ADDRESS_SANITIZER)
         target_compile_options(AK PRIVATE -fno-sanitize=address)
     endif()
-elseif (APPLE)
+elseif (APPLE AND NOT LADYBIRD_LEGACY_MACOS)
     set(ASSERTION_HANDLER_VISIBILITY PRIVATE)
     if (NOT BUILD_SHARED_LIBS)
         set(ASSERTION_HANDLER_VISIBILITY INTERFACE)
