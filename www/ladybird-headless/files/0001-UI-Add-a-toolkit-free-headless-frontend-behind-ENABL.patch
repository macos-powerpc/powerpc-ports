 Libraries/LibWebView/CMakeLists.txt |  2 +-
 Libraries/LibWebView/Utilities.cpp  | 12 ++++++---
 Meta/CMake/lagom_options.cmake      |  4 +++
 UI/CMakeLists.txt                   |  7 +++--
 UI/Headless/CMakeLists.txt          | 12 +++++++++
 UI/Headless/main.cpp                | 40 +++++++++++++++++++++++++++++
 UI/cmake/InstallRules.cmake         |  8 +++---
 UI/cmake/ResourceFiles.cmake        |  5 +++-
 8 files changed, 79 insertions(+), 11 deletions(-)
 create mode 100644 UI/Headless/CMakeLists.txt
 create mode 100644 UI/Headless/main.cpp

diff --git a/Libraries/LibWebView/CMakeLists.txt b/Libraries/LibWebView/CMakeLists.txt
index c82af9b1..a0a12afb 100644
--- a/Libraries/LibWebView/CMakeLists.txt
+++ b/Libraries/LibWebView/CMakeLists.txt
@@ -50,7 +50,7 @@ embed_as_string(
 compile_ipc(UIProcessServer.ipc UIProcessServerEndpoint.h)
 compile_ipc(UIProcessClient.ipc UIProcessClientEndpoint.h)
 
-if (NOT APPLE AND NOT CMAKE_INSTALL_LIBEXECDIR STREQUAL "libexec")
+if (NOT CMAKE_INSTALL_LIBEXECDIR STREQUAL "libexec")
     set_source_files_properties(Utilities.cpp PROPERTIES COMPILE_DEFINITIONS LADYBIRD_LIBEXECDIR="${CMAKE_INSTALL_LIBEXECDIR}")
 endif()
 
diff --git a/Libraries/LibWebView/Utilities.cpp b/Libraries/LibWebView/Utilities.cpp
index ce20bcbb..75efe5af 100644
--- a/Libraries/LibWebView/Utilities.cpp
+++ b/Libraries/LibWebView/Utilities.cpp
@@ -80,10 +80,12 @@ void platform_init(Optional<ByteString> ladybird_binary_path)
         }
         auto app_dir = MUST(application_directory());
 #ifdef AK_OS_MACOS
-        return LexicalPath(app_dir).parent().append("Resources"sv).string();
-#else
-        return find_prefix(LexicalPath(app_dir)).append("share/Lagom"sv).string();
+        // Inside an application bundle the resources sit next to the executable directory. A plain
+        // (non-bundle) install, e.g. from a package manager, is laid out like any other Unix.
+        if (LexicalPath(app_dir).basename() == "MacOS"sv)
+            return LexicalPath(app_dir).parent().append("Resources"sv).string();
 #endif
+        return find_prefix(LexicalPath(app_dir)).append("share/Lagom"sv).string();
     }();
 
     Core::ResourceImplementation::install(make<Core::ResourceImplementationFile>(MUST(String::from_byte_string(s_ladybird_resource_root))));
@@ -112,7 +114,9 @@ ErrorOr<Vector<ByteString>> get_paths_for_helper_process(StringView process_name
     auto application_path = TRY(application_directory());
     Vector<ByteString> paths;
 
-#if !defined(AK_OS_MACOS) && !defined(AK_OS_WINDOWS)
+#if !defined(AK_OS_WINDOWS)
+    // Unix-style installs keep the helpers in libexec (or bin); a macOS bundle has them next to the
+    // browser binary and is covered by the application-directory entry below.
     auto prefix = find_prefix(LexicalPath(application_path));
     TRY(paths.try_append(LexicalPath::join(prefix.string(), libexec_path, process_name).string()));
     TRY(paths.try_append(LexicalPath::join(prefix.string(), "bin"sv, process_name).string()));
diff --git a/Meta/CMake/lagom_options.cmake b/Meta/CMake/lagom_options.cmake
index cd4a0e15..df366415 100644
--- a/Meta/CMake/lagom_options.cmake
+++ b/Meta/CMake/lagom_options.cmake
@@ -30,3 +30,7 @@ if (ANDROID OR APPLE)
 else()
     ladybird_option(ENABLE_QT ON CACHE BOOL "Build ladybird application using Qt GUI")
 endif()
+
+# Takes precedence over ENABLE_QT and the native frontends: a toolkit-free ladybird binary that only
+# offers the headless modes and WebDriver. Useful where no supported GUI toolkit is available.
+ladybird_option(ENABLE_HEADLESS_UI OFF CACHE BOOL "Build the toolkit-free ladybird frontend (headless modes and WebDriver only)")
