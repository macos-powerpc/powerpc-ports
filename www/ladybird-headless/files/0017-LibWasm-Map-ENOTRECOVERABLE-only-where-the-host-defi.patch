From e369f0bd5e04bfe507557b94f1b01301206157d0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 25 Sep 2026 05:09:49 +0000
Subject: [PATCH 17/21] LibWasm: Map ENOTRECOVERABLE only where the host
 defines it

Mac OS X before 10.7 has no ENOTRECOVERABLE (or EOWNERDEAD) in
<errno.h>. A host that does not define the code can never report it, so
leave the case out there, as is already done for ESUCCESS.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libraries/LibWasm/WASI/Wasi.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Libraries/LibWasm/WASI/Wasi.cpp b/Libraries/LibWasm/WASI/Wasi.cpp
index 2ce479f0..8e17fd57 100644
--- a/Libraries/LibWasm/WASI/Wasi.cpp
+++ b/Libraries/LibWasm/WASI/Wasi.cpp
@@ -1141,8 +1141,10 @@ Errno errno_value_from_errno(int value)
         return Errno::NotDirectory;
     case ENOTEMPTY:
         return Errno::NotEmpty;
+#ifdef ENOTRECOVERABLE
     case ENOTRECOVERABLE:
         return Errno::NotRecoverable;
+#endif
     case ENOTSOCK:
         return Errno::NotSocket;
     case ENOTSUP:
