From f4c6792ddfc96c2f14ab2d8a5f5efe6b2f64dbd7 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 25 Sep 2026 22:09:38 +0000
Subject: [PATCH] LibGC: Free heap blocks with MADV_FREE on legacy macOS

Until 10.9, madvise(MADV_FREE_REUSABLE) and madvise(MADV_FREE_REUSE)
only succeed on regions whose maximum protection is VM_PROT_ALL
(vm_map_entry_is_reusable() in xnu-1456 to xnu-2050). The GC maps its
blocks with mach_vm_map() and a read/write maximum, so on 10.6 the first
block the GC frees fails with ENOMEM and the VERIFY aborts the process.

Under LADYBIRD_LEGACY_MACOS, discard freed blocks with MADV_FREE like the
other BSDs do, and skip MADV_FREE_REUSE when a block is taken from the
cache again. 10.5 already took that path: its SDK has no
MADV_FREE_REUSABLE.
---
 Libraries/LibGC/BlockAllocator.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/Libraries/LibGC/BlockAllocator.cpp b/Libraries/LibGC/BlockAllocator.cpp
index d20769c6..b9c618e8 100644
--- a/Libraries/LibGC/BlockAllocator.cpp
+++ b/Libraries/LibGC/BlockAllocator.cpp
@@ -28,6 +28,13 @@
 #    include <memoryapi.h>
 #endif
 
+// Kernels before 10.9 only apply MADV_FREE_REUSABLE and MADV_FREE_REUSE to regions whose maximum
+// protection is VM_PROT_ALL (vm_map_entry_is_reusable()); the blocks are mapped read/write only, so
+// both fail with ENOMEM there. Legacy macOS discards the pages with MADV_FREE instead.
+#if defined(MADV_FREE_REUSE) && defined(MADV_FREE_REUSABLE) && !defined(LADYBIRD_LEGACY_MACOS)
+#    define GC_USE_MADV_FREE_REUSABLE
+#endif
+
 namespace GC {
 
 BlockAllocator::~BlockAllocator()
@@ -56,7 +63,7 @@ void* BlockAllocator::allocate_block([[maybe_unused]] char const* name)
         auto* block = m_blocks.unstable_take(random_index);
         ASAN_UNPOISON_MEMORY_REGION(block, HeapBlock::BLOCK_SIZE);
         LSAN_REGISTER_ROOT_REGION(block, HeapBlock::BLOCK_SIZE);
-#if defined(MADV_FREE_REUSE) && defined(MADV_FREE_REUSABLE)
+#ifdef GC_USE_MADV_FREE_REUSABLE
         if (madvise(block, HeapBlock::BLOCK_SIZE, MADV_FREE_REUSE) < 0) {
             perror("madvise(MADV_FREE_REUSE)");
             VERIFY_NOT_REACHED();
@@ -103,7 +110,7 @@ void BlockAllocator::deallocate_block(void* block)
         warnln("{}", Error::from_windows_error(ret));
         VERIFY_NOT_REACHED();
     }
-#elif defined(MADV_FREE_REUSE) && defined(MADV_FREE_REUSABLE)
+#elif defined(GC_USE_MADV_FREE_REUSABLE)
     if (madvise(block, HeapBlock::BLOCK_SIZE, MADV_FREE_REUSABLE) < 0) {
         perror("madvise(MADV_FREE_REUSABLE)");
         VERIFY_NOT_REACHED();
