From 635be9e588480e70b3c107f2060fba6f1ff69c21 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 25 Sep 2026 21:16:53 +0000
Subject: [PATCH] WebDriver: Install the WebDriver binary

Nothing installed WebDriver, so an installed Ladybird could not be driven
without a build tree. Install it into the binary directory: WebDriver
looks for the browser as prefix/libexec/Ladybird, prefix/bin/Ladybird or
next to itself, and all of those resolve from there.
---
 Services/WebDriver/CMakeLists.txt | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Services/WebDriver/CMakeLists.txt b/Services/WebDriver/CMakeLists.txt
index 8aa8709c..cfbb2f73 100644
--- a/Services/WebDriver/CMakeLists.txt
+++ b/Services/WebDriver/CMakeLists.txt
@@ -18,3 +18,10 @@ target_link_libraries(WebDriver PRIVATE OpenSSL::Crypto OpenSSL::SSL)
 if (WIN32)
     lagom_windows_bin(WebDriver)
 endif()
+
+# Next to the browser, which WebDriver then finds as prefix/bin/Ladybird.
+install(TARGETS WebDriver
+    RUNTIME
+        COMPONENT ladybird_Runtime
+        DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
