From cc7f031937b39c2767785f2778146f9f04998826 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 13 Oct 2026 08:08:22 +0000
Subject: [PATCH] LibWeb: Use our blob object tag for a media element's blob URL

c4d0b3274 (pick of d960c1eaf) calls obtain_a_blob_object() with
FileAPI::TopLevelSelfFetch. Upstream added that name in 978ca691c,
which renamed NavigationEnvironment to TopLevelNavigation and
TopLevelSelfFetch; we did not pick it, so the name does not exist here.
Our NavigationEnvironment skips the same-partition check exactly as
TopLevelSelfFetch does upstream, so the media element passes that instead.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libraries/LibWeb/HTML/HTMLMediaElement.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/Libraries/LibWeb/HTML/HTMLMediaElement.cpp b/Libraries/LibWeb/HTML/HTMLMediaElement.cpp
index 89d65493c..c568bf1fb 100644
--- Libraries/LibWeb/HTML/HTMLMediaElement.cpp
+++ Libraries/LibWeb/HTML/HTMLMediaElement.cpp
@@ -1196,9 +1196,11 @@ void HTMLMediaElement::load_url_resource(URL::URL const& url_record, Function<vo
         }
 
         // 5. Let stringOrEnvironment be "top-level-self-fetch" if isTopLevelSelfFetch is true; otherwise settingsObject.
-        auto string_or_environment = [&] -> Variant<GC::Ref<HTML::Environment>, FileAPI::TopLevelSelfFetch> {
+        // NB: Our FileAPI predates the top-level-self-fetch string; its NavigationEnvironment skips the same-partition
+        //     check the same way.
+        auto string_or_environment = [&] -> Variant<GC::Ref<HTML::Environment>, FileAPI::NavigationEnvironment> {
             if (is_top_level_self_fetch)
-                return FileAPI::TopLevelSelfFetch();
+                return FileAPI::NavigationEnvironment {};
             return { settings_object };
         }();
 
