From 0b5537addcb44a81fcba6fd7c10058dc675137fd Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 24 Sep 2026 19:02:55 +0000
Subject: [PATCH 07/21] LibGfx: Make APNG support optional instead of requiring
 a patched libpng

Most distributions ship libpng without the APNG patch. Instead of
failing at configure time, warn and decode animated PNGs as single
frames when PNG_APNG_SUPPORTED is not defined.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 Libraries/LibGfx/CMakeLists.txt             | 3 ++-
 Libraries/LibGfx/ImageFormats/PNGLoader.cpp | 7 ++++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/Libraries/LibGfx/CMakeLists.txt b/Libraries/LibGfx/CMakeLists.txt
index 3c1ee826..9b63df4c 100644
--- a/Libraries/LibGfx/CMakeLists.txt
+++ b/Libraries/LibGfx/CMakeLists.txt
@@ -130,7 +130,8 @@ check_c_source_compiles([=[
 unset(CMAKE_REQUIRED_LIBRARIES)
 
 if (NOT LIBPNG_HAS_APNG)
-    message(FATAL_ERROR "libpng does not support APNG, which is required by LibGfx.")
+    # Distributions rarely carry the APNG patch; the loader then decodes animated PNGs as single frames.
+    message(WARNING "libpng was built without APNG support; animated PNGs will show their first frame only")
 endif()
 
 if (NOT ANDROID)
diff --git a/Libraries/LibGfx/ImageFormats/PNGLoader.cpp b/Libraries/LibGfx/ImageFormats/PNGLoader.cpp
index bf46017f..050465d9 100644
--- a/Libraries/LibGfx/ImageFormats/PNGLoader.cpp
+++ b/Libraries/LibGfx/ImageFormats/PNGLoader.cpp
@@ -267,6 +267,7 @@ ErrorOr<size_t> PNGLoadingContext::read_frames(png_structp png_ptr, png_infop in
         return frame_bitmap;
     };
 
+#ifdef PNG_APNG_SUPPORTED
     if (png_get_acTL(png_ptr, info_ptr, &frame_count, &loop_count)) {
         // acTL chunk present: This is an APNG.
         png_set_acTL(png_ptr, info_ptr, frame_count, loop_count);
@@ -356,7 +357,11 @@ ErrorOr<size_t> PNGLoadingContext::read_frames(png_structp png_ptr, png_infop in
             frame_descriptors.append({ move(frame_bitmap), 0 });
             frame_count = 1;
         }
-    } else {
+    } else
+#else
+    // A libpng without the APNG patch decodes every file as a single frame.
+#endif
+    {
         // This is a single-frame PNG.
         frame_count = 1;
         loop_count = 0;
