From 7341e35d199aba7d465010a75a99c65290794e6a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 25 Sep 2026 05:12:34 +0000
Subject: [PATCH 18/21] Meta: Make the installed Lagom package usable by a
 separately built frontend

With ENABLE_INSTALL_HEADERS the build installs the library headers and a
Lagom CMake package, but a frontend built against that package (rather
than in-tree) could not compile, and could silently disagree with the
libraries about what the headers mean:

- The flags and definitions that change what the headers mean are applied
  directory-wide, so consumers of the package never saw them:
  -fsigned-char (char is unsigned by default on PowerPC and ARM),
  -ffp-contract=off, -fstrict-flex-arrays=2, C++23, LADYBIRD_LEGACY_MACOS
  (selects the Metal/IOSurface members in AK/Platform.h), USE_VULKAN,
  USE_VULKAN_IMAGES and _FILE_OFFSET_BITS=64, plus libatomic where 64-bit
  atomics are not native. Carry them in AK's install interface and make
  every library's install interface include AK. The build tree is
  unaffected.
- The generated Export.h headers were not installed.
- IPC endpoints were installed by source directory and file name only, so
  the RequestServer and WebContent endpoints landed in include/Meta/Lagom,
  and the ImageDecoder and LibWeb worker endpoints lost their directories.
  Install each one where it sits in the Lagom build tree, which mirrors
  the include roots the package exports. Drop LibWebView's own copy of the
  endpoint install, which also dropped two headers at the include root.
- The RequestServer endpoints include Services/RequestServer/CacheLevel.h.
- LagomConfig.cmake did not find Threads and OpenSSL, whose imported
  targets appear in the exported link interfaces.
- LibGfx installed its generated TIFF .cpp next to the header.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libraries/LibGfx/CMakeLists.txt       |  3 +--
 Libraries/LibWebView/CMakeLists.txt   | 14 ------------
 Meta/CMake/code_generators.cmake      |  8 +++++--
 Meta/CMake/lagom-install-config.cmake |  5 +++++
 Meta/CMake/targets.cmake              |  5 +++++
 Meta/Lagom/CMakeLists.txt             | 32 +++++++++++++++++++++++++++
 6 files changed, 49 insertions(+), 18 deletions(-)

diff --git a/Libraries/LibGfx/CMakeLists.txt b/Libraries/LibGfx/CMakeLists.txt
index 9b63df4c..8db872d3 100644
--- a/Libraries/LibGfx/CMakeLists.txt
+++ b/Libraries/LibGfx/CMakeLists.txt
@@ -98,8 +98,7 @@ list(FILTER generated_headers INCLUDE REGEX "\\.h$")
 list(TRANSFORM generated_headers PREPEND "${CMAKE_CURRENT_BINARY_DIR}/")
 
 if (ENABLE_INSTALL_HEADERS)
-    list(TRANSFORM generated_sources PREPEND "${CMAKE_CURRENT_BINARY_DIR}/")
-    install(FILES ${generated_sources} DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/LibGfx/ImageFormats")
+    install(FILES ${generated_headers} DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/LibGfx/ImageFormats")
 endif()
 
 # Third-party
diff --git a/Libraries/LibWebView/CMakeLists.txt b/Libraries/LibWebView/CMakeLists.txt
index a0a12afb..020ff21b 100644
--- a/Libraries/LibWebView/CMakeLists.txt
+++ b/Libraries/LibWebView/CMakeLists.txt
@@ -80,17 +80,3 @@ endif()
 if (HAS_FONTCONFIG)
     target_link_libraries(LibWebView PRIVATE Fontconfig::Fontconfig)
 endif()
-
-if (ENABLE_INSTALL_HEADERS)
-    foreach(header ${GENERATED_SOURCES})
-        get_filename_component(extension ${header} EXT)
-        if (NOT "${extension}" STREQUAL ".h")
-            continue()
-        endif()
-
-        get_filename_component(subdirectory ${header} DIRECTORY)
-        string(REGEX REPLACE "^\\.\\./\\.\\./" "" subdirectory "${subdirectory}")
-
-        install(FILES "${CMAKE_CURRENT_BINARY_DIR}/${header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/${subdirectory}")
-    endforeach()
-endif()
diff --git a/Meta/CMake/code_generators.cmake b/Meta/CMake/code_generators.cmake
index 9418e59c..dd9a16bf 100644
--- a/Meta/CMake/code_generators.cmake
+++ b/Meta/CMake/code_generators.cmake
@@ -40,8 +40,12 @@ function(compile_ipc source output)
     add_custom_target(generate_${output_name} DEPENDS ${output})
     add_dependencies(ladybird_codegen_accumulator generate_${output_name})
 
-    cmake_path(RELATIVE_PATH CMAKE_CURRENT_SOURCE_DIR BASE_DIRECTORY ${SerenityOS_SOURCE_DIR} OUTPUT_VARIABLE current_source_dir_relative)
+    # Install the endpoint where it sits relative to the Lagom build directory, which mirrors the
+    # include roots (., Services, Libraries) that consumers of the installed package get.
+    cmake_path(ABSOLUTE_PATH output BASE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR} NORMALIZE OUTPUT_VARIABLE output_path)
+    cmake_path(RELATIVE_PATH output_path BASE_DIRECTORY ${Lagom_BINARY_DIR} OUTPUT_VARIABLE output_relative_path)
+    cmake_path(GET output_relative_path PARENT_PATH output_relative_dir)
     if (ENABLE_INSTALL_HEADERS)
-        install(FILES ${CMAKE_CURRENT_BINARY_DIR}/${output} DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/${current_source_dir_relative}" OPTIONAL)
+        install(FILES ${output_path} DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/${output_relative_dir}" OPTIONAL)
     endif()
 endfunction()
diff --git a/Meta/CMake/lagom-install-config.cmake b/Meta/CMake/lagom-install-config.cmake
index 2805685e..946b6700 100644
--- a/Meta/CMake/lagom-install-config.cmake
+++ b/Meta/CMake/lagom-install-config.cmake
@@ -1 +1,6 @@
+include(CMakeFindDependencyMacro)
+# Imported targets named in the exported link interfaces (LibMain links threads, LibCrypto and LibTLS
+# link OpenSSL publicly).
+find_dependency(Threads)
+find_dependency(OpenSSL)
 include("${CMAKE_CURRENT_LIST_DIR}/LagomTargets.cmake")
diff --git a/Meta/CMake/targets.cmake b/Meta/CMake/targets.cmake
index 0f7e26d5..d4711e63 100644
--- a/Meta/CMake/targets.cmake
+++ b/Meta/CMake/targets.cmake
@@ -16,6 +16,9 @@ function(lagom_generate_export_header name fs_name)
     include(GenerateExportHeader)
     string(TOUPPER ${fs_name} fs_name_upper)
     generate_export_header(${name} EXPORT_MACRO_NAME ${fs_name_upper}_API EXPORT_FILE_NAME "Export.h")
+    if (ENABLE_INSTALL_HEADERS)
+        install(FILES "${CMAKE_CURRENT_BINARY_DIR}/Export.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/${name}")
+    endif()
 endfunction()
 
 function(lagom_copy_runtime_dlls target_name)
@@ -72,6 +75,8 @@ function(lagom_lib target_name fs_name)
 
     if (NOT "${target_name}" STREQUAL "AK")
         target_link_libraries(${target_name} PRIVATE AK)
+        # Every installed header builds on AK's, so consumers of the package get its usage requirements.
+        target_link_libraries(${target_name} INTERFACE $<INSTALL_INTERFACE:AK>)
     endif()
 
     if (WIN32)
diff --git a/Meta/Lagom/CMakeLists.txt b/Meta/Lagom/CMakeLists.txt
index cd771776..91d5bca6 100644
--- a/Meta/Lagom/CMakeLists.txt
+++ b/Meta/Lagom/CMakeLists.txt
@@ -219,9 +219,41 @@ compile_ipc(${LADYBIRD_PROJECT_ROOT}/Services/WebContent/WebDriverClient.ipc Ser
 compile_ipc(${LADYBIRD_PROJECT_ROOT}/Services/WebContent/WebDriverServer.ipc Services/WebContent/WebDriverServerEndpoint.h)
 compile_ipc(${LADYBIRD_PROJECT_ROOT}/Services/WebContent/WebUIClient.ipc Services/WebContent/WebUIClientEndpoint.h)
 compile_ipc(${LADYBIRD_PROJECT_ROOT}/Services/WebContent/WebUIServer.ipc Services/WebContent/WebUIServerEndpoint.h)
+if (ENABLE_INSTALL_HEADERS)
+    # The generated RequestServer endpoints include this service header.
+    install(FILES "${LADYBIRD_PROJECT_ROOT}/Services/RequestServer/CacheLevel.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/Services/RequestServer")
+endif()
 
 add_ladybird_subdirectory(Libraries)
 
+# The installed headers mean something else without the flags and definitions the libraries were
+# built with, which the build applies directory-wide. Hand them to consumers of the installed package
+# (e.g. a separately built frontend) through AK, which every Lagom library links in its interface.
+# The build tree itself is unaffected.
+target_compile_features(AK INTERFACE $<INSTALL_INTERFACE:cxx_std_23>)
+if (NOT MSVC)
+    target_compile_options(AK INTERFACE
+        $<INSTALL_INTERFACE:-fsigned-char>
+        $<INSTALL_INTERFACE:-ffp-contract=off>
+        $<INSTALL_INTERFACE:-fstrict-flex-arrays=2>
+    )
+endif()
+if (APPLE AND LADYBIRD_LEGACY_MACOS)
+    target_compile_definitions(AK INTERFACE $<INSTALL_INTERFACE:LADYBIRD_LEGACY_MACOS=1>)
+endif()
+if (HAS_VULKAN)
+    target_compile_definitions(AK INTERFACE $<INSTALL_INTERFACE:USE_VULKAN=1>)
+endif()
+if (USE_VULKAN_IMAGES)
+    target_compile_definitions(AK INTERFACE $<INSTALL_INTERFACE:USE_VULKAN_IMAGES=1>)
+endif()
+if (LINUX)
+    target_compile_definitions(AK INTERFACE $<INSTALL_INTERFACE:_FILE_OFFSET_BITS=64>)
+endif()
+if (DEFINED LAGOM_HAS_NATIVE_64BIT_ATOMICS AND NOT LAGOM_HAS_NATIVE_64BIT_ATOMICS)
+    target_link_libraries(AK INTERFACE $<INSTALL_INTERFACE:atomic>)
+endif()
+
 if (ENABLE_FUZZERS)
     add_subdirectory(Fuzzers)
 endif()
