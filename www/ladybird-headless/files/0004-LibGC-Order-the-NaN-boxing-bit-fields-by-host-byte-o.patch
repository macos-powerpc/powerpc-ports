From 346790823dc20cc11c647ec85a8929474a7a9e0d Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 24 Sep 2026 18:35:26 +0000
Subject: [PATCH 04/21] LibGC: Order the NaN-boxing bit-fields by host byte
 order

GCC allocates bit-fields from the most significant bit on big-endian
targets, so the `payload : 48` / `tag : 16` pair has to be declared in
the opposite order there to keep the tag in the top 16 bits of the
encoded value, matching the shift-based tag extraction.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 Libraries/LibGC/NanBoxedValue.h | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Libraries/LibGC/NanBoxedValue.h b/Libraries/LibGC/NanBoxedValue.h
index 261364d4..b556aa44 100644
--- a/Libraries/LibGC/NanBoxedValue.h
+++ b/Libraries/LibGC/NanBoxedValue.h
@@ -108,8 +108,15 @@ protected:
     union {
         double as_double;
         struct {
+            // Bit-fields are allocated from the most significant bit on big-endian targets, so the
+            // declaration order has to follow the byte order to keep `tag` in the top 16 bits.
+#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+            u64 tag : 16;
+            u64 payload : 48;
+#else
             u64 payload : 48;
             u64 tag : 16;
+#endif
         };
         u64 encoded;
     } m_value { .encoded = 0 };
