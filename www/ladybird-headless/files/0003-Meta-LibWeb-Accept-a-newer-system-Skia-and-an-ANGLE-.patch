From 57c12240a046c399442ca9dbb6c3ecfe792124e0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 24 Sep 2026 18:35:26 +0000
Subject: [PATCH 03/21] Meta+LibWeb: Accept a newer system Skia and an ANGLE
 without angle.pc

The pkg-config lookup demanded exactly the Skia milestone pinned in
vcpkg.json; accept that version or newer, since distributions ship
later milestones. For ANGLE, fall back to locating the EGL and GLESv2
libraries and headers directly when no angle.pc is installed.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 Libraries/LibCrypto/CMakeLists.txt |  9 +++++++--
 Libraries/LibWeb/CMakeLists.txt    | 21 +++++++++++++++++++--
 Meta/CMake/skia.cmake              |  2 +-
 3 files changed, 27 insertions(+), 5 deletions(-)

diff --git a/Libraries/LibCrypto/CMakeLists.txt b/Libraries/LibCrypto/CMakeLists.txt
index 9202fe3f..c0cfddd7 100644
--- a/Libraries/LibCrypto/CMakeLists.txt
+++ b/Libraries/LibCrypto/CMakeLists.txt
@@ -31,9 +31,14 @@ set(SOURCES
 
 ladybird_lib(LibCrypto crypto)
 
+# pkg-config only supplies hints: some packaged libtommath.pc files carry unexpanded paths, which
+# an imported pkg-config target would reject at generate time.
 find_package(PkgConfig REQUIRED)
-pkg_check_modules(libtommath REQUIRED IMPORTED_TARGET libtommath)
-target_link_libraries(LibCrypto PRIVATE PkgConfig::libtommath)
+pkg_check_modules(libtommath QUIET libtommath)
+find_path(LIBTOMMATH_INCLUDE_DIR NAMES tommath.h HINTS ${libtommath_INCLUDE_DIRS} ${libtommath_INCLUDEDIR} PATH_SUFFIXES libtommath REQUIRED)
+find_library(LIBTOMMATH_LIBRARY NAMES tommath HINTS ${libtommath_LIBRARY_DIRS} ${libtommath_LIBDIR} REQUIRED)
+target_include_directories(LibCrypto SYSTEM PRIVATE "${LIBTOMMATH_INCLUDE_DIR}")
+target_link_libraries(LibCrypto PRIVATE "${LIBTOMMATH_LIBRARY}")
 
 find_package(OpenSSL REQUIRED)
 target_link_libraries(LibCrypto PUBLIC OpenSSL::Crypto)
diff --git a/Libraries/LibWeb/CMakeLists.txt b/Libraries/LibWeb/CMakeLists.txt
index 8a352a12..50c34a1b 100644
--- a/Libraries/LibWeb/CMakeLists.txt
+++ b/Libraries/LibWeb/CMakeLists.txt
@@ -8,8 +8,25 @@ if(unofficial-angle_FOUND)
     set(ANGLE_TARGETS unofficial::angle::libEGL unofficial::angle::libGLESv2)
 else()
     find_package(PkgConfig)
-    pkg_check_modules(angle REQUIRED IMPORTED_TARGET angle)
-    set(ANGLE_TARGETS PkgConfig::angle)
+    # Distributions name the pkg-config files differently: some ship angle.pc, others (e.g. the
+    # upstream GN build's install target) egl.pc and glesv2.pc; failing both, use the libraries directly.
+    pkg_check_modules(angle IMPORTED_TARGET angle)
+    if (angle_FOUND)
+        set(ANGLE_TARGETS PkgConfig::angle)
+    else()
+        pkg_check_modules(angle_egl_glesv2 IMPORTED_TARGET egl glesv2)
+        if (angle_egl_glesv2_FOUND)
+            set(ANGLE_TARGETS PkgConfig::angle_egl_glesv2)
+        else()
+            find_path(ANGLE_INCLUDE_DIR NAMES EGL/egl.h REQUIRED)
+            find_library(ANGLE_EGL_LIBRARY NAMES EGL libEGL REQUIRED)
+            find_library(ANGLE_GLESV2_LIBRARY NAMES GLESv2 libGLESv2 REQUIRED)
+            add_library(ladybird_angle INTERFACE)
+            target_include_directories(ladybird_angle SYSTEM INTERFACE "${ANGLE_INCLUDE_DIR}")
+            target_link_libraries(ladybird_angle INTERFACE "${ANGLE_EGL_LIBRARY}" "${ANGLE_GLESV2_LIBRARY}")
+            set(ANGLE_TARGETS ladybird_angle)
+        endif()
+    endif()
 endif()
 
 set(SOURCES
diff --git a/Meta/CMake/skia.cmake b/Meta/CMake/skia.cmake
index 4958793c..92454e82 100644
--- a/Meta/CMake/skia.cmake
+++ b/Meta/CMake/skia.cmake
@@ -36,7 +36,7 @@ else()
       endif()
     endforeach()
 
-    pkg_check_modules(skia skia=${SKIA_REQUIRED_VERSION} REQUIRED IMPORTED_TARGET skia)
+    pkg_check_modules(skia skia>=${SKIA_REQUIRED_VERSION} REQUIRED IMPORTED_TARGET skia)
     set(SKIA_TARGET PkgConfig::skia)
     set_property(TARGET PkgConfig::skia APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS "SKCMS_DLL")
 endif()
