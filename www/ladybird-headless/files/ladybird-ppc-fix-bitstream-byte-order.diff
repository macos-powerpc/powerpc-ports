From 904bb74abf8f64b42832ccae68d733216f93f954 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 1 Oct 2026 23:59:49 +0000
Subject: [PATCH] AK: Keep the little-endian bit streams in stream order on any host

LittleEndianInputBitStream refilled its 64-bit bit buffer by reading
the bytes of the stream into the memory of a BufferType and shifting
that number into the buffer, and LittleEndianOutputBitStream flushed
the buffer by writing its memory out as bytes. The first byte of the
stream is meant to supply the least significant bits, which is where
a little-endian host keeps it. A big-endian host keeps it in the most
significant byte, so every group of up to eight bytes was consumed and
produced in reverse order, and read_some() after a partial byte copied
the wrong end of the number as well.

GIF images were the visible result: the LZW codes of a frame are read
through this stream, the decoder met an invalid code after a few
pixels, and since such an error counts as the end of the data, the
frame stayed (almost) transparent. The old-style LZW of TIFF and the
WebP writer go through the same classes.

Keep the buffer that touches the stream as a LittleEndian<BufferType>,
so that the bytes change place where they enter and leave the number.
Nothing changes on a little-endian host.

Checked with the cross compiler for 32-bit PowerPC under qemu: without
this the first frame of download-animation.gif decoded to 3 of 9344
indices, with it the decode is identical to an independent LZW decoder,
and the LZW compressor's output decodes with that decoder too.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 AK/BitStream.h | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/AK/BitStream.h b/AK/BitStream.h
index 94b429ed3..b4c020501 100644
--- AK/BitStream.h
+++ AK/BitStream.h
@@ -8,6 +8,7 @@
 
 #include <AK/ByteBuffer.h>
 #include <AK/Concepts.h>
+#include <AK/Endian.h>
 #include <AK/MaybeOwned.h>
 #include <AK/NumericLimits.h>
 #include <AK/OwnPtr.h>
@@ -173,7 +174,9 @@ public:
 
         if (m_bit_count > 0) {
             auto bits_to_read = min(buffer.size() * bits_per_byte, m_bit_count);
-            auto result = TRY(read_bits(bits_to_read));
+            // The least significant byte of the bit buffer is the first byte of the stream, so hand the bits out
+            // as a little-endian number, whatever the byte order of the host.
+            LittleEndian<BufferType> result { TRY(read_bits(bits_to_read)) };
 
             bytes_read = bits_to_read / bits_per_byte;
             buffer.overwrite(0, &result, bytes_read);
@@ -263,10 +266,12 @@ private:
             size_t bits_to_read = bit_buffer_size - m_bit_count;
             size_t bytes_to_read = bits_to_read / bits_per_byte;
 
-            BufferType buffer = 0;
+            // The first byte of the stream must become the least significant byte of the bit buffer, so read the bytes
+            // as a little-endian number, whatever the byte order of the host.
+            LittleEndian<BufferType> buffer {};
             auto bytes = TRY(m_stream->read_some({ &buffer, bytes_to_read }));
 
-            m_bit_buffer |= (buffer << m_bit_count);
+            m_bit_buffer |= (static_cast<BufferType>(buffer) << m_bit_count);
             m_bit_count += bytes.size() * bits_per_byte;
         }
 
@@ -406,7 +411,10 @@ public:
     ALWAYS_INLINE ErrorOr<void> flush_buffer_to_stream()
     {
         auto bytes_to_write = m_bit_count / bits_per_byte;
-        TRY(m_stream->write_until_depleted({ &m_bit_buffer, bytes_to_write }));
+        // The least significant byte of the bit buffer is the first byte of the stream, so write the buffer as a
+        // little-endian number, whatever the byte order of the host.
+        LittleEndian<BufferType> buffer { m_bit_buffer };
+        TRY(m_stream->write_until_depleted({ &buffer, bytes_to_write }));
 
         if (m_bit_count == bit_buffer_size) {
             m_bit_buffer = 0;
