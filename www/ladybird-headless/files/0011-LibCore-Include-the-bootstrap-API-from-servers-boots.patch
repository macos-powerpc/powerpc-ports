From 387321b8de94a0cf5e0d3ecd3c7c7a6139786a0a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 24 Sep 2026 21:17:37 +0000
Subject: [PATCH 11/21] LibCore: Include the bootstrap API from
 <servers/bootstrap.h>

The top-level <bootstrap.h> is missing from older Mac OS X SDKs such as
10.5, where <servers/bootstrap.h> carries the whole launchd bootstrap API.
Newer SDKs keep <servers/bootstrap.h> as a wrapper around <bootstrap.h>,
so it works everywhere.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libraries/LibCore/MachPort.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Libraries/LibCore/MachPort.cpp b/Libraries/LibCore/MachPort.cpp
index 2f25722b..69eec276 100644
--- a/Libraries/LibCore/MachPort.cpp
+++ b/Libraries/LibCore/MachPort.cpp
@@ -16,7 +16,7 @@ extern "C" {
 #endif
 
 #if defined(AK_OS_MACOS)
-#    include <bootstrap.h>
+#    include <servers/bootstrap.h>
 #endif
 
 namespace Core {
