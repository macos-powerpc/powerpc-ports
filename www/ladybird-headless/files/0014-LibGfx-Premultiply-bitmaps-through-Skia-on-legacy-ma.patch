From ecc37d554552b57159d54ed8e2807fb7c48b9c97 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 24 Sep 2026 21:37:14 +0000
Subject: [PATCH 14/21] LibGfx: Premultiply bitmaps through Skia on legacy
 macOS

The Accelerate framework of Mac OS X 10.5 and 10.6 has no
vImagePremultiplyData_BGRA8888 or vImageUnpremultiplyData_BGRA8888. Use
the portable Skia code path that other platforms already take when
building with LADYBIRD_LEGACY_MACOS.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libraries/LibGfx/Bitmap.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/Libraries/LibGfx/Bitmap.cpp b/Libraries/LibGfx/Bitmap.cpp
index a692d1cb..0f577eb1 100644
--- a/Libraries/LibGfx/Bitmap.cpp
+++ b/Libraries/LibGfx/Bitmap.cpp
@@ -19,7 +19,10 @@
 #include <core/SkPixmap.h>
 #include <errno.h>
 
-#ifdef AK_OS_MACOS
+// vImage{Premultiply,Unpremultiply}Data_BGRA8888 are missing from the Accelerate of Mac OS X 10.5 and 10.6;
+// legacy builds use the Skia path below instead.
+#if defined(AK_OS_MACOS) && !defined(LADYBIRD_LEGACY_MACOS)
+#    define AK_HAS_VIMAGE_BGRA_PREMULTIPLY
 #    include <Accelerate/Accelerate.h>
 #endif
 
@@ -321,7 +324,7 @@ void Bitmap::set_alpha_type_destructive(AlphaType alpha_type)
         return;
     }
 
-#ifdef AK_OS_MACOS
+#ifdef AK_HAS_VIMAGE_BGRA_PREMULTIPLY
     vImage_Buffer buf { .data = m_data, .height = vImagePixelCount(height()), .width = vImagePixelCount(width()), .rowBytes = pitch() };
     vImage_Error err;
     if (m_alpha_type == AlphaType::Unpremultiplied) {
