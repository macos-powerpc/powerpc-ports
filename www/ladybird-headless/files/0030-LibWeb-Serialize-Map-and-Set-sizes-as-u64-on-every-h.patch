From da8cb76cb67eec3eee78c80bd5be66c87cb71cf2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 26 Sep 2026 04:23:47 +0000
Subject: [PATCH] LibWeb: Serialize Map and Set sizes as u64 on every host

Structured serialization writes map_size()/set_size(), which are
size_t, and the deserializer reads them back with decode<u64>().
IPC::Encoder writes integers at their own size, so on a 32-bit host
the size takes 4 bytes but 8 are read, the rest of the record is
misaligned and deserialization fails with "Can't read past the end of
the stream memory": structuredClone() of any Map or Set aborted
WebContent (e.g. on Instagram).

Encode both as u64. Nothing changes on 64-bit hosts.
---
 Libraries/LibWeb/HTML/StructuredSerialize.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/Libraries/LibWeb/HTML/StructuredSerialize.cpp b/Libraries/LibWeb/HTML/StructuredSerialize.cpp
index afc1339a..1acd2e52 100644
--- a/Libraries/LibWeb/HTML/StructuredSerialize.cpp
+++ b/Libraries/LibWeb/HTML/StructuredSerialize.cpp
@@ -495,7 +495,8 @@ public:
                     copied_list.append(entry.value);
                 }
 
-                serialized.encode(map->map_size());
+                // NB: Decoded as u64; map_size() is a size_t, which is only 4 bytes on 32-bit hosts.
+                serialized.encode(static_cast<u64>(map->map_size()));
 
                 // 3. For each Record { [[Key]], [[Value]] } entry of copiedList:
                 for (auto copied_value : copied_list) {
@@ -520,7 +521,8 @@ public:
                     copied_list.append(entry.key);
                 }
 
-                serialized.encode(set->set_size());
+                // NB: Decoded as u64; set_size() is a size_t, which is only 4 bytes on 32-bit hosts.
+                serialized.encode(static_cast<u64>(set->set_size()));
 
                 // 3. For each entry of copiedList:
                 for (auto copied_value : copied_list) {
