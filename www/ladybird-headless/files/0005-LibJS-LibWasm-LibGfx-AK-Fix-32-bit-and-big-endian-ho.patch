diff --git a/AK/Endian.h b/AK/Endian.h
index 71435e6d..595538e0 100644
--- a/AK/Endian.h
+++ b/AK/Endian.h
@@ -6,6 +6,9 @@
 
 #pragma once
 
+#include <AK/Array.h>
