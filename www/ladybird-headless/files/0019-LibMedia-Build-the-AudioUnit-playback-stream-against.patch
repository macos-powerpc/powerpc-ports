From a8085bb7291e40decc1f53c4f7c651bc46e48489 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 25 Sep 2026 06:31:07 +0000
Subject: [PATCH 19/21] LibMedia: Build the AudioUnit playback stream against
 the 10.5/10.6 SDKs

- The kAudioChannelBit_*TopFront and kAudioChannelLabel_*TopFront names
  are aliases that later SDKs added for the VerticalHeight* channels;
  the Mac OS X 10.5 and 10.6 SDKs only have the original names, with the
  same values. Use those.
- UInt32 is unsigned long on 32-bit Darwin, so the sizes passed to
  AudioUnitGetPropertyInfo/AudioUnitGetProperty and
  AudioFormatGetPropertyInfo/AudioFormatGetProperty by pointer cannot be
  u32 there. Declare them as UInt32.
- On 10.5 and 10.6 the AudioUnit and AudioComponent functions are
  exported by AudioUnit.framework, and AudioToolbox only imports them, so
  LibMedia also links AudioUnit.framework under LADYBIRD_LEGACY_MACOS.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .../Audio/PlaybackStreamAudioUnit.cpp         | 45 ++++++++++---------
 Libraries/LibMedia/CMakeLists.txt             |  6 +++
 2 files changed, 30 insertions(+), 21 deletions(-)

diff --git a/Libraries/LibMedia/Audio/PlaybackStreamAudioUnit.cpp b/Libraries/LibMedia/Audio/PlaybackStreamAudioUnit.cpp
index db31bc56..e6e5c1ed 100644
--- a/Libraries/LibMedia/Audio/PlaybackStreamAudioUnit.cpp
+++ b/Libraries/LibMedia/Audio/PlaybackStreamAudioUnit.cpp
@@ -117,7 +117,8 @@ private:
 template<typename T>
 static ErrorOr<CoreAudioPropertyValue<T>> get_audio_unit_property(AudioComponentInstance& instance, u32 property)
 {
-    u32 size = 0;
+    // NOTE: UInt32, not u32: the out-parameters are UInt32*, and UInt32 is unsigned long on 32-bit Darwin.
+    UInt32 size = 0;
     AU_TRY(AudioUnitGetPropertyInfo(
         instance,
         property,
@@ -393,25 +394,27 @@ NonnullRefPtr<Core::ThreadedPromise<void>> PlaybackStreamAudioUnit::set_volume(d
 }
 
 // This must be kept in the order defined by AudioChannelBitmap.
-#define ENUMERATE_CHANNEL_POSITIONS(C)          \
-    C(Left, Channel::FrontLeft)                 \
-    C(Right, Channel::FrontRight)               \
-    C(Center, Channel::FrontCenter)             \
-    C(LFEScreen, Channel::LowFrequency)         \
-    C(LeftSurround, Channel::BackLeft)          \
-    C(RightSurround, Channel::BackRight)        \
-    C(LeftCenter, Channel::FrontLeftOfCenter)   \
-    C(RightCenter, Channel::FrontRightOfCenter) \
-    C(CenterSurround, Channel::BackCenter)      \
-    C(LeftSurroundDirect, Channel::SideLeft)    \
-    C(RightSurroundDirect, Channel::SideRight)  \
-    C(TopCenterSurround, Channel::TopCenter)    \
-    C(TopBackLeft, Channel::TopBackLeft)        \
-    C(TopBackCenter, Channel::TopBackCenter)    \
-    C(TopBackRight, Channel::TopBackRight)      \
-    C(LeftTopFront, Channel::TopFrontLeft)      \
-    C(CenterTopFront, Channel::TopFrontCenter)  \
-    C(RightTopFront, Channel::TopFrontRight)
+// NOTE: Newer SDKs call the VerticalHeight* channels *TopFront, as aliases of the same values; only the
+//       original names exist in the Mac OS X 10.5 and 10.6 SDKs.
+#define ENUMERATE_CHANNEL_POSITIONS(C)               \
+    C(Left, Channel::FrontLeft)                      \
+    C(Right, Channel::FrontRight)                    \
+    C(Center, Channel::FrontCenter)                  \
+    C(LFEScreen, Channel::LowFrequency)              \
+    C(LeftSurround, Channel::BackLeft)               \
+    C(RightSurround, Channel::BackRight)             \
+    C(LeftCenter, Channel::FrontLeftOfCenter)        \
+    C(RightCenter, Channel::FrontRightOfCenter)      \
+    C(CenterSurround, Channel::BackCenter)           \
+    C(LeftSurroundDirect, Channel::SideLeft)         \
+    C(RightSurroundDirect, Channel::SideRight)       \
+    C(TopCenterSurround, Channel::TopCenter)         \
+    C(TopBackLeft, Channel::TopBackLeft)             \
+    C(TopBackCenter, Channel::TopBackCenter)         \
+    C(TopBackRight, Channel::TopBackRight)           \
+    C(VerticalHeightLeft, Channel::TopFrontLeft)     \
+    C(VerticalHeightCenter, Channel::TopFrontCenter) \
+    C(VerticalHeightRight, Channel::TopFrontRight)
 
 ErrorOr<ChannelMap> audio_channel_layout_to_channel_map(AudioChannelLayout const& channel_layout)
 {
@@ -461,7 +464,7 @@ ErrorOr<ChannelMap> audio_channel_layout_to_channel_map(AudioChannelLayout const
         if (channel_layout.mChannelLayoutTag == kAudioChannelLayoutTag_UseChannelDescriptions) {
             fill_channels_from_channel_descriptions(channel_layout);
         } else {
-            u32 explicit_layout_size = 0;
+            UInt32 explicit_layout_size = 0;
             AU_TRY(AudioFormatGetPropertyInfo(
                 kAudioFormatProperty_ChannelLayoutForTag,
                 sizeof(AudioChannelLayoutTag),
diff --git a/Libraries/LibMedia/CMakeLists.txt b/Libraries/LibMedia/CMakeLists.txt
index 16326654..90cfe3d1 100644
--- a/Libraries/LibMedia/CMakeLists.txt
+++ b/Libraries/LibMedia/CMakeLists.txt
@@ -49,6 +49,12 @@ elseif (LADYBIRD_AUDIO_BACKEND STREQUAL "AUDIO_UNIT")
     target_sources(LibMedia PRIVATE Audio/PlaybackStreamAudioUnit.cpp)
     find_library(AUDIO_TOOLBOX AudioToolbox REQUIRED)
     target_link_libraries(LibMedia PRIVATE ${AUDIO_TOOLBOX})
+    if (LADYBIRD_LEGACY_MACOS)
+        # Older macOS (at least through 10.6) exports the AudioUnit and AudioComponent functions from
+        # AudioUnit.framework; AudioToolbox only imports them.
+        find_library(AUDIO_UNIT_FRAMEWORK AudioUnit REQUIRED)
+        target_link_libraries(LibMedia PRIVATE ${AUDIO_UNIT_FRAMEWORK})
+    endif()
 elseif(LADYBIRD_AUDIO_BACKEND STREQUAL "WASAPI")
     target_sources(LibMedia PRIVATE Audio/PlaybackStreamWasapi.cpp)
     target_link_libraries(LibMedia PRIVATE ole32 avrt winmm)
