                    -DLADYBIRD_DEFAULT_OPTIMIZATION_FLAGS=OFF \
                    -DLADYBIRD_ENABLE_CPPTRACE=OFF \
                    -DLADYBIRD_WARNINGS_AS_ERRORS=OFF \
                    -DLagom_INSTALL_CMAKEDIR:PATH=lib/cmake/Lagom \
                    -DPython3_EXECUTABLE=${prefix}/bin/python${py_ver}

# The project's own -O3/-g flags are off (LADYBIRD_DEFAULT_OPTIMIZATION_FLAGS=OFF) so that
# the flags below are the only ones: a few of the generated LibWeb binding units need well
# over a gigabyte with GCC at -O3, which does not fit a 32-bit address space. -O2, no
# debug info, and a lower GCC garbage-collection threshold keep the peak down at some
# cost in compile time (tune ggc-min-expand/ggc-min-heapsize if a unit still fails).
configure.optflags          -O2

if {${configure.build_arch} eq "ppc"} {
    configure.cflags-append     -ffp-contract=off \
                                --param ggc-min-expand=20 --param ggc-min-heapsize=32768
    configure.cxxflags-append   -ffp-contract=off \
                                --param ggc-min-expand=20 --param ggc-min-heapsize=32768
}

# The install tree is the Unix layout: bin/Ladybird, bin/ladybird-{js,wasm,webdriver},
# libexec/{WebContent,WebWorker,RequestServer,ImageDecoder}, lib/liblagom-*.dylib,
# share/Lagom (resources), include/ladybird and lib/cmake/Lagom.
post-destroot {
    foreach {tool installed} {js ladybird-js wasm ladybird-wasm WebDriver ladybird-webdriver} {
        move ${destroot}${prefix}/bin/${tool} ${destroot}${prefix}/bin/${installed}
        if {[file exists ${destroot}${prefix}/bin/${tool}-orig]} {
            move ${destroot}${prefix}/bin/${tool}-orig ${destroot}${prefix}/bin/${installed}-orig
        }
    }
    delete ${destroot}${prefix}/COMMIT
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE \
        ${destroot}${prefix}/share/doc/${name}
}

notes "
Run ${prefix}/bin/Ladybird --headless=text https://example.org/ (or =layout-tree,\
 =manual, or =screenshot with --screenshot-delay SECONDS). There is no browser\
 window in this port. WebDriver: ${prefix}/bin/ladybird-webdriver.
"

livecheck.type      none
