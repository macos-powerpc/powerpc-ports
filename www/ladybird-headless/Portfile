# clock_gettime, arc4random_buf, openat etc.
legacysupport.newest_darwin_requires_legacy 15
legacysupport.redirect_bins Ladybird js wasm WebDriver

# Branch ppc of the fork: upstream 22e8e99d4c (2026-03-19), the last commit that builds
# without Rust (ENABLE_RUST=OFF), plus upstream fixes picked on top and the portability
# changes for 32-bit big-endian PowerPC and Mac OS X 10.5/10.6.
github.setup        barracuda156 ladybird 20260319.6 ppc-
revision            0
name                ladybird-headless
categories          www
license             BSD
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer

description         Ladybird web engine with a toolkit-free frontend (headless modes and WebDriver)
long_description    The Ladybird browser engine (LibWeb, LibJS and the WebContent, \
                    RequestServer, ImageDecoder and WebWorker helper processes) built \
                    with a frontend that opens no window: the Ladybird binary offers \
                    --headless=screenshot|layout-tree|text|manual and WebDriver sessions. \
                    Snapshot of upstream from before the Rust migration, with later \
                    upstream fixes and portability changes for 32-bit big-endian PowerPC \
                    and older Darwin toolchains.

homepage            https://ladybird.org
github.tarball_from archive

# The build generates the public-suffix table from this list; pin one revision
# so the build is reproducible and configure needs no network access.
set psl_commit      a179a48c465e818cfd8d626691cb317985da87fb
master_sites-append https://raw.githubusercontent.com/publicsuffix/list/${psl_commit}:psl
distfiles-append    public_suffix_list.dat:psl
extract.only        ${distname}${extract.suffix}

checksums           ${distname}${extract.suffix} \
                    rmd160  79aa995a12abbdabee005f03d0cccc329ca9fb5c \
                    sha256  04840a93003f05f9b9d707347c9477e6fa43f50c33926fb44db24e41f27d9167 \
                    size    35084826 \
                    public_suffix_list.dat \
                    rmd160  a364c63d6ade504390ea32107ba66a99e86a6b2c \
                    sha256  7333192f818588d9d0044d27d67210c782acd6d87cf71f54a00dfa20a561cfc9 \
                    size    334697

worksrcdir          ${name}

post-extract {
    # extract.rename has named the directory after the distfile.
    move ${workpath}/${distname} ${worksrcpath}
    xinstall -d ${workpath}/caches/PublicSuffix
    copy ${distpath}/public_suffix_list.dat ${workpath}/caches/PublicSuffix/
}

# This is required:
cmake.generator     Ninja

compiler.cxx_standard   2023
compiler.blacklist-append {clang < 1900}

ffmpeg.version      8

set libfmt_v        12
cmake.prefix_path-append \
                    ${prefix}/lib/libfmt${libfmt_v}/cmake

set py_ver          3.14
set py_ver_nodot    [string map {. {}} ${py_ver}]
configure.python    ${prefix}/bin/python${py_ver}

post-patch {
    fs-traverse f ${worksrcpath} {
        if {[string match *.py ${f}]} {
            reinplace -q "s|/usr/bin/env python3|${configure.python}|" ${f}
            reinplace -q "s|/usr/bin/env python|${configure.python}|" ${f}
        }
    }
}

depends_build-append \
                    path:bin/pkg-config:pkgconfig \
                    port:python${py_ver_nodot}

depends_lib-append  port:angle \
                    port:brotli \
                    port:curl \
                    port:fast-float \
                    path:lib/pkgconfig/fontconfig.pc:fontconfig \
                    path:lib/pkgconfig/freetype2.pc:freetype \
                    path:lib/pkgconfig/harfbuzz.pc:harfbuzz \
                    port:highway \
