From ac89131e99956322f5ddf2f77a48147a8249e428 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 30 Jul 2026 19:05:48 +0000
Subject: [PATCH 18/20] Do not leak the NSImage when applying a toplevel icon

-[OwlBuffer createNSImage] returns a retained image the caller must
release (see -updateCursorFromSurface in OwlPointer.m); passing it
straight to setMiniwindowImage: leaked one NSImage per set_icon.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017CtxTDuv1qwYdYQ8qAKYB3
---
 Sources/Shell/OwlXdgToplevelIconManagerV1.m | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Sources/Shell/OwlXdgToplevelIconManagerV1.m b/Sources/Shell/OwlXdgToplevelIconManagerV1.m
index 15bf856..fd290f5 100644
--- a/Sources/Shell/OwlXdgToplevelIconManagerV1.m
+++ b/Sources/Shell/OwlXdgToplevelIconManagerV1.m
@@ -232,7 +232,9 @@ static void icon_manager_set_icon_handler(
     }
 
     [buffer invalidate];
-    [window setMiniwindowImage: [buffer createNSImage]];
+    NSImage *image = [buffer createNSImage];
+    [window setMiniwindowImage: image];
+    [image release];
 }
 
 static const struct xdg_toplevel_icon_manager_v1_interface icon_manager_impl = {
