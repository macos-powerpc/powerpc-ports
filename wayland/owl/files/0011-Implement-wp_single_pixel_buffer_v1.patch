+#import "OwlBuffer.h"
+#import <Cocoa/Cocoa.h>
+#import <wayland-server.h>
+
+
+@interface OwlSinglePixelBuffer : OwlBuffer {
+    CGFloat _red, _green, _blue, _alpha;
+}
+
+- (id) initWithResource: (struct wl_resource *) resource
+                       r: (uint32_t) r
+                       g: (uint32_t) g
+                       b: (uint32_t) b
+                       a: (uint32_t) a;
