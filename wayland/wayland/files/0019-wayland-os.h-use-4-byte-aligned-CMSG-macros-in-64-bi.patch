From f1dc975161fdecf0e9c04f0ce6ed4d4a2949a3d1 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 20:48:49 +0000
Subject: [PATCH] wayland-os.h: use 4-byte aligned CMSG macros in 64-bit 10.5
 builds

In 64-bit builds the Mac OS X 10.5 SDK computes CMSG_DATA, CMSG_LEN,
CMSG_SPACE and CMSG_NXTHDR with 8-byte alignment, padding struct
cmsghdr to 16 bytes. The 10.5 kernel is 32-bit and lays control
messages out with a 12-byte header, as the 10.6 and later SDKs
assume. MacPorts legacy-support corrects CMSG_DATA only.

For a single fd, wl_connection_flush() therefore sends
cmsg_len = CMSG_LEN(4) = 20 with the fd at offset 12. The kernel
derives two fds from that length, the real one plus 4 bytes of
uninitialized stack, and sendmsg() fails with EBADF. foot on 10.5/ppc64
hit this on its first wl_shm.create_pool:

  -> wl_shm#4.create_pool(new id wl_shm_pool#41, fd 20, 1392640)
  err: wayland.c:2442: failed to flush wayland socket: Bad file descriptor

Receiving the compositor's keymap only worked by accident: the
compositor's libwayland made the same mistake, and its padding slot
happened to hold a valid fd.

Substitute the 10.6 SDK definitions for all four macros when building
64-bit against an SDK older than 10.6.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/wayland-os.h | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/src/wayland-os.h b/src/wayland-os.h
index 42e2800..3c80a2a 100644
--- a/src/wayland-os.h
+++ b/src/wayland-os.h
@@ -29,6 +29,44 @@
 #include <sys/types.h>
 #include <sys/socket.h>
 
+/*
+ * In 64-bit builds the 10.5 SDK computes every CMSG_ macro with 8-byte
+ * alignment, padding struct cmsghdr to 16 bytes, while the 32-bit 10.5
+ * kernel lays control messages out with 4-byte alignment (a 12-byte
+ * header), which is also what the 10.6 and later SDKs assume. For a
+ * single fd CMSG_LEN() then yields 20 instead of 16, the kernel reads
+ * two fds -- the real one plus 4 bytes of uninitialized padding -- and
+ * sendmsg() fails with EBADF. MacPorts legacy-support only corrects
+ * CMSG_DATA, so substitute the 10.6 definitions for all of them.
+ */
+#if defined(__APPLE__) && defined(__LP64__)
+#include <AvailabilityMacros.h>
+#if MAC_OS_X_VERSION_MAX_ALLOWED < 1060
+
+#define WL_CMSG_ALIGN32(n) (((size_t)(n) + 3) & ~(size_t)3)
+
+#undef CMSG_DATA
+#undef CMSG_NXTHDR
+#undef CMSG_SPACE
+#undef CMSG_LEN
+
+#define CMSG_DATA(cmsg) \
+	((unsigned char *)(cmsg) + WL_CMSG_ALIGN32(sizeof(struct cmsghdr)))
+#define CMSG_NXTHDR(mhdr, cmsg) \
+	(((unsigned char *)(cmsg) + WL_CMSG_ALIGN32((cmsg)->cmsg_len) + \
+	  WL_CMSG_ALIGN32(sizeof(struct cmsghdr)) > \
+	  (unsigned char *)(mhdr)->msg_control + (mhdr)->msg_controllen) ? \
+	 (struct cmsghdr *)0 : \
+	 (struct cmsghdr *)((unsigned char *)(cmsg) + \
+			    WL_CMSG_ALIGN32((cmsg)->cmsg_len)))
+#define CMSG_SPACE(l) \
+	(WL_CMSG_ALIGN32(sizeof(struct cmsghdr)) + WL_CMSG_ALIGN32(l))
+#define CMSG_LEN(l) \
+	(WL_CMSG_ALIGN32(sizeof(struct cmsghdr)) + (l))
+
+#endif
+#endif
+
 int
 wl_os_socket_cloexec(int domain, int type, int protocol);
 
-- 
2.43.0

