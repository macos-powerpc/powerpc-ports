+// Parse a decimal uint64 argument; rejects empty strings, signs, whitespace,
+// trailing garbage, and out-of-range values
+static bool parse_u64(const char *s, uint64_t *out) {
+    if (*s == '\0') {
+        return false;
+    }
+    for (const char *p = s; *p; p++) {
+        if (*p < '0' || *p > '9') {
+            return false;
+        }
+    }
+    errno = 0;
+    unsigned long long val = strtoull(s, NULL, 10);
+    if (errno == ERANGE) {
+        return false;
+    }
