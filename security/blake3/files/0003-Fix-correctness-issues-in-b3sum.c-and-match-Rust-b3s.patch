+// Stream XOF output to stdout as raw bytes
+static bool write_raw_output(const blake3_hasher *hasher, uint64_t seek, uint64_t length) {
+    uint8_t block[4096];
+    while (length > 0) {
+        size_t take = length < sizeof(block) ? (size_t)length : sizeof(block);
+        blake3_hasher_finalize_seek(hasher, seek, block, take);
+        size_t written = 0;
+        while (written < take) {
+            ssize_t n = write(STDOUT_FILENO, block + written, take - written);
+            if (n < 0) {
+                if (errno == EINTR) continue;
+                fprintf(stderr, "%s: error writing output: %s\n", NAME, strerror(errno));
