From 109ee5b1ca34c031f94ef390b1ac75828b09c6b3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 09:46:33 +0000
Subject: [PATCH] Revert "pwgen: Use Objective-C ARC."

This reverts commit 611e13f3d4f3da283461a485be25ef7d97abc6f5.

Assisted-By: Claude Sonnet 5
---
 Makefile                           |  2 +-
 sf-pwgen.m                         | 16 ++++++++--------
 sf-pwgen.xcodeproj/project.pbxproj |  2 --
 3 files changed, 9 insertions(+), 11 deletions(-)

diff --git a/Makefile b/Makefile
index 97cfc02..3861418 100644
--- a/Makefile
+++ b/Makefile
@@ -1,5 +1,5 @@
 CC?=clang
-CFLAGS?=-Wall -Wextra -Os -fobjc-arc
+CFLAGS?=-Wall -Wextra -Os
 TARGET=sf-pwgen
 SRC=sf-pwgen.m
 LIBS=-framework Foundation -framework CoreFoundation -framework SecurityFoundation
diff --git a/sf-pwgen.m b/sf-pwgen.m
index 112d930..c2e41d5 100644
--- a/sf-pwgen.m
+++ b/sf-pwgen.m
@@ -45,8 +45,7 @@
 
 static void usage(const char *argv0) {
   // to get the available languages
-  NSDictionary *policy =
-      (NSDictionary *)CFBridgingRelease(SFPWAPolicyCopyDefault());
+  NSDictionary *policy = (NSDictionary *)SFPWAPolicyCopyDefault();
   NSArray *languages =
       [policy[@"Languages-Evaluate"] componentsSeparatedByString:@","];
 
@@ -71,6 +70,8 @@ static void usage(const char *argv0) {
          "produce garbage, bug: rdar://14889281\n");
   printf("  -v, --version      Print the version number and exit.\n");
   printf("  -h, --help         Print this message.\n");
+
+  [policy release];
 }
 
 int main(int argc, char *argv[]) {
@@ -148,8 +149,7 @@ int main(int argc, char *argv[]) {
     length = PASS_MAX_LENGTH;
   }
 
-  NSDictionary *policy =
-      (NSDictionary *)CFBridgingRelease(SFPWAPolicyCopyDefault());
+  NSDictionary *policy = (NSDictionary *)SFPWAPolicyCopyDefault();
   assert(policy != NULL);
 
   SFPWAContextRef ctx = SFPWAContextCreateWithDefaults();
@@ -159,7 +159,7 @@ int main(int argc, char *argv[]) {
     NSArray *languages =
         [policy[@"Languages-Evaluate"] componentsSeparatedByString:@","];
     if ([languages containsObject:language]) {
-      SFPWAContextLoadDictionaries(ctx, (__bridge CFArrayRef) @[ language ], 1);
+      SFPWAContextLoadDictionaries(ctx, (CFArrayRef) @[ language ], 1);
     } else {
       fprintf(stderr,
               "warning: requested language `%s' unavailable, try one of: %s.\n",
@@ -174,9 +174,8 @@ int main(int argc, char *argv[]) {
       n = PASS_REQUEST_COUNT;
     }
 
-    NSMutableArray *suggestions =
-        (__bridge NSMutableArray *)SFPWAPasswordSuggest(
-            ctx, (__bridge CFDictionaryRef)policy, length, 0, n, algorithm);
+    NSMutableArray *suggestions = (NSMutableArray *)SFPWAPasswordSuggest(
+        ctx, (CFDictionaryRef)policy, length, 0, n, algorithm);
     assert(suggestions != NULL);
 
     for (NSString *s in suggestions) {
@@ -193,6 +192,7 @@ int main(int argc, char *argv[]) {
   }
 
   SFPWAContextRelease(ctx);
+  [policy release];
 
   return EXIT_SUCCESS;
 }
diff --git a/sf-pwgen.xcodeproj/project.pbxproj b/sf-pwgen.xcodeproj/project.pbxproj
index e543163..ef23705 100644
--- a/sf-pwgen.xcodeproj/project.pbxproj
+++ b/sf-pwgen.xcodeproj/project.pbxproj
@@ -266,7 +266,6 @@
 		9A850B1D16E1B750001E2417 /* Debug */ = {
 			isa = XCBuildConfiguration;
 			buildSettings = {
-				CLANG_ENABLE_OBJC_ARC = YES;
 				CODE_SIGN_STYLE = Automatic;
 				CURRENT_PROJECT_VERSION = 1.5;
 				MACOSX_DEPLOYMENT_TARGET = 10.6;
@@ -277,7 +276,6 @@
 		9A850B1E16E1B750001E2417 /* Release */ = {
 			isa = XCBuildConfiguration;
 			buildSettings = {
-				CLANG_ENABLE_OBJC_ARC = YES;
 				CODE_SIGN_STYLE = Automatic;
 				CURRENT_PROJECT_VERSION = 1.5;
 				MACOSX_DEPLOYMENT_TARGET = 10.6;
