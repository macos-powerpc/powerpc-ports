From 123a0ea3a12d8660510a4b0f81e757e43731e997 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 09:52:20 +0000
Subject: [PATCH 2/2] Avoid Clang-only literal/subscript syntax for GCC
 compatibility

Dictionary subscripting (policy[@"key"]) and array literals (@[ ... ])
are Clang extensions that older GCC's Objective-C front end doesn't
support. Replace them with plain objectForKey:/arrayWithObject: calls.

Assisted-By: Claude Sonnet 5
---
 sf-pwgen.m | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/sf-pwgen.m b/sf-pwgen.m
index c2e41d5..103161e 100644
--- a/sf-pwgen.m
+++ b/sf-pwgen.m
@@ -46,8 +46,8 @@
 static void usage(const char *argv0) {
   // to get the available languages
   NSDictionary *policy = (NSDictionary *)SFPWAPolicyCopyDefault();
-  NSArray *languages =
-      [policy[@"Languages-Evaluate"] componentsSeparatedByString:@","];
+  NSArray *languages = [[policy objectForKey:@"Languages-Evaluate"]
+      componentsSeparatedByString:@","];
 
   printf(PROJECT " " VERSION ": macOS password generator\n");
   printf("Anders Bergh <anders1@gmail.com>\n\n");
@@ -156,10 +156,11 @@ int main(int argc, char *argv[]) {
   assert(ctx != NULL);
 
   if (language) {
-    NSArray *languages =
-        [policy[@"Languages-Evaluate"] componentsSeparatedByString:@","];
+    NSArray *languages = [[policy objectForKey:@"Languages-Evaluate"]
+        componentsSeparatedByString:@","];
     if ([languages containsObject:language]) {
-      SFPWAContextLoadDictionaries(ctx, (CFArrayRef) @[ language ], 1);
+      SFPWAContextLoadDictionaries(
+          ctx, (CFArrayRef)[NSArray arrayWithObject:language], 1);
     } else {
       fprintf(stderr,
               "warning: requested language `%s' unavailable, try one of: %s.\n",
