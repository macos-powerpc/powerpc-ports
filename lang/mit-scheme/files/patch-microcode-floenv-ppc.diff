@@ -36,7 +36,43 @@
 
 #ifdef NEED_FEEXCEPT_WORKAROUND
 
-# ifdef __APPLE__
+# if (defined (__ppc__)) || (defined (__ppc64__))
+
+/* The FPSCR enable bits VE, OE, UE, ZE, XE are the exception flags >> 22.  */
+
+static inline int
+fpscr_enabled_excepts (fenv_t fpscr)
+{
+  return ((int) ((fpscr << 22) & FE_ALL_EXCEPT));
+}
+
+int fegetexcept(void)
+{
+  fenv_t fenv;
+  return ((fegetenv (&fenv)) ? -1 : (fpscr_enabled_excepts (fenv)));
+}
+
+int feenableexcept(unsigned int excepts)
+{
+  fenv_t fenv;
+  if (fegetenv (&fenv))
+    return -1;
+  int old_excepts = (fpscr_enabled_excepts (fenv));
+  fenv |= ((excepts & FE_ALL_EXCEPT) >> 22);
+  return ((fesetenv (&fenv)) ? -1 : old_excepts);
+}
+
+int fedisableexcept(unsigned int excepts)
+{
+  fenv_t fenv;
+  if (fegetenv (&fenv))
+    return -1;
+  int old_excepts = (fpscr_enabled_excepts (fenv));
+  fenv &= (~ ((excepts & FE_ALL_EXCEPT) >> 22));
+  return ((fesetenv (&fenv)) ? -1 : old_excepts);
+}
+
