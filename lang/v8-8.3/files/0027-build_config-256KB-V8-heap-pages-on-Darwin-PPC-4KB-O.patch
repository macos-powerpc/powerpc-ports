kPageSizeBits=19 exists for Linux/AIX PPC with 64KB physical pages;
Darwin ppc uses 4KB pages, so use the generic 18 (256KB MemoryChunks)
as every other 4KB-page platform does — and as the nodejs12 ppc-darwin
port does (its patch 0020), keeping both V8 builds' heap layout
consistent for the planned node14-against-this-V8 build.
---
 v8/src/base/build_config.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/v8/src/base/build_config.h b/v8/src/base/build_config.h
index cec09c4..a06513b 100644
--- a/v8/src/base/build_config.h
+++ b/v8/src/base/build_config.h
@@ -203,8 +203,8 @@
 #endif
 
 // Number of bits to represent the page size for paged spaces.
-#if V8_TARGET_ARCH_PPC || V8_TARGET_ARCH_PPC64
-// PPC has large (64KB) physical pages.
+#if (V8_TARGET_ARCH_PPC || V8_TARGET_ARCH_PPC64) && !V8_OS_MACOSX
+// PPC has large (64KB) physical pages (Linux/AIX; Darwin uses 4KB pages).
 const int kPageSizeBits = 19;
 #else
 const int kPageSizeBits = 18;
