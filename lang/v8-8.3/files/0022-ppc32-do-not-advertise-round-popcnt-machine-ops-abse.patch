SupportedMachineOperatorFlags unconditionally advertised the float
round ops (frim/frip/friz/frin — ISA 2.02, POWER5+) and popcnt
(popcntw — ISA 2.06, POWER7). CSA consults these flags at mksnapshot
time and bakes the instructions into snapshot builtins (Math.floor,
Math.ceil, Math.round, Math.trunc), so any use of those builtins
SIGILLs on 970/G4-class cores. Return kNoFlags on 32-bit, matching the
Rockwell ppc32 configuration proven working in the nodejs12 port; CSA
and TurboFan use their portable fallbacks.
---
 .../compiler/backend/ppc/instruction-selector-ppc.cc   | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/v8/src/compiler/backend/ppc/instruction-selector-ppc.cc b/v8/src/compiler/backend/ppc/instruction-selector-ppc.cc
index 58ce91d..e290246 100644
--- a/v8/src/compiler/backend/ppc/instruction-selector-ppc.cc
+++ b/v8/src/compiler/backend/ppc/instruction-selector-ppc.cc
@@ -2512,6 +2512,7 @@ void InstructionSelector::VisitI32x4Abs(Node* node) { UNIMPLEMENTED(); }
 // static
 MachineOperatorBuilder::Flags
 InstructionSelector::SupportedMachineOperatorFlags() {
+#if V8_TARGET_ARCH_PPC64
   return MachineOperatorBuilder::kFloat32RoundDown |
          MachineOperatorBuilder::kFloat64RoundDown |
          MachineOperatorBuilder::kFloat32RoundUp |
@@ -2522,6 +2523,15 @@ InstructionSelector::SupportedMachineOperatorFlags() {
          MachineOperatorBuilder::kWord32Popcnt |
          MachineOperatorBuilder::kWord64Popcnt;
   // We omit kWord32ShiftIsSafe as s[rl]w use 0x3F as a mask rather than 0x1F.
+#else
+  // The round ops emit frim/frip/friz/frin (ISA 2.02, POWER5+) and the
+  // popcnt ops emit popcntw/popcntd (ISA 2.06, POWER7) — none of which
+  // exist on the 32-bit-era cores this target supports (G3/G4/G5), and
+  // CSA bakes them into snapshot builtins at mksnapshot time if
+  // advertised. Advertise nothing and let the compiler use fallbacks,
+  // matching the configuration proven in the nodejs12 ppc32 port.
+  return MachineOperatorBuilder::kNoFlags;
+#endif
 }
 
