Mac OS 10.6: guard layoutSubtreeIfNeeded (10.7+), fix seteEnabled: typo
https://github.com/racket/racket/issues/5386#issuecomment-6588240910

layoutSubtreeIfNeeded was added unconditionally by racket/gui 2caa9290c
and 1e5053bec; on 10.6 every get-frame/get-client-size call throws
"unrecognized selector" at startup.

racket/gui 9bcc786f misspelled setEnabled: as seteEnabled: in the
PSMTabBarControl branch of tab-panel% enable-window, which is the branch
used below 10.10 and on 32-bit.
--- share/pkgs/gui-lib/mred/private/wx/cocoa/window.rkt.orig
+++ share/pkgs/gui-lib/mred/private/wx/cocoa/window.rkt
@@ -741,7 +741,8 @@
     (define/public (get-margin-adjustments) (values 0 0 0 0))
 
     (define/public (get-frame)
-      (tellv cocoa layoutSubtreeIfNeeded)
+      (when (version-10.7-or-later?)
+        (tellv cocoa layoutSubtreeIfNeeded))
       (define r (tell #:type _NSRect cocoa frame))
       (define-values (lm tm rm bm) (get-margin-adjustments))
       (cond
@@ -818,7 +819,8 @@
 
     (define/public (get-client-size w h)
       ;; May be called in Cocoa event-handling mode
-      (tellv (get-cocoa-content) layoutSubtreeIfNeeded)
+      (when (version-10.7-or-later?)
+        (tellv (get-cocoa-content) layoutSubtreeIfNeeded))
       (let ([s (NSRect-size (tell #:type _NSRect (get-cocoa-content) bounds))])
         (set-box! w (->long (ceiling (NSSize-width s))))
         (set-box! h (->long (ceiling (NSSize-height s))))))
--- share/pkgs/gui-lib/mred/private/wx/cocoa/tab-panel.rkt.orig
+++ share/pkgs/gui-lib/mred/private/wx/cocoa/tab-panel.rkt
@@ -293,7 +293,7 @@
              (if on? NSDefaultControlTint NSClearControlTint))
       (when control-cocoa
         (unless use-mm?
-          (tellv control-cocoa seteEnabled: #:type _BOOL on?)))
+          (tellv control-cocoa setEnabled: #:type _BOOL on?)))
       (when (version-26.0-or-later?)
         (when (eq? cocoa tabv-cocoa)
           (let ([subviews (tell cocoa subviews)])
