libc++: do not use openat() in remove_all() before macOS 10.10

The openat()/unlinkat()/fdopendir() family only exists since macOS 10.10.
Use the directory_iterator based implementation of remove_all() for older
deployment targets, as is already done for Windows and z/OS.

diff --git a/libcxx/src/filesystem/operations.cpp b/libcxx/src/filesystem/operations.cpp
--- a/libcxx/src/filesystem/operations.cpp
+++ b/libcxx/src/filesystem/operations.cpp
@@ -819,7 +819,10 @@
 //
 // The second implementation is used on platforms where `openat()` & friends are available,
 // and it threads file descriptors through recursive calls to avoid such race conditions.
-#if defined(_LIBCPP_WIN32API) || defined(__MVS__)
+// The openat() family of functions is only available since macOS 10.10.
+#if defined(_LIBCPP_WIN32API) || defined(__MVS__) ||                                                                   \
+    (defined(__APPLE__) && defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) &&                                   \
+     __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 101000)
 #  define REMOVE_ALL_USE_DIRECTORY_ITERATOR
 #endif
 
