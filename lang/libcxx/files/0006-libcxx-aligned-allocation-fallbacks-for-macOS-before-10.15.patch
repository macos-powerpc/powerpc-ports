libc++: aligned allocation fallbacks for macOS before 10.15

__libcpp_aligned_alloc() calls aligned_alloc() unconditionally, but Apple
only added it in macOS 10.15, and posix_memalign() in 10.6. Use
posix_memalign() for deployment targets before 10.15, and on 10.5 emulate it
the way MacPorts legacy-support does (malloc() is 16-byte aligned, valloc()
gives page alignment for anything larger; both results can be free()d).

diff --git a/libcxx/src/include/aligned_alloc.h b/libcxx/src/include/aligned_alloc.h
--- a/libcxx/src/include/aligned_alloc.h
+++ b/libcxx/src/include/aligned_alloc.h
@@ -30,6 +30,23 @@
 #  if defined(_LIBCPP_MSVCRT_LIKE)
   return ::_aligned_malloc(__size, __alignment);
 
+#  elif defined(__APPLE__) && defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) &&                               \
+      __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 1060
+  // Mac OS X 10.5 has neither aligned_alloc() (10.15) nor posix_memalign() (10.6).
+  // Emulate the latter the same way MacPorts legacy-support does: malloc() always
+  // returns 16-byte aligned memory, and valloc() provides page alignment for any
+  // larger request. The result can be released with free().
+  if (__alignment < sizeof(void*) || (__alignment & (__alignment - 1)) != 0)
+    return nullptr;
+  return __alignment <= 16 ? ::malloc(__size) : ::valloc(__size);
+#  elif defined(__APPLE__) && defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) &&                               \
+      __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 101500
+  // aligned_alloc() is only available since macOS 10.15.
+  void* __result = nullptr;
+  (void)::posix_memalign(&__result, __alignment, __size);
+  // If posix_memalign fails, __result is unmodified so we still return `nullptr`.
+  return __result;
+
 // Android only provides aligned_alloc when targeting API 28 or higher.
 #  elif !defined(__ANDROID__) || __ANDROID_API__ >= 28
   // aligned_alloc() requires that __size is a multiple of __alignment,
