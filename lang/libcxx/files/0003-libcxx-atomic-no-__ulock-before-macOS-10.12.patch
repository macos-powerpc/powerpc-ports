libc++: do not use __ulock before macOS 10.12

The private __ulock_wait()/__ulock_wake() API that atomic.cpp falls back to
on Apple platforms only exists since macOS 10.12. Use the generic timed
backoff implementation when the deployment target is older.

diff --git a/libcxx/src/atomic.cpp b/libcxx/src/atomic.cpp
--- a/libcxx/src/atomic.cpp
+++ b/libcxx/src/atomic.cpp
@@ -29,6 +29,11 @@
        __ENVIRONMENT_WATCH_OS_VERSION_MIN_REQUIRED__ >= 100400)
 #    define _LIBCPP_USE_OS_SYNC
 #  endif
+// The private __ulock API only exists since macOS 10.12. Older systems use the
+// generic timed-backoff fallback below.
+#  if defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) && __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 101200
+#    define _LIBCPP_NO_PLATFORM_WAIT
+#  endif
 #endif
 
 #ifdef __linux__
@@ -63,7 +68,7 @@
 #  include <memory>
 #  include <windows.h>
 
-#elif defined(__APPLE__)
+#elif defined(__APPLE__) && !defined(_LIBCPP_NO_PLATFORM_WAIT)
 
 #  if defined(_LIBCPP_USE_OS_SYNC)
 #    include <os/os_sync_wait_on_address.h>
@@ -113,7 +118,7 @@
   _LIBCPP_FUTEX(__ptr, FUTEX_WAKE_PRIVATE, __notify_one ? 1 : INT_MAX, 0, 0, 0);
 }
 
-#elif defined(__APPLE__)
+#elif defined(__APPLE__) && !defined(_LIBCPP_NO_PLATFORM_WAIT)
 
 #  if defined(_LIBCPP_USE_OS_SYNC)
 
