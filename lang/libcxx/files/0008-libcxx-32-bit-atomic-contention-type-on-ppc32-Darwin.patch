libc++: use a 32-bit atomic contention type on 32-bit PowerPC Darwin

__cxx_contention_t is int64_t on Apple platforms, which on 32-bit PowerPC
means every atomic wait/notify, latch, barrier and semaphore operation goes
through libatomic (and needs -latomic at link time). There is no
address-based wait/wake platform API on the Darwin versions that run on
PowerPC anyway, so use int32_t like Linux does.

This changes the libc++ ABI for this (unsupported upstream) target only;
there is no other libc++ on PowerPC Darwin to stay compatible with.
Optional: dropping this patch is safe, users then need -latomic for the
facilities above.

diff --git a/libcxx/include/__atomic/contention_t.h b/libcxx/include/__atomic/contention_t.h
--- a/libcxx/include/__atomic/contention_t.h
+++ b/libcxx/include/__atomic/contention_t.h
@@ -27,6 +27,10 @@
 
 #  if defined(__linux__) || defined(__Fuchsia__)
 using __cxx_contention_t _LIBCPP_NODEBUG = int32_t;
+#  elif defined(__APPLE__) && defined(__ppc__) && !defined(__ppc64__)
+// 32-bit PowerPC has no lock-free 64-bit atomics, and there is no address-based
+// wait/wake platform API on the Darwin versions that run on it anyway.
+using __cxx_contention_t _LIBCPP_NODEBUG = int32_t;
 #  elif defined(__APPLE__)
 using __cxx_contention_t _LIBCPP_NODEBUG = int64_t;
 #  elif defined(__FreeBSD__) && __SIZEOF_LONG__ == 8
@@ -41,11 +45,14 @@
 
 #else // _LIBCPP_ABI_ATOMIC_WAIT_NATIVE_BY_SIZE
 
-#  if defined(__linux__) || defined(__Fuchsia__) || (defined(_AIX) && !defined(__64BIT__))
+// 32-bit PowerPC Darwin: no lock-free 64-bit atomics (would need libatomic), and no
+// address-based wait/wake platform API on the Darwin versions that run on it anyway.
+#  if defined(__linux__) || defined(__Fuchsia__) || (defined(_AIX) && !defined(__64BIT__)) ||                          \
+      (defined(__APPLE__) && defined(__ppc__) && !defined(__ppc64__))
 using __cxx_contention_t _LIBCPP_NODEBUG = int32_t;
 #  else
 using __cxx_contention_t _LIBCPP_NODEBUG = int64_t;
-#  endif // __linux__ || __Fuchsia__ || (_AIX && !__64BIT__)
+#  endif // __linux__ || __Fuchsia__ || (_AIX && !__64BIT__) || (__APPLE__ && __ppc__)
 
 #endif // _LIBCPP_ABI_ATOMIC_WAIT_NATIVE_BY_SIZE
 
