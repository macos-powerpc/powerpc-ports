libc++ cmake: look for libatomic on Darwin when building with GCC

Upstream hard-codes LIBCXX_HAS_ATOMIC_LIB=NO on Apple platforms. GCC
implements 64-bit atomics on 32-bit PowerPC through libatomic, so when the
compiler is GCC, link libatomic into libc++ if the target has no native
64-bit atomics and libatomic provides them.

The usual check_library_exists(atomic __atomic_fetch_add_8 ...) cannot be
used for this: it compiles a C file, and the C driver of GCC rejects the
-nostdlib++ which config-ix.cmake puts into CMAKE_REQUIRED_FLAGS for all
checks (Clang accepts the option for C as well), so with GCC that check
always fails without ever looking for libatomic. Probe in C++ instead,
with a 64-bit __atomic_fetch_add that has to link.

diff --git a/libcxx/cmake/config-ix.cmake b/libcxx/cmake/config-ix.cmake
--- a/libcxx/cmake/config-ix.cmake
+++ b/libcxx/cmake/config-ix.cmake
@@ -113,7 +113,32 @@
 elseif(APPLE)
   set(LIBCXX_HAS_PTHREAD_LIB NO)
   set(LIBCXX_HAS_RT_LIB NO)
-  set(LIBCXX_HAS_ATOMIC_LIB NO)
+  if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+    # GCC implements 64-bit atomics on 32-bit PowerPC through libatomic, so
+    # link it into libc++ when the target has no native 64-bit atomics and
+    # libatomic provides them. check_library_exists() cannot be used for this:
+    # it compiles C, and the C driver of GCC rejects the -nostdlib++ carried
+    # by CMAKE_REQUIRED_FLAGS (Clang accepts it for C as well).
+    include(CheckCXXSourceCompiles)
+    set(_libcxx_atomic64_source "
+#include <stdint.h>
+int main(int, char**) {
+  static int64_t x = 0;
+  return (int)__atomic_fetch_add(&x, 1, __ATOMIC_SEQ_CST);
+}
+")
+    check_cxx_source_compiles("${_libcxx_atomic64_source}" LIBCXX_HAS_NATIVE_64_BIT_ATOMICS)
+    if (LIBCXX_HAS_NATIVE_64_BIT_ATOMICS)
+      set(LIBCXX_HAS_ATOMIC_LIB NO)
+    else()
+      cmake_push_check_state()
+      list(APPEND CMAKE_REQUIRED_LIBRARIES atomic)
+      check_cxx_source_compiles("${_libcxx_atomic64_source}" LIBCXX_HAS_ATOMIC_LIB)
+      cmake_pop_check_state()
+    endif()
+  else()
+    set(LIBCXX_HAS_ATOMIC_LIB NO)
+  endif()
 elseif(FUCHSIA)
   set(LIBCXX_HAS_PTHREAD_LIB NO)
   set(LIBCXX_HAS_RT_LIB NO)
