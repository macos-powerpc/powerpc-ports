libc++ headers: guard libc functions missing on Darwin for GCC

libc++ relies on Clang's using_if_exists attribute to silently drop
using-declarations for libc functions that the C library does not provide.
GCC has no such attribute, so with GCC on Darwin:

 - <cstdlib> fails on quick_exit()/at_quick_exit() (never provided by Apple)
   and aligned_alloc() (macOS 10.15+);
 - <ctime> fails on timespec_get() (macOS 10.15+);
 - <cuchar> fails on mbrtoc16() and friends (no <uchar.h> in old SDKs);
 - <cmath> fails on llrintf()/llroundf() etc. in -std=c++XX mode on
   macOS < 10.7, where <math.h> hides the long long rounding functions
   under __STRICT_ANSI__ although libm provides them.

Add explicit guards (and, for math.h, the missing prototypes) which only
kick in when the attribute is unavailable on Apple platforms.

diff --git a/libcxx/include/cstdlib b/libcxx/include/cstdlib
--- a/libcxx/include/cstdlib
+++ b/libcxx/include/cstdlib
@@ -144,13 +144,29 @@
 using ::mbstowcs _LIBCPP_USING_IF_EXISTS;
 using ::wcstombs _LIBCPP_USING_IF_EXISTS;
 #  endif
-#  if !defined(_LIBCPP_CXX03_LANG)
+// Apple's libc has never provided quick_exit()/at_quick_exit(), and only gained
+// aligned_alloc() in macOS 10.15. Clang silently drops the missing declarations
+// through using_if_exists, but other compilers (GCC) need explicit guards.
+#  if __has_attribute(__using_if_exists__) || !defined(__APPLE__)
+#    define _LIBCPP_LIBC_HAS_QUICK_EXIT 1
+#  else
+#    define _LIBCPP_LIBC_HAS_QUICK_EXIT 0
+#  endif
+#  if __has_attribute(__using_if_exists__) || !defined(__APPLE__) ||                                                   \
+      (defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) && __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ >= 101500)
+#    define _LIBCPP_LIBC_HAS_ALIGNED_ALLOC 1
+#  else
+#    define _LIBCPP_LIBC_HAS_ALIGNED_ALLOC 0
+#  endif
+#  if !defined(_LIBCPP_CXX03_LANG) && _LIBCPP_LIBC_HAS_QUICK_EXIT
 using ::at_quick_exit _LIBCPP_USING_IF_EXISTS;
 using ::quick_exit _LIBCPP_USING_IF_EXISTS;
 #  endif
-#  if _LIBCPP_STD_VER >= 17
+#  if _LIBCPP_STD_VER >= 17 && _LIBCPP_LIBC_HAS_ALIGNED_ALLOC
 using ::aligned_alloc _LIBCPP_USING_IF_EXISTS;
 #  endif
+#  undef _LIBCPP_LIBC_HAS_QUICK_EXIT
+#  undef _LIBCPP_LIBC_HAS_ALIGNED_ALLOC
 
 _LIBCPP_END_NAMESPACE_STD
 

diff --git a/libcxx/include/ctime b/libcxx/include/ctime
--- a/libcxx/include/ctime
+++ b/libcxx/include/ctime
@@ -80,7 +80,12 @@
 using ::gmtime _LIBCPP_USING_IF_EXISTS;
 using ::localtime _LIBCPP_USING_IF_EXISTS;
 using ::strftime _LIBCPP_USING_IF_EXISTS;
-#  if _LIBCPP_STD_VER >= 17
+// Apple's libc only gained timespec_get() in macOS 10.15. Clang silently drops the
+// missing declaration through using_if_exists, but other compilers (GCC) need an
+// explicit guard.
+#  if _LIBCPP_STD_VER >= 17 &&                                                                                         \
+      (__has_attribute(__using_if_exists__) || !defined(__APPLE__) ||                                                  \
+       (defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) && __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ >= 101500))
 using ::timespec_get _LIBCPP_USING_IF_EXISTS;
 #  endif
 

diff --git a/libcxx/include/cuchar b/libcxx/include/cuchar
--- a/libcxx/include/cuchar
+++ b/libcxx/include/cuchar
@@ -62,14 +62,19 @@
 
 using ::mbstate_t _LIBCPP_USING_IF_EXISTS;
 
-#    if _LIBCPP_HAS_C8RTOMB_MBRTOC8
+// Older Apple SDKs do not provide <uchar.h> (libc++'s own <uchar.h> copes with
+// that), so none of these functions exist. Clang silently drops the missing
+// declarations through using_if_exists, other compilers (GCC) need a guard.
+#    if __has_attribute(__using_if_exists__) || !defined(__APPLE__) || __has_include_next(<uchar.h>)
+#      if _LIBCPP_HAS_C8RTOMB_MBRTOC8
 using ::mbrtoc8 _LIBCPP_USING_IF_EXISTS;
 using ::c8rtomb _LIBCPP_USING_IF_EXISTS;
-#    endif
+#      endif
 using ::mbrtoc16 _LIBCPP_USING_IF_EXISTS;
 using ::c16rtomb _LIBCPP_USING_IF_EXISTS;
 using ::mbrtoc32 _LIBCPP_USING_IF_EXISTS;
 using ::c32rtomb _LIBCPP_USING_IF_EXISTS;
+#    endif
 
 _LIBCPP_END_NAMESPACE_STD
 

diff --git a/libcxx/include/math.h b/libcxx/include/math.h
--- a/libcxx/include/math.h
+++ b/libcxx/include/math.h
@@ -304,6 +304,33 @@
 #      include_next <math.h>
 #    endif
 
+#    if defined(__APPLE__) && defined(__cplusplus) && defined(__STRICT_ANSI__) && !defined(__STDC_VERSION__)
+// Before Mac OS X 10.7, <math.h> omits the prototypes of the long long rounding
+// functions when __STRICT_ANSI__ is defined (e.g. with -std=c++XX rather than
+// -std=gnu++XX), although libm has always provided them.
+#      if __has_include(<Availability.h>)
+#        include <Availability.h>
+#      endif
+#      if !defined(__MAC_OS_X_VERSION_MAX_ALLOWED) || __MAC_OS_X_VERSION_MAX_ALLOWED < 1070
+extern "C" {
+extern long long int llrint(double);
+extern long long int llrintf(float);
+extern long long int llround(double);
+extern long long int llroundf(float);
+#        ifdef __LIBMLDBL_COMPAT
+// On PowerPC with the 128-bit long double, <math.h> binds the long double
+// functions to the $LDBL128 symbols with this macro; the unsuffixed symbols
+// are the 64-bit long double versions.
+extern long long int llrintl(long double) __LIBMLDBL_COMPAT(llrintl);
+extern long long int llroundl(long double) __LIBMLDBL_COMPAT(llroundl);
+#        else
+extern long long int llrintl(long double);
+extern long long int llroundl(long double);
+#        endif
+}
+#      endif
+#    endif
+
 #    ifdef __cplusplus
 
 // We support including .h headers inside 'extern "C"' contexts, so switch

