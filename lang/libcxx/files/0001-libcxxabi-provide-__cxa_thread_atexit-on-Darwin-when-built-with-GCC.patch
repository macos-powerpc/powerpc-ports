libc++abi: provide __cxa_thread_atexit() on Darwin when built with GCC

On Apple platforms Clang registers thread_local destructors through the dyld
TLV runtime (_tlv_atexit), so upstream does not build cxa_thread_atexit.cpp
there. GCC implements thread_local with emulated TLS (from libgcc) and emits
calls to __cxa_thread_atexit() instead; without this symbol every program
with a thread_local object that has a destructor fails to link.

Build cxa_thread_atexit.cpp on Apple when the compiler is GCC, drop the weak
reference to __cxa_thread_atexit_impl() there (Darwin has none and ld64 does
not accept undefined weak references), declare the function in <cxxabi.h>
for GCC, and export/re-export it through a dedicated symbol list.

Replaces the old libcxxabi emutls patch: emutls itself now comes from GCC's
libgcc_s, which the driver links because libc++abi uses -nostdlib++ rather
than -nodefaultlibs.

diff --git a/libcxxabi/include/cxxabi.h b/libcxxabi/include/cxxabi.h
--- a/libcxxabi/include/cxxabi.h
+++ b/libcxxabi/include/cxxabi.h
@@ -179,9 +179,11 @@
 extern _LIBCXXABI_FUNC_VIS bool __cxa_uncaught_exception() _LIBCXXABI_NOEXCEPT;
 extern _LIBCXXABI_FUNC_VIS unsigned int __cxa_uncaught_exceptions() _LIBCXXABI_NOEXCEPT;
 
-#if defined(__linux__) || defined(__Fuchsia__)
+#if defined(__linux__) || defined(__Fuchsia__) || (defined(__APPLE__) && defined(__GNUC__) && !defined(__clang__))
 // Linux and Fuchsia TLS support. Not yet an official part of the Itanium ABI.
 // https://sourceware.org/glibc/wiki/Destructor%20support%20for%20thread_local%20variables
+// Also used by GCC on Apple platforms, where thread_local is implemented with
+// emulated TLS.
 extern _LIBCXXABI_FUNC_VIS int __cxa_thread_atexit(void (*)(void *), void *,
                                                    void *) _LIBCXXABI_NOEXCEPT;
 #endif

diff --git a/libcxxabi/lib/cxa-thread-atexit.exp b/libcxxabi/lib/cxa-thread-atexit.exp
new file mode 100644
--- /dev/null
+++ b/libcxxabi/lib/cxa-thread-atexit.exp
@@ -0,0 +1,3 @@
+# Thread-local destructor registration. Not used by Clang on Apple platforms,
+# but GCC (emulated TLS) calls it for thread_local objects with destructors.
+___cxa_thread_atexit

diff --git a/libcxxabi/src/CMakeLists.txt b/libcxxabi/src/CMakeLists.txt
--- a/libcxxabi/src/CMakeLists.txt
+++ b/libcxxabi/src/CMakeLists.txt
@@ -36,11 +36,21 @@
   )
 endif()
 
-if (LIBCXXABI_ENABLE_THREADS AND (UNIX OR FUCHSIA) AND NOT (APPLE OR CYGWIN)
+# On Apple platforms Clang registers thread_local destructors through the dyld
+# TLV runtime (_tlv_atexit), but GCC uses emulated TLS and emits calls to
+# __cxa_thread_atexit() instead, so provide it when building with GCC.
+if (APPLE AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+  set(LIBCXXABI_APPLE_NEEDS_CXA_THREAD_ATEXIT ON)
+else()
+  set(LIBCXXABI_APPLE_NEEDS_CXA_THREAD_ATEXIT OFF)
+endif()
+if (LIBCXXABI_ENABLE_THREADS AND (UNIX OR FUCHSIA) AND NOT CYGWIN
+    AND (NOT APPLE OR LIBCXXABI_APPLE_NEEDS_CXA_THREAD_ATEXIT)
     AND NOT ("${CMAKE_SYSTEM_NAME}" MATCHES "AIX"))
   list(APPEND LIBCXXABI_SOURCES
     cxa_thread_atexit.cpp
   )
+  set(LIBCXXABI_HAS_CXA_THREAD_ATEXIT ON)
 endif()
 
 set(LIBCXXABI_HEADERS
@@ -252,6 +262,10 @@
   reexport_symbols("${CMAKE_CURRENT_SOURCE_DIR}/../lib/itanium-base.exp")
   reexport_symbols("${CMAKE_CURRENT_SOURCE_DIR}/../lib/std-misc.exp")
 
+  if (LIBCXXABI_HAS_CXA_THREAD_ATEXIT)
+    reexport_symbols("${CMAKE_CURRENT_SOURCE_DIR}/../lib/cxa-thread-atexit.exp")
+  endif()
+
   if (LIBCXXABI_ENABLE_NEW_DELETE_DEFINITIONS)
     reexport_symbols("${CMAKE_CURRENT_SOURCE_DIR}/../lib/new-delete.exp")
   endif()

diff --git a/libcxxabi/src/cxa_thread_atexit.cpp b/libcxxabi/src/cxa_thread_atexit.cpp
--- a/libcxxabi/src/cxa_thread_atexit.cpp
+++ b/libcxxabi/src/cxa_thread_atexit.cpp
@@ -21,6 +21,7 @@
 
   using Dtor = void(*)(void*);
 
+#if !defined(__APPLE__)
   extern "C"
 #ifndef HAVE___CXA_THREAD_ATEXIT_IMPL
   // A weak symbol is used to detect this function's presence in the C library
@@ -28,6 +29,7 @@
   _LIBCXXABI_WEAK
 #endif
   int __cxa_thread_atexit_impl(Dtor, void*, void*);
+#endif // !defined(__APPLE__)
 
 #ifndef HAVE___CXA_THREAD_ATEXIT_IMPL
 
@@ -106,16 +108,24 @@
 
 #endif // HAVE___CXA_THREAD_ATEXIT_IMPL
 
-#if defined(__linux__) || defined(__Fuchsia__)
+#if defined(__linux__) || defined(__Fuchsia__) || defined(__APPLE__)
 extern "C" {
 
   _LIBCXXABI_FUNC_VIS int __cxa_thread_atexit(Dtor dtor, void* obj, void* dso_symbol) throw() {
 #ifdef HAVE___CXA_THREAD_ATEXIT_IMPL
     return __cxa_thread_atexit_impl(dtor, obj, dso_symbol);
 #else
+#  if defined(__APPLE__)
+    // Darwin's libc has no __cxa_thread_atexit_impl(), and ld64 does not accept
+    // undefined weak references, so always use the fallback implementation.
+    // On Apple platforms this file is only compiled for GCC, which implements
+    // thread_local with emulated TLS and calls __cxa_thread_atexit().
+    {
+#  else
     if (__cxa_thread_atexit_impl) {
       return __cxa_thread_atexit_impl(dtor, obj, dso_symbol);
     } else {
+#  endif
       // Initialize the dtors std::__libcpp_tls_key (uses __cxa_guard_*() for
       // one-time initialization and __cxa_atexit() for destruction)
       static DtorsManager manager;
@@ -142,5 +152,5 @@
 #endif // HAVE___CXA_THREAD_ATEXIT_IMPL
   }
 } // extern "C"
-#endif // defined(__linux__) || defined(__Fuchsia__)
+#endif // defined(__linux__) || defined(__Fuchsia__) || defined(__APPLE__)
 } // namespace __cxxabiv1
