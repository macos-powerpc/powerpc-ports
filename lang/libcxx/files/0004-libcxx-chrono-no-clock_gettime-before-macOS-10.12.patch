libc++: do not use clock_gettime() before macOS 10.12

clock_gettime() only exists since macOS 10.12. For older deployment targets
use gettimeofday() for system_clock and _FilesystemClock, and restore the
mach_absolute_time() based steady_clock that libc++ used until LLVM 17
(with the conversion split to avoid overflow on PowerPC, where the timebase
numerator is large).

diff --git a/libcxx/src/chrono.cpp b/libcxx/src/chrono.cpp
--- a/libcxx/src/chrono.cpp
+++ b/libcxx/src/chrono.cpp
@@ -41,6 +41,15 @@
 #  define _LIBCPP_HAS_CLOCK_GETTIME
 #endif
 
+// clock_gettime() is only available since macOS 10.12. Older systems use
+// gettimeofday() for the system clock and mach_absolute_time() for the
+// steady clock, as libc++ did historically.
+#if defined(__APPLE__) && defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) &&                                    \
+    __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 101200
+#  undef _LIBCPP_HAS_CLOCK_GETTIME
+#  define _LIBCPP_USE_MACH_ABSOLUTE_TIME
+#endif
+
 #if defined(_LIBCPP_WIN32API)
 #  define WIN32_LEAN_AND_MEAN
 #  define VC_EXTRA_LEAN
@@ -170,7 +179,34 @@
 
 #if _LIBCPP_HAS_MONOTONIC_CLOCK
 
-#  if defined(__APPLE__)
+#  if defined(_LIBCPP_USE_MACH_ABSOLUTE_TIME)
+
+// mach_absolute_time() * MachInfo.numer / MachInfo.denom is the number of
+// nanoseconds since the computer booted up. MachInfo.numer and MachInfo.denom
+// are run time constants supplied by the OS. This clock has no relationship
+// to the Gregorian calendar. It's main use is as a high resolution timer.
+
+static mach_timebase_info_data_t __libcpp_mach_timebase_info() {
+  mach_timebase_info_data_t MachInfo;
+  mach_timebase_info(&MachInfo);
+  return MachInfo;
+}
+
+static steady_clock::time_point __libcpp_steady_clock_now() {
+  static const mach_timebase_info_data_t MachInfo = __libcpp_mach_timebase_info();
+  const uint64_t ticks = mach_absolute_time();
+  uint64_t ns;
+  if (MachInfo.numer == MachInfo.denom) {
+    ns = ticks;
+  } else {
+    // Split the computation to avoid overflowing 64 bits, which happens quickly
+    // on PowerPC where numer is large (e.g. 1000000000 / 33333333).
+    ns = (ticks / MachInfo.denom) * MachInfo.numer + (ticks % MachInfo.denom) * MachInfo.numer / MachInfo.denom;
+  }
+  return steady_clock::time_point(steady_clock::duration(static_cast<steady_clock::rep>(ns)));
+}
+
+#  elif defined(__APPLE__)
 
 // On Apple platforms, only CLOCK_UPTIME_RAW, CLOCK_MONOTONIC_RAW or
 // mach_absolute_time are able to time functions in the nanosecond range.

diff --git a/libcxx/src/filesystem/filesystem_clock.cpp b/libcxx/src/filesystem/filesystem_clock.cpp
--- a/libcxx/src/filesystem/filesystem_clock.cpp
+++ b/libcxx/src/filesystem/filesystem_clock.cpp
@@ -41,6 +41,12 @@
 #  define _LIBCPP_HAS_CLOCK_GETTIME
 #endif
 
+// clock_gettime() is only available since macOS 10.12; older systems use gettimeofday().
+#if defined(__APPLE__) && defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) &&                                    \
+    __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 101200
+#  undef _LIBCPP_HAS_CLOCK_GETTIME
+#endif
+
 _LIBCPP_BEGIN_NAMESPACE_FILESYSTEM
 _LIBCPP_BEGIN_EXPLICIT_ABI_ANNOTATIONS
 
