# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem                  1.0

name                        libcxx

# On macOS 10.7 and later libc++ is part of the OS and this port is empty,
# as its predecessor (libc++ 5.0.1, built with Clang) was. On 10.6 and
# earlier, on any architecture, it provides a current libc++ built with GCC.

# Upstream dropped these Darwin releases long ago, but libc++ and libc++abi
# are almost entirely platform-agnostic. The few places which assume a modern
# Darwin libc, Clang-only compiler features or a modern ld64 are patched
# below; every patch explains what it works around.

# The library is built with gcc16 and only ever used from GCC
# (-stdlib=libc++), so its version is independent from the llvm ports.
# gcc16 bakes the include directory of this port into its driver
# (--with-gxx-libcxx-include-dir), but does not depend on this port: GCC
# never reads the headers while it is built (gcc/configure.ac only records
# the path), so gcc16 is built first, and everything here, cmake and python3
# included, is built with it. -stdlib=libc++ works once the headers are
# installed. The install prefix is version-independent for that reason.

# Two subports, sharing version, patches and configuration:
#  - ${name}-headers configures the same CMake tree and installs only
#    the headers, including the generated __config_site;
#  - ${name} builds and installs the libraries.

set headers_subport         ${name}-headers
subport                     ${headers_subport} {}

# The port this replaces had epoch 1.
epoch                       1
version                     23.1.4
revision                    0

categories                  lang devel
maintainers                 {@barracuda156 macos-powerpc.org:barracuda} {@catap korins.ky:kirill}
license                     NCSA

if {${subport} eq ${headers_subport}} {
    description             Headers of libc++, the LLVM implementation of the C++ standard library
    long_description        {*}${description}. On macOS 10.6 and earlier they are intended to be \
                            used from GCC via -stdlib=libc++\; the libraries are provided by ${name}. \
                            On later systems this port is empty, libc++ being part of the OS.
} else {
    description             libc++ is the LLVM implementation of the C++ standard library
    long_description        {*}${description}. On macOS 10.6 and earlier it is built with and \
                            intended to be used from GCC via -stdlib=libc++\; objects cannot be \
                            passed between different C++ runtimes, so it is installed into its own \
                            prefix unless the default_runtime variant is selected. On later systems \
                            this port is empty, libc++ being part of the OS.
}

homepage                    https://libcxx.llvm.org

if {${os.platform} eq "darwin" && ${os.major} >= 11} {
    # Nothing to build: libc++ is part of the OS. Install the same marker as
    # the port this replaces, so that dependents keep working unchanged.
    supported_archs         noarch
    platforms               any
    distfiles
    depends_extract
    use_configure           no
    build {}
    destroot {
        xinstall -d ${destroot}${prefix}/share/doc/${subport}
        system "echo ${subport} is an empty port on this OS version because the functionality is already provided by the OS. > ${destroot}${prefix}/share/doc/${subport}/README.txt"
    }
    livecheck.type          none
    return
}

PortGroup                   cmake 1.1
PortGroup                   muniversal 1.0

master_sites                https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/

# Since LLVM 22 upstream only publishes the monolithic llvm-project tarball;
# the per-component tarballs (libcxx-*.src.tar.xz etc.) are gone.
distname                    llvm-project-${version}.src
extract.suffix              .tar.xz

checksums                   rmd160  bd18b5f174b3c02a4f868b21c7d0547765d21e05 \
                            sha256  819ecf7351f1a66f76b2d701d8942faaf5faeb324cb90c9d5b090de142434bb2 \
                            size    179272572

if {[vercmp [macports_version] >= 2.12.99]} {
    extract.add_deps        no
}
depends_extract             port:xz-bootstrap
depends_skip_archcheck-append \
                            xz-bootstrap
extract.cmd                 ${prefix}/libexec/xz-bootstrap/bin/xz

# Only extract what a standalone runtimes build of libc++/libc++abi needs;
# the full tree is about 2 GB, mostly tests.
# libc++'s std::from_chars for floating-point types (src/charconv.cpp) is
# implemented with header-only code from LLVM libc (libc/shared, which pulls
# in libc/src/__support, libc/hdr and libc/include). The build finds it via
# cmake/Modules/FindLibcCommonUtils.cmake only if the libc directory exists
# next to libcxx; without it the include path is silently missing (and the
# link line gets a bogus -lllvm-libc-common-utilities), hence the subset
# below. Nothing from libc is compiled or installed.
extract.post_args-append    ${distname}/cmake \
                            ${distname}/runtimes \
                            ${distname}/llvm/cmake \
                            ${distname}/llvm/utils/llvm-lit \
                            ${distname}/libc/LICENSE.TXT \
                            ${distname}/libc/hdr \
                            ${distname}/libc/include/llvm-libc-macros \
                            ${distname}/libc/include/llvm-libc-types \
                            ${distname}/libc/shared \
                            ${distname}/libc/src/__support \
                            ${distname}/libcxx/CMakeLists.txt \
                            ${distname}/libcxx/LICENSE.TXT \
                            ${distname}/libcxx/cmake \
                            ${distname}/libcxx/include \
                            ${distname}/libcxx/lib \
                            ${distname}/libcxx/modules \
                            ${distname}/libcxx/src \
                            ${distname}/libcxx/utils \
                            ${distname}/libcxx/vendor \
                            ${distname}/libcxxabi/CMakeLists.txt \
                            ${distname}/libcxxabi/LICENSE.TXT \
                            ${distname}/libcxxabi/cmake \
                            ${distname}/libcxxabi/include \
                            ${distname}/libcxxabi/lib \
                            ${distname}/libcxxabi/src

patch.pre_args-replace      -p0 -p1

# libc++abi: GCC (emulated TLS) needs __cxa_thread_atexit, which upstream
# only builds on Linux/Fuchsia.
patchfiles                  0001-libcxxabi-provide-__cxa_thread_atexit-on-Darwin-when-built-with-GCC.patch
# Build system: ld64-97 lacks -reexported_symbols_list and -force_symbols_*_list;
# newer ld64 (e.g. darwin-xtools) rejects the former for deployment targets
# before 10.7.
patchfiles-append           0002-runtimes-cmake-cope-with-old-ld64-lacking-symbol-list-options.patch
# Library sources: APIs that do not exist before macOS 10.10/10.12/10.15.
patchfiles-append           0003-libcxx-atomic-no-__ulock-before-macOS-10.12.patch \
                            0004-libcxx-chrono-no-clock_gettime-before-macOS-10.12.patch \
                            0005-libcxx-filesystem-no-openat-before-macOS-10.10.patch \
                            0006-libcxx-aligned-allocation-fallbacks-for-macOS-before-10.15.patch
# Headers: libc++ relies on Clang's using_if_exists attribute to hide libc
# functions which Apple does not provide; GCC has no such attribute.
patchfiles-append           0007-libcxx-headers-guard-libc-functions-missing-on-Darwin-for-GCC.patch
# Optional: 32-bit atomic contention type on ppc32, so that atomic::wait,
# latch, barrier and semaphore do not require -latomic. Changes the ABI of
# this (unsupported upstream) target only; drop if undesired.
patchfiles-append           0008-libcxx-32-bit-atomic-contention-type-on-ppc32-Darwin.patch
# Link libatomic into libc++ when the target has no native 64-bit atomics
# (ppc32) and GCC provides them there; probed in C++, as the usual C check
# cannot run with GCC's -nostdlib++. libc++ itself needs none with 0008.
patchfiles-append           0009-libcxx-cmake-look-for-libatomic-on-Darwin-with-GCC.patch
# Build system: libc++abi's Darwin export list of the fundamental type
# typeinfos describes what Clang emits; GCC's set differs (no _Float16,
# __int128 only on ppc64, long double mangled 'g'), and ld64 fails on listed
# symbols which do not exist, so the list is generated from the compiler.
patchfiles-append           0010-libcxxabi-export-the-fundamental-type-typeinfos-which-GCC-emits.patch
# libc++abi: the __cxa_thread_atexit fallback kept its destructor list in
# a thread_local, which GCC's emulated TLS tears down before the list is run.
patchfiles-append           0011-libcxxabi-keep-the-thread_local-destructor-list-in-the-TLS-key.patch

# The default powerpc-ports compiler:
set gcc_ver                 16

set py_ver                  3.14
set py_ver_nodot            [string map {. {}} ${py_ver}]

# libc++ 23 is compiled as C++26 and officially supports GCC >= 15.
# The headers subport only needs a compiler for CMake to configure,
# and gcc16 is installed before this port anyway (see above).
# The runtimes build needs Python 3 (one generated header mapping file).
depends_build-append        port:gcc${gcc_ver} \
                            port:python${py_ver_nodot}

set libcxx_cc               ${prefix}/bin/gcc-mp-${gcc_ver}
set libcxx_cxx              ${prefix}/bin/g++-mp-${gcc_ver}

configure.compiler.add_deps no

# sterilize MacPorts build environment; we want nothing picked up from MP prefix
compiler.cpath
compiler.library_path

configure.cxx_stdlib

configure.cflags
configure.cxxflags
configure.cppflags
configure.optflags
configure.ldflags

configure.universal_cflags
configure.universal_cxxflags
configure.universal_cppflags
configure.universal_ldflags
configure.universal_args

configure.ccache            no
configure.distcc            no

# sterilize PATH
configure.env-append        PATH=${workpath}/bins:/usr/bin:/bin:/usr/sbin:/sbin
build.env-append            PATH=${workpath}/bins:/usr/bin:/bin:/usr/sbin:/sbin
destroot.env-append         PATH=${workpath}/bins:/usr/bin:/bin:/usr/sbin:/sbin

configure.cmd               ${prefix}/bin/cmake
cmake.build_type            Release
# No ninja to minimize dependencies:
cmake.generator             {Unix Makefiles}

# Standalone runtimes build (the only supported way since LLVM 15).
cmake.source_dir            ${worksrcpath}/runtimes

variant default_runtime description "Install into the system prefix, the libraries depending on the base system only" {
    description-append      This version is intended to provide the default C++ runtime.

    destroot.violate_mtree  yes
}

# Install it into a dedicated prefix, to be on a safe side, since some ports
# may hardcode libc++, and we rather want an explicit error than a successful but broken build.
# The prefix is version-independent so that gcc16 can bake the include path in.
# Install into system prefix, if that is asked for.
if {[variant_isset default_runtime]} {
    cmake.install_prefix    /usr

    configure.pre_args-replace \
                            {*}[cmake::system_prefix_path] \
                            -DCMAKE_SYSTEM_PREFIX_PATH="${cmake.install_prefix}"

    package.flat            no
} else {
    cmake.install_prefix    ${prefix}/libexec/${name}

    configure.pre_args-replace \
                            {*}[cmake::system_prefix_path] \
                            -DCMAKE_SYSTEM_PREFIX_PATH="${cmake.install_prefix}\;/usr"
}

configure.pre_args-delete   {*}[cmake::module_path]

configure.pre_args-delete   {*}[cmake::ccaching]

# Shared by both subports: this is what defines __config_site, so it must
# stay identical for the headers and the libraries.
configure.args-append       -DCMAKE_LIBTOOL=/usr/bin/libtool \
                            -DLIBCXX_CXX_ABI=libcxxabi \
                            -DLIBCXX_ENABLE_FILESYSTEM=ON \
                            -DLIBCXX_ENABLE_SHARED=ON \
                            -DLIBCXX_ENABLE_STATIC=ON \
                            -DLIBCXX_ENABLE_TIME_ZONE_DATABASE=OFF \
                            -DLIBCXX_ENABLE_VENDOR_AVAILABILITY_ANNOTATIONS=OFF \
                            -DLIBCXX_HARDENING_MODE=none \
                            -DLIBCXX_INCLUDE_BENCHMARKS=OFF \
                            -DLIBCXX_INCLUDE_DOCS=OFF \
                            -DLIBCXX_INCLUDE_TESTS=OFF \
                            -DLIBCXX_INSTALL_MODULES=OFF \
                            -DLIBCXX_USE_COMPILER_RT=OFF \
                            -DLIBCXXABI_ENABLE_SHARED=ON \
                            -DLIBCXXABI_ENABLE_STATIC=ON \
                            -DLIBCXXABI_INCLUDE_TESTS=OFF \
                            -DLIBCXXABI_USE_COMPILER_RT=OFF \
                            -DLIBCXXABI_USE_LLVM_UNWINDER=OFF \
                            -DLLVM_ENABLE_RUNTIMES="libcxxabi\;libcxx" \
                            -DLLVM_INCLUDE_DOCS=OFF \
                            -DLLVM_INCLUDE_TESTS=OFF \
                            -DPython3_EXECUTABLE=${prefix}/bin/python${py_ver}

# Run the compiler under arch(8) so that universal builds get the right slice
# (and on PowerPC hosts a translated gcc16, if that is what is installed).
# Leopard is the first macOS which has the arch command with Rosetta.
# See: https://trac.macports.org/ticket/67284
if {${os.major} > 8} {
    pre-configure {
        file mkdir ${workpath}/bins

        set gcc [open "${workpath}/bins/gcc" w 0755]
        puts ${gcc} "#!/bin/sh"
        puts ${gcc} "arch -arch $\{BUILD_ARCH:-${build_arch}\} ${libcxx_cc} \"\$@\""
        close ${gcc}

        set gxx [open "${workpath}/bins/g++" w 0755]
        puts ${gxx} "#!/bin/sh"
        puts ${gxx} "arch -arch $\{BUILD_ARCH:-${build_arch}\} ${libcxx_cxx} \"\$@\""
        close ${gxx}
    }
    configure.cc            ${workpath}/bins/gcc
    configure.cxx           ${workpath}/bins/g++
} else {
    configure.cc            ${libcxx_cc}
    configure.cxx           ${libcxx_cxx}
}

if {${subport} eq ${headers_subport}} {
    # Only generate and install the headers; the libraries are never built.
    # The generated headers do not depend on the architecture.
    supported_archs         noarch
    universal_variant       no

    build.target            generate-cxx-headers generate-cxxabi-headers

    destroot {
        foreach component {cxx-headers cxxabi-headers} {
            system -W ${cmake.build_dir} "env DESTDIR=${destroot} ${configure.cmd} --install . --component ${component}"
        }
    }
} else {
    depends_lib-append      port:${headers_subport}

    # The headers come from ${headers_subport}.
    configure.args-append   -DLIBCXX_INSTALL_HEADERS=OFF \
                            -DLIBCXXABI_INSTALL_HEADERS=OFF

    if {[variant_isset default_runtime]} {
        # A runtime in /usr/lib must not depend on anything in ${prefix}, so
        # the libraries are linked without libgcc_s. That is safe here: the
        # unwinder is the system's (libSystem since 10.6, libgcc_s.1 on 10.5),
        # GCC's libgcc_s.1.1 carries none, so libc++abi binds _Unwind_* to the
        # system anyway, and neither library uses emulated TLS. All libc++
        # takes from libgcc is __divdi3/__udivdi3, linked statically from
        # libgcc.a. -static-libgcc would not do: for deployment targets up to
        # 10.6 it adds libgcc_eh.a, i.e. a second unwinder and a second
        # emulated TLS. -nodefaultlibs also drops the driver's -lSystem (and,
        # before 10.7, -lSystemStubs, which on PowerPC provides the $LDBLStub
        # entry points of the 128-bit long double printf family), so those
        # are named explicitly. With +libsupcxx the static libsupc++.a needs
        # emulated TLS for its exception globals; libemutls_w.a is GCC's copy
        # for exactly this case, with weak definitions so that dyld merges it
        # with libgcc_s should both end up in one process. The driver adds
        # -rpath ${prefix}/lib/libgcc to everything it links, hence
        # -nodefaultrpaths.
        if {${os.major} < 11} {
            set system_libs     SystemStubs\;System
        } else {
            set system_libs     System
        }
        if {[vercmp ${macosx_deployment_target} 10.6] < 0} {
            # Before 10.6 the unwinder lives in Apple's libgcc_s, not in
            # libSystem; the driver links it as -lgcc_s.10.5 (-lgcc_s.10.4 for
            # 10.4) for such targets, which resolves to /usr/lib/libgcc_s.1.dylib.
            if {[vercmp ${macosx_deployment_target} 10.5] < 0} {
                set system_libs gcc_s.10.4\;${system_libs}
            } else {
                set system_libs gcc_s.10.5\;${system_libs}
            }
        }
        if {[variant_isset libsupcxx]} {
            set system_libs     emutls_w\;${system_libs}
        }
        configure.args-append   -DCMAKE_SHARED_LINKER_FLAGS="-nodefaultlibs -nodefaultrpaths" \
                                -DLIBCXX_ADDITIONAL_LIBRARIES="${system_libs}" \
                                -DLIBCXX_HAS_GCC_LIB=ON \
                                -DLIBCXX_HAS_GCC_S_LIB=OFF \
                                -DLIBCXXABI_ADDITIONAL_LIBRARIES="${system_libs}"
                                -DLIBCXXABI_HAS_GCC_S_LIB=OFF
    } else {
        # Runtime libraries of GCC: libgcc_s (__divdi3 and friends on ppc32,
        # emulated TLS for libsupc++) and libatomic, if patch 0009 links it.
        depends_lib-append  path:share/doc/libgcc/README:libgcc
    }

    variant libsupcxx description "Use GCC's C++ ABI runtime (libsupc++) instead of libc++abi" { }

    if {[variant_isset libsupcxx]} {
        # This is inherited from libgcc:
        depends_lib-append      port:libiconv

        # libc++ on GCC's own C++ ABI runtime, the mirror image of Apple's
        # 10.7 arrangement where libstdc++ and libc++ shared libc++abi. The
        # runtime comes from libstdc++.6.dylib of gcc16, i.e. the libsupc++
        # inside it, so exceptions, RTTI, std::exception, operator new and
        # __cxa_thread_atexit are the same objects for -stdlib=libc++ and
        # -stdlib=libstdc++ code in one process. libc++abi is not built. With
        # +default_runtime, which must not depend on ${prefix}, the static
        # libsupc++.a is linked into libc++ instead (a private copy, as with
        # libc++abi). Either way gcc16 links -stdlib=libc++ programs with
        # -lc++ -lc++abi, so a libc++abi.dylib pointing at the library which
        # holds the ABI runtime is installed. libstdc++ defines operator
        # new/delete already, so libc++ must not.
        configure.args-replace \
                            -DLLVM_ENABLE_RUNTIMES="libcxxabi\;libcxx" \
                            -DLLVM_ENABLE_RUNTIMES=libcxx
        configure.args-append \
                            -DLIBCXX_ENABLE_NEW_DELETE_DEFINITIONS=OFF
        if {[variant_isset default_runtime]} {
            configure.args-replace \
                            -DLIBCXX_CXX_ABI=libcxxabi \
                            -DLIBCXX_CXX_ABI=libsupc++
        } else {
            configure.args-replace \
                            -DLIBCXX_CXX_ABI=libcxxabi \
                            -DLIBCXX_CXX_ABI=libstdc++
        }

        pre-configure {
            # libc++ copies cxxabi.h and bits/c++config.h (and friends)
            # from the ABI library's include directories; take them
            # from the compiler's own search path.
            set dirs {}
            set inside 0
            catch {exec ${libcxx_cxx} -x c++ -E -v /dev/null 2>@1} out
            foreach line [split ${out} "\n"] {
                set line [string trim ${line}]
                if {[string match "#include <...> search starts here:" ${line}]} {
                    set inside 1
                    continue
                }
                if {[string match "End of search list." ${line}]} {
                    break
                }
                if {${inside} && ([file exists ${line}/cxxabi.h] || [file exists ${line}/bits/c++config.h])} {
                    lappend dirs ${line}
                }
            }
            if {[llength ${dirs}] < 2} {
                ui_error "could not find the libstdc++ headers of ${libcxx_cxx} (cxxabi.h, bits/c++config.h):\n${out}"
                return -code error "libstdc++ headers not found"
            }
            set abi_libdir [file dirname [exec ${libcxx_cxx} -print-file-name=libsupc++.a]]
            if {![string match "/*" ${abi_libdir}]} {
                return -code error "${libcxx_cxx} does not know where libsupc++.a is"
            }
            configure.args-append \
                            -DLIBCXX_CXX_ABI_INCLUDE_PATHS="[join ${dirs} "\;"]" \
                            -DLIBCXX_CXX_ABI_LIBRARY_PATH=${abi_libdir}
        }

        post-destroot {
            if {[variant_isset default_runtime]} {
                ln -s libc++.1.dylib ${destroot}${cmake.install_prefix}/lib/libc++abi.dylib
            } else {
                ln -s ${prefix}/lib/libgcc/libstdc++.6.dylib ${destroot}${cmake.install_prefix}/lib/libc++abi.dylib
            }
        }
    }

    post-destroot {
        # CMake sets the install names from CMAKE_INSTALL_NAME_DIR; this is only
        # a safety net in case something still refers to @rpath.
        foreach dylib {libc++.1.dylib libc++abi.1.dylib} {
            if {![file exists ${destroot}${cmake.install_prefix}/lib/${dylib}]} {
                continue
            }
            system "install_name_tool -id ${cmake.install_prefix}/lib/${dylib} ${destroot}${cmake.install_prefix}/lib/${dylib}"
            system "install_name_tool -change @rpath/libc++.1.dylib ${cmake.install_prefix}/lib/libc++.1.dylib ${destroot}${cmake.install_prefix}/lib/${dylib}"
            system "install_name_tool -change @rpath/libc++abi.1.dylib ${cmake.install_prefix}/lib/libc++abi.1.dylib ${destroot}${cmake.install_prefix}/lib/${dylib}"
        }
    }

    # Universal variant code is borrowed from clang-11-bootstrap port.
    if {[variant_exists universal] && [variant_isset universal]} {
        foreach arch ${universal_archs_supported} {
            lappend merger_configure_env(${arch}) BUILD_ARCH=${arch}
            lappend merger_build_env(${arch}) BUILD_ARCH=${arch}
        }
        merger_arch_flag    yes
        merger_arch_compiler \
                            yes
        merger_must_run_binaries \
                            yes
    }

    notes "
The libraries have been installed into ${cmake.install_prefix}/lib and the headers\
(including cxxabi.h) into ${cmake.install_prefix}/include/c++/v1 by ${headers_subport}.
gcc16 finds the headers there automatically with -stdlib=libc++ (it does not depend on\
this port, since this port is built with it)\; unless the libs are moved into\
${prefix}/lib or /usr/lib, ldflags should be set accordingly (-L${cmake.install_prefix}/lib).
On 32-bit PowerPC, std::atomic on 64-bit types still needs -latomic, as with libstdc++.
"

    if {[variant_isset libsupcxx]} {
        notes-append "
With +libsupcxx the C++ ABI runtime is GCC's: exceptions and RTTI interoperate with\
libstdc++ code in the same process, and -lc++abi resolves to the library holding it.
"
    }

    if {[variant_isset default_runtime]} {
        notes-append "
With +default_runtime the libraries depend on libSystem only: no libgcc_s and no rpath.
"

        post-destroot {
            # Nothing outside the base system may be referenced from /usr/lib.
            foreach dylib {libc++.1.dylib libc++abi.1.dylib} {
                set f ${destroot}${cmake.install_prefix}/lib/${dylib}
                if {![file exists ${f}] || [file type ${f}] eq "link"} {
                    continue
                }
                set deps [exec otool -L ${f}]
                set cmds [exec otool -l ${f}]
                if {[string match "*${prefix}/*" ${deps}] || [string match "*LC_RPATH*" ${cmds}]} {
                    ui_error "${dylib} depends on something under ${prefix} or carries an rpath:\n${deps}"
                    return -code error "${dylib} is not self-contained"
                }
            }
        }
    }
}

livecheck.type              none
