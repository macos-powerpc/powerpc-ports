github.tarball_from archive

# Install the V compiler as a separate distfile.
# Based on https://github.com/macports/macports-ports/blob/master/games/minetest/Portfile
# vc_commit must be the vlang/vc snapshot generated from this V release
# (its commit message references the `V ${version}` commit in vlang/v).
set vc_commit       7eb8c54a3843e5107d5af06d7a8c3e928f322475
set main_distfile   ${distfiles}
set vc_distfile     ${vc_commit}${extract.suffix}
set vc_mastersite   https://github.com/vlang/vc/archive

distfiles           ${main_distfile}:main \
                    ${vc_distfile}:vc

master_sites        ${github.master_sites}:main \
                    ${vc_mastersite}:vc

checksums           ${main_distfile} \
                    rmd160  f9f43f4a865631ba0729b9a87dd542b2584ed9e2 \
                    sha256  1a05f646fba9516ec6307979b282d0cc5327075bef268d40c0ca7d0b887e4f52 \
                    size    15945625 \
                    ${vc_distfile} \
                    rmd160  9b26f9f566dccce29b2f5afef7fb0ee3a08e7e36 \
                    sha256  255d5e999edf71dd2786c06a0fdcda47ecfd79d9fde3c9cf7548e36996284f45 \
                    size    3145077

depends_lib-append  port:boehmgc

# https://trac.macports.org/ticket/64913
if {${configure.build_arch} in [list ppc ppc64]} {
    configure.ldflags-append -latomic
}

# GCC sizes its garbage-collected heap from RAM, not from the address space:
# with 1 GB or more it lets the heap grow to twice the live data before
# collecting (--param ggc-min-expand defaults to 100). A 32-bit cc1 compiling
# the ~550k-line C file V generates for itself then dies at the 4 GB ceiling
# with "mmap(...) failed (error code=12)" / "cc1: out of memory". Collecting
# after 10% growth keeps the peak near the live data, for some extra time.
# -parallel-cc (below) now cuts that file into pieces, so this is extra
# margin at the price of compile time; drop it once a full build has passed.
if {${configure.build_arch} in [list ppc i386]} {
    configure.cflags-append --param ggc-min-expand=10
}

# A 32-bit Mach-O object cannot hold a section larger than 16 MB that has
# scattered relocation entries (their r_address field is 24 bits wide), and
# on ppc every reference from code to a local symbol - string literals,
# static data - is one. V's -prod build of itself is ~22 MB of ppc text in
# a single object, so cctools as dies with "Section too large, can't encode
# r_address (0x1515e08) into 24-bits of scattered relocation entry" after
# cc1 spent hours on it. -parallel-cc makes V split the generated C into
# several files and link their objects. It also drops -flto, which was
# doubling the work: GCC on Darwin has no linker plugin, so its LTO objects
# carry a complete native compile as well (that is what the assembler
# choked on), and the LTO link recompiles everything from bytecode anyway.
# Stock V takes both the number of files and the number of concurrent C
# compilers from VJOBS; patch-parallel-cc-files.diff adds V_PARALLEL_CC_FILES
# so a fine split does not multiply the peak memory. The unpatched vc
# snapshot (v1) only knows VJOBS, so v1 -> v2 is split ${build.jobs} ways;
# that stage has no GC pins and its text fit in one object before.
if {${configure.build_arch} in [list ppc ppc64 i386]} {
    set parallel_cc_vflag   -parallel-cc
    build.env-append        V_PARALLEL_CC_FILES=8
    pre-build {
        build.env-append    VJOBS=${build.jobs}
    }
} else {
    set parallel_cc_vflag   ""
}

# Path to V compiler
set vc_path ${worksrcpath}/vc

pre-patch {
    # Allows us to patch vc
    move ${workpath}/vc-${vc_commit} ${vc_path}
}

# ./thirdparty/stdatomic/nix/atomic.h:12:10: fatal error: 'stdatomic.h' file not found
# Based on cmus port: compatible compilers are Xcode > Xcode 7, clang > 3.7, and gcc > 4.8
compiler.c_standard 2011
compiler.blacklist-append {clang < 700} macports-clang-3.*

# Stop V from looking in Homebrew directories, and remove hardcoded MacPorts prefix.
# V has built-in font rendering, but users can optionally use freetype.
# patch-legacysupport-makefile.diff is unconditional: V's GNUmakefile clones and
# builds macports-legacy-support itself for Darwin <= 16, which conflicts with
# the legacysupport PortGroup and with the -cflags this port passes in VFLAGS.
# patch-bootstrap-std-gnu99.diff applies on top of it, so keep the order below.
patchfiles          patch-boehmgc-prefix.diff \
                    patch-freetype2-prefix.diff \
                    patch-legacysupport-makefile.diff \
                    patch-bootstrap-std-gnu99.diff \
                    patch-openssl-prefix.diff \
                    patch-pkgconfig-prefix.diff \
                    patch-postgresql-prefix.diff \
                    patch-final-gc-mode.diff \
                    patch-getline-ssize-t.diff \
                    patch-msg-nosignal.diff \
                    patch-no-clang-only-warning-flags.diff

# https://github.com/vlang/v/issues/28612
patchfiles-append   patch-stable-type-hash-cache.diff

patchfiles-append   patch-parallel-cc-files.diff \
                    patch-parallel-cc-gc-keepalive.diff

# See https://github.com/vlang/v/issues/6605
if {${os.major} <= [option legacysupport.newest_darwin_requires_legacy]} {
    # Use LegacySupport with the time module
    patchfiles-append patch-clock-gettime.diff
}

post-patch {
    # Disable vlang self update feature.
    copy -force ${filespath}/vup.v ${worksrcpath}/cmd/tools

    foreach f [list net/openssl/openssl.c.v fontstash/a_d_use_freetype.v db/pg/pg.c.v v/pkgconfig/pkgconfig.v builtin/builtin_d_gcboehm.c.v] {
        reinplace -W ${worksrcpath} "s|@PREFIX@|${prefix}|g" vlib/${f}
    }

    if {${os.major} <= [option legacysupport.newest_darwin_requires_legacy]} {
        reinplace "s|@PREFIX@|${prefix}|g" ${worksrcpath}/vlib/time/time_nix.c.v
    }
}

# -cg, -showcc and -show-c-output allows for better error debugging
# local prevents fetching the V compiler during the build
# https://github.com/vlang/v/issues/10796 - Set correct deployment target.

# The installed compiler needs a GC: built with -gc none it never frees,
# and compiling any sizeable project exhausts a 32-bit address space. Only
# the final stage gets it (FINAL_GC_VFLAG, from patch-final-gc-mode.diff):
# the bootstrap stages have no GC, and a GC-less v2 building V-with-boehm
# ran out of memory too, until patch-stable-type-hash-cache.diff.

# Every VFLAGS entry must be a single word without quotes or escapes. VFLAGS
# reaches V twice: make expands it into the recipe, where the shell parses that
# copy, and, as a command-line variable, exports it verbatim into the recipe's
# environment, where V reads it again and tokenizes it itself
# (vlib/v/util/vflags/vflags.v: whitespace-separated, quotes honoured,
# backslashes not). The former `-cflags [shellescape ${configure.cflags}]`
# became `-cflags -Os\ --param\ ggc-min-expand=10` there and v1 stopped with
# "Unknown argument `--param\`". It was redundant anyway: the makefile
# PortGroup exports CPPFLAGS and CFLAGS to make, and V's GNUmakefile passes them
# to every stage as -cflags "..." (BOOTSTRAP_VC_VFLAGS, BOOTSTRAP_VFLAGS).
build.args-append   local=true \
                    VFLAGS="-v -cg -showcc -show-c-output -prod ${parallel_cc_vflag} -cc ${configure.cc} -macosx-version-min ${macosx_deployment_target}" \
                    FINAL_GC_VFLAG="-gc boehm" \
                    VC=${vc_path}

pre-build {
    # V would create $VTMP itself with mode 0700 (os.v, create_folder_when_it_does_not_exist);
    # an existing directory is used as is, so create it readable for inspection.
    xinstall -d -m 0755 ${workpath}/vtmp ${workpath}/tmp
}

build.env-append    VTMP=${workpath}/vtmp \
                    TMPDIR=${workpath}/tmp

# When the C compiler fails, V regenerates the C with #line directives,
# recompiles it with the same command, then builds and runs its bug reporter
# to POST to bugs.vlang.io (vlib/v/builder/c_error_report.v). That doubles
# the cost of a failure and buries the real error under the reporter's own
# output; with it disabled the first error is the last thing in the log.
build.env-append    V_C_ERROR_BUG_REPORT_DISABLED=1

# See https://trac.macports.org/ticket/64913
# In case _developer group doesn't exist
add_users vlang group=_developer

destroot {
    set library_path ${destroot}${prefix}/lib/${name}
    set examples_path ${destroot}${prefix}/share/examples

    xinstall -d ${examples_path}
    move ${worksrcpath}/examples ${examples_path}/${name}

    xinstall -d ${library_path}
    foreach f {cmd thirdparty v v.mod vlib} {
        move ${worksrcpath}/${f} ${library_path}/${f}
    }

    ln -s ${prefix}/lib/${name}/v ${destroot}${prefix}/bin

    # Vlang compiles the subcommands in the tools dir on first runtime usage (e.g. v doctor).
    # Allow running Vlang to those in the _developer group, rather than running sudo each time.
    # See https://github.com/vlang/v/issues/10324

    # Majority of subcommands only require ${library_path}/cmd/tools to be writable but v self requires
    # all of ${library_path}

    fs-traverse item ${library_path} {
        file attributes ${item} -group _developer -permissions g+w
    }
}

# Delete leftover subcommands compiled during runtime
post-deactivate {
    delete ${prefix}/lib/${name}
}

# Based on various Android ports - don't make files world-writable.
# e.g. https://github.com/macports/macports-ports/blob/master/java/android/Portfile
notes "
The Vlang library directory is group _developer writable. You need to be a member\
of the _developer group to use Vlang. If you are not, run:

sudo dscl . append /Groups/_developer GroupMembership <username>

Optionally, to use the V PostgreSQL module, install PostgreSQL and set the POSTGRESQL_VERSION
environment variable. For PostgreSQL 14:

export POSTGRESQL_VERSION=14
"

# vlang also tags weekly snapshots (weekly.YYYY.WW); only track numbered releases
livecheck.regex     {archive/refs/tags/([0-9.]+)\.tar\.gz}
