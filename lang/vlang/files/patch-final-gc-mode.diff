Allow the final compiler to use a different GC mode than the bootstrap stages.

V's GNUmakefile passes $(VFLAGS) to both `v1 -> v2` and `v2 -> v`, so asking
for -gc boehm there forces the garbage-collector-less bootstrap compiler to
build V-with-boehm as well, which exhausts a 32-bit address space. Only the
installed compiler needs a GC. FINAL_GC_VFLAG is appended last, so it wins
over BOOTSTRAP_GC_VFLAG for that stage only.

--- GNUmakefile.original
+++ GNUmakefile
@@ -133,6 +133,8 @@
 BOOTSTRAP_VC_CCOMPILER_VFLAG :=
 POST_BOOTSTRAP_CCOMPILER_VFLAG :=
 BOOTSTRAP_GC_VFLAG :=
+# GC mode for the final compiler only; the bootstrap stages stay as they are.
+FINAL_GC_VFLAG ?=
 ifeq ($(filter -gc -gc=%,$(VFLAGS)),)
 	BOOTSTRAP_GC_VFLAG := -gc none
 endif
@@ -186,7 +188,7 @@
 ifdef NETBSD
 	paxctl +m v2$(EXE_EXT)
 endif
-	./v2$(EXE_EXT) -nocache -o $(VEXE)$(EXE_EXT) $(BOOTSTRAP_GC_VFLAG) $(VFLAGS) $(BOOTSTRAP_VFLAGS) cmd/v
+	./v2$(EXE_EXT) -nocache -o $(VEXE)$(EXE_EXT) $(BOOTSTRAP_GC_VFLAG) $(VFLAGS) $(BOOTSTRAP_VFLAGS) $(FINAL_GC_VFLAG) cmd/v
 ifdef NETBSD
 	paxctl +m $(VEXE)$(EXE_EXT)
 endif
