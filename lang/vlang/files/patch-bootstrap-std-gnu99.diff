Build the v1 bootstrap stage as gnu99 rather than strict c99.

On PowerPC, MacPorts selects a macports-gcc (the clangs are broken there), and
strict -std=c99 makes gcc define __STRICT_ANSI__, which restricts what the old
Darwin SDK headers expose. V used -std=gnu99 here until 0.5.x; gnu99 is a
superset of c99, so this cannot reject anything c99 would have accepted.

NOTE: applies on top of patch-legacysupport-makefile.diff; keep that one
earlier in `patchfiles`.

--- GNUmakefile.original
+++ GNUmakefile
@@ -178,7 +178,7 @@
 	$(RM) v1$(EXE_EXT)
 	$(RM) v2$(EXE_EXT)
 else
-	$(CC) $(CPPFLAGS) $(BOOTSTRAP_VC_CC_CFLAGS) -std=c99 -w -o v1$(EXE_EXT) $(VC)/$(VCFILE) -lm -lpthread $(BOOTSTRAP_LDFLAGS) || cmd/tools/cc_compilation_failed_non_windows.sh
+	$(CC) $(CPPFLAGS) $(BOOTSTRAP_VC_CC_CFLAGS) -std=gnu99 -w -o v1$(EXE_EXT) $(VC)/$(VCFILE) -lm -lpthread $(BOOTSTRAP_LDFLAGS) || cmd/tools/cc_compilation_failed_non_windows.sh
 ifdef NETBSD
 	paxctl +m v1$(EXE_EXT)
 endif
