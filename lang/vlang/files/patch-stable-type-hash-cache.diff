+	stable_type_symbol_hash_cache        shared map[ast.Type]u64 // concrete type -> stable_type_symbol_hash(); one map for all per-file Gens
 	unique_file_path_hash                u64 // a hash of file.path, used for making auxiliary fn generation unique (like `compare_xyz`)
 	fn_decl                              &ast.FnDecl = unsafe { nil } // pointer to the FnDecl we are currently inside otherwise 0
