Give the Boehm GC keepalive helpers external linkage under -parallel-cc.

A -prod build with the Boehm GC pins the pointer-carrying locals of a scope
around every call statement, collecting them through one generated
__v_boehm_collect_keepalive_<hash>_<type> helper per type. cgen writes those
helpers as `static inline`: the prototype into the shared header (out.h), the
body into the auto-functions block, which -parallel-cc places in out_0.c
only. Every other out_N.c then calls a static function it has no body for,
which the C compiler turns into a reference to an undefined symbol, and the
link fails with "Undefined symbols for architecture ppc:
___v_boehm_collect_keepalive_..._v__ast__SumType, referenced from: ... in
out_1.o". Upstream does not see it: its -parallel-cc CI builds use -gc none
without -prod, so no pins are generated. Builds without -parallel-cc keep the
`static inline` helpers.

--- vlib/v/gen/c/cgen.v.original
+++ vlib/v/gen/c/cgen.v
@@ -8709,9 +8709,15 @@
 	if !should_generate {
 		return fn_name
 	}
-	g.definitions.writeln('static inline int ${fn_name}(${styp}* it, voidptr* out, int idx);')
+	// The helper bodies (g.auto_fn_definitions) are written out once and,
+	// under -parallel-cc, into out_0.c only, while the functions that call them
+	// are spread over out_1..N.c. There they need external linkage: with a
+	// `static inline` prototype in out.h, every other object ends up referencing
+	// a symbol nothing defines and the link fails.
+	fn_mod := if g.pref.parallel_cc { '' } else { 'static inline ' }
+	g.definitions.writeln('${fn_mod}int ${fn_name}(${styp}* it, voidptr* out, int idx);')
 	mut sb := strings.new_builder(256)
-	sb.writeln('static inline int ${fn_name}(${styp}* it, voidptr* out, int idx) {')
+	sb.writeln('${fn_mod}int ${fn_name}(${styp}* it, voidptr* out, int idx) {')
 	match sym.kind {
 		.string {
 			sb.writeln('\tif (it->str != 0) {')
