From 6de2f1390fed9e9eb5c58ff7ceb2669f9ecff79e Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:42:11 +0000
Subject: [PATCH 25/60] port: embedded-file-writer-mac support powerpc

12.4 re-derivation of the 9.4-series patch 0010: teach the Mach-O
embedded.S writer the classic-cctools dialect used when mksnapshot
runs on a PowerPC Mac (host == target on the G5): .globl instead of
.private_extern (following AIX), .align with power-of-two exponents
instead of .balign, ';' comments, .line/.file instead of .loc, kLong
byte chunks (fixed 4-byte instruction stream), and no .octa.

Drift since 9.4 was confined to one hunk: AlignToCodeAlignment grew an
x64/ppc64/arm64 ladder (the __POWERPC__ case slots in before the
generic .balign 32 fallback), AlignToDataAlignment asserts against
InstructionStream::kMetadataAlignment now, and STATIC_ASSERT became
static_assert.  The other four hunks applied as-is.
---
 .../platform-embedded-file-writer-mac.cc      | 45 ++++++++++++++++++-
 .../platform-embedded-file-writer-mac.h       |  5 +++
 2 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.cc b/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.cc
index af87bd1..059c9f5 100644
--- a/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.cc
+++ b/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.cc
@@ -19,10 +19,16 @@ const char* DirectiveAsString(DataDirective directive) {
       return ".long";
     case kQuad:
       return ".quad";
+#ifndef __POWERPC__
     case kOcta:
       return ".octa";
   }
   UNREACHABLE();
+#else
+    default:
+      UNREACHABLE();
+  }
+#endif
 }
 
 }  // namespace
@@ -43,11 +49,16 @@ void PlatformEmbeddedFileWriterMac::DeclareUint32(const char* name,
 }
 
 void PlatformEmbeddedFileWriterMac::DeclareSymbolGlobal(const char* name) {
+#ifdef __POWERPC__
+  // Follow AIX here.
+  fprintf(fp_, ".globl _%s\n", name);
+#else
   // TODO(jgruber): Investigate switching to .globl. Using .private_extern
   // prevents something along the compilation chain from messing with the
   // embedded blob. Using .global here causes embedded blob hash verification
   // failures at runtime.
   fprintf(fp_, ".private_extern _%s\n", name);
+#endif
 }
 
 void PlatformEmbeddedFileWriterMac::AlignToCodeAlignment() {
@@ -64,6 +75,11 @@ void PlatformEmbeddedFileWriterMac::AlignToCodeAlignment() {
   // ARM64 macOS has a 16kiB page size. Since we want to remap it on the heap,
   // needs to be page-aligned.
   fprintf(fp_, ".balign 16384\n");
+#elif defined(__POWERPC__)
+  // The classic cctools assembler has no .balign; .align takes the
+  // power-of-two exponent.
+  static_assert(32 >= kCodeAlignment);
+  fprintf(fp_, ".align 5\n");
 #else
   static_assert(32 >= kCodeAlignment);
   fprintf(fp_, ".balign 32\n");
@@ -81,11 +97,19 @@ void PlatformEmbeddedFileWriterMac::AlignToPageSizeIfNeeded() {
 
 void PlatformEmbeddedFileWriterMac::AlignToDataAlignment() {
   static_assert(8 >= InstructionStream::kMetadataAlignment);
+#ifdef __POWERPC__
+  fprintf(fp_, ".align 3\n");
+#else
   fprintf(fp_, ".balign 8\n");
+#endif
 }
 
 void PlatformEmbeddedFileWriterMac::Comment(const char* string) {
+#ifdef __POWERPC__
+  fprintf(fp_, "; %s\n", string);
+#else
   fprintf(fp_, "// %s\n", string);
+#endif
 }
 
 void PlatformEmbeddedFileWriterMac::DeclareLabel(const char* name) {
@@ -94,14 +118,17 @@ void PlatformEmbeddedFileWriterMac::DeclareLabel(const char* name) {
 
 void PlatformEmbeddedFileWriterMac::SourceInfo(int fileid, const char* filename,
                                                int line) {
+#ifdef __POWERPC__
+  fprintf(fp_, ".line %d, \"%s\"\n", line, filename);
+#else
   fprintf(fp_, ".loc %d %d\n", fileid, line);
+#endif
 }
 
 // TODO(mmarchini): investigate emitting size annotations for OS X
 void PlatformEmbeddedFileWriterMac::DeclareFunctionBegin(const char* name,
                                                          uint32_t size) {
   DeclareLabel(name);
-
   // TODO(mvstanton): Investigate the proper incantations to mark the label as
   // a function on OSX.
 }
@@ -122,5 +149,21 @@ int PlatformEmbeddedFileWriterMac::IndentedDataDirective(
   return fprintf(fp_, "  %s ", DirectiveAsString(directive));
 }
 
+#ifdef __POWERPC__
+
+DataDirective PlatformEmbeddedFileWriterMac::ByteChunkDataDirective() const {
+  // PPC uses a fixed 4 byte instruction set, using .long
+  // to prevent any unnecessary padding.
+  return kLong;
+}
+
+int PlatformEmbeddedFileWriterMac::WriteByteChunk(const uint8_t* data) {
+  DCHECK_EQ(ByteChunkDataDirective(), kLong);
+  const uint32_t* long_ptr = reinterpret_cast<const uint32_t*>(data);
+  return HexLiteral(*long_ptr);
+}
+
+#endif // __POWERPC__
+
 }  // namespace internal
 }  // namespace v8
diff --git a/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.h b/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.h
index ce0bf1e..5343dd3 100644
--- a/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.h
+++ b/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.h
@@ -45,6 +45,11 @@ class PlatformEmbeddedFileWriterMac : public PlatformEmbeddedFileWriterBase {
 
   int IndentedDataDirective(DataDirective directive) override;
 
+#ifdef __POWERPC__
+  DataDirective ByteChunkDataDirective() const override;
+  int WriteByteChunk(const uint8_t* data) override;
+#endif
+
  private:
   const EmbeddedTargetArch target_arch_;
   const EmbeddedTargetOs target_os_;
-- 
