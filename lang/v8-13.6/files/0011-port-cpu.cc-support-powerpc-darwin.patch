From b1bd6f015bad92025c45f9242cdb7f10106b103c Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:34:19 +0000
Subject: [PATCH 11/60] port: cpu.cc-support-powerpc-darwin

[Re-anchored onto 12.4 from the 9.4 series; hunks applied without modification.]

Amended 2026-11-12 (found by the 14.6 G5 cycle, parade #5): the host_info
block was added inside upstream's `#elif V8_HOST_ARCH_PPC64` section, so
on the 32-bit host it never compiled and CPU::part_ stayed 0, which this
tree's enum reads as kPPCPower8 (14.6's as kPPCPower9, where the misread
enabled modsw/moduw and wasm SIMD on the G5). At 13.6 nothing but the
--print-features output keys on PPC_8_PLUS. The section gate now includes
V8_HOST_ARCH_PPC.

Assisted-by: Claude Fable 5.1
---
 v8/src/base/cpu.cc | 30 ++++++++++++++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/v8/src/base/cpu.cc b/v8/src/base/cpu.cc
index 8d868aa..66802a8 100644
--- a/v8/src/base/cpu.cc
+++ b/v8/src/base/cpu.cc
@@ -38,6 +38,15 @@
 #if V8_OS_DARWIN
 #include <sys/sysctl.h>  // sysctlbyname
 #endif
+#if V8_OS_MACOSX
+#include <sys/sysctl.h>  // sysctlbyname
+#if V8_HOST_ARCH_PPC || V8_HOST_ARCH_PPC64
+#include <mach/mach.h>
+#include <mach/mach_host.h>
+#include <mach/host_info.h>
+#include <mach/machine.h>
+#endif
+#endif
 #if V8_OS_POSIX
 #include <unistd.h>  // sysconf()
 #endif
@@ -903,7 +912,7 @@ CPU::CPU()
 #endif  // V8_OS_IOS
 #endif  // V8_OS_WIN
 
-#elif V8_HOST_ARCH_PPC64
+#elif V8_HOST_ARCH_PPC || V8_HOST_ARCH_PPC64
 
 #ifndef USE_SIMULATOR
 #if V8_OS_LINUX
@@ -955,7 +964,24 @@ CPU::CPU()
       part_ = kPPCPower8;
       break;
   }
-#endif  // V8_OS_AIX
+
+#elif V8_OS_MACOSX
+
+struct host_basic_info host_basic_info;
+  switch(host_basic_info.cpu_subtype) {
+    case CPU_SUBTYPE_POWERPC_970:
+    default:
+      part_ = kPPCG5;
+      break;
+    case CPU_SUBTYPE_POWERPC_7450:
+      part_ = kPPCG4;
+      break;
+    case CPU_SUBTYPE_POWERPC_7400:
+      part_ = kPPCG4;
+      break;
+   }
+
+#endif  // V8_OS_MACOSX
 #endif  // !USE_SIMULATOR
 
 #elif V8_HOST_ARCH_RISCV64
