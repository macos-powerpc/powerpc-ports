From 4563023b188e86faee411a691ba3e336fc32c6c1 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:45:01 +0000
Subject: [PATCH 29/60] ppc32: avoid fcfids in int-to-float conversions
 (POWER7+)

12.4 re-derivation of the 9.4-series patch 0021, identical in content
(only the TurboAssembler->MacroAssembler merge moved the context):
fcfids is ISA 2.06, absent on G4/G5.  fcfid is exact for any int32 and
frsp performs the single correctly-rounded narrowing, so the pair
produces the same result.

Note: this file still requires a 64-bit FPU (fcfid/fctidz), i.e. G5 as
minimum silicon; G4/G3 support would need the manual bit-twiddling
conversion paths from the Rockwell ppc32 lineage.
---
 v8/src/codegen/ppc/macro-assembler-ppc.cc | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index 79409ad..f0dca0f 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -1352,13 +1352,25 @@ void MacroAssembler::ConvertUnsignedIntToDouble(Register src,
 
 void MacroAssembler::ConvertIntToFloat(Register src, DoubleRegister dst) {
   MovIntToDouble(dst, src, r0);
+#if V8_TARGET_ARCH_PPC64
   fcfids(dst, dst);
+#else
+  // fcfids is ISA 2.06 (POWER7+), absent on G4/G5. fcfid is exact for any
+  // int32, and frsp then rounds once to single precision -- same result.
+  fcfid(dst, dst);
+  frsp(dst, dst);
+#endif
 }
 
 void MacroAssembler::ConvertUnsignedIntToFloat(Register src,
                                                DoubleRegister dst) {
   MovUnsignedIntToDouble(dst, src, r0);
+#if V8_TARGET_ARCH_PPC64
   fcfids(dst, dst);
+#else
+  fcfid(dst, dst);
+  frsp(dst, dst);
+#endif
 }
 
 #if V8_TARGET_ARCH_PPC64
