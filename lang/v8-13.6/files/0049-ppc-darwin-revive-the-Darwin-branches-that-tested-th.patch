From e2371747fadfe712412706cabc478dc159914e32 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 17:55:16 +0000
Subject: [PATCH 49/60] ppc-darwin: revive the Darwin branches that tested the
 pre-10.x V8_OS_MACOSX

V8 renamed V8_OS_MACOSX to V8_OS_DARWIN (plus V8_OS_MACOS for the non-iOS
subset) after 9.4.  The 12.4 series re-anchored the 9.4-era patches
"without modification", so three of them kept testing the old name, and
every branch behind it was dead in the validated 12.4 build:

- src/base/cpu.cc (patches "cpu.cc: support powerpc darwin" and "base/cpu:
  actually query host_info"): the mach includes and the host_info CPU
  subtype probe.  Never compiled since 9.4 - it also assigns kPPCG4/kPPCG5,
  which no base/cpu.h after 9.4 declares.  Both fixed: V8_OS_DARWIN, and the
  two enumerators added to the PPC part codes.  Behaviour on the G5 does not
  change: CpuFeatures::ProbeImpl only acts on POWER8/9/10 parts, so a G4/G5
  part code sets no feature bit (as the garbage/default part did before).
- src/codegen/ppc/constants-ppc.h ("port: amend-constants-ppc"):
  ABI_PASSES_HANDLES_IN_REGS on Darwin.  Only the simulator reads it;
  spelled V8_OS_DARWIN so the file states what 9.4 validated.
- src/codegen/ppc/cpu-ppc.cc ("use sys_icache_invalidate on Darwin") was
  fixed at its rebase stop: at 13.6 the generic FlushICache is a single
  icbi (POWER6+ coherent-cache assumption), so a dead Darwin branch would
  have left G4/G5 JIT code unflushed; the 12.4 build survived because 12.4's
  generic path still looped over 128-byte lines, the G5's line size.

No other V8_OS_MACOSX user remains in the tree.
---
 v8/src/base/cpu.cc                 | 6 +++---
 v8/src/base/cpu.h                  | 6 ++++--
 v8/src/codegen/ppc/constants-ppc.h | 2 +-
 3 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/v8/src/base/cpu.cc b/v8/src/base/cpu.cc
index 0d7c2f0..f0ff65a 100644
--- a/v8/src/base/cpu.cc
+++ b/v8/src/base/cpu.cc
@@ -38,7 +38,7 @@
 #if V8_OS_DARWIN
 #include <sys/sysctl.h>  // sysctlbyname
 #endif
-#if V8_OS_MACOSX
+#if V8_OS_DARWIN
 #include <sys/sysctl.h>  // sysctlbyname
 #if V8_HOST_ARCH_PPC || V8_HOST_ARCH_PPC64
 #include <mach/mach.h>
@@ -965,7 +965,7 @@ CPU::CPU()
       break;
   }
 
-#elif V8_OS_MACOSX
+#elif V8_OS_DARWIN
 
   host_basic_info_data_t hbi = {};
   mach_msg_type_number_t count = HOST_BASIC_INFO_COUNT;
@@ -984,7 +984,7 @@ CPU::CPU()
       break;
   }
 
-#endif  // V8_OS_MACOSX
+#endif  // V8_OS_DARWIN
 #endif  // !USE_SIMULATOR
 
 #elif V8_HOST_ARCH_RISCV64
diff --git a/v8/src/base/cpu.h b/v8/src/base/cpu.h
index 82909f0..19f2aba 100644
--- a/v8/src/base/cpu.h
+++ b/v8/src/base/cpu.h
@@ -63,8 +63,10 @@ class V8_BASE_EXPORT CPU final {
   // Denver-specific part code
   static const int kNvidiaDenverV10 = 0x002;
 
-  // PPC-specific part codes
-  enum { kPPCPower8, kPPCPower9, kPPCPower10 };
+  // PPC-specific part codes.  kPPCG4/kPPCG5 are what the Darwin host_info
+  // probe reports for the 32-bit-era cores; nothing in CpuFeatures::ProbeImpl
+  // keys on them (POWER8 and later are the only probed features).
+  enum { kPPCPower8, kPPCPower9, kPPCPower10, kPPCG4, kPPCG5 };
 
   // General features
   bool has_fpu() const { return has_fpu_; }
diff --git a/v8/src/codegen/ppc/constants-ppc.h b/v8/src/codegen/ppc/constants-ppc.h
index 0208be9..a1d4257 100644
--- a/v8/src/codegen/ppc/constants-ppc.h
+++ b/v8/src/codegen/ppc/constants-ppc.h
@@ -30,7 +30,7 @@
 #endif
 
 #if !(V8_HOST_ARCH_PPC || V8_HOST_ARCH_PPC64) || V8_OS_AIX || \
-    V8_TARGET_ARCH_PPC64 || V8_OS_MACOSX
+    V8_TARGET_ARCH_PPC64 || V8_OS_DARWIN
 #define ABI_PASSES_HANDLES_IN_REGS 1
 #else
 #define ABI_PASSES_HANDLES_IN_REGS 0
-- 
2.43.0

