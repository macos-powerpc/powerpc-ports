From ee13bb0b5b3d8a1ef18f02d490b0e76cce24b8f4 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 17:41:06 +0000
Subject: [PATCH 14/60] ppc: use sys_icache_invalidate for icache flush on
 Darwin
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The generic flush loop relies on a runtime icache line size probe that
has no Darwin implementation, so it would assume 128-byte lines —
correct on G5 only by coincidence, and silently skipping 3/4 of the
lines on G4 (32-byte lines). sys_icache_invalidate (10.5+) goes through
the commpage routine, which reads the per-CPU cache line size. Same fix
as nodejs12 ppc-darwin patch 0016; the OS::DebugBreak half of that fix
is already covered by patch 0007 here, and Assembler::bkpt already
emits twge r2,r2 (0x7D821008) upstream in 8.3.

[Re-anchored onto 12.4 from the 9.4 series; hunks applied without modification.]

13.6 rebase: the guard is V8_OS_DARWIN.  V8 renamed V8_OS_MACOSX to V8_OS_DARWIN/V8_OS_MACOS after 9.4, so the 12.4 re-anchoring of this patch (and of the 9.4 cpu.cc and constants-ppc.h patches) left its Darwin branch dead - the generic icbi path ran on the G5 instead, correct there only because of its 128-byte lines.  At 13.6 the generic path is a single icbi (POWER6+ coherent caches assumed), which no G3/G4/G5 can live with, so this branch has to be live.
---
 v8/src/codegen/ppc/cpu-ppc.cc | 46 +++++++++++++++++++++++++++++------
 1 file changed, 39 insertions(+), 7 deletions(-)

diff --git a/v8/src/codegen/ppc/cpu-ppc.cc b/v8/src/codegen/ppc/cpu-ppc.cc
index d599e7d..dadeea6 100644
--- a/v8/src/codegen/ppc/cpu-ppc.cc
+++ b/v8/src/codegen/ppc/cpu-ppc.cc
@@ -8,18 +8,50 @@
 
 #include "src/codegen/cpu-features.h"
 
+#if V8_OS_DARWIN
+#include <libkern/OSCacheControl.h>  // sys_icache_invalidate, 10.5+
+#endif
+
+#define INSTR_AND_DATA_CACHE_COHERENCY PPC_6_PLUS
+
 namespace v8 {
 namespace internal {
 
 void CpuFeatures::FlushICache(void* buffer, size_t size) {
 #if !defined(USE_SIMULATOR)
-  __asm__ __volatile__(
-      "sync \n"
-      "icbi 0, %0  \n"
-      "isync  \n"
-      : /* no output */
-      : "r"(buffer)
-      : "memory");
+#if V8_OS_DARWIN
+  // Let libSystem pick the cache line size: the runtime probe below has no
+  // Darwin implementation and would assume 128-byte lines, which is wrong
+  // on G4 (32-byte lines). The commpage routine also dispatches per-CPU.
+  sys_icache_invalidate(buffer, size);
+#else
+  if (CpuFeatures::IsSupported(INSTR_AND_DATA_CACHE_COHERENCY)) {
+    __asm__ __volatile__(
+        "sync \n"
+        "icbi 0, %0  \n"
+        "isync  \n"
+        : /* no output */
+        : "r"(buffer)
+        : "memory");
+    return;
+  }
+
+  const int kCacheLineSize = CpuFeatures::icache_line_size();
+  intptr_t mask = kCacheLineSize - 1;
+  uint8_t* start =
+      reinterpret_cast<uint8_t*>(reinterpret_cast<intptr_t>(buffer) & ~mask);
+  uint8_t* end = static_cast<uint8_t*>(buffer) + size;
+  for (uint8_t* pointer = start; pointer < end; pointer += kCacheLineSize) {
+    __asm__(
+        "dcbf 0, %0  \n"
+        "sync        \n"
+        "icbi 0, %0  \n"
+        "isync       \n"
+        : /* no output */
+        : "r"(pointer));
+  }
+
+#endif  // V8_OS_DARWIN
 #endif  // !USE_SIMULATOR
 }
 }  // namespace internal
