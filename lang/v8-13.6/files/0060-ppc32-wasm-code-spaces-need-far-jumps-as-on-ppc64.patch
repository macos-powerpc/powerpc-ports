From 50e57d2173c693893c6023bc175fb8696a3385c8 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 13:51:32 +0000
Subject: [PATCH 60/60] ppc32: wasm code spaces need far jumps, as on ppc64

The 32-bit ppc jump-table slots re-derived for 13.6 keep ppc64's
design: the near slot is one relative `b` (26 bits, +-32MB) that
falls back to a far-table slot when the target is out of range, the
far slot and the lazy-compile slot load their targets from their own
tails.  ppc64 therefore sets kNeedsFarJumpsBetweenCodeSpaces and caps
a code space at kDefaultMaxWasmCodeSpaceSizeMb = 32 ("branches only
take 26 bits"), so that every code space has jump tables within
branch range and FindJumpTablesForRegionLocked can tell when a region
needs its own.

Both lists named PPC64 only, so the restored 32-bit target ran with
the ia32/arm configuration: no far jumps, no per-function far slots,
a 1024 MB code-space cap, and FindJumpTablesForRegionLocked handing
the first code space's tables to every later region.  That holds only
while a module stays in one reservation within +-32MB of its jump
table: a module that grows a second code space elsewhere in the 4 GB
address space, or a code space larger than 32 MB, makes
EmitJumpSlot's relative branch unencodable with no far slot to fall
back to.  12.4 ran the same way; small modules never noticed.

Give ppc32 ppc64's configuration: V8_TARGET_ARCH_PPC in the
kNeedsFarJumpsBetweenCodeSpaces list and in the 32 MB cap, and drop
NewNativeModule's static_assert that tied the far-jump requirement to
a 64-bit pointer size - the comment anticipated the divergence, and
the reduced-estimate logic it guards is already keyed on the
requirement itself.  OverheadPerCodeSpace now counts the far jump
table per code space on ppc32 as it does on ppc64, which makes the
previous patch's one-time accounting compile out.

globals.h and wasm-code-manager.h are included widely: this lands at
the next clean build, not as an incremental delta.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 v8/src/common/globals.h          | 2 +-
 v8/src/wasm/wasm-code-manager.cc | 8 +++-----
 v8/src/wasm/wasm-code-manager.h  | 4 +++-
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/v8/src/common/globals.h b/v8/src/common/globals.h
index 25f9e2c..c7f6913 100644
--- a/v8/src/common/globals.h
+++ b/v8/src/common/globals.h
@@ -444,7 +444,7 @@ constexpr uint32_t kMaxCommittedWasmCodeMB = 4095;
 #if V8_TARGET_ARCH_ARM64 || V8_TARGET_ARCH_LOONG64
 // ARM64 and Loong64 only supports direct calls within a 128 MB range.
 constexpr uint32_t kDefaultMaxWasmCodeSpaceSizeMb = 128;
-#elif V8_TARGET_ARCH_PPC64
+#elif V8_TARGET_ARCH_PPC || V8_TARGET_ARCH_PPC64
 // Branches only take 26 bits.
 constexpr uint32_t kDefaultMaxWasmCodeSpaceSizeMb = 32;
 #else
diff --git a/v8/src/wasm/wasm-code-manager.cc b/v8/src/wasm/wasm-code-manager.cc
index 562b242..d08acfa 100644
--- a/v8/src/wasm/wasm-code-manager.cc
+++ b/v8/src/wasm/wasm-code-manager.cc
@@ -2474,11 +2474,9 @@ std::shared_ptr<NativeModule> WasmCodeManager::NewNativeModule(
   // a reduced code size estimate. This saves some precious address space at the
   // cost of needing more code spaces, but those are cheaper if they do not
   // result in more far jumps.
-  // For now it is the case that far jumps are only needed on 64-bit platforms,
-  // so those two conditions can be interchanged. Think about which logic to use
-  // once those diverge.
-  static_assert(NativeModule::kNeedsFarJumpsBetweenCodeSpaces ==
-                (kSystemPointerSize == kInt64Size));
+  // ppc32 is the 32-bit target that does need far jumps (26-bit relative near
+  // slots, as on ppc64), so the two conditions are not interchangeable: key
+  // the reduced estimate on the far-jump requirement itself.
   if constexpr (!NativeModule::kNeedsFarJumpsBetweenCodeSpaces) {
     code_size_estimate /= 2;
     // Without far jumps between code spaces the far jump table (one slot per
diff --git a/v8/src/wasm/wasm-code-manager.h b/v8/src/wasm/wasm-code-manager.h
index 49258f5..0f4cc18 100644
--- a/v8/src/wasm/wasm-code-manager.h
+++ b/v8/src/wasm/wasm-code-manager.h
@@ -581,7 +581,9 @@ class V8_EXPORT_PRIVATE NativeModule final {
 
 #if V8_TARGET_ARCH_X64 || V8_TARGET_ARCH_S390X || V8_TARGET_ARCH_ARM64 || \
     V8_TARGET_ARCH_PPC64 || V8_TARGET_ARCH_LOONG64 ||                     \
-    V8_TARGET_ARCH_RISCV64 || V8_TARGET_ARCH_MIPS64
+    V8_TARGET_ARCH_RISCV64 || V8_TARGET_ARCH_MIPS64 || V8_TARGET_ARCH_PPC
+  // ppc32: the near jump slot is the same 26-bit relative branch as on
+  // ppc64, so code spaces farther than +-32MB apart need the far table.
   static constexpr bool kNeedsFarJumpsBetweenCodeSpaces = true;
 #else
   static constexpr bool kNeedsFarJumpsBetweenCodeSpaces = false;
