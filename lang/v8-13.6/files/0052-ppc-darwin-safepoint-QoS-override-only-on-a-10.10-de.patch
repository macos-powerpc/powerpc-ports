From 2f146d9ccc5f149207dc5b070937f2009f738020 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 01:33:04 +0000
Subject: [PATCH 52/60] ppc-darwin: safepoint QoS override only on a 10.10+
 deployment target

First G5 cycle of the 13.6 port, parade #3 (every TU including
heap-inl.h):

  src/heap/safepoint.h:53:5: error: 'pthread_override_t' does not
  name a type; did you mean 'pthread_once_t'?

13.6 added --safepoint-bump-qos-class: while a safepoint is being
reached, V8_OS_DARWIN code raises the running threads' QoS with
pthread_override_qos_class_start_np so a USER_INTERACTIVE main thread
does not wait on BACKGROUND workers (priority inversion).  The
override API and pthread_override_t are 10.10 additions, absent from
the PowerPC-era SDKs.  Gate the three sites (the RunningLocalHeap
member, the start and end calls in safepoint.cc) on the deployment
target through one header-local macro, V8_SAFEPOINT_QOS_OVERRIDE,
tested the way 0048 tests the thread-priority QoS switch in
platform-posix.cc: __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__,
which the compiler always defines on Darwin, against 101000 (the
QOS_CLASS_* values are enum members, so defined() cannot see them).
On the PowerPC targets the flag stays defined and is a no-op, as it
is on every non-Darwin OS; a >= 10.10 build of the patched tree is
unchanged.
---
 v8/src/heap/safepoint.cc |  4 ++--
 v8/src/heap/safepoint.h  | 13 ++++++++++++-
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/v8/src/heap/safepoint.cc b/v8/src/heap/safepoint.cc
index aa83375..4ecc56c 100644
--- a/v8/src/heap/safepoint.cc
+++ b/v8/src/heap/safepoint.cc
@@ -147,7 +147,7 @@ void IsolateSafepoint::SetSafepointRequestedFlags(
         local_heap->state_.SetSafepointRequested();
 
     if (old_state.IsRunning()) {
-#if V8_OS_DARWIN
+#if V8_SAFEPOINT_QOS_OVERRIDE
       pthread_override_t qos_override = nullptr;
 
       if (v8_flags.safepoint_bump_qos_class) {
@@ -251,7 +251,7 @@ void IsolateSafepoint::Barrier::WaitUntilRunningThreadsInSafepoint(
   while (stopped_ < running_count) {
     cv_stopped_.Wait(&mutex_);
   }
-#if V8_OS_DARWIN
+#if V8_SAFEPOINT_QOS_OVERRIDE
   if (v8_flags.safepoint_bump_qos_class) {
     for (auto& running_local_heap : running_local_heaps) {
       CHECK_EQ(
diff --git a/v8/src/heap/safepoint.h b/v8/src/heap/safepoint.h
index 6f121ec..4644c6a 100644
--- a/v8/src/heap/safepoint.h
+++ b/v8/src/heap/safepoint.h
@@ -23,6 +23,17 @@ class LocalHeap;
 class PerClientSafepointData;
 class RootVisitor;
 
+// The per-thread QoS override API (pthread_override_qos_class_start_np)
+// appeared in 10.10; on the PowerPC-era SDKs there is nothing to bump and
+// --safepoint-bump-qos-class stays a no-op.  Gate on the deployment target
+// like platform-posix.cc does (the compiler always defines the macro on
+// Darwin; the QOS_CLASS_* values are enum members, invisible to defined()).
+#if V8_OS_DARWIN && (__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ >= 101000)
+#define V8_SAFEPOINT_QOS_OVERRIDE 1
+#else
+#define V8_SAFEPOINT_QOS_OVERRIDE 0
+#endif
+
 // Used to bring all threads with heap access in an isolate to a safepoint such
 // that e.g. a garbage collection can be performed.
 class IsolateSafepoint final {
@@ -49,7 +60,7 @@ class IsolateSafepoint final {
  private:
   struct RunningLocalHeap {
     LocalHeap* local_heap;
-#if V8_OS_DARWIN
+#if V8_SAFEPOINT_QOS_OVERRIDE
     pthread_override_t qos_override;
 #endif
   };
