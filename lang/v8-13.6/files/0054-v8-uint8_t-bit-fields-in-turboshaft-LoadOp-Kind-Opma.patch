From 8587e65e0345886d42750f57b6f99a345a11dc8c Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 05:49:58 +0000
Subject: [PATCH 54/60] v8: uint8_t bit-fields in turboshaft LoadOp::Kind
 (Opmask window)

G5 parade #5 (2026-10-27, instruction-selector-ppc.cc, the first TU to
include turboshaft/opmasks.h): opmasks.h:54/116 `offset + size <=
sizeof(uint64_t)` reduces to 9 <= 8 for
FIELD(Simd128LoadTransformOp, transform_kind), and every
kSimd128LoadTransform* alias then fails to form.

An Opmask compares the first 8 bytes of an operation, so every masked
field must end within that window.  Simd128LoadTransformOp is the
Operation header (4) + LoadOp::Kind load_kind + TransformKind
transform_kind.  Kind is seven bool:1 bit-fields: one byte upstream,
putting transform_kind at offset 5; on Darwin ppc32, where bool is 4
bytes and bit-fields are allocated in units of the declared type
(PCC_BITFIELD_TYPE_MATTERS), Kind is 4 bytes and transform_kind lands
at offset 8, outside the window.

Retype the seven bit-fields to uint8_t:1, the 0041 fix for
EffectDimensions/OpEffects.  uint8_t:1 packs identically to bool:1 on
every Itanium-ABI target, so nothing changes elsewhere; the fields are
read in boolean context, assigned true/false (designated initialisers
included), compared field-wise in operator==, shifted into an int in
hash_value (bool and uint8_t both promote to int), and streamed through
?: or if in operations.cc - identical 0/1 values either way.  StoreOp
and the SIMD load ops alias the same Kind.

0041's sweep had judged LoadOp::Kind safe because the struct itself
carries no bit_cast or sizeof contract; the contract is indirect - the
Opmask window of an op that embeds it.  Census of opmasks.h (every
MaskBuilder, 19 ops): Simd128LoadTransformOp is the only masked op
with a bool-bearing field ahead of a masked field; the others hold
enums, Representations, uint16_t or uint8_t only, so their masked
fields stay inside the window at a 4-byte bool as well.  No MaskBuilder
exists outside opmasks.h.  Audit rule from here on: a 4-byte bool
matters not only in size-asserted structs but wherever an offset
contract follows it.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 v8/src/compiler/turboshaft/operations.h | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/v8/src/compiler/turboshaft/operations.h b/v8/src/compiler/turboshaft/operations.h
index cabc7ee..24eb026 100644
--- a/v8/src/compiler/turboshaft/operations.h
+++ b/v8/src/compiler/turboshaft/operations.h
@@ -2863,17 +2863,22 @@ struct ConstantOp : FixedArityOperationT<0, ConstantOp> {
 // not decompress the value.
 struct LoadOp : OperationT<LoadOp> {
   struct Kind {
+    // uint8_t rather than bool bit-fields: Darwin/ppc32 has a 4-byte bool
+    // and allocates bit-fields in units of the declared type, which would
+    // make Kind 4 bytes and push the field that follows it in
+    // Simd128LoadTransformOp past the 8-byte Opmask window (opmasks.h).
+    // uint8_t:1 packs identically to bool:1 on all Itanium-ABI targets.
     // The `base` input is a tagged pointer to a HeapObject.
-    bool tagged_base : 1;
+    uint8_t tagged_base : 1;
     // The effective address might be unaligned. This is only set to true if
     // the platform does not support unaligned loads for the given
     // MemoryRepresentation natively.
-    bool maybe_unaligned : 1;
+    uint8_t maybe_unaligned : 1;
     // There is a Wasm trap handler for out-of-bounds accesses.
-    bool with_trap_handler : 1;
+    uint8_t with_trap_handler : 1;
     // The wasm trap handler is used for null accesses. Note that this requires
     // with_trap_handler as well.
-    bool trap_on_null : 1;
+    uint8_t trap_on_null : 1;
     // If {load_eliminable} is true, then:
     //   - Stores/Loads at this address cannot overlap. Concretely, it means
     //     that something like this cannot happen:
@@ -2902,11 +2907,11 @@ struct LoadOp : OperationT<LoadOp> {
     // In the main JS pipeline, only ArrayBuffers (= TypedArray/DataView)
     // loads/stores have this {load_eliminable} set to false,
     // and all other loads have it to true.
-    bool load_eliminable : 1;
+    uint8_t load_eliminable : 1;
     // The loaded value may not change.
-    bool is_immutable : 1;
+    uint8_t is_immutable : 1;
     // The load should be atomic.
-    bool is_atomic : 1;
+    uint8_t is_atomic : 1;
 
     static constexpr Kind Aligned(BaseTaggedness base_is_tagged) {
       switch (base_is_tagged) {
