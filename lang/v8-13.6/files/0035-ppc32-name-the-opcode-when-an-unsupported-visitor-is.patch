From df30e1e4165d69dd304854f91806aedd573b8c6f Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 22:48:48 +0000
Subject: [PATCH 35/60] ppc32: name the opcode when an unsupported visitor is
 reached

12.4 re-derivation of the 9.4-series patch 0036.  Far smaller here:
the 80 hand-written UNIMPLEMENTED() stubs of 9.4 are now generated by
the single VISIT_UNSUPPORTED_OP macro, and the macro knows the
operator name at preprocessing time, so the FATAL can print #op
directly -- no node->op()->mnemonic() call, which also sidesteps the
Turbofan/Turboshaft node_t difference.

Rationale unchanged (G5 error #11): mksnapshot dies during builtin
instruction selection with a bare 'unimplemented code' fatal --
release-mode UNIMPLEMENTED() carries no context, and the stubs are
inlined into VisitNode so the stack trace cannot identify the operator
either.  Costs nothing, keeps bring-up failures diagnosable in one run
instead of a bisection.
---
 v8/src/compiler/backend/instruction-selector.cc | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/v8/src/compiler/backend/instruction-selector.cc b/v8/src/compiler/backend/instruction-selector.cc
index 89adb9e..ce87aef 100644
--- a/v8/src/compiler/backend/instruction-selector.cc
+++ b/v8/src/compiler/backend/instruction-selector.cc
@@ -34,8 +34,13 @@ namespace v8 {
 namespace internal {
 namespace compiler {
 
-#define VISIT_UNSUPPORTED_OP(op) \
-  void InstructionSelectorT::Visit##op(OpIndex) { UNIMPLEMENTED(); }
+#define VISIT_UNSUPPORTED_OP(op)                                        \
+  void InstructionSelectorT::Visit##op(OpIndex) {                       \
+    /* Name the operator: release-mode UNIMPLEMENTED() carries no */    \
+    /* context and the stubs are inlined into VisitNode, so a bare */   \
+    /* fatal cannot be attributed to an opcode from the stack trace. */ \
+    FATAL("Unsupported operator: " #op);                                \
+  }
 
 using namespace turboshaft;  // NOLINT(build/namespaces)
 
