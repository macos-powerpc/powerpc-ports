From d984bfd32c53c5e25163ec9762297e15df98aaa2 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 17:12:07 +0000
Subject: [PATCH 02/60] abseil: darwin-ppc build fixes (copts, hwaes/simd
 detection, examine_stack)

The 20240722.0-era darwin-ppc set from macos-powerpc/powerpc-ports
(devel/abseil patch-darwin-ppc.diff at commit 8369f7df), which is the
right vintage for the absl HEAD 2024-03-11 that V8 12.4 vendors - the
port's current (20260817-era) reworked patch no longer fits this code.
Offsets regenerated; one fuzz-2 hunk (AbseilConfigureCopts.cmake)
re-anchored.  Content: keep x86/ARM crypto and SIMD copts away from
PowerPC (AbseilConfigureCopts.cmake is the live one for our CMake
build; copts.py/configure_copts.bzl are carried for parity with the
reviewed port set), fix randen hwaes detection and platform.h target
macros for powerpc-darwin, and unbreak examine_stack there.

Maintainer caveat on record: this era of the stack guarantees
building; correctness was less reviewed than the current port's.  Each
hunk is to be re-diffed against the port's 20260526 rework before the
port ships.

13.6 rebase (abseil fd39cfa4): the copts.py / configure_copts.bzl hunks are dropped - upstream removed the ABSL_RANDOM_RANDEN_COPTS select and the HWAES flag table they amended; neither file takes part in the CMake build (carried for parity with the port set only).  AbseilConfigureCopts.cmake, examine_stack.cc, platform.h and randen_detect.cc merged cleanly.
---
 .../absl/copts/AbseilConfigureCopts.cmake          |  6 ++++--
 .../absl/debugging/internal/examine_stack.cc       |  6 ++++++
 .../abseil-cpp/absl/random/internal/platform.h     | 14 ++++++++++----
 .../absl/random/internal/randen_detect.cc          |  7 +++++++
 4 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/v8/third_party/abseil-cpp/absl/copts/AbseilConfigureCopts.cmake b/v8/third_party/abseil-cpp/absl/copts/AbseilConfigureCopts.cmake
index f1d8b26..600dfde 100644
--- a/v8/third_party/abseil-cpp/absl/copts/AbseilConfigureCopts.cmake
+++ b/v8/third_party/abseil-cpp/absl/copts/AbseilConfigureCopts.cmake
@@ -52,13 +52,13 @@ if(APPLE AND CMAKE_CXX_COMPILER_ID MATCHES [[Clang]])
   if(ABSL_RANDOM_RANDEN_COPTS AND NOT ABSL_RANDOM_RANDEN_COPTS_WARNING)
     list(APPEND ABSL_RANDOM_RANDEN_COPTS "-Wno-unused-command-line-argument")
   endif()
-elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|amd64|AMD64")
+elseif(CMAKE_OSX_ARCHITECTURES MATCHES "x86_64|amd64|AMD64")
   if (MSVC)
     set(ABSL_RANDOM_RANDEN_COPTS "${ABSL_RANDOM_HWAES_MSVC_X64_FLAGS}")
   else()
     set(ABSL_RANDOM_RANDEN_COPTS "${ABSL_RANDOM_HWAES_X64_FLAGS}")
   endif()
-elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "arm.*|aarch64")
+elseif(CMAKE_OSX_ARCHITECTURES MATCHES "arm.*|aarch64")
   if (CMAKE_SIZEOF_VOID_P STREQUAL "8")
     set(ABSL_RANDOM_RANDEN_COPTS "${ABSL_RANDOM_HWAES_ARM64_FLAGS}")
   elseif(CMAKE_SIZEOF_VOID_P STREQUAL "4")
@@ -66,6 +66,8 @@ elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "arm.*|aarch64")
   else()
     message(WARNING "Value of CMAKE_SIZEOF_VOID_P (${CMAKE_SIZEOF_VOID_P}) is not supported.")
   endif()
+elseif(CMAKE_OSX_ARCHITECTURES MATCHES "ppc|ppc64")
+  set(ABSL_RANDOM_RANDEN_COPTS "${ABSL_RANDOM_HWAES_PPC_FLAGS}")
 else()
   set(ABSL_RANDOM_RANDEN_COPTS "")
 endif()
diff --git a/v8/third_party/abseil-cpp/absl/debugging/internal/examine_stack.cc b/v8/third_party/abseil-cpp/absl/debugging/internal/examine_stack.cc
index 3dd6ba1..ebe1248 100644
--- a/v8/third_party/abseil-cpp/absl/debugging/internal/examine_stack.cc
+++ b/v8/third_party/abseil-cpp/absl/debugging/internal/examine_stack.cc
@@ -226,6 +226,12 @@ void* GetProgramCounter(void* const vuc) {
 #else
     return reinterpret_cast<void*>(signal_ucontext->uc_mcontext->ss.rip);
 #endif
+#elif defined(__ppc__) || defined(__ppc64__)
+#if __DARWIN_UNIX03
+    return reinterpret_cast<void*>(signal_ucontext->uc_mcontext->__ss.__srr0);
+#else
+    return reinterpret_cast<void*>(signal_ucontext->uc_mcontext->ss.srr0);
+#endif
 #endif
   }
 #elif defined(__akaros__)
diff --git a/v8/third_party/abseil-cpp/absl/random/internal/platform.h b/v8/third_party/abseil-cpp/absl/random/internal/platform.h
index bd2993e..18f6a42 100644
--- a/v8/third_party/abseil-cpp/absl/random/internal/platform.h
+++ b/v8/third_party/abseil-cpp/absl/random/internal/platform.h
@@ -69,8 +69,8 @@
 #define ABSL_ARCH_AARCH64
 #elif defined(__arm__) || defined(__ARMEL__) || defined(_M_ARM)
 #define ABSL_ARCH_ARM
-#elif defined(__powerpc64__) || defined(__PPC64__) || defined(__powerpc__) || \
-    defined(__ppc__) || defined(__PPC__)
+#elif defined(__powerpc64__) || defined(__PPC64__) || defined(__ppc64__) || \
+     defined(__powerpc__) || defined(__PPC__) || defined(__ppc__)
 #define ABSL_ARCH_PPC
 #else
 // Unsupported architecture.
@@ -107,9 +107,11 @@
 
 #elif defined(ABSL_ARCH_PPC)
 
+#if defined(__APPLE__)
+#undef ABSL_HAVE_ACCELERATED_AES
+#define ABSL_HAVE_ACCELERATED_AES 0
 // Rely on VSX and CRYPTO extensions for vcipher on PowerPC.
-#if (defined(__VEC__) || defined(__ALTIVEC__)) && defined(__VSX__) && \
-    defined(__CRYPTO__)
+#elif (defined(__VEC__) || defined(__ALTIVEC__)) && defined(__VSX__) && defined(__CRYPTO__)
 #undef ABSL_HAVE_ACCELERATED_AES
 #define ABSL_HAVE_ACCELERATED_AES 1
 #endif
@@ -160,6 +162,10 @@
 // (This captures a lot of Android configurations.)
 #undef ABSL_RANDOM_INTERNAL_AES_DISPATCH
 #define ABSL_RANDOM_INTERNAL_AES_DISPATCH 1
+#elif defined(__APPLE__) && defined(ABSL_ARCH_PPC)
+// Darwin PPC
+#undef ABSL_RANDOM_INTERNAL_AES_DISPATCH
+#define ABSL_RANDOM_INTERNAL_AES_DISPATCH 0
 #endif
 
 // NaCl does not allow dispatch.
diff --git a/v8/third_party/abseil-cpp/absl/random/internal/randen_detect.cc b/v8/third_party/abseil-cpp/absl/random/internal/randen_detect.cc
index 63e8379..cbcae5f 100644
--- a/v8/third_party/abseil-cpp/absl/random/internal/randen_detect.cc
+++ b/v8/third_party/abseil-cpp/absl/random/internal/randen_detect.cc
@@ -50,6 +50,8 @@
 #elif defined(__linux__) && defined(ABSL_HAVE_GETAUXVAL)
 #define ABSL_INTERNAL_USE_LINUX_GETAUXVAL
 #define ABSL_INTERNAL_USE_GETAUXVAL
+#elif defined(__APPLE__) && defined(ABSL_ARCH_PPC)
+#define ABSL_INTERNAL_USE_PPC_CPUINFO
 #endif
 #endif
 
@@ -71,6 +73,11 @@ static void __cpuid(int cpu_info[4], int info_type) {
 #endif
 #endif  // ABSL_INTERNAL_USE_X86_CPUID
 
+#if defined(ABSL_INTERNAL_USE_PPC_CPUINFO)
+#include <mach/mach.h>
+#include <mach/machine.h>
+#endif // ABSL_INTERNAL_USE_PPC_CPUINFO
+
 // On linux, just use the c-library getauxval call.
 #if defined(ABSL_INTERNAL_USE_LINUX_GETAUXVAL)
 
-- 
2.43.0

