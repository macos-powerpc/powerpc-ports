From 44d109e3b4d8b844fd46dd8fa3f28833c59995cc Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 01:33:04 +0000
Subject: [PATCH 51/60] ppc-darwin: keep TracedNode at two words under the
 4-byte Darwin bool

First G5 cycle of the 13.6 port, parade #2 (every TU including
isolate.h):

  src/handles/traced-handles.h:111:34: error: static assertion failed
    static_assert(sizeof(TracedNode) <= 2 * kSystemPointerSize);
  the comparison reduces to '(12 <= 8)'

13.6 rewrote TracedNode (the 12.4 node had no size bound) as
Address + two 8-bit indices + uint8_t flags + std::atomic<bool>
is_marked_: 8 bytes on upstream's 32-bit hosts, two words.  On
Darwin PowerPC gcc's bool is 4 bytes (-mone-byte-bool is off, the
Apple ABI), so the atomic<bool> sits at offset 8 and the node grows
to 12.  Store the mark bit in a std::atomic<uint8_t> instead - the
same retype the port already applies to Debug::is_active_ and to the
fast-API javascript_execution_assert - and the layout is upstream's
again (8 bytes; 16 on 64-bit, unchanged).  Only the three accessors
touch the member; markbit() keeps returning bool.
---
 v8/src/handles/traced-handles.h | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/v8/src/handles/traced-handles.h b/v8/src/handles/traced-handles.h
index 40859d4..20c473a 100644
--- a/v8/src/handles/traced-handles.h
+++ b/v8/src/handles/traced-handles.h
@@ -60,13 +60,15 @@ class TracedNode final {
     next_free_index_ = next_free_index;
   }
 
-  void set_markbit() { is_marked_.store(true, std::memory_order_relaxed); }
+  void set_markbit() { is_marked_.store(1, std::memory_order_relaxed); }
 
-  bool markbit() const { return is_marked_.load(std::memory_order_relaxed); }
+  bool markbit() const {
+    return is_marked_.load(std::memory_order_relaxed) != 0;
+  }
 
   bool IsMetadataCleared() const { return flags_ == 0 && !markbit(); }
 
-  void clear_markbit() { is_marked_.store(false, std::memory_order_relaxed); }
+  void clear_markbit() { is_marked_.store(0, std::memory_order_relaxed); }
 
   bool has_old_host() const { return HasOldHost::decode(flags_); }
   void set_has_old_host(bool v) { flags_ = HasOldHost::update(flags_, v); }
@@ -103,8 +105,10 @@ class TracedNode final {
   IndexType index_;
   uint8_t flags_ = 0;
   // Marking bit could be stored in flags_ as well but is kept separately for
-  // clarity.
-  std::atomic<bool> is_marked_ = false;
+  // clarity.  A byte, not a bool: the Darwin PowerPC ABI makes bool 4 bytes
+  // (gcc's -mone-byte-bool is off), which would push the node to 12 bytes
+  // and past the two-word bound below.
+  std::atomic<uint8_t> is_marked_ = 0;
 };
 
 // TracedNode should not take more than 2 words.
