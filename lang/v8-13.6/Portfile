# bnoordhuis/v8-cmake has no 13.6 tag, so 0000-v8-cmake-build-harness.patch
# carries the harness itself: the 12.4 port's harness (itself the upstream
# 11.6 tag plus the 9.4 port's ppc wiring) re-mirrored against 13.6's
# BUILD.gn with node/gnmirror.py (per-target source lists, both directions)
# and node/gndefines.py (the config("features")/("toolchain") defines for
# this configuration): simdutf and highway as system libraries (vendored
# fallback targets behind V8_USE_SYSTEM_SIMDUTF/V8_USE_SYSTEM_HIGHWAY),
# the tree-path simdutf include redirected through a generated header,
# fast_float header-only; leaptiering an option that is OFF; the CSA and
# Turboshaft builtin generators compiled once into v8_initializers (the 12.4
# harness compiled them a second time into v8_base), which d8, mksnapshot
# and any embedder link; the defines node's own build sets and the new 13.6
# defaults it does not (black allocated pages, wasm random fuzzers, runtime
# call stats, the array-buffer internal-field counts) stated and audited;
# mksnapshot with --stress-turbo-late-spilling and a fixed --random-seed;
# torque list 245 entries verified exact.  Plus the one source edit
# update_v8.py would apply at import time (inspector-protocol
# code_generator.py). Nothing else - the whole v8/ tree arrives verbatim
# from the node distfile, and the series below applies with no fuzz.

# The ppc-darwin series, re-derived for 13.6 from the G5-validated v8-12.4
# series (every 12.4 patch is accounted for: 7 of the 52 are superseded or
# obsolete here, see below). 13.6 is a bigger hop for this target than
# 12.4 was: upstream removed 32-bit PowerPC altogether (no "ppc" in
# BUILD.gn or v8config.h, 103 32-bit conditionals gone from the backend,
# the instruction selector rewritten Turboshaft-only) and moved the ppc64
# backend's floor to POWER8 (the FP<->GPR moves, min/max and conditional
# select lost their pre-POWER7 fallbacks).  Hence three new foundation
# patches at the front of the series:
# - 0004 restores the 32-bit target configuration (v8config.h host/target/
#   32-bit/big-endian detection, globals.h, 36 arch-dispatch sites outside
#   the backend, the ABI macros' host-width tests);
# - 0005 restores the 32-bit halves of the ppc backend: the 12.4 #else
#   branches re-inserted where their 64-bit twin survives (73 blocks, by
#   node/reinsert32.py), hand-ported where 13.6 rewrote the 64-bit side,
#   and the pre-POWER7/8 fallbacks 13.6 deleted (memory-path FP moves,
#   compare-and-branch min/max, branch-around select, isel-free
#   conversions);
# - 0006 the 32-bit instruction selector for the Turboshaft-only file (59
#   Word64 visitors guarded - the generic selector supplies them on 32-bit
#   targets -, the Int32Pair/Word32Pair visitors in Turboshaft form, the
#   load/store/compare/switch sites), which supersedes 12.4's selector
#   patches (0005/0006/0014/0041/0050 of that series).
# Re-derived against 13.6 during the rebase, beyond context: the wasm jump
# tables (fixed instruction tables now; 32-bit far/lazy slots of 11/10
# words with lwz and 4-byte targets), DoubleToInt64 64-bit-only in the
# code generator, Debug::is_active_ as std::atomic<uint8_t>, the fast-API
# bool assert (the Turbofan linearizer is gone), RecommitPages' new shape.
# Obsolete at 13.6 and dropped: 12.4's wasm import-wrapper frame asserts
# (the slots are gone), the shared-RO-heap array-index decoder (shared RO
# heap is unconditional), the far-jump-slot padding (table-based now).
# Found while rebasing and fixed (0049): V8 renamed V8_OS_MACOSX to
# V8_OS_DARWIN after 9.4, so the 12.4 series' re-anchored 9.4 patches had
# dead Darwin branches (CPU subtype probe, sys_icache_invalidate - which
# 13.6's single-icbi generic flush makes mandatory on G4/G5 -, the handle
# ABI macro).
# Known limitations carried from 12.4: wasm-threads i64/sub-word atomics
# reach named-operator fatals if a module using them is instantiated; wasm
# SIMD modules are rejected with a clean CompileError below POWER9;
# Liftoff stays disabled (TurboFan compiles every wasm function).

# Any modern python works: the only build-time python consumer is the
# inspector code_generator.py, which sys.path-inserts --jinja_dir ahead of
# site-packages and therefore always uses the VENDORED jinja2 3.1.2 +
# markupsafe (no py-jinja2 port needed, unlike v8-9.4 whose comment
# predates checking this).  Verified with CPython 3.14.7: configure clean,
# generated inspector sources byte-identical to a 3.12 run.
set py_ver              3.14
set py_ver_nodot        [string map {. {}} ${py_ver}]

# ICU i18n: the harness builds V8 with V8_INTL_SUPPORT against MacPorts'
# ICU (CMake's FindICU; V8 13.6 static-asserts ICU >= 73), which is what
# upstream does by default and brings the whole JS Intl.* namespace,
# RegExp Unicode property escapes (\p{...} under /u - the biggest
# ecosystem hit when absent), real localeCompare, String.prototype.
# normalize and locale-aware case mapping. Beyond the intl sources the
# harness builds and runs V8's gen-regexp-special-case tool, whose output
# (the ECMAScript case-folding special cases, derived from ICU data)
# compiles into v8_base. The installed archive set is unchanged, but
# the archives now reference libicui18n/libicuuc/libicudata: an embedder
# linking them supplies those itself - nodejs22 is configured
# --with-intl=system-icu for that reason, and the two ports flip
# together.  d8 links the ICU dylibs. (The gettext/glib2 dependencies
# the port used to carry were never referenced by the CMake build.)
depends_build-append    port:python${py_ver_nodot}
depends_lib-append      path:lib/pkgconfig/icu-uc.pc:icu

# simdutf and highway: new V8 dependencies since 12.x (string ASCII
# validation and Uint8Array base64; the JSON stringifier's escape scan).
# BUILD.gn builds the vendored copies (simdutf 6.4.0, highway 2024-05);
# the harness links the system ports instead, whose AltiVec kernels are
# the point on this target. The API V8 uses was checked against simdutf 9.3.2
# and highway 1.4.0. Like ICU, both become part of the archives' link
# interface: an embedder (nodejs24 with --shared-simdutf) adds -lsimdutf
# -lhwy itself.
depends_lib-append      port:highway \
                        port:simdutf

configure.python        ${prefix}/bin/python${py_ver}

# Unpacking all of node would cost ~1 GB for the 98 MB subtree we want, so
# the extract phase pulls out deps/v8 by hand instead.
extract {
    system -W ${workpath} "${extract.cmd} ${extract.pre_args} \
        ${distpath}/node-v${node_version}${extract.suffix} \
        | tar -xf - node-v${node_version}/deps/v8"

    xinstall -d ${worksrcpath}
    move ${workpath}/node-v${node_version}/deps/v8 ${worksrcpath}/v8
    delete ${workpath}/node-v${node_version}
}

