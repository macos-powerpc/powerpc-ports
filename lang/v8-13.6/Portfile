# V8 13.6.233 is the V8 vendored by the nodejs-24 LTS line.
name                    v8-13.6
version                 13.6.233.17
revision                0

# The engine comes from node's release tarball rather than the upstream v8
# archive for the same reasons as v8-9.4 and v8-12.4: node-24 ships this
# exact V8 with its own floating patches, and that patched tree is what
# the ppc-darwin series below was derived against; and node vendors every
# V8 deps checkout the CMake build needs (abseil-cpp complete with its own
# CMakeLists, third_party/glibc ieee754 math, fp16, fast_float, jinja2,
# markupsafe, zlib, inspector_protocol, trace_event; simdutf and highway
# too, although this port links the system ones - see below).  node-v24.22.1/
# deps/v8 IS the port's v8/ tree.
#
# No googletest distfile: as at 12.4 the harness excludes
# crdtp/status_test_support.cc, so node's googletest copy - pruned to
# gtest_prod.h - is sufficient.
#
# NOTE: node 24 receives maintenance releases until 2028-04. The engine
# stays 13.6.233.x, but on a distfile bump re-verify that the series still
# applies without fuzz (upstream floats patches into deps/v8).
set node_version        24.22.1

use_xz                  yes

master_sites            https://nodejs.org/dist/v${node_version}/

distfiles               node-v${node_version}${extract.suffix}

worksrcdir              v8-cmake-${version}

