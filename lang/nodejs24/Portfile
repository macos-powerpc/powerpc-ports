# node 24's configure accepts 3.9 through 3.14; use the same python as
# the v8-13.6 port so the G5 needs only one.
set py_ver              3.14
set py_ver_nodot        [string map {. {}} ${py_ver}]

# V8 comes prebuilt from the v8-13.6 port, which builds this very
# tarball's deps/v8 (V8 13.6.233.17, with the ppc-darwin series)
# through a CMake harness and installs the static archives plus d8.
# Node's own gyp build is kept as is; configure --without-bundled-v8
# drops the whole in-tree V8 build (torque, mksnapshot, all V8
# compilation) and patch 0002 links the port's archives instead.

# Compile-time V8 headers are the in-tree deps/v8/include. Unlike at
# 12.4, the v8-13.6 series patches include/ (v8config.h has no 32-bit
# PowerPC detection left upstream), so patch 0004 carries the identical
# hunks into deps/v8/include and pre-configure cmp-checks the two files
# against the installed copies: the two ports must move together.

# Node core itself uses abseil (one absl::Mutex call in src/node.cc;
# upstream builds it from deps/v8/third_party/abseil-cpp via
# tools/v8_gypfiles/abseil.gyp). With the external V8 that second
# abseil build is dropped (patch 0003): the same absl sources are
# already compiled into the archives the v8-13.6 port installs, merged
# below into libv8_absl.a and linked into every linkable by patch 0002,
# with the same compiler and C++ ABI flags. The v8 port's three absl
# source patches are carried (0005-0007, path-shifted to deps/v8) so
# that the absl headers node.cc includes match the ones the archives
# were compiled from

# New at 24: simdutf is no longer a node dependency but a V8 one
# (deps/v8/third_party/simdutf, built by tools/v8_gypfiles/v8.gyp);
# the v8-13.6 port links the system simdutf and highway from ports
# simdutf and highway instead of the vendored copies, so node is built
# with --shared-simdutf against the same library and patch 0002 adds
# -lhwy to the archives' link interface.
set v8_port             v8-13.6
set v8_prebuilt_libdir  ${prefix}/libexec/${v8_port}/lib
set v8_prebuilt_incdir  ${prefix}/libexec/${v8_port}/include
# Node force_loads libv8_base_without_compiler.a (so native addons can
# resolve every V8 API symbol from the node binary), which exposes every
# archive member that cannot link outside special configs - members d8
# and mksnapshot never notice, because nothing references them. The
# v8 harness excludes the known offenders since 12.4 revision 2, so
# the deletions in pre-configure are expected no-ops; they are
# membership-checked and kept as a guard against a harness regression.
set v8_libdir           ${workpath}/v8-libs

depends_build-append    path:bin/pkg-config:pkgconfig \
                        port:python${py_ver_nodot} \
                        port:${v8_port}

depends_lib-append      port:highway \
                        path:lib/pkgconfig/icu-uc.pc:icu \
                        path:lib/libuv.dylib:libuv \
                        port:simdutf \
                        port:zlib

# node 24.22.1 bundles libuv 1.52.1 and, with --shared-libuv below, compiles
# against ${prefix}/include/uv.h instead. It needs at least libuv 1.50.0:
# uv_thread_setname (node_platform.cc, node_watchdog.cc, tracing/agent.cc),
# uv_getrusage_thread (node_process_methods.cc, node_report.cc,
# node_worker.cc) and uv_udp_try_send2 (udp_wrap.cc) were added there;
# nothing in src/ needs a later release. MacPorts cannot express a version
# constraint on a dependency, so fail early with a clear message instead of
# deep inside the compile.
pre-configure {
    set uv_version_h ${prefix}/include/uv/version.h
    if {![file exists ${uv_version_h}]} {
        return -code error "libuv headers not found at ${uv_version_h}"
    }
    set fh [open ${uv_version_h}]
    set uv_text [read ${fh}]
    close ${fh}
    set uv_major 0
    set uv_minor 0
    set uv_patch 0
    regexp {UV_VERSION_MAJOR\s+(\d+)} ${uv_text} -> uv_major
    regexp {UV_VERSION_MINOR\s+(\d+)} ${uv_text} -> uv_minor
    regexp {UV_VERSION_PATCH\s+(\d+)} ${uv_text} -> uv_patch
    if {${uv_major} < 1 || (${uv_major} == 1 && ${uv_minor} < 50)} {
        ui_error "${name} needs libuv >= 1.50.0 (uv_thread_setname,\
            uv_getrusage_thread, uv_udp_try_send2); found\
            ${uv_major}.${uv_minor}.${uv_patch} in ${uv_version_h}. Upgrade\
            port libuv (node ${version} bundles libuv 1.52.1)."
        return -code error "libuv too old"
    }

    # Header parity with the v8 port (see the comment at v8_port):
    # the in-tree deps/v8/include, patched by 0004, must be what the installed
    # archives were built against.
    foreach h {v8config.h v8-unwinder-state.h} {
        set installed ${v8_prebuilt_incdir}/${h}
        set intree ${worksrcpath}/deps/v8/include/${h}
        if {![file exists ${installed}]} {
            return -code error "${installed} not found - is port ${v8_port} installed?"
        }
        if {[catch {exec cmp -s ${installed} ${intree}}]} {
            ui_error "${intree} differs from ${installed}: the ${name} port's\
                patch 0004 and the ${v8_port} port's series are out of step;\
                rebuild ${v8_port} from its current port dir or refresh 0004."
            return -code error "V8 header mismatch"
        }
    }
}

proc rec_glob {basedir pattern} {
    set files [glob -directory $basedir -nocomplain -type f $pattern]
    foreach dir [glob -directory $basedir -nocomplain -type d *] {
        lappend files {*}[rec_glob $dir $pattern]
    }
    return $files
}

configure.python        ${prefix}/bin/python${py_ver}

patch.pre_args-replace  -p0 -p1

patchfiles-append       0001-gyp-build-system-for-powerpc-darwin.patch \
                        0002-gyp-link-against-an-external-prebuilt-V8-with-withou.patch \
                        0003-gyp-no-second-abseil-build-with-an-external-V8.patch \
                        0004-v8-bring-deps-v8-include-to-parity-with-the-v8-13.6-.patch \
                        0005-abseil-fall-back-to-pthread_mach_thread_np-where-pth.patch \
                        0006-abseil-darwin-ppc-build-fixes-copts-hwaes-simd-detec.patch \
                        0007-abseil-config.h-enable-TLS-with-gcc-libstdc-gate-the.patch \
                        0008-simdjson-portable-full_multiplication-for-32-bit-non.patch \
                        0009-crypto-read-use-system-ca-certificates-from-OpenSSL-.patch \
                        0010-gyp-make-deps-ada-and-deps-merve-honour-shared-simdu.patch

post-patch {
    foreach f [concat ${worksrcpath}/configure \
                   ${worksrcpath}/tools/gyp/gyp \
                   ${worksrcpath}/deps/v8/tools/objdump-v8 \
                   [rec_glob ${worksrcpath} *.py]] {
        reinplace -q "s|/usr/bin/env python3|${configure.python}|" ${f}
        reinplace -q "s|/usr/bin/env python|${configure.python}|" ${f}
    }
    foreach gypfile [rec_glob ${worksrcpath} *.gyp*] {
        reinplace -q "s|'python3'|'${configure.python}'|" ${gypfile}
        reinplace -q "s|'python'|'${configure.python}'|" ${gypfile}
    }
    reinplace "s|@OSX_V@|${macosx_deployment_target}|g" ${worksrcpath}/common.gypi
    foreach f [list ${worksrcpath}/node.gyp ${worksrcpath}/node.gypi] {
        reinplace "s|@V8_LIBDIR@|${v8_libdir}|g" ${f}
    }
    if {${configure.cxx_stdlib} ne "libc++"} {
        reinplace "s|_GLIBCXX_USE_CXX11_ABI=1|_GLIBCXX_USE_CXX11_ABI=0|g" ${worksrcpath}/common.gypi
    }
}

pre-configure {
    # Copy zlib headers here because we do not want to prepend the entire
    # ${prefix}/include to the include path.
    file mkdir ${workpath}/zlib-inc
    file copy ${prefix}/include/zconf.h ${prefix}/include/zlib.h \
        ${workpath}/zlib-inc/

    # Assemble the V8 lib dir (see the comment at v8_libdir): symlink
    # every archive, but give v8_base_without_compiler a real copy with
    # any unlinkable orphan members deleted (membership-checked, so
    # a no-op with a harness-fixed v8 port).
    set v8_base libv8_base_without_compiler.a
    file delete -force ${v8_libdir}
    file mkdir ${v8_libdir}
    foreach lib [glob ${v8_prebuilt_libdir}/libv8_*.a] {
        if {[file tail ${lib}] eq ${v8_base}} {
            file copy ${lib} ${v8_libdir}
        } else {
            file link -symbolic ${v8_libdir}/[file tail ${lib}] ${lib}
        }
    }
    #   deoptimizer-cfi-builtins.cc.o, deoptimizer-cfi-empty.cc.o
    #     v8_control_flow_integrity only: unresolvable Builtins_* labels,
    #     and both define Deoptimizer::IsValidReturnAddress (nodejs16)
    #   vtunedomain-support-extension.cc.o
    #     v8_enable_vtunetracemark only: references the never-built vtune
    #     library
    #   generate-bytecodes-builtins-list.cc.o
    #     the bytecode_builtins_list_generator host tool, swept into the
    #     archive by a harness GLOB: its main() duplicates node_main.o's
    foreach obj {deoptimizer-cfi-builtins.cc.o deoptimizer-cfi-empty.cc.o \
                 vtunedomain-support-extension.cc.o \
                 generate-bytecodes-builtins-list.cc.o} {
        if {![catch {exec ar -t ${v8_libdir}/${v8_base} ${obj}}]} {
            system -W ${v8_libdir} "ar -d ${v8_base} ${obj}"
        }
    }
    #   adler32.c.o, when present twice
    #     the 12.4 harness once compiled zlib's adler32.c both through its
    #     zlib GLOB and through a separate object library: two members with
    #     the one set of Cr_z_adler32* symbols, a duplicate under force_load
    #     (the symbol table hides it from every other link). ar -d removes
    #     one member per name (`ar -t lib name` also lists only the first,
    #     so count in the full listing); keep exactly one copy.
    set members [exec ar -t ${v8_libdir}/${v8_base}]
    set n [regexp -all -line {^adler32\.c\.o$} ${members}]
    while {${n} > 1} {
        system -W ${v8_libdir} "ar -d ${v8_base} adler32.c.o"
        set members [exec ar -t ${v8_libdir}/${v8_base}]
        set n [regexp -all -line {^adler32\.c\.o$} ${members}]
        if {${n} == 0} {
            return -code error "ar -d removed every adler32.c.o from ${v8_base}"
        }
    }
    system -W ${v8_libdir} "ranlib ${v8_base}"

    # Merge the abseil dependency closure of the v8 archives into
    # a single archive: within one archive ld64 needs no topological
    # ordering among the constituent libraries. (libtool warns about
    # duplicate member names, e.g. escaping.cc.o from strings and
    # strings_internal; archive members are addressed by offset via
    # the symbol table, so the duplicates are harmless.)
    system -W ${v8_libdir} \
        "libtool -static -o libv8_absl.a [join [glob ${v8_prebuilt_libdir}/libabsl_*.a]]"
}

configure.args-append   --without-npm
configure.args-append   --without-corepack
# ICU: the v8-13.6 port builds V8 with V8_INTL_SUPPORT against MacPorts'
# ICU, so its archives reference libicui18n/libicuuc/libicudata and node
# must link the same ICU. system-icu does exactly that: configure puts
# pkg-config's icu-i18n/icu-uc libs and cflags into config.gypi's
# target_defaults, i.e. on every link line (node, node_mksnapshot,
# cctest), which resolves the archives' ICU references, and node gets
# its own i18n on top of V8's Intl.* (URL IDNA for non-ASCII hostnames,
# Buffer.transcode(), the full TextDecoder encoding set). node 24
# requires ICU >= 73 (tools/icu/icu_versions.json), the same floor V8
# 13.6 asserts; configure checks the pkg-config version. The two ports
# flip together: intl=none against an i18n V8 fails to link.
configure.args-append   --with-intl=system-icu
# The inspector is disabled to keep the powerpc build minimal: it would
# add crdtp, src/inspector and the V8 inspector protocol codegen to
# the build surface.
# TODO: drop --without-inspector and append ${v8_libdir}/libv8_inspector.a
# to the archive list in patch 0002's node.gypi hunk - the v8-13.6 port
# already installs that archive.
configure.args-append   --without-inspector
configure.args-append   --without-bundled-v8
configure.args-append   --shared-openssl
configure.args-append   --shared-openssl-includes=[openssl::include_dir]
configure.args-append   --shared-openssl-libpath=[openssl::lib_dir]
configure.args-append   --shared-zlib
configure.args-append   --shared-zlib-includes=${workpath}/zlib-inc
configure.args-append   --shared-zlib-libpath=${prefix}/lib
# System libuv is fixed for older systems, the bundled one is not (its
# Darwin uv__hrtime calls mach_continuous_time, a 10.12 API, and scales the
# timebase with a bare multiply that overflows on PowerPC). Minimum version
# checked in the pre-configure block above.
configure.args-append   --shared-libuv
# simdutf: node's own sources (string_bytes, node_buffer, encoding_binding,
# util) call simdutf directly; the bundled copy now lives inside deps/v8
# and is built by tools/v8_gypfiles/v8.gyp, which --without-bundled-v8
# drops. Link the system simdutf the v8-13.6 port was built against
# (API checked against simdutf 9.3.2: every function node 24 calls is
# there). The -L this adds also serves patch 0002's -lhwy. deps/ada and
# deps/merve ignore the flag upstream and would drag v8.gyp back into
# the graph - patch 0010.
configure.args-append   --shared-simdutf
configure.args-append   --shared-simdutf-includes=${prefix}/include
configure.args-append   --shared-simdutf-libpath=${prefix}/lib

universal_variant       no

# "V8 doesn't like cache."
