        configure.args-append   --dest-cpu=ppc
    }
    ppc64 {
        configure.args-append   --dest-cpu=ppc64
    }
}

compiler.blacklist-append {clang < 900}

build.args-append   CC=${configure.cc} \
                    CXX=${configure.cxx} \
                    CXX.host=${configure.cxx} \
                    CPP=${configure.cpp} \
                    CPPFLAGS="${configure.cppflags}" \
                    CFLAGS="${configure.cflags} ${configure.cppflags}" \
                    CXXFLAGS="${configure.cxxflags} ${configure.cppflags}" \
                    LDFLAGS="${configure.ldflags} [legacysupport::get_library_link_flags]" \
                    PYTHON=${configure.python} \
                    V=1

destroot {
    set bindir ${destroot}${prefix}/bin
    set libdir ${destroot}${prefix}/lib
    set libndir ${libdir}/node
    set incdir ${destroot}${prefix}/include/node
    set docdir ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${bindir}
    xinstall -d ${libdir}
    xinstall -d ${libndir}
    xinstall -d ${incdir}
    xinstall -d ${docdir}

    # install binaries
    xinstall -m 755 -W ${worksrcpath} \
        out/Release/node \
        ${bindir}

    # install headers. deps/v8/include and deps/uv/include have
    # subdirectories (cppgc/, libplatform/, uv/) that v8.h and uv.h
    # include - copy the trees, not just the top-level headers. The V8
    # headers are the patched (port-parity) ones, which is what native
    # addons must compile against.
    xinstall -m 644 {*}[glob ${worksrcpath}/src/*.h]                ${incdir}
    foreach f [glob ${worksrcpath}/deps/v8/include/*] {
        copy ${f} ${incdir}
    }
    foreach f [glob ${worksrcpath}/deps/uv/include/*] {
        copy ${f} ${incdir}
    }
    xinstall -m 644 {*}[glob ${worksrcpath}/deps/cares/include/*.h] ${incdir}

    # install manpage
    xinstall -m 644 -W ${worksrcpath} \
        doc/node.1 \
        ${destroot}${prefix}/share/man/man1

    # install docs
    xinstall -m 644 -W ${worksrcpath} \
        CHANGELOG.md \
        CONTRIBUTING.md \
        GOVERNANCE.md \
        LICENSE \
        README.md \
        SECURITY.md \
        ${docdir}
}

