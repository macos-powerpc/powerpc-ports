From 07e288ed0570fd38979fdf9f1f6e5da5d8ff3142 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 07:25:54 +0000
Subject: [PATCH] gyp: link against an external prebuilt V8 with
 --without-bundled-v8

node 24 carries the configure flag: node_use_bundled_v8=false removes
the only dependencies on tools/v8_gypfiles/v8.gyp, so torque,
mksnapshot and all of V8 compilation drop out of the gyp build.  What
upstream never wired up is where the V8 symbols then come from.  Add an
else-branch in node.gypi supplying the static archives installed by the
v8-13.6 port (every linkable target - node, node_mksnapshot, cctest,
embedtest - includes node.gypi, so one patch point covers all), and
give the Darwin force_load of v8_base_without_compiler in the node
executable - required so the node binary re-exports the full V8 API to
native addons - an else-branch pointing at the installed archive, the
shape the libnode target already has.

The else-branch must also supply -Ideps/v8/include: the dropped v8.gyp
dependencies propagated it via direct_dependent_settings, and of the
node.gypi includers only libnode does not list deps/v8/include in its
own include_dirs - without it every libnode source fails on v8.h not
found (first nodejs16 G5 build; node 24 is the same).

Archives, as installed by the v8-13.6 port: libv8_initializers.a is
not optional - the 13.6 harness builds the CSA/Turboshaft builtin
generators once, there, instead of a second time into v8_base.
libv8_absl.a is the abseil dependency closure of v8_libbase, merged by
the Portfile from the constituent absl archives so that single-pass
ld64 archive resolution needs no topological ordering among them.
New at 13.6: V8 links highway (json-stringifier) and simdutf; the v8
port uses the system libraries from ports highway and simdutf, so the
archives' link interface needs -lhwy (added here) and -lsimdutf (which
--shared-simdutf puts on every link line, with the -L for both).

The @V8_LIBDIR@ placeholder is substituted by the Portfile.  Compile-
time headers stay the in-tree deps/v8/include, which patch 0004 brings
to parity with the port's installed headers (the 13.6 series patches
include/v8config.h; node 22's did not need to).
---
 node.gyp  | 19 ++++++++++++++++++-
 node.gypi | 38 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 56 insertions(+), 1 deletion(-)

diff --git a/node.gyp b/node.gyp
index e48e118..da4320d 100644
--- a/node.gyp
+++ b/node.gyp
@@ -636,7 +636,6 @@
           'xcode_settings': {
             'OTHER_LDFLAGS': [
               '-Wl,-force_load,<(PRODUCT_DIR)/<(STATIC_LIB_PREFIX)node_base<(STATIC_LIB_SUFFIX)',
-              '-Wl,-force_load,<(PRODUCT_DIR)/<(STATIC_LIB_PREFIX)v8_base_without_compiler<(STATIC_LIB_SUFFIX)',
             ],
           },
           'msvs_settings': {
@@ -648,6 +647,24 @@
             },
           },
           'conditions': [
+            # v8_base_without_compiler must be force-loaded in full: it is
+            # what re-exports the whole V8 API from the node binary so that
+            # native addons can resolve V8 symbols at runtime.  With
+            # --without-bundled-v8 the archive lives in the v8 port's prefix
+            # (@V8_LIBDIR@, substituted by the Portfile), not in PRODUCT_DIR.
+            ['node_use_bundled_v8=="true"', {
+              'xcode_settings': {
+                'OTHER_LDFLAGS': [
+                  '-Wl,-force_load,<(PRODUCT_DIR)/<(STATIC_LIB_PREFIX)v8_base_without_compiler<(STATIC_LIB_SUFFIX)',
+                ],
+              },
+            }, {
+              'xcode_settings': {
+                'OTHER_LDFLAGS': [
+                  '-Wl,-force_load,@V8_LIBDIR@/libv8_base_without_compiler.a',
+                ],
+              },
+            }],
             ['OS != "aix" and OS != "os400" and OS != "mac" and OS != "ios"', {
               'ldflags': [
                 '-Wl,--whole-archive',
diff --git a/node.gypi b/node.gypi
index 6587270..8ff2913 100644
--- a/node.gypi
+++ b/node.gypi
@@ -95,6 +95,44 @@
         'tools/v8_gypfiles/v8.gyp:v8_snapshot',
         'tools/v8_gypfiles/v8.gyp:v8_libplatform',
       ],
+    }, {
+      # --without-bundled-v8: supply what the dropped v8.gyp dependencies
+      # used to provide.  Headers first: their direct_dependent_settings
+      # propagated -Ideps/v8/include, and of the node.gypi includers only
+      # libnode does not list it in its own include_dirs (duplicates are
+      # harmless to gyp).
+      'include_dirs': [
+        'deps/v8/include',
+      ],
+      # Then the archives installed by the v8 port.  Absolute paths, not
+      # -L/-l: on Darwin -l would also match dylibs, and ld64 resolves
+      # archive members regardless of command line order, so no grouping
+      # is needed.  @V8_LIBDIR@ is substituted by the Portfile.
+      # link_settings on a static_library propagates to the executables
+      # that link it.  libv8_initializers.a carries the CSA/Turboshaft
+      # builtin generators (built once there by the 13.6 harness, not a
+      # second time into v8_base).  libv8_absl.a is the abseil dependency
+      # closure of v8_libbase, merged from the individual absl archives by
+      # the Portfile (single archive, so no inter-archive ordering).
+      'link_settings': {
+        'libraries': [
+          '@V8_LIBDIR@/libv8_libplatform.a',
+          '@V8_LIBDIR@/libv8_base_without_compiler.a',
+          '@V8_LIBDIR@/libv8_compiler.a',
+          '@V8_LIBDIR@/libv8_initializers.a',
+          '@V8_LIBDIR@/libv8_snapshot.a',
+          '@V8_LIBDIR@/libv8_torque_generated.a',
+          '@V8_LIBDIR@/libv8_libsampler.a',
+          '@V8_LIBDIR@/libv8_libbase.a',
+          '@V8_LIBDIR@/libv8_absl.a',
+          # V8 13.6 links highway (json-stringifier); the v8 port uses the
+          # system libhwy from port highway rather than the vendored copy.
+          # -L${prefix}/lib is on every link line already through
+          # --shared-simdutf-libpath, which also resolves the archives'
+          # simdutf references.
+          '-lhwy',
+        ],
+      },
     }],
     [ 'node_use_v8_platform=="true"', {
       'defines': [
-- 
2.43.0

