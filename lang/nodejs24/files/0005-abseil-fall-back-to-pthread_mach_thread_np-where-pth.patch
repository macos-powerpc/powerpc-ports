From 65c239dfb6d9b739a3d0f74017b4cc6c7056e274 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 07:26:38 +0000
Subject: [PATCH] abseil: fall back to pthread_mach_thread_np where
 pthread_threadid_np is unavailable

Carried from the v8-13.6 port (series patch 0001) for header/archive
parity: node.cc includes these abseil headers while linking the absl
archives the v8 port compiled from the patched tree.  node-v24.22.1's
deps/v8/third_party/abseil-cpp is byte-identical to the 13.6 import.

Upstream GetTID() calls pthread_threadid_np unconditionally, but that
function only appeared in Mac OS X 10.6; on 10.4/10.5 and on PowerPC
the call has to be pthread_mach_thread_np.  Taken verbatim (offsets
regenerated) from macos-powerpc/powerpc-ports devel/abseil
patch-pthread.diff at commit 8369f7df (the abseil 20240722.0 stack,
the closest reviewed vintage to the absl HEAD 2024-03-11 that V8 12.4
vendors); the same patch is still carried unchanged by that port
today.  Origin: macports-ports PR 19905.
---
 .../abseil-cpp/absl/base/internal/sysinfo.cc       | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/deps/v8/third_party/abseil-cpp/absl/base/internal/sysinfo.cc b/deps/v8/third_party/abseil-cpp/absl/base/internal/sysinfo.cc
index 1937db3..b361f39 100644
--- a/deps/v8/third_party/abseil-cpp/absl/base/internal/sysinfo.cc
+++ b/deps/v8/third_party/abseil-cpp/absl/base/internal/sysinfo.cc
@@ -70,6 +70,10 @@
 #include "absl/base/internal/unscaledcycleclock.h"
 #include "absl/base/thread_annotations.h"
 
+#if defined __APPLE__
+#include <AvailabilityMacros.h>
+#endif
+
 namespace absl {
 ABSL_NAMESPACE_BEGIN
 namespace base_internal {
@@ -440,7 +444,17 @@ pid_t GetTID() {
   // `nullptr` here implies this thread.  This only fails if the specified
   // thread is invalid or the pointer-to-tid is null, so we needn't worry about
   // it.
+#if (MAC_OS_X_VERSION_MAX_ALLOWED < 1060) || defined(__POWERPC__)
+  tid = pthread_mach_thread_np(pthread_self());
+#elif MAC_OS_X_VERSION_MIN_REQUIRED < 1060
+  if (&pthread_threadid_np) {
+    pthread_threadid_np(nullptr, &tid);
+  } else {
+    tid = pthread_mach_thread_np(pthread_self());
+  }
+#else
   pthread_threadid_np(nullptr, &tid);
+#endif
   return static_cast<pid_t>(tid);
 }
 
