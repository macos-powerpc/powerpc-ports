From f9deb14fbcac423152547dc5d45134dbf7280c6d Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 07:25:54 +0000
Subject: [PATCH] gyp: build system for powerpc-darwin

- re-admit ppc (32-bit) to configure's --dest-cpu choices: node 24
  pruned it from valid_arch (node 22 still listed it); nothing else in
  configure needs it, and common.gypi's ppc conditions below plus gyp's
  ARCHS-to--arch emulation do the rest
- map __ppc__/__ppc64__ (Darwin gcc spellings) in host_arch_cc() and
  correct __PPC__, which is 32-bit, to mean ppc (the old table made any
  32-bit PowerPC host look like ppc64, and an unmatched Darwin host fell
  through to the ia32 default, which in turn made configure believe it
  was cross-compiling)
- link libatomic where gcc needs it for 64-bit atomics on 32-bit
  targets; on mac this must go through xcode_settings (plain ldflags
  are ignored by the darwin gyp generators), but only for non-static
  targets: gyp passes OTHER_LDFLAGS to 'libtool -static' as well, and
  Apple libtool errors out on -l flags in static archives
- respect the port's deployment target instead of hardcoding 13.5;
  set ppc/ppc64 ARCHS (gyp's xcode emulation would otherwise pick an
  Intel default); pin -std=gnu++20 for gcc, the standard the external
  V8 archives were built with and the one upstream now uses on every
  posix platform (the in-tree pin is CLANG_CXX_LANGUAGE_STANDARD and
  clang-only; deps/ncrypto declares operator<=>, which gcc only lexes
  from C++20 on); add -fpermissive
- O2 instead of O3 and no per-file debug info: the 32-bit cctools
  toolchain is a hard constraint on object and archive sizes
- drop -Werror=undefined-inline from WARNING_CFLAGS: that is a
  clang-only warning and gcc rejects the option outright (the
  neighboring extra-semi and ctad-maybe-unsupported warnings do exist
  in gcc and stay)
- define __STDC_FORMAT_MACROS and _DARWIN_C_SOURCE on mac for older
  SDK headers
- add ppc to the list of 32-bit target_archs that force V8 pointer
  compression, the shared cage, 31-bit smis, the external code space
  and the sandbox off, so an explicit --experimental-enable-pointer-
  compression cannot produce a config the 32-bit archives do not have

node 24 re-derivation of the nodejs22 patch (0001 + 0010 folded):
the deployment-target hunk re-anchored (upstream moved to 13.5), the
gnu++17 pin replaced by gnu++20 from the start.
---
 common.gypi  | 49 +++++++++++++++++++++++++++++++++++++++++++++----
 configure.py |  7 +++++--
 node.gyp     |  1 -
 3 files changed, 50 insertions(+), 7 deletions(-)

diff --git a/common.gypi b/common.gypi
index b416129..9e6a2c0 100644
--- a/common.gypi
+++ b/common.gypi
@@ -120,7 +120,7 @@
         'v8_base': '<(PRODUCT_DIR)/libv8_snapshot.a',
       }],
       # V8 pointer compression only supports 64bit architectures.
-      ['target_arch in "arm ia32 mips mipsel"', {
+      ['target_arch in "arm ia32 mips mipsel ppc"', {
         'v8_enable_pointer_compression': 0,
         'v8_enable_pointer_compression_shared_cage': 0,
         'v8_enable_31bit_smis_on_64bit_arch': 0,
@@ -337,7 +337,12 @@
           }
         },
         'xcode_settings': {
-          'GCC_OPTIMIZATION_LEVEL': '3', # stop gyp from defaulting to -Os
+          'GCC_OPTIMIZATION_LEVEL': '2', # stop gyp from defaulting to -Os
+          # gyp's xcode emulation injects -gdwarf-2 unless this is set (env
+          # CFLAGS never reach the compiler on mac).  Keep debug info out of
+          # the static archives: the 32-bit cctools toolchain cannot handle
+          # multi-GB inputs.
+          'GCC_GENERATE_DEBUGGING_SYMBOLS': 'NO',
         },
       }
     },
@@ -719,8 +724,25 @@
           }],
         ],
       }],
+      # gcc needs libatomic for 64-bit atomics on 32-bit targets.  On mac
+      # only xcode_settings are honored, plain ldflags are ignored, but
+      # OTHER_LDFLAGS also get passed to 'libtool -static', which rejects
+      # -l flags, so keep it away from static_library targets.
+      ['target_arch in "arm mips ppc"', {
+        'conditions': [
+          ['OS=="mac"', {
+            'target_conditions': [
+              ['_type!="static_library"', {
+                'xcode_settings': { 'OTHER_LDFLAGS': [ '-latomic' ] },
+              }],
+            ],
+          }, {
+            'ldflags': [ '-latomic' ],
+          }],
+        ],
+      }],
       ['OS=="mac"', {
-        'defines': ['_DARWIN_USE_64_BIT_INODE=1'],
+        'defines': ['_DARWIN_USE_64_BIT_INODE=1', '__STDC_FORMAT_MACROS', '_DARWIN_C_SOURCE'],
         'xcode_settings': {
           'ALWAYS_SEARCH_USER_PATHS': 'NO',
           'GCC_CW_ASM_SYNTAX': 'NO',                # No -fasm-blocks
@@ -731,7 +753,7 @@
           'GCC_ENABLE_PASCAL_STRINGS': 'NO',        # No -mpascal-strings
           'GCC_STRICT_ALIASING': 'NO',              # -fno-strict-aliasing
           'PREBINDING': 'NO',                       # No -Wl,-prebind
-          'MACOSX_DEPLOYMENT_TARGET': '13.5',       # -mmacosx-version-min=13.5
+          'MACOSX_DEPLOYMENT_TARGET': '@OSX_V@',    # -mmacosx-version-min=@OSX_V@
           'USE_HEADERMAP': 'NO',
           'WARNING_CFLAGS': [
             '-Wall',
@@ -764,6 +786,25 @@
               ],
             },
           }],
+          # Pin the C++ standard: the CLANG_CXX_LANGUAGE_STANDARD below is
+          # clang-only, and without an explicit -std modern gcc defaults to
+          # gnu++17 (gcc 11-15) or gnu++23 (gcc 16+).  gnu++20 is what
+          # upstream builds node with on every posix platform (cflags_cc
+          # above, which the mac generator ignores) and the standard the
+          # external V8 archives were built with; deps/ncrypto declares
+          # operator<=>, which gcc only lexes as one token from C++20 on.
+          ['target_arch=="ppc"', {
+            'xcode_settings': {
+              'ARCHS': ['ppc'],
+              'OTHER_CPLUSPLUSFLAGS': ['-std=gnu++20', '-fpermissive'],
+            },
+          }],
+          ['target_arch=="ppc64"', {
+            'xcode_settings': {
+              'ARCHS': ['ppc64'],
+              'OTHER_CPLUSPLUSFLAGS': ['-std=gnu++20', '-fpermissive'],
+            },
+          }],
           ['clang==1', {
             'xcode_settings': {
               'GCC_VERSION': 'com.apple.compilers.llvm.clang.1_0',
diff --git a/configure.py b/configure.py
index b826e24..833799e 100755
--- a/configure.py
+++ b/configure.py
@@ -47,7 +47,8 @@ parser = argparse.ArgumentParser()
 valid_os = ('win', 'mac', 'solaris', 'freebsd', 'openbsd', 'linux',
             'android', 'aix', 'cloudabi', 'os400', 'ios', 'openharmony')
 valid_arch = ('arm', 'arm64', 'ia32', 'mips', 'mipsel', 'mips64el',
-              'ppc64', 'x64', 'x86', 'x86_64', 's390x', 'riscv64', 'loong64')
+              'ppc', 'ppc64', 'x64', 'x86', 'x86_64', 's390x', 'riscv64',
+              'loong64')
 valid_arm_float_abi = ('soft', 'softfp', 'hard')
 valid_arm_fpu = ('vfp', 'vfpv3', 'vfpv3-d16', 'neon')
 valid_mips_arch = ('loongson', 'r1', 'r2', 'r6', 'rx')
@@ -1512,7 +1513,9 @@ def host_arch_cc():
     '__MIPSEL__'  : 'mipsel',
     '__mips__'    : 'mips',
     '__PPC64__'   : 'ppc64',
-    '__PPC__'     : 'ppc64',
+    '__ppc64__'   : 'ppc64',
+    '__PPC__'     : 'ppc',
+    '__ppc__'     : 'ppc',
     '__x86_64__'  : 'x64',
     '__s390x__'   : 's390x',
     '__riscv'     : 'riscv',
diff --git a/node.gyp b/node.gyp
index 62c748b..e48e118 100644
--- a/node.gyp
+++ b/node.gyp
@@ -501,7 +501,6 @@
         '-Wendif-labels',
         '-W',
         '-Wno-unused-parameter',
-        '-Werror=undefined-inline',
         '-Werror=extra-semi',
         '-Werror=ctad-maybe-unsupported',
       ],
-- 
2.43.0

