From 5a42f6b0cdcbaa5da4ddb385c8d00067a9f19b66 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 07:26:37 +0000
Subject: [PATCH] v8: bring deps/v8/include to parity with the v8-13.6 port's
 headers

Node compiles its own sources against the in-tree deps/v8/include
(every target lists it; patch 0002 adds it for libnode).  At 12.4 that
was byte-identical to what the v8 port's archives were built against,
because none of the port's patches touched include/.  At 13.6 it is
not: pristine include/v8config.h has no 32-bit PowerPC detection left
(the host/target chain ends in #error for a ppc32 compile), so the
v8-13.6 series' foundation commit ("ppc32: restore the 32-bit PowerPC
target configuration", 44767ae) patches include/v8config.h (host arch,
target arch, 32-bit, big-endian) and include/v8-unwinder-state.h.

Carry exactly those hunks here, re-pathed to deps/v8/include/, so the
headers node sees are the headers the archives were built from (the
Portfile cmp-checks the two files against the installed copies before
configure).  node-v24.22.1's deps/v8/include is byte-identical to the
v8-13.6 import (V8 13.6.233.17), so the hunks apply without offsets.
---
 deps/v8/include/v8-unwinder-state.h |  3 ++-
 deps/v8/include/v8config.h          | 14 ++++++++++++--
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/deps/v8/include/v8-unwinder-state.h b/deps/v8/include/v8-unwinder-state.h
index 084692f..63efbfb 100644
--- a/deps/v8/include/v8-unwinder-state.h
+++ b/deps/v8/include/v8-unwinder-state.h
@@ -18,7 +18,8 @@ struct CalleeSavedRegisters {
   void* arm_r10;
 };
 #elif V8_TARGET_ARCH_X64 || V8_TARGET_ARCH_IA32 || V8_TARGET_ARCH_ARM64 ||     \
-    V8_TARGET_ARCH_MIPS64 || V8_TARGET_ARCH_PPC64 || V8_TARGET_ARCH_RISCV64 || \
+    V8_TARGET_ARCH_MIPS64 || V8_TARGET_ARCH_PPC || V8_TARGET_ARCH_PPC64 ||     \
+    V8_TARGET_ARCH_RISCV64 ||                                                 \
     V8_TARGET_ARCH_S390X || V8_TARGET_ARCH_LOONG64 || V8_TARGET_ARCH_RISCV32
 struct CalleeSavedRegisters {};
 #else
diff --git a/deps/v8/include/v8config.h b/deps/v8/include/v8config.h
index 9581df6..2146e16 100644
--- a/deps/v8/include/v8config.h
+++ b/deps/v8/include/v8config.h
@@ -840,6 +840,9 @@ V8 shared library set USING_V8_SHARED.
 #elif defined(__PPC64__) || defined(_ARCH_PPC64)
 #define V8_HOST_ARCH_PPC64 1
 #define V8_HOST_ARCH_64_BIT 1
+#elif defined(__PPC__) || defined(_ARCH_PPC)
+#define V8_HOST_ARCH_PPC 1
+#define V8_HOST_ARCH_32_BIT 1
 #elif defined(__s390x__)
 #define V8_HOST_ARCH_S390X 1
 #define V8_HOST_ARCH_64_BIT 1
@@ -863,8 +866,8 @@ V8 shared library set USING_V8_SHARED.
 // architecture, that is, target the native environment as presented by the
 // compiler.
 #if !V8_TARGET_ARCH_X64 && !V8_TARGET_ARCH_IA32 && !V8_TARGET_ARCH_ARM && \
-    !V8_TARGET_ARCH_ARM64 && !V8_TARGET_ARCH_MIPS64 &&                    \
-    !V8_TARGET_ARCH_PPC64 && !V8_TARGET_ARCH_S390X &&                     \
+    !V8_TARGET_ARCH_ARM64 && !V8_TARGET_ARCH_MIPS64 && !V8_TARGET_ARCH_PPC && \
+    !V8_TARGET_ARCH_PPC64 && !V8_TARGET_ARCH_S390X &&                         \
     !V8_TARGET_ARCH_RISCV64 && !V8_TARGET_ARCH_LOONG64 &&                 \
     !V8_TARGET_ARCH_RISCV32
 #if defined(_M_X64) || defined(__x86_64__)
@@ -881,6 +884,8 @@ V8 shared library set USING_V8_SHARED.
 #define V8_TARGET_ARCH_LOONG64 1
 #elif defined(_ARCH_PPC64)
 #define V8_TARGET_ARCH_PPC64 1
+#elif defined(_ARCH_PPC)
+#define V8_TARGET_ARCH_PPC 1
 #elif defined(__s390x__)
 #define V8_TARGET_ARCH_S390X 1
 #elif defined(__riscv) || defined(__riscv__)
@@ -915,6 +920,8 @@ V8 shared library set USING_V8_SHARED.
 #define V8_TARGET_ARCH_64_BIT 1
 #elif V8_TARGET_ARCH_LOONG64
 #define V8_TARGET_ARCH_64_BIT 1
+#elif V8_TARGET_ARCH_PPC
+#define V8_TARGET_ARCH_32_BIT 1
 #elif V8_TARGET_ARCH_PPC64
 #define V8_TARGET_ARCH_64_BIT 1
 #elif V8_TARGET_ARCH_S390X
@@ -975,6 +982,9 @@ V8 shared library set USING_V8_SHARED.
 #else
 #define V8_TARGET_LITTLE_ENDIAN 1
 #endif
+#elif V8_TARGET_ARCH_PPC
+// 32-bit PowerPC is big-endian on every OS V8 has run on (Darwin, AIX, Linux).
+#define V8_TARGET_BIG_ENDIAN 1
 #elif V8_TARGET_ARCH_PPC64
 #if V8_OS_AIX
 #define V8_TARGET_BIG_ENDIAN 1
-- 
2.43.0

