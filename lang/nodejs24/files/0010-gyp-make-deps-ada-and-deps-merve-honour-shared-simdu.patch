From 6122dd55fa5362b4169725887b308bc596bf0084 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 07:38:04 +0000
Subject: [PATCH] gyp: make deps/ada and deps/merve honour --shared-simdutf

ada (deps/ada/ada.gyp) is hardwired to V8's vendored simdutf: it
depends on tools/v8_gypfiles/v8.gyp:simdutf unconditionally and adds
deps/v8/third_party/simdutf to its include path.  Node's own targets
switch to the system library with --shared-simdutf (configure puts the
-I and -lsimdutf into target_defaults, so every target, ada included,
already compiles and links against it), but ada's hard dependency
still drags tools/v8_gypfiles/v8.gyp into the graph - and with
--without-bundled-v8 that is the whole V8 gyp build, whose variables
section scrapes deps/v8/third_party/*/BUILD.gn before a single target
is selected.

Gate both the dependency and the vendored include dir on
node_shared_simdutf=="false", the same condition node.gyp and
node.gypi use for their own simdutf dependencies.  ADA_USE_SIMDUTF
stays on: ada uses simdutf either way, only its origin changes.

merve (deps/merve/merve.gyp) has the include-dir half of the same
problem: it adds deps/v8/third_party/simdutf unconditionally.  The
generated include order happens to put configure's shared-simdutf -I
first, but a header from one simdutf and a library from another is
not a configuration to rely on; gate it the same way.
---
 deps/ada/ada.gyp     | 11 ++++++++---
 deps/merve/merve.gyp |  7 ++++++-
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/deps/ada/ada.gyp b/deps/ada/ada.gyp
index 30054e6..b953605 100644
--- a/deps/ada/ada.gyp
+++ b/deps/ada/ada.gyp
@@ -8,7 +8,6 @@
       'type': 'static_library',
       'include_dirs': [
         '.',
-        '<(DEPTH)/deps/v8/third_party/simdutf',
       ],
       'direct_dependent_settings': {
         'include_dirs': ['.'],
@@ -16,8 +15,14 @@
       'defines': [
         'ADA_USE_SIMDUTF=1',
       ],
-      'dependencies': [
-        '../../tools/v8_gypfiles/v8.gyp:simdutf',
+      'conditions': [
+        # With --shared-simdutf the system library's -I and -l come from
+        # configure's target_defaults; only the bundled build needs V8's
+        # vendored copy (and with it tools/v8_gypfiles/v8.gyp).
+        [ 'node_shared_simdutf=="false"', {
+          'include_dirs': [ '<(DEPTH)/deps/v8/third_party/simdutf' ],
+          'dependencies': [ '../../tools/v8_gypfiles/v8.gyp:simdutf' ],
+        }],
       ],
       'sources': [ '<@(ada_sources)' ]
     },
diff --git a/deps/merve/merve.gyp b/deps/merve/merve.gyp
index 781b157..ec40bb5 100644
--- a/deps/merve/merve.gyp
+++ b/deps/merve/merve.gyp
@@ -8,13 +8,18 @@
       'type': 'static_library',
       'include_dirs': [
         '.',
-        '../v8/third_party/simdutf',
       ],
       'direct_dependent_settings': {
         'include_dirs': ['.'],
       },
       'sources': [ '<@(merve_sources)' ],
       'conditions': [
+        # With --shared-simdutf the system library's -I comes from
+        # configure's target_defaults; only the bundled build wants V8's
+        # vendored copy on the include path.
+        ['node_shared_simdutf=="false"', {
+          'include_dirs': [ '../v8/third_party/simdutf' ],
+        }],
         ['OS=="win"', {
           'msvs_settings': {
             'VCCLCompilerTool': {
-- 
