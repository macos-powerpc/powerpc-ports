From 29a360d35409d75cc1b21a91232f96a09f4e844f Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 07:26:37 +0000
Subject: [PATCH] gyp: no second abseil build with an external V8

Node's own use of abseil is one call in src/node.cc
(absl::SetMutexDeadlockDetectionMode, via absl/synchronization/
mutex.h); upstream builds the whole of deps/v8/third_party/abseil-cpp
for it through tools/v8_gypfiles/abseil.gyp (107 TUs).  With
--without-bundled-v8 the same source vintage is already compiled into
the v8 port's absl archives, merged into libv8_absl.a and linked into
every linkable by patch 0002's node.gypi branch, with the same compiler
and the same MacPorts-global C++ ABI flags - the gyp abseil target
contributes nothing but its include dir.  Make the
'tools/v8_gypfiles/abseil.gyp:abseil' dependency of libnode and cctest
conditional on node_use_bundled_v8=="true" and add
deps/v8/third_party/abseil-cpp to node.gypi's --without-bundled-v8
include_dirs.  This also removes the only includer of toolchain.gypi
from this port's graph.

The abseil source patches that follow (0005-0007) stay: node.cc
includes the absl headers, and they must match the headers the v8 port
compiled the archives from.

node 24: the nodejs22 patch's second half - toolchain.gypi forcing
ARCHS i386 on every 32-bit Mac V8 target (it emitted -arch i386 for
the abseil target on the first G5 build) - is gone upstream; node 24's
toolchain.gypi no longer sets ARCHS for 32-bit targets at all.
---
 node.gyp  | 18 ++++++++++++++++--
 node.gypi |  6 ++++++
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/node.gyp b/node.gyp
index da4320d..70a86cd 100644
--- a/node.gyp
+++ b/node.gyp
@@ -842,7 +842,6 @@
         '<(SHARED_INTERMEDIATE_DIR)' # for node_natives.h
       ],
       'dependencies': [
-        'tools/v8_gypfiles/abseil.gyp:abseil',
         'node_js2c#host',
       ],
 
@@ -1072,6 +1071,14 @@
       ],
 
       'conditions': [
+        # With the bundled V8, abseil is compiled from
+        # deps/v8/third_party/abseil-cpp for node's own use of it
+        # (absl::Mutex in src/node.cc).  With --without-bundled-v8 the same
+        # code is already linked from the v8 port's libv8_absl.a (node.gypi),
+        # so the second build is dropped; node.gypi supplies the include dir.
+        [ 'node_use_bundled_v8=="true"', {
+          'dependencies': [ 'tools/v8_gypfiles/abseil.gyp:abseil' ],
+        }],
         [ 'node_builtin_modules_path!=""', {
           # When loading builtins from disk, JS source files do not need to
           # trigger rebuilds since the binary reads them at runtime.
@@ -1293,7 +1300,6 @@
 
       'dependencies': [
         '<(node_lib_target_name)',
-        'tools/v8_gypfiles/abseil.gyp:abseil',
       ],
 
       'includes': [
@@ -1318,6 +1324,14 @@
       'sources': [ '<@(node_cctest_sources)' ],
 
       'conditions': [
+        # With the bundled V8, abseil is compiled from
+        # deps/v8/third_party/abseil-cpp for node's own use of it
+        # (absl::Mutex in src/node.cc).  With --without-bundled-v8 the same
+        # code is already linked from the v8 port's libv8_absl.a (node.gypi),
+        # so the second build is dropped; node.gypi supplies the include dir.
+        [ 'node_use_bundled_v8=="true"', {
+          'dependencies': [ 'tools/v8_gypfiles/abseil.gyp:abseil' ],
+        }],
         [ 'node_shared_gtest=="false"', {
           'dependencies': [
             'deps/googletest/googletest.gyp:gtest',
diff --git a/node.gypi b/node.gypi
index 8ff2913..dadbb08 100644
--- a/node.gypi
+++ b/node.gypi
@@ -103,6 +103,12 @@
       # harmless to gyp).
       'include_dirs': [
         'deps/v8/include',
+        # abseil headers for node's own absl use (src/node.cc).  The code
+        # comes from libv8_absl.a below, so tools/v8_gypfiles/abseil.gyp is
+        # not built in this configuration (node.gyp).  Header/archive
+        # parity: the port's absl patches keep these headers identical to
+        # the ones the v8 port compiled the archives from.
+        'deps/v8/third_party/abseil-cpp',
       ],
       # Then the archives installed by the v8 port.  Absolute paths, not
       # -L/-l: on Darwin -l would also match dylibs, and ld64 resolves
-- 
