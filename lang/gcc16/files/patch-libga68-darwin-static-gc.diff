libga68: link a static Boehm GC into libga68.dylib only, without a spec entry

With --enable-algol68-gc and a bdw-gc directory that holds libgc.a, configure
means to link the collector statically into the Darwin dylib with no entry in
libga68.spec ("No spec entry").  Two problems:

- SPEC_LIBGA68_DEPS is extended with BDW_GC_LIBS before the Darwin case clears
  it, so libga68.spec still names the GC library (the build-time libgc.la, or
  -L<dir> -lgc) and every ga68 link refers to the build directory.
- The archive goes into LIBADD, so libtool records its build-time path in
  libga68.la and adds the archive itself as a member of libga68.a.

Pass the archive to the dylib link through extra_darwin_ldflags_libga68
instead, and extend the spec deps after the Darwin case.  Non-Darwin hosts
and builds without GC are unchanged.

--- libga68/configure.ac
+++ libga68/configure.ac
@@ -394,7 +394,6 @@
   LIBGA68_GCFLAGS='-DLIBGA68_WITH_GC=1'
   LIBGA68_BOEHM_GC_INCLUDES=$BDW_GC_CFLAGS
   LIBGA68_BOEHM_GC_LIBS=$BDW_GC_LIBS
-  SPEC_LIBGA68_DEPS="$SPEC_LIBGA68_DEPS $BDW_GC_LIBS"
 fi
 
 extra_darwin_ldflags_libga68=
@@ -402,14 +401,23 @@
   *-*-darwin*)
      extra_darwin_ldflags_libga68=-Wl,-U,___algol68_main
      if test -f $bdw_lib_dir/libgc.a; then
-       # Darwin wants to link this statically into the library
-       LIBGA68_BOEHM_GC_LIBS="$bdw_lib_dir/libgc.a"
+       # Darwin wants to link this statically into the library.  Hand the
+       # archive to the linker of the shared library only: in LIBADD, libtool
+       # would also add it to libga68.a as a member, and record its build-time
+       # path in libga68.la.
+       LIBGA68_BOEHM_GC_LIBS=
+       extra_darwin_ldflags_libga68="$extra_darwin_ldflags_libga68 -Wl,$bdw_lib_dir/libgc.a"
        # No spec entry.
        BDW_GC_LIBS=
      fi
      ;;
   *) ;;
 esac
+
+# After the Darwin case above, which may drop the spec entry.
+if test "$use_bdw_gc" != no; then
+  SPEC_LIBGA68_DEPS="$SPEC_LIBGA68_DEPS $BDW_GC_LIBS"
+fi
 AC_SUBST(extra_darwin_ldflags_libga68)
 
 case "$enable_algol68_gc_debug" in
