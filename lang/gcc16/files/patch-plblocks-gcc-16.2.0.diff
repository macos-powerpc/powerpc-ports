+  DECL_CHAIN (invoke) = descriptor;
+  TYPE_FIELDS (type) = isa;
+  state->fields_tail = descriptor;
+  state->block_type = type;
+  return type;
+}
+
+/* Return an artificial declaration for one of the concrete block classes.
+   The runtime exports these as arrays; only their addresses are material to
+   generated code.  */
+
+static tree
+block_runtime_class_decl (location_t loc, bool global_p)
+{
+  tree *slot = &c_block_trees[global_p ? CBTI_GLOBAL_CLASS
+				       : CBTI_STACK_CLASS];
+
+  if (!*slot)
+    {
+      const char *name = c_blocks_runtime_class_name (global_p);
+      tree array_type = build_array_type_nelts (ptr_type_node, 32);
+      *slot = build_decl (loc, VAR_DECL, get_identifier (name), array_type);
+      DECL_EXTERNAL (*slot) = 1;
+      TREE_PUBLIC (*slot) = 1;
+      TREE_USED (*slot) = 1;
+    }
+  return *slot;
+}
+
+/* Return declarations for the two ownership hooks exported by a Blocks
+   runtime.  */
+
+static tree
+block_object_runtime_function (location_t loc, bool dispose_p)
+{
+  tree *slot = &c_block_trees[dispose_p ? CBTI_OBJECT_DISPOSE
+					: CBTI_OBJECT_ASSIGN];
+  if (!*slot)
+    {
+      const char *name
+	= c_blocks_runtime_object_function_name (dispose_p);
+      tree type;
+      if (dispose_p)
+	type = build_function_type_list (void_type_node, ptr_type_node,
+					 integer_type_node, NULL_TREE);
+      else
+	type = build_function_type_list (void_type_node, ptr_type_node,
+					 ptr_type_node, integer_type_node,
+					 NULL_TREE);
+      *slot = build_decl (loc, FUNCTION_DECL, get_identifier (name), type);
+      DECL_EXTERNAL (*slot) = 1;
+      TREE_PUBLIC (*slot) = 1;
+      TREE_USED (*slot) = 1;
+    }
+  return *slot;
+}
+
+/* Build PARAM->FIELD without going through source-level name lookup.  */
+
+static tree
+block_capture_component (location_t loc, tree param, tree field)
+{
+  tree object = build_indirect_ref (loc, param, RO_ARROW);
+  return build3_loc (loc, COMPONENT_REF, TREE_TYPE (field),
+		     object, field, NULL_TREE);
+}
+
+/* Synthesize a copy or dispose helper for captures which require runtime
+   ownership.  At present that is every byref capture; object and block
+   pointer captures join the same path as their ownership classification is
+   enabled.  */
+
+static tree
+build_block_copy_dispose_helper (location_t loc,
+				 struct c_block_state *state,
+				 unsigned int number, bool dispose_p)
+{
+  tree block_pointer = build_pointer_type (state->block_type);
+  struct c_arg_info *args = build_arg_info ();
+  tree first = build_decl (loc, PARM_DECL,
+			   get_identifier (dispose_p ? "__src" : "__dst"),
+			   block_pointer);
+  DECL_ARG_TYPE (first) = block_pointer;
+  TREE_USED (first) = 1;
+
+  if (dispose_p)
+    {
+      args->parms = first;
+      args->types = tree_cons (NULL_TREE, block_pointer, void_list_node);
+    }
+  else
+    {
+      tree second = build_decl (loc, PARM_DECL, get_identifier ("__src"),
+				block_pointer);
+      DECL_ARG_TYPE (second) = block_pointer;
+      TREE_USED (second) = 1;
+      DECL_CHAIN (first) = second;
+      args->parms = first;
+      args->types = tree_cons
+	(NULL_TREE, block_pointer,
+	 tree_cons (NULL_TREE, block_pointer, void_list_node));
+    }
+
+  char name[48];
+  snprintf (name, sizeof name, dispose_p ? "__destroy_helper_block_%u"
+					: "__copy_helper_block_%u", number);
+  bool nested = current_function_decl != NULL_TREE;
+  struct c_typespec result_spec = {};
+  result_spec.kind = ctsk_typeof;
+  result_spec.spec = void_type_node;
+  result_spec.expr_const_operands = true;
+  struct c_declspecs *specs = build_null_declspecs ();
+  if (!nested)
+    specs->storage_class = csc_static;
+  declspecs_add_type (loc, specs, result_spec);
+  finish_declspecs (specs);
+  struct c_declarator *declarator
+    = build_function_declarator
+	(args, build_id_declarator (get_identifier (name)));
+
+  if (nested)
+    c_push_function_context ();
+  if (!start_function (specs, declarator, NULL_TREE))
+    {
+      if (nested)
+	c_pop_function_context ();
+      return error_mark_node;
+    }
+
+  tree helper = current_function_decl;
+  store_parm_decls ();
+  tree dst_or_src = DECL_ARGUMENTS (helper);
+  tree src = dispose_p ? dst_or_src : DECL_CHAIN (dst_or_src);
+  tree stmt = c_begin_compound_stmt (true);
+
+  for (tree capture = state->captures;
+       capture; capture = TREE_CHAIN (capture))
+    {
+      tree original = TREE_PURPOSE (capture);
+      int ownership_flag = block_capture_ownership_flag (original);
+      if (!ownership_flag)
+	continue;
+      tree field = TREE_VALUE (capture);
+      tree runtime = block_object_runtime_function (loc, dispose_p);
+      tree call;
+      if (dispose_p)
+	{
+	  tree value = block_capture_component (loc, src, field);
+	  call = build_function_call
+	    (loc, runtime,
+	     tree_cons (NULL_TREE, value,
+			tree_cons (NULL_TREE,
+				   build_int_cst (integer_type_node,
+						  ownership_flag),
+				   NULL_TREE)));
+	}
+      else
+	{
+	  tree destination
+	    = build_fold_addr_expr_loc
+		(loc, block_capture_component (loc, dst_or_src, field));
+	  destination = fold_convert_loc (loc, ptr_type_node, destination);
+	  tree value = block_capture_component (loc, src, field);
+	  call = build_function_call
+	    (loc, runtime,
+	     tree_cons
+	       (NULL_TREE, destination,
+		tree_cons (NULL_TREE, value,
+			   tree_cons (NULL_TREE,
+				      build_int_cst (integer_type_node,
+						     ownership_flag),
+				      NULL_TREE))));
+	}
+      add_stmt (call);
+    }
+
+  tree body = c_end_compound_stmt (loc, stmt, true);
+  DECL_STATIC_CHAIN (helper) = 0;
+  TREE_USED (helper) = 1;
+  add_stmt (body);
+  finish_function (loc);
+  if (nested)
+    {
+      c_pop_function_context ();
+      add_stmt (build_stmt (loc, DECL_EXPR, helper));
+    }
+  DECL_CONTEXT (helper) = NULL_TREE;
+  return helper;
+}
+
+/* The descriptor prefix common to block literals without copy/dispose
+   helpers.  */
+
+static tree
+block_descriptor_record_type (location_t loc, bool copy_dispose_p)
+{
+  tree *slot = &c_block_trees[copy_dispose_p
+			      ? CBTI_COPY_DISPOSE_DESCRIPTOR_TYPE
+			      : CBTI_DESCRIPTOR_TYPE];
+  if (!*slot)
+    {
+      tree type = make_node (RECORD_TYPE);
+      tree reserved = block_field (loc, type, "reserved",
+				   long_unsigned_type_node);
+      tree size = block_field (loc, type, "size",
+			       long_unsigned_type_node);
+      DECL_CHAIN (reserved) = size;
+      if (copy_dispose_p)
+	{
+	  tree copy = block_field (loc, type, "copy", ptr_type_node);
+	  tree dispose = block_field (loc, type, "dispose", ptr_type_node);
+	  DECL_CHAIN (size) = copy;
+	  DECL_CHAIN (copy) = dispose;
+	}
+      TYPE_FIELDS (type) = reserved;
+      layout_type (type);
+      *slot = type;
+    }
+  return *slot;
+}
+
+/* Build a static descriptor compound literal for BLOCK_TYPE.  */
+
+static tree
+build_block_descriptor (location_t loc, struct c_block_state *state)
+{
+  tree type = block_descriptor_record_type (loc,
+					     state->needs_copy_dispose);
+  tree fields = TYPE_FIELDS (type);
+  vec<constructor_elt, va_gc> *values = NULL;
+  CONSTRUCTOR_APPEND_ELT (values, fields,
+			  build_int_cst (long_unsigned_type_node, 0));
+  fields = DECL_CHAIN (fields);
+  CONSTRUCTOR_APPEND_ELT (values, fields,
+			  fold_convert (long_unsigned_type_node,
+					TYPE_SIZE_UNIT (state->block_type)));
+  if (state->needs_copy_dispose)
+    {
+      fields = DECL_CHAIN (fields);
+      CONSTRUCTOR_APPEND_ELT
+	(values, fields,
+	 fold_convert (ptr_type_node,
+		       build_fold_addr_expr_loc (loc, state->copy_helper_decl)));
+      fields = DECL_CHAIN (fields);
+      CONSTRUCTOR_APPEND_ELT
+	(values, fields,
+	 fold_convert (ptr_type_node,
+		       build_fold_addr_expr_loc (loc,
+						 state->dispose_helper_decl)));
+    }
+  tree constructor = build_constructor (type, values);
+  TREE_CONSTANT (constructor) = 1;
+  TREE_STATIC (constructor) = 1;
+
+  struct c_declspecs *specs = build_null_declspecs ();
+  specs->storage_class = csc_static;
+  return build_compound_literal (loc, type, constructor, false, 0, specs);
+}
+
+/* Turn a completed block state and helper into a concrete literal and return
+   it with its source-level block-pointer type.  */
+
+static tree
+build_block_literal_value (location_t loc, struct c_block_state *state,
+			   tree source_function_type)
+{
+  const bool global_p = state->captures == NULL_TREE;
+  tree descriptor = build_block_descriptor (loc, state);
+  tree field = TYPE_FIELDS (state->block_type);
+  vec<constructor_elt, va_gc> *values = NULL;
+
+  tree runtime_class = block_runtime_class_decl (loc, global_p);
+  tree isa = fold_convert (ptr_type_node,
+			   build_fold_addr_expr_loc (loc, runtime_class));
+  CONSTRUCTOR_APPEND_ELT (values, field, isa);
+
+  unsigned int flags = global_p ? (1U << 28) : 0;
+  if (state->needs_copy_dispose)
+    flags |= 1U << 25;
+  if (aggregate_value_p (state->return_type, state->helper_decl))
+    flags |= 1U << 29;
+  field = DECL_CHAIN (field);
+  CONSTRUCTOR_APPEND_ELT (values, field,
+			  build_int_cst (integer_type_node, flags));
+  field = DECL_CHAIN (field);
+  CONSTRUCTOR_APPEND_ELT (values, field,
+			  build_int_cst (integer_type_node, 0));
+  field = DECL_CHAIN (field);
+  CONSTRUCTOR_APPEND_ELT
+    (values, field,
+     fold_convert (ptr_type_node,
+		   build_fold_addr_expr_loc (loc, state->helper_decl)));
+  field = DECL_CHAIN (field);
+  CONSTRUCTOR_APPEND_ELT
+    (values, field,
+     fold_convert (ptr_type_node, build_fold_addr_expr_loc (loc, descriptor)));
+
+  for (tree capture = state->captures;
+       capture; capture = TREE_CHAIN (capture))
+    {
+      tree original = TREE_PURPOSE (capture);
+      tree value = original;
+      if (VAR_P (original) && C_DECL_BLOCK_BYREF (original))
+	value = block_byref_capture_cell (loc, original);
+      else if (c_current_block
+	  && decl_function_context (original) != current_function_decl)
+	value = c_block_capture_reference (loc, original);
+      if (TREE_CODE (TREE_TYPE (original)) == ARRAY_TYPE
+	  || TREE_CODE (TREE_TYPE (original)) == FUNCTION_TYPE)
+	value = default_conversion (value);
+      field = DECL_CHAIN (field);
+      CONSTRUCTOR_APPEND_ELT (values, field, value);
+    }
+
+  tree constructor = build_constructor (state->block_type, values);
+  TREE_CONSTANT (constructor) = global_p;
+  TREE_STATIC (constructor) = global_p;
+
+  struct c_declspecs *specs = NULL;
+  if (global_p)
+    {
+      specs = build_null_declspecs ();
+      specs->storage_class = csc_static;
+    }
+  tree object = build_compound_literal (loc, state->block_type, constructor,
+					!global_p, 0, specs);
+  if (!global_p)
+    {
+      tree literal = object;
+      if (TREE_CODE (literal) == C_MAYBE_CONST_EXPR)
+	literal = C_MAYBE_CONST_EXPR_EXPR (literal);
+      gcc_assert (TREE_CODE (literal) == COMPOUND_LITERAL_EXPR);
+      tree decl = COMPOUND_LITERAL_EXPR_DECL (literal);
+      DECL_ATTRIBUTES (decl)
+	= tree_cons (get_identifier ("block_stack_literal"), NULL_TREE,
+		     DECL_ATTRIBUTES (decl));
+    }
+  tree address = build_fold_addr_expr_loc (loc, object);
+  tree block_type = build_block_pointer_type (source_function_type);
+  return fold_convert_loc (loc, block_type,
+			   fold_convert_loc (loc, ptr_type_node, address));
+}
+
+/* Parse the most commonly emitted forms of a block literal:
+
+       ^ { statements }
+       ^ ( parameter-declaration-list ) { statements }
+
+   The invoke helper is represented as an ordinary artificial function.  Its
+   first argument is a pointer to the concrete literal record, followed by the
+   user-written parameters.  */
+
+static struct c_expr
+c_parser_block_literal_expression (c_parser *parser)
+{
+  /* Helper declarations have file scope after synthesis.  Their assembler
+     names therefore must be unique across all containing functions, not
+     merely within one owner.  */
+  static unsigned int next_block_number;
+  struct c_expr result;
+  location_t start = c_parser_peek_token (parser)->location;
+  tree block_owner = current_function_decl;
+  while (block_owner
+	 && DECL_CONTEXT (block_owner)
+	 && TREE_CODE (DECL_CONTEXT (block_owner)) == FUNCTION_DECL)
+    block_owner = DECL_CONTEXT (block_owner);
+  c_parser_consume_token (parser);
+
+  /* Blocks permit function attributes both immediately after the caret and
+     after the parameter clause.  Keep them on the synthesized invoke
+     function so attributes such as noreturn, format, nonnull and sentinel
+     participate in the normal function diagnostics.  */
+  tree block_attrs = NULL_TREE;
+  if (c_parser_next_token_is_keyword (parser, RID_ATTRIBUTE))
+    block_attrs = c_parser_gnu_attributes (parser);
+
+  tree written_return_type = NULL_TREE;
+  struct c_arg_info *args = NULL;
+  if (c_parser_next_token_is_not (parser, CPP_OPEN_PAREN)
+      && c_parser_next_token_is_not (parser, CPP_OPEN_BRACE))
+    {
+      struct c_declspecs *return_specs = build_null_declspecs ();
+      c_parser_declspecs (parser, return_specs, false, true, true, false,
+			  false, true, true, cla_prefer_type);
+      if (!return_specs->declspecs_seen_p)
+	{
+	  c_parser_error (parser, "expected block result type");
+	  result.set_error ();
+	  return result;
+	}
+      pending_xref_error ();
+      finish_declspecs (return_specs);
+      bool seen_id = false;
+      struct c_declarator *declarator
+	= c_parser_declarator (parser,
+			       return_specs->typespec_kind != ctsk_none,
+			       C_DTR_BLOCK, &seen_id);
+      if (!declarator)
+	{
+	  result.set_error ();
+	  return result;
+	}
+
+      tree block_decl = grokblockdecl (return_specs, declarator);
+      if (block_decl == error_mark_node)
+	{
+	  if (c_parser_next_token_is (parser, CPP_OPEN_BRACE))
+	    c_parser_skip_to_end_of_block_or_statement (parser);
+	  result.set_error ();
+	  return result;
+	}
+
+      tree block_function_type = TREE_TYPE (block_decl);
+      written_return_type = TREE_TYPE (block_function_type);
+      args = build_arg_info ();
+      args->parms = DECL_ARGUMENTS (block_decl);
+      args->types = TYPE_ARG_TYPES (block_function_type);
+      args->no_named_args_stdarg_p
+	= TYPE_NO_NAMED_ARGS_STDARG_P (block_function_type);
+    }
+
+  if (!args && c_parser_next_token_is (parser, CPP_OPEN_PAREN))
+    {
+      c_parser_consume_token (parser);
+      args = c_parser_parms_declarator (parser, false, NULL_TREE, false);
+      if (!args)
+	{
+	  result.set_error ();
+	  return result;
+	}
+    }
+  else if (!args)
+    {
+      args = build_arg_info ();
+      args->types = void_list_node;
+    }
+
+  if (c_parser_next_token_is_keyword (parser, RID_ATTRIBUTE))
+    block_attrs = chainon (block_attrs, c_parser_gnu_attributes (parser));
+
+  if (c_parser_next_token_is_not (parser, CPP_OPEN_BRACE))
+    {
+      c_parser_error (parser, "blocks require a block body");
+      result.set_error ();
+      return result;
+    }
+
+  tree source_arg_types = args->types;
+  bool no_named_args_stdarg_p = args->no_named_args_stdarg_p;
+  struct c_block_state state = {};
+  state.outer = c_current_block;
+  state.return_type = written_return_type;
+  state.explicit_return_type = written_return_type != NULL_TREE;
+  build_block_literal_record (start, &state);
+
+  tree self_type = build_pointer_type (state.block_type);
+  tree self = build_decl (start, PARM_DECL,
+			  get_identifier ("__block_literal"), self_type);
+  DECL_ARG_TYPE (self) = self_type;
+  TREE_USED (self) = 1;
+  DECL_CHAIN (self) = args->parms;
+  args->parms = self;
+  args->types = tree_cons (NULL_TREE, self_type, args->types);
+
+  char helper_name[48];
+  unsigned int number = ++next_block_number;
+  const char *owner_name
+    = (block_owner && DECL_NAME (block_owner)
+       ? IDENTIFIER_POINTER (DECL_NAME (block_owner)) : "global");
+  snprintf (helper_name, sizeof helper_name, "__%s_block_invoke_%u",
+	    owner_name, number);
+
+  bool nested = current_function_decl != NULL_TREE;
+  struct c_typespec result_spec = {};
+  result_spec.kind = ctsk_typeof;
+  result_spec.spec = written_return_type ? written_return_type : void_type_node;
+  result_spec.expr_const_operands = true;
+  struct c_declspecs *specs = build_null_declspecs ();
+  /* A nested helper is never public; one synthesized for a file-scope
+     literal must not be either, or every translation unit would define
+     the same global __global_block_invoke_N symbol.  */
+  if (!nested)
+    specs->storage_class = csc_static;
+  declspecs_add_type (start, specs, result_spec);
+  finish_declspecs (specs);
+  struct c_declarator *declarator
+    = build_function_declarator
+	(args, build_id_declarator (get_identifier (helper_name)));
+
+  if (nested)
+    c_push_function_context ();
+  if (!start_function (specs, declarator, NULL_TREE))
+    {
+      if (nested)
+	c_pop_function_context ();
+      result.set_error ();
+      return result;
+    }
+
+  state.helper_decl = current_function_decl;
+  /* Argument-number attributes describe the source block signature, which
+     does not include the ABI's hidden literal pointer.  Applying them
+     unchanged to the invoke helper would make format(2,3), nonnull(1), and
+     similar attributes refer to the wrong parameters.  Attributes needed
+     for helper code generation are applied here; the complete list is
+     retained on SOURCE_FUNCTION_TYPE below for source-level checking.  */
+  tree helper_attrs = NULL_TREE;
+  for (tree attr = block_attrs; attr; attr = TREE_CHAIN (attr))
+    if (is_attribute_p ("noreturn", get_attribute_name (attr)))
+      helper_attrs
+	= tree_cons (TREE_PURPOSE (attr), TREE_VALUE (attr), helper_attrs);
+  decl_attributes (&state.helper_decl, helper_attrs, 0);
+  store_parm_decls ();
+  state.self_decl = DECL_ARGUMENTS (current_function_decl);
+  c_current_block = &state;
+
+  location_t end = start;
+  tree body = c_parser_compound_statement (parser, &end);
+  c_current_block = state.outer;
+
+  if (!state.return_type)
+    state.return_type = void_type_node;
+  layout_type (state.block_type);
+  DECL_STATIC_CHAIN (state.helper_decl) = 0;
+  TREE_USED (state.helper_decl) = 1;
+  add_stmt (body);
+  finish_function (end);
+  if (nested)
+    {
+      c_pop_function_context ();
+      add_stmt (build_stmt (start, DECL_EXPR, state.helper_decl));
+    }
+
+  /* The invoke pointer is a plain code pointer.  It must not retain nested
+     function context or cause GCC to manufacture a trampoline.  */
+  DECL_CONTEXT (state.helper_decl) = NULL_TREE;
+
+  if (state.needs_copy_dispose)
+    {
+      state.copy_helper_decl
+	= build_block_copy_dispose_helper (start, &state, number, false);
+      state.dispose_helper_decl
+	= build_block_copy_dispose_helper (start, &state, number, true);
+    }
+
+  tree source_function_type
+    = build_function_type (state.return_type, source_arg_types,
+			   no_named_args_stdarg_p);
+  if (TREE_THIS_VOLATILE (state.helper_decl))
+    source_function_type
+      = build_type_variant (source_function_type,
+			    TYPE_READONLY (source_function_type), 1);
+  source_function_type
+    = build_type_attribute_variant
+	(source_function_type, block_attrs);
+  result.value = build_block_literal_value (start, &state,
+					    source_function_type);
+  protected_set_expr_location (result.value, end);
+  result.original_code = ERROR_MARK;
+  result.original_type = NULL_TREE;
+  result.m_decimal = 0;
+  set_c_expr_source_range (&result, start, end);
+  return result;
+}
 
