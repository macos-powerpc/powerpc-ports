+/* Build the source-language type R (^)(P...).  The pointee is the signature
+   visible to the programmer.  Block invocation lowering supplies the hidden
+   block-object argument required by the runtime ABI.  */
+
+tree
+build_block_pointer_type (tree function_type)
+{
+  gcc_assert (TREE_CODE (function_type) == FUNCTION_TYPE);
+
+  /* Function attributes written after a declarator may rebuild the pointer
+     around a new function-type variant.  Carry the internal distinction on
+     both nodes so that such attributes do not silently turn a block pointer
+     into an ordinary function pointer.  */
+  tree function_attributes
+    = tree_cons (get_identifier ("block_pointer"), NULL_TREE,
+		 TYPE_ATTRIBUTES (function_type));
+  function_type
+    = build_type_attribute_variant (function_type, function_attributes);
+  tree pointer_type = build_pointer_type (function_type);
+  tree attributes = TYPE_ATTRIBUTES (function_type);
+  return build_type_attribute_variant (pointer_type, attributes);
+}
+
+/* Return the external symbol used for a concrete global or stack block.
+   PLBlocks deliberately uses a prefixed ABI so it can coexist with Apple's
+   runtime and hand off to that runtime when it is available.  */
+
+const char *
+c_blocks_runtime_class_name (bool global_p)
+{
+  if (flag_blocks_runtime == BLOCKS_RUNTIME_PLBLOCKS)
+    return global_p ? "_PLConcreteGlobalBlock2"
+		    : "_PLConcreteStackBlock2";
+  return global_p ? "_NSConcreteGlobalBlock" : "_NSConcreteStackBlock";
+}
+
+/* Return the selected runtime's ownership helper symbol.  */
+
+const char *
+c_blocks_runtime_object_function_name (bool dispose_p)
+{
+  if (flag_blocks_runtime == BLOCKS_RUNTIME_PLBLOCKS)
+    return dispose_p ? "_PLBlock_object_dispose"
+		     : "_PLBlock_object_assign";
+  return dispose_p ? "_Block_object_dispose" : "_Block_object_assign";
