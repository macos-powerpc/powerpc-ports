diff -N libplblocks/Makefile
--- /dev/null
+++ libplblocks/Makefile
@@ -0,0 +1,195 @@
+# Standalone build for the vendored PLBlocks macOS runtime.
+#
+# GCC's top-level build uses configure and Makefile.in in this directory.
+# This makefile remains available for focused runtime development and for
+# building the library independently of a complete GCC build tree.
+
+.DEFAULT_GOAL := all
+
+srcdir := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+builddir ?= build
+
+CC ?= cc
+AR ?= ar
+AR_FLAGS ?= rc
+LD = $(shell $(CC) -print-prog-name=ld)
+NM ?= nm
+RANLIB ?= ranlib
+BLOCKS_CC ?= $(CC)
+INSTALL ?= install
+LN_S ?= ln -s
+
+prefix ?= /usr/local
+libdir ?= $(prefix)/lib
+includedir ?= $(prefix)/include
+DESTDIR ?=
+
+MACOSX_DEPLOYMENT_TARGET ?= 10.5
+TARGET_TRIPLE ?= $(shell $(CC) -dumpmachine 2>/dev/null)
+TARGET_ARCH := $(firstword $(subst -, ,$(TARGET_TRIPLE)))
+OBJC_ABI ?= auto
+
+CFLAGS ?= -O2
+CPPFLAGS ?=
+LDFLAGS ?=
+LDLIBS ?= -framework Foundation
+TARGET_FLAGS ?=
+OBJC_GC_FLAGS ?= -fobjc-gc
+MIN_OS_FLAGS ?= -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET)
+
+VERSION ?= 1.0.0
+MAJOR ?= 1
+TEST_CFLAGS ?= -O2 -g
+LIBRARY_BASENAME := libPLBlocks
+LIBRARY_VERSIONED := $(LIBRARY_BASENAME).$(MAJOR).dylib
+LIBRARY_LINK := $(LIBRARY_BASENAME).dylib
+LIBRARY := $(builddir)/$(LIBRARY_VERSIONED)
+STATIC_LIBRARY := $(builddir)/$(LIBRARY_BASENAME).a
+STATIC_OBJECT := $(builddir)/$(LIBRARY_BASENAME)-static.o
+INSTALL_NAME ?= $(libdir)/$(LIBRARY_VERSIONED)
+
+ifeq ($(OBJC_ABI),1)
+ALIAS_LIST := $(srcdir)/config/objc1_symbol_aliases.txt
+else ifeq ($(OBJC_ABI),2)
+ALIAS_LIST := $(srcdir)/config/objc2_symbol_aliases.txt
+else ifneq ($(filter powerpc ppc i386 i486 i586 i686,$(TARGET_ARCH)),)
+ALIAS_LIST := $(srcdir)/config/objc1_symbol_aliases.txt
+else ifneq ($(filter powerpc64 ppc64 x86_64,$(TARGET_ARCH)),)
+ALIAS_LIST := $(srcdir)/config/objc2_symbol_aliases.txt
+else
+ALIAS_LIST :=
+endif
+ALIAS_DEP := $(ALIAS_LIST)
+
+RUNTIME_SOURCES := \
+	$(srcdir)/src/Block.m \
+	$(srcdir)/src/NSBlock.m \
+	$(srcdir)/src/Concrete/PLBlockConcreteLegacy.m
+
+RUNTIME_OBJECTS := \
+	$(builddir)/Block.o \
+	$(builddir)/NSBlock.o \
+	$(builddir)/PLBlockConcreteLegacy.o
+
+TEST_PROGRAMS := \
+	$(builddir)/plblocks-c-runtime \
+	$(builddir)/plblocks-objc-runtime
+
+COMPILE_FLAGS = \
+	$(CPPFLAGS) \
+	-I$(srcdir)/src \
+	-I$(srcdir)/src/Concrete \
+	$(CFLAGS) \
+	$(TARGET_FLAGS) \
+	$(MIN_OS_FLAGS) \
+	$(OBJC_GC_FLAGS)
+
+.PHONY: all check-abi check-target clean compile-check install run-tests \
+	show-config test-programs check-vendor
+
+all: $(LIBRARY) $(builddir)/$(LIBRARY_LINK) $(STATIC_LIBRARY)
+
+compile-check: check-target $(RUNTIME_OBJECTS)
+
+check-target:
+	$(if $(strip $(ALIAS_LIST)),@:,$(error cannot infer the Objective-C ABI for '$(TARGET_TRIPLE)'; set OBJC_ABI=1 or OBJC_ABI=2))
+
+$(builddir):
+	mkdir -p $@
+
+$(builddir)/Block.o: $(srcdir)/src/Block.m \
+		$(srcdir)/src/Block.h $(srcdir)/src/Block_private.h | \
+		$(builddir) check-target
+	$(CC) $(COMPILE_FLAGS) -c $< -o $@
+
+$(builddir)/NSBlock.o: $(srcdir)/src/NSBlock.m \
+		$(srcdir)/src/NSBlock.h $(srcdir)/src/Block.h \
+		$(srcdir)/src/Block_private.h | $(builddir) check-target
+	$(CC) $(COMPILE_FLAGS) -c $< -o $@
+
+$(builddir)/PLBlockConcreteLegacy.o: \
+		$(srcdir)/src/Concrete/PLBlockConcreteLegacy.m \
+		$(srcdir)/src/Concrete/PLBlockConcreteLegacy.h \
+		$(srcdir)/src/NSBlock.h | $(builddir) check-target
+	$(CC) $(COMPILE_FLAGS) -c $< -o $@
+
+$(LIBRARY): $(RUNTIME_OBJECTS) $(ALIAS_DEP)
+	$(if $(strip $(ALIAS_LIST)),,$(error cannot infer the Objective-C ABI for '$(TARGET_TRIPLE)'; set OBJC_ABI=1 or OBJC_ABI=2))
+	$(CC) $(TARGET_FLAGS) $(MIN_OS_FLAGS) $(LDFLAGS) -dynamiclib \
+		-Wl,-alias_list,$(ALIAS_LIST) \
+		-Wl,-install_name,$(INSTALL_NAME) \
+		-Wl,-compatibility_version,$(MAJOR) \
+		-Wl,-current_version,$(VERSION) \
+		-o $@ $(RUNTIME_OBJECTS) $(LDLIBS)
+
+$(builddir)/$(LIBRARY_LINK): $(LIBRARY)
+	cd $(builddir) && $(LN_S) -f $(LIBRARY_VERSIONED) $(LIBRARY_LINK)
+
+$(STATIC_OBJECT): $(RUNTIME_OBJECTS) $(ALIAS_DEP)
+	$(LD) -r -alias_list $(ALIAS_LIST) -o $@ $(RUNTIME_OBJECTS)
+
+$(STATIC_LIBRARY): $(STATIC_OBJECT)
+	rm -f $@
+	$(AR) $(AR_FLAGS) $@ $(STATIC_OBJECT)
+	$(RANLIB) $@
+
+check-abi: $(LIBRARY) $(STATIC_LIBRARY)
+	@for library in $(LIBRARY) $(STATIC_LIBRARY); do \
+	  for symbol in \
+		  __PLBlock_copy \
+		  __PLBlock_release \
+		  __PLBlock_object_assign \
+		  __PLBlock_object_dispose \
+		  __PLConcreteStackBlock2 \
+		  __PLConcreteGlobalBlock2; do \
+	    $(NM) -g $$library | grep -q "[[:space:]]$$symbol$$" || { \
+	      echo "missing required ABI symbol in $$library: $$symbol" >&2; \
+	      exit 1; \
+	    }; \
+	  done; \
+	done
+
+test-programs: all $(TEST_PROGRAMS)
+
+$(builddir)/plblocks-c-runtime: $(srcdir)/testsuite/c-runtime.c $(LIBRARY)
+	$(BLOCKS_CC) $(TARGET_FLAGS) $(MIN_OS_FLAGS) $(TEST_CFLAGS) \
+		-fblocks -fblocks-runtime=plblocks -I$(srcdir)/src \
+		-I$(srcdir)/src/Concrete -L$(builddir) -o $@ $< \
+		-framework Foundation
+
+$(builddir)/plblocks-objc-runtime: \
+		$(srcdir)/testsuite/objc-runtime.m $(LIBRARY)
+	$(BLOCKS_CC) $(TARGET_FLAGS) $(MIN_OS_FLAGS) $(TEST_CFLAGS) \
+		-fblocks -fblocks-runtime=plblocks -I$(srcdir)/src \
+		-I$(srcdir)/src/Concrete -L$(builddir) -o $@ $< \
+		-framework Foundation
+
+run-tests: test-programs
+	DYLD_LIBRARY_PATH=$(builddir) $(builddir)/plblocks-c-runtime
+	DYLD_LIBRARY_PATH=$(builddir) $(builddir)/plblocks-objc-runtime
+
+install: all
+	$(INSTALL) -d $(DESTDIR)$(libdir) $(DESTDIR)$(includedir)
+	$(INSTALL) -m 755 $(LIBRARY) $(DESTDIR)$(libdir)/$(LIBRARY_VERSIONED)
+	$(INSTALL) -m 644 $(STATIC_LIBRARY) \
+		$(DESTDIR)$(libdir)/$(notdir $(STATIC_LIBRARY))
+	$(RANLIB) $(DESTDIR)$(libdir)/$(notdir $(STATIC_LIBRARY))
+	cd $(DESTDIR)$(libdir) && $(LN_S) -f $(LIBRARY_VERSIONED) $(LIBRARY_LINK)
+	$(INSTALL) -m 644 $(srcdir)/src/Block.h $(DESTDIR)$(includedir)/Block.h
+
+show-config:
+	@echo "CC=$(CC)"
+	@echo "TARGET_TRIPLE=$(TARGET_TRIPLE)"
+	@echo "TARGET_ARCH=$(TARGET_ARCH)"
+	@echo "OBJC_ABI=$(OBJC_ABI)"
+	@echo "ALIAS_LIST=$(ALIAS_LIST)"
+	@echo "MACOSX_DEPLOYMENT_TARGET=$(MACOSX_DEPLOYMENT_TARGET)"
+	@echo "INSTALL_NAME=$(INSTALL_NAME)"
+
+check-vendor:
+	cd $(srcdir) && shasum -a 256 -c SHA256SUMS
+
+clean:
+	rm -f $(RUNTIME_OBJECTS) $(LIBRARY) $(builddir)/$(LIBRARY_LINK) \
+		$(STATIC_OBJECT) $(STATIC_LIBRARY) \
+		$(TEST_PROGRAMS)
diff -N libplblocks/Makefile.in
--- /dev/null
+++ libplblocks/Makefile.in
@@ -0,0 +1,201 @@
+# Makefile for the GCC-integrated PLBlocks compatibility runtime.
+
+SHELL = @SHELL@
+MAKEOVERRIDES =
+
+srcdir = @srcdir@
+VPATH = @srcdir@
+prefix = @prefix@
+exec_prefix = @exec_prefix@
+libdir = @libdir@
+target_noncanonical = @target_noncanonical@
+gcc_version := $(shell @get_gcc_base_ver@ $(srcdir)/../gcc/BASE-VER)
+libsubdir = $(libdir)/gcc/$(target_noncanonical)/$(gcc_version)
+multi_basedir = @multi_basedir@
+toolexecdir = @toolexecdir@
+toolexeclibdir = @toolexeclibdir@
+
+MULTISRCTOP =
+MULTIBUILDTOP =
+MULTIDIRS =
+MULTISUBDIR =
+MULTIDO = true
+MULTICLEAN = true
+
+INSTALL = @INSTALL@
+INSTALL_PROGRAM = @INSTALL_PROGRAM@
+INSTALL_DATA = @INSTALL_DATA@
+LN_S = @LN_S@
+AR = @AR@
+AR_FLAGS = rc
+LD = @LD@
+NM = @NM@
+RANLIB = @RANLIB@
+
+CC = @CC@
+CFLAGS = @CFLAGS@
+CPPFLAGS = @CPPFLAGS@
+LDFLAGS = @LDFLAGS@
+
+OBJC_ABI = @objc_abi@
+ALIAS_LIST = @alias_list@
+VERSION = @PACKAGE_VERSION@
+MAJOR = 1
+
+LIBRARY_BASENAME = libPLBlocks
+LIBRARY_VERSIONED = $(LIBRARY_BASENAME).$(MAJOR).dylib
+LIBRARY_LINK = $(LIBRARY_BASENAME).dylib
+STATIC_LIBRARY = $(LIBRARY_BASENAME).a
+STATIC_OBJECT = $(LIBRARY_BASENAME)-static.o
+INSTALL_NAME = $(toolexeclibdir)/$(LIBRARY_VERSIONED)
+
+RUNTIME_SOURCES = \
+	$(srcdir)/src/Block.m \
+	$(srcdir)/src/NSBlock.m \
+	$(srcdir)/src/Concrete/PLBlockConcreteLegacy.m
+
+RUNTIME_OBJECTS = Block.o NSBlock.o PLBlockConcreteLegacy.o
+CHECK_PROGRAMS = plblocks-c-runtime plblocks-objc-runtime
+
+ALL_CFLAGS = $(CPPFLAGS) $(CFLAGS) \
+	-I$(srcdir)/src -I$(srcdir)/src/Concrete -fobjc-gc
+
+FLAGS_TO_PASS = \
+	"AR=$(AR)" \
+	"AR_FLAGS=$(AR_FLAGS)" \
+	"CC=$(CC)" \
+	"CFLAGS=$(CFLAGS)" \
+	"CPPFLAGS=$(CPPFLAGS)" \
+	"DESTDIR=$(DESTDIR)" \
+	"INSTALL=$(INSTALL)" \
+	"INSTALL_DATA=$(INSTALL_DATA)" \
+	"INSTALL_PROGRAM=$(INSTALL_PROGRAM)" \
+	"LD=$(LD)" \
+	"LDFLAGS=$(LDFLAGS)" \
+	"LN_S=$(LN_S)" \
+	"NM=$(NM)" \
+	"RANLIB=$(RANLIB)" \
+	"SHELL=$(SHELL)" \
+	"prefix=$(prefix)" \
+	"exec_prefix=$(exec_prefix)" \
+	"libdir=$(libdir)"
+
+.PHONY: all check check-abi run-tests install install-strip install-libs \
+	install-headers installdirs mostlyclean clean distclean \
+	maintainer-clean info dvi pdf html install-info install-dvi \
+	install-pdf install-html installcheck uninstall TAGS
+
+all: $(LIBRARY_VERSIONED) $(LIBRARY_LINK) $(STATIC_LIBRARY)
+	: $(MAKE); exec $(MULTIDO) $(FLAGS_TO_PASS) multi-do DO=all
+
+Block.o: $(srcdir)/src/Block.m $(srcdir)/src/Block.h \
+	$(srcdir)/src/Block_private.h
+	$(CC) $(ALL_CFLAGS) -c $(srcdir)/src/Block.m -o $@
+
+NSBlock.o: $(srcdir)/src/NSBlock.m $(srcdir)/src/NSBlock.h \
+	$(srcdir)/src/Block.h $(srcdir)/src/Block_private.h
+	$(CC) $(ALL_CFLAGS) -c $(srcdir)/src/NSBlock.m -o $@
+
+PLBlockConcreteLegacy.o: \
+	$(srcdir)/src/Concrete/PLBlockConcreteLegacy.m \
+	$(srcdir)/src/Concrete/PLBlockConcreteLegacy.h \
+	$(srcdir)/src/NSBlock.h
+	$(CC) $(ALL_CFLAGS) -c \
+	  $(srcdir)/src/Concrete/PLBlockConcreteLegacy.m -o $@
+
+$(LIBRARY_VERSIONED): $(RUNTIME_OBJECTS) $(ALIAS_LIST)
+	$(CC) $(CFLAGS) $(LDFLAGS) -dynamiclib \
+	  -Wl,-alias_list,$(ALIAS_LIST) \
+	  -Wl,-install_name,$(INSTALL_NAME) \
+	  -Wl,-compatibility_version,$(MAJOR) \
+	  -Wl,-current_version,$(VERSION) \
+	  -o $@ $(RUNTIME_OBJECTS) -framework Foundation
+
+$(LIBRARY_LINK): $(LIBRARY_VERSIONED)
+	$(LN_S) -f $(LIBRARY_VERSIONED) $(LIBRARY_LINK)
+
+$(STATIC_OBJECT): $(RUNTIME_OBJECTS) $(ALIAS_LIST)
+	$(LD) -r -alias_list $(ALIAS_LIST) -o $@ $(RUNTIME_OBJECTS)
+
+$(STATIC_LIBRARY): $(STATIC_OBJECT)
+	rm -f $@
+	$(AR) $(AR_FLAGS) $@ $(STATIC_OBJECT)
+	$(RANLIB) $@
+
+check: check-abi $(CHECK_PROGRAMS)
+
+plblocks-c-runtime: $(srcdir)/testsuite/c-runtime.c $(LIBRARY_LINK)
+	$(CC) $(CPPFLAGS) $(CFLAGS) -fblocks -fblocks-runtime=plblocks \
+	  -static-libgcc -I$(srcdir)/src -I$(srcdir)/src/Concrete -L. \
+	  -o $@ $(srcdir)/testsuite/c-runtime.c -framework Foundation
+
+plblocks-objc-runtime: $(srcdir)/testsuite/objc-runtime.m $(LIBRARY_LINK)
+	$(CC) $(CPPFLAGS) $(CFLAGS) -fblocks -fblocks-runtime=plblocks \
+	  -static-libgcc -I$(srcdir)/src -I$(srcdir)/src/Concrete -L. \
+	  -o $@ $(srcdir)/testsuite/objc-runtime.m -framework Foundation
+
+run-tests: check
+	DYLD_LIBRARY_PATH=. ./plblocks-c-runtime
+	DYLD_LIBRARY_PATH=. ./plblocks-objc-runtime
+
+check-abi: $(LIBRARY_VERSIONED) $(STATIC_LIBRARY)
+	@for library in $(LIBRARY_VERSIONED) $(STATIC_LIBRARY); do \
+	  for symbol in \
+	    __PLBlock_copy \
+	    __PLBlock_release \
+	    __PLBlock_object_assign \
+	    __PLBlock_object_dispose \
+	    __PLConcreteStackBlock2 \
+	    __PLConcreteGlobalBlock2; do \
+	    $(NM) -g $$library | grep -q "[[:space:]]$$symbol$$" || { \
+	      echo "missing required ABI symbol in $$library: $$symbol" >&2; \
+	      exit 1; \
+	    }; \
+	  done; \
+	done
+
+install: install-libs install-headers
+
+install-strip:
+	$(MAKE) INSTALL_PROGRAM="$(INSTALL_PROGRAM) -s" install
+
+installdirs:
+	$(SHELL) $(multi_basedir)/mkinstalldirs \
+	  $(DESTDIR)$(toolexeclibdir) \
+	  $(DESTDIR)$(libsubdir)/include/PLBlocks
+
+install-libs: all installdirs
+	$(INSTALL_PROGRAM) $(LIBRARY_VERSIONED) \
+	  $(DESTDIR)$(toolexeclibdir)/$(LIBRARY_VERSIONED)
+	$(INSTALL_DATA) $(STATIC_LIBRARY) \
+	  $(DESTDIR)$(toolexeclibdir)/$(STATIC_LIBRARY)
+	$(RANLIB) $(DESTDIR)$(toolexeclibdir)/$(STATIC_LIBRARY)
+	cd $(DESTDIR)$(toolexeclibdir) && \
+	  $(LN_S) -f $(LIBRARY_VERSIONED) $(LIBRARY_LINK)
+	$(MULTIDO) $(FLAGS_TO_PASS) multi-do DO=install-libs
+
+# The PLBlocks header keeps the include path of the original PLBlocks
+# framework.  The <Block.h> installed beside it selects that header only
+# when the PLBlocks runtime is in use, and otherwise defers to the SDK.
+install-headers: installdirs
+	$(INSTALL_DATA) $(srcdir)/src/Block.h \
+	  $(DESTDIR)$(libsubdir)/include/PLBlocks/Block.h
+	$(INSTALL_DATA) $(srcdir)/include/Block.h \
+	  $(DESTDIR)$(libsubdir)/include/Block.h
+
+mostlyclean:
+	-$(MULTICLEAN) multi-clean
+	-rm -f $(RUNTIME_OBJECTS) $(LIBRARY_VERSIONED) $(LIBRARY_LINK) \
+	  $(STATIC_OBJECT) $(STATIC_LIBRARY) \
+	  $(CHECK_PROGRAMS)
+
+clean: mostlyclean
+
+distclean: clean
+	-rm -f Makefile config.status config.cache config.log
+
+maintainer-clean: distclean
+
+info dvi pdf html install-info install-dvi install-pdf install-html \
+installcheck uninstall TAGS:
+	@:
diff -N libplblocks/README
--- /dev/null
+++ libplblocks/README
@@ -0,0 +1,255 @@
+PLBlocks runtime notes
+**********************
+
+This directory contains the Mac OS X runtime portion of PLBlocks.  It
+is included to provide an implementation of the Blocks runtime on
+systems older than Mac OS X 10.6.
+
+The runtime is integrated into GCC as a target library.  A standalone
+makefile is also provided for development and testing independently of
+the rest of GCC.
+
+This file describes the GCC integration, the ABI used by PLBlocks, the
+supported target configurations, and the standalone build procedure.
+
+
+PLBlocks ABI
+============
+
+PLBlocks uses a prefixed ABI so that its symbols do not conflict with
+the Blocks runtime supplied by Apple.
+
+The principal runtime entry points are:
+
+        _PLBlock_copy
+        _PLBlock_release
+        _PLBlock_object_assign
+        _PLBlock_object_dispose
+
+The concrete block symbols are:
+
+        __PLConcreteStackBlock2
+        __PLConcreteGlobalBlock2
+
+These names are intentionally different from the corresponding symbols
+in Apple's Blocks runtime.
+
+On Mac OS X 10.6 and later, PLBlocks attempts to locate Apple's Blocks
+runtime dynamically.  When it is available, block operations are
+passed to the system runtime.
+
+On Mac OS X 10.5, PLBlocks uses its own Objective-C block classes and
+memory-management implementation.
+
+The Apple runtime is found by dynamic lookup rather than by direct
+linkage.  This is necessary because a library linked against the Mac OS
+X 10.5 SDK must not contain undefined references to symbols introduced
+by Apple's Mac OS X 10.6 Blocks runtime.
+
+
+Compiler options
+================
+
+Use the following option to select the collision-safe PLBlocks ABI:
+
+        -fblocks-runtime=plblocks
+
+On Darwin targets, GCC then adds `-lPLBlocks' to the link command
+automatically.  When `-fblocks' is enabled and no runtime is selected
+explicitly, GCC chooses PLBlocks for deployment targets older than Mac
+OS X 10.6.  It chooses the system runtime for Mac OS X 10.6 and later.
+
+The following option overrides the deployment-target selection and uses
+Apple's unprefixed Blocks ABI without linking the PLBlocks compatibility
+library:
+
+        -fblocks-runtime=system
+
+
+Building as a GCC target library
+================================
+
+When Objective-C support is enabled, GCC configures libplblocks by
+default for supported PowerPC and x86 Darwin targets.
+
+The library may be disabled with:
+
+        --disable-libplblocks
+
+The library may be requested explicitly with:
+
+        --enable-libplblocks
+
+When `--enable-libplblocks' is used on an unsupported target, configure
+reports an error rather than silently building a library with the wrong
+Objective-C ABI.
+
+The usual GCC target-library commands are:
+
+        make all-target-libplblocks
+        make check-target-libplblocks
+        make install-target-libplblocks
+
+The configured build uses GCC's target compiler and inherits
+`CFLAGS_FOR_TARGET' and `LDFLAGS_FOR_TARGET'.
+
+Libplblocks also participates in GCC multilib configuration.  A
+separate library may therefore be built for each enabled target
+multilib.
+
+The Objective-C ABI is selected according to the target architecture.
+The Objective-C ABI 1 symbol aliases are used for 32-bit slices, and
+the Objective-C ABI 2 aliases are used for 64-bit slices.
+
+Installation places:
+
+        libPLBlocks.1.dylib
+        libPLBlocks.a
+
+and the corresponding:
+
+        libPLBlocks.dylib
+
+linker symlink in GCC's target library directory.
+
+The public PLBlocks header is installed in GCC's private target include
+directory as `PLBlocks/Block.h', the include path used by the original
+PLBlocks framework.  A small `Block.h' (from `include/Block.h') is
+installed beside it.  When the PLBlocks runtime is selected the compiler
+predefines `__PLBLOCKS__', and that `Block.h' includes the PLBlocks
+header, whose `Block_copy' and `Block_release' call `_PLBlock_copy' and
+`_PLBlock_release'.  Otherwise it uses `#include_next' to reach the SDK's
+`Block.h'.  This keeps `#include <Block.h>' working with the system
+runtime on Mac OS X 10.6 and later, where the PLBlocks entry points are
+not linked.
+
+The `check-target-libplblocks' target verifies that the required
+PL-prefixed ABI symbols are exported.  It also compile-links the C and
+Objective-C runtime test programs.
+
+For a native build, the tests may also be executed with:
+
+        make -C TARGET-SUBDIR/libplblocks run-tests
+
+
+Target architecture and Objective-C ABI
+=======================================
+
+PLBlocks uses Mach-O alias lists to convert Objective-C class symbols
+into the concrete block `isa' pointers required by the Blocks ABI.
+
+The following configurations are used:
+
+        Target                  Objective-C ABI    Alias list
+        ------                  ---------------    ----------
+        powerpc, i386           ABI 1              config/objc1_symbol_aliases.txt
+        powerpc64, x86_64       ABI 2              config/objc2_symbol_aliases.txt
+        arm64, aarch64          system runtime     no PLBlocks fallback
+
+The PLBlocks fallback is not built for ARM64 targets.  Those targets use
+the system Blocks runtime.
+
+The integrated 32-bit PowerPC library has been built against the Mac OS
+X 10.5 SDK with the GCC 13 version of this port, from which the GCC 16
+version is derived.
+
+The following parts of that configuration have been checked:
+
+        * the GCC installation layout;
+        * the Mach-O install name;
+        * the exported PLBlocks ABI symbols;
+        * automatic linking by the GCC driver;
+        * the C runtime test; and
+        * the Objective-C runtime test.
+
+Both runtime tests pass on Mac OS X 10.5.8 running on PowerPC.
+
+The PowerPC 64-bit and Intel libraries have not yet received equivalent
+target-system validation.
+
+
+Standalone build
+================
+
+The standalone makefile builds one architecture slice at a time.
+
+The output of:
+
+        CC -dumpmachine
+
+is used to select the Objective-C alias list automatically.
+
+The selection may be overridden by setting either:
+
+        OBJC_ABI=1
+
+or:
+
+        OBJC_ABI=2
+
+For example, a PowerPC cross-build for Mac OS X 10.5 may be started
+with:
+
+        make -C libplblocks \
+          CC='/path/to/powerpc-apple-darwin9-gcc -B/path/to/cross-binutils/' \
+          MACOSX_DEPLOYMENT_TARGET=10.5
+
+
+Standalone make targets
+=======================
+
+The standalone makefile provides the following targets.
+
+`compile-check'
+     Compile all runtime objects without linking the library.
+
+`all'
+     Build `libPLBlocks.1.dylib' and `libPLBlocks.a'.
+
+`check-abi'
+     Build both libraries and verify that the required ABI symbols are
+     exported by each.
+
+`test-programs'
+     Cross-compile the standalone C and Objective-C runtime tests.
+
+`run-tests'
+     Build and execute the runtime tests.  This target is useful only
+     for a native target, or where the target programs can otherwise be
+     executed by the build system.
+
+`install'
+     Install the dynamic and static libraries and the public `Block.h'
+     header.
+
+`show-config'
+     Display the target configuration inferred by the makefile,
+     including the selected Objective-C ABI.
+
+`check-vendor'
+     Verify the hashes of the checked-in vendor sources.
+
+
+Objective-C garbage collection
+==============================
+
+The standalone build uses `-fobjc-gc' by default.
+
+This corresponds to the old Xcode project setting:
+
+        GCC_ENABLE_OBJC_GC = supported
+
+For a target which does not provide Objective-C garbage collection,
+build with:
+
+        OBJC_GC_FLAGS=
+
+
+Vendored sources
+================
+
+The PLBlocks sources in this directory are vendored rather than
+maintained as an independent copy of the original project.
+
+See `VENDORING' for information about the source provenance, omitted
+files, local changes, and recorded hashes.
