+  tree initializer_type = TREE_TYPE (decl);
+  bool byref_p = VAR_P (decl) && C_DECL_BLOCK_BYREF (decl);
+  if (block_capture_ownership_flag (decl))
+    c_current_block->needs_copy_dispose = true;
+  if (byref_p)
