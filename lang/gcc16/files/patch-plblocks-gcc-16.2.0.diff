diff -N gcc/testsuite/objc.dg/blocks-gc-1.m
--- /dev/null
+++ gcc/testsuite/objc.dg/blocks-gc-1.m
@@ -0,0 +1,29 @@
+/* Block pointers participate in the legacy Objective-C GC barriers.  */
+/* { dg-do compile { target *-*-darwin* } } */
+/* { dg-options "-fblocks -fobjc-gc" } */
+
+void (^strong_global) (void);
+void (^__weak weak_global) (void);
+
+struct block_slot
+{
+  void (^value) (void);
+};
+
+void
+store_blocks (struct block_slot *slot, void (^value) (void))
+{
+  strong_global = value;
+  weak_global = value;
+  slot->value = value;
+}
+
+void (^read_weak_block (void)) (void)
+{
+  return weak_global;
+}
+
+/* { dg-final { scan-assembler "objc_assign_global" } } */
+/* { dg-final { scan-assembler "objc_assign_weak" } } */
+/* { dg-final { scan-assembler "objc_assign_strongCast" } } */
+/* { dg-final { scan-assembler "objc_read_weak" } } */
diff -N gcc/testsuite/objc.dg/objc-gc-super-1.m
--- /dev/null
+++ gcc/testsuite/objc.dg/objc-gc-super-1.m
@@ -0,0 +1,22 @@
+/* A GC write barrier must not intercept initialization of the local
+   objc_super record used for a super send.  */
+/* { dg-do compile { target *-*-darwin* } } */
+/* { dg-options "-fobjc-gc" } */
+
+@interface gc_super_base
+- (id) value;
+@end
+
+@interface gc_super_subclass : gc_super_base
+- (id) value;
+@end
+
+@implementation gc_super_subclass
+- (id) value
+{
+  return [super value];
+}
+@end
+
+/* { dg-final { scan-assembler "objc_msgSendSuper" } } */
+/* { dg-final { scan-assembler-not "objc_assign_strongCast" } } */
