+/* Return true when an objc_gc attribute denotes weak ownership.  */
+
+static bool
+block_byref_weak_p (tree decl, tree type)
+{
+  tree attr = lookup_attribute ("objc_gc", DECL_ATTRIBUTES (decl));
+  if (!attr)
+    attr = lookup_attribute ("objc_gc", TYPE_ATTRIBUTES (type));
+  if (!attr || !TREE_VALUE (attr))
+    return false;
+  tree value = TREE_VALUE (TREE_VALUE (attr));
+  return (value && TREE_CODE (value) == IDENTIFIER_NODE
+	  && id_equal (value, "weak"));
+}
+
+/* Return a declaration for one of the Blocks ownership runtime hooks.  */
+
+static tree
+block_byref_runtime_function (location_t loc, bool dispose_p)
+{
+  tree *slot = &c_block_trees[dispose_p ? CBTI_OBJECT_DISPOSE
+					: CBTI_OBJECT_ASSIGN];
+  if (!*slot)
+    {
+      const char *name
+	= c_blocks_runtime_object_function_name (dispose_p);
+      tree type;
+      if (dispose_p)
+	type = build_function_type_list (void_type_node, ptr_type_node,
+					 integer_type_node, NULL_TREE);
+      else
+	type = build_function_type_list (void_type_node, ptr_type_node,
+					 ptr_type_node, integer_type_node,
+					 NULL_TREE);
+      *slot = build_decl (loc, FUNCTION_DECL, get_identifier (name), type);
+      DECL_EXTERNAL (*slot) = 1;
+      TREE_PUBLIC (*slot) = 1;
+      TREE_USED (*slot) = 1;
+    }
+  return *slot;
+}
+
+/* Synthesize a byref keep or destroy helper.  The runtime invokes these with
+   untyped cell pointers; the helper recovers the concrete cell and forwards
+   ownership of its value through the normal Blocks runtime hooks.  */
+
+static tree
+build_block_byref_helper (location_t loc, tree cell_type, tree value_field,
+			  unsigned int number, int ownership_flag,
+			  bool dispose_p)
+{
+  struct c_arg_info *args = build_arg_info ();
+  tree first = build_decl (loc, PARM_DECL,
+			   get_identifier (dispose_p ? "__src" : "__dst"),
+			   ptr_type_node);
+  DECL_ARG_TYPE (first) = ptr_type_node;
+  TREE_USED (first) = 1;
+
+  if (dispose_p)
+    {
+      args->parms = first;
+      args->types = tree_cons (NULL_TREE, ptr_type_node, void_list_node);
+    }
+  else
+    {
+      tree second = build_decl (loc, PARM_DECL, get_identifier ("__src"),
+				ptr_type_node);
+      DECL_ARG_TYPE (second) = ptr_type_node;
+      TREE_USED (second) = 1;
+      DECL_CHAIN (first) = second;
+      args->parms = first;
+      args->types
+	= tree_cons (NULL_TREE, ptr_type_node,
+		     tree_cons (NULL_TREE, ptr_type_node, void_list_node));
+    }
+
+  char name[64];
+  snprintf (name, sizeof name,
+	    dispose_p ? "__Block_byref_object_dispose_%u"
+		      : "__Block_byref_object_copy_%u",
+	    number);
+  bool nested = current_function_decl != NULL_TREE;
+  struct c_typespec result_spec = {};
+  result_spec.kind = ctsk_typeof;
+  result_spec.spec = void_type_node;
+  result_spec.expr_const_operands = true;
+  struct c_declspecs *specs = build_null_declspecs ();
+  if (!nested)
+    specs->storage_class = csc_static;
+  declspecs_add_type (loc, specs, result_spec);
+  finish_declspecs (specs);
+  struct c_declarator *declarator
+    = build_function_declarator
+	(args, build_id_declarator (get_identifier (name)));
+
+  if (nested)
+    c_push_function_context ();
+  if (!start_function (specs, declarator, NULL_TREE))
+    {
+      if (nested)
+	c_pop_function_context ();
+      return error_mark_node;
+    }
+
+  tree helper = current_function_decl;
+  store_parm_decls ();
+  tree dst_or_src = DECL_ARGUMENTS (helper);
+  tree src = dispose_p ? dst_or_src : DECL_CHAIN (dst_or_src);
+  tree cell_pointer = build_pointer_type (cell_type);
+  tree typed_src = fold_convert_loc (loc, cell_pointer, src);
+  tree src_cell = build_indirect_ref (loc, typed_src, RO_ARROW);
+  tree src_value
+    = build3_loc (loc, COMPONENT_REF, TREE_TYPE (value_field),
+		  src_cell, value_field, NULL_TREE);
+  tree runtime = block_byref_runtime_function (loc, dispose_p);
+  tree call;
+  ownership_flag |= 128;  /* BLOCK_BYREF_CALLER.  */
+
+  if (dispose_p)
+    call = build_function_call
+      (loc, runtime,
+       tree_cons (NULL_TREE, src_value,
+		  tree_cons (NULL_TREE,
+			     build_int_cst (integer_type_node, ownership_flag),
+			     NULL_TREE)));
+  else
+    {
+      tree typed_dst = fold_convert_loc (loc, cell_pointer, dst_or_src);
+      tree dst_cell = build_indirect_ref (loc, typed_dst, RO_ARROW);
+      tree dst_value
+	= build3_loc (loc, COMPONENT_REF, TREE_TYPE (value_field),
+		      dst_cell, value_field, NULL_TREE);
+      tree destination
+	= fold_convert_loc (loc, ptr_type_node,
+			    build_fold_addr_expr_loc (loc, dst_value));
+      call = build_function_call
+	(loc, runtime,
+	 tree_cons
+	   (NULL_TREE, destination,
+	    tree_cons
+	      (NULL_TREE, src_value,
+	       tree_cons (NULL_TREE,
+			  build_int_cst (integer_type_node, ownership_flag),
+			  NULL_TREE))));
+    }
+
+  tree stmt = c_begin_compound_stmt (true);
+  add_stmt (call);
+  tree body = c_end_compound_stmt (loc, stmt, true);
+  DECL_STATIC_CHAIN (helper) = 0;
+  TREE_USED (helper) = 1;
+  add_stmt (body);
+  finish_function (loc);
+  if (nested)
+    {
+      c_pop_function_context ();
+      add_stmt (build_stmt (loc, DECL_EXPR, helper));
+    }
+  DECL_CONTEXT (helper) = NULL_TREE;
+  return helper;
+}
+
+/* Lower a local declared with __attribute__((blocks(byref))) to the
+   forwarding-cell prefix defined by the Blocks ABI:
+
+     { void *isa; cell *forwarding; int flags; int size; T value; }
+
+   References retain their source-level type because build_external_ref
+   redirects them through forwarding->value.  */
+
+static tree
+lower_block_byref_decl (tree decl, location_t loc, tree initializer)
+{
