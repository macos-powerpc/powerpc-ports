+
+   BLOCK is wrapped in a SAVE_EXPR because it occurs both in the invoke-field
+   load and as the hidden first argument.  */
+
+static tree
+build_block_invoke (location_t loc, tree block, tree fntype,
+		    tree *hidden_argument)
+{
+  tree invoke_field;
+  tree literal_type = block_literal_generic_type (&invoke_field);
+  tree saved_block = save_expr (block);
+  tree literal_pointer = build_pointer_type (literal_type);
+  tree converted_block = fold_convert_loc (loc, literal_pointer, saved_block);
+  tree literal = build_indirect_ref (loc, converted_block, RO_UNARY_STAR);
+  tree invoke = build3_loc (loc, COMPONENT_REF, TREE_TYPE (invoke_field),
+			    literal, invoke_field, NULL_TREE);
+
+  tree argument_types = tree_cons (NULL_TREE, ptr_type_node,
+				   TYPE_ARG_TYPES (fntype));
+  tree invoke_type = build_function_type (TREE_TYPE (fntype),
+					  argument_types);
+  *hidden_argument = fold_convert_loc (loc, ptr_type_node, saved_block);
+  return fold_convert_loc (loc, build_pointer_type (invoke_type), invoke);
+}
