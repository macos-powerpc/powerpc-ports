+.PHONY: configure-target-libplblocks maybe-configure-target-libplblocks
+maybe-configure-target-libplblocks:
+@if gcc-bootstrap
+configure-target-libplblocks: stage_current
+@endif gcc-bootstrap
+@if target-libplblocks
+maybe-configure-target-libplblocks: configure-target-libplblocks
+configure-target-libplblocks: 
+	@: $(MAKE); $(unstage)
+	@r=`${PWD_COMMAND}`; export r; \
+	s=`cd $(srcdir); ${PWD_COMMAND}`; export s; \
+	echo "Checking multilib configuration for libplblocks..."; \
+	$(SHELL) $(srcdir)/mkinstalldirs $(TARGET_SUBDIR)/libplblocks; \
+	$(CC_FOR_TARGET) --print-multi-lib > $(TARGET_SUBDIR)/libplblocks/multilib.tmp 2> /dev/null; \
+	if test -r $(TARGET_SUBDIR)/libplblocks/multilib.out; then \
+	  if cmp -s $(TARGET_SUBDIR)/libplblocks/multilib.tmp $(TARGET_SUBDIR)/libplblocks/multilib.out; then \
+	    rm -f $(TARGET_SUBDIR)/libplblocks/multilib.tmp; \
+	  else \
+	    rm -f $(TARGET_SUBDIR)/libplblocks/Makefile; \
+	    mv $(TARGET_SUBDIR)/libplblocks/multilib.tmp $(TARGET_SUBDIR)/libplblocks/multilib.out; \
+	  fi; \
+	else \
+	  mv $(TARGET_SUBDIR)/libplblocks/multilib.tmp $(TARGET_SUBDIR)/libplblocks/multilib.out; \
+	fi; \
+	test ! -f $(TARGET_SUBDIR)/libplblocks/Makefile || exit 0; \
+	$(SHELL) $(srcdir)/mkinstalldirs $(TARGET_SUBDIR)/libplblocks; \
+	$(NORMAL_TARGET_EXPORTS)  \
+	echo Configuring in $(TARGET_SUBDIR)/libplblocks; \
+	cd "$(TARGET_SUBDIR)/libplblocks" || exit 1; \
+	case $(srcdir) in \
+	  /* | [A-Za-z]:[\\/]*) topdir=$(srcdir) ;; \
+	  *) topdir=`echo $(TARGET_SUBDIR)/libplblocks/ | \
+		sed -e 's,\./,,g' -e 's,[^/]*/,../,g' `$(srcdir) ;; \
+	esac; \
+	module_srcdir=libplblocks; \
+	rm -f no-such-file || : ; \
+	CONFIG_SITE=no-such-file $(SHELL) \
+	  $$s/$$module_srcdir/configure \
+	  --srcdir=$${topdir}/$$module_srcdir \
+	  $(TARGET_CONFIGARGS) --build=${build_alias} --host=${target_alias} \
+	  --target=${target_alias}  \
+	  || exit 1
+@endif target-libplblocks
