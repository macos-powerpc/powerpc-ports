diff -N libplblocks/testsuite/c-runtime.c
--- /dev/null
+++ libplblocks/testsuite/c-runtime.c
@@ -0,0 +1,112 @@
+/*
+ * Focused execution tests for the PLBlocks ABI and the GCC Blocks lowering.
+ */
+
+#include "Block.h"
+#include "Block_private.h"
+#include "PLBlockConcrete.h"
+
+#include <stdio.h>
+
+static int failures;
+
+#define CHECK(EXPRESSION)						\
+  do									\
+    {									\
+      if (!(EXPRESSION))						\
+	{								\
+	  fprintf (stderr, "%s:%d: check failed: %s\n",			\
+		   __FILE__, __LINE__, #EXPRESSION);			\
+	  ++failures;							\
+	}								\
+    }									\
+  while (0)
+
+struct triple
+{
+  long first;
+  long second;
+  long third;
+};
+
+static int (^global_block) (void) = ^{ return 42; };
+
+static int
+apply (int (^block) (int), int value)
+{
+  return block (value);
+}
+
+static int (^
+copy_accumulator (int initial)) (int)
+{
+  __block int total = initial;
+  return PLBlock_copy (^(int value) {
+    total += value;
+    return total;
+  });
+}
+
+static int (^
+copy_nested_adder (int base)) (int)
+{
+  int (^inner) (int) = PLBlock_copy (^(int value) {
+    return base + value;
+  });
+  int (^outer) (int) = PLBlock_copy (^(int value) {
+    return inner (value) + 1;
+  });
+  PLBlock_release (inner);
+  return outer;
+}
+
+int
+main (void)
+{
+  struct Block_layout *global_layout = (struct Block_layout *) global_block;
+  CHECK (global_block () == 42);
+  CHECK ((global_layout->flags & BLOCK_IS_GLOBAL) != 0);
+  CHECK (global_layout->isa == (void *) &_PLConcreteGlobalBlock2);
+  CHECK (PLBlock_copy (global_block) == global_block);
+  PLBlock_release (global_block);
+
+  int captured = 17;
+  int (^stack_block) (int) = ^(int value) {
+    return captured + value;
+  };
+  struct Block_layout *stack_layout = (struct Block_layout *) stack_block;
+  CHECK (stack_layout->isa == (void *) &_PLConcreteStackBlock2);
+  CHECK (apply (stack_block, 5) == 22);
+
+  int (^heap_block) (int) = PLBlock_copy (stack_block);
+  CHECK (heap_block (8) == 25);
+  PLBlock_release (heap_block);
+
+  int (^accumulator) (int) = copy_accumulator (10);
+  CHECK (accumulator (2) == 12);
+  CHECK (accumulator (5) == 17);
+  PLBlock_release (accumulator);
+
+  int (^nested) (int) = copy_nested_adder (30);
+  CHECK (nested (11) == 42);
+  PLBlock_release (nested);
+
+  struct triple (^structure_block) (long) = ^(long value) {
+    struct triple result = { value, value + 1, value + 2 };
+    return result;
+  };
+  struct triple result = structure_block (40);
+  CHECK (result.first == 40);
+  CHECK (result.second == 41);
+  CHECK (result.third == 42);
+  CHECK ((((struct Block_layout *) structure_block)->flags
+	  & BLOCK_USE_STRET) != 0);
+
+  if (failures)
+    {
+      fprintf (stderr, "PLBlocks C runtime: %d failure(s)\n", failures);
+      return 1;
+    }
+  puts ("PLBlocks C runtime: PASS");
+  return 0;
+}
diff -N libplblocks/testsuite/objc-runtime.m
--- /dev/null
+++ libplblocks/testsuite/objc-runtime.m
@@ -0,0 +1,91 @@
+/*
+ * Objective-C ownership and object-behavior tests for PLBlocks.
+ */
+
+#import "Block.h"
+
+#import <Foundation/Foundation.h>
+
+#include <stdio.h>
+
+static int failures;
+static int live_witnesses;
+
+#define CHECK(EXPRESSION)						\
+  do									\
+    {									\
+      if (!(EXPRESSION))						\
+	{								\
+	  fprintf (stderr, "%s:%d: check failed: %s\n",			\
+		   __FILE__, __LINE__, #EXPRESSION);			\
+	  ++failures;							\
+	}								\
+    }									\
+  while (0)
+
+@interface PLBlocksWitness : NSObject
+{
+  int value;
+}
+- (id)initWithValue:(int)newValue;
+- (int)value;
+@end
+
+@implementation PLBlocksWitness
+- (id)initWithValue:(int)newValue
+{
+  self = [super init];
+  if (self)
+    {
+      value = newValue;
+      ++live_witnesses;
+    }
+  return self;
+}
+
+- (int)value
+{
+  return value;
+}
+
+- (void)dealloc
+{
+  --live_witnesses;
+  [super dealloc];
+}
+@end
+
+int
+main (void)
+{
+  NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+
+  PLBlocksWitness *witness
+    = [[PLBlocksWitness alloc] initWithValue:42];
+  int (^stack_block) (void) = ^{ return [witness value]; };
+  int (^heap_block) (void) = [stack_block copy];
+
+  [witness release];
+  CHECK (live_witnesses == 1);
+  CHECK (heap_block () == 42);
+  CHECK ([heap_block retainCount] >= 1);
+
+  [heap_block release];
+  CHECK (live_witnesses == 0);
+
+  int (^global_block) (void) = ^{ return 7; };
+  CHECK ([global_block copy] == global_block);
+  CHECK (global_block () == 7);
+  [global_block release];
+
+  [pool drain];
+
+  if (failures)
+    {
+      fprintf (stderr, "PLBlocks Objective-C runtime: %d failure(s)\n",
+	       failures);
+      return 1;
+    }
+  puts ("PLBlocks Objective-C runtime: PASS");
+  return 0;
+}
