+/* Validate the implementation attribute used by the __block macro.  The C
+   front end performs the actual forwarding-cell lowering in finish_decl.  */
+
+static tree
+handle_blocks_attribute (tree *node, tree name, tree args,
+			 int ARG_UNUSED (flags), bool *no_add_attrs)
+{
+  tree argument = args ? TREE_VALUE (args) : NULL_TREE;
+  if (!VAR_P (*node)
+      || !argument
+      || TREE_CODE (argument) != IDENTIFIER_NODE
+      || strcmp (IDENTIFIER_POINTER (argument), "byref") != 0)
+    {
+      if (TREE_CODE (*node) == PARM_DECL)
+	error ("__block attribute can be specified on variables only");
+      else
+	warning (OPT_Wattributes, "%qE attribute ignored", name);
+      *no_add_attrs = true;
+    }
+  return NULL_TREE;
+}
