+/* Return the ABI prefix used by every Blocks literal.  The invoke field is
+   deliberately represented as void * here; each call site casts it to the
+   exact hidden-argument function type derived from the block's source type.
+
+     struct __block_literal_generic {
+       void *isa;
+       int flags;
+       int reserved;
+       void *invoke;
+     };
+
+   Building this as an internal tree type keeps the implementation independent
+   of pointer size and target record layout.  */
+
+static tree
+block_literal_generic_type (tree *invoke_field)
+{
+  tree type = c_block_trees[CBTI_LITERAL_GENERIC_TYPE];
+  tree invoke = c_block_trees[CBTI_LITERAL_INVOKE_FIELD];
+
+  if (!type)
+    {
+      type = make_node (RECORD_TYPE);
+
+      tree isa = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+			     get_identifier ("isa"), ptr_type_node);
+      tree flags = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+			       get_identifier ("flags"), integer_type_node);
+      tree reserved = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+				  get_identifier ("reserved"),
+				  integer_type_node);
+      invoke = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+			   get_identifier ("invoke"), ptr_type_node);
+
+      DECL_FIELD_CONTEXT (isa) = type;
+      DECL_FIELD_CONTEXT (flags) = type;
+      DECL_FIELD_CONTEXT (reserved) = type;
+      DECL_FIELD_CONTEXT (invoke) = type;
+      DECL_CHAIN (isa) = flags;
+      DECL_CHAIN (flags) = reserved;
+      DECL_CHAIN (reserved) = invoke;
+      TYPE_FIELDS (type) = isa;
+      layout_type (type);
+      c_block_trees[CBTI_LITERAL_GENERIC_TYPE] = type;
+      c_block_trees[CBTI_LITERAL_INVOKE_FIELD] = invoke;
+    }
+
+  *invoke_field = invoke;
+  return type;
+}
