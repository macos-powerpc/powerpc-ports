+/* Debuggers on Darwin use a generic description of the Blocks ABI rather
+   than treating a block as an ordinary function pointer.  This mirrors the
+   type emitted by Apple GCC:
+
+     struct __block_literal_generic {
+       void *__isa;
+       int __flags;
+       int __reserved;
+       void *__FuncPtr;
+       struct __block_descriptor *__descriptor;
+     };
+
+   Keep this debug-only type separate from the concrete, capture-dependent
+   record used to lower each block literal.  */
+
+static GTY(()) tree block_literal_debug_type;
+
+static tree
+build_block_literal_debug_type (void)
+{
+  tree descriptor = make_node (RECORD_TYPE);
+  TYPE_NAME (descriptor) = get_identifier ("__block_descriptor");
+  tree reserved = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+			      get_identifier ("reserved"),
+			      long_unsigned_type_node);
+  tree size = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+			  get_identifier ("Size"), long_unsigned_type_node);
+  DECL_CHAIN (reserved) = size;
+  DECL_FIELD_CONTEXT (reserved) = descriptor;
+  DECL_FIELD_CONTEXT (size) = descriptor;
+  TYPE_FIELDS (descriptor) = reserved;
+  layout_type (descriptor);
+
+  tree literal = make_node (RECORD_TYPE);
+  TYPE_NAME (literal) = get_identifier ("__block_literal_generic");
+  tree isa = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+			 get_identifier ("__isa"), ptr_type_node);
+  tree flags = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+			   get_identifier ("__flags"), integer_type_node);
+  tree reserved_field = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+				    get_identifier ("__reserved"),
+				    integer_type_node);
+  tree invoke = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+			    get_identifier ("__FuncPtr"), ptr_type_node);
+  tree descriptor_field
+    = build_decl (UNKNOWN_LOCATION, FIELD_DECL,
+		  get_identifier ("__descriptor"),
+		  build_pointer_type (descriptor));
+  DECL_CHAIN (isa) = flags;
+  DECL_CHAIN (flags) = reserved_field;
+  DECL_CHAIN (reserved_field) = invoke;
+  DECL_CHAIN (invoke) = descriptor_field;
+  for (tree field = isa; field; field = DECL_CHAIN (field))
+    DECL_FIELD_CONTEXT (field) = literal;
+  TYPE_FIELDS (literal) = isa;
+  TYPE_ATTRIBUTES (literal)
+    = tree_cons (get_identifier ("block_literal"), NULL_TREE,
+		 TYPE_ATTRIBUTES (literal));
+  layout_type (literal);
+  return literal;
+}
+
+/* Return the debugger-facing representation of a block pointer.  */
+
+tree
+c_get_debug_type (const_tree type)
+{
+  if (!BLOCK_POINTER_TYPE_P (type))
+    return NULL_TREE;
+  if (!block_literal_debug_type)
+    block_literal_debug_type = build_block_literal_debug_type ();
+  return build_pointer_type (block_literal_debug_type);
+}
