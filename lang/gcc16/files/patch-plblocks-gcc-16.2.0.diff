+					  RO_ARROW);
+	tree captured = build3_loc (loc, COMPONENT_REF, TREE_TYPE (field),
+				    object, field, NULL_TREE);
+	if (VAR_P (decl) && C_DECL_BLOCK_BYREF (decl))
+	  return c_block_byref_value
+	    (loc, build_indirect_ref (loc, captured, RO_ARROW));
+	return captured;
