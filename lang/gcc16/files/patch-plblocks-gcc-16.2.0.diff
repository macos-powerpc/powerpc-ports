+/* Runtime ownership classification for one imported declaration.  */
+
+static int
+block_capture_ownership_flag (tree decl)
+{
+  if (VAR_P (decl) && C_DECL_BLOCK_BYREF (decl))
+    return 8;  /* BLOCK_FIELD_IS_BYREF.  */
+  tree type = TREE_TYPE (decl);
+  if (BLOCK_POINTER_TYPE_P (type))
+    return 7;  /* BLOCK_FIELD_IS_BLOCK.  */
