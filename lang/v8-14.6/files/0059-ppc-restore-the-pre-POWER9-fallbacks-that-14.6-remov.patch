From 3fbc8c438fb7d1c3fa2f9cc5ca4db1b34d0a0f74 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Wed, 11 Nov 2026 17:32:22 +0000
Subject: [PATCH 59/70] ppc: restore the pre-POWER9 fallbacks that 14.6 removed

14.6 moved the ppc64 backend's floor from POWER8 to POWER9 (BUILD.gn
compiles it with -mcpu=pwr9, cpu-features.h starts the PPC list at
PPC_9_PLUS): the CpuFeatures::IsSupported(PPC_9_PLUS) checks around
modsw/moduw/modsd/modud (MacroAssembler::Mod{S,U}{32,64} and the
kPPC_Mod* code-generator cases) and cnttzw/cnttzd (CountTrailingZerosU32/
U64) went away together with their fallbacks, and SupportsWasmSimd128()
became `return true` under a DCHECK.  All of these are ISA 3.0; none
exists on a G4/G5, and kPPC_Mod32 is live code (every optimized int32
`%` in JS).

Put the 13.6 shape back:

- the feature check with the 13.6 fallback: src - (src / value) * value
  through a pushed scratch in the masm helpers, ASSEMBLE_MODULO in the
  code generator (re-added with its 13.6 text: 14.6 had dropped the
  then-unused macro);
- a branch-free pre-POWER9 count-trailing-zeros: (src - 1) & ~src is the
  mask of the trailing zero bits (all ones for src == 0), so ctz =
  width - clz(mask); r0 is the scratch.  13.6's loop needed two
  caller-provided scratches that the 14.6 signature no longer has.  The
  only callers are the ppc Liftoff hooks (Liftoff bails out on ppc32);
- SupportsWasmSimd128() = IsSupported(PPC_9_PLUS) again: with 14.6's
  unconditional true a G5 would accept wasm SIMD modules and emit VSX.

The 64-bit variants keep the previous commit's PPC64 gating.  The 13.6
convention for pre-POWER7/8 fallbacks (compile-time, since those
enumerators are gone) does not apply here: PPC_9_PLUS still exists and
the Darwin probe never sets it, so the runtime check is the upstreamable
form.

Not touched: MoveToCrFromXer (mcrxrx, ISA 3.0; its only users are the ppc
Maglev backend, which this build does not compile) - part of the Maglev
work.

Assisted-by: Claude Fable 5.1 <noreply@anthropic.com>
---
 v8/src/codegen/ppc/assembler-ppc.cc           |  3 +-
 v8/src/codegen/ppc/macro-assembler-ppc.cc     | 67 +++++++++++++++++--
 .../backend/ppc/code-generator-ppc.cc         | 33 +++++++--
 3 files changed, 93 insertions(+), 10 deletions(-)

diff --git a/v8/src/codegen/ppc/assembler-ppc.cc b/v8/src/codegen/ppc/assembler-ppc.cc
index d562716..11c7623 100644
--- a/v8/src/codegen/ppc/assembler-ppc.cc
+++ b/v8/src/codegen/ppc/assembler-ppc.cc
@@ -59,8 +59,7 @@ static CpuFeatureSet CpuFeaturesImpliedByCompiler() {
 
 bool CpuFeatures::SupportsWasmSimd128() {
 #if V8_ENABLE_WEBASSEMBLY
-  DCHECK(CpuFeatures::IsSupported(PPC_9_PLUS));
-  return true;
+  return CpuFeatures::IsSupported(PPC_9_PLUS);
 #else
   return false;
 #endif  // V8_ENABLE_WEBASSEMBLY
diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index dbc1c5b..34f5e7a 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -3158,9 +3158,20 @@ void MacroAssembler::DivU32(Register dst, Register src, Register value, OEBit s,
   ZeroExtWord32(dst, dst);
 }
 
+// modsw/moduw/modsd/modud are ISA 3.0 (POWER9); below that the remainder is
+// src - (src / value) * value through a pushed scratch, as before 14.6.
 void MacroAssembler::ModS64(Register dst, Register src, Register value) {
 #if V8_TARGET_ARCH_PPC64
-  modsd(dst, src, value);
+  if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
+    modsd(dst, src, value);
+  } else {
+    Register scratch = GetRegisterThatIsNotOneOf(dst, src, value);
+    Push(scratch);
+    divd(scratch, src, value);
+    mulld(scratch, scratch, value);
+    sub(dst, src, scratch);
+    Pop(scratch);
+  }
 #else
   UNREACHABLE();
 #endif
@@ -3168,20 +3179,47 @@ void MacroAssembler::ModS64(Register dst, Register src, Register value) {
 
 void MacroAssembler::ModU64(Register dst, Register src, Register value) {
 #if V8_TARGET_ARCH_PPC64
-  modud(dst, src, value);
+  if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
+    modud(dst, src, value);
+  } else {
+    Register scratch = GetRegisterThatIsNotOneOf(dst, src, value);
+    Push(scratch);
+    divdu(scratch, src, value);
+    mulld(scratch, scratch, value);
+    sub(dst, src, scratch);
+    Pop(scratch);
+  }
 #else
   UNREACHABLE();
 #endif
 }
 
 void MacroAssembler::ModS32(Register dst, Register src, Register value) {
-  modsw(dst, src, value);
+  if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
+    modsw(dst, src, value);
+  } else {
+    Register scratch = GetRegisterThatIsNotOneOf(dst, src, value);
+    Push(scratch);
+    divw(scratch, src, value);
+    mullw(scratch, scratch, value);
+    sub(dst, src, scratch);
+    Pop(scratch);
+  }
 #if V8_TARGET_ARCH_PPC64
   extsw(dst, dst);
 #endif
 }
 void MacroAssembler::ModU32(Register dst, Register src, Register value) {
-  moduw(dst, src, value);
+  if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
+    moduw(dst, src, value);
+  } else {
+    Register scratch = GetRegisterThatIsNotOneOf(dst, src, value);
+    Push(scratch);
+    divwu(scratch, src, value);
+    mullw(scratch, scratch, value);
+    sub(dst, src, scratch);
+    Pop(scratch);
+  }
   ZeroExtWord32(dst, dst);
 }
 
@@ -5608,15 +5646,36 @@ void MacroAssembler::CountLeadingZerosU64(Register dst, Register src, RCBit r) {
   cntlzd(dst, src, r);
 }
 
+// cnttzw/cnttzd are ISA 3.0 (POWER9).  Below that: (src - 1) & ~src is the
+// mask of src's trailing zero bits (all ones for src == 0), so
+// ctz(src) = width - clz(mask).  r0 is the scratch; dst may alias src.
 void MacroAssembler::CountTrailingZerosU32(Register dst, Register src,
                                            RCBit r) {
+  if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
     cnttzw(dst, src, r);
+    return;
+  }
+  DCHECK(dst != r0 && src != r0);
+  addi(r0, src, Operand(-1));
+  andc(r0, r0, src);
+  cntlzw(dst, r0);
+  subfic(dst, dst, Operand(32));
+  if (r == SetRC) cmpwi(dst, Operand::Zero());
 }
 
 void MacroAssembler::CountTrailingZerosU64(Register dst, Register src,
                                            RCBit r) {
 #if V8_TARGET_ARCH_PPC64
+  if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
     cnttzd(dst, src, r);
+    return;
+  }
+  DCHECK(dst != r0 && src != r0);
+  addi(r0, src, Operand(-1));
+  andc(r0, r0, src);
+  cntlzd(dst, r0);
+  subfic(dst, dst, Operand(64));
+  if (r == SetRC) cmpi(dst, Operand::Zero());
 #else
   UNREACHABLE();
 #endif
diff --git a/v8/src/compiler/backend/ppc/code-generator-ppc.cc b/v8/src/compiler/backend/ppc/code-generator-ppc.cc
index 9953182..0055aa5 100644
--- a/v8/src/compiler/backend/ppc/code-generator-ppc.cc
+++ b/v8/src/compiler/backend/ppc/code-generator-ppc.cc
@@ -452,6 +452,15 @@ Condition FlagsConditionToCondition(FlagsCondition condition, ArchOpcode op) {
     DCHECK_EQ(SetRC, i.OutputRCBit());                                    \
   } while (0)
 
+#define ASSEMBLE_MODULO(div_instr, mul_instr)                        \
+  do {                                                               \
+    const Register scratch = kScratchReg;                            \
+    __ div_instr(scratch, i.InputRegister(0), i.InputRegister(1));   \
+    __ mul_instr(scratch, scratch, i.InputRegister(1));              \
+    __ sub(i.OutputRegister(), i.InputRegister(0), scratch, LeaveOE, \
+           i.OutputRCBit());                                         \
+  } while (0)
+
 #define ASSEMBLE_FLOAT_MODULO()                                             \
   do {                                                                      \
     FrameScope scope(masm(), StackFrame::MANUAL);                           \
@@ -1629,19 +1638,35 @@ CodeGenerator::CodeGenResult CodeGenerator::AssembleArchInstruction(
       ASSEMBLE_FLOAT_BINOP_RC(fdiv, MiscField::decode(instr->opcode()));
       break;
     case kPPC_Mod32:
-      __ modsw(i.OutputRegister(), i.InputRegister(0), i.InputRegister(1));
+      if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
+        __ modsw(i.OutputRegister(), i.InputRegister(0), i.InputRegister(1));
+      } else {
+        ASSEMBLE_MODULO(divw, mullw);
+      }
       break;
 #if V8_TARGET_ARCH_PPC64
     case kPPC_Mod64:
-      __ modsd(i.OutputRegister(), i.InputRegister(0), i.InputRegister(1));
+      if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
+        __ modsd(i.OutputRegister(), i.InputRegister(0), i.InputRegister(1));
+      } else {
+        ASSEMBLE_MODULO(divd, mulld);
+      }
       break;
 #endif
     case kPPC_ModU32:
-      __ moduw(i.OutputRegister(), i.InputRegister(0), i.InputRegister(1));
+      if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
+        __ moduw(i.OutputRegister(), i.InputRegister(0), i.InputRegister(1));
+      } else {
+        ASSEMBLE_MODULO(divwu, mullw);
+      }
       break;
 #if V8_TARGET_ARCH_PPC64
     case kPPC_ModU64:
-      __ modud(i.OutputRegister(), i.InputRegister(0), i.InputRegister(1));
+      if (CpuFeatures::IsSupported(PPC_9_PLUS)) {
+        __ modud(i.OutputRegister(), i.InputRegister(0), i.InputRegister(1));
+      } else {
+        ASSEMBLE_MODULO(divdu, mulld);
+      }
       break;
 #endif
     case kPPC_ModDouble:
