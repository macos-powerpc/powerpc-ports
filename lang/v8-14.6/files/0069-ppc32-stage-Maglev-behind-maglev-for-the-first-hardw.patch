From 6c57f0f2a94272e15f65327c4ce237652359cb08 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Thu, 12 Nov 2026 01:19:26 +0000
Subject: [PATCH 69/70] ppc32: stage Maglev behind --maglev for the first
 hardware cycle

The ppc32 Maglev backend (the preceding commits) has only been
derived statically.  With V8_ENABLE_MAGLEV on, --maglev defaults to
true, so every hot function on the first build would go through it:
the existing d8 smoke battery, node_mksnapshot's bootstrap JS and
npm would all turn into Maglev tests at once, and a wrong body would
show up far from its cause.

Default --maglev to false on V8_TARGET_ARCH_PPC.  The tiers already
validated on the G5 (Ignition, TurboFan) keep running everywhere,
and Maglev runs where it is asked for: `d8 --maglev`, the port's
d8-smoke-maglev.js, `node --maglev`.  Once that battery is green on
hardware, revert this commit; node then gets Maglev without a node
side change.  --future and --maglev-future still imply --maglev.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 v8/src/flags/flag-definitions.h | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/v8/src/flags/flag-definitions.h b/v8/src/flags/flag-definitions.h
index 2e22fac..18b0ff4 100644
--- a/v8/src/flags/flag-definitions.h
+++ b/v8/src/flags/flag-definitions.h
@@ -602,7 +602,12 @@ DEFINE_BOOL(force_emit_interrupt_budget_checks, false,
             "force emit tier-up logic from all non-turbofan code, even if it "
             "is the top enabled tier")
 #ifdef V8_ENABLE_MAGLEV
+#if V8_TARGET_ARCH_PPC
+// ppc32: staged, pass --maglev until the backend has passed on hardware.
+DEFINE_BOOL(maglev, false, "enable the maglev optimizing compiler")
+#else
 DEFINE_BOOL(maglev, true, "enable the maglev optimizing compiler")
+#endif
 #if !ENABLE_MAGLEV
 // Enable Maglev on Future for platforms in which it's not enabled by default
 // (eg, Android).
