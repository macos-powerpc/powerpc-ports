From 565666d9d9a2bd1707061aeed992f193be0f9e34 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:37:54 +0000
Subject: [PATCH 19/70] ppc32: disable Liftoff

12.4 re-derivation of the 9.4-series patch 0003.  The Liftoff half
carries over intact: the ppc Liftoff implementation targets 64-bit
registers and spill slots, so bail out of every function in
PrepareStackFrame (the file is liftoff-assembler-ppc-inl.h now) and
default --liftoff to off on ppc32 to skip the wasted pass.  Wasm then
always compiles with TurboFan via Int64Lowering.

The 9.4 patch's other half - the per-arch Code::kHeaderPaddingSize
entry - is obsolete: the 11.x Code/InstructionStream split replaced
the hand-maintained per-arch table with generically computed padding
(kCodeAlignmentMinusCodeHeader plus TrailingPaddingSizeFor), guarded
by static_assert(kCodeAlignment >= kHeaderSize).  Checked by hand for
ppc32: kCodeAlignment is 32 (kCodeAlignmentBits 5 on non-x64/ppc64)
and the ISTREAM_FIELDS header is at most 24 bytes with kTaggedSize 4
and the embedded-constant-pool field, so the assert holds.
---
 v8/src/flags/flag-definitions.h                      | 7 +++++++
 v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h | 6 ++++++
 2 files changed, 13 insertions(+)

diff --git a/v8/src/flags/flag-definitions.h b/v8/src/flags/flag-definitions.h
index 15d4341..2e22fac 100644
--- a/v8/src/flags/flag-definitions.h
+++ b/v8/src/flags/flag-definitions.h
@@ -1935,8 +1935,15 @@ DEFINE_INT(wasm_stack_switching_stack_size, V8_DEFAULT_STACK_SIZE_KB,
 // depends on the stack limit margin and the platform's page size.
 DEFINE_VALUE_IMPLICATION(experimental_wasm_growable_stacks,
                          wasm_stack_switching_stack_size, 1)
+#if V8_TARGET_ARCH_PPC
+// The ppc Liftoff code targets 64-bit registers; on ppc32 every function
+// bails out to TurboFan anyway, so skip the wasted Liftoff pass.
+DEFINE_BOOL(liftoff, false,
+            "enable Liftoff, the baseline compiler for WebAssembly")
+#else
 DEFINE_BOOL(liftoff, true,
             "enable Liftoff, the baseline compiler for WebAssembly")
+#endif
 DEFINE_BOOL(liftoff_only, false,
             "disallow TurboFan compilation for WebAssembly (for testing)")
 DEFINE_IMPLICATION(liftoff_only, liftoff)
diff --git a/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h b/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h
index 7aaca19..39ad586 100644
--- a/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h
+++ b/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h
@@ -137,6 +137,12 @@ inline void StoreToMemory(LiftoffAssembler* assm, MemOperand dst,
 
 int LiftoffAssembler::PrepareStackFrame() {
   int offset = pc_offset();
+#if !V8_TARGET_ARCH_PPC64
+  // The ppc Liftoff implementation targets 64-bit registers and spill
+  // slots; on ppc32 it would need i64 register pairs throughout.  Bail
+  // out of every function so wasm always compiles with TurboFan.
+  bailout(kUnsupportedArchitecture, "ppc32");
+#endif
   addi(sp, sp, Operand::Zero());
   return offset;
 }
