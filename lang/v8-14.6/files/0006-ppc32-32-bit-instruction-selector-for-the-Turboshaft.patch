+#if !V8_TARGET_ARCH_PPC64
+// The Int32Pair / Word32Pair operations exist only on 32-bit targets (the
+// generic selector marks them unsupported under V8_TARGET_ARCH_64_BIT); the
+// pair opcodes they select are still in instruction-codes-ppc.h and the code
+// generator.  Re-derived in Turboshaft-only form from the 12.4 port.
+namespace {
+// Shared routine for multiple pair binary operations.
+void VisitPairBinop(InstructionSelector* selector, InstructionCode opcode,
+                    InstructionCode opcode2, OpIndex node) {
+  PPCOperandGenerator g(selector);
+  const Word32PairBinopOp& op = selector->Cast<Word32PairBinopOp>(node);
+
+  OptionalOpIndex projection1 = selector->FindProjection(node, 1);
+  if (projection1.valid()) {
+    // We use UseUniqueRegister here to avoid register sharing with the output
+    // registers.
+    InstructionOperand inputs[] = {
+        g.UseRegister(op.left_low()), g.UseUniqueRegister(op.left_high()),
+        g.UseRegister(op.right_low()), g.UseUniqueRegister(op.right_high())};
+
+    InstructionOperand outputs[] = {g.DefineAsRegister(node),
+                                    g.DefineAsRegister(projection1.value())};
+
+    selector->Emit(opcode, 2, outputs, 4, inputs);
+  } else {
+    // The high word of the result is not used, so we emit the standard 32 bit
+    // instruction.
+    selector->Emit(opcode2, g.DefineSameAsFirst(node),
+                   g.UseRegister(op.left_low()), g.UseRegister(op.right_low()));
+  }
+}
+}  // namespace
+
+void InstructionSelector::VisitInt32PairAdd(OpIndex node) {
+  VisitPairBinop(this, kPPC_AddPair, kPPC_Add32, node);
+}
+
+void InstructionSelector::VisitInt32PairSub(OpIndex node) {
+  VisitPairBinop(this, kPPC_SubPair, kPPC_Sub, node);
+}
+
+void InstructionSelector::VisitInt32PairMul(OpIndex node) {
+  PPCOperandGenerator g(this);
+  const Word32PairBinopOp& op = Cast<Word32PairBinopOp>(node);
+  OptionalOpIndex projection1 = FindProjection(node, 1);
+  if (projection1.valid()) {
+    InstructionOperand inputs[] = {
+        g.UseUniqueRegister(op.left_low()), g.UseUniqueRegister(op.left_high()),
+        g.UseUniqueRegister(op.right_low()),
+        g.UseUniqueRegister(op.right_high())};
+
+    InstructionOperand outputs[] = {g.DefineAsRegister(node),
+                                    g.DefineAsRegister(projection1.value())};
+
+    InstructionOperand temps[] = {g.TempRegister(), g.TempRegister()};
+
+    Emit(kPPC_MulPair, 2, outputs, 4, inputs, 2, temps);
+  } else {
+    // The high word of the result is not used, so we emit the standard 32 bit
+    // instruction.
+    Emit(kPPC_Mul32, g.DefineSameAsFirst(node), g.UseRegister(op.left_low()),
+         g.UseRegister(op.right_low()));
+  }
+}
+
+namespace {
+// Shared routine for multiple pair shift operations.
+void VisitPairShift(InstructionSelector* selector, InstructionCode opcode,
+                    OpIndex node) {
+  PPCOperandGenerator g(selector);
+  // The pair shifts are Word32PairBinopOps whose right_low() is the shift
+  // count (ia32/arm spell them the same way).
+  const Word32PairBinopOp& op = selector->Cast<Word32PairBinopOp>(node);
+  // We use g.UseUniqueRegister here to guarantee that there is
+  // no register aliasing of input registers with output registers.
+  InstructionOperand shift_operand;
+  OpIndex shift_by = op.right_low();
+  if (g.CanBeImmediate(shift_by, kShift64Imm)) {
+    shift_operand = g.UseImmediate(shift_by);
+  } else {
+    shift_operand = g.UseUniqueRegister(shift_by);
+  }
+
+  InstructionOperand inputs[] = {g.UseUniqueRegister(op.left_low()),
+                                 g.UseUniqueRegister(op.left_high()),
+                                 shift_operand};
+
+  OptionalOpIndex projection1 = selector->FindProjection(node, 1);
+
+  InstructionOperand outputs[2];
+  InstructionOperand temps[1];
+  int32_t output_count = 0;
+  int32_t temp_count = 0;
+
+  outputs[output_count++] = g.DefineAsRegister(node);
+  if (projection1.valid()) {
+    outputs[output_count++] = g.DefineAsRegister(projection1.value());
+  } else {
+    temps[temp_count++] = g.TempRegister();
+  }
+
+  selector->Emit(opcode, output_count, outputs, 3, inputs, temp_count, temps);
+}
+}  // namespace
+
+void InstructionSelector::VisitWord32PairShl(OpIndex node) {
+  VisitPairShift(this, kPPC_ShiftLeftPair, node);
+}
+
+void InstructionSelector::VisitWord32PairShr(OpIndex node) {
+  VisitPairShift(this, kPPC_ShiftRightPair, node);
+}
+
+void InstructionSelector::VisitWord32PairSar(OpIndex node) {
+  VisitPairShift(this, kPPC_ShiftRightAlgPair, node);
+}
