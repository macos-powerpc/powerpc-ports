From 9dedc8ab7830209c3b2652fbe2f8bc7ccaa9943b Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Thu, 12 Nov 2026 01:08:13 +0000
Subject: [PATCH 66/70] maglev: let the generic Maglev files build for ppc32

The ppc Maglev backend (src/maglev/ppc, upstream ppc64 only) is made
32-bit by the following commits; this one adapts the six places in
the generic Maglev files that name the target.  All of them are
compiled only with V8_ENABLE_MAGLEV, except the two arch ladders in
maglev-graph-builder.cc that the kFloat64Round and kMathClz32 commits
already answered.

- maglev-assembler-inl.h, maglev-regalloc.cc: include the ppc
  assembler and register headers for V8_TARGET_ARCH_PPC as well
  (otherwise #error).  The two macros are mutually exclusive
  (v8config.h).

- maglev-code-generator.cc: keep the trampoline pool blocked while
  the deopt exits are emitted on ppc32 too.  The Deoptimizer
  constructor finds an exit's index by dividing its offset from the
  first exit by kEagerDeoptExitSize/kLazyDeoptExitSize (3
  instructions, deoptimizer-ppc.cc), so a trampoline pool emitted
  between two exits would shift every later index; the ppc32
  assembler has the same pool as ppc64.

- maglev-ir.h, Float64Modulus: the ppc backend implements it with
  CallCFunction(mod_two_doubles_operation), but on ppc64 (and s390x)
  the node is a plain Float64 node, so the register allocator keeps
  values live in volatile FPRs across the C call (f0-f13 are volatile
  in the ELFv2, AIX and Darwin ABIs; the body's MultiPush covers
  r3-r11 only).  Put PPC64 and PPC on the list of targets where it is
  a node with OpProperties::Call(), so live registers are spilled
  (SpillAndClearRegisters) and, in debug builds, allow_call matches.
  The node then needs MaxCallStackArgs(), defined in maglev-ir-ppc.cc.

- maglev-ir.h, Float64Sqrt: the ppc backend emits fsqrt, an optional
  instruction that the 970 (G5) has and G3/G4 do not.  The series
  routes TurboFan's Float64Sqrt through base::ieee754::sqrt
  (ieee754_sqrt_function); Maglev's node does the same on ppc32 and
  therefore becomes a call node there (Float64() | Call(), plus
  MaxCallStackArgs), like Float64Ieee754Unary.  Cost: on ppc32 the
  node is no longer pure, so it is not hoisted or value-numbered
  across; the graph optimizer's constant folding (VisitFloat64Sqrt)
  is unaffected.  ppc64 keeps the pure node and fsqrt.

- maglev-assembler.h, Move(Register, intptr_t): declared only for
  64-bit targets, because on the 32-bit targets Maglev upstream
  supports (arm Linux) intptr_t is `int` and Move(Register, int32_t)
  covers it.  On Darwin, intptr_t is `long` on 32-bit too, so the
  generic calls that pass one - IntPtrConstant::DoLoadToRegister,
  CheckTypedArrayBounds with an IntPtrConstant length, the two
  constant-typed-array loads (reinterpret_cast<intptr_t>(data_ptr))
  - match neither the int32_t nor the uint32_t overload exactly and
  are ambiguous.  Declare it for Darwin ppc32 as well; the ppc
  definition (mov(dst, Operand(p))) serves both widths.  Same class as
  the Word32Constant(sizeof(int32_t)) commit: Darwin's ILP32 types
  are `long`-based.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 v8/src/maglev/maglev-assembler-inl.h   |  2 +-
 v8/src/maglev/maglev-assembler.h       |  3 ++-
 v8/src/maglev/maglev-code-generator.cc |  2 +-
 v8/src/maglev/maglev-ir.h              | 20 +++++++++++++++-----
 v8/src/maglev/maglev-regalloc.cc       |  2 +-
 5 files changed, 20 insertions(+), 9 deletions(-)

diff --git a/v8/src/maglev/maglev-assembler-inl.h b/v8/src/maglev/maglev-assembler-inl.h
index 217a998..e99cb57 100644
--- a/v8/src/maglev/maglev-assembler-inl.h
+++ b/v8/src/maglev/maglev-assembler-inl.h
@@ -29,7 +29,7 @@
 #include "src/maglev/x64/maglev-assembler-x64-inl.h"
 #elif V8_TARGET_ARCH_S390X
 #include "src/maglev/s390/maglev-assembler-s390-inl.h"
-#elif V8_TARGET_ARCH_PPC64
+#elif V8_TARGET_ARCH_PPC64 || V8_TARGET_ARCH_PPC
 #include "src/maglev/ppc/maglev-assembler-ppc-inl.h"
 #elif V8_TARGET_ARCH_LOONG64
 #include "src/maglev/loong64/maglev-assembler-loong64-inl.h"
diff --git a/v8/src/maglev/maglev-assembler.h b/v8/src/maglev/maglev-assembler.h
index f07d406..9190027 100644
--- a/v8/src/maglev/maglev-assembler.h
+++ b/v8/src/maglev/maglev-assembler.h
@@ -472,7 +472,8 @@ class V8_EXPORT_PRIVATE MaglevAssembler : public MacroAssembler {
   inline void Move(Register dst, Tagged<TaggedIndex> i);
   inline void Move(Register dst, int32_t i);
   inline void Move(Register dst, uint32_t i);
-#ifdef V8_TARGET_ARCH_64_BIT
+#if defined(V8_TARGET_ARCH_64_BIT) || \
+    (defined(V8_TARGET_ARCH_PPC) && defined(V8_OS_DARWIN))
   inline void Move(Register dst, intptr_t p);
 #endif
   inline void Move(Register dst, IndirectPointerTag i);
diff --git a/v8/src/maglev/maglev-code-generator.cc b/v8/src/maglev/maglev-code-generator.cc
index ebea290..5717f47 100644
--- a/v8/src/maglev/maglev-code-generator.cc
+++ b/v8/src/maglev/maglev-code-generator.cc
@@ -1856,7 +1856,7 @@ bool MaglevCodeGenerator::EmitDeopts() {
   deopt_exit_start_offset_ = __ pc_offset();
 
   int deopt_index = 0;
-#ifdef V8_TARGET_ARCH_PPC64
+#if defined(V8_TARGET_ARCH_PPC64) || defined(V8_TARGET_ARCH_PPC)
   Assembler::BlockTrampolinePoolScope block_trampoline_pool(masm());
 #endif
   __ RecordComment("-- Non-lazy deopts");
diff --git a/v8/src/maglev/maglev-ir.h b/v8/src/maglev/maglev-ir.h
index d372004..b1ef4e7 100644
--- a/v8/src/maglev/maglev-ir.h
+++ b/v8/src/maglev/maglev-ir.h
@@ -3474,11 +3474,12 @@ DEF_FLOAT64_BINARY_NODE(Add)
 DEF_FLOAT64_BINARY_NODE(Subtract)
 DEF_FLOAT64_BINARY_NODE(Multiply)
 DEF_FLOAT64_BINARY_NODE(Divide)
-#if defined(V8_TARGET_ARCH_ARM64) || defined(V8_TARGET_ARCH_ARM) || \
-    defined(V8_TARGET_ARCH_RISCV64) || defined(V8_TARGET_ARCH_LOONG64)
-// On Arm/Arm64/Riscv64/LoongArch64, floating point modulus is implemented with
-// a call to a C++ function, while on x64, it's implemented natively without
-// call.
+#if defined(V8_TARGET_ARCH_ARM64) || defined(V8_TARGET_ARCH_ARM) ||       \
+    defined(V8_TARGET_ARCH_RISCV64) || defined(V8_TARGET_ARCH_LOONG64) || \
+    defined(V8_TARGET_ARCH_PPC64) || defined(V8_TARGET_ARCH_PPC)
+// On Arm/Arm64/Riscv64/LoongArch64/PPC, floating point modulus is implemented
+// with a call to a C++ function, while on x64, it's implemented natively
+// without call.
 DEF_FLOAT64_BINARY_NODE_WITH_CALL(Modulus)
 #else
 DEF_FLOAT64_BINARY_NODE(Modulus)
@@ -3650,9 +3651,18 @@ class Float64Sqrt : public FixedInputValueNodeT<1, Float64Sqrt> {
  public:
   explicit Float64Sqrt(uint64_t bitfield) : Base(bitfield) {}
 
+#ifdef V8_TARGET_ARCH_PPC
+  // No fsqrt before the 970: ppc32 calls the C library.
+  static constexpr OpProperties kProperties =
+      OpProperties::Float64() | OpProperties::Call();
+#else
   static constexpr OpProperties kProperties = OpProperties::Float64();
+#endif
   DECLARE_UNOP(Float64)
 
+#ifdef V8_TARGET_ARCH_PPC
+  int MaxCallStackArgs() const;
+#endif
   void SetValueLocationConstraints();
   void GenerateCode(MaglevAssembler*, const ProcessingState&);
   void PrintParams(std::ostream&) const;
diff --git a/v8/src/maglev/maglev-regalloc.cc b/v8/src/maglev/maglev-regalloc.cc
index bdfc78b..5612059 100644
--- a/v8/src/maglev/maglev-regalloc.cc
+++ b/v8/src/maglev/maglev-regalloc.cc
@@ -38,7 +38,7 @@
 #include "src/codegen/x64/register-x64.h"
 #elif V8_TARGET_ARCH_S390X
 #include "src/codegen/s390/register-s390.h"
-#elif V8_TARGET_ARCH_PPC64
+#elif V8_TARGET_ARCH_PPC64 || V8_TARGET_ARCH_PPC
 #include "src/codegen/ppc/register-ppc.h"
 #elif V8_TARGET_ARCH_LOONG64
 #include "src/codegen/loong64/register-loong64.h"
