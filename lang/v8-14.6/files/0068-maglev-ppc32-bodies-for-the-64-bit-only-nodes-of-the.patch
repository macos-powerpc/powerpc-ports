   Register left = ToRegister(LeftInput());
   Register right = ToRegister(RightInput());
   Register out = ToRegister(result());
+#if V8_TARGET_ARCH_PPC64
     __ sub(out, left, right, SetOE);
     __ MoveToCrFromXer(cr0);
+#else
