 void Int32MultiplyWithOverflow::SetValueLocationConstraints() {
@@ -421,6 +478,7 @@ void Int32MultiplyWithOverflow::GenerateCode(MaglevAssembler* masm,
 
   // TODO(leszeks): peephole optimise multiplication by a constant.
 
+#if V8_TARGET_ARCH_PPC64
   MaglevAssembler::TemporaryRegisterScope temps(masm);
   Register temp = temps.AcquireScratch();
   __ mullw(out, left, right, SetOE, SetRC);
@@ -444,6 +502,33 @@ void Int32MultiplyWithOverflow::GenerateCode(MaglevAssembler* masm,
   __ EmitEagerDeoptIf(lt, DeoptimizeReason::kOverflow, this);
 
   __ bind(&end);
+#else
+  // No XER: the product fits iff the high word is the sign of the low word
+  // (as kPPC_Mul32WithHigh32).  Keep left and right intact for the -0 test.
+  MaglevAssembler::TemporaryRegisterScope temps(masm);
+  Register res_high = temps.AcquireScratch();
+  Register res_low =
+      (out == left || out == right) ? temps.AcquireScratch() : out;
+  __ mulhw(res_high, left, right);
+  __ mullw(res_low, left, right);
+  __ srawi(r0, res_low, 31);
+  __ CmpS32(res_high, r0);
+  DCHECK_REGLIST_EMPTY(RegList{out} &
+                       GetGeneralRegistersUsedAsInputs(eager_deopt_info()));
+  __ EmitEagerDeoptIf(ne, DeoptimizeReason::kOverflow, this);
+
+  // If the result is zero, check if either lhs or rhs is negative.
+  Label end;
+  __ CmpS32(res_low, Operand::Zero(), r0);
+  __ bne(&end);
+  __ orx(r0, left, right, SetRC);
+  // If one of them is negative, we must have a -0 result, which is non-int32,
+  // so deopt.
+  __ EmitEagerDeoptIf(lt, DeoptimizeReason::kOverflow, this);
+
+  __ bind(&end);
+  __ Move(out, res_low);
+#endif
 }
 
 void Int32DivideWithOverflow::SetValueLocationConstraints() {
@@ -498,6 +583,7 @@ void Int32DivideWithOverflow::GenerateCode(MaglevAssembler* masm,
   __ bind(*done);
 
   // Perform the actual integer division.
+#if V8_TARGET_ARCH_PPC64
   __ divw(out, left, right, LeaveOE, SetRC);
   __ EmitEagerDeoptIf(overflow, DeoptimizeReason::kNotInt32, this);
 
@@ -505,8 +591,21 @@ void Int32DivideWithOverflow::GenerateCode(MaglevAssembler* masm,
   __ mullw(r0, out, right);
   __ sub(r0, left, r0, LeaveOE, SetRC);
   __ EmitEagerDeoptIf(ne, DeoptimizeReason::kNotInt32, this);
+#else
+  // The deferred checks above rule out the cases divw cannot represent; the
+  // remainder check must read left and right, so do not divide into them.
+  MaglevAssembler::TemporaryRegisterScope temps(masm);
+  Register res = (out == left || out == right) ? temps.AcquireScratch() : out;
+  __ divw(res, left, right);
+
+  // Check that the remainder is zero.
+  __ mullw(r0, res, right);
+  __ sub(r0, left, r0, LeaveOE, SetRC);
+  __ EmitEagerDeoptIf(ne, DeoptimizeReason::kNotInt32, this);
+  __ Move(out, res);
+#endif
 
-  __ extsw(out, out);
+  __ SignExtend32To64Bits(out, out);
 }
 
