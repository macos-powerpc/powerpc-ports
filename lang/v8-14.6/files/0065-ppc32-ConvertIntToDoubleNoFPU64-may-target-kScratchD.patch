From fdd5b983a664cfbfa47e703ed7f6463c6f52348c Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Thu, 12 Nov 2026 01:14:47 +0000
Subject: [PATCH 65/70] ppc32: ConvertIntToDoubleNoFPU64 may target
 kScratchDoubleReg

The ppc32 int32/uint32 -> double conversion (the G3/G4 path that
replaces fcfid) builds 2^52 + value on the stack and subtracts the
bias, which it loads into kScratchDoubleReg (d13); it DCHECKed that
dst is not d13.  TurboFan never allocates d13, so that held.  Maglev
does not: MaglevAssembler::TemporaryRegisterScope hands out d13 as
the first scratch double, and generic Maglev code converts into one -
Int32ToNumber, Uint32ToNumber and IntPtrToNumber acquire a scratch
double in their deferred HeapNumber path and Int32ToDouble into it,
and the ppc backend's TryTruncateDoubleToInt32/Uint32 and
TryChangeFloat64ToIndex convert back into their scratch double for
the round-trip check.  With dst == d13 the second lfd overwrites the
value and fsub(d13, d13, d13) yields 0.0: in release builds every
int32 outside the 31-bit Smi range would be boxed as 0.0 (on ppc32
that starts at 2^30), and every truncation check would compare
against 0.0.

Use kDoubleRegZero (d14) for the bias when dst is d13.  d14 holds no
invariant any more (the MinF64/MaxF64 commit removed the last reader
that relied on JSEntry's 0.0; CanonicalizeNaN and the Maglev zero
compares load it first), and at the Maglev sites that convert into
d13 the other FP scratch is free.  Code generated for any other dst,
which includes everything TurboFan emits, is unchanged.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 v8/src/codegen/ppc/macro-assembler-ppc.cc | 4 ++--
 v8/src/codegen/ppc/macro-assembler-ppc.h  | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index 6e2e096..f796835 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -1098,8 +1098,8 @@ void MacroAssembler::ConvertIntToDoubleNoFPU64(Register src,
   //   signed:   value' = src + 2^31 (via src ^ 0x80000000), bias 2^52 + 2^31
   //   unsigned: value' = src,                               bias 2^52
   Register scratch = r0;
-  DoubleRegister double_scratch = kScratchDoubleReg;
-  DCHECK(dst != double_scratch);
+  DoubleRegister double_scratch =
+      dst == kScratchDoubleReg ? kDoubleRegZero : kScratchDoubleReg;
   subi(sp, sp, Operand(2 * kDoubleSize));
   mov(scratch, Operand(0x43300000));
   stw(scratch, MemOperand(sp, Register::kExponentOffset));
diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.h b/v8/src/codegen/ppc/macro-assembler-ppc.h
index 171f43a..e41dbf9 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.h
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.h
@@ -81,7 +81,8 @@ class V8_EXPORT_PRIVATE MacroAssembler : public MacroAssemblerBase {
 #else
   // Converts the (unsigned) integer in |src| to a double in |dst| without
   // fcfid, which belongs to the optional 64-bit FPU (absent on G3/G4).
-  // Clobbers r0 and kScratchDoubleReg.
+  // Clobbers r0 and kScratchDoubleReg (kDoubleRegZero if dst is
+  // kScratchDoubleReg).
   void ConvertIntToDoubleNoFPU64(Register src, DoubleRegister dst,
                                  bool src_is_unsigned);
 
