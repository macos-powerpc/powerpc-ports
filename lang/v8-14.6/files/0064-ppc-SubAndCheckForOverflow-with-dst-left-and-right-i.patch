From 59dec179fa5280be69f3100915480eb94ad3797d Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Thu, 12 Nov 2026 01:06:50 +0000
Subject: [PATCH 64/70] ppc: SubAndCheckForOverflow with dst, left and right in
 one register; ppc32 AssertZeroExtended

Two macro-assembler helpers the ppc32 Maglev layer reaches.

SubAndCheckForOverflow computes the xor-sign overflow test after the
subtraction and preserves the overwritten operand in `scratch`.  In
the dst == left branch it then reads `right` again for the
left ^ right term.  When dst == left == right that register already
holds the difference (0), so the term becomes left ^ 0 = left and the
helper reports overflow for every negative x in x - x.
AddAndCheckForOverflow handles the left == right case explicitly; the
Sub variant did not.  Maglev's register allocator produces this shape
for `a - a` when `a` dies at the subtraction (UseRegister on both
inputs of the same node, DefineAsRegister may reuse the dying input's
register); TurboFan's kPPC_SubWithOverflow32 can as well, since an
output may share the register of an input that dies at the
instruction.  Use the preserved copy for both operands then: the term
is 0 and no overflow is reported, which is the right answer for
x - x.  ppc64 shares the helper and gets the same fix.

AssertZeroExtended (debug code only) checks
`CmpS64(reg, kMaxUInt32); Check(le)`.  On ppc32 the comparison is a
signed 32-bit cmpw against -1, so it aborts on every non-negative
value.  A 32-bit register is zero-extended by definition; make the
check ppc64-only (arm32's AssertZeroExtended is an empty body for the
same reason).  Maglev's StringFromCharCode calls it; release builds
are unaffected.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 v8/src/codegen/ppc/macro-assembler-ppc.cc | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index 4dbdf89..6e2e096 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -1988,12 +1988,15 @@ void MacroAssembler::SubAndCheckForOverflow(Register dst, Register left,
   DCHECK(overflow_dst != left);
   DCHECK(overflow_dst != right);
 
+  bool left_is_right = left == right;
+
   // C = A-B; C overflows if A/B have diff signs and C has diff sign than A
   if (dst == left) {
     mr(scratch, left);      // Preserve left.
     sub(dst, left, right);  // Left is overwritten.
     xor_(overflow_dst, dst, scratch);
-    xor_(scratch, scratch, right);
+    // Right is overwritten too if it is left.
+    xor_(scratch, scratch, left_is_right ? scratch : right);
     and_(overflow_dst, overflow_dst, scratch, SetRC);
   } else if (dst == right) {
     mr(scratch, right);     // Preserve right.
@@ -2439,11 +2442,13 @@ void MacroAssembler::AssertUnreachable(AbortReason reason) {
 }
 
 void MacroAssembler::AssertZeroExtended(Register int32_register) {
+#if V8_TARGET_ARCH_PPC64
   if (!v8_flags.debug_code) return;
   ASM_CODE_COMMENT(this);
   mov(r0, Operand(kMaxUInt32));
   CmpS64(int32_register, r0);
   Check(le, AbortReason::k32BitValueInRegisterIsNotZeroExtended);
+#endif
 }
 
 void MacroAssembler::AssertMap(Register object) {
