From 797e38dfe4ed1c7f392a99e6882d9cf06ce43925 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Wed, 11 Nov 2026 17:33:18 +0000
Subject: [PATCH 61/70] ppc32: the API frame has a constant-pool slot on ppc32
 too (Internals::kFrameCPSlotCount)

14.6 exposes the frame's constant-pool slot count in include/v8-internal.h
(kFrameCPSlotCount: 1 under V8_TARGET_ARCH_PPC64, 0 otherwise) for the
FunctionCallbackInfo frame layout in v8-function-callback.h, and
src/execution/frames.cc static_asserts it against
CommonFrameConstants::kCPSlotSize.  The ppc32 port runs with the embedded
constant pool (V8_EMBEDDED_CONSTANT_POOL_BOOL, restored by the
target-configuration commit), so kCPSlotSize is kSystemPointerSize there
and the header must say 1 for V8_TARGET_ARCH_PPC as well - otherwise
frames.cc fails to compile, and an embedder compiled against the pristine
header would index the callback frame one slot off.

Public header: the nodejs26 include/ parity patch must carry this hunk
alongside the v8config.h and v8-unwinder-state.h ones (node/ppc64only.py
flagged the directive as new at 14.6).

Assisted-by: Claude Fable 5.1 <noreply@anthropic.com>
---
 v8/include/v8-internal.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/v8/include/v8-internal.h b/v8/include/v8-internal.h
index fab0f3c..f6c65fd 100644
--- a/v8/include/v8-internal.h
+++ b/v8/include/v8-internal.h
@@ -1045,7 +1045,7 @@ class Internals {
   static const int kIsolateRootsOffset =
       kContinuationPreservedEmbedderDataOffset + kApiSystemPointerSize;
 
-#if V8_TARGET_ARCH_PPC64
+#if V8_TARGET_ARCH_PPC || V8_TARGET_ARCH_PPC64
   static constexpr int kFrameCPSlotCount = 1;
 #else
   static constexpr int kFrameCPSlotCount = 0;
