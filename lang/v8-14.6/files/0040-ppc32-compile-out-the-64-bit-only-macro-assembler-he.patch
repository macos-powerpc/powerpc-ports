From 71140c763f82e458d67be53d8b17295a95bb6e51 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 17:49:23 +0000
Subject: [PATCH 40/70] ppc32: compile out the 64-bit-only macro-assembler
 helpers

G5 build error #2 of the 12.4 port (v8_base, macro-assembler-ppc.cc).
Class: known blind spot "64-bit-only mnemonics in masm helpers" - all
sites are macro-assembler surface that either did not exist at 9.4 or
gained new 64-bit fast paths between 9.4 and 12.4 (the 9.4 series
never had to touch these functions).  gcc reported the complete
undeclared-identifier set for the TU; a preprocessor-level audit (see
below) confirms it and finds no further sites in any other ppc TU.

The 25 mnemonics declared only under V8_TARGET_ARCH_PPC64 in
assembler-ppc.h are the audit set (clrldi clrrdi divd divdu ld ldu
mffprd mffprwz mtfprd mtfprwa mtfprwz mulld rldcl rldic rldicl rldicr
rldimi rotld rotldi rotrdi sldi sradi srdi std stdu).  Fixes, by
reachability on ppc32:

- MovIntToFloat / MovFloatToInt (LIVE: Float32<->Int32 bitcasts, F32x4
  helpers): the PPC_8_PLUS direct-move fast path (mtfprd/mffprwz, ISA
  2.07) is PPC64-gated exactly like the one in MovDoubleToInt64; the
  stack-based path below it is the ppc32 code, unchanged.
- DivS32 / ModS32 (LIVE: kPPC_Div32/Mod32): the trailing extsw
  canonicalization is PPC64-gated, same shape as the neighbouring
  AddS32/SubS32/MulS32 got in the pointer-size-lowering patch (extsw
  parses on ppc32 - it is declared unconditionally - but is a G4
  SIGILL at runtime; the 970 happens to implement it, which is why
  the G5 would not have caught it).
- DivS64 / DivU64 / ModS64 / ModU64, ByteReverseU64,
  CountTrailingZerosU64, ClearByteU64, ReverseBitsInSingleByteU64,
  I64x2Mul (compile-reachable, runtime-dead): PPC64 body, UNREACHABLE
  on ppc32, the same convention as the F64x2 lane helpers.  Dead
  because 64-bit integer ops are pair-lowered (Int64Lowering / the
  restored pair visitors), Word32ReverseBits/Word32Ctz are not
  advertised (SupportedMachineOperatorFlags returns kNoFlags on
  ppc32), 64-bit SAB atomics are routed to the C++ runtime, Liftoff
  is disabled, and wasm SIMD never validates.
- COUNT_TRAILING_ZEROES_SLOW: the shift in the loop becomes
  ShiftRightU64 (= srdi on ppc64, srwi on ppc32), which keeps
  CountTrailingZerosU32's pre-P9 slow path compiling and correct on
  ppc32.

Validation: ppcheck balanced; cross-g++14 full-TU parse is OOM-killed
on this box even at -fsyntax-only (961MB ceiling, canary static_assert
never reached - the masm TU joins the selector TU above the local
instantiation ceiling), so the class was verified at the preprocessor
level instead: -E provenance-tracked scan of all 16 compiled ppc TUs
for the 25-name set = 16 hits before this patch (exactly the G5 error
list), 0 after, 0 in every other TU.  PPC64 -E output is
byte-identical before/after except the two COUNT_TRAILING_ZEROES_SLOW
expansions calling ShiftRightU64 instead of raw srdi (identical
emission - ShiftRightU64's ppc64 body is that srdi).

13.6 rebase: MovIntToFloat/MovFloatToInt already have the PPC64 / stack-path split from the backend restoration commit (13.6 dropped the PPC_8_PLUS runtime check on 64-bit; the 32-bit side is the memory path), so those two hunks give way; the remaining hunks (DivS32/ModS32 extsw gating, the 64-bit-only helpers' UNREACHABLE bodies, COUNT_TRAILING_ZEROES_SLOW) applied as before.

14.6 rebase: the ppc backend's baseline moved on to POWER9, so ModS32/
ModU32/ModS64/ModU64 and CountTrailingZerosU32/U64 lost their
IsSupported(PPC_9_PLUS) checks and emit modsw/moduw/modsd/modud and
cnttzw/cnttzd unconditionally (the COUNT_TRAILING_ZEROES_SLOW macro is
gone).  This commit keeps to its own subject - the 64-bit forms are
compiled out on ppc32 as before - and the pre-POWER9 fallbacks are
restored by a later commit in the series.
---
 v8/src/codegen/ppc/macro-assembler-ppc.cc | 52 +++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index ebebb1d..dbc1c5b 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -3127,18 +3127,30 @@ void MacroAssembler::MulS32(Register dst, Register src, Register value, OEBit s,
 
 void MacroAssembler::DivS64(Register dst, Register src, Register value, OEBit s,
                             RCBit r) {
+#if V8_TARGET_ARCH_PPC64
   divd(dst, src, value, s, r);
+#else
+  // 64-bit integer ops are pair-lowered on ppc32 (Int64Lowering) and
+  // Liftoff bails out, so the 64-bit divide helpers are never reached.
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::DivU64(Register dst, Register src, Register value, OEBit s,
                             RCBit r) {
+#if V8_TARGET_ARCH_PPC64
   divdu(dst, src, value, s, r);
+#else
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::DivS32(Register dst, Register src, Register value, OEBit s,
                             RCBit r) {
   divw(dst, src, value, s, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst);
+#endif
 }
 void MacroAssembler::DivU32(Register dst, Register src, Register value, OEBit s,
                             RCBit r) {
@@ -3147,16 +3159,26 @@ void MacroAssembler::DivU32(Register dst, Register src, Register value, OEBit s,
 }
 
 void MacroAssembler::ModS64(Register dst, Register src, Register value) {
+#if V8_TARGET_ARCH_PPC64
   modsd(dst, src, value);
+#else
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::ModU64(Register dst, Register src, Register value) {
+#if V8_TARGET_ARCH_PPC64
   modud(dst, src, value);
+#else
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::ModS32(Register dst, Register src, Register value) {
   modsw(dst, src, value);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst);
+#endif
 }
 void MacroAssembler::ModU32(Register dst, Register src, Register value) {
   moduw(dst, src, value);
@@ -4353,6 +4375,7 @@ void MacroAssembler::I64x2Mul(Simd128Register dst, Simd128Register src1,
                               Simd128Register src2, Register scratch1,
                               Register scratch2, Register scratch3,
                               Simd128Register scratch4) {
+#if V8_TARGET_ARCH_PPC64
   constexpr int lane_width_in_bytes = 8;
   if (CpuFeatures::IsSupported(PPC_10_PLUS)) {
     vmulld(dst, src1, src2);
@@ -4375,6 +4398,12 @@ void MacroAssembler::I64x2Mul(Simd128Register dst, Simd128Register src1,
     }
     mtvsrdd(dst, scratch1, scratch2);
   }
+#else
+  // The non-P10 fallback multiplies the lanes in GPRs (mfvsrd/mulld) —
+  // 64-bit only. Wasm SIMD never validates on ppc32 (SupportsWasmSimd128
+  // is false) and Liftoff bails out, so this helper is never reached.
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::I16x8Mul(Simd128Register dst, Simd128Register src1,
@@ -5298,6 +5327,7 @@ void MacroAssembler::ByteReverseU32(Register dst, Register val,
 }
 
 void MacroAssembler::ByteReverseU64(Register dst, Register val, Register) {
+#if V8_TARGET_ARCH_PPC64
   if (CpuFeatures::IsSupported(PPC_10_PLUS)) {
     brd(dst, val);
     return;
@@ -5306,6 +5336,12 @@ void MacroAssembler::ByteReverseU64(Register dst, Register val, Register) {
   std(val, MemOperand(sp));
   ldbrx(dst, MemOperand(r0, sp));
   addi(sp, sp, Operand(kSystemPointerSize));
+#else
+  // A u64 lives in a register pair on ppc32; the only callers (64-bit
+  // atomics codegen, Liftoff, ReverseBitsU64) are all compiled but
+  // unreachable there (0035-class runtime routing, Liftoff disabled).
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::JumpIfEqual(Register x, int32_t y, Label* dest) {
@@ -5579,14 +5615,22 @@ void MacroAssembler::CountTrailingZerosU32(Register dst, Register src,
 
 void MacroAssembler::CountTrailingZerosU64(Register dst, Register src,
                                            RCBit r) {
+#if V8_TARGET_ARCH_PPC64
     cnttzd(dst, src, r);
+#else
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::ClearByteU64(Register dst, int byte_idx) {
+#if V8_TARGET_ARCH_PPC64
   CHECK(0 <= byte_idx && byte_idx <= 7);
   int shift = byte_idx*8;
   rldicl(dst, dst, shift, 8);
   rldicl(dst, dst, 64-shift, 0);
+#else
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::ReverseBitsU64(Register dst, Register src,
@@ -5610,6 +5654,7 @@ void MacroAssembler::ReverseBitsInSingleByteU64(Register dst, Register src,
                                                 Register scratch1,
                                                 Register scratch2,
                                                 int byte_idx) {
+#if V8_TARGET_ARCH_PPC64
   CHECK(0 <= byte_idx && byte_idx <= 7);
   int j = byte_idx;
   // zero all bits of scratch1
@@ -5630,6 +5675,13 @@ void MacroAssembler::ReverseBitsInSingleByteU64(Register dst, Register src,
   // clear jth byte of dst and insert jth byte of scratch2
   ClearByteU64(dst, j);
   orx(dst, dst, scratch2);
+#else
+  // rldicl/rldicr are 64-bit rotates. Both callers (ReverseBitsU64,
+  // ReverseBitsU32) are unreachable on ppc32: Word32ReverseBits is not
+  // advertised (SupportedMachineOperatorFlags returns kNoFlags) and
+  // Word64 ops never reach the backend.
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::JumpIfCodeIsMarkedForDeoptimization(
