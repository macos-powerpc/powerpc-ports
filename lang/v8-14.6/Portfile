post-patch {
    # Upstream mixes variations of Python shebangs, so account for all:
    fs-traverse f ${worksrcpath} {
        if {[string match *.py ${f}]} {
            reinplace -q "s|/usr/bin/env python2|${configure.python}|" ${f}
            reinplace -q "s|/usr/bin/env python3|${configure.python}|" ${f}
            reinplace -q "s|/usr/bin/env python|${configure.python}|" ${f}
        }
    }
}

compiler.cxx_standard   2020

if {[string match *gcc* ${configure.compiler}]} {
    configure.cxxflags-append \
                        -fpermissive
    if {${configure.build_arch} in [list i386 ppc]} {
        configure.ldflags-append \
                        -latomic
    }
}

# fdlibm (src/base/ieee754.cc, and at 12.4 also the third_party/glibc
# ieee754 dbl-64 sources) needs exact per-operation double rounding; fused
# multiply-add contraction makes the results 1 ulp off, and contraction in
# the C++ runtime can diverge from JIT-emitted arithmetic. Upstream
# BUILD.gn does the same for s390 and ppc64.
if {${configure.build_arch} eq "ppc"} {
    configure.cflags-append     -ffp-contract=off
    configure.cxxflags-append   -ffp-contract=off
}

configure.args-append   -DPYTHON_EXECUTABLE=${configure.python}
# Harness defaults, stated so that a harness-side default change can never
# silently alter what the archives nodejs26 links expect: Intl on, the
# system simdutf/highway, Maglev off unless the maglev variant is selected
# (header-invisible either way, node needs no define). Leaptiering is
# unconditional at 14.6 (the 13.6 option no longer exists).
configure.args-append   -DV8_ENABLE_I18N=ON \
                        -DV8_USE_SYSTEM_SIMDUTF=ON \
                        -DV8_USE_SYSTEM_HIGHWAY=ON \
                        -DV8_ENABLE_MAGLEV=OFF

# The ppc32 Maglev backend (0063-0069) is new and was derived statically.
# It is built by default but staged: on ppc32 --maglev defaults to false
# (0069), so d8, node_mksnapshot and node keep the G5-validated tiers
# unless --maglev is passed (d8-smoke-maglev.js does). -maglev builds the
# series without the Maglev TUs.  Reverting 0069 flips the default once
# the Maglev battery is green on hardware.
variant maglev description "Build the Maglev JIT tier (staged on ppc32: pass --maglev)" {
    configure.args-replace  -DV8_ENABLE_MAGLEV=OFF -DV8_ENABLE_MAGLEV=ON
}
default_variants        +maglev

destroot {
    set v8_execprefix   ${prefix}/libexec/${name}
    set docdir          ${prefix}/share/doc/${name}
    xinstall -d ${destroot}${v8_execprefix}/bin
    xinstall -d ${destroot}${v8_execprefix}/lib
    xinstall -d ${destroot}/${docdir}
    copy ${worksrcpath}/v8/include ${destroot}${v8_execprefix}
    foreach binary [list d8 mksnapshot torque] {
        copy ${cmake.build_dir}/${binary} ${destroot}${v8_execprefix}/bin
    }
    foreach slib [glob ${cmake.build_dir}/*.a] {
        copy ${slib} ${destroot}${v8_execprefix}/lib
    }
    # The abseil dependency closure builds as EXCLUDE_FROM_ALL subdirectory
    # targets, so its archives land under the subdirectory's build tree.
    # They are part of the link interface of the v8 archives (v8_libbase
    # links absl::flat_hash_map/flat_hash_set) - the nodejs26 external-V8
    # build needs them installed alongside. (The *.a glob above already
    # covers libv8_initializers.a, which an embedder links as well now that
    # the builtin generators live only there.)
    fs-traverse f ${cmake.build_dir}/v8/third_party/abseil-cpp {
        if {[string match *.a ${f}]} {
            copy ${f} ${destroot}${v8_execprefix}/lib
        }
    }
    copy ${worksrcpath}/v8/docs ${destroot}${docdir}
}
