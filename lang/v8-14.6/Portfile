# bnoordhuis/v8-cmake has no 14.6 tag, so 0000-v8-cmake-build-harness.patch
# carries the harness itself: the 13.6 port's harness (the upstream 11.6 tag
# plus the 9.4 port's ppc wiring, re-mirrored at 12.4 and 13.6) re-mirrored
# once more against 14.6's BUILD.gn with node/gnmirror.py (per-target source
# lists, both directions) and node/gndefines.py (the config("features")/
# ("toolchain") defines for this configuration). What changed at 14.6:
# leaptiering is unconditional (no GN arg, no define - the 13.6 option is
# gone); Maglev is offered (V8_ENABLE_MAGLEV: 14.6 ships a ppc64 backend,
# pure 64-bit; 0063-0069 re-derive it for ppc32, see the maglev variant);
# Temporal is Rust (temporal_rs) since 14.0 and is OFF and
# not offered (V8_TEMPORAL_SUPPORT unset, its three TUs and one .tq
# removed as BUILD.gn drops them); V8_ENABLE_UNDEFINED_DOUBLE and
# V8_ENABLE_REGEXP_DIAGNOSTICS, both GN defaults, are deliberately not set
# because node's own gyp build does not set them (torque bakes the first
# into its build flags, so the posture is harness-wide); source moves
# (js-trampoline-assembler to v8_initializers, builtins-effects-dummy to
# mksnapshot, linkage/wasm-compiler-definitions into v8_base,
# turboshaft-graph-interface/wrappers into v8_compiler, constant-pool-ppc.cc
# and save-flags.cc new); the abseil roll adds absl::int128 and
# absl::str_format to the link interface; mksnapshot passes
# --turbo-always-optimize-spills (GN's and node's replacement for the
# retired --stress-turbo-late-spilling) with the fixed --random-seed;
# torque list 245 entries verified exact for this posture. GN's new
# -mcpu=pwr9 cflag for ppc64 is not mirrored (G4/G5 target). Plus the one
# source edit update_v8.py would apply at import time (inspector-protocol
# code_generator.py, regenerated for its new context).  Nothing else -
# the whole v8/ tree arrives verbatim from the node distfile, and the series
# below applies with no fuzz.

# Inherited from abseil port: abseil is built with
# ABSL_THREAD_IDENTITY_MODE_USE_POSIX_SETSPECIFIC (define scoped to
# absl_base) because GCC/Darwin thread_local is libgcc's emutls, whose
# pthread-key destructor frees the thread's blocks before libstdc++'s
# thread-atexit key runs the C++ destructors; abseil's Apple default keeps
# the ThreadIdentity in such a thread_local and every V8 worker-thread exit
# crashed (node 24: SIGILL in NodePlatform::Shutdown under npm).

# The ppc-darwin series, rebased onto 14.6 from the G5-validated v8-13.6
# series (60 patches -> 61; 43 of the 60 applied as they were). 14.6 is
# a smaller hop than 13.6 was: the 32-bit configuration, backend halves and
# Turboshaft-only selector were authored at 13.6 and carry over; what 14.6
# changed underneath them:
# - the instruction selector is de-templated (InstructionSelectorT<Adapter>
#   -> InstructionSelector, operands read through op.input(i); input_at is
#   gone), so the 32-bit selector patch (0006) was re-derived: the pair-op
#   visitors read their operands through Word32PairBinopOp as ia32/arm do;
# - the ppc64 backend's floor moved from POWER8 to POWER9 (BUILD.gn adds
#   -mcpu=pwr9, cpu-features.h starts at PPC_9_PLUS): modsw/moduw/modsd/
#   modud, cnttzw/cnttzd and the wasm-SIMD gate lost their feature checks.
#   0059 puts the 13.6 shape back (kPPC_Mod32 is every optimized int32 %);
# - leaptiering is unconditional: the JSDispatchTable accessors the 13.6
#   harness compiled out are live now and work through the pointer-size
#   lowering of the U64 helpers (0007) - the 32-bit JSDispatchEntry layout
#   is upstream's (ia32/arm);
# - CallCFunction's new raw `ld` frame restore needs lwz on 32-bit (0060);
# - include/v8-internal.h now exposes the frame's constant-pool slot count
#   (kFrameCPSlotCount, PPC64-only upstream); the ppc32 port runs with the
#   embedded constant pool, so it is 1 here too (0061) - a public-header
#   hunk the nodejs26 include/ parity patch must carry, like v8config.h
#   and v8-unwinder-state.h.
# Obsolete at 14.6 and dropped: 13.6's safepoint QoS gating (the QoS
# override moved out of V8 into the embedder platform's
# BoostablePriorityScope) and the Int64-lowering `__ template Tuple<>`
# spelling (upstream writes `__ MakeTuple(...)` now). Re-derived in place
# during the rebase: TryInlineTruncateDoubleToI's new double_scratch
# parameter, the Darwin r13 callee-save list (now in register-ppc.h's
# C_CALL_CALLEE_SAVE_REGISTERS), LoadOp::Kind (upstream packed it;
# the uint8_t spelling is kept), the restrictive load/store architecture
# macro, the embedded constant pool's move into codegen/ppc/.
# Known limitations carried from 12.4/13.6: wasm-threads i64/sub-word
# atomics reach named-operator fatals if a module using them is
# instantiated; wasm SIMD modules are rejected with a clean CompileError
# below POWER9; Liftoff stays disabled (TurboFan compiles every wasm
# function).

# Any modern python works: the only build-time python consumer is the
# inspector code_generator.py, which sys.path-inserts --jinja_dir ahead of
# site-packages and therefore always uses the VENDORED jinja2 +
# markupsafe (no py-jinja2 port needed, unlike v8-9.4 whose comment
# predates checking this). Verified with CPython 3.14.7: configure clean,
# generated inspector sources byte-identical to a 3.12 run.
set py_ver              3.14
set py_ver_nodot        [string map {. {}} ${py_ver}]

# ICU i18n: the harness builds V8 with V8_INTL_SUPPORT against MacPorts'
# ICU (CMake's FindICU; V8 14.6 static-asserts ICU >= 73), which is what
# upstream does by default and brings the whole JS Intl.* namespace,
# RegExp Unicode property escapes (\p{...} under /u - the biggest
# ecosystem hit when absent), real localeCompare, String.prototype.
# normalize and locale-aware case mapping. Beyond the intl sources the
# harness builds and runs V8's gen-regexp-special-case tool, whose output
# (the ECMAScript case-folding special cases, derived from ICU data)
# compiles into v8_base. The installed archive set is unchanged, but
# the archives now reference libicui18n/libicuuc/libicudata: an embedder
# linking them supplies those itself - nodejs26 is configured
# --with-intl=system-icu for that reason, and the two ports flip
# together. d8 links the ICU dylibs. (The gettext/glib2 dependencies
# the port used to carry were never referenced by the CMake build.)
depends_build-append    port:python${py_ver_nodot}
depends_lib-append      path:lib/pkgconfig/icu-uc.pc:icu

# simdutf and highway: V8 dependencies since 13.x (string ASCII/UTF-16
# validation, Uint8Array base64 incl. 14.6's atomic variants; highway's
# vector ops in the JSON stringifier, the regexp runtime, unicode.cc and
# the string hasher). BUILD.gn builds the vendored copies (simdutf 7.7.0 at
# 14.6, highway 2024-05); the harness links the system ports instead, whose
# AltiVec kernels are the point on this target. simdutf's releases are
# additive, so 9.3.2 covers the 7.7.0 API V8 calls (checked at 13.6 against
# the 6.4.0 set; the 14.6 additions - atomic_binary_to_base64,
# atomic_base64_to_binary_safe, to_well_formed_utf16 - exist from 7.x).
# Like ICU, both become part of the archives' link interface: an embedder
# (nodejs26 with --shared-simdutf) adds -lsimdutf -lhwy itself.
depends_lib-append      port:simdutf \
                        port:highway

configure.python        ${prefix}/bin/python${py_ver}

# Unpacking all of node would cost ~1 GB for the 98 MB subtree we want,
# so the extract phase pulls out deps/v8 by hand instead.
extract {
    system -W ${workpath} "${extract.cmd} ${extract.pre_args} \
        ${distpath}/node-v${node_version}${extract.suffix} \
        | tar -xf - node-v${node_version}/deps/v8"

    xinstall -d ${worksrcpath}
    move ${workpath}/node-v${node_version}/deps/v8 ${worksrcpath}/v8
    delete ${workpath}/node-v${node_version}
}

