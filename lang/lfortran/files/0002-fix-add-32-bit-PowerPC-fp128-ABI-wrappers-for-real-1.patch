From 45a1cd7ad27ebac7f39f704d8f8626aa093e9aeb Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 10 Oct 2026 18:37:40 +0000
Subject: [PATCH 2/2] fix: add 32-bit PowerPC fp128 ABI wrappers for real(16)

Give 32-bit PowerPC the compiler-rt entry points LLVM emits for real(16),
so a program that does real(16) arithmetic at run time links and computes
correctly on macOS PowerPC (issue #13240). Since 5b271f6 the runtime builds
on PowerPC but defines none of these entry points there.

LLVM has no fp128 register class on 32-bit PowerPC (Iain Sandoe's 7.1.1
Darwin branch is identical to upstream 7.1 here), so it softens fp128 to
i128 and moves it as four 32-bit words in consecutive GPRs, most
significant word first: the operands of a binary helper arrive in r3-r6
and r7-r10 and the result goes back in r3-r6. No 32-bit C integer type
spans four GPRs, but GCC returns a complex integer with 64-bit halves in
r3-r6 (rs6000_complex_function_value) and, because it splits complex
arguments into their halves, passes one in four consecutive GPRs as well.
`_Complex long long` therefore spells LLVM's convention the same way the
16-byte vector does on x86-64, and its memory layout (real part first) is
the big-endian binary128 image, so the memcpy conversions are exact.
Darwin and SVR4 agree on all of this; ppc64 and VSX targets are not
covered and keep defining no entry points.

Verified with powerpc-linux-gnu-gcc 14 under qemu-ppc using a harness
that loads r3-r10 and f1 exactly like LLVM-generated code and reads the
result registers back: all 16 checks over the arithmetic, comparison,
conversion and to_str/from_str paths pass; before this change the harness
does not link (22 undefined references).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/libasr/runtime/lfortran_float128.c      | 30 ++++++++++++++++-----
 src/libasr/runtime/lfortran_float128_llvm.h |  5 ++++
 2 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/src/libasr/runtime/lfortran_float128.c b/src/libasr/runtime/lfortran_float128.c
index 3d26a32..5d1c2f0 100644
--- a/src/libasr/runtime/lfortran_float128.c
+++ b/src/libasr/runtime/lfortran_float128.c
@@ -1652,16 +1652,34 @@ lf_float128 lf_float128_from_str(const char *s) {
  * The conversions are pure memcpy, so no fp128 arithmetic is generated here
  * and these wrappers cannot recurse into themselves.
  *
- * On other targets (e.g. PowerPC, 32-bit x86, 32-bit ARM, RISC-V) the fp128
- * calling convention is not spelled out here, so these entry points are not
- * provided. The rest of the runtime still builds; real(16) arithmetic on
+ * On 32-bit PowerPC a complex integer type spells LLVM's convention, see the
+ * typedef below.
+ *
+ * On other targets (e.g. 64-bit PowerPC, 32-bit x86, 32-bit ARM, RISC-V) the
+ * fp128 calling convention is not spelled out here, so these entry points are
+ * not provided. The rest of the runtime still builds; real(16) arithmetic on
  * such targets relies on the system's compiler-rt/libgcc, if available.
  * ======================================================================== */
 #if (defined(__x86_64__) && (defined(__GNUC__) || defined(__clang__))) \
-    || (defined(_MSC_VER) && defined(_M_X64))
+    || (defined(_MSC_VER) && defined(_M_X64)) \
+    || (defined(__powerpc__) && !defined(__powerpc64__) \
+        && (defined(__GNUC__) || defined(__clang__)))
 
 #if defined(__x86_64__) && (defined(__GNUC__) || defined(__clang__))
 typedef double lf_f128_abi __attribute__((vector_size(16)));
+#elif defined(__powerpc__)
+/* 32-bit PowerPC has no fp128 register class, so LLVM softens fp128 to i128
+ * and moves it as four 32-bit words in consecutive GPRs, most significant
+ * word first: the operands of a binary helper arrive in r3-r6 and r7-r10
+ * and the result goes back in r3-r6 (RetCC_PPC assigns i32 results to
+ * r3-r10). No 32-bit C integer type spans four GPRs, but GCC returns a
+ * complex integer with 64-bit halves in r3-r6 (rs6000_complex_function_value)
+ * and, because it splits complex arguments into their two halves, passes one
+ * in four consecutive GPRs as well. Its memory layout puts the real part
+ * first, which on this big-endian target is the high half of the binary128
+ * image, so the memcpy conversions below are exact. Darwin and SVR4 agree on
+ * all of this. */
+typedef _Complex long long lf_f128_abi;
 #else
 /* On Windows x64 LLVM passes fp128 arguments indirectly through a pointer to
  * a 16-byte aligned slot and returns fp128 in XMM0. MSVC gives __m128d
@@ -1706,8 +1724,8 @@ int __gttf2   (lf_f128_abi a, lf_f128_abi b) { return __gttf2_lf_impl   (lf_f128
 int __getf2   (lf_f128_abi a, lf_f128_abi b) { return __getf2_lf_impl   (lf_f128_from_abi(a), lf_f128_from_abi(b)); }
 int __unordtf2(lf_f128_abi a, lf_f128_abi b) { return __unordtf2_lf_impl(lf_f128_from_abi(a), lf_f128_from_abi(b)); }
 
-/* SIMD-ABI public entry points for the transcendentals called by
- * LLVM-emitted `call fp128 @lf_sqrtq(fp128)` / `lf_powq(fp128, fp128)`. */
+/* Public entry points for the transcendentals called by LLVM-emitted
+ * `call fp128 @lf_sqrtq(fp128)` / `lf_powq(fp128, fp128)`. */
 lf_f128_abi lf_sqrtq(lf_f128_abi a)                 { return lf_f128_to_abi(lf_f128_sqrt(lf_f128_from_abi(a))); }
 lf_f128_abi lf_powq(lf_f128_abi a, lf_f128_abi b)   { return lf_f128_to_abi(lf_f128_pow(lf_f128_from_abi(a), lf_f128_from_abi(b))); }
 #endif
diff --git a/src/libasr/runtime/lfortran_float128_llvm.h b/src/libasr/runtime/lfortran_float128_llvm.h
index bacd2e3..991c728 100644
--- a/src/libasr/runtime/lfortran_float128_llvm.h
+++ b/src/libasr/runtime/lfortran_float128_llvm.h
@@ -14,6 +14,11 @@
  * public entry points take a 16-byte vector rather than the struct.
  * On ARM64, naked-function shims bridge the SIMD ABI to the struct ABI.
  * On WASM, sret-style wrappers match the ABI LLVM uses for wasm32.
+ * On 32-bit PowerPC, LLVM moves the softened fp128 through four GPRs, which
+ * a complex integer type spells in C, so the entry points take that.
+ * On every other target none of the public entry points are defined, and a
+ * program doing real(16) arithmetic at run time gets the symbols from the
+ * toolchain's compiler-rt or libgcc, or fails to link.
  */
 
 #ifndef LFORTRAN_FLOAT128_LLVM_H
-- 
2.43.0

