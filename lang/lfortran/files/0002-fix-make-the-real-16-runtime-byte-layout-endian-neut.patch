index b7a0702..f1db6e9 100644
--- a/src/libasr/runtime/lfortran_float128_llvm.h
+++ b/src/libasr/runtime/lfortran_float128_llvm.h
@@ -24,14 +24,45 @@
 #define LFORTRAN_FLOAT128_LLVM_H
 
 #include <stdint.h>
+#include <string.h>
 
 #ifdef __cplusplus
 extern "C" {
 #endif
 
-/* Core type — 16-byte struct, little-endian IEEE 754 binary128 */
+/* Core type: the 16 bytes of an IEEE 754 binary128 value exactly as the
+ * target stores it in memory, which is what memcpy from an fp128 variable or
+ * an LLVM-emitted fp128 store yields. On a little-endian target bytes[0..7]
+ * hold the low 64 bits of the value, on a big-endian target they hold the
+ * high 64 bits. Code must not pick the halves out of the array itself;
+ * lf_f128_to_words() and lf_f128_from_words() do that in the target's byte
+ * order. */
 typedef struct { uint8_t bytes[16]; } lf_float128;
 
+static inline void lf_f128_to_words(lf_float128 v, uint64_t *lo, uint64_t *hi) {
+#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && \
+    __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+    memcpy(hi, v.bytes, 8);
+    memcpy(lo, v.bytes + 8, 8);
+#else
+    memcpy(lo, v.bytes, 8);
+    memcpy(hi, v.bytes + 8, 8);
+#endif
+}
+
+static inline lf_float128 lf_f128_from_words(uint64_t lo, uint64_t hi) {
+    lf_float128 v;
+#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && \
+    __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+    memcpy(v.bytes, &hi, 8);
+    memcpy(v.bytes + 8, &lo, 8);
+#else
+    memcpy(v.bytes, &lo, 8);
+    memcpy(v.bytes + 8, &hi, 8);
+#endif
+    return v;
+}
+
 /* ── Internal _lf_impl variants (struct ABI, all platforms) ────────────── */
 lf_float128 __addtf3_lf_impl(lf_float128 a, lf_float128 b);
 lf_float128 __subtf3_lf_impl(lf_float128 a, lf_float128 b);
