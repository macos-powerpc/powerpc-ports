# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

# Snapshot of the d5.12.1 series taken from VictorMiasnikov's fork of
# modula3/cm3. It carries upstream e8fa74c42c, without which a compiler
# built on AMD64_LINUX generates wrong data layouts for other targets.
github.setup        VictorMiasnikov cm3 5.12.1 d -ZZYYXX-20260606
revision            0
categories          lang
license             Permissive
maintainers         nomaintainer

description         Critical Mass Modula-3 compiler and libraries

long_description    CM3 is an open source Modula-3 system descended from \
                    DEC SRC Modula-3 and Critical Mass Modula-3. This port \
                    builds the cm3 compiler with its C back end, the m3core \
                    and libm3 runtime libraries, and the core set of \
                    libraries and tools.

homepage            https://modula3.github.io/cm3
github.tarball_from archive

# A branch shares the tag's name, so GitHub rejects the portgroup's
# default archive URL as ambiguous; fetch the tag by its full ref.
master_sites        https://github.com/${github.author}/${github.project}/archive/refs/tags
distfiles           ${git.branch}${extract.suffix}
checksums           ${git.branch}${extract.suffix} \
                    rmd160  3d297c52942376b497568bc44b62a7550a687fdf \
                    sha256  b7e6466d06acd84cb4d4962bedd1cce071706910df5768e4419b6f71d7e8567b \
                    size    97666809

# m3core's big-endian ExtendedRep is a 128-bit quad layout, but EXTENDED is
# 64-bit on every target except AMD64_LINUX; make it the LONGREAL alias
# the little-endian ext64 variant uses.
patchfiles          patch-m3core-ieee-be-extendedrep.diff

livecheck.regex     archive/refs/tags/d(\[0-9.\]+)-ZZYYXX-\[0-9_-\]+\\.tar\\.gz

# The build ignores ABI flag, but it works anyway.
compiler.cxx_standard   2011
compiler.thread_local_storage yes

# cm3 is written in Modula-3, so building it needs a cm3. The bootstrap
# archives hold the compiler and its support libraries as C generated by
# the cm3 C back end plus a Makefile, and each one is specific to
# a target, so the archive is chosen by build_arch.

# The archives published with the fork's releases were generated by
# a compiler predating e8fa74c42c and crash at startup (FindModules in
# RTLinker.m3); the ones used here were generated from this tag with
# the patch above applied, by scripts/python/boot1.py on AMD64_LINUX.
set boot_site       https://macos-powerpc.org/compilers/cm3/boot/
set boot_date       20261028
supported_archs     ppc ppc64 x86_64
universal_variant   no

set boot_dist       ""
set cm3_target      ""

switch ${build_arch} {
    ppc {
        set cm3_target  PPC_DARWIN
        set boot_dist   cm3-boot-PPC_DARWIN-d5.12.1-${boot_date}.tgz
        checksums-append \
                    ${boot_dist} \
                    rmd160  271a9be14d53edf7aceb5aee8c28bdd75f3de376 \
                    sha256  6af82892dd71810fe34681801af88ec4a8b46713d6a6aafc13990ee7ac3eac21 \
                    size    24340185
    }
    ppc64 {
        set cm3_target  PPC64_DARWIN
        set boot_dist   cm3-boot-PPC64_DARWIN-d5.12.1-${boot_date}.tgz
        checksums-append \
                    ${boot_dist} \
                    rmd160  69b7e23751a6a39bc53d8bd6e6d006eb7e7e7961 \
                    sha256  2acd22d19fe8c8552a9ae545e7bac5590bd7ecd4cd7ee666a5cfa1b4593b4123 \
                    size    24620592
    }
    x86_64 {
        set cm3_target  AMD64_DARWIN
        set boot_dist   cm3-boot-AMD64_DARWIN-d5.12.1-${boot_date}.tgz
        checksums-append \
                    ${boot_dist} \
                    rmd160  33d4196871e7d90e4dbe9c38a77caee93d5ac5b7 \
                    sha256  d2aae9f973629a337ec12e8dedf0ba9a4a5e7cdc7f36cd73989adf5610f48f59 \
                    size    24354581
    }
}

if {${boot_dist} ne ""} {
    master_sites-append ${boot_site}:boot
    distfiles-append    ${boot_dist}:boot
}

extract.only        ${git.branch}${extract.suffix}

pre-fetch {
    if {${boot_dist} eq ""} {
        return -code error "no cm3 bootstrap archive is available for ${build_arch}"
    }
}

post-extract {
    xinstall -d ${workpath}/boot
    system -W ${workpath}/boot "gzip -dc ${distpath}/${boot_dist} | tar -xf -"
}

use_configure       no

# Everything is shipped into a private tree, then copied into destroot.
set cm3_stage       ${workpath}/stage
set cm3_root        ${prefix}/libexec/cm3

proc cm3_cxx {} {
    global configure.cxx configure.cxx_archflags configure.sdkroot
    set cxx "${configure.cxx} ${configure.cxx_archflags}"
    if {${configure.sdkroot} ne ""} {
        append cxx " -isysroot ${configure.sdkroot}"
    }
    return $cxx
}

# bin/cm3.cfg is what cm3 reads first; it selects the target configuration
# from bin/config. The build-time variant pins the compiler MacPorts
# chose and gives executables a relocatable rpath, so that what is linked
# against the staging tree keeps working once installed. The installed
# variant is the plain one upstream's own installer writes.
proc cm3_write_config {path target buildtime} {
    global build.jobs
    set fd [open ${path} w]
    puts $fd "% written by MacPorts"
    puts $fd {M3_BACKEND_MODE = "C"}
    puts $fd {if not defined("SL") SL = "/" end}
    puts $fd "if not defined(\"HOST\") HOST = \"${target}\" end"
    puts $fd {if not defined("TARGET") TARGET = HOST end}
    if {${buildtime}} {
        puts $fd "SYSTEM_CC_LD = \"[cm3_cxx] -g -fPIC\""
        puts $fd {SYSTEM_CC_ASM = SYSTEM_CC_LD}
        puts $fd {SYSTEM_CC = SYSTEM_CC_LD & " -x c++"}
    }
    puts $fd {INSTALL_ROOT = (path() & SL & "..")}
    puts $fd {include(path() & SL & "config" & SL & TARGET)}
    if {${buildtime}} {
        puts $fd {LIB_USE = "@loader_path/../lib"}
        puts $fd "M3_PARALLEL_BACK = ${build.jobs}"
    }
    close $fd
}

# Run one of the upstream build scripts against the staging tree.
proc cm3_script {args} {
    global worksrcpath cm3_stage cm3_target
    set env "CM3_INSTALL=${cm3_stage} CM3_TARGET=${cm3_target}"
    append env " CM3=${cm3_stage}/bin/cm3 OMIT_GCC=yes"
    append env " PATH=${cm3_stage}/bin:\$PATH"
    system -W ${worksrcpath}/scripts "env ${env} ./[join ${args}]"
}

# Replace the compiler in the staging tree with the one just built.
proc cm3_install_compiler {} {
    global worksrcpath cm3_stage cm3_target
    set cm3 ${worksrcpath}/m3-sys/cm3/${cm3_target}/cm3
    system "env M3CONFIG=${cm3_stage}/bin/cm3.cfg ${cm3} -version"
    xinstall -m 0755 ${cm3} ${cm3_stage}/bin/cm3
}

build {
    # 1. The bootstrap compiler, from the pregenerated C sources.
    set bootdir [lindex [glob -directory ${workpath}/boot -type d cm3-boot-*] 0]
    system -W ${bootdir} "${build.cmd} -j${build.jobs} CC='[cm3_cxx]' CFLAGS='-pthread'"

    # 2. Stage it with the build-time configuration.
    xinstall -d ${cm3_stage}/bin/config
    xinstall -m 0755 ${bootdir}/cm3 ${cm3_stage}/bin/cm3
    foreach f [glob -directory ${worksrcpath}/m3-sys/cminstall/src/config -type f *] {
        xinstall -m 0644 ${f} ${cm3_stage}/bin/config
    }
    cm3_write_config ${cm3_stage}/bin/cm3.cfg ${cm3_target} 1

    # 3. The runtime, with the bootstrap compiler.
    cm3_script do-pkg.sh buildship m3core libm3

    # 4. The compiler, then the runtime and compiler again with the
    #    result, as scripts/upgrade.sh does.
    set front "sysutils set m3middle m3objfile m3linker m3back m3front m3quake cm3 mklib m3cggen"
    cm3_script do-pkg.sh realclean ${front}
    cm3_script do-pkg.sh buildship ${front}
    cm3_install_compiler
    cm3_script do-pkg.sh realclean m3core libm3 ${front}
    cm3_script do-pkg.sh buildship m3core libm3 ${front}
    cm3_install_compiler

    # 5. Everything tagged "core" in scripts/pkginfo.txt.
    cm3_script do-cm3-core.sh realclean
    cm3_script do-cm3-core.sh buildship
}

destroot {
    xinstall -d ${destroot}${prefix}/libexec
    copy ${cm3_stage} ${destroot}${cm3_root}
    cm3_write_config ${destroot}${cm3_root}/bin/cm3.cfg ${cm3_target} 0

    # cm3 finds cm3.cfg next to its own executable, so it gets a wrapper;
    # the other tools are symlinked.
    xinstall -d ${destroot}${prefix}/bin
    set fd [open ${destroot}${prefix}/bin/cm3 w]
    puts $fd "#!/bin/sh"
    puts $fd "exec \"${cm3_root}/bin/cm3\" \"\$@\""
    close $fd
    file attributes ${destroot}${prefix}/bin/cm3 -permissions 0755
    foreach f [glob -directory ${destroot}${cm3_root}/bin -type f *] {
        set tool [file tail ${f}]
        if {${tool} ne "cm3" && [file executable ${f}]} {
            ln -s ../libexec/cm3/bin/${tool} ${destroot}${prefix}/bin/${tool}
        }
    }

    foreach f [glob -nocomplain -directory ${destroot}${cm3_root}/man -type f */*] {
        set section [file tail [file dirname ${f}]]
        xinstall -d ${destroot}${prefix}/share/man/${section}
        ln -s ../../../libexec/cm3/man/${section}/[file tail ${f}] \
            ${destroot}${prefix}/share/man/${section}/[file tail ${f}]
    }
}

notes "
The Modula-3 system lives in ${cm3_root}; its configuration is
${cm3_root}/bin/cm3.cfg and the libraries that packages import are
shipped under ${cm3_root}/pkg.
"
