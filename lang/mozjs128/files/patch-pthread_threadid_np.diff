Leopard, and Snow Leopard on PowerPC, lack pthread_threadid_np. Use the
thread's Mach port name as the profiler thread id instead.

diff --git mozglue/baseprofiler/core/ProfilerUtils.cpp mozglue/baseprofiler/core/ProfilerUtils.cpp
index 517efcb..102bad4 100644
--- mozglue/baseprofiler/core/ProfilerUtils.cpp
+++ mozglue/baseprofiler/core/ProfilerUtils.cpp
@@ -73,10 +73,7 @@ BaseProfilerProcessId profiler_current_process_id() {
 namespace mozilla::baseprofiler {
 
 BaseProfilerThreadId profiler_current_thread_id() {
-  uint64_t tid;
-  if (pthread_threadid_np(nullptr, &tid) != 0) {
-    return BaseProfilerThreadId{};
-  }
+  uint64_t tid = pthread_mach_thread_np(pthread_self());
   return BaseProfilerThreadId::FromNativeId(tid);
 }
 
