+  MOZ_ASSERT(p < ptrEnd);
+
+  size_t utf8CharLen = _GetIteratorLength(p);
+
+  if (utf8CharLen == 1) {
+    return *(p++);
+  }
+  uint32_t res =
+      static_cast<unsigned char>(*(p++) & (0xff >> (utf8CharLen + 1)))
+      << ((utf8CharLen - 1) * 6);
+
+  for (--utf8CharLen; utf8CharLen && p < ptrEnd; --utf8CharLen) {
+    res |= (static_cast<unsigned char>(*(p++)) - 0x80)
+           << ((utf8CharLen - 1) * 6);
