Backport from later Firefox: also ask pkg-config for icu-uc. With shared
ICU, icu-i18n.pc only lists icu-uc in Requires.private, so libicuuc was
missing from the link, which ld64 rejects for dylibs.

diff --git js/moz.configure js/moz.configure
index 593b93a..b0a1dfb 100644
--- js/moz.configure
+++ js/moz.configure
@@ -1305,7 +1305,9 @@ def enable_system_icu_option(enable_system_icu):
     return enable_system_icu
 
 
-system_icu = pkg_check_modules("MOZ_ICU", "icu-i18n >= 73.1", when="--with-system-icu")
+system_icu = pkg_check_modules(
+    "MOZ_ICU", "icu-uc icu-i18n >= 73.1", when="--with-system-icu"
+)
 
 
 @depends(enable_system_icu_option)
