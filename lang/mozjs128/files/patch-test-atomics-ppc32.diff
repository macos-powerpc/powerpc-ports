 GENERATE_TEST_LOPSIDED(16)
 GENERATE_TEST_LOPSIDED(32)
+#if !defined(__ppc__)
 GENERATE_TEST_LOPSIDED(64)
+#endif
 
 int main() {
   TestDocumentationExample();
@@ -184,6 +186,8 @@ int main() {
   TEST_LOPSIDED(8);
   TEST_LOPSIDED(16);
   TEST_LOPSIDED(32);
+#if !defined(__ppc__)
   TEST_LOPSIDED(64);
+#endif
   return 0;
 }
