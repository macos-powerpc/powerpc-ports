llvm-objdump is only used by old-configure for the ICF and static libstdc++
checks, which need GNU ld or Linux. Do not require it for GCC builds on
Darwin, where no LLVM tools may be installed.

--- moz.configure.orig
+++ moz.configure
@@ -396,6 +396,7 @@
     what="llvm-objdump",
     when="--enable-compile-environment",
     paths=clang_search_path,
+    allow_missing=True,
 )
 
 add_old_configure_assignment("LLVM_OBJDUMP", llvm_objdump)
