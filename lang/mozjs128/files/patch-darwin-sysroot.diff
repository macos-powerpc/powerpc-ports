On Darwin the sysroot comes from --with-macos-sdk and is not a bootstrapped
Linux sysroot. Treating it as one makes GCC builds pick up -isystem and -L
paths for the system gcc-4.2 libstdc++ and pass -rpath-link, which ld64
rejects.

--- build/moz.configure/toolchain.configure.orig
+++ build/moz.configure/toolchain.configure
@@ -1191,7 +1191,9 @@
             log.info("Using %s sysroot in %s", host_or_target_str, path)
         return namespace(
             path=path,
-            bootstrapped=bool(path and not sysroot_input),
+            bootstrapped=bool(
+                path and not sysroot_input and host_or_target.kernel != "Darwin"
+            ),
             stdcxx_version=version,
         )
 
@@ -1234,6 +1236,8 @@
 
     @depends(host_or_target, when=sysroot.path)
     def multiarch_dir(target):
+        if target.kernel == "Darwin":
+            return None
         if target.cpu == "x86":
             # Turn e.g. i686-linux-gnu into i386-linux-gnu
             return target.toolchain.replace(target.raw_cpu, "i386")
