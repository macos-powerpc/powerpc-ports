Leopard and Snow Leopard on PowerPC lack pthread_setname_np. configure
checks for pthread_getname_np, use that result to decide.

diff --git js/src/threading/posix/PosixThread.cpp js/src/threading/posix/PosixThread.cpp
index 35532e3..eb7064b 100644
--- js/src/threading/posix/PosixThread.cpp
+++ js/src/threading/posix/PosixThread.cpp
@@ -107,9 +107,11 @@ void ThisThread::SetName(const char* name) {
   name = nameBuf;
 #endif
 
-  int rv;
+  int rv = 0;
 #ifdef XP_DARWIN
+#  ifdef HAVE_PTHREAD_GETNAME_NP
   rv = pthread_setname_np(name);
+#  endif
 #elif defined(__DragonFly__) || defined(__FreeBSD__) || defined(__OpenBSD__)
   pthread_set_name_np(pthread_self(), name);
   rv = 0;
