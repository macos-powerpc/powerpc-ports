From eba42dcaa91149cf4b3a2e7d95316da7d507ba8d Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Thu, 12 Nov 2026 11:52:33 +0000
Subject: [PATCH] gyp: make deps/ada and deps/merve honour --shared-simdutf

node 26 moved the build of V8's vendored simdutf out of v8.gyp into its
own tools/v8_gypfiles/simdutf.gyp and gates node's own dependencies on
it on node_shared_simdutf=="false" (node.gyp, node.gypi).  ada
(deps/ada/ada.gyp) did not follow: it depends on
tools/v8_gypfiles/simdutf.gyp:simdutf unconditionally and takes
deps/v8/third_party/simdutf as an include dir through that target's
all_dependent_settings.  With --shared-simdutf configure already puts
the system library's -I and -lsimdutf into target_defaults (so every
target, ada included, compiles and links against it); the hard
dependency would additionally compile the vendored simdutf (7.7.0 at
V8 14.6) into the link next to the system library (9.3.3 from port
simdutf) and put its headers on ada's include path - a duplicate-symbol
link and a header/library mismatch.  Gate the dependency on
node_shared_simdutf=="false", the condition node.gyp and node.gypi use.
ADA_USE_SIMDUTF stays on: ada uses simdutf either way, only its origin
changes.

merve (deps/merve/merve.gyp) has the include-dir half of the same
problem: it adds deps/v8/third_party/simdutf unconditionally.  A header
from one simdutf and a library from another is not a configuration to
rely on, whichever copy the generated include order happens to find
first; gate it the same way.

(nodejs24's patch of the same name targeted ada's dependency on
v8.gyp:simdutf, which also dragged the whole V8 gyp build - and its
BUILD.gn scraping - into the --without-bundled-v8 graph.  simdutf.gyp
includes only toolchain.gypi and scrapes nothing, so at 26 the harm is
the double simdutf, not the graph.)
---
 deps/ada/ada.gyp     | 10 ++++++++--
 deps/merve/merve.gyp |  7 ++++++-
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/deps/ada/ada.gyp b/deps/ada/ada.gyp
index 855261f..da026f6 100644
--- a/deps/ada/ada.gyp
+++ b/deps/ada/ada.gyp
@@ -15,8 +15,14 @@
       'defines': [
         'ADA_USE_SIMDUTF=1',
       ],
-      'dependencies': [
-        '../../tools/v8_gypfiles/simdutf.gyp:simdutf',
+      'conditions': [
+        # With --shared-simdutf the system library's -I and -lsimdutf come
+        # from configure's target_defaults; only the bundled build needs
+        # V8's vendored copy (tools/v8_gypfiles/simdutf.gyp, whose
+        # all_dependent_settings also supply its include dir).
+        [ 'node_shared_simdutf=="false"', {
+          'dependencies': [ '../../tools/v8_gypfiles/simdutf.gyp:simdutf' ],
+        }],
       ],
       'sources': [ '<@(ada_sources)' ]
     },
diff --git a/deps/merve/merve.gyp b/deps/merve/merve.gyp
index 7712fa9..38460c2 100644
--- a/deps/merve/merve.gyp
+++ b/deps/merve/merve.gyp
@@ -8,7 +8,6 @@
       'type': 'static_library',
       'include_dirs': [
         '.',
-        '../v8/third_party/simdutf',
       ],
       'direct_dependent_settings': {
         'include_dirs': ['.'],
@@ -16,6 +15,12 @@
       'defines': [ 'MERVE_USE_SIMDUTF=1' ],
       'sources': [ '<@(merve_sources)' ],
       'conditions': [
+        # With --shared-simdutf the system library's -I comes from
+        # configure's target_defaults; only the bundled build wants V8's
+        # vendored copy on the include path.
+        ['node_shared_simdutf=="false"', {
+          'include_dirs': [ '../v8/third_party/simdutf' ],
+        }],
         ['OS=="win"', {
           'msvs_settings': {
             'VCCLCompilerTool': {
-- 
2.43.0

