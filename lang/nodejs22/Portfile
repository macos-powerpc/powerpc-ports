compiler.cxx_standard   2017

# node 22's configure accepts 3.8 through 3.14; use the same python
# as the v8-12.4 port so the G5 needs only one.
set py_ver              3.14
set py_ver_nodot        [string map {. {}} ${py_ver}]

# V8 comes prebuilt from the v8-12.4 port, which builds this very
# tarball's deps/v8 (with the ppc-darwin series) through a CMake
# harness and installs the static archives plus d8. Node's own gyp
# build is kept as is; configure --without-bundled-v8 drops the whole
# in-tree V8 build (torque, mksnapshot, all V8 compilation) and patch
# 0002 links the port's archives instead. Compile-time V8 headers
# stay the in-tree deps/v8/include: none of the v8 port's patches
# touch include/, so the bundled headers are byte-identical to what
# the archives were built against.

# New relative to nodejs16: node 22 core itself uses abseil (one
# absl::Mutex call in src/node.cc; upstream builds it from deps/v8/
# third_party/abseil-cpp via tools/v8_gypfiles/abseil.gyp). With the
# external V8 that second abseil build is dropped (patch 0009): the same
# absl sources are already compiled into the archives the v8-12.4 port
# installs, merged below into libv8_absl.a and linked into every
# linkable by patch 0002, with the same compiler and C++ ABI flags.
# The v8 port's three absl source patches are still carried (0003-0005,
# path-shifted to deps/v8) so that the absl headers node.cc includes
# match the ones the archives were compiled from.  0009 also fixes
# tools/v8_gypfiles/toolchain.gypi's "32-bit Mac means i386" ARCHS
# assumption (it emitted -arch i386 for the abseil target) for the
# bundled-V8 configuration.
set v8_port             v8-12.4
set v8_prebuilt_libdir  ${prefix}/libexec/${v8_port}/lib
# Node force_loads libv8_base_without_compiler.a (so native addons can
# resolve every V8 API symbol from the node binary), which would
# expose any archive member that cannot link outside special configs.
# The v8-12.4 harness already excludes the known offenders (the cfi
# deoptimizer and vtune TUs), so the deletions below are expected
# no-ops; they are membership-checked and kept as a guard against
# a harness regression.
set v8_libdir           ${workpath}/v8-libs

depends_build-append    path:bin/pkg-config:pkgconfig \
                        port:python${py_ver_nodot} \
                        port:${v8_port}

depends_lib-append      path:lib/pkgconfig/icu-uc.pc:icu \
                        path:lib/libuv.dylib:libuv-devel \
                        port:zlib

# node 22.23.2 bundles libuv 1.51.0 and, with --shared-libuv below, compiles
# against ${prefix}/include/uv.h instead. It needs at least libuv 1.50.0:
# uv_thread_setname (node_platform.cc, node_watchdog.cc, tracing/agent.cc)
# and uv_getrusage_thread (node_process_methods.cc, node_report.cc,
# node_worker.cc) were added there. MacPorts cannot express a version
# constraint on a dependency, so fail early with a clear message instead of
# deep inside the compile (first G5 build, 2026-09-02).
pre-configure {
    set uv_version_h ${prefix}/include/uv/version.h
    if {![file exists ${uv_version_h}]} {
        return -code error "libuv headers not found at ${uv_version_h}"
    }
    set fh [open ${uv_version_h}]
    set uv_text [read ${fh}]
    close ${fh}
    set uv_major 0
    set uv_minor 0
    set uv_patch 0
    regexp {UV_VERSION_MAJOR\s+(\d+)} ${uv_text} -> uv_major
    regexp {UV_VERSION_MINOR\s+(\d+)} ${uv_text} -> uv_minor
    regexp {UV_VERSION_PATCH\s+(\d+)} ${uv_text} -> uv_patch
    if {${uv_major} < 1 || (${uv_major} == 1 && ${uv_minor} < 50)} {
        ui_error "${name} needs libuv >= 1.50.0 (uv_thread_setname,\
            uv_getrusage_thread); found ${uv_major}.${uv_minor}.${uv_patch}\
            in ${uv_version_h}. Upgrade port libuv (node ${version} bundles\
            libuv 1.51.0)."
        return -code error "libuv too old"
    }
}

proc rec_glob {basedir pattern} {
    set files [glob -directory $basedir -nocomplain -type f $pattern]
    foreach dir [glob -directory $basedir -nocomplain -type d *] {
        lappend files {*}[rec_glob $dir $pattern]
    }
    return $files
}

configure.python        ${prefix}/bin/python${py_ver}

patch.pre_args-replace  -p0 -p1

patchfiles-append       0001-Fix-gyp-build-system-for-powerpc-darwin.patch \
                        0002-Link-against-an-external-prebuilt-V8-with-without-bu.patch \
                        0003-abseil-fall-back-to-pthread_mach_thread_np-where-pth.patch \
                        0004-abseil-darwin-ppc-build-fixes-copts-hwaes-simd-detec.patch \
                        0005-abseil-config.h-enable-TLS-with-gcc-libstdc-gate-the.patch \
                        0006-simdutf-gate-the-VSX-requiring-PPC64-kernel-behind-a.patch \
                        0007-simdjson-gate-the-PPC64-VMX-kernel-behind-an-explici.patch \
                        0008-simdjson-portable-full_multiplication-for-32-bit-non.patch \
                        0009-gyp-no-second-abseil-build-with-an-external-V8-ppc-A.patch \
                        0010-gyp-build-node-as-gnu-20-like-the-V8-archives.patch \
                        0011-crypto-read-use-system-ca-certificates-from-OpenSSL-.patch

post-patch {
    foreach f [concat ${worksrcpath}/configure \
                   ${worksrcpath}/tools/gyp/gyp \
                   ${worksrcpath}/deps/v8/tools/objdump-v8 \
                   [rec_glob ${worksrcpath} *.py]] {
        reinplace -q "s|/usr/bin/env python3|${configure.python}|" ${f}
        reinplace -q "s|/usr/bin/env python|${configure.python}|" ${f}
    }
    foreach gypfile [rec_glob ${worksrcpath} *.gyp*] {
        reinplace -q "s|'python3'|'${configure.python}'|" ${gypfile}
        reinplace -q "s|'python'|'${configure.python}'|" ${gypfile}
    }
    reinplace "s|@OSX_V@|${macosx_deployment_target}|g" ${worksrcpath}/common.gypi
    foreach f [list ${worksrcpath}/node.gyp ${worksrcpath}/node.gypi] {
        reinplace "s|@V8_LIBDIR@|${v8_libdir}|g" ${f}
    }
    if {${configure.cxx_stdlib} ne "libc++"} {
        reinplace "s|_GLIBCXX_USE_CXX11_ABI=1|_GLIBCXX_USE_CXX11_ABI=0|g" ${worksrcpath}/common.gypi
    }
}

pre-configure {
    # Copy zlib headers here because we do not want to prepend the entire
    # ${prefix}/include to the include path.
    file mkdir ${workpath}/zlib-inc
    file copy ${prefix}/include/zconf.h ${prefix}/include/zlib.h \
        ${workpath}/zlib-inc/

    # Assemble the V8 lib dir (see the comment at v8_libdir): symlink
    # every archive, but give v8_base_without_compiler a real copy with
    # any unlinkable orphan members deleted (membership-checked, so
    # a no-op with a harness-fixed v8 port).
    set v8_base libv8_base_without_compiler.a
    file delete -force ${v8_libdir}
    file mkdir ${v8_libdir}
    foreach lib [glob ${v8_prebuilt_libdir}/libv8_*.a] {
        if {[file tail ${lib}] eq ${v8_base}} {
            file copy ${lib} ${v8_libdir}
        } else {
            file link -symbolic ${v8_libdir}/[file tail ${lib}] ${lib}
        }
    }
    foreach obj {deoptimizer-cfi-builtins.cc.o deoptimizer-cfi-empty.cc.o \
                 vtunedomain-support-extension.cc.o} {
        if {![catch {exec ar -t ${v8_libdir}/${v8_base} ${obj}}]} {
            system -W ${v8_libdir} "ar -d ${v8_base} ${obj}"
        }
    }
    system -W ${v8_libdir} "ranlib ${v8_base}"

    # Merge the abseil dependency closure of the v8 archives into
    # a single archive: within one archive ld64 needs no topological
    # ordering among the 38 constituent libraries. (libtool warns
    # about one duplicate member name, escaping.cc.o from strings and
    # strings_internal; archive members are addressed by offset via
    # the symbol table, so the duplicate is harmless.)
    system -W ${v8_libdir} \
        "libtool -static -o libv8_absl.a [join [glob ${v8_prebuilt_libdir}/libabsl_*.a]]"
}

configure.args-append   --without-npm
configure.args-append   --without-corepack
# ICU: the v8-12.4 port builds V8 with V8_INTL_SUPPORT against MacPorts'
# ICU, so its archives reference libicui18n/libicuuc/libicudata and node
# must link the same ICU. system-icu does exactly that: configure puts
# pkg-config's icu-i18n/icu-uc libs and cflags into config.gypi's
# target_defaults, i.e. on every link line (node, node_mksnapshot,
# mkcodecache), which resolves the archives' ICU references, and node
# gets its own i18n on top of V8's Intl.* (URL IDNA for non-ASCII
# hostnames, Buffer.transcode(), the full TextDecoder encoding set).
# node 22 requires ICU >= 73 (tools/icu/icu_versions.json), the same
# floor V8 12.4 asserts; configure checks the pkg-config version. node
# 22.23.2's configure already probes both icu-i18n and icu-uc (the
# ICU >= 76 pkg-config split older nodejs ports patch in). The two
# ports flip together: intl=none against an i18n V8 fails to link.
configure.args-append   --with-intl=system-icu
# Unlike node 16, the node 22 inspector no longer needs ICU - only
# SSL. It is disabled here anyway to keep the first powerpc build
# minimal: it would add crdtp, src/inspector and the V8 inspector
# protocol codegen to the build surface.
# TODO (independent of the ICU flip): drop --without-inspector and
# append ${v8_libdir}/libv8_inspector.a to the archive list in patch
# 0002's node.gypi hunk - the v8-12.4 port already installs that
# archive, built without ICU, which node 22 accepts.
configure.args-append   --without-inspector
configure.args-append   --without-bundled-v8
# The v8-12.4 port is built without V8_SHARED_RO_HEAP (see that
# port's series patch 0043); node must not assume the shared
# read-only heap either.
configure.args-append   --disable-shared-readonly-heap
configure.args-append   --shared-openssl
configure.args-append   --shared-openssl-includes=[openssl::include_dir]
configure.args-append   --shared-openssl-libpath=[openssl::lib_dir]
configure.args-append   --shared-zlib
configure.args-append   --shared-zlib-includes=${workpath}/zlib-inc
configure.args-append   --shared-zlib-libpath=${prefix}/lib
# System libuv is fixed for older systems, the bundled one is not (its
# Darwin uv__hrtime calls mach_continuous_time, a 10.12 API, and scales the
# timebase with a bare multiply that overflows on PowerPC). Minimum version
# checked in the pre-configure block above.
configure.args-append   --shared-libuv

universal_variant       no

