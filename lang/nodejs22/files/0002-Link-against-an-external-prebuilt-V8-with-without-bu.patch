From 42134c6f5a1b071e24e94e155a86479681d886ef Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 1 Sep 2026 21:43:19 +0000
Subject: [PATCH 2/2] Link against an external prebuilt V8 with
 --without-bundled-v8

node 22 already carries the configure flag: node_use_bundled_v8=false
removes the only dependencies on tools/v8_gypfiles/v8.gyp, so torque,
mksnapshot and all of V8 compilation drop out of the gyp build.  What
upstream never wired up is where the V8 symbols then come from.  Add an
else-branch in node.gypi supplying the static archives installed by the
v8-12.4 port (every linkable target - node, node_mksnapshot, mkcodecache,
cctest, embedtest - includes node.gypi, so one patch point covers all),
and repoint the Darwin force_load of v8_base_without_compiler - required
so the node binary re-exports the full V8 API to native addons - from
PRODUCT_DIR to the installed archive.

The else-branch must also supply -Ideps/v8/include: the dropped v8.gyp
dependencies propagated it via direct_dependent_settings, and of the
node.gypi includers only libnode does not list deps/v8/include in its
own include_dirs - without it every libnode source fails on v8.h not
found (hit on the first nodejs16 G5 build, structural twin here).

New relative to the nodejs16 patch: libv8_absl.a.  V8 12.4 requires
abseil (v8_libbase links the absl::flat_hash_map/flat_hash_set
closure), and the v8-12.4 port installs the 38 constituent absl
archives; the Portfile merges them into a single libv8_absl.a so that
classic single-pass ld64 archive resolution needs no topological
ordering among them.

The @V8_LIBDIR@ placeholder is substituted by the Portfile.  Compile-time
headers stay the in-tree deps/v8/include: the v8-12.4 port builds from
this very tarball's deps/v8 and none of its patches touch include/, so
the bundled headers are byte-identical to what the archives were built
against.
---
 node.gyp  |  7 ++++++-
 node.gypi | 30 ++++++++++++++++++++++++++++++
 2 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/node.gyp b/node.gyp
index 758ff7e..8f6c8bb 100644
--- a/node.gyp
+++ b/node.gyp
@@ -598,10 +598,15 @@
           ],
         }],
         [ 'node_intermediate_lib_type=="static_library" and node_shared=="false"', {
+          # v8_base_without_compiler must be force-loaded in full: it is
+          # what re-exports the whole V8 API from the node binary so that
+          # native addons can resolve V8 symbols at runtime.  With
+          # --without-bundled-v8 the archive lives in the v8 port's prefix
+          # (@V8_LIBDIR@, substituted by the Portfile), not in PRODUCT_DIR.
           'xcode_settings': {
             'OTHER_LDFLAGS': [
               '-Wl,-force_load,<(PRODUCT_DIR)/<(STATIC_LIB_PREFIX)<(node_core_target_name)<(STATIC_LIB_SUFFIX)',
-              '-Wl,-force_load,<(PRODUCT_DIR)/<(STATIC_LIB_PREFIX)v8_base_without_compiler<(STATIC_LIB_SUFFIX)',
+              '-Wl,-force_load,@V8_LIBDIR@/libv8_base_without_compiler.a',
             ],
           },
           'msvs_settings': {
diff --git a/node.gypi b/node.gypi
index bb00241..d401f09 100644
--- a/node.gypi
+++ b/node.gypi
@@ -93,6 +93,36 @@
         'tools/v8_gypfiles/v8.gyp:v8_snapshot',
         'tools/v8_gypfiles/v8.gyp:v8_libplatform',
       ],
+    }, {
+      # --without-bundled-v8: supply what the dropped v8.gyp dependencies
+      # used to provide.  Headers first: their direct_dependent_settings
+      # propagated -Ideps/v8/include, and of the node.gypi includers only
+      # libnode does not list it in its own include_dirs (duplicates are
+      # harmless to gyp).
+      'include_dirs': [
+        'deps/v8/include',
+      ],
+      # Then the archives installed by the v8 port.  Absolute paths, not
+      # -L/-l: on Darwin -l would also match dylibs, and ld64 resolves
+      # archive members regardless of command line order, so no grouping
+      # is needed.  @V8_LIBDIR@ is substituted by the Portfile.
+      # link_settings on a static_library propagates to the executables
+      # that link it.  libv8_absl.a is the abseil dependency closure of
+      # v8_libbase, merged from the individual absl archives by the
+      # Portfile (single archive, so no inter-archive ordering).
+      'link_settings': {
+        'libraries': [
+          '@V8_LIBDIR@/libv8_libplatform.a',
+          '@V8_LIBDIR@/libv8_base_without_compiler.a',
+          '@V8_LIBDIR@/libv8_compiler.a',
+          '@V8_LIBDIR@/libv8_initializers.a',
+          '@V8_LIBDIR@/libv8_snapshot.a',
+          '@V8_LIBDIR@/libv8_torque_generated.a',
+          '@V8_LIBDIR@/libv8_libsampler.a',
+          '@V8_LIBDIR@/libv8_libbase.a',
+          '@V8_LIBDIR@/libv8_absl.a',
+        ],
+      },
     }],
     [ 'node_use_v8_platform=="true"', {
       'defines': [
