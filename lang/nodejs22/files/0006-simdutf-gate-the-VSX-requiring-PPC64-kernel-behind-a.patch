From f40416262fb375da280381d9d724ebe5dd932ae2 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 1 Sep 2026 22:10:51 +0000
Subject: [PATCH 6/7] simdutf: gate the VSX-requiring PPC64 kernel behind an
 explicit opt-in

The bundled simdutf 6.4.2 enables its PPC64 kernel (~1700 lines of
vec_* code requiring VSX, i.e. POWER7+) whenever __PPC64__ and plain
AltiVec macros are present.  Apple PowerPC CPUs (G4/G5) have AltiVec
but no VSX, and MacPorts cpu-tuning variants pass -mcpu=970 /
-mcpu=native, which defines __ALTIVEC__ and __VEC__ - on a 64-bit
powerpc build that combination would compile POWER7+ intrinsics for a
970.  Mirror the upstream simdutf 9.x fix from macos-powerpc
powerpc-ports 4bb9f009 (in turn after freebsd-ports d442c49f): VSX
becomes an explicit SIMDUTF_ENABLE_VSX opt-in, and the Darwin macro
spellings (__ppc64__, __ppc__ - Darwin gcc does not define __PPC64__/
__PPC__) are added so the architecture branches classify correctly.
Without the opt-in every PowerPC build selects the portable fallback,
which is big-endian-aware.

Everything derives from SIMDUTF_IS_PPC64 (the amalgamated simdutf.cpp
includes simdutf.h and has no independent raw guards), so the
detection is the single patch point.  The current ppc32 build never
reaches any of this (__PPC64__ absent, gyp passes no vector flags) -
this is armor for cpu-variant and ppc64 builds, not a fix for a
present failure.
---
 deps/simdutf/simdutf.h | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/deps/simdutf/simdutf.h b/deps/simdutf/simdutf.h
index 02ee47d..f95802c 100644
--- a/deps/simdutf/simdutf.h
+++ b/deps/simdutf/simdutf.h
@@ -162,8 +162,12 @@
   #define SIMDUTF_IS_X86_64 1
 #elif defined(__aarch64__) || defined(_M_ARM64) || defined(_M_ARM64EC)
   #define SIMDUTF_IS_ARM64 1
-#elif defined(__PPC64__) || defined(_M_PPC64)
-  #if defined(__VEC__) && defined(__ALTIVEC__)
+#elif defined(__PPC64__) || defined(_M_PPC64) || defined(__ppc64__)
+  // The PPC64 kernel requires VSX (POWER7+), but plain AltiVec detection
+  // would enable it: Apple PowerPC CPUs (G4/G5) have AltiVec and no VSX,
+  // and -mcpu=970 / -mcpu=native defines __ALTIVEC__ and __VEC__.  Make
+  // VSX an explicit opt-in instead, as simdutf 9.x does.
+  #if defined(__VEC__) && defined(SIMDUTF_ENABLE_VSX)
     #define SIMDUTF_IS_PPC64 1
   #endif
 #elif defined(__s390__)
@@ -214,7 +218,7 @@
     #define SIMDUTF_IS_X86_32BITS 1
   #elif defined(__arm__) || defined(_M_ARM)
     #define SIMDUTF_IS_ARM_32BITS 1
-  #elif defined(__PPC__) || defined(_M_PPC)
+  #elif defined(__PPC__) || defined(_M_PPC) || defined(__ppc__)
     #define SIMDUTF_IS_PPC_32BITS 1
   #endif
 
