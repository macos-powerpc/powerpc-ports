From 78d0543a4f5e901df599d7f4eb74aae81c1f2c98 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 1 Sep 2026 22:40:24 +0000
Subject: [PATCH] simdjson: portable full_multiplication for 32-bit non-MSVC
 targets

The 32-bit branch of full_multiplication calls _umul128, an MSVC
intrinsic, whenever SIMDJSON_IS_32BITS - so any 32-bit gcc/clang build
that is not ARM64 fails to compile: 32-bit gcc has no __uint128_t, so
the 64-bit branch is unavailable, and the _umul128 emulation upstream
ships in jsoncharutils sits in a namespace that unqualified lookup
from the numberparsing namespaces never reaches (verified empirically
on x86-64 gcc with SIMDJSON_IS_32BITS forced: every kernel's
full_multiplication errors out, with gcc suggesting the unreachable
jsoncharutils copy).  On darwin-ppc32 this breaks the node build in
deps/simdjson at the fallback kernel, which is always compiled.

Restrict _umul128 to SIMDJSON_REGULAR_VISUAL_STUDIO and give the
remaining 32-bit compilers the classic four-multiply emulation
(model-checked exact against 200k random and edge-case 128-bit
products).  The identical block appears once per kernel per
sub-amalgamation - 30 copies across simdjson.cpp and simdjson.h - and
all are rewritten identically.

Same fix as patch 0001 of the standalone devel/simdjson port, where it
is followed by the AltiVec kernel work; here it is carried alone as a
pure compile fix - node on powerpc uses simdjson's portable fallback
(big-endian-correct by construction) until the VMX kernel is validated
by the standalone port's test suite on real hardware.
---
 deps/simdjson/simdjson.cpp | 132 ++++++++++++++++++++++---
 deps/simdjson/simdjson.h   | 198 +++++++++++++++++++++++++++++++++----
 2 files changed, 300 insertions(+), 30 deletions(-)

diff --git a/deps/simdjson/simdjson.cpp b/deps/simdjson/simdjson.cpp
index 8f33059..2b8761f 100644
--- a/deps/simdjson/simdjson.cpp
+++ b/deps/simdjson/simdjson.cpp
@@ -9116,8 +9116,17 @@ simdjson_inline internal::value128 full_multiplication(uint64_t value1, uint64_t
   // ARM64 has native support for 64-bit multiplications, no need to emultate
   answer.high = __umulh(value1, value2);
   answer.low = value1 * value2;
-#else
+#elif SIMDJSON_REGULAR_VISUAL_STUDIO
   answer.low = _umul128(value1, value2, &answer.high); // _umul128 not available on ARM64
+#else
+  // 32-bit without MSVC: no __uint128_t and no _umul128.
+  uint64_t ad = uint64_t(uint32_t(value1 >> 32)) * uint32_t(value2);
+  uint64_t bd = uint64_t(uint32_t(value1)) * uint32_t(value2);
+  uint64_t adbc = ad + uint64_t(uint32_t(value1)) * uint32_t(value2 >> 32);
+  uint64_t adbc_carry = uint64_t(adbc < ad);
+  answer.low = bd + (adbc << 32);
+  answer.high = uint64_t(uint32_t(value1 >> 32)) * uint32_t(value2 >> 32) +
+                (adbc >> 32) + (adbc_carry << 32) + uint64_t(answer.low < bd);
 #endif // SIMDJSON_IS_ARM64
 #else // SIMDJSON_REGULAR_VISUAL_STUDIO || SIMDJSON_IS_32BITS
   __uint128_t r = (static_cast<__uint128_t>(value1)) * value2;
