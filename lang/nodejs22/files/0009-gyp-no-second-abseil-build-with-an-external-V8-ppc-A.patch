From be7c4cd0928dc132c1e98c8a54cb6088fa055912 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Wed, 2 Sep 2026 10:22:22 +0000
Subject: [PATCH] gyp: no second abseil build with an external V8; ppc ARCHS in
 the V8 toolchain

First G5 build of the port (2026-09-02) died in the abseil target: its
107 TUs compiled with -arch i386 while every other target got -arch
ppc ("g++-mp-16: warning: this compiler does not support x86 ('-arch'
option ignored)" - and the objects would have been wrong-arch anyway).

Two things, fixed separately:

1. tools/v8_gypfiles/toolchain.gypi assumes that a 32-bit V8 target on a
   Mac is Intel: for v8_target_arch in {arm, ia32, ppc} its host and
   target toolset blocks set xcode_settings ARCHS = i386, which as a
   per-target setting overrides the ARCHS ppc that common.gypi (patch
   0001) sets in target_defaults, and gyp's xcode emulation turns ARCHS
   into -arch.  Make the ARCHS choice conditional on v8_target_arch:
   ppc keeps ppc, everything else keeps upstream's i386.  The nodejs16
   port never met this because with --without-bundled-v8 nothing in
   its graph included toolchain.gypi; at 22 abseil.gyp does.

2. The abseil build itself is redundant in this configuration.  Node's
   own use of abseil is one call in src/node.cc
   (absl::SetMutexDeadlockDetectionMode, via absl/synchronization/
   mutex.h); the same source vintage is already compiled into the v8
   port's 38 absl archives, merged into libv8_absl.a and linked into
   every linkable by patch 0002's node.gypi branch, with the same
   compiler and the same MacPorts-global C++ ABI flags.  So the gyp
   abseil target contributed nothing but its include dir.  Make the
   'tools/v8_gypfiles/abseil.gyp:abseil' dependency of libnode and
   cctest conditional on node_use_bundled_v8=="true" and add
   deps/v8/third_party/abseil-cpp to node.gypi's --without-bundled-v8
   include_dirs.  Saves the 107-TU compile on the G5 and removes the
   only includer of toolchain.gypi from this port's graph (fix 1 is
   kept for the bundled-V8 configuration and as the actual root cause).

The port's absl source patches (0003-0005) stay: node.cc includes the
absl headers, and they must match the headers the v8 port compiled
the archives from.

Verified on the linux configure rig (stub xcrun/xcodebuild, fake
openssl/zlib dirs, the Portfile's exact configure arguments): configure
completes; the generated graph has no abseil target and no
deps/v8/third_party/abseil-cpp/*.cc compile rule, libnode's include
path carries deps/v8/third_party/abseil-cpp, and libv8_absl.a stays on
the link line.
---
 node.gyp                         | 16 ++++++++++++++--
 node.gypi                        |  6 ++++++
 tools/v8_gypfiles/toolchain.gypi | 22 ++++++++++++++++------
 3 files changed, 36 insertions(+), 8 deletions(-)

diff --git a/node.gyp b/node.gyp
index 8f6c8bb..47a9bbe 100644
--- a/node.gyp
+++ b/node.gyp
@@ -848,7 +848,6 @@
         'deps/googletest/googletest.gyp:gtest_prod',
         'deps/histogram/histogram.gyp:histogram',
         'deps/nbytes/nbytes.gyp:nbytes',
-        'tools/v8_gypfiles/abseil.gyp:abseil',
         'node_js2c#host',
       ],
 
@@ -888,6 +887,14 @@
       'msvs_disabled_warnings!': [4244],
 
       'conditions': [
+        # With the bundled V8, abseil is compiled from
+        # deps/v8/third_party/abseil-cpp for node's own use of it
+        # (absl::Mutex in src/node.cc).  With --without-bundled-v8 the same
+        # code is already linked from the v8 port's libv8_absl.a (node.gypi),
+        # so the second build is dropped; node.gypi supplies the include dir.
+        [ 'node_use_bundled_v8=="true"', {
+          'dependencies': [ 'tools/v8_gypfiles/abseil.gyp:abseil' ],
+        }],
         [ 'openssl_default_cipher_list!=""', {
           'defines': [
             'NODE_OPENSSL_DEFAULT_CIPHER_LIST="<(openssl_default_cipher_list)"'
@@ -1190,7 +1197,6 @@
         'deps/googletest/googletest.gyp:gtest_main',
         'deps/histogram/histogram.gyp:histogram',
         'deps/nbytes/nbytes.gyp:nbytes',
-        'tools/v8_gypfiles/abseil.gyp:abseil',
       ],
 
       'includes': [
@@ -1215,6 +1221,12 @@
       'sources': [ '<@(node_cctest_sources)' ],
 
       'conditions': [
+        # As for libnode: with the bundled V8, abseil is compiled from
+        # deps/v8/third_party/abseil-cpp for node's own use of it
+        # ...; with --without-bundled-v8 libv8_absl.a (node.gypi) covers it.
+        [ 'node_use_bundled_v8=="true"', {
+          'dependencies': [ 'tools/v8_gypfiles/abseil.gyp:abseil' ],
+        }],
         [ 'node_use_openssl=="true"', {
           'defines': [
             'HAVE_OPENSSL=1',
diff --git a/node.gypi b/node.gypi
index d401f09..26b4bc4 100644
--- a/node.gypi
+++ b/node.gypi
@@ -101,6 +101,12 @@
       # harmless to gyp).
       'include_dirs': [
         'deps/v8/include',
+        # abseil headers for node's own absl use (src/node.cc).  The code
+        # comes from libv8_absl.a below, so tools/v8_gypfiles/abseil.gyp is
+        # not built in this configuration (node.gyp).  Header/archive
+        # parity: the port's absl patches keep these headers identical to
+        # the ones the v8 port compiled the archives from.
+        'deps/v8/third_party/abseil-cpp',
       ],
       # Then the archives installed by the v8 port.  Absolute paths, not
       # -L/-l: on Darwin -l would also match dylibs, and ld64 resolves
diff --git a/tools/v8_gypfiles/toolchain.gypi b/tools/v8_gypfiles/toolchain.gypi
index ac6a345..9c1f592 100644
--- a/tools/v8_gypfiles/toolchain.gypi
+++ b/tools/v8_gypfiles/toolchain.gypi
@@ -636,10 +636,15 @@
                   }],
                 ],
               }],
+              # A 32-bit Mac target is not only Intel: keep the ppc ARCHS
+              # that common.gypi sets for a PowerPC build instead of
+              # overriding it with i386 (gyp emits it as -arch).
+              ['v8_target_arch=="ppc"', {
+                'xcode_settings': { 'ARCHS': [ 'ppc' ] },
+              }, {
+                'xcode_settings': { 'ARCHS': [ 'i386' ] },
+              }],
             ],
-            'xcode_settings': {
-              'ARCHS': [ 'i386' ],
-            },
           }],
           ['_toolset=="target"', {
             'conditions': [
@@ -654,10 +659,15 @@
                   }],
                 ],
               }],
+              # A 32-bit Mac target is not only Intel: keep the ppc ARCHS
+              # that common.gypi sets for a PowerPC build instead of
+              # overriding it with i386 (gyp emits it as -arch).
+              ['v8_target_arch=="ppc"', {
+                'xcode_settings': { 'ARCHS': [ 'ppc' ] },
+              }, {
+                'xcode_settings': { 'ARCHS': [ 'i386' ] },
+              }],
             ],
-            'xcode_settings': {
-              'ARCHS': [ 'i386' ],
-            },
           }],
         ],
       }],
