From eed236681fa7e32010dd4b84ce28cd2e6640f35e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 19:13:35 +0000
Subject: [PATCH 4/5] coroutine/ppc, ppc64: size the initial fake frame for the
 Darwin ABI

The reserve above a fresh coroutine's first frame was copied from the
ppc64le port, where 32 bytes is the whole minimal ELFv2 caller frame.
On Darwin a callee may also write into the caller's register parameter
area (32/64 bytes after the 24/48-byte linkage area), and GCC does so
whenever it homes incoming arguments, for example at -O0. With only
16/32 bytes reserved those stores land on the first words of the
fiber's VM stack, which fiber_pool_stack_alloca() carves out directly
above the machine stack: vm_stack[2], the ENV_FLAGS word of the dummy
control frame, on both ppc and ppc64. Reserve 16 words / doublewords
(64 / 128 bytes), which covers the 56 / 112 bytes the ABI allows the
callee to use and keeps the stack 16-byte aligned.

Also enter fiber_entry at its first instruction. Darwin has no
TOC-setting global entry prologue, so the +8 inherited from ppc64le
skipped the first two instructions of the function instead, which
happened to be harmless with GCC's usual mflr/save sequence.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 coroutine/ppc/Context.h   | 13 ++++++++++---
 coroutine/ppc64/Context.h | 13 ++++++++++---
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/coroutine/ppc/Context.h b/coroutine/ppc/Context.h
index 8e35a799aa..f616a091cc 100644
--- coroutine/ppc/Context.h
+++ coroutine/ppc/Context.h
@@ -14,7 +14,12 @@
 enum {
   COROUTINE_REGISTERS =
   20  /* 19 general purpose registers (r13-r31) and 1 return address */
-  + 4  /* caller linkage area, including the condition register save slot */
+  + 16 /* fake caller frame for the entry function. The Darwin ABI lets a
+          callee write into its caller's frame: the 24-byte linkage area
+          (coroutine_transfer uses its CR slot at 4(r1), the entry function
+          its LR slot at 8(r1)) and the mandatory 32-byte register parameter
+          area, where GCC homes incoming r3-r10 when they need a stack slot.
+          56 bytes, rounded up to keep the stack 16-byte aligned. */
 };
 
 struct coroutine_context
@@ -44,8 +49,10 @@ static inline void coroutine_initialize(
     context->stack_pointer -= COROUTINE_REGISTERS;
     memset(context->stack_pointer, 0, sizeof(void*) * COROUTINE_REGISTERS);
 
-    /* Skip a global prologue that sets the TOC register */
-    context->stack_pointer[19] = ((char*)start) + 8;
+    /* Return address slot of coroutine_transfer's frame. Darwin functions
+       have no TOC-setting global entry prologue, so enter at the first
+       instruction. */
+    context->stack_pointer[19] = (void*)start;
 }
 
 struct coroutine_context * coroutine_transfer(struct coroutine_context * current, struct coroutine_context * target);
diff --git a/coroutine/ppc64/Context.h b/coroutine/ppc64/Context.h
index 2cbfee67f0..d60dcd42fc 100644
--- coroutine/ppc64/Context.h
+++ coroutine/ppc64/Context.h
@@ -13,7 +13,12 @@
 enum {
   COROUTINE_REGISTERS =
   20  /* 19 general purpose registers (r13-r31) and 1 return address */
-  + 4  /* caller linkage area, including the condition register save slot */
+  + 16 /* fake caller frame for the entry function. The Darwin ABI lets a
+          callee write into its caller's frame: the 48-byte linkage area
+          (coroutine_transfer uses its CR slot at 8(r1), the entry function
+          its LR slot at 16(r1)) and the mandatory 64-byte register parameter
+          area, where GCC homes incoming r3-r10 when they need a stack slot.
+          112 bytes, rounded up to keep the stack 16-byte aligned. */
 };
 
 struct coroutine_context
@@ -43,8 +48,10 @@ static inline void coroutine_initialize(
     context->stack_pointer -= COROUTINE_REGISTERS;
     memset(context->stack_pointer, 0, sizeof(void*) * COROUTINE_REGISTERS);
 
-    /* Skip a global prologue that sets the TOC register */
-    context->stack_pointer[19] = ((char*)start) + 8;
+    /* Return address slot of coroutine_transfer's frame. Darwin functions
+       have no TOC-setting global entry prologue, so enter at the first
+       instruction. */
+    context->stack_pointer[19] = (void*)start;
 }
 
 struct coroutine_context * coroutine_transfer(struct coroutine_context * current, struct coroutine_context * target);
