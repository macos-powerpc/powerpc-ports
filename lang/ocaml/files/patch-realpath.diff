@@ -580,6 +586,25 @@ static char * caml_dirname (const char * path)
 #endif
 }
 
+#ifdef HAS_REALPATH
+
+CAMLexport char * caml_realpath(const char * path)
+{
+#ifdef REALPATH_NEEDS_BUFFER
+  /* On Mac OS X 10.5 and earlier, realpath(3) does not accept NULL as its
+     second argument (this POSIX.1-2008 extension only appeared in 10.6) and
+     crashes if it is passed one: a buffer of PATH_MAX bytes must be
+     supplied. */
+  char resolved[PATH_MAX];
+  if (realpath(path, resolved) == NULL) return NULL;
+  return strdup(resolved);
+#else
+  return realpath(path, NULL);
+#endif
+}
+
+#endif /* HAS_REALPATH */
