index f616a091cc..fa71944b65 100644
--- a/coroutine/ppc/Context.h
+++ b/coroutine/ppc/Context.h
@@ -14,6 +14,11 @@
 enum {
   COROUTINE_REGISTERS =
   20  /* 19 general purpose registers (r13-r31) and 1 return address */
+  + 36 /* 18 nonvolatile FP registers (f14-f31), 8 bytes each */
+  + 48 /* 12 nonvolatile vector registers (v20-v31), 16 bytes each; the slots
+          are reserved even in builds without AltiVec */
+  + 1  /* VRSAVE */
+  + 3  /* padding to keep coroutine_transfer's frame a multiple of 16 bytes */
   + 16 /* fake caller frame for the entry function. The Darwin ABI lets a
           callee write into its caller's frame: the 24-byte linkage area
           (coroutine_transfer uses its CR slot at 4(r1), the entry function
