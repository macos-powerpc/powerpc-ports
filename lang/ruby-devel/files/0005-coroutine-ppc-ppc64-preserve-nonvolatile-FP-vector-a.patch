From da938c1761d839e3bbaf791b156e2278cc89ce9d Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 19:15:59 +0000
Subject: [PATCH 5/5] coroutine/ppc, ppc64: preserve nonvolatile FP, vector and
 VRSAVE registers

The Darwin PowerPC ABI makes f14-f31, v20-v31 and VRSAVE callee-saved,
but coroutine_transfer only preserved r13-r31, LR and CR2-CR4. Any C
code keeping a double in a nonvolatile FPR across a fiber switch, for
example Float arithmetic that drives an Enumerator through its fiber,
resumed with whatever the other fiber had left in the register. This is
the same class of bug fixed for ppc64le in 15a43f6688.

Frames grow to 432 (ppc) and 512 (ppc64) bytes, still multiples of 16.
r13-r31 and LR keep their offsets, so coroutine_initialize() still puts
the entry address at index 19. The CR slot stays in the caller's
linkage area as before.

The FPRs are saved unconditionally. The vector registers and VRSAVE are
saved only when the compiler itself generates AltiVec code (__ALTIVEC__,
set by -maltivec or an AltiVec -mcpu), since only such code can keep
anything live in them across the call, and since the instructions trap
on CPUs without a vector unit. The vector slots are reserved in the
frame either way, so Context.h and Context.S cannot disagree about the
frame size. Context.S is preprocessed with the same CFLAGS as the C
sources, so the macro matches the code generator's setting.

Vector slots sit at 16-byte aligned offsets because stvx/lvx ignore the
low four address bits. VRSAVE is saved after the vector registers and
restored before them, so the registers are marked live whenever they
hold data the kernel must preserve.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 coroutine/ppc/Context.S   | 133 ++++++++++++++++++++++++++++++++++++--
 coroutine/ppc/Context.h   |   5 ++
 coroutine/ppc64/Context.S | 133 ++++++++++++++++++++++++++++++++++++--
 coroutine/ppc64/Context.h |   5 ++
 4 files changed, 264 insertions(+), 12 deletions(-)

diff --git a/coroutine/ppc/Context.S b/coroutine/ppc/Context.S
index ba87caef86..ece786668d 100644
--- a/coroutine/ppc/Context.S
+++ b/coroutine/ppc/Context.S
@@ -8,6 +8,21 @@
 ; Notice that this code is only for Darwin (macOS). Darwin ABI differs from AIX and ELF.
 ; To add support for AIX, *BSD or *Linux, please make separate implementations.
 
+; Nonvolatile registers in the Darwin PowerPC ABI: r13-r31, f14-f31, v20-v31,
+; VRSAVE and CR2-CR4. Frame layout, offsets from r1 after the prologue
+; (432 bytes, a multiple of 16 so that r1 stays 16-byte aligned):
+;       0 ..    75  r31 .. r13   (19 words)
+;      76           LR
+;      80 ..   223  f14 .. f31   (18 doublewords)
+;     224 ..   415  v20 .. v31   (12 quadwords, 16-byte aligned; AltiVec builds only)
+;     416           VRSAVE       (AltiVec builds only)
+;     420 ..   431  padding
+;     436           CR, which is 4(r1) of the caller: the CR save slot of its linkage area
+; coroutine_initialize() lays out the first frame of a new coroutine to match:
+; the return address goes to stack_pointer[19], everything else starts zeroed.
+; The vector slots are always reserved so that the frame size does not depend
+; on whether the build uses AltiVec.
+
 #define TOKEN_PASTE(x,y) x##y
 
 .machine ppc7400 ; = G4, Rosetta
@@ -17,9 +32,8 @@
 .align 2
 
 PREFIXED_SYMBOL(coroutine_transfer):
-	; Make space on the stack for caller registers
-	; (Should we rather use red zone? See libphobos example.)
-	subi r1,r1,80
+	; Make space on the stack for the nonvolatile registers
+	subi r1,r1,432
 
 	; Get LR
 	mflr r0
@@ -50,7 +64,61 @@ PREFIXED_SYMBOL(coroutine_transfer):
 
 	; Save nonvolatile CR fields in the caller linkage area
 	mfcr r0
-	stw r0,84(r1)
+	stw r0,436(r1)
+
+	; Save nonvolatile FP registers
+	stfd f14,80(r1)
+	stfd f15,88(r1)
+	stfd f16,96(r1)
+	stfd f17,104(r1)
+	stfd f18,112(r1)
+	stfd f19,120(r1)
+	stfd f20,128(r1)
+	stfd f21,136(r1)
+	stfd f22,144(r1)
+	stfd f23,152(r1)
+	stfd f24,160(r1)
+	stfd f25,168(r1)
+	stfd f26,176(r1)
+	stfd f27,184(r1)
+	stfd f28,192(r1)
+	stfd f29,200(r1)
+	stfd f30,208(r1)
+	stfd f31,216(r1)
+
+#ifdef __ALTIVEC__
+	; Save nonvolatile vector registers. stvx ignores the low 4 bits of the
+	; address, so these slots rely on r1 being 16-byte aligned.
+	li r11,224
+	stvx v20,r1,r11
+	li r11,240
+	stvx v21,r1,r11
+	li r11,256
+	stvx v22,r1,r11
+	li r11,272
+	stvx v23,r1,r11
+	li r11,288
+	stvx v24,r1,r11
+	li r11,304
+	stvx v25,r1,r11
+	li r11,320
+	stvx v26,r1,r11
+	li r11,336
+	stvx v27,r1,r11
+	li r11,352
+	stvx v28,r1,r11
+	li r11,368
+	stvx v29,r1,r11
+	li r11,384
+	stvx v30,r1,r11
+	li r11,400
+	stvx v31,r1,r11
+
+	; Save VRSAVE, which is nonvolatile on Darwin: functions OR in the bits of
+	; the vector registers they use and restore the old value on return.
+	mfspr r0,256
+	stw r0,416(r1)
+#endif
 
 	; Save stack pointer to first argument
 	stw r1,0(r3)
@@ -58,6 +126,59 @@ PREFIXED_SYMBOL(coroutine_transfer):
 	; Load stack pointer from second argument
 	lwz r1,0(r4)
 
+#ifdef __ALTIVEC__
+	; Restore VRSAVE first so that the vector registers reloaded below are
+	; already marked live.
+	lwz r0,416(r1)
+	mtspr 256,r0
+
+	; Restore nonvolatile vector registers
+	li r11,224
+	lvx v20,r1,r11
+	li r11,240
+	lvx v21,r1,r11
+	li r11,256
+	lvx v22,r1,r11
+	li r11,272
+	lvx v23,r1,r11
+	li r11,288
+	lvx v24,r1,r11
+	li r11,304
+	lvx v25,r1,r11
+	li r11,320
+	lvx v26,r1,r11
+	li r11,336
+	lvx v27,r1,r11
+	li r11,352
+	lvx v28,r1,r11
+	li r11,368
+	lvx v29,r1,r11
+	li r11,384
+	lvx v30,r1,r11
+	li r11,400
+	lvx v31,r1,r11
+#endif
+
+	; Restore nonvolatile FP registers
+	lfd f14,80(r1)
+	lfd f15,88(r1)
+	lfd f16,96(r1)
+	lfd f17,104(r1)
+	lfd f18,112(r1)
+	lfd f19,120(r1)
+	lfd f20,128(r1)
+	lfd f21,136(r1)
+	lfd f22,144(r1)
+	lfd f23,152(r1)
+	lfd f24,160(r1)
+	lfd f25,168(r1)
+	lfd f26,176(r1)
+	lfd f27,184(r1)
+	lfd f28,192(r1)
+	lfd f29,200(r1)
+	lfd f30,208(r1)
+	lfd f31,216(r1)
+
 	; Load return address
 	lwz r0,76(r1)
 
@@ -86,11 +207,11 @@ PREFIXED_SYMBOL(coroutine_transfer):
 	mtlr r0
 
 	; Restore nonvolatile CR2-CR4
-	lwz r0,84(r1)
+	lwz r0,436(r1)
 	mtcrf 56,r0
 
 	; Pop stack frame
-	addi r1,r1,80
+	addi r1,r1,432
 
 	; Jump to return address
 	blr
