github.tarball_from     archive

# The series is the v8-8.3 ppc-darwin series replayed onto 8.4.371.23
# and renumbered to be sequential (the old gaps at 0008 and the
# commented-out tnode.h patch are gone), plus three new patches.
# 8.4-specific deltas handled:
# - 0001 re-merged over the ptr-compr rewrite (e87972b162) and the
#   kSystemPointerSize rename (a3fbabc726): tagged loads/stores keep the
#   32-bit paths (COMPRESS_POINTERS is never defined on ppc32, decompress
#   opcodes stay PPC64-only), Code::kHeaderPaddingSize recomputed for the
#   8.4 header layout (12 with embedded constant pool, was 16 on 8.3).
# - 0027 compiles out the wasm-simd Splat/ExtractLane cases added in
#   8.4: they emit VSX moves (mtvsrd/mfvsrd/mfvsrwz) that no 32-bit
#   PowerPC implements, and four sequences do not even compile on ppc32.
#   kPPC_Load/StoreSimd128 (pure AltiVec lvx/stvx) stay enabled.
# - 0028/0029 remove the last G5-only instructions from the 32-bit
#   paths: double<->int conversions now use fctiwz and the classic
#   exponent-bias trick instead of fctidz/fcfid (optional 64-bit FPU,
#   970-only), and Float64Sqrt/Float32Sqrt call libm sqrt instead of
#   emitting fsqrt. With these, binaries built on any ppc Mac are
#   expected to run on G4 (and likely G3: the AltiVec paths are only
#   reachable through flag-gated wasm SIMD). Tested on a G5 so far.
# Historical note (from v8-8.3): with the original lineage-A series, d8
# crashed with EXC_BAD_INSTRUCTION in Builtins_JSRunMicrotasksEntry (the
# first bytecode executed after startup): speculation-poison prologues
# emit isel (POWER7+) unless DISABLE_UNTRUSTED_CODE_MITIGATIONS is
# defined, CSA baked frim/popcntw (POWER5+/7) into builtins, fcfids
# (POWER7) was emitted for int->float32, and Darwin's 4-byte bool shifted
# the IsolateData layout the generated code loads from. Patches 0016-0026
# fix these.

# Nothing to gain by using a new Python with an old V8.
set py_ver              3.11
set py_ver_nodot        [string map {. {}} ${py_ver}]

depends_build-append    port:gettext \
                        path:bin/pkg-config:pkgconfig \
                        port:python${py_ver_nodot} \
                        port:py${py_ver_nodot}-jinja2
depends_lib-append      port:gettext-runtime \
                        path:lib/pkgconfig/glib-2.0.pc:glib2 \
                        path:lib/pkgconfig/icu-uc.pc:icu

configure.python        ${prefix}/bin/python${py_ver}

patch.pre_args-replace  -p0 -p1

patchfiles-append       0001-Restore-ppc32-patches-from-upstream.patch \
                        0002-inspector-unbreak-build-with-gcc.patch \
                        0003-cpu.cc-support-powerpc-darwin.patch \
                        0004-semaphore-use-libdispatch-only-where-it-is-avai.patch \
                        0005-runtime-utils.h-fix-static_cast.patch \
                        0006-Register-specs-for-powerpc-darwin.patch \
                        0007-platform-posix.cc-for-powerpc-darwin.patch \
                        0008-embedded-file-writer-mac-support-powerpc.patch \
                        0009-Add-some-missing-headers-and-use-cinttypes-cons.patch \
                        0010-libsampler-support-powerpc-and-aarch64.patch \
                        0011-macro-assembler-ppc.h-fix-asserts-for-ppc.patch \
                        0012-CMakeLists-support-ppc-and-aarch64.patch \
                        0013-V8_TARGET_ARCH_PPC64-use-macros-correctly.patch \
                        0014-build_config.h-fix-macros.patch \
                        0015-amend-constants-ppc.patch

# Runtime correctness for ppc32 Darwin (forward-ported from the nodejs12
# ppc-darwin series and a fresh audit of the 8.3/8.4 ppc backend); see
# the individual patch headers for details:
patchfiles-append       0016-v8-use-uint8_t-for-booleans-visible-to-generated-cod.patch \
                        0017-ppc-add-Darwin-32-bit-ABI-stack-frame-constants.patch \
                        0018-ppc-use-sys_icache_invalidate-for-icache-flush-on-Da.patch \
                        0019-base-cpu-actually-query-host_info-for-the-CPU-subtyp.patch \
                        0020-ppc32-do-not-advertise-round-popcnt-machine-ops-abse.patch \
                        0021-ppc32-avoid-fcfids-in-int-to-float-conversions-POWER.patch \
                        0022-base-fix-TimeTicks-Now-mach-timebase-overflow-on-Pow.patch \
                        0023-CMake-define-DISABLE_UNTRUSTED_CODE_MITIGATIONS-for-.patch \
                        0024-libsampler-V8-s-PPC-frame-pointer-is-r31-not-r30.patch \
                        0025-build_config-256KB-V8-heap-pages-on-Darwin-PPC-4KB-O.patch \
                        0026-ppc32-fix-three-64-bit-only-instruction-emissions-re.patch \
                        0027-ppc32-compile-out-VSX-wasm-simd-Splat-ExtractLane-ca.patch \
                        0028-ppc32-double-int-conversions-without-the-64-bit-FPU-.patch \
                        0029-ppc32-implement-Float64Sqrt-Float32Sqrt-via-a-C-call.patch

post-patch {
    # Upstream mixes variations of Python shebangs, so account for all:
    fs-traverse f ${worksrcpath} {
        if {[string match *.py ${f}]} {
            reinplace -q "s|/usr/bin/env python2|${configure.python}|" ${f}
            reinplace -q "s|/usr/bin/env python3|${configure.python}|" ${f}
            reinplace -q "s|/usr/bin/env python|${configure.python}|" ${f}
        }
    }
    if {${py_ver_nodot} > 39} {
        # https://stackoverflow.com/questions/69381312/importerror-cannot-import-name-mapping-from-collections-using-python-3-10
        reinplace "s|from collections import Mapping|from collections.abc import Mapping|" ${worksrcpath}/v8/third_party/jinja2/tests.py
    }
}

# std::is_convertible
compiler.cxx_standard   2017

# type_traits: error: invalid use of incomplete type 'class v8::internal::JSAggregateError' [-fpermissive]
if {[string match *gcc* ${configure.compiler}]} {
    configure.cxxflags-append \
                        -fpermissive
    if {${configure.build_arch} in [list i386 ppc]} {
        configure.ldflags-append \
                        -latomic
    }
}

configure.args-append   -DPYTHON_EXECUTABLE=${configure.python}

destroot {
    set v8_execprefix   ${prefix}/libexec/${name}
    set docdir          ${prefix}/share/doc/${name}
    xinstall -d ${destroot}${v8_execprefix}/bin
    xinstall -d ${destroot}${v8_execprefix}/lib
    xinstall -d ${destroot}/${docdir}
    copy ${worksrcpath}/v8/include ${destroot}${v8_execprefix}
    foreach binary [list d8 mksnapshot torque] {
        copy ${cmake.build_dir}/${binary} ${destroot}${v8_execprefix}/bin
    }
    foreach slib [glob ${cmake.build_dir}/*.a] {
        copy ${slib} ${destroot}${v8_execprefix}/lib
    }
    copy ${worksrcpath}/v8/docs ${destroot}${docdir}
}
