# V8 8.4.371 is the V8 vendored by every nodejs-14 LTS (14.15-14.21.3).
name                    v8-8.4
# No support for ppc32 in master presently; no support for ppc64 on macOS.
# See: https://github.com/nodejs/node/issues/30323
github.setup            bnoordhuis v8-cmake 8.4.371.23
