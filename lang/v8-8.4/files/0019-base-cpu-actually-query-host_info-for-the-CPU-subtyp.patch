From e0e688d7882e7ab451d25c3bc484088f841f4ca4 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Fri, 28 Aug 2026 03:17:03 +0000
Subject: [PATCH] base/cpu: actually query host_info for the CPU subtype on
 Darwin
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The previous code declared an uninitialized host_basic_info struct and
switched on its garbage cpu_subtype — it never called host_info(), so
part_ was whatever the stack happened to contain (usually falling into
the default case). Call host_info() properly and default to PPC_G4
(no optional POWER5+ features) for G3 and unknown subtypes; only a
positively identified 970 reports PPC_G5.
---
 v8/src/base/cpu.cc | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/v8/src/base/cpu.cc b/v8/src/base/cpu.cc
index a9a2a26..44696e7 100644
--- a/v8/src/base/cpu.cc
+++ b/v8/src/base/cpu.cc
@@ -695,19 +695,22 @@ CPU::CPU()
 
 #elif V8_OS_MACOSX
 
-struct host_basic_info host_basic_info;
-  switch(host_basic_info.cpu_subtype) {
+  host_basic_info_data_t hbi = {};
+  mach_msg_type_number_t count = HOST_BASIC_INFO_COUNT;
+  kern_return_t kr = host_info(mach_host_self(), HOST_BASIC_INFO,
+                               reinterpret_cast<host_info_t>(&hbi), &count);
+  switch (kr == KERN_SUCCESS ? hbi.cpu_subtype : CPU_SUBTYPE_POWERPC_ALL) {
     case CPU_SUBTYPE_POWERPC_970:
-    default:
       part_ = PPC_G5;
       break;
-    case CPU_SUBTYPE_POWERPC_7450:
-      part_ = PPC_G4;
-      break;
     case CPU_SUBTYPE_POWERPC_7400:
+    case CPU_SUBTYPE_POWERPC_7450:
+    default:
+      // G4 implies no optional POWER5+ features, which is the safe
+      // assumption for G3 and anything unrecognized as well.
       part_ = PPC_G4;
       break;
-   }
+  }
 
 #endif  // V8_OS_MACOSX
 #endif  // !USE_SIMULATOR
-- 
2.43.0

