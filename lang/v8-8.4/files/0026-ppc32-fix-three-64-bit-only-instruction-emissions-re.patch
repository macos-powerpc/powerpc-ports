From 34ef8ebd7c228ae0bb4f23b52d9456c98662ab3a Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Fri, 28 Aug 2026 03:22:31 +0000
Subject: [PATCH] ppc32: fix three 64-bit-only instruction emissions reachable
 on 32-bit
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Found by re-running the 64-bit-instruction sweep from the nodejs12 port
(the method that caught MulHigh32/clrldi there):

- kPPC_Add32 emitted extsw unconditionally: the PPC64 guard only wraps
  the overflow branch, leaving extsw compiled into every 32-bit add.
  Executes silently on a 970 but SIGILLs on real 32-bit cores.

- kPPC_ByteRev32 emitted extsw on 32-bit too, and used the output
  register as scratch while the rlwimi sequence still reads the input
  register — the selector uses plain UseRegister, so output may alias
  input, silently corrupting the byte-reversed value. Use r0 as the
  scratch (as the 64-bit variant does) and mr to the output.

- TurboAssembler::LoadWordArith used lwax (64-bit-only) in its
  large-offset path with no guard; use lwzx on 32-bit.
---
 v8/src/codegen/ppc/macro-assembler-ppc.cc         |  6 ++++++
 v8/src/compiler/backend/ppc/code-generator-ppc.cc | 12 +++++++-----
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index 4059caf..bc9b25f 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -2660,7 +2660,13 @@ void TurboAssembler::LoadWordArith(Register dst, const MemOperand& mem,
   if (!is_int16(offset)) {
     DCHECK(scratch != no_reg);
     mov(scratch, Operand(offset));
+#if V8_TARGET_ARCH_PPC64
     lwax(dst, MemOperand(mem.ra(), scratch));
+#else
+    // lwax is a 64-bit-only instruction; a plain word load is equivalent
+    // on 32-bit.
+    lwzx(dst, MemOperand(mem.ra(), scratch));
+#endif
   } else {
 #if V8_TARGET_ARCH_PPC64
     int misaligned = (offset & 3);
diff --git a/v8/src/compiler/backend/ppc/code-generator-ppc.cc b/v8/src/compiler/backend/ppc/code-generator-ppc.cc
index 97a50dd..992de1d 100644
--- a/v8/src/compiler/backend/ppc/code-generator-ppc.cc
+++ b/v8/src/compiler/backend/ppc/code-generator-ppc.cc
@@ -1475,8 +1475,8 @@ CodeGenerator::CodeGenResult CodeGenerator::AssembleArchInstruction(
           __ addi(i.OutputRegister(), i.InputRegister(0), i.InputImmediate(1));
           DCHECK_EQ(LeaveRC, i.OutputRCBit());
         }
-        __ extsw(i.OutputRegister(), i.OutputRegister());
 #if V8_TARGET_ARCH_PPC64
+        __ extsw(i.OutputRegister(), i.OutputRegister());
       }
 #endif
       break;
@@ -2184,15 +2184,17 @@ CodeGenerator::CodeGenResult CodeGenerator::AssembleArchInstruction(
     case kPPC_ByteRev32: {
       Register input = i.InputRegister(0);
       Register output = i.OutputRegister();
-#if V8_TARGET_ARCH_PPC64
+      // temp1 must not alias input: the selector does not constrain
+      // output != input, and the rlwimi sequence still reads input.
       Register temp1 = r0;
-#else
-      Register temp1 = output;
-#endif
       __ rotlwi(temp1, input, 8);
       __ rlwimi(temp1, input, 24, 0, 7);
       __ rlwimi(temp1, input, 24, 16, 23);
+#if V8_TARGET_ARCH_PPC64
       __ extsw(output, temp1);
+#else
+      __ mr(output, temp1);
+#endif
       break;
     }
 #if V8_TARGET_ARCH_PPC64
-- 
2.43.0

