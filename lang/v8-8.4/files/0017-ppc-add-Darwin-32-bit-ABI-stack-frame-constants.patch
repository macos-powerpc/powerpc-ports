From fe3d5eb10f7354728b786a73de01e28ad194d955 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Fri, 28 Aug 2026 03:15:52 +0000
Subject: [PATCH] ppc: add Darwin 32-bit ABI stack frame constants

register-ppc.h had only SysV frame constants for 32-bit ppc (4 slots,
LR at 4(r1), params homed from 8(r1)), so on Darwin every C callee
stored its LR into the caller frame's parameter area and clobbered V8
frames. Darwin is AIX-like: 24-byte linkage area + 32-byte parameter
save area, LR save word at 8(r1). Use 16 slots (64 bytes, 16-byte
aligned), LR slot 2, extra param slot 14, matching the constants proven
in the nodejs12 ppc-darwin port (patch 0015 there).

ABI_PASSES_HANDLES_IN_REGS for Darwin is already handled by patch 0016.
---
 v8/src/codegen/ppc/register-ppc.h | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/v8/src/codegen/ppc/register-ppc.h b/v8/src/codegen/ppc/register-ppc.h
index cd4a7fb..e6fa42c 100644
--- a/v8/src/codegen/ppc/register-ppc.h
+++ b/v8/src/codegen/ppc/register-ppc.h
@@ -179,7 +179,27 @@ const int kNumCalleeSavedDoubles = 18;
 // The following constants describe the stack frame linkage area as
 // defined by the ABI.  Note that kNumRequiredStackFrameSlots must
 // satisfy alignment requirements (rounding up if required).
-#if V8_TARGET_ARCH_PPC
+#if V8_TARGET_ARCH_PPC && V8_OS_MACOSX
+// Darwin 32-bit ABI (AIX-like linkage area, 4-byte slots):
+// [0] back chain
+// [1] saved CR
+// [2] saved LR
+// [3] reserved
+// [4] reserved
+// [5] saved TOC (unused on Darwin)
+// [6] Parameter1 save area
+// ...
+// [13] Parameter8 save area
+// [14] Parameter9 slot (if necessary)
+// ...
+// The caller must always allocate the linkage area plus the 32-byte
+// parameter save area (14 slots, 56 bytes); round up to 16 slots (64
+// bytes) to keep the stack 16-byte aligned as the ABI requires.
+const int kNumRequiredStackFrameSlots = 16;
+const int kStackFrameLRSlot = 2;
+const int kStackFrameExtraParamSlot = 14;
+#elif V8_TARGET_ARCH_PPC
+// 32-bit SysV/ELF ABI (Linux).
 const int kNumRequiredStackFrameSlots = 4;
 const int kStackFrameLRSlot = 1;
 const int kStackFrameExtraParamSlot = 2;
-- 
2.43.0

