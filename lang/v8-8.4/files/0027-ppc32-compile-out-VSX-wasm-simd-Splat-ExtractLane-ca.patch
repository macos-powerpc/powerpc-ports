From 25736c7b550314c5b98a1020f3202ab4b0ca2438 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Fri, 28 Aug 2026 09:15:54 +0000
Subject: [PATCH] ppc32: compile out VSX wasm-simd Splat/ExtractLane cases

The 8.4 wasm-simd additions (a04762b318 "Implement simd Splat",
98c242cefb "FP Splat", 12ac48d272 "ExtractLane") emit VSX moves
(mtvsrd/mfvsrd/mfvsrwz) with no CpuFeatures::IsSupported(VSX) guard.
32-bit PowerPC (G3/G4/G5) has AltiVec but no VSX, and four of the
sequences do not even compile on ppc32 (sradi is PPC64-only, and
MovDoubleToInt64/MovInt64ToDouble take an extra hi register there).
Guard the whole case block with V8_TARGET_ARCH_PPC64; on ppc32 the
opcodes fall to UNREACHABLE. Wasm SIMD is behind
--experimental-wasm-simd and Liftoff bails out on ppc, so the paths
are runtime-dead with the flag off. kPPC_Load/StoreSimd128 (lvx/stvx,
pure AltiVec from 1568a47c) stay enabled.
---
 v8/src/compiler/backend/ppc/code-generator-ppc.cc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/v8/src/compiler/backend/ppc/code-generator-ppc.cc b/v8/src/compiler/backend/ppc/code-generator-ppc.cc
index 992de1d..81f859d 100644
--- a/v8/src/compiler/backend/ppc/code-generator-ppc.cc
+++ b/v8/src/compiler/backend/ppc/code-generator-ppc.cc
@@ -2216,6 +2216,12 @@ CodeGenerator::CodeGenResult CodeGenerator::AssembleArchInstruction(
       break;
     }
 #endif  // V8_TARGET_ARCH_PPC64
+#if V8_TARGET_ARCH_PPC64
+    // The wasm-simd Splat/ExtractLane sequences use VSX moves (mtvsrd,
+    // mfvsrd, mfvsrwz), which do not exist on 32-bit PowerPC (G3/G4/G5:
+    // AltiVec only, no VSX). Compiled out on ppc32; wasm SIMD is
+    // flag-gated and Liftoff bails out, so these opcodes are never
+    // reached (default: UNREACHABLE if they ever are).
     case kPPC_F64x2Splat: {
       Simd128Register dst = i.OutputSimd128Register();
       constexpr int shift_bits = 64;
@@ -2311,6 +2317,7 @@ CodeGenerator::CodeGenResult CodeGenerator::AssembleArchInstruction(
       __ sradi(i.OutputRegister(), kScratchReg, 24);
       break;
     }
+#endif  // V8_TARGET_ARCH_PPC64
     case kPPC_StoreCompressTagged: {
       ASSEMBLE_STORE_INTEGER(StoreTaggedField, StoreTaggedFieldX);
       break;
-- 
