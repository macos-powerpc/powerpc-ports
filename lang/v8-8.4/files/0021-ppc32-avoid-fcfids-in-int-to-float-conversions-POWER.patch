From 7927167f5b6855aede95054adf37c6176e309b97 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Fri, 28 Aug 2026 03:17:58 +0000
Subject: [PATCH] ppc32: avoid fcfids in int-to-float conversions (POWER7-only,
 SIGILLs on G5)

ConvertIntToFloat/ConvertUnsignedIntToFloat emitted fcfids (ISA 2.06)
unguarded; it is reachable on 32-bit via kPPC_Int32ToFloat32/
kPPC_Uint32ToFloat32 (e.g. Math.fround, Float32Array traffic) and does
not exist on 970/G4-class cores. Use fcfid (64-bit ISA, present on the
970) followed by frsp: fcfid is exact for any 32-bit integer and frsp
performs the single correctly-rounded narrowing.

Note: this file still requires a 64-bit FPU (fcfid/fctidz), i.e. G5 as
minimum silicon; G4/G3 support would need the manual bit-twiddling
conversion paths from the Rockwell ppc32 lineage.
---
 v8/src/codegen/ppc/macro-assembler-ppc.cc | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index a7b8d1a..4059caf 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -807,13 +807,25 @@ void TurboAssembler::ConvertUnsignedIntToDouble(Register src,
 
 void TurboAssembler::ConvertIntToFloat(Register src, DoubleRegister dst) {
   MovIntToDouble(dst, src, r0);
+#if V8_TARGET_ARCH_PPC64
   fcfids(dst, dst);
+#else
+  // fcfids is ISA 2.06 (POWER7+), absent on G4/G5. fcfid is exact for any
+  // int32, and frsp then rounds once to single precision — same result.
+  fcfid(dst, dst);
+  frsp(dst, dst);
+#endif
 }
 
 void TurboAssembler::ConvertUnsignedIntToFloat(Register src,
                                                DoubleRegister dst) {
   MovUnsignedIntToDouble(dst, src, r0);
+#if V8_TARGET_ARCH_PPC64
   fcfids(dst, dst);
+#else
+  fcfid(dst, dst);
+  frsp(dst, dst);
+#endif
 }
 
 #if V8_TARGET_ARCH_PPC64
