From e0cf7d77829d8b72becf237bb1568a16c0d36ef1 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 02:26:09 +0000
Subject: [PATCH 215/217] expand/proc_macro: send `-=`, `<<=`, `>>=` and
 `yield` to proc macros as themselves

The table mapping mrustc's tokens to the symbols a proc macro receives had
`-=` as `-`, `<<=` as `<=`, `>>=` as `>=` and `yield` as `yeild` (upstream since
2024). Every proc macro input goes through it: a function-like macro's tokens
directly, and an attribute macro's item through the AST printer and back, so
a fn body written as `x -= 1;` reached `#[async_trait]`, `#[tokio::main]`,
`#[tracing::instrument]` and the like as `x - 1;`. A macro that gives the body
back produced code that still compiles and silently does nothing (`<<=`/`>>=`
became comparisons); `+=`, `*=`, `^=`, ... were right.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/expand/proc_macro.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 608099f0..08fbac39 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -595,7 +595,7 @@ namespace {
 
             case TOK_EQUAL:     m_pmi.send_symbol("="); break;
             case TOK_PLUS_EQUAL:    m_pmi.send_symbol("+="); break;
-            case TOK_DASH_EQUAL:    m_pmi.send_symbol("-"); break;
+            case TOK_DASH_EQUAL:    m_pmi.send_symbol("-="); break;
             case TOK_PERCENT_EQUAL: m_pmi.send_symbol("%="); break;
             case TOK_SLASH_EQUAL:   m_pmi.send_symbol("/="); break;
             case TOK_STAR_EQUAL:    m_pmi.send_symbol("*="); break;
@@ -611,8 +611,8 @@ namespace {
             case TOK_DOUBLE_PIPE:   m_pmi.send_symbol("||"); break;
             case TOK_DOUBLE_LT:     m_pmi.send_symbol("<<"); break;
             case TOK_DOUBLE_GT:     m_pmi.send_symbol(">>"); break;
-            case TOK_DOUBLE_LT_EQUAL:   m_pmi.send_symbol("<="); break;
-            case TOK_DOUBLE_GT_EQUAL:   m_pmi.send_symbol(">="); break;
+            case TOK_DOUBLE_LT_EQUAL:   m_pmi.send_symbol("<<="); break;
+            case TOK_DOUBLE_GT_EQUAL:   m_pmi.send_symbol(">>="); break;
 
             case TOK_DOLLAR:    m_pmi.send_symbol("$"); break;
 
@@ -655,7 +655,7 @@ namespace {
             case TOK_RWORD_CONTINUE:m_pmi.send_rword("continue"); break;
             case TOK_RWORD_BREAK:   m_pmi.send_rword("break");  break;
             case TOK_RWORD_RETURN:  m_pmi.send_rword("return"); break;
-            case TOK_RWORD_YIELD:   m_pmi.send_rword("yeild");  break;
+            case TOK_RWORD_YIELD:   m_pmi.send_rword("yield");  break;
             case TOK_RWORD_BOX:     m_pmi.send_rword("box");    break;
             case TOK_RWORD_REF:     m_pmi.send_rword("ref");    break;
             case TOK_RWORD_FALSE:   m_pmi.send_rword("false"); break;
