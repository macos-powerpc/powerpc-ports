         return ::MIR::Constant::make_ItemAddr(box$(vtable_path));
     }
+
+    /// Descend from `lv` (of type `ty`) to the struct/tuple field or array element that starts `ofs` bytes in.
+    /// Returns false if the offset doesn't land on the start of one.
+    bool place_at_offset(const ::MIR::TypeResolve& state, MirMutator& mutator, ::MIR::LValue& lv, ::HIR::TypeRef& ty, size_t ofs)
+    {
+        while( ofs > 0 )
+        {
+            if( const auto* te = ty.data().opt_Array() )
+            {
+                size_t size = 0;
+                if( !te->size.is_Known() || !Target_GetSizeOf(state.sp, state.m_resolve, te->inner, size) || size == 0 )
+                    return false;
+                size_t idx = ofs / size;
+                if( idx >= te->size.as_Known() )
+                    return false;
+                auto idx_lv = mutator.in_temporary( ::HIR::CoreType::Usize, ::MIR::Constant::make_Uint({ U128(idx), ::HIR::CoreType::Usize }) );
+                lv = ::MIR::LValue::new_Index(mv$(lv), idx_lv.as_Local());
+                ofs -= idx * size;
+                auto inner = te->inner.clone();
+                ty = mv$(inner);
+            }
+            else if( ty.data().is_Tuple() || TU_TEST1(ty.data(), Path, .binding.is_Struct()) )
+            {
+                const auto* repr = Target_GetTypeRepr(state.sp, state.m_resolve, ty);
+                if( !repr )
+                    return false;
+                const TypeRepr::Field* fld = nullptr;
+                unsigned idx = 0;
+                for(const auto& f : repr->fields)
+                {
+                    size_t size = 0;
+                    if( Target_GetSizeOf(state.sp, state.m_resolve, f.ty, size) && f.offset <= ofs && ofs < f.offset + size ) {
+                        fld = &f;
+                        break;
+                    }
+                    idx ++;
+                }
+                if( !fld )
+                    return false;
+                lv = ::MIR::LValue::new_Field(mv$(lv), idx);
+                ofs -= fld->offset;
+                auto inner = fld->ty.clone();
+                ty = mv$(inner);
+            }
+            else
+            {
+                return false;
+            }
+        }
+        return true;
+    }
 }
 
