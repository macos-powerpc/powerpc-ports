From f15989e967922ec61c19b2572c9f17b65225fa51 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 03:28:54 +0000
Subject: [PATCH] parse: trait items, enum variants and their fields take an (inherited)
 visibility

rustc parses a visibility in front of a trait item, an enum variant and
a variant's fields, then rejects anything but the inherited one (E0449). mrustc
went straight to the item, so a `$v:vis` fragment that matched nothing - still
a token - was "Unexpected token TOK_INTERPOLATED_VIS". objc2 0.6.4
`extern_protocol!` (objc2-foundation 0.3.2 copying.rs, cargo-c 0.10.25):

    __extern_protocol_rewrite_methods: `$v:vis fn $name:ident($($params:tt)*) ..`
    __rewrite_self_param / __extract_method_attributes: `($v fn $name(..) -> $ret)` as `tt`s
    __extern_protocol_method_out: `$($attr_method)* $($function_start)* where .. { .. }`

in the body of `pub unsafe trait NSCopying`, i.e. an interpolated empty
visibility as the first token of a trait method:

    MACRO<::"objc2-0_6_4_H104001"::..::__extern_protocol_method_out> error:0: Unexpected token TOK_INTERPOLATED_VIS

Parse_Trait_Item and Parse_EnumDef (variants, tuple and struct-like fields)
now parse the visibility first and error on a non-inherited one as rustc does.
In a trait body it comes before the macro-invocation and `$item` checks, so
an empty `$v` can precede those too.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/parse/root.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 689ca4f9..7e7cedcf 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -181,6 +181,16 @@ namespace {
         return AST::Visibility::make_restricted(AST::Visibility::Ty::Private, vis_mod_path(lex));
     }
 }
+/// rustc parses a visibility on trait items, enum variants and their fields, then rejects anything but the inherited
+/// one (E0449). A `$v:vis` fragment that matched nothing is still a token: objc2 0.6.4 `extern_protocol!` forwards
+/// `$v fn $name(..)` through its tt-munchers into the trait body (objc2-foundation 0.3.2).
+void Parse_Publicity_Inherited(TokenStream& lex, const char* what)
+{
+    if( Parse_Publicity(lex).ty() != AST::Visibility::Ty::Private )
+    {
+        ERROR(lex.point_span(), E0000, "visibility qualifiers are not permitted here (" << what << ")");
+    }
+}
 
 ::AST::HigherRankedBounds Parse_HRB(TokenStream& lex)
 {
@@ -765,6 +775,9 @@ AST::Named<AST::Item> Parse_Trait_Item(TokenStream& lex)
 
     auto ps = lex.start_span();
 
+    // Parsed first (rustc), so an empty `$v:vis` can also precede a macro invocation or an interpolated item
+    Parse_Publicity_Inherited(lex, "trait item");
+
     {
         ::AST::MacroInvocation  inv;
         if( Parse_MacroInvocation_Opt(lex, inv) )
@@ -1006,6 +1019,7 @@ AST::Enum Parse_EnumDef(TokenStream& lex, const AST::AttributeList& meta_items)
         auto item_attrs = Parse_ItemAttrs(lex);
         SET_ATTRS(lex, item_attrs);
 
+        Parse_Publicity_Inherited(lex, "enum variant");
         GET_CHECK_TOK(tok, lex, TOK_IDENT);
         auto name = tok.ident().name;
         // Tuple-like variants
@@ -1020,6 +1034,7 @@ AST::Enum Parse_EnumDef(TokenStream& lex, const AST::AttributeList& meta_items)
                 }
 
                 auto field_attrs = Parse_ItemAttrs(lex);
+                Parse_Publicity_Inherited(lex, "enum variant field");
                 auto ty = Parse_Type(lex);
                 items.emplace_back( std::move(field_attrs), AST::Visibility::make_global(), std::move(ty) );
             } while( GET_TOK(tok, lex) == TOK_COMMA );
@@ -1037,6 +1052,7 @@ AST::Enum Parse_EnumDef(TokenStream& lex, const AST::AttributeList& meta_items)
                 }
 
                 auto field_attrs = Parse_ItemAttrs(lex);
+                Parse_Publicity_Inherited(lex, "enum variant field");
 
                 GET_CHECK_TOK(tok, lex, TOK_IDENT);
                 auto name = tok.ident().name;
