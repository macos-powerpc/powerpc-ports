From f116fcfc08a31abfed98fa180745b2932da3548b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 17:04:56 +0000
Subject: [PATCH] expand: `panic!` with an argument that starts with a string
 literal and goes on is a payload (std's `panic_2015`)

pest_meta 2.1.3 (nsh 0.4.2) src/lib.rs:33 `panic!("grammar error\n\n".to_owned() + &e.into_iter()...join("\n\n"))`:
"lib.rs:38:1 error:0: Type mismatch between &str and ::"alloc-0_0_0"::string::String". In a 2015/2018 std crate
rustc's `panic!` is std::panic::panic_2015, whose single-argument arm is `rt::begin_panic` (any payload); core's arm is
`panic_str_2015(&str)`. 0044 routed that form through std, but told it from core's literal form by the FIRST token
only, so an argument starting with a string literal stayed on core whatever followed. Not a regression: before 0044
every such panic went to core.

is_payload_panic: core's forms are nothing, a string literal alone (a trailing comma allowed) and a string literal
followed by format arguments; a string literal followed by anything other than a comma continues an expression = a payload.

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/expand/panic.cpp b/src/expand/panic.cpp
index faf6e986..58bce8f2 100644
--- a/src/expand/panic.cpp
+++ b/src/expand/panic.cpp
@@ -17,15 +17,22 @@
 class CExpander_panic:
     public ExpandProcMacro
 {
-    /// `panic!(<payload>)`: a single argument that isn't a string literal
+    /// `panic!(<payload>)`: a single argument that isn't a string literal. core's forms are nothing, a string literal
+    /// alone (a trailing comma allowed) and a string literal followed by format arguments; anything else is a payload,
+    /// including an expression that starts with a string literal and goes on (pest_meta 2.1.3
+    /// `panic!("grammar error\n\n".to_owned() + &..)`: only the first token used to be looked at)
     static bool is_payload_panic(const TokenTree& tt)
     {
         const TokenTree* first = nullptr;
+        const TokenTree* second = nullptr;
         if( tt.is_token() ) {
             first = &tt;
         }
-        else if( tt.size() > 0 ) {
-            first = &tt[0];
+        else {
+            if( tt.size() > 0 )
+                first = &tt[0];
+            if( tt.size() > 1 )
+                second = &tt[1];
         }
         if( !first ) {
             return false;
@@ -35,14 +42,19 @@ class CExpander_panic:
             return true;
         }
         const auto& t = first->tok();
+        bool is_string_literal = false;
         if( t.type() == TOK_STRING ) {
-            return false;
+            is_string_literal = true;
         }
-        if( t.type() == TOK_INTERPOLATED_EXPR ) {
+        else if( t.type() == TOK_INTERPOLATED_EXPR ) {
             // A `$msg:expr` fragment: look through to the literal (NOTE: `frag_node` has no const overload)
-            return dynamic_cast<const AST::ExprNode_String*>( &const_cast<Token&>(t).frag_node() ) == nullptr;
+            is_string_literal = dynamic_cast<const AST::ExprNode_String*>( &const_cast<Token&>(t).frag_node() ) != nullptr;
+        }
+        if( !is_string_literal ) {
+            return true;
         }
-        return true;
+        // The literal alone, with a trailing comma or with format arguments after the comma: core's form
+        return second && !(second->is_token() && second->tok().type() == TOK_COMMA);
     }
     ::std::unique_ptr<TokenStream> expand(const Span& sp, const ::AST::Crate& crate, const TokenTree& tt, AST::Module& mod) override
     {
