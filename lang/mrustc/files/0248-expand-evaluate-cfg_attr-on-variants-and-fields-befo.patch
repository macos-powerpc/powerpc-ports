From e8f4530c3b68cec248236c28f5182bebf1f60ac6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 05:11:31 +0000
Subject: [PATCH 248/250] expand: evaluate `#[cfg_attr]` on variants and fields
 before the item's derives run

gix-hash 0.22.1 (gql 0.43.0), lib.rs:74:

    error:0: No #[default] attribute on enum with derive(Default)

    #[derive(Default, PartialEq, Eq, Debug, Hash, Ord, PartialOrd, Clone, Copy)]
    pub enum Kind {
        #[cfg_attr(feature = "sha1", default)]
        #[cfg(feature = "sha1")]
        Sha1 = 1,
        #[cfg_attr(all(not(feature = "sha1"), feature = "sha256"), default)]
        #[cfg(feature = "sha256")]
        Sha256 = 2,
    }

rustc cfg-evaluates the whole item, the attributes of its variants and
fields included, before any derive sees it. Expand_Mod's pre-derive pass
over an enum's variants and a struct's fields only stripped `#[cfg]` and
left `cfg_attr` to the later per-variant visit, so the builtin Default
derive found no `#[default]` marker. The pre-derive pass now runs
Expand_Attrs_CfgAttr on every variant and field first, which also lets
a `cfg_attr` produce the `#[cfg]` it then tests; the later visit has
nothing left to expand there.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/expand/mod.cpp b/src/expand/mod.cpp
index 69606ff1..0b34b556 100644
--- a/src/expand/mod.cpp
+++ b/src/expand/mod.cpp
@@ -2098,14 +2098,21 @@ void Expand_Mod(const ExpandState& es, ::AST::AbsolutePath modpath, ::AST::Modul
         }
 
         // Pre-exapand inner `#[cfg]`
+        // - `#[cfg_attr]` on variants and fields is evaluated here too (rustc cfg-evaluates the whole item before
+        //   its derives run): `#[derive(Default)]` looks for the `#[default]` a `#[cfg_attr(feature = "sha1", default)]`
+        //   produces (gix-hash 0.22.1 lib.rs:74, gql 0.43.0), and a `cfg_attr` may produce the `#[cfg]` tested below.
         {
             struct H {
                 static void filter_cfg(::std::vector<AST::StructItem>& lst) {
+                    for(auto& v : lst)
+                        Expand_Attrs_CfgAttr(v.m_attrs);
                     auto new_end = ::std::remove_if(lst.begin(), lst.end(), [&](const AST::StructItem& v) { return !check_cfg_attrs(v.m_attrs); });
                     DEBUG(lst.size() << " -> " << new_end - lst.begin());
                     lst.erase(new_end, lst.end());
                 }
                 static void filter_cfg(::std::vector<AST::TupleItem>& lst) {
+                    for(auto& v : lst)
+                        Expand_Attrs_CfgAttr(v.m_attrs);
                     auto new_end = ::std::remove_if(lst.begin(), lst.end(), [&](const AST::TupleItem& v) { return !check_cfg_attrs(v.m_attrs); });
                     DEBUG(lst.size() << " -> " << new_end - lst.begin());
                     lst.erase(new_end, lst.end());
@@ -2132,6 +2139,7 @@ void Expand_Mod(const ExpandState& es, ::AST::AbsolutePath modpath, ::AST::Modul
             TU_ARMA(Enum, enm) {
                 for(auto it = enm.variants().begin(); it != enm.variants().end(); )
                 {
+                    Expand_Attrs_CfgAttr(it->m_attrs);
                     if( !check_cfg_attrs(it->m_attrs) ) {
                         it = enm.variants().erase(it);
                     }
