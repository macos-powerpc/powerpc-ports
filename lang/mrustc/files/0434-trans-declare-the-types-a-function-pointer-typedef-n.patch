From 7ed9d6e709c3cfc8803f93373853255344efced2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 5 Nov 2026 21:31:16 +0000
Subject: [PATCH] trans: declare the types a function pointer typedef names
 before writing it

pavao 0.3.1 (termscp 1.2.2) libpavao-0_3_1.rlib.c: "error: passing argument
3 of 'var6' from incompatible pointer type [-Wincompatible-pointer-types]
.. note: expected 'struct e_..c_void *' but argument is of type 'struct
e_..c_void *'" (an error since GCC 14).

`get_fn(ctx, smbc_getFunctionWrite)` passes the getter as `unsafe extern
"C" fn(*mut SMBCCTX) -> Option<fn(*mut SMBCCTX, *mut SMBCFILE, *const
c_void, usize) -> isize>`. emit_type_fn writes the typedefs a signature
depends on first: the scalarised `Option<fn>` return names the inner
function type, so the inner typedef went out right there, ahead of the
type walker's order, and before `struct e_..c_void;` had been declared
(the walker reaches c_void only through the inner type's own arguments,
which it visits later). A struct first named in a parameter list is
a prototype-scope type, distinct from the file-scope one, so the call
through the pointer did not type-check.

The dependency pass now walks every argument and return type of the
typedef through its pointers and forward-declares the struct/enum/union
(or tuple/array typedef) it names, besides emitting nested function
typedefs. Repeated declarations are allowed in C, so the walker's own
protos are unaffected.

Assisted-by: Claude Fable 5.1 <noreply@anthropic.com
---

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 3aa33542..582bae13 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -2548,20 +2548,27 @@ namespace {
             // Likewise a scalarised pointer newtype names its pointee, which the walker never visited: declare it
             // here, as a struct first named in a parameter list is a different type from the file-scope one.
             // - imagequant-sys 4.0.3: `liq_image_create_custom`'s row callback takes an `AnySyncSendPtr(*mut c_void)`
+            // The same goes for every other struct/enum/union the signature names, by value or through pointers: this
+            // typedef can be emitted as another function type's dependency (the line above) before the walker reached
+            // those types. GCC 14 rejects a call through such a pointer ("incompatible pointer type", the parameter's
+            // prototype-scope struct against the file-scope one).
+            // - pavao-sys 0.3.1 (termscp 1.2.2): `smbc_getFunctionWrite: fn(*mut SMBCCTX) -> Option<fn(.., *const c_void,
+            //   usize) -> isize>` had the inner typedef written before `struct e_..c_void;`
             {
                 auto emit_dep = [&](const ::HIR::TypeRef* scalar, const ::HIR::TypeRef& t) {
-                    if( use_cabi && scalar ) {
-                        const auto* cur = scalar;
-                        while( cur->data().is_Pointer() || cur->data().is_Borrow() ) {
-                            cur = cur->data().is_Pointer() ? &cur->data().as_Pointer().inner : &cur->data().as_Borrow().inner;
-                        }
-                        // Repeated struct declarations and identical typedefs are both allowed in C
-                        emit_type_proto(*cur);
+                    // The type as the typedef spells it
+                    const auto* cur = (use_cabi && scalar) ? scalar : &t;
+                    while( cur->data().is_Pointer() || cur->data().is_Borrow() ) {
+                        cur = cur->data().is_Pointer() ? &cur->data().as_Pointer().inner : &cur->data().as_Borrow().inner;
                     }
-                    else if( t.data().is_Function() ) {
-                        emit_type_fn(t);
+                    if( cur->data().is_Function() ) {
+                        emit_type_fn(*cur);
                         m_of << "\n";
                     }
+                    else if( cur->data().is_Path() || cur->data().is_Tuple() || cur->data().is_Array() || cur->data().is_NamedFunction() ) {
+                        // Repeated struct declarations and identical typedefs are both allowed in C
+                        emit_type_proto(*cur);
+                    }
                     };
                 emit_dep(use_cabi ? cabi.ret : nullptr, te.m_rettype);
                 for(unsigned int i = 0; i < te.m_arg_types.size(); i ++) {
