From 40babd61c03abea74756343da00d309ce55c8e25 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 07:09:57 +0000
Subject: [PATCH] mir: exclusive range patterns next to other ranges; `char`
 ranges ending at U+10FFFF

libbz2-rs-sys 0.2.5 src/compress.rs:260 (fselect 0.10.3):

    let nGroups: usize = match s.nMTF {
        0..200 => 2, 200..600 => 3, 600..1200 => 4, 1200..2400 => 5, _ => 6,
    };

    BUG: from_hir_match.cpp:2295: TODO: Handle overlap with exclusive ranges: 0..200 and 200..600

rules_overlap compared two ranges only when both were inclusive. Two
ranges overlap when each starts before the other ends, and
`is_within_right` already gives "before the end" for an inclusive or
an exclusive end. That one expression now covers every combination, so
`0..200` and `200..600` are disjoint.

The runtime kit found a second, silent bug in the range dispatch for
`char`. The upper-bound test was skipped for an exclusive range ending
at U+10FFFF (`'z'..'\u{10FFFF}'` accepted U+10FFFF), and a matching
assert in the single-rule path insisted such ranges were inclusive.
Like the integer types, an exclusive end now always gets its test, and
an inclusive one only below U+10FFFF.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/mir/from_hir_match.cpp b/src/mir/from_hir_match.cpp
index 7326d9d5..741349a3 100644
--- a/src/mir/from_hir_match.cpp
+++ b/src/mir/from_hir_match.cpp
@@ -2285,35 +2285,9 @@ namespace {
                 if( ae->first == be->first )
                     return true;
 
-                //auto check_ends = []( const PatternRule::Data_ValueRange& lo, const PatternRule::Data_ValueRange& hi)->bool {
-                //    return lo.is_inclusive == hi.is_inclusive ? lo.last <= hi.last
-                //        : (lo.is_inclusive
-                //            ? lo.last < hi.last // Lower side is inclusive, higher side exlusive - must be less than higher side
-                //            : throw "TODO" // Lower side is excl, higher side incl - lower+1 < higher = lower < higher-1 = lower
-                //            );
-                //    };
-                ASSERT_BUG(Span(), ae->is_inclusive && be->is_inclusive, "TODO: Handle overlap with exclusive ranges: "
-                    << ae->first << ".." << (ae->is_inclusive ? "=" : "") << ae->last
-                    << " and "
-                    << be->first << ".." << (be->is_inclusive ? "=" : "") << be->last
-                    );
-                assert(ae->is_inclusive && "TODO: Exclusive ranges");
-                assert(be->is_inclusive && "TODO: Exclusive ranges");
-                // Start of B within A
-                if( ae->first <= be->first && is_within_right(be->first, *ae) )
-                    return true;
-                // End of B within A
-                if( is_within_right(ae->first, *be) && be->last <= ae->last ) // TODO: Right-exclusive (if equal type then original check, otherwise complex)
-                    return true;
-                // Start of A within B
-                if( be->first <= ae->first && is_within_right(ae->first, *be) )
-                    return true;
-                // End of A within B
-                if( is_within_right(be->first, *ae) && ae->last <= be->last ) // TODO: Right-exclusive
-                    return true;
-
-                // Disjoint
-                return false;
+                // Each starts before the other ends (`is_within_right` handles an inclusive or exclusive end)
+                // - libbz2-rs-sys 0.2.5 (fselect): `0..200` and `200..600` arms -> "TODO: Handle overlap with exclusive ranges"
+                return is_within_right(be->first, *ae) && is_within_right(ae->first, *be);
             }
             else
             {
@@ -2842,8 +2816,8 @@ int MIR_LowerHIR_Match_Simple__GeneratePattern(MirBuilder& builder, const Span&
                     }
 
                     // IF `val` > `last` : fail_bb
-                    if(re.last.as_Uint().v >= 0x10FFFF ) {
-                        assert(re.is_inclusive);
+                    // (`..'\u{10FFFF}'` excludes the last char: the comparison below)
+                    if(re.last.as_Uint().v >= 0x10FFFF && re.is_inclusive ) {
                         builder.end_block( ::MIR::Terminator::make_Goto({ succ_bb }) );
                     }
                     else {
@@ -4043,7 +4017,8 @@ void MatchGenGrouped::gen_dispatch_range(const field_path_t& field_path, const :
             break;
         case ::HIR::CoreType::Char:
             lower_possible = (first.as_Uint().v > 0);
-            upper_possible = is_inclusive ? (last.as_Uint().v <= 0x10FFFF) : (last.as_Uint().v < 0x10FFFF);
+            // As for integers: an exclusive end always needs the test (`'z'..'\u{10FFFF}'` must reject U+10FFFF)
+            upper_possible = is_inclusive ? (last.as_Uint().v < 0x10FFFF) : true;
             break;
         case ::HIR::CoreType::F16:
         case ::HIR::CoreType::F32:
