From 745bee3996b084c4194092426ef829b085f9d79b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 12:18:52 +0000
Subject: [PATCH] macro_rules/trans: a `$body:block` fn body inside
 `$item:item`, and `#[export_name]`

ring 0.17.14 (tombi 1.8.4), src/prefixed.rs `prefixed_export!` on its
non-x86/arm path (arithmetic/montgomery.rs:200), found right behind the
0258 error:

    MACRO<..::prefixed_export> BUG: src/macro_rules/eval.cpp:2353: TODO:
    Macro_InvokeRules_MatchPattern - No arm matched - (34, 10)

`prefixed_export! { unsafe extern "C" fn bn_mul_mont(..) {..} }` writes
the `$body:block` back as the fn body and hands the item to
`prefixed_item!`'s `$item:item`; the matcher's item consumer took only
`{ .. }` or `;` after a fn signature, and token 10 (an interpolated
block) ended the arm. The fn arm and its `where` scan now accept
an interpolated block.

Past that, `#[export_name = ".."]` had no handler at all, so the
definition kept its mangled name while ring's C calls
`ring_core_0_17_14__bn_mul_mont`: an undefined symbol at the final link.
`export_name` is now `link_name`'s handler under another name (the symbol
a definition is emitted as, like `#[no_mangle]` with a chosen name). And
link-named functions are codegen roots of an rlib/dylib/cdylib as they
already were of a staticlib or executable: rustc exports them whatever
the crate type, and a consumer crate only sees a prototype (a non-inline
function's MIR is not saved), so the rlib's object must define them.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/expand/codegen.cpp b/src/expand/codegen.cpp
index bfb4e6bd..d6860885 100644
--- a/src/expand/codegen.cpp
+++ b/src/expand/codegen.cpp
@@ -398,6 +398,14 @@ class CHandler_LinkName:
     }
 };
 STATIC_DECORATOR("link_name", CHandler_LinkName);
+// `#[export_name = ".."]` on a definition: the symbol it is emitted as, like `#[no_mangle]` with a chosen name. ring
+// 0.17.14 prefixed.rs `prefixed_export!` -> `#[export_name = concat!(prefix!(), stringify!($name))] unsafe extern "C"
+// fn bn_mul_mont(..) {..}` (arithmetic/montgomery.rs:200, tombi 1.8.4), called by ring's C code. Was ignored.
+class CHandler_ExportName:
+    public CHandler_LinkName
+{
+};
+STATIC_DECORATOR("export_name", CHandler_ExportName);
 
 class CHandler_LinkSection:
     public ExpandDecorator
diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 2b12b4eb..2b7b831c 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -1781,7 +1781,7 @@ namespace
                 if(lex.consume_if(TOK_RWORD_WHERE))
                 {
                     do {
-                        if( lex.next() == TOK_BRACE_OPEN || lex.next() == TOK_SEMICOLON )
+                        if( lex.next() == TOK_BRACE_OPEN || lex.next() == TOK_SEMICOLON || lex.next() == TOK_INTERPOLATED_BLOCK )
                             break;
                         if( lex.consume_if(TOK_LIFETIME) ) {
                             if( !lex.consume_if(TOK_COLON) )
@@ -2116,6 +2116,12 @@ namespace
                 if( !consume_tt(lex) )
                     return false;
             }
+            // A `$body:block` fragment written back as the body, then matched by `$item:item` (ring 0.17.14
+            // prefixed.rs `prefixed_export!` -> `prefixed_item! { export_name $name { .. fn $name(..) $body } }`)
+            else if( lex.next() == TOK_INTERPOLATED_BLOCK )
+            {
+                lex.consume();
+            }
             else
             {
                 return false;
diff --git a/src/main.cpp b/src/main.cpp
index 37d162d3..95794817 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -801,7 +801,10 @@ int main(int argc, char *argv[])
             case ::AST::Crate::Type::RustLib:
             case ::AST::Crate::Type::RustDylib:
             case ::AST::Crate::Type::CDylib:
-                return Trans_Enumerate_Public(*hir_crate);
+                // `#[no_mangle]`/`#[export_name]` functions are exported symbols for rustc whatever the crate type:
+                // an rlib's object must define them (a consumer only sees the prototype), e.g. for C code linked into
+                // the final binary - ring 0.17.14 `bn_mul_mont` (prefixed_export!, called by ring's own C, tombi 1.8.4)
+                return Trans_Enumerate_Public(*hir_crate, /*link_named_roots=*/true);
             case ::AST::Crate::Type::StaticLib:
                 // Public items, plus `#[no_mangle]`/`#[export_name]` functions: the archive is consumed by C code
                 return Trans_Enumerate_Public(*hir_crate, /*link_named_roots=*/true);
