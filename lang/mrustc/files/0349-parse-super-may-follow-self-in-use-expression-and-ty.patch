From b07a5b736b13163dd18a30dc9220270e8859d069 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 23:33:55 +0000
Subject: [PATCH] parse: `super` may follow `self` in use, expression and type
 paths

safe-transmute 0.11.3 src/full.rs:14 (repgrep 0.17.1): `use self::super::trivial::{TriviallyTransmutable, ..};` =
"BUG: ASSERT FAIL: src/parse/root.cpp:1683: path.nodes().size() > 0: super in empty path". The reference lets `super`
follow `self` (`self::super::x` is `super::x`). Parse_Use_Inner knew `super` only after a `super` (count up) or
a name (pop it), so a `self`-class path with no names hit the assertion; Parse_Path rejected the token after `self::`
outright ("Unexpected token TOK_RWORD_SUPER, expected TOK_IDENT": `self::super::f()`, `-> self::super::S`).

Parse_Use_Inner: a `self` path without names becomes `super` with count 1 (further `super`s count up as before).
Parse_Path: after `self::`, a `super` continues as the `super` case.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/parse/paths.cpp b/src/parse/paths.cpp
index 9af6380e..321cf6f9 100644
--- a/src/parse/paths.cpp
+++ b/src/parse/paths.cpp
@@ -40,9 +40,15 @@ AST::Path Parse_Path(TokenStream& lex, eParsePathGenericMode generic_mode)
             return AST::Path(rcstring_self);
         }
         GET_CHECK_TOK(tok, lex, TOK_DOUBLE_COLON);
+        // `super` may follow `self` (`self::super::f()`, `-> self::super::S`): the same path as without the `self`
+        if( LOOK_AHEAD(lex) == TOK_RWORD_SUPER ) {
+            GET_TOK(tok, lex);
+            goto super_path;
+        }
         return AST::Path::new_self(Parse_PathNodes(lex, generic_mode));
 
     case TOK_RWORD_SUPER: {
+    super_path:
         GET_CHECK_TOK(tok, lex, TOK_DOUBLE_COLON);
         unsigned int count = 1;
         while( LOOK_AHEAD(lex) == TOK_RWORD_SUPER ) {
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index d31ed967..1d48e077 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1679,6 +1679,11 @@ void Parse_Use_Inner(TokenStream& lex, ::std::vector<AST::UseItem::Ent>& entries
                 p->nodes.pop_back();
             }
         }
+        else if( path.m_class.is_Self() && path.nodes().empty() ) {
+            // `super` may follow `self`: `use self::super::trivial::{..}` (safe-transmute 0.11.3 full.rs:14) is
+            // `use super::trivial::{..}`
+            path = AST::Path::new_super(1, {});
+        }
         else {
             ASSERT_BUG(lex.point_span(), path.nodes().size() > 0, "super in empty path");
             path.nodes().pop_back();
