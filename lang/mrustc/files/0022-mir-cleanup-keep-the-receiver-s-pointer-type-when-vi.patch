From 3897daf8623d70fa2148c4f18e327b3673ef9792 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 2 Oct 2026 01:52:36 +0000
Subject: [PATCH] mir/cleanup: keep the receiver's pointer type when
 virtualizing through smart pointers

MIR_Cleanup_Virtualize rebuilds a `Foo<()>` receiver from a `Foo<dyn Trait>`
(Box/Rc/Arc/Pin/...) by recursing through the CoerceUnsized field. At the
innermost pointer it emitted the DstPtr into a `*const ()` temporary, which
is only right when the pointer's pointee is exactly `Self` (Box<Self>).
`Arc<Self>` holds `NonNull<ArcInner<Self>>`, so the rebuilt struct got
a `*const ()` assigned to a `*const ArcInner<()>` field. GCC 14+ rejects that
as -Wincompatible-pointer-types (older GCC only warns).

Use the receiver's own `()`-substituted pointer type for the temporary.

Hit by signal-hook 0.3.4 (dijo): `Arc<dyn AddSignal>` calling
`fn add_signal(self: Arc<Self>, ...)`.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/mir/cleanup.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/mir/cleanup.cpp b/src/mir/cleanup.cpp
index 81be0fc8..6e585463 100644
--- a/src/mir/cleanup.cpp
+++ b/src/mir/cleanup.cpp
@@ -634,8 +634,10 @@ namespace {
             else if( ty.data().is_Borrow() || ty.data().is_Pointer() )
             {
                 out_inner_ptr = lv.clone();
+                // Use the receiver's own (`()`-substituted) pointer type, not `*const ()` - the pointee may wrap
+                // `Self` (e.g. `Arc<Self>` holds `*const ArcInner<Self>`), and the enclosing struct expects that type.
                 return mutator.in_temporary(
-                    ::HIR::TypeRef::new_pointer(::HIR::BorrowType::Shared, ::HIR::TypeRef::new_unit()),
+                    mv$(ty),
                     ::MIR::RValue::make_DstPtr({ mv$(lv) })
                     );
             }
