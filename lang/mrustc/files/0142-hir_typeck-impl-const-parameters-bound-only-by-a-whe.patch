From 126b37b8b39201620ed3d0e391f60911456905d6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 23:35:07 +0000
Subject: [PATCH 142/143] hir_typeck: impl const parameters bound only by
 a where-clause associated type get their value

`impl<C, T, const N: usize> Blend for C where C: ArrayCast<Array = [T; N]>`
(palette 0.7.7): neither the impl type nor the trait fixes `N`, so it got
a placeholder, the bound check resolved the placeholder to the array length,
and then only the types and lifetimes were copied back into the impl params.
`N` stayed `Infer`, and monomorphising the method's MIR constant `N` aborted:
`clone_constant - Monomorphise MIR generic constant N/*I:0*/ = Infer`.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_typeck/static.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index 09d1182c..29369eec 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -1493,6 +1493,18 @@ bool StaticTraitResolve::find_impl__check_crate_raw(
         }
         //ASSERT_BUG(sp, impl_params.m_types[i] != HIR::TypeRef(), "Impl type parameter #" << i << " wasn't set (or even a placeholder)");
     }
+    // Value parameters bound only through the bounds (`impl<C, T, const N: usize> Tr for C where C: Arr<Array = [T; N]>`)
+    // were left `Infer` here, so the method's MIR constant `N` had no value when monomorphised (palette 0.7.7 `Blend`).
+    for(size_t i = 0; i < impl_params.m_values.size(); i ++)
+    {
+        if( !params_set.m_values[i] )
+        {
+            if( !placeholders_set.m_values[i] ) {
+                //BUG(sp, "Placeholder values shouldn't leak :( - " << placeholders.m_values[i]);
+            }
+            impl_params.m_values[i] = std::move(placeholders.m_values[i]);
+        }
+    }
     for(size_t i = 0; i < impl_params.m_lifetimes.size(); i ++)
     {
         if( !params_set.m_lifetimes[i] )
