From e2c3e8eb8f3b42dffc2076f0297c3cae3ae32fc2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 8 Oct 2026 19:20:29 +0000
Subject: [PATCH 146/146] hir_typeck: an impl const parameter nothing bound
 stays `Infer`, not a raw placeholder

0142 copied every impl value placeholder back into the impl params after the
bound checks, so that `N` in `impl<C, T, const N: usize> Blend for C where
C: ArrayCast<Array = [T; N]>` (palette 0.7.7) gets the array length a bound
resolved it to. It also copied placeholders that nothing bound: `impl<const N:
usize> Swizzle<N> for Splat`, found for `Splat: Swizzle<_>` while the trait
argument is still an inference variable (core_simd vector.rs:170,
`Splat::swizzle::<T, 1>(Simd::<T, 1>::from([value]))` in `Simd::splat`).
The method's return type `Simd<T, N>` then carried the placeholder into
`Context::equate_types` and libcore 1.90 failed to build:

  expr_cs.cpp:2033: !type_contains_impl_placeholder(ri): Type contained an impl
  placeholder parameter - core_simd::vector::Simd<T/*M:0*/,{Generic(impl_?_0x1a72d490/*P:0*/)},>

Copy a value placeholder back only when a bound resolved it; an unbound one is
left `Infer` as before 0142.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_typeck/static.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index 29369eec..a582f525 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -1495,13 +1495,13 @@ bool StaticTraitResolve::find_impl__check_crate_raw(
     }
     // Value parameters bound only through the bounds (`impl<C, T, const N: usize> Tr for C where C: Arr<Array = [T; N]>`)
     // were left `Infer` here, so the method's MIR constant `N` had no value when monomorphised (palette 0.7.7 `Blend`).
+    // Only a placeholder that a bound did resolve is copied back: one nothing bound (`impl<const N: usize> Swizzle<N>
+    // for Splat` found for `Splat: Swizzle<_>`, core_simd `Splat::swizzle::<T, 1>(..)`) stays `Infer` as before, since
+    // a raw value placeholder in the impl params reaches `Context::equate_types` and trips its impl-placeholder assertion.
     for(size_t i = 0; i < impl_params.m_values.size(); i ++)
     {
-        if( !params_set.m_values[i] )
+        if( !params_set.m_values[i] && placeholders_set.m_values[i] )
         {
-            if( !placeholders_set.m_values[i] ) {
-                //BUG(sp, "Placeholder values shouldn't leak :( - " << placeholders.m_values[i]);
-            }
             impl_params.m_values[i] = std::move(placeholders.m_values[i]);
         }
     }
