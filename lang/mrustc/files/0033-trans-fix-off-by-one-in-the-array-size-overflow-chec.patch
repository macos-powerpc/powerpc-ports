From fd73f20deec57e69e03b8d85867bbd4d09350672 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 00:16:45 +0000
Subject: [PATCH 33/36] trans: fix off-by-one in the array-size overflow check

`out_size * N` overflows `size_t` iff `out_size > SIZE_MAX / N`; the check
used `<=`, which also rejects the exact-fit case. That only bites when
mrustc is itself a 32-bit binary: hex 0.4.3 implements `FromHex` for
`[u8; 2147483648]` on 32-bit targets, and there `SIZE_MAX / 2^31 == 1 ==
sizeof(u8)`, so the ppc-hosted compiler died with "Integer overflow
calculating array size" although 2^31 bytes fits a 32-bit `size_t`.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/trans/target.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/trans/target.cpp b/src/trans/target.cpp
index 5069ce03..18b55374 100644
--- a/src/trans/target.cpp
+++ b/src/trans/target.cpp
@@ -889,7 +889,10 @@ bool Target_GetSizeAndAlignOf(const Span& sp, const StaticTraitResolve& resolve,
         }
         else
         {
-            if( SIZE_MAX / te.size.as_Known() <= out_size )
+            // Overflows iff `out_size * N > SIZE_MAX`, i.e. iff `out_size > SIZE_MAX / N` - strictly greater.
+            // `<=` rejected `[u8; 2147483648]` (hex 0.4.3's `FromHex` impls) when mrustc itself is a 32-bit
+            // binary: there `SIZE_MAX / 2^31 == 1 == sizeof(u8)` even though 2^31 bytes fits a 32-bit size_t.
+            if( SIZE_MAX / te.size.as_Known() < out_size )
                 BUG(sp, "Integer overflow calculating array size");
             out_size *= te.size.as_Known();
         }
