From 8b36796c99557e8a2e053218fa33dfc87747a0d5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 18:01:11 +0000
Subject: [PATCH 67/68] resolve: a module in scope doesn't shadow a primitive
 type of the same name

A module lives in the type namespace, but it isn't a type: rustc
resolves a single-segment type path to the primitive type when the
name in scope is a module. mrustc's `lookup_in_mod` returned whatever
the module's type table held, so a glob-imported module named like
a primitive was bound as the type. std_prelude 0.2.12 re-exports
`pub use std::str;` (and `u8`, `u16`, ..), so in path_abs 0.5.1 every
`&str` after `use std_prelude::*;` became the module `alloc::str`:

    BUG: src/hir_conv/lifetime_elision.cpp:451: Unexpected module: ::"alloc-0_0_0"::str

Skip module bindings in type and pattern-type lookups, so the search
falls through to the primitive types (and to the usual "couldn't find
type name" error otherwise). The hygiene mod-path lookup that binds
extern items gets the same rule. Namespace lookups still find modules,
so `str::from_utf8(..)` and `u8::MAX` keep working.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/resolve/absolute.cpp | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/src/resolve/absolute.cpp b/src/resolve/absolute.cpp
index 5e6bf15f..7df46bf2 100644
--- a/src/resolve/absolute.cpp
+++ b/src/resolve/absolute.cpp
@@ -411,9 +411,16 @@ namespace
                 {
                     auto v = mod.m_type_items.find(name);
                     if( v != mod.m_type_items.end() ) {
-                        DEBUG("- " << mod.path() << " TY: Type " << v->second.path);
-                        path = ::AST::Path( v->second.path );
-                        return true;
+                        // A module shares the type namespace but isn't a type: as in rustc, it doesn't shadow a primitive
+                        // type of the same name (`use std::str;` via `std_prelude::*` then `&str` - path_abs 0.5.1)
+                        if( v->second.path.m_bindings.type.binding.is_Module() ) {
+                            DEBUG("- " << mod.path() << " TY: Module " << v->second.path << " (not a type, ignored)");
+                        }
+                        else {
+                            DEBUG("- " << mod.path() << " TY: Type " << v->second.path);
+                            path = ::AST::Path( v->second.path );
+                            return true;
+                        }
                     }
                 }
                 // HACK: For `Enum::Var { .. }` patterns matching value variants
@@ -566,7 +573,10 @@ namespace
                             default:
                                 TODO(sp, "Bind type/mod '" << name << "' for module path " << mp << " : " << item->tag_str());
                             TU_ARMA(Module, e) {
-                                bindings.type.set( item_path, AST::PathBinding_Type::make_Module({nullptr, { &crate, &e }}) );
+                                // Only a path prefix can name a module (see `lookup_in_mod`)
+                                if( mode == LookupMode::Namespace ) {
+                                    bindings.type.set( item_path, AST::PathBinding_Type::make_Module({nullptr, { &crate, &e }}) );
+                                }
                                 }
                             TU_ARMA(Trait, e) {
                                 bindings.type.set( item_path, AST::PathBinding_Type::make_Trait({nullptr}) );
