From 3b8ba6d0eb5af63d731ad260ddbeb40a3e4e838f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 16:47:52 +0000
Subject: [PATCH] codegen_c: a trait object tail of a user-aligned type is not
 capped at 4 on Darwin ppc32

Found by reading the backend, no crate reported it. On
powerpc-apple-darwin a struct that ends in a trait object
(`W<dyn Tr> { a: u8, t: dyn Tr }`, `ArcInner<dyn Tr>`) places the tail
with the alignment from the vtable, passed through
`mrustc_dyn_field_align`, the run-time form of GCC's
ADJUST_FIELD_ALIGN: 4 for anything above 4 except 16.

GCC does not apply that macro to user-aligned types, and on this
target no natural alignment is above 16 (AltiVec vectors), so every
larger value is a `repr(align(N))` type that the C struct of the sized
value places at N. Through the trait object it was placed at 4:

    W<dyn Tr> over #[repr(align(32))] struct Al32 { v: u32 }
    tail offset 4 (want 32), size_of_val 36 (want 64),
    align_of_val 4 (want 32), `get` read the wrong memory

A real case would be an `Arc<dyn Trait>` over a type that holds
crossbeam's `CachePadded` (align 64 on 32-bit powerpc).

The helper now caps only 8. A `repr(align(8))` type is still taken for
a natural 8 (`u64`, `f64`): the vtable holds one alignment, telling the
two apart needs the field alignment in the vtable header.

Assisted-by: Claude Fable 5.2
---

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 6205d84e..e4472950 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -558,8 +558,9 @@ namespace {
                 ;
             if( Target_IsDarwinPPC32() )
             {
-                // Placement of a field of alignment `a` (GCC's ADJUST_FIELD_ALIGN), for trait object tails
-                m_of << "static inline size_t mrustc_dyn_field_align(size_t a) { return a > 4 && a != 16 ? 4 : a; }\n";
+                // Placement of a field of alignment `a` (GCC's ADJUST_FIELD_ALIGN), for trait object tails: a natural 8
+                // is capped at 4. Above 16 only user-aligned types exist, which GCC exempts from the cap.
+                m_of << "static inline size_t mrustc_dyn_field_align(size_t a) { return a == 8 ? 4 : a; }\n";
             }
             switch(m_compiler)
             {
diff --git a/src/version.cpp b/src/version.cpp
index c82fd032..0d8736f6 100644
--- a/src/version.cpp
+++ b/src/version.cpp
@@ -13,7 +13,7 @@
 #define VERSION_PATCH   0
 
 // Number of the last patch in this fork's series: every fix commit bumps it
-#define VERSION_SERIES  466
+#define VERSION_SERIES  467
 // rlibs written by an older series are refused (0 = accept all)
 #define VERSION_SERIES_FLOOR    0
 
