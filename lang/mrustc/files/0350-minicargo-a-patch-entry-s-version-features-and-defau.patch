From 00b5c18f0656e4d8d0b5ef91c8ab8756d1c06823 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 23:48:46 +0000
Subject: [PATCH] minicargo: a `[patch]` entry's `version`, `features` and
 `default-features` keys are accepted

gurk-rs 0.10.2 (gurk) Cargo.toml:
    [patch.crates-io]
    libsqlite3-sys = { version = "0.36.0", git = "https://github.com/boxdot/rusqlite", rev = 'a2f39..' }
= "TODO: Handle workspace patch dependency frag 'version'" (the workspace loader; the package loader says "Support
non-path repository patches" for the same key). Both loaders knew only `path` and the git keys. `version` is what
the replacement must be, which cargo checked against the checkout the vendor directory holds; `features` and
`default-features` take no effect in a patch (cargo warns). All three are noted and otherwise ignored.

Assisted-By: Claude Fable 5.1
---

diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index 1d1a5039..e0182168 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -24,6 +24,11 @@ namespace {
         return key == "git" || key == "branch" || key == "tag" || key == "rev";
     }
 }
+/// Keys of a `[patch]` entry that pick or decorate the replacement without locating it
+static bool is_patch_only_key(const ::std::string& key)
+{
+    return key == "version" || key == "features" || key == "default-features";
+}
 
 // TODO: Extract this from the target at runtime (by invoking the compiler on the passed target)
 #ifdef _WIN32
@@ -171,6 +176,13 @@ WorkspaceManifest WorkspaceManifest::load_from_toml(const ::helpers::path& works
                 // `[patch.crates-io] x = { git = ".." }`: the checkout is in the vendor directory, found by name
                 DEBUG("Patch " << package_name << ": " << key_val.path[3] << " = " << key_val.value << " (resolved from the vendor directory)");
             }
+            else if( is_patch_only_key(key_val.path[3]) )
+            {
+                // `version` = what the replacement must be (gurk-rs 0.10.2 `libsqlite3-sys = { version = "0.36.0", git =
+                // "..", rev = ".." }`): cargo checked it against the checkout the vendor directory holds. `features` and
+                // `default-features` take no effect in a patch (cargo warns).
+                DEBUG("Patch " << package_name << ": " << key_val.path[3] << " = " << key_val.value << " (not used)");
+            }
             else
             {
                 TODO("Handle workspace patch dependency frag '" << key_val.path[3] << "'");
@@ -886,6 +898,10 @@ void PackageManifest::fill_from_kv(ErrorHandler& eh, const WorkspaceManifest* wm
                     // `[patch.crates-io] x = { git = ".." }`: the checkout is in the vendor directory, found by name
                     DEBUG("Patch " << package_name << ": " << key_val.path[3] << " = " << key_val.value << " (resolved from the vendor directory)");
                 }
+                else if( key_val.path.size() == 4 && is_patch_only_key(key_val.path[3]) ) {
+                    // `version` (checked by cargo against the checkout), `features`/`default-features` (no effect in a patch)
+                    DEBUG("Patch " << package_name << ": " << key_val.path[3] << " = " << key_val.value << " (not used)");
+                }
                 else {
                     eh.todo("Support non-path repository patches");
                 }
