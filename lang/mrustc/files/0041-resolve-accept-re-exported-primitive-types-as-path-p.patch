From 7a9eda0b10d081f04c55b0be0315440f396abf33 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 04:34:39 +0000
Subject: [PATCH] resolve: accept re-exported primitive types as path prefixes

libyaml-rs 0.3.0 has `mod libc { pub use core::primitive::{i32 as
c_int, ...}; }` and then uses `libc::c_int::MAX`. Absolute path binding
had no case for a primitive type in the middle of a path and failed with
"Encountered non-namespace item 'c_int' (::"#builtins"::i32) in path
crate::libc::c_int::MAX".

Turn the rest of the path into a UFCS path on the primitive (`<i32>::MAX`),
as is already done for structs, enums, unions and type aliases. Do the
same when walking another crate's modules reaches an import of a builtin
type (e.g. `core::primitive::u32::MAX`), which previously tripped an
assertion on the rewritten `#builtins` path.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/resolve/absolute.cpp | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/resolve/absolute.cpp b/src/resolve/absolute.cpp
index afc9950d..f52bf4cc 100644
--- a/src/resolve/absolute.cpp
+++ b/src/resolve/absolute.cpp
@@ -1270,6 +1270,20 @@ namespace {
             TU_MATCH_HDRA( (it->second->ent), {)
             TU_ARMA(Import, e) {
                 DEBUG("`" << n.name() << "`: Import " << e.path);
+                if( e.path.crate_name() == CRATE_BUILTINS ) {
+                    // A re-exported primitive used as a path prefix (e.g. `core::primitive::u32::MAX`): `<u32>::MAX`
+                    ASSERT_BUG(sp, e.path.components().size() == 1, "Unexpected builtin path " << e.path);
+                    auto ct = coretype_fromstring(e.path.components()[0].c_str());
+                    ASSERT_BUG(sp, ct != CORETYPE_INVAL, "Unknown builtin type " << e.path);
+                    if( ! n.args().is_empty() ) {
+                        ERROR(sp, E0000, "Type parameters were not expected here");
+                    }
+                    auto new_path = ::AST::Path::new_ufcs_ty( ::TypeRef(sp, ct) );
+                    for(unsigned int j = i + 1; j < path_abs.nodes.size(); j ++)
+                        new_path.nodes().push_back( mv$(path_abs.nodes[j]) );
+                    path = mv$(new_path);
+                    return Resolve_Absolute_Path_BindUFCS(context, sp, mode,  path);
+                }
                 // - Update path then restart
                 auto newpath = AST::Path(e.path.crate_name(), {});
                 for(const auto& n : e.path.components())
@@ -1735,6 +1749,17 @@ void Resolve_Absolute_Path_BindAbsolute(Context& context, const Span& sp, Contex
                 path = split_replace_into_ufcs_path(sp, mv$(path), i,  name_ref.path);
                 return Resolve_Absolute_Path_BindUFCS(context, sp, mode,  path);
                 }
+            TU_ARMA(Primitive, e) {
+                // A re-exported primitive (e.g. `pub use core::primitive::i32 as c_int;`) used as a path prefix: `c_int::MAX` is `<i32>::MAX`
+                if( ! n.args().is_empty() ) {
+                    ERROR(sp, E0000, "Type parameters were not expected here");
+                }
+                auto new_path = ::AST::Path::new_ufcs_ty( ::TypeRef(sp, e) );
+                for( unsigned int j = i+1; j < path_abs.nodes.size(); j ++ )
+                    new_path.nodes().push_back( mv$(path_abs.nodes[j]) );
+                path = mv$(new_path);
+                return Resolve_Absolute_Path_BindUFCS(context, sp, mode,  path);
+                }
             TU_ARMA(Module, e) {
                 if( name_ref.is_import ) {
                     auto newpath = name_ref.path;
