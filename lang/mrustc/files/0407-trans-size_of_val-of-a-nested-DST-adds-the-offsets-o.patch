-                            align_needed = true;
-                            m_of << "ALIGN_TO(";
+                else {
+                    // The unsized tail can sit several structs deep (servo_arc's `ArcInner<HeaderSlice<H, [T]>>`): collect
+                    // the offset of the last field and the alignment of every wrapper, outermost first.
+                    struct Level { size_t ofs; size_t align; };
+                    ::std::vector<Level>    levels;
+                    for(::HIR::TypeRef cur = ty.clone(); cur.data().is_Path(); )
+                    {
+                        const auto* repr = Target_GetTypeRepr(sp, m_resolve, cur);
+                        MIR_ASSERT(mir_res, repr, "Can't get repr of " << cur);
+                        levels.push_back(Level { repr->fields.back().offset, repr->align });
+                        cur = repr->fields.back().ty.clone();
+                    }
+                    // slice metadata (`[T]` and `str`)
+                    if( inner_ty.data().is_Slice() || inner_ty == ::HIR::CoreType::Str ) {
+                        size_t item_size = 0;
+                        size_t item_align = 0;
+                        if(const auto* te = inner_ty.data().opt_Slice() ) {
+                            MIR_ASSERT(mir_res, Target_GetSizeAndAlignOf(sp, m_resolve, te->inner, item_size, item_align), "Can't get size of " << te->inner);
+                        }
+                        else {
+                            assert(inner_ty == ::HIR::CoreType::Str);
+                            item_size = 1;
+                            item_align = 1;
+                        }
+                        // Each level is `offset + size of the inner level`, rounded up to the level's alignment (= size_of of
+                        // the type with a `[T; N]` tail). `known` tracks the alignment the expression already has, so the
+                        // rounding is only emitted where it can change the value.
+                        auto lowbit = [](size_t v) { return v & (~v + 1); };
+                        size_t known = item_size == 0 ? SIZE_MAX : lowbit(item_size);
+                        ::std::vector<bool> round_up(levels.size());
+                        for(size_t i = levels.size(); i --; )
+                        {
+                            if( levels[i].ofs != 0 )
+                                known = ::std::min(known, lowbit(levels[i].ofs));
+                            if( levels[i].align > 1 && known < levels[i].align ) {
+                                round_up[i] = true;
+                                known = levels[i].align;
+                            }
+                        }
+                        for(size_t i = 0; i < levels.size(); i ++)
+                        {
+                            if( round_up[i] )
+                                m_of << "ALIGN_TO(";
+                            if( levels[i].ofs != 0 )
+                                m_of << levels[i].ofs << " + ";
+                        }
+                        emit_param(e.args.at(0)); m_of << ".META * " << item_size;
+                        for(size_t i = levels.size(); i --; )
+                        {
+                            if( round_up[i] )
+                                m_of << ", " << levels[i].align << ")";
                         }
-                        const auto* repr = Target_GetTypeRepr(sp, m_resolve, ty);
-                        m_of << repr->fields.back().offset << " + ";
                     }
-                    emit_param(e.args.at(0)); m_of << ".META * " << item_size;
-                    if(align_needed) {
-                        m_of << ", " << item_align << ")";
+                    // Trait object metadata.
+                    else if( inner_ty.data().is_TraitObject() ) {
+                        // TODO: Handle aligning the size if the wrapper's alignment is greater than the object
+                        // - Also, how is the final field aligned?
+                        size_t ofs = 0;
+                        for(const auto& l : levels)
+                            ofs += l.ofs;
+                        if( ofs != 0 ) {
+                            m_of << ofs << " + ";
+                        }
+                        //auto vtable_path = inner_ty.data().as_TraitObject().m_trait.m_path.clone();
+                        //vtable_path.m_path.m_components.back() += "#vtable";
+                        //auto vtable_ty = ::HIR::TypeRef
+                        m_of << "((VTABLE_HDR*)"; emit_param(e.args.at(0)); m_of << ".META)->size";
                     }
-                }
-                // Trait object metadata.
-                else if( inner_ty.data().is_TraitObject() ) {
-                    // TODO: Handle aligning the size if the wrapper's alignment is greater than the object
-                    // - Also, how is the final field aligned?
-                    if( ! ty.data().is_TraitObject() ) {
-                        const auto* repr = Target_GetTypeRepr(sp, m_resolve, ty);
-                        m_of << repr->fields.back().offset << " + ";
+                    else {
+                        MIR_BUG(mir_res, "Unknown inner unsized type " << inner_ty << " for " << ty);
                     }
-                    //auto vtable_path = inner_ty.data().as_TraitObject().m_trait.m_path.clone();
-                    //vtable_path.m_path.m_components.back() += "#vtable";
-                    //auto vtable_ty = ::HIR::TypeRef
-                    m_of << "((VTABLE_HDR*)"; emit_param(e.args.at(0)); m_of << ".META)->size";
-                }
-                else {
-                    MIR_BUG(mir_res, "Unknown inner unsized type " << inner_ty << " for " << ty);
                 }
-                // TODO: Align up
             }
             else if( name == "min_align_of_val" || name == "align_of_val" ) {
                 emit_lvalue(e.ret_val); m_of << " = ";
