From 80a02656f0de94bbf03457401882bb9d68530378 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 02:43:03 +0000
Subject: [PATCH 217/217] parse: `self`, `super` and private visibility name
 the enclosing module, not a block

mrustc parses a block's items into an anonymous module, and `Parse_Publicity`
took `pub(self)`, `pub(super)`, `pub(in self/super::..)` and private
visibility relative to it. For visibility blocks aren't modules (rustc), so in
num-bigint 0.4.8 (jaq 3.1.1) biguint/iter.rs

    const _: () = { impl<'a> U32Digits<'a> { pub(super) fn new(..) } };

`new` was visible in `biguint::iter` instead of `biguint`, and
`U32Digits::new(&self.data)` in `impl BigUint` failed in Resolve UFCS with
"Failed to find impl with 'new' for
::"num_bigint-0_4_8"::biguint::iter::U32Digits<'#omitted,>". Likewise
a private method in an `impl` inside a fn body was only visible inside that body.

The visibility path now drops trailing anonymous (`#N`) modules first.

(A free fn in `biguint` making the same call passed only because Resolve UFCS
doesn't restore its current module after visiting a submodule, so the fn was
checked from the last submodule visited.)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/parse/root.cpp | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index ed353089..689ca4f9 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -50,6 +50,18 @@ AST::Attribute  Parse_MetaItem(TokenStream& lex);
 void Parse_ModRoot(TokenStream& lex, AST::Module& mod, AST::AttributeList& mod_attrs);
 bool Parse_MacroInvocation_Opt(TokenStream& lex,  AST::MacroInvocation& out_inv);
 
+namespace {
+    /// The module that `self`, `super` and private visibility name: a block's items are in an anonymous module, but
+    /// for visibility blocks aren't modules (rustc). `pub(super) fn new` in `const _: () = { impl S { .. } };` in
+    /// `a::b` is visible in `a`, not just in `a::b` (num-bigint 0.4.8 `U32Digits::new`).
+    AST::AbsolutePath vis_mod_path(TokenStream& lex)
+    {
+        auto path = lex.parse_state().get_current_mod().path();
+        while( !path.nodes.empty() && path.nodes.back().c_str()[0] == '#' )
+            path.nodes.pop_back();
+        return path;
+    }
+}
 ::AST::Visibility Parse_Publicity(TokenStream& lex, bool allow_restricted/*=true*/)
 {
     Token   tok;
@@ -92,11 +104,11 @@ bool Parse_MacroInvocation_Opt(TokenStream& lex,  AST::MacroInvocation& out_inv)
                 return AST::Visibility::make_restricted(AST::Visibility::Ty::PubCrate, std::move(path));
             case TOK_RWORD_SELF:
                 // Private!
-                path = lex.parse_state().get_current_mod().path();
+                path = vis_mod_path(lex);
                 GET_CHECK_TOK(tok, lex, TOK_PAREN_CLOSE);
                 return AST::Visibility::make_restricted(AST::Visibility::Ty::PubSelf, std::move(path));
             case TOK_RWORD_SUPER:
-                path = lex.parse_state().get_current_mod().path();
+                path = vis_mod_path(lex);
                 path.nodes.pop_back();
                 GET_CHECK_TOK(tok, lex, TOK_PAREN_CLOSE);
                 return AST::Visibility::make_restricted(AST::Visibility::Ty::PubSuper, std::move(path));
@@ -132,11 +144,11 @@ bool Parse_MacroInvocation_Opt(TokenStream& lex,  AST::MacroInvocation& out_inv)
                     break;
                 case TOK_RWORD_SELF:
                     ast_path = AST::Path::new_self({});
-                    path = lex.parse_state().get_current_mod().path();
+                    path = vis_mod_path(lex);
                     break;
                 case TOK_RWORD_SUPER:
                     ast_path = AST::Path::new_super(1, {});
-                    path = lex.parse_state().get_current_mod().path();
+                    path = vis_mod_path(lex);
                     path.nodes.pop_back();
                     while( lex.lookahead(0) == TOK_DOUBLE_COLON && lex.lookahead(1) == TOK_RWORD_SUPER )
                     {
@@ -166,7 +178,7 @@ bool Parse_MacroInvocation_Opt(TokenStream& lex,  AST::MacroInvocation& out_inv)
     }
     else
     {
-        return AST::Visibility::make_restricted(AST::Visibility::Ty::Private, lex.parse_state().get_current_mod().path());
+        return AST::Visibility::make_restricted(AST::Visibility::Ty::Private, vis_mod_path(lex));
     }
 }
 
