diff --git a/dyn-metadata-makedst-test/dynmeta.rs b/dyn-metadata-makedst-test/dynmeta.rs
new file mode 100644
index 00000000..7291900d
--- /dev/null
+++ b/dyn-metadata-makedst-test/dynmeta.rs
@@ -0,0 +1,39 @@
+pub trait Shape { fn area(&self) -> u32; fn tag(&self) -> u32; }
+pub struct Sq { side: u32 }
+impl Shape for Sq { fn area(&self) -> u32 { self.side } fn tag(&self) -> u32 { 7 } }
+pub struct Tri { base: u32 }
+impl Shape for Tri { fn area(&self) -> u32 { self.base } fn tag(&self) -> u32 { 3 } }
+
+// libstd's shape: generic `with_metadata_of`, the metadata type is `<U as Pointee>::Metadata` until monomorphisation
+#[no_mangle] pub extern "C" fn dyn_roundtrip(side: u32) -> u32 {
+    let s = Sq { side };
+    let p: *const dyn Shape = &s as *const Sq;
+    let q = with_metadata_of(&s as *const Sq, p);
+    unsafe { (*q).area() }
+}
+// user-code shape: a `DynMetadata<dyn Shape>` local fed to `from_raw_parts`
+#[no_mangle] pub extern "C" fn dyn_explicit(base: u32) -> u32 {
+    let t = Tri { base };
+    let p: *const dyn Shape = &t as *const Tri;
+    let m: DynMetadata<dyn Shape> = metadata(p);
+    let q: *const dyn Shape = from_raw_parts(&t as *const Tri as *const (), m);
+    unsafe { (*q).tag() }
+}
+// `*mut` output, data pointer from another object of the same type: the vtable travels, the data does not
+#[no_mangle] pub extern "C" fn dyn_mut_swap() -> u32 {
+    let mut a = Sq { side: 1 };
+    let mut b = Sq { side: 5 };
+    let pa: *mut dyn Shape = &mut a as *mut Sq;
+    let q: *mut dyn Shape = from_raw_parts_mut(&mut b as *mut Sq as *mut (), metadata(pa));
+    unsafe { (*q).area() }
+}
+// the other metadata kinds must keep working: slice length and thin pointers
+#[no_mangle] pub extern "C" fn slice_roundtrip(n: usize) -> usize {
+    let arr = [1u8, 2, 3, 4];
+    let p: *const [u8] = from_raw_parts(&arr as *const [u8; 4] as *const (), n);
+    metadata(p)
+}
+#[no_mangle] pub extern "C" fn thin_roundtrip(v: u32) -> u32 {
+    let p: *const u32 = from_raw_parts(&v as *const u32 as *const (), ());
+    unsafe { *p }
+}
diff --git a/dyn-metadata-makedst-test/hdr.rs b/dyn-metadata-makedst-test/hdr.rs
new file mode 100644
index 00000000..0483a440
--- /dev/null
+++ b/dyn-metadata-makedst-test/hdr.rs
@@ -0,0 +1,39 @@
+#![feature(no_core, lang_items, intrinsics, rustc_attrs, extern_types)]
+#![no_core]
+#![crate_type = "lib"]
+#[lang = "sized"] pub trait Sized {}
+#[lang = "copy"] pub trait Copy {}
+pub mod marker { pub use super::{Copy, PhantomData}; }
+#[lang = "unsize"] pub trait Unsize<T: ?Sized> {}
+#[lang = "coerce_unsized"] pub trait CoerceUnsized<T: ?Sized> {}
+impl<T: ?Sized + Unsize<U>, U: ?Sized> CoerceUnsized<*const U> for *const T {}
+impl<T: ?Sized + Unsize<U>, U: ?Sized> CoerceUnsized<*mut U> for *mut T {}
+impl<T: ?Sized + Unsize<U>, U: ?Sized> CoerceUnsized<*const U> for *mut T {}
+#[lang = "deref"] pub trait Deref { #[lang = "deref_target"] type Target: ?Sized; fn deref(&self) -> &Self::Target; }
+#[lang = "receiver"] pub trait Receiver {}
+#[lang = "fn_ptr_trait"] pub trait FnPtr {}
+#[lang = "tuple_trait"] pub trait Tuple {}
+#[lang = "discriminant_kind"] pub trait DiscriminantKind { #[lang = "discriminant_type"] type Discriminant; }
+#[lang = "pointee_trait"] pub trait Pointee { #[lang = "metadata_type"] type Metadata; }
+#[lang = "phantom_data"] pub struct PhantomData<T: ?Sized>;
+#[lang = "drop"] pub trait Drop { fn drop(&mut self); }
+pub mod ops { pub struct RangeFull; }
+impl Copy for u8 {}
+impl Copy for u32 {}
+impl Copy for usize {}
+impl<T: ?Sized> Copy for *const T {}
+impl<T: ?Sized> Copy for *mut T {}
+// core::ptr::metadata (1.90): `DynMetadata` wraps a `NonNull` to the opaque vtable type
+pub struct NonNull<T: ?Sized> { pointer: *const T }
+extern "C" { pub type VTable; }
+#[lang = "dyn_metadata"]
+pub struct DynMetadata<Dyn: ?Sized> { _vtable_ptr: NonNull<VTable>, _phantom: PhantomData<Dyn> }
+#[rustc_intrinsic] pub const fn aggregate_raw_ptr<P, D, M>(data: D, meta: M) -> P;
+#[rustc_intrinsic] pub const fn ptr_metadata<P: ?Sized, M>(ptr: *const P) -> M;
+pub const fn metadata<T: ?Sized>(ptr: *const T) -> <T as Pointee>::Metadata { ptr_metadata(ptr) }
+pub const fn from_raw_parts<T: ?Sized>(data: *const (), meta: <T as Pointee>::Metadata) -> *const T { aggregate_raw_ptr(data, meta) }
+pub const fn from_raw_parts_mut<T: ?Sized>(data: *mut (), meta: <T as Pointee>::Metadata) -> *mut T { aggregate_raw_ptr(data, meta) }
+// `<*const T>::with_metadata_of` (used by `byte_sub`, so by `Rc`/`Arc::from_raw` of a `dyn`)
+pub fn with_metadata_of<T: ?Sized, U: ?Sized>(this: *const T, meta: *const U) -> *const U {
+    from_raw_parts::<U>(this as *const (), metadata(meta))
+}
diff --git a/dyn-metadata-makedst-test/main.c b/dyn-metadata-makedst-test/main.c
new file mode 100644
index 00000000..97992699
--- /dev/null
+++ b/dyn-metadata-makedst-test/main.c
@@ -0,0 +1,11 @@
+#include <stdio.h>
+unsigned dyn_roundtrip(unsigned); unsigned dyn_explicit(unsigned); unsigned dyn_mut_swap(void);
+unsigned long slice_roundtrip(unsigned long); unsigned thin_roundtrip(unsigned);
+int main(void) {
+    int fails = 0;
+    unsigned a = dyn_roundtrip(42), b = dyn_explicit(9), c = dyn_mut_swap(), e = thin_roundtrip(1234);
+    unsigned long d = slice_roundtrip(3);
+    printf("dyn_roundtrip=%u dyn_explicit=%u dyn_mut_swap=%u slice=%lu thin=%u\n", a, b, c, d, e);
+    fails += a != 42; fails += b != 3; fails += c != 5; fails += d != 3; fails += e != 1234;
+    return fails;
+}
diff --git a/dyn-metadata-makedst-test/run.sh b/dyn-metadata-makedst-test/run.sh
new file mode 100755
index 00000000..a57d1c61
--- /dev/null
+++ b/dyn-metadata-makedst-test/run.sh
@@ -0,0 +1,15 @@
+#!/bin/sh
+# Kit for 0246: `MakeDst` (the `aggregate_raw_ptr` intrinsic, 1.90 `ptr::from_raw_parts`) with a trait-object
+# metadata operand passed the whole `DynMetadata<dyn Trait>` struct to make_traitobjptr(void*, void*):
+# cursive_core 0.3.5 (jlq 0.1.0) `Rc<dyn Fn(&mut Cursive)>::from_raw` -> `byte_sub` -> `with_metadata_of` ->
+# "error: incompatible type for argument 2 of 'make_traitobjptr'". `DstMeta` (`ptr_metadata`) already stored
+# `.META` into `._0._0` of the struct; the C backend now reads it back the same way. Builds the no_core crate
+# through codegen and the C compiler, then runs it: vtable and data pointer must survive the round trip for
+# `*const`/`*mut dyn`, slices keep their length, thin pointers still work. usage: ./run.sh <path/to/mrustc>
+MRUSTC=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
+cd "$(dirname "$0")"; rm -rf out; mkdir -p out; export MRUSTC_TARGET_VER=1.90
+cat hdr.rs dynmeta.rs > out/full.rs
+if "$MRUSTC" --edition 2021 --crate-type rlib out/full.rs -o out/full.rlib > out/full.log 2>&1 \
+    && ${CC:-cc} main.c out/full.rlib.o -o out/full > out/cc.log 2>&1 && ./out/full > out/run.log; then echo "PASS full: $(cat out/run.log)"
+else echo "FAIL full: $(cat out/run.log 2>/dev/null) $(cat out/full.log out/cc.log 2>/dev/null | grep -v '^(\|V V V\|core dumped' | grep -m1 'error\|BUG\|Assert\|TODO' | cut -c1-160)"; exit 1; fi
+rm -rf out; echo "ALL PASSED"
