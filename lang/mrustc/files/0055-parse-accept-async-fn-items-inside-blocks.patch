From bde98d302e474df9111bedd11215a6b317a1d2f9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 08:23:11 +0000
Subject: [PATCH 55/59] parse: accept `async fn` items inside blocks

A statement starting with `async` was always parsed as an `async`
block, so an `async fn` declared inside a function body failed. tokio
1.10.1's `Child::wait_with_output` (src/process/mod.rs) has one:

    async fn read_to_end<A: AsyncRead + Unpin>(io: Option<A>) -> ..

    error:0: Unexpected token TOK_RWORD_FN, expected TOK_BRACE_OPEN

Treat `async fn` and `async unsafe fn` as items, like `const`/`unsafe`
followed by something other than `{`.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/parse/expr.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index 3560cab2..7b273381 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -182,6 +182,21 @@ ExprNodeP Parse_ExprBlockLine_WithItems(TokenStream& lex, ::std::shared_ptr<AST:
             return ExprNodeP();
         }
         break;
+    // 'async' - `async [unsafe] fn` is an item (e.g. a helper inside a function in tokio 1.10.1), anything else is an
+    // `async [move] { ... }` block
+    case TOK_RWORD_ASYNC:
+        if( LOOK_AHEAD(lex) == TOK_RWORD_FN || LOOK_AHEAD(lex) == TOK_RWORD_UNSAFE )
+        {
+            PUTBACK(tok, lex);
+            if( !local_mod ) {
+                local_mod = lex.parse_state().get_current_mod().add_anon();
+                DEBUG("Set module from " << lex.parse_state().module->path() << " to " << local_mod->path() );
+                lex.parse_state().module = local_mod.get();
+            }
+            Parse_Mod_Item(lex, *local_mod, mv$(item_attrs));
+            return ExprNodeP();
+        }
+        break;
     // 'unsafe' - Check if the next token isn't a `{`, if so it's an item. Otherwise, fall through
     case TOK_RWORD_UNSAFE:
         if( LOOK_AHEAD(lex) != TOK_BRACE_OPEN )
