From 9500f8fab8b079121e2a5db96c52e2cada8e3098 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 15:48:04 +0000
Subject: [PATCH 130/130] mir: the inliner handles a borrow argument

MIR_Optimise_Inlining copies non-local call arguments into new locals,
handling constants and lvalues only. `.await` lowering passes the context
to Future::poll as a borrow parameter (`&mut *a1`), so inlining a call
made with it (e.g. `PollFn::poll` running a closure, in an async fn's
generated poll) hit "Assertion `m_tag == TAG_LValue' failed"
(MIR::Param::as_LValue, mir.hpp:498) during MIR Optimise.

Borrow arguments now get a local of the borrow type, assigned the borrow.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/mir/optimise.cpp | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/src/mir/optimise.cpp b/src/mir/optimise.cpp
index 05b57ee0..3a4fe4a5 100644
--- a/src/mir/optimise.cpp
+++ b/src/mir/optimise.cpp
@@ -1486,10 +1486,26 @@ bool MIR_Optimise_Inlining(::MIR::TypeResolve& state, ::MIR::Function& fcn, bool
             for(auto& val : cloner.const_assignments)
             {
                 ::HIR::TypeRef  tmp;
-                auto ty = val.is_Constant() ? state.get_const_type(val.as_Constant()) : state.get_lvalue_type(tmp, val.as_LValue()).clone();
+                ::HIR::TypeRef  ty;
+                ::MIR::RValue   rval;
+                TU_MATCH_HDRA( (val), {)
+                TU_ARMA(Constant, e) {
+                    ty = state.get_const_type(e);
+                    rval = ::MIR::RValue(mv$(e));
+                    }
+                TU_ARMA(LValue, e) {
+                    ty = state.get_lvalue_type(tmp, e).clone();
+                    rval = ::MIR::RValue(mv$(e));
+                    }
+                // A borrow argument, e.g. the `&mut *cx` that `.await` lowering passes to `Future::poll`
+                // - inlining a closure call through `PollFn::poll` in an async fn's generated `poll`
+                TU_ARMA(Borrow, e) {
+                    ty = ::HIR::TypeRef::new_borrow(e.type, state.get_lvalue_type(tmp, e.val).clone());
+                    rval = ::MIR::RValue::make_Borrow({ e.type, false, mv$(e.val) });
+                    }
+                }
                 auto lv = ::MIR::LValue::new_Local( static_cast<unsigned>(fcn.locals.size()) );
                 fcn.locals.push_back( mv$(ty) );
-                auto rval = val.is_Constant() ? ::MIR::RValue(mv$(val.as_Constant())) : ::MIR::RValue( mv$(val.as_LValue()) );
                 auto stmt = ::MIR::Statement::make_Assign({ mv$(lv), mv$(rval) });
                 DEBUG("++ " << stmt);
                 new_blocks[0].statements.insert( new_blocks[0].statements.begin(), mv$(stmt) );
