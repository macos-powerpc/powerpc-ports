From 7ec7c3119e294e97e4e5e03720310e718e78ce40 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 30 Oct 2026 19:50:05 +0000
Subject: [PATCH 414/415] hir_typeck: a destination that absorbed a source wins
 over a lone open source

color-eyre 0.6.5 (wiki-tui 0.9.2) config.rs:205-210:
    let file = frame.filename.as_ref().map(|path| path.display());
    let file: &dyn fmt::Display =
        if let Some(ref filename) = file { filename } else { &"<unknown source file>" };
    <null> error:0: Type mismatch between std::path::Display<'_> and &str

The closure leaves `file: Option<_26>` until its body is typed, so the arms
give the match's type variable the sources `&_26` and `&&str` and the let the
destination `&dyn Display`. check_ivar_poss dropped `&&str` (it coerces into
the destination) and then picked `&_26` "as the only source"; the `&&str` arm
made `_26 = &str` and the closure's `Display<'_>` mismatched. rustc coerces
every arm to the expected type.

A destination that absorbed a source this way is what every source has to
reach, so it is picked before the only-source rule (same guards).

Assisted-by: Claude Fable 5.1
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 227aa4f3..1a04c371 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -8094,6 +8094,8 @@ namespace
             }
 
             // Remove any options that are filled by other options (e.g. `str` and a derferencable String)
+            // - A destination that absorbed a source this way is what the sources must agree on (see below)
+            const ::HIR::TypeRef* absorbing_dest = nullptr;
             for(auto it = possible_tys.begin(); it != possible_tys.end(); )
             {
                 bool remove_option = false;
@@ -8155,6 +8157,8 @@ namespace
                                 {
                                     remove_option = true;
                                     DEBUG("- Remove " << *it << ", can deref to " << other_opt);
+                                    if( other_opt.is_dest() && other_opt.is_coerce() )
+                                        absorbing_dest = other_opt.ty;
                                     break;
                                 }
                             }
@@ -8236,6 +8240,21 @@ namespace
             // Try if in first level fallback, or the bounded list is empty
             if( (!honour_disable || !ivar_ent.has_bounded) )
             {
+                // A source was dropped above because it coerces into a destination: that destination is the type every
+                // source has to reach (rustc's expected type), so it beats a lone remaining source whose own type is
+                // still open. color-eyre 0.6.5 config.rs:206 `let file: &dyn Display = if let Some(ref f) = file { f }
+                // else { &"<unknown source file>" }` with `file: Option<_>` from a closure: `&_` won and `_` became `&str`.
+                if( absorbing_dest && n_dst_ivars == 0 && ::std::count_if(possible_tys.begin(), possible_tys.end(), PossibleType::is_dest_s) == 1 )
+                {
+                    auto it = ::std::find_if(possible_tys.begin(), possible_tys.end(), PossibleType::is_dest_s);
+                    if( it->is_coerce() && context.m_ivars.types_equal(*it->ty, *absorbing_dest) )
+                    {
+                        const auto& new_ty = *it->ty;
+                        DEBUG("Picking " << new_ty << " as the destination a source coerced into [" << possible_tys << "]");
+                        context.equate_types(sp, ty_l, new_ty);
+                        return true;
+                    }
+                }
                 // If there's only one non-deref in the list OR there's only one deref in the list
                 if( n_src_ivars == 0 && ::std::count_if(possible_tys.begin(), possible_tys.end(), PossibleType::is_source_s) == 1 )
                 {
