From 639bcbe61148ed2f1f1e225c94c1b0b6746188f9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 14:34:22 +0000
Subject: [PATCH] hir_typeck: the arbitrary inference pick prefers an option
 without unresolved ivars

pin-project-internal 1.1.10 src/pin_project/args.rs:53 (kbs2 0.7.3):
    "Type mismatch between &::"syn-2_0_104_Hcf7"::attr::Attribute and ::"syn-2_0_104_Hcf7"::attr::Attribute"
`let span = match (prev_res, res) { (Some(_), _) => attr, (None, _) => prev_attr }; bail!(span, ..)`, where
bail! is `syn::Error::new_spanned(&span as &dyn ToTokens, ..)`. `attr: &Attribute` is the item of
`attrs.iter().filter(..)` (settled only once the closure is typed), `prev_attr: &&Attribute` comes from
`let (prev_attr, prev_res) = &prev;` with `prev.0` that same late type. The match result reached the arbitrary
pick of the "IVar possibilities (fallback)" stage with the candidates [`&Attribute`, `&_57`] and took the last,
`&_57`; coercing the first arm's `&Attribute` into a reference with an unknown pointee is an equality, so `_57`
had to be `Attribute`, against the tuple field's own `_57 := attr`. rustc keeps the first arm's known type and
deref-coerces `&&Attribute` to it.

The arbitrary pick now prefers the last option that holds no inference variable: a target with an unknown
pointee turns every other option's coercion into an equality, while a known target leaves the late option free
to coerce once it is resolved. When every option has ivars the pick is unchanged.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 01ca5622..0923553f 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -8177,7 +8177,17 @@ namespace
                 if( possible_tys.size() > 0 && !honour_disable && n_ivars == 0 )
                 {
                     //::std::sort(possible_tys.begin(), possible_tys.end());  // Sorts ivars to the front
-                    const auto& new_ty = *possible_tys.back().ty;
+                    // Prefer the last option that holds no unresolved ivar: a target with an unknown pointee turns the other
+                    // options' coercions into equalities. pin-project-internal 1.1.10 args.rs:53 (kbs2): the arms
+                    // `attr: &Attribute` (from `Filter::next`, settled late) and `prev_attr: &_` with the result cast to
+                    // `&dyn ToTokens` took `&_`, so `&Attribute := &_` became "Type mismatch between &Attribute and
+                    // Attribute"; rustc coerces the later arm to the first, known, one (`&&Attribute` derefs to it).
+                    auto it_pick = possible_tys.end();
+                    for(auto it = possible_tys.begin(); it != possible_tys.end(); ++it) {
+                        if( !context.m_ivars.type_contains_ivars(*it->ty) )
+                            it_pick = it;
+                    }
+                    const auto& new_ty = (it_pick != possible_tys.end() ? *it_pick->ty : *possible_tys.back().ty);
                     DEBUG("Picking " << new_ty << " as an arbitary an option from [" << possible_tys << "]");
                     context.equate_types(sp, ty_l, new_ty);
                     return true;
