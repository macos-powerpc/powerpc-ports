From 102ee3caf34b01fa702be98d9ec22e1accbf5dec Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 6 Nov 2026 07:29:43 +0000
Subject: [PATCH] parse: an empty bound list may end at `>` or `=`

tor-cell 0.47.0 (arti 2.7.0) chancell/msg.rs:28 `restricted_msg!`:
`Unexpected token TOK_GT, expected TOK_IDENT`.

restrict.rs:133 transcribes `fn encode_onto<W:>(self, w: &mut W) -> ..
where W: Writer + ?Sized`: a generic parameter with an empty bound list
closed by `>`. rustc accepts `<T:>`, `<T: = D>` and `where T:`.
Parse_TypeBound returned early on an empty list only before `,`, `{` or
`;`, so the `>` went into the bound parser as a path.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 3a57df64..7711f72c 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -252,8 +252,10 @@ void Parse_TypeBound(TokenStream& lex, AST::GenericParams& ret, TypeRef checked_
     TRACE_FUNCTION;
     Token tok;
 
-    // Empty bound list
-    if( lex.lookahead(0) == TOK_COMMA || lex.lookahead(0) == TOK_BRACE_OPEN || lex.lookahead(0) == TOK_SEMICOLON ) {
+    // Empty bound list: `where T: {`, `<T: , U>`, and `<T:>` / `<T: = D>` at the end of a parameter
+    // (tor-cell 0.47.0 restrict.rs:133 `fn encode_onto<W:>(self, w: &mut W) where W: Writer + ?Sized`)
+    if( lex.lookahead(0) == TOK_COMMA || lex.lookahead(0) == TOK_BRACE_OPEN || lex.lookahead(0) == TOK_SEMICOLON
+        || lex.lookahead(0) == TOK_GT || lex.lookahead(0) == TOK_EQUAL ) {
         return ;
     }
 
