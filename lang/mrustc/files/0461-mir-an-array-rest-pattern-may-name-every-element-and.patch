From 1cb487f499c3d9bcca2744c613815566ee1cb1a0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 10 Nov 2026 12:48:16 +0000
Subject: [PATCH 461/461] mir: an array rest pattern may name every element and
 leave the rest empty

Found writing the array-rest-ref-pattern-test kit: `let [a, b, rest @ ..] =
s;` with `s: &[u8; 2]` -> `BUG: src/mir/from_hir_match.cpp:2071: ASSERT
FAIL: pe.leading.size() < e.size.as_Known(): Too many leading slice rules
for array type`.

The array SplitSlice rule builder required the leading sub-patterns, and
separately the trailing ones, to be fewer than the array length, so a rest
that is left empty (`[a, b, rest @ ..]`, `[rest @ .., a, b]`, `[a, b, ..]`
on a `[T; 2]`; valid Rust, rest: `[T; 0]`) was rejected. The check is now
leading + trailing <= length, in one assertion that prints the pattern and
the type.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/mir/from_hir_match.cpp b/src/mir/from_hir_match.cpp
index e90a0cbb..7ccb7793 100644
--- a/src/mir/from_hir_match.cpp
+++ b/src/mir/from_hir_match.cpp
@@ -2068,8 +2068,8 @@ void PatternRulesetBuilder::append_from(const Span& sp, const ::HIR::Pattern& pa
             }
         TU_ARMA(SplitSlice, pe) {
             ASSERT_BUG(sp, pe.leading.size() < FIELD_INDEX_MAX, "Too many leading slice rules to fit encodng");
-            ASSERT_BUG(sp, pe.leading.size() < e.size.as_Known(), "Too many leading slice rules for array type");
-            ASSERT_BUG(sp, pe.trailing.size() < e.size.as_Known(), "Too many leading slice rules for array type");
+            // `[a, b, rest @ ..]` on a `[T; 2]` names every element and leaves an empty rest
+            ASSERT_BUG(sp, pe.leading.size() + pe.trailing.size() <= e.size.as_Known(), "Too many slice rules for array type: " << pat << " on " << ty);
             for(const auto& subpat : pe.leading)
             {
                 this->append_from( sp, subpat, e.inner );
