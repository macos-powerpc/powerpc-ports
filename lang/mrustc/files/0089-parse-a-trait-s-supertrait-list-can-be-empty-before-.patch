From 3982f1e51f73f576bcea72d71c4a76893efff9ea Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 6 Oct 2026 17:43:02 +0000
Subject: [PATCH 89/90] parse: a trait's supertrait list can be empty before a `where` clause

shellexpand 3.1.2 src/wtraits.rs:119:

    pub(crate) trait WstrExt: where for <'s> &'s Self: WstrRefExt {

    wtraits.rs:119:33 error:0: Unexpected token TOK_RWORD_WHERE, expected TOK_IDENT

The bound list after `:` is optional in the grammar (`TypeParamBounds?`).
`Parse_TraitDef` already stopped at `{` for `trait Tr: {`, but not at `where`,
so it tried to parse `where` as a trait path. It now stops at either. This also
covers a trailing `+` before the where clause (`trait Tr: Copy + where ...`).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/parse/root.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index ad8e1267..a5b2eee9 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -921,7 +921,8 @@ AST::Trait Parse_TraitDef(TokenStream& lex, AST::AttributeList& meta_items, AST:
             if( GET_TOK(tok, lex) == TOK_LIFETIME ) {
                 lifetimes.push_back( GET_SPANNED(AST::LifetimeRef, lex, ::AST::LifetimeRef(tok.ident()) ) );
             }
-            else if( tok.type() == TOK_BRACE_OPEN ) {
+            // The bound list can be empty (`trait Tr: {` or `trait Tr: where ... {`), or end in a `+`
+            else if( tok.type() == TOK_BRACE_OPEN || tok.type() == TOK_RWORD_WHERE ) {
                 break;
             }
             else {
