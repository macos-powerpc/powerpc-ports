index 2a33ea67..869d0e60 100644
--- a/src/hir/type.cpp
+++ b/src/hir/type.cpp
@@ -743,6 +743,8 @@ namespace {
             if(te == xe) {
                 return ::HIR::Compare::Equal;
             }
+            // Two different expressions may still evaluate to the same value (this fell through to the throw below)
+            return ::HIR::Compare::Fuzzy;
             }
         TU_ARMA(Generic, te,xe) throw "Unreachable";
         TU_ARMA(Evaluated, te, xe)
@@ -750,6 +752,23 @@ namespace {
         }
         throw "Unreachable";
     }
+    /// An array size as a value: a bound value ivar is replaced by its value through the placeholder callback (as
+    /// path parameters do, `PathParams::match_test_generics_fuzz` / `compare_with_placeholders`), and a `Known` size
+    /// becomes the evaluated literal (held in `tmp`) so that both spellings of a known size compare equal.
+    const ::HIR::ConstGeneric& resolve_array_size(const Span& sp, const ::HIR::ArraySize& s, ::HIR::t_cb_resolve_type resolve_placeholder, ::HIR::ConstGeneric& tmp)
+    {
+        if( const auto* k = s.opt_Known() ) {
+            tmp = ::HIR::ConstGeneric( ::HIR::EncodedLiteralPtr( EncodedLiteral::make_usize(*k) ) );
+            return tmp;
+        }
+        const auto& v = s.as_Unevaluated();
+        if( const auto* ie = v.opt_Infer() ) {
+            if( ie->index != ~0u ) {
+                return resolve_placeholder.get_val(sp, v);
+            }
+        }
+        return v;
+    }
 }
 
