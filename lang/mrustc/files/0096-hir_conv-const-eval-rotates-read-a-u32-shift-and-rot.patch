From b71321a4e60e6add71bf4fc1177ad643769770c7 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 00:46:13 +0000
Subject: [PATCH 96/96] hir_conv: const-eval rotates read a u32 shift and
 rotate 64-bit values

Since 1.8x `rotate_left`/`rotate_right` take `shift: u32` for every T,
but the shift was read at T's width: a `u8`/`u16` rotate read the high
end of the u32 on big-endian targets (rotate by 0, e.g. ppc
`rl8(0x81, 1)` gave 0x81), and a `u64` rotate read 8 bytes of a 4-byte
value ("Invalid read: 0+8"). 64-bit values were also returned
unrotated (`rotate_left(0xF0u64, 60)` gave 0xF0), and a shift of at
least the bit width hit an assertion although it rotates modulo the
width. Read the shift as u32 for 1.90 (T before), reduce it modulo the
width, and drop the 64-bit special case; U128 shifts are fine below 128.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_conv/constant_evaluation.cpp | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index 49dff12e..da8b06ef 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -2709,12 +2709,13 @@ namespace HIR {
                     auto ti = TypeInfo::for_type(ty);
 
                     auto val = local_state.read_param_uint(ti.bits, e.args.at(0));
-                    auto count = local_state.read_param_uint(ti.bits, e.args.at(1));
-                    MIR_ASSERT(state, count <= ti.bits, "Excessive rotation");
-                    unsigned count_i = count.truncate_u64();
+                    // The shift is a `u32` for every T since 1.8x (before, it had the type of `x`), and rotates by
+                    // the shift modulo the bit width.
+                    auto count = local_state.read_param_uint(TARGETVER_LEAST_1_90 ? 32 : ti.bits, e.args.at(1));
+                    unsigned count_i = count.truncate_u64() % ti.bits;
 
                     U128    rv;
-                    if( count_i == 0 || ti.bits == 64 ) {
+                    if( count_i == 0 ) {
                         rv = val;
                     }
                     else if( te->name == "rotate_left" ) {
