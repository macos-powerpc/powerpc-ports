+        /// A value enum whose tag (`repr(u128)`/`repr(i128)`) is an emulated i128, i.e. a two-word struct in the C
+        bool enum_tag_is_emulated_i128(const ::HIR::TypeRef& ty) const
+        {
+            if( !m_options.emulated_i128 || !TU_TEST1(ty.data(), Path, .binding.is_Enum()) )
+                return false;
+            const auto* repr = Target_GetTypeRepr(sp, m_resolve, ty);
+            if( !repr || !repr->variants.is_Values() )
+                return false;
+            const auto& ve = repr->variants.as_Values();
+            return type_is_emulated_i128(Target_GetInnerType(sp, m_resolve, *repr, ve.field.index, ve.field.sub_fields));
+        }
