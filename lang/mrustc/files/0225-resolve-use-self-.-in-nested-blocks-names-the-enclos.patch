From a4884218f224727a2ced2bd2a177d25072749847 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 14:01:30 +0000
Subject: [PATCH] resolve: `use self::..` in nested blocks names the enclosing
 module

Resolve_Use_AbsolutisePath took `self` in a `use` inside a block as the
parent of the innermost anonymous (block) module only. In a block nested in
a fn body (`..::#0::#1`) that is still the fn body's block. jaq-core 3.1.0
compile.rs (jaq 3.1.1):

    fn term(&mut self, t: parse::Term<&'s str>, tr: &Tr) -> (Term, Tr) {
        use parse::Term::*;
        match t {
            ..
            Fold(name, xs, pat, args) => {
                use self::Fold::{Foreach, Reduce};

`self::Fold` found the `Fold` variant that the fn body's glob brings in,
not the module's `enum Fold`:

    compile.rs:674:21-51 error:0: Cannot find component 2 of crate::compile::#0::Fold::Foreach/*?*/ (_)

`self` now skips every trailing anonymous module, as `super` in the same
function and `self` in Resolve Absolute / get_module already do.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/resolve/use.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/resolve/use.cpp b/src/resolve/use.cpp
index 9bccf815..318f7d17 100644
--- a/src/resolve/use.cpp
+++ b/src/resolve/use.cpp
@@ -232,9 +232,15 @@ static bool Resolve_Use_LocalTypeItemShadows(const AST::Crate& crate, const ::AS
     TU_ARMA(Self, e) {
         DEBUG("Self " << path);
         // EVIL HACK: If the current module is an anon module, refer to the parent
+        // - Every enclosing anon module (as for `super` below): a block nested in a fn body is `..::#0::#1`, and
+        //   `self` is still the named module (jaq-core 3.1.0 `use self::Fold::{..}` in a match arm, where the fn
+        //   body's `use parse::Term::*;` brings in a `Fold` variant)
         if( base_path.nodes().size() > 0 && base_path.nodes().back().name().c_str()[0] == '#' ) {
+            unsigned int n_named = base_path.nodes().size();
+            while( n_named > 0 && base_path.nodes()[n_named-1].name().c_str()[0] == '#' )
+                n_named --;
             AST::Path   np("", {});
-            for( unsigned int i = 0; i < base_path.nodes().size() - 1; i ++ )
+            for( unsigned int i = 0; i < n_named; i ++ )
                 np.nodes().push_back( base_path.nodes()[i] );
             np += path;
             return np;
