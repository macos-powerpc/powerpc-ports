From 35fb9f92e15f4980571dd40546604503c0a989b9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 14 Oct 2026 19:59:20 +0000
Subject: [PATCH 240/241] expand: proc-macro impl tokens carry associated
 types, macro calls and item attributes

arc-swap 1.9.2 (cargo-c 0.10.25, broot 1.61.0) ref_cnt.rs:184:

    #[rustversion::since(1.39)]
    unsafe impl<T> RefCnt for Pin<Arc<T>> {
        type Base = T;
        ..
    }

    BUG: src/expand/proc_macro.cpp:1867: TODO: visit_impl - Item Type

The token visitor that sends an impl to an attribute proc macro handled
only functions and statics/consts. It now sends associated types (the
where clause after the type, `type Item<'a> = &'a S where Self: 'a;`,
the position mrustc's parser takes back), unexpanded macro invocations,
`unsafe` on the impl, and each item's own attributes (`#[inline]`,
`#[cfg(..)]`, doc comments), which were dropped before, as for trait and
module items.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/expand/proc_macro.cpp | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 2bdc4c1f..7e761d8b 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -1778,6 +1778,9 @@ namespace {
 
         void visit_impl_hdr(const ::AST::ImplDef& impl)
         {
+            if( impl.is_unsafe() ) {
+                m_pmi.send_rword("unsafe");
+            }
             m_pmi.send_rword("impl");
             visit_params(impl.params());
 
@@ -1862,9 +1865,12 @@ namespace {
             {
                 const auto& sp = i.sp;
                 const auto& item = *i.data;
+                // The item's own attributes (`#[inline]`, `#[cfg(..)]`) are part of the impl's tokens, as for trait
+                // and module items
+                this->visit_attrs(i.attrs);
                 TU_MATCH_HDRA((item), {)
                 default:
-                    TODO(sp, "Item " << item.tag_str());
+                    TODO(sp, "visit_impl - Item " << item.tag_str());
                     break;
                 TU_ARMA(Function, e) {
                     visit_function(i.name.c_str(), i.vis, e);
@@ -1872,6 +1878,24 @@ namespace {
                 TU_ARMA(Static, e) {
                     visit_static(i.name.c_str(), i.vis, e);
                     }
+                // An associated type: `type Base = T;` (arc-swap 1.9.2 ref_cnt.rs:184 `#[rustversion::since(1.39)]
+                // unsafe impl<T> RefCnt for Pin<Arc<T>> { type Base = T; .. }`, "TODO: visit_impl - Item Type")
+                // - The where clause goes after the type (`type Item<'a> = &'a S where Self: 'a;`): the position rustc
+                //   prefers, and the only one mrustc's parser takes back
+                TU_ARMA(Type, e) {
+                    this->visit_vis(i.vis);
+                    m_pmi.send_rword("type");
+                    m_pmi.send_ident(i.name.c_str());
+                    this->visit_params(e.params());
+                    m_pmi.send_symbol("=");
+                    this->visit_type(e.type());
+                    this->visit_bounds(e.params());
+                    m_pmi.send_symbol(";");
+                    }
+                // A macro invocation in the impl body, not yet expanded
+                TU_ARMA(MacroInv, e) {
+                    this->visit_item(i.name, i.vis, item);
+                    }
                 }
             }
             m_pmi.send_symbol("}");
