+        assert_tt_matches!(it.next(), Ident::new("x", Span::call_site()).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Alone).into());
+        assert_tt_matches!(it.next(), Literal::new_u(0,0).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Alone).into());
+        assert_tt_matches!(it.next(), Literal::new_u(1,0).into());
+        assert_tt_matches!(it.next(), Literal::new_u(1,0).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Alone).into());
+        assert_tt_matches!(it.next(), Ident::new("max", Span::call_site()).into());
+        let _ = it.next();
+        assert_tt_matches!(it.next(), Literal::new_u(1,0).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Joint).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Alone).into());
+        assert_tt_matches!(it.next(), Literal::new_u(2,0).into());
+        assert_tt_matches!(it.next(), lit(Float(1.5, 0)));
+        assert_tt_matches!(it.next(), lit(Float(1.0, 0)));
+        assert_tt_matches!(it.next(), lit(Float(2000.0, 0)));
+        assert_tt_matches!(it.next(), lit(Float(1.5e-3, 64)));
+        assert_tt_matches!(it.next(), lit(Float(1.0, 32)));
+        assert_tt_matches!(it.next(), Literal::new_u(31,8).into());
+        assert_tt_matches!(it.next(), lit(Suffixed(Box::new(UnsignedInt(10, 0)), "px".to_owned())));
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Alone).into());
+        assert_tt_matches!(it.next(), Literal::new_u(7,8).into());
+        assert_tt_matches!(it.next());
+        assert_eq!(lit(Float(1.0, 0)).to_string(), "1.0");
+        assert_eq!(lit(Float(0.1f32 as f64, 32)).to_string(), "0.1f32");
+    }
+    #[test]
+    fn comment_at_end()
+    {
+        // A line comment ending the input looped forever
+        let rv = TokenStream::from_str("x // comment").expect("Failed to parse");
+        let mut it = rv.inner.into_iter();
+        assert_tt_matches!(it.next(), Ident::new("x", Span::call_site()).into());
+        assert_tt_matches!(it.next());
+        assert!(TokenStream::from_str("x /* unterminated").is_err());
+    }
+    #[test]
+    fn symbols()
+    {
+        let rv = TokenStream::from_str("<<= ..= ...").expect("Failed to parse");
+        let mut it = rv.inner.into_iter();
+        assert_tt_matches!(it.next(), Punct::new('<', Spacing::Joint).into());
+        assert_tt_matches!(it.next(), Punct::new('<', Spacing::Joint).into());
+        assert_tt_matches!(it.next(), Punct::new('=', Spacing::Alone).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Joint).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Joint).into());
+        assert_tt_matches!(it.next(), Punct::new('=', Spacing::Alone).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Joint).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Joint).into());
+        assert_tt_matches!(it.next(), Punct::new('.', Spacing::Alone).into());
+        assert_tt_matches!(it.next());
+    }
+    #[test]
+    fn escapes_and_raw_idents()
+    {
+        let rv = TokenStream::from_str(r#"'\u{7b}' '\x41' '\\' b'a' b'\xff' b"\xff\\" r#type"#).expect("Failed to parse");
+        let mut it = rv.inner.into_iter();
+        assert_tt_matches!(it.next(), Literal::character('{').into());
+        assert_tt_matches!(it.next(), Literal::character('A').into());
+        assert_tt_matches!(it.next(), Literal::character('\\').into());
+        assert_tt_matches!(it.next(), Literal::byte_character(b'a').into());
+        assert_tt_matches!(it.next(), Literal::byte_character(0xff).into());
+        assert_tt_matches!(it.next(), Literal::byte_string(b"\xff\\").into());
+        assert_tt_matches!(it.next(), Ident::new_raw("type", Span::call_site()).into());
+        assert_tt_matches!(it.next());
+        assert_eq!(Literal::character('\\').to_string(), r"'\\'");
+        assert_eq!(Literal::byte_string(b"\\").to_string(), r#"b"\x5c""#);
+    }
 }
