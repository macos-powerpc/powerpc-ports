+        /// The character of an escape sequence: the current character is the one after the `\`, and is left on the
+        /// escape's last character
+        fn lex_escape<T: Iterator<Item=char>>(it: &mut CharStream<T>) -> Result<char, &'static str>
+        {
+            Ok(match it.cur()
+            {
+            'n' => '\n',
+            'r' => '\r',
+            't' => '\t',
+            '0' => '\0',
+            '\\' => '\\',
+            '\'' => '\'',
+            '"' => '"',
+            'x' => {
+                let mut v = 0u32;
+                for _ in 0 .. 2 {
+                    let d = some_else!(it.consume() => return Err("Unterminated `\\x` escape"));
+                    v = v * 16 + some_else!(d.to_digit(16) => return Err("Invalid hex digit in `\\x` escape"));
+                }
+                some_else!(::std::char::from_u32(v) => return Err("Invalid `\\x` escape"))
+                },
+            'u' => {
+                if it.consume() != Some('{') {
+                    return Err("Expected `{` after `\\u`");
+                }
+                let mut v = 0u32;
+                loop {
+                    let d = some_else!(it.consume() => return Err("Unterminated `\\u` escape"));
+                    if d == '}' {
+                        break ;
+                    }
+                    if d != '_' {
+                        v = v * 16 + some_else!(d.to_digit(16) => return Err("Invalid hex digit in `\\u` escape"));
+                    }
+                }
+                some_else!(::std::char::from_u32(v) => return Err("Invalid `\\u` escape"))
+                },
+            _ => return Err("Unknown escape"),
+            })
+        }
+        /// A number literal: the current character is its first digit, and is left on the character after it.
+        /// As mrustc's own lexer: an integer followed by `..`, or by `.` and an identifier (`1..2`, `1.max(2)`), ends
+        /// there; any other `.`, an exponent, or an `f32`/`f64` suffix makes a float (`1.5`, `1.`, `1e3`, `1f32`).
+        /// Other suffixes are kept, as rustc's lexer does (`10px` for a DSL macro). A tuple index (`allow_float`
+        /// false) ends before any `.` or exponent: `x.0.1` is `x . 0 . 1`.
+        fn lex_number<T: Iterator<Item=char>>(it: &mut CharStream<T>, allow_float: bool) -> Result<crate::token_tree::LiteralValue, &'static str>
+        {
+            use crate::token_tree::LiteralValue;
+            fn digits<T: Iterator<Item=char>>(it: &mut CharStream<T>, mut c: Option<char>, base: u32, v: &mut u128, text: &mut String) -> Option<char>
+            {
+                loop
+                {
+                    match c
+                    {
+                    Some('_') => {},
+                    Some(ch) if ch.is_digit(base) => {
+                        *v = v.wrapping_mul(base as u128).wrapping_add(ch.to_digit(base).unwrap() as u128);
+                        text.push(ch);
+                        },
+                    _ => return c,
+                    }
+                    c = it.consume();
+                }
+            }
+            fn parse_float(text: &str) -> Result<f64, &'static str> {
+                // `1.` is `1.0`
+                let text = if text.ends_with('.') { format!("{}0", text) } else { text.to_owned() };
+                text.parse::<f64>().map_err(|_| "Invalid float literal")
+            }
+
+            let mut base = 10;
+            if it.cur() == '0' {
+                base = match it.next() { Some('x') => 16, Some('o') => 8, Some('b') => 2, _ => 10 };
+                if base != 10 {
+                    it.consume();
+                    it.consume();
+                }
+            }
+            let mut v: u128 = 0;
+            // Decimal digits (and `.`/exponent) of a float's value
+            let mut text = String::new();
+            let mut is_float = false;
+            let first = if it.is_complete() { None } else { Some(it.cur()) };
+            let mut c = digits(it, first, base, &mut v, &mut text);
+            if text.is_empty() {
+                return Err("Missing digits in an integer literal");
+            }
+            if allow_float && base == 10 && c == Some('.') {
+                let int_ends = match it.next() { Some('.') => true, Some(n) => n == '_' || n.is_alphabetic(), None => false };
+                if !int_ends {
+                    is_float = true;
+                    text.push('.');
+                    let after_dot = it.consume();
+                    c = digits(it, after_dot, 10, &mut 0, &mut text);
+                }
+            }
+            if allow_float && base == 10 && (c == Some('e') || c == Some('E')) {
+                let is_exponent = match it.next() { Some('+') | Some('-') | Some('_') => true, Some(n) => n.is_digit(10), None => false };
+                if is_exponent {
+                    is_float = true;
+                    text.push('e');
+                    c = it.consume();
+                    if c == Some('+') || c == Some('-') {
+                        text.push(c.unwrap());
+                        c = it.consume();
+                    }
+                    c = digits(it, c, 10, &mut 0, &mut text);
+                }
+            }
+            let suffix = match c
+                {
+                Some(ch) if ch == '_' || ch.is_alphabetic() => get_ident(it, String::new()),
+                _ => String::new(),
+                };
+            Ok(match &suffix[..]
+            {
+            "" if is_float => LiteralValue::Float(parse_float(&text)?, 0),
+            "" => LiteralValue::UnsignedInt(v, 0),
+            "f32" if base == 10 => LiteralValue::Float(parse_float(&text)?, 32),
+            "f64" if base == 10 => LiteralValue::Float(parse_float(&text)?, 64),
+            "u8"    if !is_float => LiteralValue::UnsignedInt(v,   8),
+            "u16"   if !is_float => LiteralValue::UnsignedInt(v,  16),
+            "u32"   if !is_float => LiteralValue::UnsignedInt(v,  32),
+            "u64"   if !is_float => LiteralValue::UnsignedInt(v,  64),
+            "u128"  if !is_float => LiteralValue::UnsignedInt(v, 128),
+            "usize" if !is_float => LiteralValue::UnsignedInt(v,   1),
+            "i8"    if !is_float => LiteralValue::SignedInt(v as i128,   8),
+            "i16"   if !is_float => LiteralValue::SignedInt(v as i128,  16),
+            "i32"   if !is_float => LiteralValue::SignedInt(v as i128,  32),
+            "i64"   if !is_float => LiteralValue::SignedInt(v as i128,  64),
+            "i128"  if !is_float => LiteralValue::SignedInt(v as i128, 128),
+            "isize" if !is_float => LiteralValue::SignedInt(v as i128,   1),
+            _ => {
+                let inner = if is_float { LiteralValue::Float(parse_float(&text)?, 0) } else { LiteralValue::UnsignedInt(v, 0) };
+                LiteralValue::Suffixed(Box::new(inner), suffix.clone())
+                },
+            })
+        }
 
         'outer: while ! it.is_complete()
         {
