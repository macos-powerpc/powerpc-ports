From ee5beb146fdba47721ca273f5ab2e0c730578865 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 26 Oct 2026 05:45:06 +0000
Subject: [PATCH] parse: `use ::{..}` takes a brace list of extern-prelude
 paths (edition 2018+)

kalc 1.5.1, compiling bnum 0.12.1:

    src/bint/mod.rs:30:1 error:0: Unexpected token TOK_BRACE_OPEN, expected TOK_IDENT

bnum/src/bint/mod.rs:29:

    #[cfg(feature = "borsh")]
    use ::{
        alloc::string::ToString,
        borsh::{BorshDeserialize, BorshSchema, BorshSerialize},
    };

Since edition 2018 a leading `::` in a path names a crate of the extern prelude, and the use tree
after it may be a brace list whose entries each start with a crate name.  Parse_Use_Root's 2018
arm read exactly one crate identifier after `::`, so the list was a syntax error, even in an item
that is cfg'd out (it still has to parse).  The arm now reads either one entry or a brace list of
entries (`crate`, `crate as name`, `crate::<use tree>`, trailing comma allowed) through a new
Parse_Use_Extern2018, which is the old single-entry code.  Edition 2015, where `::` is the crate
root and Parse_Use_Inner already took the braces, is unchanged.

Kit use-root-brace-test (no_core `dep` stand-in passed with --extern): pos.rs = the bnum shape
cfg'd out and live with nested braces, `self`, `as`, a glob and a trailing comma (editions 2021
and 2018, typecheck); neg.rs = an unknown path in the list still fails (now in resolve);
ed2015.rs = the 2015 crate-root form.  Fails on 0409 with the exact error; all of bnum 0.12.1
parses on 0410.

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index d16c972b..4cf01f74 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1807,6 +1807,32 @@ void Parse_Use_Inner(TokenStream& lex, ::std::vector<AST::UseItem::Ent>& entries
     // TODO: Get a span covering the final node.
     entries.push_back({ lex.point_span(), AST::Path(path), ::std::move(name) });
 }
+// After a leading `::` in 2018+: `crate`, `crate as name` or `crate::<use tree>`
+static void Parse_Use_Extern2018(TokenStream& lex, ::std::vector<AST::UseItem::Ent>& entries)
+{
+    Token   tok;
+    GET_CHECK_TOK(tok, lex, TOK_IDENT);
+    // HACK: if the crate name starts with `=` it's a 2018 absolute path (references a crate loaded with `--extern`)
+    auto path = ::AST::Path(RcString(std::string("=") + tok.ident().name.c_str()), {});
+    if(lex.lookahead(0) != TOK_DOUBLE_COLON)
+    {
+        RcString    name;
+        if( lex.getTokenIf(TOK_RWORD_AS) )
+        {
+            name = get_optional_ident(lex);
+        }
+        else
+        {
+            name = path.m_class.as_Absolute().crate.c_str() + 1;
+        }
+
+        // TODO: Get a span covering the final node.
+        entries.push_back({ lex.point_span(), AST::Path(path), ::std::move(name) });
+        return ;
+    }
+    GET_CHECK_TOK(tok, lex, TOK_DOUBLE_COLON);
+    Parse_Use_Inner(lex, entries, path);
+}
 void Parse_Use_Root(TokenStream& lex, ::std::vector<AST::UseItem::Ent>& entries)
 {
     AST::Path   path = AST::Path("", {});
@@ -1848,27 +1874,23 @@ void Parse_Use_Root(TokenStream& lex, ::std::vector<AST::UseItem::Ent>& entries)
         }
         else if( lex.edition_after(AST::Edition::Rust2018) )
         {
-            GET_CHECK_TOK(tok, lex, TOK_IDENT);
-            // HACK: if the crate name starts with `=` it's a 2018 absolute path (references a crate loaded with `--extern`)
-            path = ::AST::Path(RcString(std::string("=") + tok.ident().name.c_str()), {});
-            // TODO: Is `use ::foo as bar` valid?
-            if(lex.lookahead(0) != TOK_DOUBLE_COLON)
+            // A brace list of extern-prelude paths: `use ::{alloc::string::ToString, borsh::{..}};`
+            // (bnum 0.12.1 bint/mod.rs:30)
+            if( lex.lookahead(0) == TOK_BRACE_OPEN )
             {
-                RcString    name;
-                if( lex.lookahead(0) == TOK_RWORD_AS )
-                {
-                    GET_CHECK_TOK(tok, lex, TOK_RWORD_AS);
-                    name = get_optional_ident(lex);
-                }
-                else
-                {
-                    name = path.m_class.as_Absolute().crate.c_str() + 1;
-                }
-
-                // TODO: Get a span covering the final node.
-                entries.push_back({ lex.point_span(), AST::Path(path), ::std::move(name) });
+                GET_TOK(tok, lex);
+                do {
+                    if( lex.lookahead(0) == TOK_BRACE_CLOSE ) {
+                        GET_TOK(tok, lex);
+                        break;
+                    }
+                    Parse_Use_Extern2018(lex, entries);
+                } while( GET_TOK(tok, lex) == TOK_COMMA );
+                CHECK_TOK(tok, TOK_BRACE_CLOSE);
                 return ;
             }
+            Parse_Use_Extern2018(lex, entries);
+            return ;
         }
         else
         {
