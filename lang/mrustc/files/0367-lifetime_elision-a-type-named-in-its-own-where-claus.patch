From 5ffbefcbe993558dfbc170528ae73c64d50ba54d Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 14:06:57 +0000
Subject: [PATCH 367/368] lifetime_elision: a type named in its own where
 clause does not inherit bounds from itself

`pub struct Holder where Holder: Send { .. }` (and smashquote 0.1.2's `pub enum UnescapeError where
UnescapeError: Send, ..` once the parser accepts it):
    "<null> BUG: ASSERT FAIL: src/hir_conv/lifetime_elision.cpp:475:be.test.is_param(): 'static: 'static"
visit_params moves each bound out while visiting it and leaves a `'static: 'static` placeholder in the list for
pointer stability. Visiting the bound's type `Holder` runs the "inherit bounds" step over the referenced item's
bounds, which here is the same list, so it met the placeholder; a push there would also have reallocated the
vector under the loop. The item's bounds are already its own, so nothing is inherited from the item itself, and
a written `'static: 'a` bound (trivially true) is skipped rather than asserted on.

Kit enum-where-clause-test strct.rs: the clause on a plain struct with a derived Debug impl (the derive copies the
clause), and `Outer<'a> where Outer<'a>: Send` next to a lifetime-carrying field. The old binary hits the assert.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_conv/lifetime_elision.cpp b/src/hir_conv/lifetime_elision.cpp
index 33c72e0d..9a8d1055 100644
--- a/src/hir_conv/lifetime_elision.cpp
+++ b/src/hir_conv/lifetime_elision.cpp
@@ -461,7 +461,12 @@ namespace
                         p->m_params.m_lifetimes.resize( gp->m_lifetimes.size() );
 
                         // Inherit bounds.
-                        if( m_cur_params ) {
+                        // - Not from the item itself: a where clause naming its own type (smashquote 0.1.2 `pub enum
+                        //   UnescapeError where UnescapeError: Send, ..`) would walk the list being visited, which holds
+                        //   `visit_params`'s `'static: 'static` placeholder for the bound in hand ("ASSERT FAIL:
+                        //   lifetime_elision.cpp:475: be.test.is_param(): 'static: 'static") and which a push would
+                        //   reallocate under the loop; its bounds are already its own.
+                        if( m_cur_params && gp != m_cur_params ) {
                             TRACE_FUNCTION_FR("INHERIT BOUNDS: " << *p, "INHERIT BOUNDS");
                             // Visit lifeitmes first - so they're un-elided
                             for(auto& l : p->m_params.m_lifetimes) {
@@ -472,7 +477,11 @@ namespace
                             for(const auto& b : gp->m_bounds) {
                                 TU_MATCH_HDRA((b), {)
                                 TU_ARMA(Lifetime, be) {
-                                    ASSERT_BUG(sp, be.test.is_param(), b);
+                                    // A written `'static: 'a` holds trivially: nothing to inherit
+                                    if( !be.test.is_param() ) {
+                                        DEBUG("Skip (not a parameter) " << b);
+                                        continue;
+                                    }
                                     ASSERT_BUG(sp, be.valid_for.binding != HIR::LifetimeRef::UNKNOWN, b);
                                     m_cur_params->m_bounds.push_back(HIR::GenericBound::make_Lifetime({
                                         ms.monomorph_lifetime(sp, be.test),
