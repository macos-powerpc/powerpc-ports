From 9e7cb1e486564e1dfb8df947f13fe66f64358668 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 00:04:52 +0000
Subject: [PATCH] parse: a trait bound may be in parentheses (`F: (FnOnce(&Ctx)
 -> T)`)

bindgen 0.72.1 (py314-qh3 2.0.4) ir/context.rs:984:

    fn with_loaned_item<F, T>(&mut self, id: ItemId, f: F) -> T
    where
        F: (FnOnce(&BindgenContext, &mut Item) -> T),

    context.rs:984:14 error:0: Unexpected token TOK_PAREN_OPEN, expected TOK_IDENT

Rust's TraitBound is `?`? ForLifetimes? TypePath, or the same in
parentheses. mrustc took the parentheses in `dyn` and `impl` bounds only.
Now also:
- Parse_TypeBound (generic parameters, where clauses, associated type
  bounds `type A: (Tr);`): `(Tr)`, `(?Sized)`, `(for<'a> Tr<'a>)`; a lifetime
  bound can't be parenthesised (rustc rejects `('a)` too). The outer
  `for<..>` of a where predicate still goes to the bounds after
  a parenthesised one.
- Parse_TraitDef supertraits: `trait Sub: (Tr) + Copy {}`.
- Associated type bounds in generic arguments: `Iter<Item: (Tr)>`.

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/parse/paths.cpp b/src/parse/paths.cpp
index 4cb53864..9af6380e 100644
--- a/src/parse/paths.cpp
+++ b/src/parse/paths.cpp
@@ -291,7 +291,12 @@ AST::Path Parse_Path(TokenStream& lex, bool is_abs, eParsePathGenericMode generi
                     // TODO: Trait list instead of duplicating the name
                     for(;;)
                     {
+                        // In parentheses, as any trait bound (see Parse_TypeBound): `Iterator<Item: (Tr)>`
+                        bool is_paren = lex.getTokenIf(TOK_PAREN_OPEN);
                         traits.push_back( Parse_Path(lex, PATH_GENERIC_TYPE) );
+                        if( is_paren ) {
+                            GET_CHECK_TOK(tok, lex, TOK_PAREN_CLOSE);
+                        }
                         if(lex.lookahead(0) != TOK_PLUS)
                             break;
                         GET_CHECK_TOK(tok, lex, TOK_PLUS);
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 7330f26f..c50e1548 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -260,7 +260,10 @@ void Parse_TypeBound(TokenStream& lex, AST::GenericParams& ret, TypeRef checked_
         }
         is_first = false;
 
-        if( lex.getTokenIf(TOK_LIFETIME, tok) ) {
+        // A trait bound may be in parentheses: `F: (FnOnce(&Ctx) -> T)` (bindgen 0.72.1 ir/context.rs:984), `T: (?Sized)`,
+        // `(for<'a> Tr<'a>)` (not a lifetime bound)
+        bool is_paren = lex.getTokenIf(TOK_PAREN_OPEN);
+        if( !is_paren && lex.getTokenIf(TOK_LIFETIME, tok) ) {
             ret.add_bound(AST::GenericBound::make_TypeLifetime( {
                 checked_type.clone(), get_LifetimeRef(lex, mv$(tok))
                 } ));
@@ -285,12 +288,16 @@ void Parse_TypeBound(TokenStream& lex, AST::GenericParams& ret, TypeRef checked_
             }
             auto trait_path = Parse_Path(lex, PATH_GENERIC_TYPE);
 
-            auto this_outer_hrbs = (lex.lookahead(0) == TOK_PLUS ? AST::HigherRankedBounds(outer_hrbs) : mv$(outer_hrbs));
+            bool more_bounds = (is_paren ? lex.lookahead(0) == TOK_PAREN_CLOSE && lex.lookahead(1) == TOK_PLUS : lex.lookahead(0) == TOK_PLUS);
+            auto this_outer_hrbs = (more_bounds ? AST::HigherRankedBounds(outer_hrbs) : mv$(outer_hrbs));
             ret.add_bound( AST::GenericBound::make_IsTrait({
                 lex.end_span(ps),
                 mv$(this_outer_hrbs), checked_type.clone(), mv$(inner_hrls), mv$(trait_path)
                 }) );
         }
+        if( is_paren ) {
+            GET_CHECK_TOK(tok, lex, TOK_PAREN_CLOSE);
+        }
     } while( lex.getTokenIf(TOK_PLUS) );
 }
 
@@ -965,6 +972,11 @@ AST::Trait Parse_TraitDef(TokenStream& lex, AST::AttributeList& meta_items, AST:
                 break;
             }
             else {
+                // In parentheses, as any trait bound (see Parse_TypeBound): `trait Sub: (Tr) + Copy {}`
+                bool is_paren = (tok.type() == TOK_PAREN_OPEN);
+                if( is_paren ) {
+                    GET_TOK(tok, lex);
+                }
                 if( tok.type() == TOK_TILDE ) {
                     GET_CHECK_TOK(tok, lex, TOK_RWORD_CONST);
                     GET_TOK(tok, lex);
@@ -975,6 +987,9 @@ AST::Trait Parse_TraitDef(TokenStream& lex, AST::AttributeList& meta_items, AST:
                 PUTBACK(tok, lex);
                 auto hrbs = Parse_HRB_Opt(lex);
                 supertraits.push_back( GET_SPANNED(Type_TraitPath, lex, (Type_TraitPath(mv$(hrbs), Parse_Path(lex, PATH_GENERIC_TYPE)) )) );
+                if( is_paren ) {
+                    GET_CHECK_TOK(tok, lex, TOK_PAREN_CLOSE);
+                }
             }
         } while( GET_TOK(tok, lex) == TOK_PLUS );
     }
