From 08f04e3fd10820a2a64e33c2f418be5fad057909 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 12:05:57 +0000
Subject: [PATCH] codegen_c: each `caller_location` gets its own block

rfc2047-decoder 1.1.0 (py314-maturin 1.15.0) failed in the C compiler:

    librfc2047_decoder-1_1_0.rlib.c: In function 'ZRG2cP20rfc2047_decoder1_1_05lexer19encoded_word_parser0g':
    error: redefinition of 'mrustc_empty_caller_location'

The `caller_location` intrinsic (what `Location::caller()` is built on) is
emitted as a function-scope `static struct <Location>
mrustc_empty_caller_location = ..;` followed by the assignment of its
address. chumsky 0.12's `#[track_caller]` combinators, each ending in the
`#[inline]` `Location::caller()`, were inlined into encoded_word_parser,
which then defined the static twice. Each emission is now a C block of its
own; a block-scope static still lives for the whole program.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index d48d7c4d..5f6e9957 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -7333,7 +7333,8 @@ namespace {
             else if( name == "caller_location" ) {
                 //m_of << "abort()";
                 auto p = m_crate.get_lang_item_path_opt("panic_location");
-                m_of << "static struct ";
+                // In its own block: a function can use this more than once (e.g. after inlining `Location::caller()`)
+                m_of << "{ static struct ";
                 if( p == HIR::SimplePath() ) {
                     m_of << "s_ZRG2cE9core0_0_05panic8Location0g";
                 }
@@ -7342,7 +7343,7 @@ namespace {
                 }
                 m_of << " mrustc_empty_caller_location = {0,0,{\"\",0}};";
                 //m_of << " mrustc_empty_caller_location = {{\"\",0},0,0};";  // NOTE: Depends on the generated layout :(
-                emit_lvalue(e.ret_val); m_of << " = &mrustc_empty_caller_location"; // TODO: Hidden ABI for caller location
+                emit_lvalue(e.ret_val); m_of << " = &mrustc_empty_caller_location; }"; // TODO: Hidden ABI for caller location
             }
             // --- Pointer manipulation
             else if( name == "offset" ) {   // addition, with the reqirement that the resultant pointer be in bounds
