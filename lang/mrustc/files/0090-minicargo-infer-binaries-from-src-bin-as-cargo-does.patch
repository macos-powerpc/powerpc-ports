diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index 31743117..9ef382a6 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -15,6 +15,7 @@
 #include <set>
 #include "repository.h"
 #include "cfg.hpp"
+#include "os.hpp"   // list_directory
 
 // TODO: Extract this from the target at runtime (by invoking the compiler on the passed target)
 #ifdef _WIN32
@@ -399,14 +400,66 @@ PackageManifest PackageManifest::load_from_toml(const ::std::string& path, const
             rv.m_targets.push_back(PackageTarget { PackageTarget::Type::Lib });
         }
     }
-    // - If there's no binary section, but src/main.rs exists, add as a binary
-    if( rv.m_create_auto_bins && ! ::std::any_of(rv.m_targets.begin(), rv.m_targets.end(), [](const auto& x){ return x.m_type == PackageTarget::Type::Bin; }) )
+    // - Binaries, as cargo infers them: `src/main.rs` (named after the package), `src/bin/<name>.rs` and
+    //   `src/bin/<name>/main.rs`
     {
-        // No library, add one pointing to lib.rs
+        ::std::vector<PackageTarget>   inferred_bins;
         if( ::std::ifstream(package_dir / "src" / "main.rs").good() )
         {
-            DEBUG("- Implicit binary");
-            rv.m_targets.push_back(PackageTarget { PackageTarget::Type::Bin });
+            // Left unnamed, so it gets the default name below
+            inferred_bins.push_back(PackageTarget { PackageTarget::Type::Bin });
+            inferred_bins.back().m_path = ::helpers::path("src") / "main.rs";
+        }
+        ::std::vector<::std::string>    bin_dir_ents;
+        os_support::list_directory(package_dir / "src" / "bin", [&](const char* name){ bin_dir_ents.push_back(name); });
+        ::std::sort(bin_dir_ents.begin(), bin_dir_ents.end());  // Directory order isn't stable
+        for(const auto& ent : bin_dir_ents)
+        {
+            auto path = ::helpers::path("src") / "bin" / ent.c_str();
+            if( ent.size() > 3 && ent.compare(ent.size() - 3, 3, ".rs") == 0 ) {
+                inferred_bins.push_back(PackageTarget { PackageTarget::Type::Bin });
+                inferred_bins.back().m_name = ent.substr(0, ent.size() - 3);
+                inferred_bins.back().m_path = path;
+            }
+            else if( ::std::ifstream(package_dir / path / "main.rs").good() ) {
+                inferred_bins.push_back(PackageTarget { PackageTarget::Type::Bin });
+                inferred_bins.back().m_name = ent;
+                inferred_bins.back().m_path = path / "main.rs";
+            }
+        }
+        auto bin_name = [&](const PackageTarget& t)->const ::std::string& { return t.m_name == "" ? rv.m_name : t.m_name; };
+
+        // A `[[bin]]` with no path takes the path of the inferred binary with its name (before the fallback below)
+        bool has_explicit_bins = false;
+        for(auto& tgt : rv.m_targets)
+        {
+            if( tgt.m_type != PackageTarget::Type::Bin )
+                continue;
+            has_explicit_bins = true;
+            if( tgt.m_path == "" ) {
+                auto it = ::std::find_if(inferred_bins.begin(), inferred_bins.end(), [&](const PackageTarget& t){ return bin_name(t) == bin_name(tgt); });
+                if( it != inferred_bins.end() )
+                    tgt.m_path = it->m_path;
+            }
+        }
+        // Inferred binaries are added when there's no `[[bin]]`, and also alongside them from edition 2018 on (cargo
+        // only warns about them in 2015). One with the name or path of a `[[bin]]` is that binary, not another.
+        if( rv.m_create_auto_bins && (!has_explicit_bins || (rv.m_edition != Edition::Unspec && rv.m_edition != Edition::Rust2015)) )
+        {
+            for(auto& inf : inferred_bins)
+            {
+                bool is_explicit = ::std::any_of(rv.m_targets.begin(), rv.m_targets.end(), [&](const PackageTarget& t) {
+                    if( t.m_type != PackageTarget::Type::Bin )
+                        return false;
+                    // (`helpers::path` to compare with the separators normalised)
+                    return bin_name(t) == bin_name(inf) || (t.m_path != "" && ::helpers::path(t.m_path) == ::helpers::path(inf.m_path));
+                    });
+                if( !is_explicit )
+                {
+                    DEBUG("- Implicit binary " << bin_name(inf) << " (" << inf.m_path << ")");
+                    rv.m_targets.push_back(::std::move(inf));
+                }
+            }
         }
     }
     if( rv.m_targets.empty() )
diff --git a/tools/minicargo/os.cpp b/tools/minicargo/os.cpp
