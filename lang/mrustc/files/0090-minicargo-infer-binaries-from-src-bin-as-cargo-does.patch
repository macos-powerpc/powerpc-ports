--- a/tools/minicargo/os.cpp
+++ b/tools/minicargo/os.cpp
@@ -6,6 +6,7 @@
 #endif
 
 #include <iostream>
+#include <cstring>  // strcmp
 #include "os.hpp"
 #include "debug.h"
 
@@ -30,6 +31,7 @@ extern "C" {
 # include <spawn.h> // posix_spawn
 # include <sys/wait.h>  // waitpid
 # include <limits.h>    // PATH_MAX
+# include <dirent.h>    // opendir/readdir
 extern char **environ;
 }
 #endif
@@ -471,6 +473,31 @@ const helpers::path& get_mrustc_path()
     return s_compiler_path;
 }
 
+void list_directory(const helpers::path& path, ::std::function<void(const char*)> cb)
+{
+#ifdef _WIN32
+    WIN32_FIND_DATA find_data;
+    HANDLE find_handle = FindFirstFile( (path / "*").str().c_str(), &find_data );
+    if( find_handle == INVALID_HANDLE_VALUE )
+        return ;
+    do {
+        if( strcmp(find_data.cFileName, ".") != 0 && strcmp(find_data.cFileName, "..") != 0 )
+            cb(find_data.cFileName);
+    } while( FindNextFile(find_handle, &find_data) );
+    FindClose(find_handle);
+#else
+    auto* dp = opendir(path.str().c_str());
+    if( dp == nullptr )
+        return ;
+    while( const auto* dent = readdir(dp) )
+    {
+        if( strcmp(dent->d_name, ".") != 0 && strcmp(dent->d_name, "..") != 0 )
+            cb(dent->d_name);
+    }
+    closedir(dp);
+#endif
+}
+
 }
 
