     /// Shell-style pattern match: `*` matches any run of characters, `?` any single character
     bool glob_match(const char* pat, const char* s)
     {
@@ -279,7 +249,7 @@ int main(int argc, const char* argv[])
                     auto parent = (slash == ::std::string::npos ? ::std::string() : member.substr(0, slash));
                     auto pattern = member.substr(slash == ::std::string::npos ? 0 : slash + 1);
                     ::std::vector<::std::string>    matches;
-                    list_directory(parent.empty() ? dir : dir / parent.c_str(), [&](const char* name) {
+                    os_support::list_directory(parent.empty() ? dir : dir / parent.c_str(), [&](const char* name) {
