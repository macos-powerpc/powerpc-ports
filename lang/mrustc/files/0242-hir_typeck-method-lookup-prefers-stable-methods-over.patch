+{
+    // rustc (method/probe.rs `pick_core`) first probes every autoderef level without the unstable library methods of
+    // features the crate hasn't enabled, and only takes one of those when nothing else applies. Inherent methods won
+    // regardless here, so core 1.90's `#[unstable(feature = "str_as_str")] str::as_str(&self) -> &str` beat an in-scope
+    // trait's (shellexpand 3.1.1 funcs.rs:394 `match var_name.as_str() { Some(..) => .. }` with `WstrExt::as_str(&self)
+    // -> Option<&str>`: "Type mismatch between str and Option<_>"); so did `i32::div_floor` (num-integer's
+    // `Integer::div_floor(&self, &Self)`), and `Iterator::intersperse` shadowed itertools' through an `I: Iterator` bound.
+    bool skipped_unstable = false;
+    auto rv = autoderef_find_method_probe(sp, traits, ivars, val_ivars, top_ty, method_name, possibilities, defer_fuzzy_impls, out_deferred_on_fuzzy, &skipped_unstable);
+    if( rv == 0 && possibilities.empty() && skipped_unstable )
+    {
+        DEBUG("Only unstable methods apply, probing again with them");
+        rv = autoderef_find_method_probe(sp, traits, ivars, val_ivars, top_ty, method_name, possibilities, defer_fuzzy_impls, out_deferred_on_fuzzy, nullptr);
+    }
+    return rv;
+}
