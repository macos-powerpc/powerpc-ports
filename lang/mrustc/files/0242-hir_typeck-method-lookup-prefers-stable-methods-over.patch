@@ -873,7 +880,11 @@ namespace resolve_ufcs {
 
                 // TODO: Control ordering with a flag in UfcsUnknown
                 // 1. Search for applicable inherent methods (COMES FIRST!)
-                if( this->resolve_UfcsUnknown_inherent(m_cur_mod_path, p, pc, p.m_data) ) {
+                // - Except an unstable library method of a feature the crate hasn't enabled: as for method calls (see
+                //   `TraitResolution::autoderef_find_method`), rustc takes one only if nothing else applies, so
+                //   `str::as_str(s)` with shellexpand's `WstrExt` in scope is the trait's.
+                bool skipped_unstable = false;
+                if( this->resolve_UfcsUnknown_inherent(m_cur_mod_path, p, pc, p.m_data, &skipped_unstable) ) {
                     assert(!p.m_data.is_UfcsUnknown());
                     return ;
                 }
@@ -985,6 +996,12 @@ namespace resolve_ufcs {
                     }
                 }
 
