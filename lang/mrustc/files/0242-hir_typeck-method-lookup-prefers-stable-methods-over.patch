+/// The feature of an item's `#[unstable(feature = "..", ..)]`, empty for `#[stable(..)]`, `parent` for neither: an
+/// unannotated item inherits an unstable parent's stability (rustc stability.rs, `#[unstable] impl X { .. }`).
+/// The crate's own unstable features are always usable by it, so they go into its enabled list.
+static RcString LowerHIR_UnstableFeature(const ::AST::AttributeList& attrs, const RcString& parent)
+{
+    if( attrs.has("stable") )
+        return RcString();
+    const auto* a = attrs.get("unstable");
+    if( !a )
+        return parent;
+    // `(feature = "name", issue = "n", implied_by = "old", soft)`; anything unexpected leaves the item stable
+    RcString rv;
+    TTStream    lex(a->span(), ParseState(), a->data());
+    if( lex.getTokenIf(TOK_PAREN_OPEN) ) {
+        while( lex.lookahead(0) == TOK_IDENT ) {
+            auto name = lex.getToken().ident().name;
+            if( lex.getTokenIf(TOK_EQUAL) ) {
+                auto tok = lex.getToken();
+                if( name == "feature" && tok.type() == TOK_STRING )
+                    rv = RcString::new_interned(tok.str());
+            }
+            if( !lex.getTokenIf(TOK_COMMA) )
+                break;
+        }
+    }
+    if( rv != "" )
+        g_crate_ptr->m_enabled_features.insert(rv);
+    return rv;
+}
+
+::HIR::Function LowerHIR_Function(::HIR::ItemPath p, const ::AST::AttributeList& attrs, const ::AST::Function& f, const ::HIR::TypeRef& real_self_type, const RcString& parent_unstable)
 {
     static Span sp;
 
