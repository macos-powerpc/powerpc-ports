             ::std::map< RcString, ::HIR::TypeImpl::VisImplEnt< ::HIR::Constant> > constants;
+            // `#[unstable]` on the block applies to the methods without a stability attribute of their own
+            const auto impl_unstable = LowerHIR_UnstableFeature(i->attrs, RcString());
 
             for(const auto& item : impl.items())
             {
@@ -2462,7 +2496,7 @@ void LowerHIR_Module_Impls(const ::AST::Module& ast_mod,  ::HIR::Crate& hir_crat
                     }
                 TU_ARMA(Function, e) {
                     methods.insert( ::std::make_pair(item.name, ::HIR::TypeImpl::VisImplEnt< ::HIR::Function> {
-                        get_vis(item.vis), item.is_specialisable, LowerHIR_Function(item_path, item.attrs, e, type)
+                        get_vis(item.vis), item.is_specialisable, LowerHIR_Function(item_path, item.attrs, e, type, impl_unstable)
                         } ) );
                     }
                 }
@@ -2545,6 +2579,19 @@ public:
     g_ast_crate_ptr = &crate;
     g_crate_name = rv.m_crate_name;
     g_core_crate = crate.m_ext_cratename_core;
+
+    // `#![feature(..)]`: unstable library methods of these features take part in method lookup like stable ones
+    // - Every identifier in the list, anything else skipped (the attribute was never checked before)
+    for(const auto& a : crate.m_attrs.m_items)
+    {
+        if( a.name() == "feature" ) {
+            TTStream    lex(a.span(), ParseState(), a.data());
+            for(auto tok = lex.getToken(); tok.type() != TOK_EOF; tok = lex.getToken()) {
+                if( tok.type() == TOK_IDENT )
+                    rv.m_enabled_features.insert(tok.ident().name);
+            }
+        }
+    }
     auto macros = std::map<RcString, HIR::MacroItem>();
     //auto& macros = rv.m_exported_macros;
 
