From 931de4ddb0ec7a862d5f8a263e832e75d8e08ae3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 7 Nov 2026 08:29:39 +0000
Subject: [PATCH] parse: outer attributes on a closure parameter

arti 2.7.0 cfg.rs:1164 `let filter_examples = |#[allow(unused_mut)] mut
examples: ExampleSectionLines| -> _ { .. };`: `error:0: Unexpected
token TOK_HASH`.

A closure parameter may carry outer attributes like a function
parameter; the closure parser went straight to the pattern. The
attributes are now read and dropped: lint attributes mean nothing here,
and a `#[cfg]` on a closure parameter is not honoured (nothing has
needed it).

Assisted-by: Claude Fable 5.1
---

diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index 75c7620a..395c854f 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -1359,6 +1359,9 @@ ExprNodeP Parse_ExprVal_Closure(TokenStream& lex, bool is_async = false)
         // `|...|` - Arguments present
         while( !lex.getTokenIf(TOK_PIPE, tok) )
         {
+            // Outer attributes on a closure parameter, as on a function's: `|#[allow(unused_mut)] mut examples: Lines|`
+            // (arti 2.7.0 cfg.rs:1164). Lint attributes mean nothing here; a `#[cfg]` is not honoured.
+            Parse_ItemAttrs(lex);
             // Irrefutable pattern
             AST::Pattern    pat = Parse_Pattern(lex, AllowOrPattern::No);
 
