From 60c6a92f534b831f3cda4046db918d69f6cc5eec Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 5 Nov 2026 20:37:27 +0000
Subject: [PATCH 432/433] hir_typeck: a pattern names the type behind the
 derefs of an `&_` scrutinee

derive-deftly-macros 1.12.0 (arti 2.7.0) expand.rs:718: "BUG:
src/hir_typeck/expr_cs.cpp:9094: Spare rules left after typecheck stabilised"
(four MatchErgonomicsRevisit rules on `&_`, the `Definitions<'c>:
AsRef<[&'c Definition<_>]>` bound and two method calls on the arm bindings).

`let (def, ctx) = ctx.find_definition(self)?.ok_or_else(..)?;` leaves `def:
&Definition<B>` with `B` an ivar: the method's bound has two impls
(DefinitionBody and DefCondBody), so only the match `match &def.body {
DefinitionBody::Paste(content) => .. }` can name it. The revisit computes
a possible type from the pattern (the enum) once the scrutinee's borrows are
counted (one deref here), then unwrapped that type once per deref - right for
a string literal pattern, whose `&str` includes the borrow the scrutinee level
is, but an enum/struct/tuple/array pattern's type is the type BEHIND the
derefs (rustc's peel_off_references); the unwrap found no borrow, gave up,
and the ivar never got its possibility (`check_ivar_poss: 75: No rules`).

Only a borrow possible type is unwrapped now; anything else is offered as is.
Still a possibility (UnsizeTo), not an equate, as for the no-deref case.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 74b3db2a..808671c5 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -3082,13 +3082,21 @@ void Context::handle_pattern(const Span& sp, ::HIR::Pattern& pat, const ::HIR::T
                     {
                         DEBUG("n_deref = " << n_deref << ", possible_type = " << possible_type);
                         const ::HIR::TypeRef* possible_type_p = &possible_type;
-                        // Unwrap borrows as many times as we've already dereferenced
-                        for(size_t i = 0; i < n_deref && possible_type_p; i ++) {
-                            if( const auto* te = possible_type_p->data().opt_Borrow() ) {
-                                possible_type_p = &te->inner;
-                            }
-                            else {
-                                possible_type_p = nullptr;
+                        // A string pattern's `&str` includes the borrow a dereferenced scrutinee level is: unwrap one
+                        // per deref. Every other pattern names the type behind the derefs (an enum pattern on `&_`
+                        // makes `_` the enum, rustc's peel_off_references), and peeling that dropped the only hint the
+                        // ivar had: derive-deftly-macros 1.12.0 expand.rs:723 `match &def.body { DefinitionBody::Paste(c)
+                        // => ..` with `def: &Definition<B>` from a lookup bounded `Definitions<'c>: AsRef<[&'c
+                        // Definition<B>]>` (two impls, arti 2.7.0)
+                        if( possible_type.data().is_Borrow() )
+                        {
+                            for(size_t i = 0; i < n_deref && possible_type_p; i ++) {
+                                if( const auto* te = possible_type_p->data().opt_Borrow() ) {
+                                    possible_type_p = &te->inner;
+                                }
+                                else {
+                                    possible_type_p = nullptr;
+                                }
                             }
                         }
                         if( possible_type_p )
