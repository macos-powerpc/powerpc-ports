From 3d89c0f3db39ce7ecc8751a25e4fa8bf183ee435 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 19:47:33 +0000
Subject: [PATCH] hir_typeck: an overriding impl's hidden `impl Trait` type
 comes from its method, not the trait's default

A trait method returning `impl Trait` gets a hidden `erased#<method>_<n>`
associated type. When the method has a default body, the trait gives
that hidden type the default body's type as its default. An impl only
receives its own entry after typeck (hir_expand/vtable.cpp); until then
ImplRef::get_type fills the gap, and it took the trait's default before
looking at the impl's overriding method. With the trait in another crate
the method's signature names the hidden type, so Typecheck Outer's
signature check expanded it to the default body's type and rejected
every override, `async fn`, `impl Trait` or concrete:

  tower-lsp-server 0.23.0 server.rs (the `rpc!` macro):
    fn code_action(&self, params: CodeActionParams)
        -> impl Future<Output = Result<Option<CodeActionResponse>>> + Send { async { .. } }
  ast-grep-lsp 0.45.3 lib.rs:197:
    async fn code_action(&self, params: CodeActionParams) -> Result<Option<CodeActionResponse>> { .. }

  <null> error:0: Method code_action doesn't match trait:
  - Mismatched return type:
    Expected ::"tower_lsp_server-0_23_0_H6400"::server::future#code_action_234
    Found    impl Future<Output = Result<..>>+use<'M0,'M0,>

A call on the concrete type during typeck would have seen the default's
type as well. The impl method's return type is now consulted first;
the default only applies to an impl that does not override the method.
Traits in the same crate are unaffected (the trait still holds the
ErasedType during typeck).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
diff --git a/src/hir_typeck/impl_ref.cpp b/src/hir_typeck/impl_ref.cpp
index f4878050..e5f797da 100644
--- a/src/hir_typeck/impl_ref.cpp
+++ b/src/hir_typeck/impl_ref.cpp
@@ -334,19 +334,12 @@ namespace {
         if( it == e.impl->m_types.end() )
         {
             static const HIR::TypeRef ty_self = ::HIR::TypeRef::new_self();
-            if( e.trait_ptr->m_types.count(name) && e.trait_ptr->m_types.at(name).m_default != HIR::TypeRef() ) {
-                const auto& aty_def = e.trait_ptr->m_types.at(name);
-                // Monomorph twice, first from trait to trait impl, second from trait impl to current
-                // - The default's own generics (group 1: a GAT's, or for a default method's hidden `erased#` type the
-                //   method's, such as the `'M0` of `&self`) stay as they are for the second step to map to `params`.
-                //   With no method params at all here: ast-grep-core 0.45.3 `trait SgNode<'r> { fn named_children(&self)
-                //   -> impl Iterator<Item = Self> { .. } }` -> Trans Enumerate "Method lifetime parameters were not
-                //   expected (got /*M:0*/)"
-                auto aty_nop = aty_def.m_generics.make_nop_params(1);
-                auto def = MonomorphStatePtr(&ty_self, &e.impl->m_trait_args, &aty_nop).monomorph_type(sp, aty_def.m_default);
-                return this->get_cb_monomorph_traitimpl(sp, params).monomorph_type(sp, def);
-            }
             // A hidden `erased#<method>_<n>` type (see `find_erased_slot`): take it from the impl method's return type
+            // - Before the trait's default: when the trait method has a body, the hidden type has that body's type as its
+            //   default, which is only right for impls that don't override the method. tower-lsp-server 0.23.0 default
+            //   `fn code_action(..) -> impl Future<..> + Send { async { .. } }` overridden by ast-grep-lsp 0.45.3 with
+            //   an `async fn` -> "Method code_action doesn't match trait: Mismatched return type: Expected
+            //   tower_lsp_server::server::future#code_action_234 Found impl Future<..>"
             if( ::std::strncmp(name, ATY_PREFIX_ERASED, ::std::strlen(ATY_PREFIX_ERASED)) == 0 )
             {
                 ::std::string   n(name + ::std::strlen(ATY_PREFIX_ERASED));
@@ -369,6 +362,18 @@ namespace {
                     }
                 }
             }
+            if( e.trait_ptr->m_types.count(name) && e.trait_ptr->m_types.at(name).m_default != HIR::TypeRef() ) {
+                const auto& aty_def = e.trait_ptr->m_types.at(name);
+                // Monomorph twice, first from trait to trait impl, second from trait impl to current
+                // - The default's own generics (group 1: a GAT's, or for a default method's hidden `erased#` type the
+                //   method's, such as the `'M0` of `&self`) stay as they are for the second step to map to `params`.
+                //   With no method params at all here: ast-grep-core 0.45.3 `trait SgNode<'r> { fn named_children(&self)
+                //   -> impl Iterator<Item = Self> { .. } }` -> Trans Enumerate "Method lifetime parameters were not
+                //   expected (got /*M:0*/)"
+                auto aty_nop = aty_def.m_generics.make_nop_params(1);
+                auto def = MonomorphStatePtr(&ty_self, &e.impl->m_trait_args, &aty_nop).monomorph_type(sp, aty_def.m_default);
+                return this->get_cb_monomorph_traitimpl(sp, params).monomorph_type(sp, def);
+            }
             return ::HIR::TypeRef();
         }
         const ::HIR::TypeRef& tpl_ty = it->second.data;
