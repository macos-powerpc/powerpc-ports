From f9c73d76c92dc0d4284384b853d12b522be64651 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 17:03:50 +0000
Subject: [PATCH] expand: `true` and `false` are cfg predicates

rustc 1.90 tests/ui, parse-only run:

    cfg/cfg-macros-notfoo.rs, cfg/conditional-compile.rs
        #[cfg(false)]
    parser/stripped-nested-outline-mod-pass.rs
        #[cfg(false)] mod foo { mod bar { mod baz; } }
    error: Unexpected token TOK_RWORD_FALSE, expected TOK_IDENT

Reference, Conditional compilation: ConfigurationPredicate is
`ConfigurationOption | ConfigurationAll | ConfigurationAny |
ConfigurationNot | true | false` (boolean literals stable since 1.88).

check_cfg_inner (expand/cfg.cpp) required an identifier. It now
answers a `true` / `false` token directly. Every cfg evaluation goes
through it: `#[cfg]`, `any()` / `all()` / `not()`, `cfg_attr(..)`,
`cfg!(..)`, and the parser's check before loading an outline module.

The third test then failed with "Can't find file for 'baz'":
a cfg-disabled inline module disabled the loading of its direct
`mod x;` children only, because each nested inline module recomputed
the flag from its own attributes. The flag is now inherited, so no
outline module below a disabled one is loaded at any depth.

Grammar copies: the cfg evaluator is the only one; attributes reach it
as token trees from the parser, the macro_rules skimmer and proc-macro
output alike.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/expand/cfg.cpp b/src/expand/cfg.cpp
index afea30e6..d25d9cb9 100644
--- a/src/expand/cfg.cpp
+++ b/src/expand/cfg.cpp
@@ -55,6 +55,11 @@ namespace {
             auto ilex = TTStream(meta.span(), ParseState(), meta.data());
             return check_cfg_inner1(meta.name().as_trivial(), ilex);
         }
+        else if( lex.lookahead(0) == TOK_RWORD_TRUE || lex.lookahead(0) == TOK_RWORD_FALSE )
+        {
+            // A boolean literal predicate: `cfg(false)`, `any(true, ..)` (stable since 1.88)
+            return lex.getToken().type() == TOK_RWORD_TRUE;
+        }
         else
         {
             auto name = lex.getTokenCheck(TOK_IDENT).ident().name;
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index bc372890..00a5b810 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -2678,9 +2678,8 @@ namespace {
             // - interprocess 2.4.4 local_socket.rs `mod stream { pub(super) mod r#enum; }`: looked for
             //   `local_socket/stream/stream/enum.rs` -> "Can't find file for 'enum'"
             submod.m_file_info.controls_dir = true;
-            submod.m_file_info.is_disabled = !H::check_item_cfg(meta_items);
-            // TODO: If cfg fails, just eat the TT until a matching #[cfg]?
-            // - Or, mark the file infor as not being valid (so child modules don't try to load)
+            // A cfg-disabled module disables the outline modules nested in it at any depth
+            submod.m_file_info.is_disabled = mod_fileinfo.is_disabled || !H::check_item_cfg(meta_items);
             Parse_ModRoot(lex, submod, meta_items);
             GET_CHECK_TOK(tok, lex, TOK_BRACE_CLOSE);
             break;
diff --git a/src/version.cpp b/src/version.cpp
index 37a38bae..3fb43b77 100644
--- a/src/version.cpp
+++ b/src/version.cpp
@@ -13,7 +13,7 @@
 #define VERSION_PATCH   0
 
 // Number of the last patch in this fork's series: every fix commit bumps it
-#define VERSION_SERIES  469
+#define VERSION_SERIES  470
 // rlibs written by an older series are refused (0 = accept all)
 #define VERSION_SERIES_FLOOR    0
 
