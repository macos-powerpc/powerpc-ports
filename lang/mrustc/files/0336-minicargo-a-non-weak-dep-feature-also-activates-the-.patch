From db7840cccd264f1379bd40d92b35ea7adb4c83b1 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 13:37:46 +0000
Subject: [PATCH] minicargo: a non-weak `dep/feature` also activates the package's own
 feature named after the optional dependency

num@0.4.3 (pqrs 0.3.2) src/lib.rs:68 `pub use num_rational::BigRational`: "Unable to resolve `use` target
::num_rational::BigRational". num's `std` asks for `num-rational/num-bigint-std`; num-rational 0.4.2 defines
`num-bigint-std = ["num-bigint/std"]` and an explicit `num-bigint = ["dep:num-bigint"]`, and `BigRational` is
`#[cfg(feature = "num-bigint")]`. cargo's activate_dep_feature: a non-weak `dep/feat` on an optional dependency
enables the dependency AND, if the package has a feature of the dependency's name (implicit or explicit), that
feature (`feature_map.contains_key(&dep_name)`). minicargo only did it for the implicit one, so num-rational was built
without `feature="num-bigint"`.

tools/minicargo/manifest.cpp activate_dep_feature: the feature is also activated when it is explicit (a non-empty
`[features]` entry; every optional dependency gets an empty placeholder entry of its name while the manifest is read,
so an empty entry means "no such feature", as for a `dep:`-referenced dependency whose name is no feature).

Assisted-By: Claude Fable 5.1
---

diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index 93a227c9..7e81b690 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -1390,8 +1390,11 @@ void PackageManifest::set_features(const ::std::vector<::std::string>& features,
     // `<dep>/<feature>` (`<dep>?/<feature>`: only if the dependency is enabled otherwise): a dependency's feature,
     // from a feature list or requested directly - as maturin does (`--features pyo3/extension-module`), or a dependency
     // declaration's `features = [..]`. Returns false for a plain feature name.
-    // - As cargo: the non-weak form also turns an optional `<dep>` on, with its implicit feature `<dep>` if it has one;
-    //   a plain dependency gets no feature of its name.
+    // - As cargo: the non-weak form also turns an optional `<dep>` on, together with a feature named `<dep>` if the
+    //   package has one (the implicit one, or an explicit `<dep> = ["dep:<dep>"]`: cargo's activate_dep_feature checks
+    //   `feature_map.contains_key(&dep_name)`); a plain dependency gets no feature of its name. num-rational 0.4.2's
+    //   `num-bigint-std = ["num-bigint/std"]` must switch its `num-bigint = ["dep:num-bigint"]` on, which gates
+    //   `BigRational` (num 0.4.3 `pub use num_rational::BigRational` under pqrs 0.3.2: "Unable to resolve `use` target").
     auto activate_dep_feature = [&](const ::std::string& sub_feat)->bool {
         auto slash_pos = sub_feat.find('/');
         if( slash_pos == ::std::string::npos ) {
@@ -1406,7 +1409,10 @@ void PackageManifest::set_features(const ::std::vector<::std::string>& features,
         ::std::string depfeat = sub_feat.substr(slash_pos+1);
         DEBUG("Activate feature '" << depfeat << "' from dependency '" << depname << "'");
         if( !weak ) {
-            if( m_implicit_dep_features.count(depname) ) {
+            // (every optional dependency gets an empty placeholder entry of its name while the manifest is read, so
+            // an empty entry is "no such feature": the implicit one holds `dep:<dep>`, an explicit one is never empty)
+            auto feat_it = m_features.find(depname);
+            if( m_implicit_dep_features.count(depname) || (feat_it != m_features.end() && !feat_it->second.empty()) ) {
                 add_feature(depname);
             }
             enable_dep(depname);
