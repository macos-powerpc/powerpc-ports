     bool    m_type_annotated = false;
+    /// `super let`: the bindings live (and drop) with the enclosing block, not the block they appear in
+    bool    m_super = false;
 
     ExprNode_Let(Span sp, ::HIR::Pattern pat, ::HIR::TypeRef ty, ::HIR::ExprNodeP val):
         ExprNode(mv$(sp)),
