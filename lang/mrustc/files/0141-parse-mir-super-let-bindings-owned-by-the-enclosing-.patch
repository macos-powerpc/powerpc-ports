     }
 
diff --git a/src/hir/expr.hpp b/src/hir/expr.hpp
index 6f30ae9c..3178b743 100644
--- a/src/hir/expr.hpp
+++ b/src/hir/expr.hpp
@@ -249,6 +249,8 @@ struct ExprNode_Let:
     /// The type was written in the source (`let x: T = v;`), making `v` a coercion site - so a `&mut` is reborrowed
