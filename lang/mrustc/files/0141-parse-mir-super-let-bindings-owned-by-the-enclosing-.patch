+++ b/src/mir/mir_builder.cpp
@@ -164,9 +164,10 @@ const ::HIR::TypeRef* MirBuilder::is_type_owned_box(const ::HIR::TypeRef& ty) co
     }
 }
 
-void MirBuilder::define_variable(unsigned int idx)
+void MirBuilder::define_variable(unsigned int idx, bool in_parent_scope)
 {
-    DEBUG("DEFINE (var) _" << idx  << ": " << m_output.locals.at(idx));
+    DEBUG("DEFINE (var) _" << idx  << ": " << m_output.locals.at(idx) << (in_parent_scope ? " (super)" : ""));
+    bool skip_one = in_parent_scope;
     for( auto scope_idx : ::reverse(m_scope_stack) )
     {
         auto& scope_def = m_scopes.at(scope_idx);
@@ -176,6 +177,11 @@ void MirBuilder::define_variable(unsigned int idx)
         (Owning,
             if( !e.is_temporary )
             {
+                if( skip_one ) {
+                    // `super let`: the block's own variable scope is skipped, the enclosing one owns the variable
+                    skip_one = false;
+                    continue;
+                }
                 auto it = ::std::find(e.slots.begin(), e.slots.end(), idx);
                 assert(it == e.slots.end());
                 e.slots.push_back( idx );
diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index 709d2e36..da093b57 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -29,7 +29,7 @@ ExprNodeP Parse_ExprBlockNode(TokenStream& lex, AST::ExprNode_Block::Type ty, Id
 //ExprNodeP Parse_ExprBlockLine(TokenStream& lex, bool *add_silence);
 ExprNodeP Parse_ExprBlockLine_Stmt(TokenStream& lex, bool& has_semicolon);
 //ExprNodeP Parse_Stmt(TokenStream& lex);   // common.hpp
-ExprNodeP Parse_Stmt_Let(TokenStream& lex);
+ExprNodeP Parse_Stmt_Let(TokenStream& lex, bool is_super = false);
 ExprNodeP Parse_Expr0(TokenStream& lex);
 ExprNodeP Parse_Expr1_5(TokenStream& lex);  // Boolean OR
 ExprNodeP Parse_Expr3(TokenStream& lex);
@@ -289,6 +289,10 @@ ExprNodeP Parse_ExprBlockLine(TokenStream& lex, bool *add_silence)
         case TOK_RWORD_SUPER:
         case TOK_DOUBLE_COLON:
         case TOK_RWORD_SELF:
+            // `super let x = ..;` (unstable `super_let`, used by core's `pin!` since 1.90) is a statement, not a path
+            if( tok.type() == TOK_RWORD_SUPER && lex.lookahead(0) == TOK_RWORD_LET ) {
+                break;
+            }
             if(tok.type() != TOK_RWORD_SELF || lex.lookahead(0) == TOK_DOUBLE_COLON) {
                 PUTBACK(tok, lex);
                 auto p = Parse_Path(lex, PATH_GENERIC_EXPR);
@@ -337,6 +341,12 @@ ExprNodeP Parse_ExprBlockLine(TokenStream& lex, bool *add_silence)
             ret = Parse_Stmt_Let(lex);
             GET_CHECK_TOK(tok, lex, TOK_SEMICOLON);
             return ret;
+        // `super let`: the binding belongs to the enclosing block (see ExprNode_LetBinding::m_is_super)
+        case TOK_RWORD_SUPER:
+            GET_CHECK_TOK(tok, lex, TOK_RWORD_LET);
+            ret = Parse_Stmt_Let(lex, /*is_super=*/true);
+            GET_CHECK_TOK(tok, lex, TOK_SEMICOLON);
+            return ret;
 
         // Blocks that don't need semicolons
         // NOTE: If these are followed by a small set of tokens (`.` and `?`) then they are actually the start of an expression
@@ -704,6 +714,13 @@ ExprNodeP Parse_Stmt(TokenStream& lex)
     // Duplicated here for the :stmt pattern fragment.
     case TOK_RWORD_LET:
         return Parse_Stmt_Let(lex);
+    case TOK_RWORD_SUPER:
+        if( lex.lookahead(0) == TOK_RWORD_LET ) {
+            GET_TOK(tok, lex);
+            return Parse_Stmt_Let(lex, /*is_super=*/true);
+        }
+        PUTBACK(tok, lex);
+        return Parse_Expr0(lex);
     case TOK_RWORD_YIELD:
         return Parse_FlowControl(lex, AST::ExprNode_Flow::YIELD);
     case TOK_RWORD_CONTINUE:
@@ -734,7 +751,7 @@ ExprNodeP Parse_Stmt(TokenStream& lex)
     }
 }
 
-ExprNodeP Parse_Stmt_Let(TokenStream& lex)
+ExprNodeP Parse_Stmt_Let(TokenStream& lex, bool is_super)
 {
     Token   tok;
     AST::Pattern pat = Parse_Pattern(lex, AllowOrPattern::Yes);   // irrefutable
@@ -750,7 +767,7 @@ ExprNodeP Parse_Stmt_Let(TokenStream& lex)
             else_arm = Parse_ExprBlockNode(lex);
         }
     }
-    return NEWNODE( AST::ExprNode_LetBinding, ::std::move(pat), mv$(type), ::std::move(val), ::std::move(else_arm) );
+    return NEWNODE( AST::ExprNode_LetBinding, ::std::move(pat), mv$(type), ::std::move(val), ::std::move(else_arm), is_super );
 }
 
