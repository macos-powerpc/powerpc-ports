+void DumpAST_Item(::std::ostream& os, const AST::Named<AST::Item>& item)
+{
+    // The printer works on modules: one holding a copy of the item
+    AST::Module mod { AST::AbsolutePath() };
+    mod.add_item( AST::Named<AST::Item>( item.span, item.attrs.clone(), item.vis, item.name, item.data.clone() ) );
+    RustPrinter p { os, false };
+    p.handle_module(mod);
+}
