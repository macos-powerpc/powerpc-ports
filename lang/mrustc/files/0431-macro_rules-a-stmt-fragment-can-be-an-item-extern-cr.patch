+    /// Does this statement start with an item? (the block parser's rule, Parse_ExprBlockLine_WithItems)
+    bool stmt_is_item(const TokenStreamRO& lex_in)
+    {
+        auto lex = lex_in.clone();
+        // Outer attributes
+        while( lex.next() == TOK_HASH )
+        {
+            lex.consume();
+            if( !consume_tt(lex) )
+                return false;
+        }
+        switch(lex.next())
+        {
+        case TOK_INTERPOLATED_ITEM:
+        case TOK_INTERPOLATED_VIS:
+        case TOK_RWORD_PUB:
+        case TOK_RWORD_TYPE:
+        case TOK_RWORD_USE:
+        case TOK_RWORD_EXTERN:
+        case TOK_RWORD_STATIC:
+        case TOK_RWORD_STRUCT:
+        case TOK_RWORD_ENUM:
+        case TOK_RWORD_TRAIT:
+        case TOK_RWORD_IMPL:
+        case TOK_RWORD_FN:
+        case TOK_RWORD_MOD:
+            return true;
+        // `crate::path` starts an expression
+        case TOK_RWORD_CRATE:
+            lex.consume();
+            return lex.next() != TOK_DOUBLE_COLON;
+        // `const { .. }` and `unsafe { .. }` are blocks
+        case TOK_RWORD_CONST:
+        case TOK_RWORD_UNSAFE:
+            lex.consume();
+            return lex.next() != TOK_BRACE_OPEN;
+        // `async [unsafe] fn` is an item, `async [move] { .. }` an expression
+        case TOK_RWORD_ASYNC:
+            lex.consume();
+            return lex.next() == TOK_RWORD_FN || lex.next() == TOK_RWORD_UNSAFE;
+        case TOK_IDENT:
+            if( lex.next_tok().ident().name == "union" ) {
+                lex.consume();
+                return lex.next() == TOK_IDENT;
+            }
+            if( lex.next_tok().ident().name == "auto" ) {
+                lex.consume();
+                return lex.next() == TOK_RWORD_TRAIT;
+            }
+            return false;
+        default:
+            return false;
+        }
+    }
