+/// Does the statement at the cursor (after its attributes) start with an item? The block parser's rule
+/// (Parse_ExprBlockLine_WithItems), for a `stmt` fragment that is one
+static bool Macro_StmtIsItem(TokenStream& lex)
+{
+    Token   tok;
+    GET_TOK(tok, lex);
+    auto next = lex.lookahead(0);
+    // (PUTBACK moves the token)
+    const auto ty = tok.type();
+    const bool is_union = (ty == TOK_IDENT && tok.ident().name == "union");
+    const bool is_auto = (ty == TOK_IDENT && tok.ident().name == "auto");
+    PUTBACK(tok, lex);
+    switch(ty)
+    {
+    case TOK_INTERPOLATED_ITEM:
+    case TOK_INTERPOLATED_VIS:
+    case TOK_RWORD_PUB:
+    case TOK_RWORD_TYPE:
+    case TOK_RWORD_USE:
+    case TOK_RWORD_EXTERN:
+    case TOK_RWORD_STATIC:
+    case TOK_RWORD_STRUCT:
+    case TOK_RWORD_MACRO:
+    case TOK_RWORD_ENUM:
+    case TOK_RWORD_TRAIT:
+    case TOK_RWORD_IMPL:
+    case TOK_RWORD_FN:
+    case TOK_RWORD_MOD:
+        return true;
+    case TOK_RWORD_CRATE:
+        return next != TOK_DOUBLE_COLON;
+    case TOK_RWORD_CONST:
+    case TOK_RWORD_UNSAFE:
+        return next != TOK_BRACE_OPEN;
+    case TOK_RWORD_ASYNC:
+        return next == TOK_RWORD_FN || next == TOK_RWORD_UNSAFE;
+    case TOK_IDENT:
+        return (is_union && next == TOK_IDENT) || (is_auto && next == TOK_RWORD_TRAIT);
+    default:
+        return false;
+    }
+}
