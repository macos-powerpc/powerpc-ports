From 6ac97694857c4ed6349a121792e01757d22e0826 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 19:20:03 +0000
Subject: [PATCH] ast/dump: attributes on call arguments and tuple/array
 elements reach attribute proc macros

maturin 1.15.0 (py314-maturin) src/build_context/builder.rs:199, inside `#[instrument(skip_all)] pub fn build(self)`:
    resolve_platform_tags(.., &mut pyproject_toml_maturin_options, #[cfg(feature = "zig")] build_options.platform.zig)
failed with
    builder.rs:77:18-28 error:0: Incorrect number of arguments to ..::resolve_platform_tags - exp 5 got 6
(77:18-28 = the `#[instrument(skip_all)]` attribute: the body was re-lexed from the macro's output).

A function body reaches an attribute proc macro through the AST dumper (DumpAST_Node), and the dumper printed
call/method/closure-call arguments and tuple/array elements without their attributes, so a `#[cfg]`'d-out argument
came back from tracing-attributes unconditional. Now each list element prints its attributes inline (expand still
evaluates the `#[cfg]` after the macro, as for statements, match arms and struct literal fields).

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/ast/dump.cpp b/src/ast/dump.cpp
index 4083e739..be864000 100644
--- a/src/ast/dump.cpp
+++ b/src/ast/dump.cpp
@@ -243,6 +243,17 @@ public:
         }
         AST::NodeVisitor::visit(n.m_value);
     }
+    // An element of an argument/tuple/array list, with its attributes: this text becomes an attribute proc macro's
+    // input (DumpAST_Node), where a `#[cfg]` element sent bare would be kept unconditionally
+    // - maturin 1.15.0 build_context/builder.rs `resolve_platform_tags(.., #[cfg(feature = "zig")] build_options.platform.zig)`
+    //   in an `#[instrument]` method
+    void visit_list_elem(AST::ExprNodeP& node) {
+        for(const auto& a : node->attrs().m_items)
+        {
+            m_os << "#[" << a << "] ";
+        }
+        AST::NodeVisitor::visit(node);
+    }
     virtual void visit(AST::ExprNode_CallPath& n) override {
         m_expr_root = false;
         m_os << n.m_path;
@@ -255,7 +266,7 @@ public:
             } else {
                 m_os << ", ";
             }
-            AST::NodeVisitor::visit(arg);
+            visit_list_elem(arg);
         }
         m_os << ")";
     }
@@ -276,7 +287,7 @@ public:
             } else {
                 m_os << ", ";
             }
-            AST::NodeVisitor::visit(arg);
+            visit_list_elem(arg);
         }
         m_os << ")";
     }
@@ -293,7 +304,7 @@ public:
             } else {
                 m_os << ", ";
             }
-            AST::NodeVisitor::visit(arg);
+            visit_list_elem(arg);
         }
         m_os << ")";
     }
@@ -667,7 +678,7 @@ public:
         else {
             for( auto& item : n.m_values )
             {
-                AST::NodeVisitor::visit(item);
+                visit_list_elem(item);
                 m_os << ", ";
             }
         }
@@ -678,7 +689,7 @@ public:
         m_os << "(";
         for( auto& item : n.m_values )
         {
-            AST::NodeVisitor::visit(item);
+            visit_list_elem(item);
             m_os << ", ";
         }
         m_os << ")";
