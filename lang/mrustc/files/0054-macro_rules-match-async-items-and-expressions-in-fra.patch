From 4e2a5469181dff720c5797d2dbd36713f0956736 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 08:23:11 +0000
Subject: [PATCH 54/59] macro_rules: match `async` items and expressions in
 fragments

The token-level fragment matcher had no notion of `async`/`await`, so
these failed to match even though the parser accepts them:

- `:item` - `async fn` / `async unsafe fn` (tokio 1.10.1 wraps
  `pub async fn copy(..)` in `cfg_io_util! { $($item:item)* }`, which
  failed with "No arm matched")
- `:expr` - `async [move] { .. }` blocks and the `.await` postfix
- `:item` - `const extern "C" fn`: the `const` arm skipped `extern` but
  not its ABI string

Async closures (`async |x| ..`) are left alone, the expression parser
doesn't support them yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/macro_rules/eval.cpp | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index bdebda9e..469dbd12 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -1308,6 +1308,13 @@ namespace
             case TOK_TRIPLE_DOT:
                 break;
 
+            case TOK_RWORD_ASYNC:
+                lex.consume();
+                lex.consume_if(TOK_RWORD_MOVE);
+                if(lex.next() != TOK_BRACE_OPEN )
+                    return false;
+                consume_tt(lex);
+                break;
             case TOK_RWORD_UNSAFE:
                 lex.consume();
                 if(lex.next() != TOK_BRACE_OPEN )
@@ -1416,6 +1423,8 @@ namespace
                     }
                     else if( lex.consume_if(TOK_INTEGER) )
                         ;
+                    else if( lex.consume_if(TOK_RWORD_AWAIT) )
+                        ;
                     else
                         return false;
                     break;
@@ -1802,8 +1811,8 @@ namespace
             lex.consume();
             if(lex.next() == TOK_RWORD_UNSAFE)
                 lex.consume();
-            if(lex.next() == TOK_RWORD_EXTERN)
-                lex.consume();
+            if( lex.consume_if(TOK_RWORD_EXTERN) )
+                lex.consume_if(TOK_STRING);
             if( lex.consume_if(TOK_RWORD_FN) )
             {
                 goto fn;
@@ -1871,6 +1880,13 @@ namespace
             if( ! lex.consume_if(TOK_RWORD_FN) )
                 return false;
             goto fn;
+        // async [unsafe] fn
+        case TOK_RWORD_ASYNC:
+            lex.consume();
+            lex.consume_if(TOK_RWORD_UNSAFE);
+            if( !lex.consume_if(TOK_RWORD_FN) )
+                return false;
+            goto fn;
         case TOK_RWORD_FN:
             lex.consume();
         fn:
