From e703650c48b03280cc180d678e5f9d05682ee7cf Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 11:56:53 +0000
Subject: [PATCH 397/397] macro_rules: `$crate` of an executable's own macro
 uses the macro's edition, not the stream's uninitialised one

gitui 0.28.1 src/app.rs:537 (bin crate, edition 2021):

    impl App {
        setup_popups!(self, [commit_popup, ..]);

with, in src/components/mod.rs:

    #[macro_export]
    macro_rules! setup_popups {
        ($self:ident, [$($element:ident),+]) => {
            $crate::any_popup_visible!($self, [$($element),+]);
            ..

    MACRO<::""::setup_popups> BUG: ASSERT FAIL: src/expand/mod.cpp:434:
      path.size() > 0: Path should have nodes: ::any_popup_visible/*?*/

An executable's local crate has no name, so the `$crate` hack in
MacroExpander::realGetToken emits the `crate` keyword from edition 2018 on
and nothing in 2015 (the `::` that follows is then the crate root). It
asked `edition_after()`, i.e. TokenStream::m_edition, which getToken sets
from realGetEdition() only AFTER a token has been produced: for a body that
starts with `$crate` the value was whatever the allocation held, never
initialised. Zero on the G5 = Rust2015, the token was dropped and
`::any_popup_visible!` in a 2021 crate named extern crate `any_popup_visible`
(a path with no nodes); on Linux the garbage was usually >= 2018 and the
same crate built. Reproducible here with a zero-filled heap
(GLIBC_TUNABLES=glibc.malloc.tcache_count=0:glibc.malloc.perturb=255).

The hack now tests the macro's own edition (m_source_edition, the edition
its body tokens are parsed under), and TokenStream's constructor gives
m_edition a definite value.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 4d56cf35..c9238c59 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -2662,7 +2662,14 @@ Token MacroExpander::realGetToken()
                     DEBUG("[" << m_log_index << "] Crate name hack");
                     if( m_crate_name == "" )
                     {
-                        if( this->edition_after(AST::Edition::Rust2018) )
+                        // The local crate of an executable has no name: `$crate::x` is `crate::x` from 2018 on, and
+                        // `::x` (the token is dropped, the `::` that follows is the crate root) in 2015. The edition is
+                        // the macro's own: `edition_after()` here read the stream's edition of the PREVIOUS token, which
+                        // for a body starting with `$crate` was the never-initialised value from construction, so
+                        // a bin crate's `$crate::any_popup_visible!(..)` (gitui 0.28.1 app.rs:537 `setup_popups!`, macro
+                        // in components/mod.rs) became `::any_popup_visible!` = extern crate `any_popup_visible` on
+                        // the G5 (zeroed heap) and worked by luck on Linux ("Path should have nodes: ::any_popup_visible").
+                        if( m_source_edition >= AST::Edition::Rust2018 )
                         {
                             return Token(TOK_RWORD_CRATE);
                         }
diff --git a/src/parse/tokenstream.cpp b/src/parse/tokenstream.cpp
index a7c88687..93f1ecdd 100644
--- a/src/parse/tokenstream.cpp
+++ b/src/parse/tokenstream.cpp
@@ -17,6 +17,8 @@ const bool DEBUG_PRINT_TOKENS = false;
 
 TokenStream::TokenStream(ParseState ps):
     m_cache_valid(false),
+    // Only meaningful once a token has been read (set from `realGetEdition()` then); a definite value until then
+    m_edition(AST::Edition::Rust2015),
     m_parse_state(ps)
 {
 }
