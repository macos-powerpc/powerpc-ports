From 2581f8d19de9d8f2101131331cd8a92b9e326190 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 5 Nov 2026 22:53:17 +0000
Subject: [PATCH] expand: a derive named by a path through std or core is the builtin

zoxide 0.10.0 src/shell.rs:26: "MACRO<make_template> error: Failed to
apply #[derive] - Missing handlers for ::std::fmt::Debug". The macro body
has `#[derive(::std::fmt::Debug, ::askama::Template)]`.

The derive dispatcher took a builtin derive by its bare name, or, as
a hack for windows 0.48.0, by a `::core::..` path. A path through std
(`::std::fmt::Debug`) or a relative one (`std::fmt::Debug`) fell through
to the proc-macro lookup and then to "Missing handlers". std re-exports
core's derive macros at the same paths (and in the preludes), so
a core/std path whose last component is a builtin derive now uses that
builtin, after the proc-macro lookup as before.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/expand/derive.cpp b/src/expand/derive.cpp
index c36c9af8..d0927040 100644
--- a/src/expand/derive.cpp
+++ b/src/expand/derive.cpp
@@ -2198,16 +2198,24 @@ static void derive_item(const Span& sp, const AST::Crate& crate, AST::Module& mo
             continue;
         }
 
-        // HACK! If the trait path is for `=core` and the last component passes `find_impl`, then assume it's a proper path
-        // This is for the 1.74 crate `windows-0.48.0`, which has `#[derive(::core::cmp::PartialEq, ::core::cmp::Eq)]` for some reason.
-
-        // Absolute path
-        if( const auto* ap = trait_path.m_class.opt_Absolute() ) {
-            // For `::core` (encoded as `=core` due to how it's parsed in `get_derive_items`)
-            if( ap->crate == "=core" ) {
-                // And if the last node (ignore intermediate nodes) returns a valid builtin
-                if(auto dp = find_impl(ap->nodes.back().name())) {
-                    // Use that
+        // A path into core or std whose last component is a builtin derive: `#[derive(::core::cmp::PartialEq,
+        // ::core::cmp::Eq)]` (windows 0.48.0), `#[derive(::std::fmt::Debug)]` (zoxide 0.10.0 shell.rs make_template!),
+        // `std::fmt::Debug`. std re-exports core's derive macros at the same paths (and the preludes), so the
+        // intermediate nodes are not checked. (`::name` is spelled `=name` by get_derive_items.)
+        {
+            const RcString* last = nullptr;
+            if( const auto* ap = trait_path.m_class.opt_Absolute() ) {
+                if( (ap->crate == "=core" || ap->crate == "=std") && !ap->nodes.empty() ) {
+                    last = &ap->nodes.back().name();
+                }
+            }
+            else if( const auto* rp = trait_path.m_class.opt_Relative() ) {
+                if( rp->nodes.size() >= 2 && (rp->nodes.front().name() == "core" || rp->nodes.front().name() == "std") ) {
+                    last = &rp->nodes.back().name();
+                }
+            }
+            if( last ) {
+                if(auto dp = find_impl(*last)) {
                     mod.add_item(sp, AST::Visibility::make_bare_private(), "", dp->handle_item(sp, opts, item.params(), type, item), {} );
                     continue ;
                 }
