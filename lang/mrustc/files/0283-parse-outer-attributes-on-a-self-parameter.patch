From db894028d997f61e51c86e3a63c4e40d42dca434 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 06:04:57 +0000
Subject: [PATCH] parse: outer attributes on a `self` parameter

hyper 1.11.0 (xh 0.26.2) failed to parse:

    src/body/incoming.rs:201:18 error:0: Unexpected token TOK_RWORD_SELF,
    expected TOK_IDENT

    fn poll_frame(
        #[cfg_attr(
            not(all(
                any(feature = "http1", feature = "http2"),
                any(feature = "client", feature = "server")
            )),
            allow(unused_mut)
        )]
        mut self: Pin<&mut Self>,
        ..

Parse_FunctionDef recognised the self parameter only when its first token
was `&`, `mut` or `self`. With an attribute in front, the parameter went to
Parse_Function_Arg, which read the attributes and then wanted a pattern,
and `mut self` isn't one.

The outer attributes after `(` are now read first. A self parameter of
any form (`self`, `mut self`, `self: T`, `&self`, `&'a mut self`) gets
them, the same way normal arguments keep theirs (expand applies `cfg` /
`cfg_attr` to every argument, and proc-macro input already sends them).
Otherwise they go in front of the first normal parameter's own
attributes, so `#[cfg(..)]` there still removes it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 86c1c1fa..7330f26f 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -491,6 +491,9 @@ AST::Function Parse_FunctionDef(TokenStream& lex, bool allow_self, bool can_be_p
     AST::Function::Arglist  args;
 
     GET_CHECK_TOK(tok, lex, TOK_PAREN_OPEN);
+    // Outer attributes on the first parameter, which can be `self` (hyper 1.11 `#[cfg_attr(.., allow(unused_mut))]
+    // mut self: Pin<&mut Self>`): kept for the self parameter, else handed to the first normal argument
+    auto first_attrs = Parse_ItemAttrs(lex);
     GET_TOK(tok, lex);
 
     // Handle self
@@ -520,7 +523,7 @@ AST::Function Parse_FunctionDef(TokenStream& lex, bool allow_self, bool can_be_p
             }
             CHECK_TOK(tok, TOK_RWORD_SELF);
             auto sp = lex.end_span(ps);
-            args.push_back( AST::Function::Arg( AST::Pattern(AST::Pattern::TagBind(), sp, rcstring_self), TypeRef(TypeRef::TagReference(), sp, ::std::move(lifetime), is_mut, TypeRef(sp, rcstring_Self, 0xFFFF))) );
+            args.push_back( AST::Function::Arg( AST::Pattern(AST::Pattern::TagBind(), sp, rcstring_self), TypeRef(TypeRef::TagReference(), sp, ::std::move(lifetime), is_mut, TypeRef(sp, rcstring_Self, 0xFFFF)), mv$(first_attrs)) );
             //if( allow_self == false )
             //    ERROR(lex.point_span(), E0000, "Self binding not expected here");
 
@@ -548,7 +551,7 @@ AST::Function Parse_FunctionDef(TokenStream& lex, bool allow_self, bool can_be_p
             else {
                 PUTBACK(tok, lex);
             }
-            args.push_back( AST::Function::Arg( AST::Pattern(AST::Pattern::TagBind(), binding_sp, rcstring_self), mv$(ty)) );
+            args.push_back( AST::Function::Arg( AST::Pattern(AST::Pattern::TagBind(), binding_sp, rcstring_self), mv$(ty), mv$(first_attrs)) );
             GET_TOK(tok, lex);
         }
     }
@@ -566,13 +569,14 @@ AST::Function Parse_FunctionDef(TokenStream& lex, bool allow_self, bool can_be_p
         else {
             PUTBACK(tok, lex);
         }
-        args.push_back( AST::Function::Arg( AST::Pattern(AST::Pattern::TagBind(), binding_sp, rcstring_self), mv$(ty)) );
+        args.push_back( AST::Function::Arg( AST::Pattern(AST::Pattern::TagBind(), binding_sp, rcstring_self), mv$(ty), mv$(first_attrs)) );
         GET_TOK(tok, lex);
     }
     else
     {
         // Unbound method
     }
+    const bool had_self = !args.empty();
 
     // In 2018, patterns must always be provided
     if( lex.edition_after(AST::Edition::Rust2018) )
@@ -605,6 +609,12 @@ AST::Function Parse_FunctionDef(TokenStream& lex, bool allow_self, bool can_be_p
                 break;
             }
             args.push_back( Parse_Function_Arg(lex, !can_be_prototype) );
+            if( !had_self && args.size() == 1 && !first_attrs.m_items.empty() ) {
+                // The attributes before the first (non-self) parameter, read above, go first
+                auto& a = args.back().attrs.m_items;
+                a.insert(a.begin(), ::std::make_move_iterator(first_attrs.m_items.begin()), ::std::make_move_iterator(first_attrs.m_items.end()));
+                first_attrs.m_items.clear();
+            }
         } while( GET_TOK(tok, lex) == TOK_COMMA );
         CHECK_TOK(tok, TOK_PAREN_CLOSE);
     }
