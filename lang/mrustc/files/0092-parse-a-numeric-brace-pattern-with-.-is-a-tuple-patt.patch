From 540303728493b1dddf7fe450ff53586b86425ca7 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 6 Oct 2026 20:01:55 +0000
Subject: [PATCH] parse: a numeric brace pattern with `..` is a tuple pattern
 with a rest

`V { 0: a, .. }` on a tuple variant was turned into `V(a)` when the
indices had no gap: the `..` only counted after a gap. On a variant with
more fields than that, annotate_value_usage then asserted
(`pe.leading.size() == flds.size()`). thiserror 2's `source()` writes
exactly this for a `#[source]` field that isn't the last one; syntect
5.3.0 `LoadingError::ParseSyntax(#[source] ParseSyntaxError, String)`:

    Assertion failed: (pe.leading.size() == flds.size()), function
    get_usage_for_pattern, file src/hir_expand/annotate_value_usage.cpp

After a gap, the remaining sub-patterns went into the trailing part,
which counts from the end, so `V { 1: x, .. }` on a 3-field variant bound
field 2. A second gap was rejected ("Missing index").

Fill skipped indices with `_` and make `..` a rest after the last one:
`V { 1: x, 3: y, .. }` is `V(_, x, _, y, ..)`. Without `..`, a missing
index is still an error.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/parse/pattern.cpp | 23 +++++++++--------------
 1 file changed, 9 insertions(+), 14 deletions(-)

diff --git a/src/parse/pattern.cpp b/src/parse/pattern.cpp
index a0ff901d..87dd01e0 100644
--- a/src/parse/pattern.cpp
+++ b/src/parse/pattern.cpp
@@ -543,29 +543,24 @@ AST::Pattern Parse_PatternStruct(TokenStream& lex, ProtoSpan ps, AST::Path path)
         }
         CHECK_TOK(tok, TOK_BRACE_CLOSE);
 
-        bool has_split = false;
+        // Fields are given by index, so skipped ones become `_` and a `..` is a rest pattern after the last one:
+        // `V { 0: a, .. }` is `V(a, ..)` and `V { 1: b, .. }` is `V(_, b, ..)` (a trailing sub-pattern would be
+        // counted from the end, i.e. the wrong field). thiserror's `source()` writes these for `#[source]` fields.
         ::std::vector<AST::Pattern> leading;
-        ::std::vector<AST::Pattern> trailing;
         unsigned int i = 0;
         for(auto& p : pats)
         {
-            if( p.first != i ) {
-                if( has_split || !split_allowed ) {
-                    ERROR(lex.point_span(), E0000, "Missing index " << i);
-                }
-                has_split = true;
-                i = p.first;
+            if( p.first != i && !split_allowed ) {
+                ERROR(lex.point_span(), E0000, "Missing index " << i);
             }
-            if( ! has_split ) {
-                leading.push_back( mv$(p.second) );
-            }
-            else {
-                trailing.push_back( mv$(p.second) );
+            for(; i < p.first; i ++) {
+                leading.push_back( AST::Pattern(lex.point_span(), AST::Pattern::Data()) );
             }
+            leading.push_back( mv$(p.second) );
             i ++;
         }
 
-        return AST::Pattern(AST::Pattern::TagNamedTuple(), lex.end_span(ps), mv$(path),  AST::Pattern::TuplePat { mv$(leading), has_split, mv$(trailing) });
+        return AST::Pattern(AST::Pattern::TagNamedTuple(), lex.end_span(ps), mv$(path),  AST::Pattern::TuplePat { mv$(leading), split_allowed, {} });
     }
 
     bool is_exhaustive = true;
