From 06db150f2fba1d3c5ec8371f4ef650812bfa6535 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 17:49:25 +0000
Subject: [PATCH] parse: an attribute's input may be delimited by braces

rustc 1.90 tests/ui, parse-only run:

    attributes/unrestricted-attribute-tokens.rs   #[rustc_dummy{a b c d}]
    error: Unexpected token TOK_BRACE_OPEN, expected TOK_SQUARE_CLOSE

and rustfmt tests/{source,target}/issue_5686.rs `#[hell{world}]`,
target/unsafe_attributes.rs `#![simple_ident_tt{a b c}]`.

Reference, Attributes: Attr is `SimplePath AttrInput?` and AttrInput
is `DelimTokenTree | = Expression`; DelimTokenTree has `( )`, `[ ]`
and `{ }` alike.

Parse_MetaItem took `(..)` and `[..]` (the latter since 1.74 for
openssl), not `{..}`; the attribute's data is the token tree with its
delimiter, so nothing after the parser changes. The macro_rules `meta`
fragment skimmer (eval.cpp) took the same two; it takes braces too.

Checked, unchanged: the proc-macro visitor and ast/dump print
an attribute's token tree with its own delimiters.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index c283646e..432f0573 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -2433,6 +2433,7 @@ namespace
                 {
                 case TOK_PAREN_OPEN:
                 case TOK_SQUARE_OPEN:
+                case TOK_BRACE_OPEN:
                     return consume_tt(lex);
                 case TOK_EQUAL:
                     lex.consume();
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index e28c300c..7fb9a1c2 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1387,8 +1387,10 @@ AST::Attribute Parse_MetaItem(TokenStream& lex)
         }
         attr_data = TokenTree(lex.get_edition(), lex.get_hygiene(), std::move(tt));
         } break;
+    // AttrInput is any DelimTokenTree
     case TOK_PAREN_OPEN:
     case TOK_SQUARE_OPEN:   // 1.74 - openssl v0.10.57
+    case TOK_BRACE_OPEN:
         PUTBACK(tok, lex);
         attr_data = Parse_TT(lex, false);
         break;
diff --git a/src/version.cpp b/src/version.cpp
index f1da996e..24f38777 100644
--- a/src/version.cpp
+++ b/src/version.cpp
@@ -13,7 +13,7 @@
 #define VERSION_PATCH   0
 
 // Number of the last patch in this fork's series: every fix commit bumps it
-#define VERSION_SERIES  479
+#define VERSION_SERIES  480
 // rlibs written by an older series are refused (0 = accept all)
 #define VERSION_SERIES_FLOOR    0
 
