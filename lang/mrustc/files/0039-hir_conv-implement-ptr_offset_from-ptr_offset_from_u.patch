From dd8d9a90324ec0d09bf805b0f172e6a5aa3c7748 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 02:06:05 +0000
Subject: [PATCH] hir_conv: implement `ptr_offset_from` /
 `ptr_offset_from_unsigned` in constant evaluation

rug 1.28 computes `num_ptr.offset_from(den_ptr) <= 0` in `const fn`s
(`MiniRational::num_is_first`, `MiniComplex::re_is_first`) on pointers
that are either both dangling or both into the same struct; the constant
evaluator had no implementation of the intrinsic and died with
`MIR TODO: Call intrinsic "ptr_offset_from"`.

Compute `(a - b) / size_of::<T>()` (the type parameter is the pointee),
signed for `ptr_offset_from` and checked non-negative for
`ptr_offset_from_unsigned`. Both pointers must belong to the same
allocation: static references are compared by path, since separate
borrows of (fields of) one static get distinct relocation objects, and
other relocations by identity; integer pointers (no relocation, e.g.
`NonNull::dangling()`) compare as the same "allocation".

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_conv/constant_evaluation.cpp | 36 ++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index 64370dfd..fd9fa4ef 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -2901,6 +2901,42 @@ namespace HIR {
                     auto ofs = local_state.read_param_uint(Target_GetPointerBits(), e.args.at(1));
                     dst.write_ptr(state, ptr_pair.first + ofs.truncate_u64() * element_size, ptr_pair.second);
                 }
+                // `ptr_offset_from(a, b)` = `(a - b) / size_of::<T>()` as `isize` (the type parameter is the pointee);
+                // `ptr_offset_from_unsigned` is the `usize` form and requires `a >= b`. Both pointers must refer
+                // to the same allocation (or both be plain integers) for the byte distance to be meaningful.
+                // (rug 1.28 computes limb counts this way in `const fn`s.)
+                else if( te->name == "ptr_offset_from" || te->name == "ptr_offset_from_unsigned" ) {
+                    auto ty = local_state.monomorph_expand(te->params.m_types.at(0));
+                    size_t element_size;
+                    if( !Target_GetSizeOf(state.sp, resolve, ty, element_size) )
+                        throw Defer();
+                    MIR_ASSERT(state, element_size > 0, "`" << te->name << "` on a zero-sized type - " << ty);
+                    auto a = local_state.read_param_ptr(e.args.at(0));
+                    auto b = local_state.read_param_ptr(e.args.at(1));
+                    // Same allocation? Two borrows of (fields of) the same static get distinct `StaticRef`
+                    // objects, so compare those by path; other relocations (and "no relocation" integer
+                    // pointers, e.g. `NonNull::dangling()`) by identity.
+                    auto same_allocation = [](const RelocPtr& x, const RelocPtr& y)->bool {
+                        if( !x || !y )
+                            return !x && !y;
+                        if( const auto* sx = x.as_staticref() ) {
+                            const auto* sy = y.as_staticref();
+                            return sy && (sx == sy || sx->path() == sy->path());
+                        }
+                        return x.as_allocation() == y.as_allocation() && x.as_constant() == y.as_constant();
+                        };
+                    MIR_ASSERT(state, same_allocation(a.second, b.second), "`" << te->name << "` on pointers into different allocations - " << a.second << " vs " << b.second);
+                    int64_t diff = static_cast<int64_t>(a.first) - static_cast<int64_t>(b.first);
+                    MIR_ASSERT(state, diff % static_cast<int64_t>(element_size) == 0, "`" << te->name << "` byte distance " << diff << " is not a multiple of " << element_size);
+                    int64_t rv = diff / static_cast<int64_t>(element_size);
+                    if( te->name == "ptr_offset_from_unsigned" ) {
+                        MIR_ASSERT(state, rv >= 0, "`ptr_offset_from_unsigned` with a negative distance " << rv);
+                        dst.write_uint(state, Target_GetPointerBits(), U128(static_cast<uint64_t>(rv)));
+                    }
+                    else {
+                        dst.write_sint(state, Target_GetPointerBits(), S128(rv));
+                    }
+                }
                 // Returns 1/0/2 (equal / not equal / unknown). Only answer definitively for pointers sharing a relocation; different allocations report 2.
                 else if( te->name == "ptr_guaranteed_cmp" ) {
                     auto a = local_state.read_param_ptr(e.args.at(0));
