From f40d38593c417316824d234a702b9a4d5e17464e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 04:08:16 +0000
Subject: [PATCH] hir_conv: defer a static whose path names const generic
 parameters

owo-colors 4.2.3 (dua-cli 2.46.0) died in constant evaluation:

    MIR ERROR: <CustomColor<{Generic(R/*I:0*/)},{Generic(G/*I:1*/)},{Generic(B/*I:2*/)},> as Color>::ANSI_BG
    BB0/0: get_staticref: lifted#C_0<CustomColor<..>,{Generic(R/*I:0*/)},{Generic(G/*I:1*/)},{Generic(B/*I:2*/)},>
    Defer during value generation

colors/custom.rs:

    impl<const R: u8, const G: u8, const B: u8> Color for CustomColor<R, G, B> {
        const ANSI_BG: &'static str = bytes_to_str(&Self::ANSI_BG_U8);
    }

The borrow of the inherent constant is promoted to a static generic over
Self and the three const parameters only. Evaluating the generic impl's
ANSI_BG reached that static through get_staticref, which defers when the
path mentions a generic TYPE; none here, so it evaluated the static's value
with R unknown, and the evaluation's own Defer ended in MIR_BUG.

get_staticref now also defers on const generic values: the path's own
params, the params of every path type inside it, array sizes and trait
object params. The constant is then evaluated per concrete instance, as
for type generics.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index e34f301a..8a209f36 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -1104,7 +1104,38 @@ namespace MIR { namespace eval {
         StaticRefPtr get_staticref(::HIR::Path p, HIR::TypeRef* out_ty=nullptr) const
         {
             // If there's any mention of generics in this path, then return Literal::Defer
-            if( visit_path_tys_with(p, [&](const auto& ty)->bool { return ty.data().is_Generic(); }) )
+            // - Const generics count too: owo-colors 4.2.3 colors/custom.rs `impl<const R: u8, const G: u8, const B: u8>
+            //   Color for CustomColor<R, G, B> { const ANSI_BG: &'static str = bytes_to_str(&Self::ANSI_BG_U8); }`
+            //   borrows `lifted#C_0<CustomColor<R,G,B>, R, G, B>`, which has no generic TYPE in it, so the static was
+            //   evaluated generically and its `Defer` became "Defer during value generation".
+            struct H {
+                static bool params_have_generic_value(const ::HIR::PathParams& pp) {
+                    for(const auto& v : pp.m_values)
+                        if( v.is_Generic() )
+                            return true;
+                    return false;
+                }
+                static bool path_has_generic_value(const ::HIR::Path& p) {
+                    TU_MATCH_HDRA( (p.m_data), {)
+                    TU_ARMA(Generic, e)       return params_have_generic_value(e.m_params);
+                    TU_ARMA(UfcsInherent, e)  return params_have_generic_value(e.params) || params_have_generic_value(e.impl_params);
+                    TU_ARMA(UfcsKnown, e)     return params_have_generic_value(e.trait.m_params) || params_have_generic_value(e.params);
+                    TU_ARMA(UfcsUnknown, e)   return params_have_generic_value(e.params);
+                    }
+                    return false;
+                }
+            };
+            if( H::path_has_generic_value(p) || visit_path_tys_with(p, [&](const auto& ty)->bool {
+                    if( ty.data().is_Generic() )
+                        return true;
+                    if( const auto* te = ty.data().opt_Path() )
+                        return H::path_has_generic_value(te->path);
+                    if( const auto* te = ty.data().opt_Array() )
+                        return te->size.is_Unevaluated() && te->size.as_Unevaluated().is_Generic();
+                    if( const auto* te = ty.data().opt_TraitObject() )
+                        return H::params_have_generic_value(te->m_trait.m_path.m_params);
+                    return false;
+                    }) )
             {
                 DEBUG("Return Literal::Defer for constastatic " << p << " which references a generic parameter");
                 throw Defer();
