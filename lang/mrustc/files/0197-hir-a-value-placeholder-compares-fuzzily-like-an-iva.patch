From 36f5cb9111851496138e1f9dc75fe5a83390db3c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 17:01:12 +0000
Subject: [PATCH 197/199] hir: a value placeholder compares fuzzily, like an ivar

0192 leaves an impl's const param that no argument fixes as
a placeholder for the where-clauses to bind.  Comparing path params and
array sizes still treated that placeholder as a plain value, so it was
"unequal" to the literal of the impl a bound then found: quantette 0.6.0
quantize/wu/f32.rs:322 `Wu::<_, Color, _, _>::new(&self.hist)`, whose
`Hist: InclusionExclusion<Stats<Sum, N, Count>, N>` goes through the
blanket `impl<H: InclusionExclusion<T, N>, T, const N> .. for &H` to
`impl .. InclusionExclusion<T, 3> for Histogram3<..>`; the inner impl's
`3` against the outer placeholder `N` failed the bound, "Failed to find
an impl of InclusionExclusion<Stats<_,_,Infer(0)>,Infer(0)> for
&Histogram3<Stats<f64,u32,3>,B1,B2,B3>".  (N stayed an ivar at that point
because `Color: ColorComponents<_, N>` had two candidates, the caller's
bound and the blanket impl.)

A value placeholder on either side is now Fuzzy in
PathParams::compare_with_placeholders and in the array-size arm of
TypeRef::compare_with_placeholders, as type placeholders already are.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir/path.cpp b/src/hir/path.cpp
index 60805578..7dd8e2bc 100644
--- a/src/hir/path.cpp
+++ b/src/hir/path.cpp
@@ -401,6 +401,13 @@ Ordering HIR::TraitPath::ord(const TraitPath& x) const
                     //return Compare::Fuzzy;
                     rv = Compare::Fuzzy;
                 }
+                // A value placeholder is an impl's const param that its bounds have yet to fix (`impl<H:
+                // InclusionExclusion<T, N>, T, const N: usize> InclusionExclusion<T, N> for &H` asked for
+                // `InclusionExclusion<_, Infer>`): as unknown as an ivar, not a mismatch against the literal `3`
+                // of the impl the bound then finds (quantette 0.6.0 `Wu::<_, Color, _, _>::new(&self.hist)`)
+                else if( TU_TEST1(val_t, Generic, .is_placeholder()) || TU_TEST1(val_x, Generic, .is_placeholder()) ) {
+                    rv = Compare::Fuzzy;
+                }
                 else if( val_t != val_x ) {
                     if( val_t.is_Unevaluated() || val_x.is_Unevaluated() ) {
                         //return Compare::Fuzzy;
diff --git a/src/hir/type.cpp b/src/hir/type.cpp
index a0efee02..1cac97b0 100644
--- a/src/hir/type.cpp
+++ b/src/hir/type.cpp
@@ -1549,6 +1549,13 @@ HIR::TypeData_NamedFunction_Ty HIR::TypeData_NamedFunction_Ty::clone() const {
         else if( re.size.is_Unevaluated() && re.size.as_Unevaluated().is_Infer() ) {
             rv &= Compare::Fuzzy;
         }
+        // A value placeholder (an impl's const param left to its bounds) is as unknown as an ivar
+        else if( le.size.is_Unevaluated() && TU_TEST1(le.size.as_Unevaluated(), Generic, .is_placeholder()) ) {
+            rv &= Compare::Fuzzy;
+        }
+        else if( re.size.is_Unevaluated() && TU_TEST1(re.size.as_Unevaluated(), Generic, .is_placeholder()) ) {
+            rv &= Compare::Fuzzy;
+        }
         else if( le.size != re.size ) {
             return Compare::Unequal;
         }
