From 886937b05baf2efb1831ddfee92b8a5de5cfb9de Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 1 Nov 2026 08:14:22 +0000
Subject: [PATCH] expand: `e.await` goes through `IntoFuture::into_future(e)`,
 so an `IntoFuture` type can be awaited

rmux 0.10.0 crates/rmux-sdk/src/layout.rs:346 `spawn.await?` on a `PaneSpawnBuilder`, which implements
`IntoFuture` (handles/pane/spawn.rs:107) and not `Future`: "Failed to find an impl of
::core::future::future::Future for PaneSpawnBuilder<'_> with Output = _". The await node was type-checked as
`e: Future` directly; rustc desugars `e.await` to `<_ as IntoFuture>::into_future(e).await`, and core's blanket
`impl<F: Future> IntoFuture for F` makes that the identity for futures.

The expand pass's unary-operator visitor now wraps the awaitee in that UFCS call, the way the `for` loop
desugar calls `IntoIterator::into_iter`, when the core crate in use defines `future::IntoFuture` (the no_core
stand-ins of most kits don't and keep their plain `.await`). Type checking and the generator lowering of the
await node are unchanged.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/expand/mod.cpp b/src/expand/mod.cpp
index ee3a2208..23fba313 100644
--- a/src/expand/mod.cpp
+++ b/src/expand/mod.cpp
@@ -1710,8 +1710,32 @@ struct CExpandExpr:
             break;
         }
     }
+    // Whether the core crate in use defines `future::IntoFuture` (the kits' no_core stand-ins mostly don't)
+    bool core_has_into_future() const {
+        auto it = crate.m_extern_crates.find(crate.m_ext_cratename_core);
+        if( it == crate.m_extern_crates.end() ) {
+            return false;
+        }
+        const auto& root = it->second.m_hir->m_root_module;
+        auto mi = root.m_mod_items.find(RcString::new_interned("future"));
+        if( mi == root.m_mod_items.end() || !mi->second->ent.is_Module() ) {
+            return false;
+        }
+        return mi->second->ent.as_Module().m_mod_items.count(RcString::new_interned("IntoFuture")) > 0;
+    }
     void visit(::AST::ExprNode_UniOp& node) override {
         this->visit_nodelete(node, node.m_value);
+        // `e.await` is `<_ as IntoFuture>::into_future(e).await` (rustc's desugar), so a type that implements only
+        // IntoFuture can be awaited (rmux-sdk 0.10.0 `PaneSpawnBuilder`); futures go through core's blanket impl.
+        if( node.m_type == ::AST::ExprNode_UniOp::AWait && core_has_into_future() ) {
+            auto core_crate = crate.m_ext_cratename_core;
+            static const RcString rcstring_into_future = RcString::new_interned("into_future");
+            auto path_IntoFuture = get_path(core_crate, "future", "IntoFuture");
+            node.m_value = ::AST::ExprNodeP(new ::AST::ExprNode_CallPath(
+                ::AST::Path::new_ufcs_trait( ::TypeRef(node.span()), path_IntoFuture, { ::AST::PathNode(rcstring_into_future) } ),
+                ::make_vec1( mv$(node.m_value) )
+                ));
+        }
         // - Desugar question mark operator before resolve so it can create names
         if( node.m_type == ::AST::ExprNode_UniOp::QMARK ) {
             auto core_crate = crate.m_ext_cratename_core;
