 src/trans/codegen_c.cpp   | 20 ++++++++++++++------
 zst-volatile-test/body.rs | 19 +++++++++++++++++++
 zst-volatile-test/hdr.rs  | 21 +++++++++++++++++++++
 zst-volatile-test/main.c  | 17 +++++++++++++++++
 zst-volatile-test/run.sh  | 21 +++++++++++++++++++++
 5 files changed, 92 insertions(+), 6 deletions(-)
 create mode 100644 zst-volatile-test/body.rs
 create mode 100644 zst-volatile-test/hdr.rs
 create mode 100644 zst-volatile-test/main.c
 create mode 100755 zst-volatile-test/run.sh

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 1caa7499..6205d84e 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -8607,16 +8607,24 @@ namespace {
                 }
             }
             // --- Volatile Load/Store
+            // A volatile access of a ZST has no storage to touch, and the value local was never declared
             else if( name == "volatile_load" ) {
-                emit_lvalue(e.ret_val); m_of << " = *(volatile "; emit_ctype(params.m_types.at(0)); m_of << "*)"; emit_param(e.args.at(0));
-            }
-            else if( name == "volatile_store" ) {
-                m_of << "*(volatile "; emit_ctype(params.m_types.at(0)); m_of << "*)"; emit_param(e.args.at(0)); m_of << " = "; emit_param(e.args.at(1));
+                if( this->type_is_bad_zst(params.m_types.at(0)) ) {
+                    m_of << "/* zst */";
+                }
+                else {
+                    emit_lvalue(e.ret_val); m_of << " = *(volatile "; emit_ctype(params.m_types.at(0)); m_of << "*)"; emit_param(e.args.at(0));
+                }
             }
-            else if( name == "nontemporal_store" ) {
+            else if( name == "volatile_store" || name == "nontemporal_store" ) {
                 // TODO: Actually do a non-temporal store
                 // GCC: _mm_stream_* (depending on input type, which must be `repr(simd)`)
-                m_of << "*(volatile "; emit_ctype(params.m_types.at(0)); m_of << "*)"; emit_param(e.args.at(0)); m_of << " = "; emit_param(e.args.at(1));
+                if( this->type_is_bad_zst(params.m_types.at(0)) ) {
+                    m_of << "/* zst */";
+                }
+                else {
+                    m_of << "*(volatile "; emit_ctype(params.m_types.at(0)); m_of << "*)"; emit_param(e.args.at(0)); m_of << " = "; emit_param(e.args.at(1));
+                }
             }
             // --- Atomics!
             else if( name.compare(0, 7, "atomic_") == 0 )
