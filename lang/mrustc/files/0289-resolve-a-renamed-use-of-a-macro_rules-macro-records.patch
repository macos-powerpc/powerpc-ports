From 5eb7581e5a97e0d0893ba66ba80157800a13b0e0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 09:26:09 +0000
Subject: [PATCH] resolve: a renamed `use` of a macro_rules! macro records its module

rustls 0.23.42 without the `logging` feature (ani-cli-rs 0.11.0):

    src/msgs/mod.rs:44-45 error:0: Couldn't find final node of path
    crate::_warn/*m:MacroRules(? ?)[crate::_warn]*/

    #[cfg(not(feature = "logging"))]
    mod log {
        macro_rules! trace    ( ($($tt:tt)*) => {{}} );
        macro_rules! _warn    ( ($($tt:tt)*) => {{}} );
        pub(crate) use {_warn as warn, debug, error, trace};
    }

and `use crate::log::warn;` in msgs/handshake.rs. Expand records a `use`
naming a macro as a macro import of its module, with the path that
Resolve_Lookup_Macro reports. For a one-segment relative path (`_warn`),
get_module returned the current module but didn't fill `out_path`, so
find_item's appended name gave `crate::_warn`. `use crate::log::trace`
didn't notice, because `trace` is found by its definition in `mod log`
before the imports are searched. `warn` only exists as the import, and
resolving it went to the crate root.

get_module now sets `out_path` to the current module's path in that case.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/resolve/common.cpp b/src/resolve/common.cpp
index be417f7c..6f358a45 100644
--- a/src/resolve/common.cpp
+++ b/src/resolve/common.cpp
@@ -127,7 +127,14 @@ namespace {
                     }
 
                     DEBUG("Ignore last");
-                    return ResolveModuleRef(&this->get_mod_by_true_path(base_nodes, base_nodes.size()));
+                    const auto& cur_mod = this->get_mod_by_true_path(base_nodes, base_nodes.size());
+                    // The caller appends the item name: a `use _warn as warn;` of a `macro_rules!` in `mod log` was
+                    // recorded as the macro import `crate::_warn` (rustls 0.23.42's `log` stand-in without the
+                    // `logging` feature: "Couldn't find final node of path crate::_warn")
+                    if(out_path) {
+                        *out_path = cur_mod.path();
+                    }
+                    return ResolveModuleRef(&cur_mod);
                 }
                 const auto& name = e.nodes.front().name();
                 // Look up in stack of anon modules
