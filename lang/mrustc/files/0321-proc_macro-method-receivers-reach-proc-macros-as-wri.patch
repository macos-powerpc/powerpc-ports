From 168712b29df2178959e901a0a2bea2b9bc0b0dc5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 05:05:33 +0000
Subject: [PATCH] proc_macro: method receivers reach proc macros as written
 (`&self`, not `self: &(Self)`)

cryptography 48.0.0 src/rust/src/backend/aead.rs:436:

    #[pyo3::pymethods]
    impl ChaCha20Poly1305 { .. fn encrypt(&self, py: pyo3::Python<'p>, ..) .. }

    aead.rs:436-437 error:0: compile_error! "Python objects are shared, so 'self' cannot be moved out of
    the Python interpreter.\nTry `&self`, `&mut self, `slf: PyClassGuard<'_, Self>` or `slf: PyClassGuardMut<'_, Self>`."

The parser stores `&'a mut self` as the argument `self: &'a mut Self`
(a generic `Self`), and the proc-macro token visitor sent it that way, as
`self : & 'a mut ( Self )`. syn reads a typed receiver as a `Receiver`
without `reference`, and pyo3-macros-backend 0.28 parse_method_receiver
takes any such receiver for a by-value `self`.

- The visitor sends a receiver whose type is the parser's own `Self` as
  its shorthand: `self`, `mut self`, `&self`, `&'a self`, `&mut self`,
  `&'a mut self`. A receiver written out (`self: &Self`, `self: Box<Self>`)
  has a path `Self` and is sent as written, as rustc gives it.
- `mut self` kept no `mut` (the binding was immutable), so a macro got
  `self: Self` and re-emitted the method without it; the binding is `mut`.

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index fb5f1a79..0ca02e40 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -1715,6 +1715,10 @@ namespace {
             m_pmi.send_symbol("(");
             for( const auto& arg : fcn.args() ) {
                 this->visit_attrs(arg.attrs);
+                if( &arg == &fcn.args().front() && this->visit_receiver_shorthand(arg) ) {
+                    m_pmi.send_symbol(",");
+                    continue;
+                }
                 this->visit_pattern(arg.pat);
                 m_pmi.send_symbol(":");
                 this->visit_type(arg.ty);
@@ -1740,6 +1744,45 @@ namespace {
                 m_pmi.send_symbol(";");
             }
         }
+        /// A receiver as its shorthand (`self`, `mut self`, `&'a self`, `&mut self`), which the parser stores as `self: Self`
+        /// / `self: &'a mut Self`. Sent as `self: &(Self)`, syn's `Receiver` has no `reference`, and pyo3-macros 0.28 takes
+        /// that for a by-value `self`: cryptography 48.0.0 src/rust/src/backend/aead.rs:436 `#[pyo3::pymethods] impl ..`
+        /// = "compile_error! Python objects are shared, so 'self' cannot be moved out of the Python interpreter".
+        /// Only the parser's own `Self` (a generic) is a shorthand: `self: &Self` written out has a path `Self` and is
+        /// sent as written.
+        bool visit_receiver_shorthand(const AST::Function::Arg& arg)
+        {
+            const auto& pat = arg.pat;
+            if( !pat.data().is_Any() || pat.bindings().size() != 1 ) {
+                return false;
+            }
+            const auto& b = pat.bindings().front();
+            if( !(b.m_name == "self") || b.m_type != ::AST::PatternBinding::Type::MOVE ) {
+                return false;
+            }
+            auto is_Self = [](const TypeRef& t) {
+                return t.m_data.is_Generic() && t.m_data.as_Generic().name == "Self";
+            };
+            if( is_Self(arg.ty) ) {
+                if( b.m_mutable ) {
+                    m_pmi.send_rword("mut");
+                }
+                m_pmi.send_rword("self");
+                return true;
+            }
+            if( const auto* te = arg.ty.m_data.opt_Borrow() ) {
+                if( !b.m_mutable && is_Self(*te->inner) ) {
+                    m_pmi.send_symbol("&");
+                    this->visit_lifetime(te->lifetime);
+                    if( te->is_mut ) {
+                        m_pmi.send_rword("mut");
+                    }
+                    m_pmi.send_rword("self");
+                    return true;
+                }
+            }
+            return false;
+        }
         void visit_static(const RcString& name, const AST::Visibility& vis, const ::AST::Static& i)
         {
             this->visit_vis(vis);
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index c50e1548..d31ed967 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -558,7 +558,8 @@ AST::Function Parse_FunctionDef(TokenStream& lex, bool allow_self, bool can_be_p
             else {
                 PUTBACK(tok, lex);
             }
-            args.push_back( AST::Function::Arg( AST::Pattern(AST::Pattern::TagBind(), binding_sp, rcstring_self), mv$(ty), mv$(first_attrs)) );
+            // (The binding is `mut`: it was dropped, and a proc macro got `self: Self` back)
+            args.push_back( AST::Function::Arg( AST::Pattern(AST::Pattern::TagBind(), binding_sp, rcstring_self, AST::PatternBinding::Type::MOVE, /*is_mut=*/true), mv$(ty), mv$(first_attrs)) );
             GET_TOK(tok, lex);
         }
     }
