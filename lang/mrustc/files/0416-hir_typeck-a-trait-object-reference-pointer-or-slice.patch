From f11e4b657fa57ba6236ce4f735558158a74370ce Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 31 Oct 2026 00:34:14 +0000
Subject: [PATCH 416/418] hir_typeck: a trait object, reference, pointer or
 slice has an auto trait only through its bounds

ares 0.10.0 src/filtration_system/mod.rs:57 `self.components.into_par_iter()`
with `self: &Decoders`, `components: Vec<Box<dyn Crack + Sync>>`:
    error:0: Attempting to move out of invalid slot - a0*.0

rayon has `impl<T: Send> IntoParallelIterator for Vec<T>` and
`impl<'a, T: Sync> IntoParallelIterator for &'a Vec<T>`. rustc rejects the
by-value impl: `Box<dyn Crack + Sync>: Send` needs `dyn Crack + Sync: Send`,
and a trait object implements an auto trait only when its own bounds or its
principal trait's supertraits say so; method lookup then auto-refs and takes
the `&Vec<T>` impl.

mrustc's auto-trait search (find_trait_impls_crate, marker section) found no
explicit impl for the trait object and fell into
check_auto_trait_impl_destructure, whose `default` arm answers Equal for every
type class it does not list: trait objects, references, raw pointers and
slices "implemented" every auto trait. A positive impl whose type matched but
whose bounds failed (`Send for &mut T where T: Send`) fell back to the same
structural answer.

Now a trait object is Unequal there (the object's own bounds and supertraits
were already answered by find_trait_impls), Borrow/Pointer/Slice follow their
inner type, and a positive impl whose type matched but whose bounds failed
ends the search as "not implemented" (rustc assembles no auto-impl candidate
when an explicit impl applies).

Assisted-by: Claude Fable 5.1
---

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index 2aa413ec..fa27bfbd 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -3464,6 +3464,7 @@ bool TraitResolution::find_trait_impls_crate(const Span& sp,
         // - Search for positive impls for this type
         DEBUG("- Search positive impls");
         bool positive_found = false;
+        bool positive_type_matched = false;
         this->m_crate.find_auto_trait_impls(trait, type, this->m_ivars.callback_resolve_infer(),
             [&](const auto& impl)->bool {
                 // Skip any negative impls on this pass
@@ -3471,6 +3472,7 @@ bool TraitResolution::find_trait_impls_crate(const Span& sp,
                     return false;
 
                 DEBUG("[find_trait_impls_crate] - Auto Pos Found impl" << impl.m_params.fmt_args() << " " << trait << impl.m_trait_args << " for " << impl.m_type << " " << impl.m_params.fmt_bounds());
+                positive_type_matched = true;
 
                 // Compare with `params`
                 HIR::PathParams impl_params;
@@ -3495,6 +3497,15 @@ bool TraitResolution::find_trait_impls_crate(const Span& sp,
             // A positive impl was found, so return true (callback should have been called)
             return true;
         }
+        // An explicit impl covers the type only through its bounds: when they fail (`Send for &T where T: Sync`,
+        // `Send for Box<T> where T: Send`) the trait is not implemented, rustc gives no structural impl then
+        if( positive_type_matched ) {
+            DEBUG("- Explicit impl bounds failed, no auto impl");
+            if( markings ) {
+                markings->auto_impls.insert( ::std::make_pair(trait, ::HIR::TraitMarkings::AutoMarking { {}, false }) );
+            }
+            return false;
+        }
 
         // - Search for negative impls for this type
         DEBUG("- Search negative impls");
@@ -3590,6 +3601,22 @@ bool TraitResolution::find_trait_impls_crate(const Span& sp,
     default:
         // Otherwise, there's no negative so it must be positive
         return ::HIR::Compare::Equal;
+    // A trait object has an auto trait only from its own bounds (`dyn Tr + Send`) or its principal trait's
+    // supertraits, both answered by `find_trait_impls` before this search; nothing makes `dyn Crack + Sync` Send
+    // (ares 0.10.0 `self.components.into_par_iter()` took `impl<T: Send> .. for Vec<T>` and moved out of `&self`)
+    TU_ARMA(TraitObject, e) {
+        return ::HIR::Compare::Unequal;
+        }
+    // Pointers and slices follow their pointee / element (`&NotSync: Sync` was answered by the default arm)
+    TU_ARMA(Borrow, e) {
+        return type_impls_trait(e.inner);
+        }
+    TU_ARMA(Pointer, e) {
+        return type_impls_trait(e.inner);
+        }
+    TU_ARMA(Slice, e) {
+        return type_impls_trait(e.inner);
+        }
     TU_ARMA(Path, e) {
         ::HIR::Compare  res = ::HIR::Compare::Equal;
         TU_MATCH_HDRA( (e.path.m_data), {)
