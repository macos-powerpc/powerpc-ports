From 67b7ef0c60aed2d7033832cadead1f752119ba3c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 16:15:14 +0000
Subject: [PATCH] hir_expand: no implied lifetime bounds from under a fn
 pointer's HRL

Lifetime inference collects implied bounds from the function's argument
types. A path type under a borrow whose lifetime is a fn pointer's own HRL
gave the whole function a bound against that HRL; lifetime-to-lifetime
bounds already skip HRLs (maybe_push_lifetime_bound), path types did not.
protobuf 2.27.1 reflect/acc/v1.rs:592 (rq 1.0.4):

    pub fn make_vec_accessor<M, V>(
        name: &'static str,
        get_vec: for<'a> fn(&'a M) -> &'a Vec<V::Value>, ..
    ) -> FieldAccessor
    where M: Message + 'static, V: ProtobufType + 'static
    {
        FieldAccessor::new_v1(name,
            FieldAccessorFunctions::Repeated(Box::new(MessageGetMut::<M, Vec<V::Value>> {
                get_field: get_vec, ..

`V::Value: 'H0` from `get_vec`'s type then answered the `'static` check of
the coercion to `Box<dyn FieldAccessor2<..>>`:

    BUG: lifetime_infer.cpp:1287: Encountered HRL with no HRL in the stack - 'static = 'H0

A plain generic param never got such a bound, so only associated types and
other paths hit it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_expand/lifetime_infer.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/hir_expand/lifetime_infer.cpp b/src/hir_expand/lifetime_infer.cpp
index aef20c67..23ece40f 100644
--- a/src/hir_expand/lifetime_infer.cpp
+++ b/src/hir_expand/lifetime_infer.cpp
@@ -2187,7 +2187,11 @@ namespace {
                         check_lifetime_variant(te->m_lifetime);
                     }
                     if( /*const auto* te =*/ ty.data().opt_Path() ) {
-                        if( !m_stack.empty() && m_stack.back() ) {
+                        // Not under a HRL (as in `maybe_push_lifetime_bound`): `for<'a> fn(&'a M) -> &'a V::Value` gave
+                        // the whole function `V::Value: 'H0`, which then answered `V::Value: 'static` - protobuf 2.27.1
+                        // reflect/acc/v1.rs:592 `Box::new(MessageGetMut::<M, Vec<V::Value>> { .. })` as a `Box<dyn ..>`,
+                        // "Encountered HRL with no HRL in the stack - 'static = 'H0"
+                        if( !m_stack.empty() && m_stack.back() && !m_stack.back()->is_hrl() ) {
                             m_state.add_type_lifetime_bound(ty, *m_stack.back());
                         }
                     }
