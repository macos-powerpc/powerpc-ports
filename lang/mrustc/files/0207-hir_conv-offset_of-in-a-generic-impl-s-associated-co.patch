From 43af5a4d96f3c9c8f2d1828a39e542c8d5bc6852 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 10 Oct 2026 17:45:23 +0000
Subject: [PATCH] hir_conv: `offset_of!` in a generic impl's associated
 constant defers until the instance is known

The first evaluation of a generic impl's constant uses placeholder params; `size_of`/`align_of` throw Defer
there and the constant is evaluated again per instance. `offset_of` asked for the layout of the still-generic
container and failed: "Calling `offset_of!` on type with non-defined repr: Cell<T, S>". Now it defers the same way.

Needed by the tokio crate patches (tokio@1.23.0..1.45.1, tokio@1.46.0+) that replace runtime/task/raw.rs's
hand-rolled `#[repr(C)]` offset formula with `offset_of!`: on Darwin ppc32 a non-first 8-aligned field
(`Core::task_id`) is 4-byte aligned although `align_of::<Id>()` is 8, so with an 8-byte scheduler (blocking
tasks) the formula said +32 while the field is at +28 (sad 0.4.32: "assertion `left == right` failed
left: 5252892 right: 5252896").

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index ce098f36..c21c2df1 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -2603,6 +2603,11 @@ namespace HIR {
                 }
                 else if( te->name == "offset_of" ) {
                     auto ty = local_state.monomorph_expand(te->params.m_types.at(0));
+                    // A still-generic container has no repr (the first evaluation of a generic impl's constant uses
+                    // placeholder params, e.g. `OffsetHelper::<T, S>::TRAILER_OFFSET` = `offset_of!(Cell<T, S>, trailer)`):
+                    // defer to the per-instance evaluation, as `size_of`/`align_of` do.
+                    if( !Target_GetTypeRepr(state.sp, this->resolve, ty) )
+                        throw Defer();
                     size_t  val = state.intrinsic_offset_of(ty, e.args);
                     dst.write_uint(state, Target_GetPointerBits(), U128(val));
                 }
