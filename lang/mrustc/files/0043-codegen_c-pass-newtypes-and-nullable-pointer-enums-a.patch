+        /// ABIs where both the caller and the callee are generated by mrustc
+        static bool abi_is_rust_internal(const RcString& abi)
+        {
+            return abi == ABI_RUST || abi == "rust-call" || abi == "rust-cold" || abi == "rust-intrinsic" || abi == "platform-intrinsic" || abi == "unadjusted";
+        }
