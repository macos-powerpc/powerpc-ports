+        // --- C ABI scalar wrappers ---
+        // A `#[repr(transparent)]`/newtype struct or a nullable-pointer `Option` is emitted as a C struct, but Rust passes
+        // and returns it like the scalar it wraps. At a C ABI boundary that matters wherever the C ABI treats a small
+        // struct differently from a scalar: e.g. 32-bit PowerPC Darwin (and i386 SysV) return every struct through a hidden
+        // pointer, while `signed char f(void)` returns in r3. So C ABI functions (`extern` declarations, Rust definitions and
+        // function pointers) whose signature contains such a type use the scalar instead:
+        // - Imported functions: the real symbol is `<name>__cabi` (scalar types), `<name>` is a converting inline wrapper.
+        // - Rust definitions: `<name>` is the body (struct types, used by direct Rust calls), the exported symbol is a
+        //   converting wrapper `<name>__cabi`.
+        // - Taking the address of either gives `<name>__cabi`, and calls through C ABI function pointers convert at the call.
+        struct CAbiSig {
+            const ::HIR::TypeRef*   ret = nullptr;
+            ::std::vector<const ::HIR::TypeRef*>    args;
+            bool any() const {
+                if( ret )   return true;
+                for(const auto* a : args)
+                    if( a ) return true;
+                return false;
+            }
+        };
+        bool type_is_cabi_scalar(const ::HIR::TypeRef& ty) const
+        {
+            if( const auto* te = ty.data().opt_Primitive() ) {
+                return *te != ::HIR::CoreType::Str && *te != ::HIR::CoreType::U128 && *te != ::HIR::CoreType::I128;
+            }
+            if( const auto* te = ty.data().opt_Pointer() ) {
+                return m_resolve.metadata_type(sp, te->inner) == MetadataType::None;
+            }
+            if( const auto* te = ty.data().opt_Borrow() ) {
+                return m_resolve.metadata_type(sp, te->inner) == MetadataType::None;
+            }
+            return ty.data().is_Function();
+        }
+        /// If `ty` is emitted as a C struct but is passed as a single scalar (a newtype, or an enum using a non-zero niche
+        /// such as `Option<&T>`), return that scalar's type.
+        const ::HIR::TypeRef* get_cabi_scalar(const ::HIR::TypeRef& ty) const
+        {
+            const ::HIR::TypeRef* cur = &ty;
+            for(unsigned depth = 0; depth < 16; depth ++)
+            {
+                if( type_is_cabi_scalar(*cur) ) {
+                    return cur == &ty ? nullptr : cur;
+                }
+                bool is_enum = false;
+                if( cur->data().is_Tuple() ) {
+                }
+                else if( const auto* te = cur->data().opt_Path() ) {
+                    if( const auto* pbe = te->binding.opt_Struct() ) {
+                        const auto& str = **pbe;
+                        if( !(str.m_repr == ::HIR::Struct::Repr::Rust || str.m_repr == ::HIR::Struct::Repr::Transparent) )
+                            return nullptr;
+                        if( str.m_max_field_alignment != 0 || str.m_forced_alignment != 0 )
+                            return nullptr;
+                    }
+                    else if( te->binding.is_Enum() ) {
+                        is_enum = true;
+                    }
+                    else {
+                        return nullptr;
+                    }
+                }
+                else {
+                    return nullptr;
+                }
+                const auto* repr = Target_GetTypeRepr(sp, m_resolve, *cur);
+                if( !repr ) {
+                    return nullptr;
+                }
+                if( is_enum && !repr->variants.is_NonZero() ) {
+                    return nullptr;
+                }
+                // Must be exactly one non-zero-sized field, covering the whole type
+                const ::HIR::TypeRef* inner = nullptr;
+                for(const auto& f : repr->fields)
+                {
+                    size_t sz = 0, al = 0;
+                    if( !Target_GetSizeAndAlignOf(sp, m_resolve, f.ty, sz, al) )
+                        return nullptr;
+                    if( sz == 0 )
+                        continue;
+                    if( inner || f.offset != 0 || sz != repr->size )
+                        return nullptr;
+                    inner = &f.ty;
+                }
+                if( !inner ) {
+                    return nullptr;
+                }
+                cur = inner;
+            }
+            return nullptr;
+        }
+        bool get_cabi_sig(CAbiSig& out, const RcString& abi, bool is_variadic, const ::HIR::TypeRef& ret_ty, size_t n_args, ::std::function<::HIR::TypeRef(size_t)> get_arg) const
+        {
+            // NOTE: Variadic functions can't have a forwarding wrapper, so are left as-is
+            if( abi_is_rust_internal(abi) || is_variadic ) {
+                return false;
+            }
+            out.ret = get_cabi_scalar(ret_ty);
+            out.args.clear();
+            for(size_t i = 0; i < n_args; i ++) {
+                out.args.push_back( get_cabi_scalar(get_arg(i)) );
+            }
+            return out.any();
+        }
+        bool get_cabi_sig_fcn(CAbiSig& out, const ::HIR::Function& item, const MonomorphiserPP& params)
+        {
+            if( item.m_markings.is_naked ) {
+                return false;
+            }
+            ::HIR::TypeRef  tmp;
+            const auto& ret_ty = monomorphise_fcn_return(tmp, item, params);
+            return get_cabi_sig(out, item.m_abi, item.m_variadic, ret_ty, item.m_args.size(), [&](size_t i) {
+                return m_resolve.monomorph_expand(sp, item.m_args[i].second, params);
+                });
+        }
+        bool get_cabi_sig_fnptr(CAbiSig& out, const ::HIR::TypeData_FunctionPointer& te) const
+        {
+            return get_cabi_sig(out, te.m_abi, te.is_variadic, te.m_rettype, te.m_arg_types.size(), [&](size_t i) { return te.m_arg_types[i].clone(); });
+        }
+        /// Suffix to use when taking the address of a function (C ABI functions with a scalarised signature are reached through `__cabi`)
+        const char* fcn_addr_suffix(const ::HIR::Path& p)
+        {
+            MonomorphState  ms;
+            auto v = m_resolve.get_value(sp, p, ms, /*signature_only=*/true);
+            if( !v.is_Function() ) {
+                return "";
+            }
+            CAbiSig sig;
+            return get_cabi_sig_fcn(sig, *v.as_Function(), ms) ? "__cabi" : "";
+        }
+        /// Emit the body of a wrapper between the struct (`<name>`) and scalar (`<name>__cabi`) forms of a function's signature.
+        /// `to_cabi`: the wrapper has the struct signature and calls `<name>__cabi` (imported functions), otherwise the reverse.
+        void emit_cabi_wrapper_body(const ::HIR::Path& p, const ::HIR::Function& item, const Trans_Params& params, const CAbiSig& sig, bool to_cabi)
+        {
+            ::HIR::TypeRef  tmp;
+            const auto& ret_ty = monomorphise_fcn_return(tmp, item, params);
+            m_of << "{\n";
+            for(size_t i = 0; i < item.m_args.size(); i ++)
+            {
+                if( !sig.args[i] )
+                    continue;
+                auto ty = params.monomorph(m_resolve, item.m_args[i].second);
+                m_of << "\t"; emit_ctype(to_cabi ? *sig.args[i] : ty, FMT_CB(ss, ss << "carg" << i;)); m_of << ";";
+                m_of << " memcpy(&carg" << i << ", &arg" << i << ", sizeof(carg" << i << "));\n";
+            }
+            m_of << "\t";
+            if( sig.ret ) {
+                emit_ctype(to_cabi ? *sig.ret : ret_ty, FMT_CB(ss, ss << "crv";)); m_of << " = ";
+            }
+            else if( ret_ty != ::HIR::TypeRef::new_unit() ) {
+                m_of << "return ";
+            }
+            m_of << Trans_Mangle(p) << (to_cabi ? "__cabi" : "") << "(";
+            for(size_t i = 0; i < item.m_args.size(); i ++)
+            {
+                if( i != 0 )    m_of << ", ";
+                m_of << (sig.args[i] ? "carg" : "arg") << i;
+            }
+            m_of << ");\n";
+            if( sig.ret ) {
+                m_of << "\t"; emit_ctype(to_cabi ? ret_ty : *sig.ret, FMT_CB(ss, ss << "rv";)); m_of << ";";
+                m_of << " memcpy(&rv, &crv, sizeof(rv));\n";
+                m_of << "\treturn rv;\n";
+            }
+            m_of << "}\n";
+        }
