From a7fe6f60c180c9f97b12b6a615dc57ba84e1e9c8 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 31 Oct 2026 08:23:28 +0000
Subject: [PATCH] macro_rules: an `expr` fragment can be a raw borrow (`&raw
 mut e`, `&raw const e`)

pyo3-ffi 0.29.2 (py314-ast_serialize 0.13.1) src/object.rs:240 `debug_assert_ne!((*ob).ob_type, &raw mut
crate::PyLong_Type)` = "MACRO<::"core-0_0_0"::debug_assert_ne> BUG: src/macro_rules/eval.cpp:2422: TODO:
Macro_InvokeRules_MatchPattern - No arm matched - (9, 79), (9, 79)": core's assert_ne arms (`$left:expr, $right:expr
$(,)?` and `$left:expr, $right:expr, $($arg:tt)+`) both failed after 9 tokens with `mut` next. The arm matcher's
expression lookahead (consume_expr) knew `&`/`&&` plus an optional `mut` only, so `raw` was taken as a path
expression and the fragment ended before `mut`. The real parser (Parse_Expr12) has had the raw borrow operator all
along, so only macro `expr` fragments were affected.

consume_expr: after `&`/`&&`, an identifier `raw` followed by `mut` or `const` is the raw borrow operator and both
tokens are consumed; `raw` followed by anything else is still a path (`&raw` with a variable named raw).

Assisted-by: Claude Fable 5.1
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index bb322e1e..5fedded7 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -1462,6 +1462,18 @@ namespace
                 case TOK_DOUBLE_AMP:
                 case TOK_AMP:
                     lex.consume();
+                    // `&raw mut e` / `&raw const e`: `raw` is a keyword only before `mut`/`const` (as in Parse_Expr12)
+                    if( lex.next() == TOK_IDENT && lex.next_tok().ident() == "raw" )
+                    {
+                        auto lex2 = lex.clone();
+                        lex2.consume();
+                        if( lex2.next() == TOK_RWORD_MUT || lex2.next() == TOK_RWORD_CONST )
+                        {
+                            lex.consume();
+                            lex.consume();
+                            break;
+                        }
+                    }
                     lex.consume_if(TOK_RWORD_MUT);
                     break;
                 default:
