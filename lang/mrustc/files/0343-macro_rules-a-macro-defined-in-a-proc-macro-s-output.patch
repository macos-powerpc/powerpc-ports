From 9a9035c87c2a3e056f39e7cc1ed522d19c6d0d1a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 19:15:22 +0000
Subject: [PATCH] macro_rules: a macro defined in a proc macro's output keeps
 the call-site hygiene for its body

pydantic_core 2.46.5 src/validators/generator.rs:112 (py314-pydantic_core): `#[pymethods] impl ValidatorIterator { fn
__next__(mut slf: PyRefMut<'_, Self>, py: Python) -> .. { .. macro_rules! next { ($iter:ident) => { match
$iter.next(py)? { .. } } } .. next!(iter) .. } }` = "MACRO<::"_pydantic_core-2_46_5"::next> error:0: Couldn't find
variable name 'py'". Proc-macro output tokens have the empty hygiene, which is mrustc's call-site marker:
an empty-hygiene identifier may see the caller's locals (resolve/absolute.cpp `src_is_call_site`, 83b358d9).
A `macro_rules!` defined in that output took the empty hygiene as its definition site, and each expansion gave the body
a new scope chained from it: an empty-hygiene binding is visible to empty identifiers only, so the body saw none of
the output's locals (parameters or `let`s, in any attribute/derive/function-like output). Not a regression: 0324 fails
the same way.

MacroExpander: when the definition hygiene is empty and has no module path (source files always have a scope, another
crate's macros a module path) and it isn't a `macro` 2.0 item, the body's identifiers, lifetimes and string literals
keep it, and the stream reports it, so the body resolves like the output around it. (A first attempt gave each proc
macro invocation a fresh scope instead; that broke pm-byte-literal-test, whose function-like macro output names the
caller's local, the case the call-site rule exists for.)

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 45034357..506710fb 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -548,6 +548,12 @@ class MacroExpander:
     AST::Edition    m_source_edition;
     bool m_is_macro_item;
     Ident::Hygiene  m_hygiene;
+    /// The macro was defined in a proc macro's output (empty hygiene, no module path: source files always have
+    /// a scope, another crate's macros a module path). Its body keeps that call-site hygiene: an empty-hygiene identifier
+    /// can see the caller's locals (resolve/absolute.cpp `src_is_call_site`), which are the definition site's here,
+    /// where a new scope chained from nothing saw none of them. pydantic_core 2.46.5 generator.rs: `macro_rules! next`
+    /// inside a `#[pymethods]` method, "Couldn't find variable name 'py'".
+    bool m_def_is_call_site;
 
 public:
     MacroExpander(const MacroExpander& x) = delete;
@@ -573,7 +579,8 @@ public:
         m_state( contents, m_mappings ),
         m_source_edition( source_edition ),
         m_is_macro_item(is_macro_item),
-        m_hygiene( Ident::Hygiene::new_scope_chained(parent_hygiene) )
+        m_hygiene( Ident::Hygiene::new_scope_chained(parent_hygiene) ),
+        m_def_is_call_site( !is_macro_item && parent_hygiene == Ident::Hygiene() && !parent_hygiene.has_mod_path() )
     {
     }
 
@@ -2553,6 +2560,10 @@ Ident::Hygiene MacroExpander::realGetHygiene() const
     {
         return m_ttstream->get_hygiene();
     }
+    else if( m_def_is_call_site )
+    {
+        return m_hygiene.get_parent();
+    }
     else
     {
         return m_hygiene;
@@ -2589,7 +2600,7 @@ Token MacroExpander::realGetToken()
                 // Rewrite the hygiene of an ident such that idents in the macro explicitly are unique for each expansion
                 // - Appears to be a valid option.
                 auto ident = e.ident();
-                if( ident.hygiene == m_hygiene.get_parent() || m_is_macro_item )
+                if( !m_def_is_call_site && (ident.hygiene == m_hygiene.get_parent() || m_is_macro_item) )
                 {
                     ident.hygiene = m_hygiene;
                 }
@@ -2600,7 +2611,7 @@ Token MacroExpander::realGetToken()
             case TOK_BYTESTRING:
             case TOK_STRING: {
                 auto h = e.str_hygiene();
-                if( h == m_hygiene.get_parent() || m_is_macro_item )
+                if( !m_def_is_call_site && (h == m_hygiene.get_parent() || m_is_macro_item) )
                 {
                     h = m_hygiene;
                 }
