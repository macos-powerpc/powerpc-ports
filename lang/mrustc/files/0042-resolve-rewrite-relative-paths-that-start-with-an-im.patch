From d6fb5631d3e92cd1a2520c5df948e61cba496957 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 04:58:44 +0000
Subject: [PATCH 42/43] resolve: rewrite relative paths that start with an
 imported primitive

Follow-up to the previous commit. libyaml-rs 0.3.0 imports a re-exported
primitive into another module (`use crate::yaml::ptrdiff_t;`, where
`yaml` has `pub use core::primitive::{i64 as ptrdiff_t, ...}`) and then
calls `ptrdiff_t::from(..)`. The relative path's first component resolves
to `::"#builtins"::i64`, the remaining components were appended to that,
and binding the result tripped the `#builtins` assertion in
Resolve_Absolute_Path_BindAbsolute.

Turn it into a UFCS path on the primitive (`<i64>::from`), as is already
done when the first component is a local type.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/resolve/absolute.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/resolve/absolute.cpp b/src/resolve/absolute.cpp
index f52bf4cc..232a49af 100644
--- a/src/resolve/absolute.cpp
+++ b/src/resolve/absolute.cpp
@@ -1910,6 +1910,16 @@ void Resolve_Absolute_Path(/*const*/ Context& context, const Span& sp, Context::
                 if( p.m_class.is_Local() ) {
                     p = ::AST::Path::new_ufcs_ty( TypeRef(sp, mv$(p)) );
                 }
+                // An imported primitive (e.g. `use core::primitive::i64 as ptrdiff_t;`): `ptrdiff_t::from` is `<i64>::from`
+                else if( p.m_class.is_Absolute() && p.m_class.as_Absolute().crate == CRATE_BUILTINS ) {
+                    ASSERT_BUG(sp, p.nodes().size() == 1, "Unexpected builtin path " << p);
+                    auto ct = coretype_fromstring(p.nodes()[0].name().c_str());
+                    ASSERT_BUG(sp, ct != CORETYPE_INVAL, "Unknown builtin type " << p);
+                    if( ! e.nodes[0].args().is_empty() ) {
+                        ERROR(sp, E0000, "Type parameters were not expected here");
+                    }
+                    p = ::AST::Path::new_ufcs_ty( TypeRef(sp, ct) );
+                }
                 if( ! e.nodes[0].args().is_empty() )
                 {
                     assert( p.nodes().size() > 0 );
