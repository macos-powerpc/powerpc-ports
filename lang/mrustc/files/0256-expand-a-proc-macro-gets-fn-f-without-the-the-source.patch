From 14018c019546c91c2390297f24ab08246de6f3dc Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 11:46:53 +0000
Subject: [PATCH] expand: a proc macro gets `fn f() {}` without the `-> ()` the source
 never wrote

ctor 0.6.3 (tree-sitter-cli 0.27.1), crates/cli/src/fuzz/allocations.rs:10
`#[ctor::ctor] unsafe fn initialize_allocation_recording() { .. }`:

    MACRO<..::__support::ctor_entry> BUG: src/macro_rules/eval.cpp:2353:
    TODO: Macro_InvokeRules_MatchPattern - No arm matched - (13, 82),
    (13, 82), (13, 82), (13, 82), (13, 82), (23, 40), (0, 14), (0, 14),
    (19, 89)

ctor-proc-macro 0.0.7 re-emits the item tokens it was given inside
`::ctor::__support::ctor_parse!(#[ctor] ..)`; that chain ends in
`ctor_entry!`'s arm `unsafe=$($unsafe:ident)?, item=fn $ident:ident()
$block:block`. Token 23 of its input was `->` (TOK_THINARROW): the
proc-macro bridge's visit_function sent every function with a return
type, so the parser's implicit unit became `fn name() -> () { .. }` and
no arm matched. rustc hands an attribute macro the source tokens.

AST::Function now records whether the source had a `->`
(Parse_FunctionDef sets it; clone() copies it) and the bridge sends
the arrow and type only then. An explicit `-> ()` is still sent.

Seen on the way, not changed: a `&self` receiver reaches the macro as
`self: &(Self)` (TODO L9).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/ast/ast.cpp b/src/ast/ast.cpp
index effd32e9..d70beace 100644
--- a/src/ast/ast.cpp
+++ b/src/ast/ast.cpp
@@ -259,6 +259,7 @@ Function Function::clone() const
     }
 
     auto rv = Function( m_span, m_abi, m_flags, m_params.clone(), m_rettype.clone(), mv$(new_args), m_is_variadic );
+    rv.m_ret_implicit = m_ret_implicit;
     if( m_code.is_valid() ) {
         rv.m_code = AST::Expr( m_code.node().clone() );
     }
diff --git a/src/ast/ast.hpp b/src/ast/ast.hpp
index 682e2289..9491cbaf 100644
--- a/src/ast/ast.hpp
+++ b/src/ast/ast.hpp
@@ -237,6 +237,9 @@ private:
 
     ::std::string   m_abi;
     Flags   m_flags;
+    // The source had no `->`: the unit return type was supplied by the parser (a proc-macro attribute's input must
+    // not grow a `-> ()` the source never had; ctor 0.6.3 matches the item with `fn $ident:ident() $block:block`)
+    bool    m_ret_implicit = false;
 public:
     struct Markings {
         enum Inline {
@@ -283,6 +286,8 @@ public:
     const Arglist& args() const { return m_args; }
           Arglist& args()       { return m_args; }
     bool is_variadic() const { return m_is_variadic; }
+    bool is_ret_implicit() const { return m_ret_implicit; }
+    void set_ret_implicit(bool v) { m_ret_implicit = v; }
 
     Function clone() const;
 };
diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 7e761d8b..9f3b5676 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -1699,10 +1699,13 @@ namespace {
                 m_pmi.send_symbol("...");
             }
             m_pmi.send_symbol(")");
-            //if( fcn.rettype() != TypeRef() ) {
+            // Only a return type the source wrote: `fn foo() {}` used to be sent as `fn foo() -> () {}`, which
+            // ctor 0.6.3's `ctor_entry!` (`item=fn $ident:ident() $block:block`, tree-sitter-cli 0.27.1
+            // fuzz/allocations.rs `#[ctor::ctor] unsafe fn ..`) could not match
+            if( !fcn.is_ret_implicit() ) {
                 m_pmi.send_symbol("->");
                 this->visit_type(fcn.rettype());
-            //}
+            }
             this->visit_bounds(fcn.params());
             // A trait method declaration has no body - send `;` rather than dereferencing an absent node.
             if( fcn.code().is_valid() ) {
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index d54dfc72..3afddc9c 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -613,7 +613,8 @@ AST::Function Parse_FunctionDef(TokenStream& lex, bool allow_self, bool can_be_p
     }
 
     // Return type
-    TypeRef ret_type = lex.getTokenIf(TOK_THINARROW)
+    bool has_ret_type = lex.getTokenIf(TOK_THINARROW);
+    TypeRef ret_type = has_ret_type
         ? Parse_Type(lex)
         : TypeRef(TypeRef::TagUnit(), lex.point_span())
         ;
@@ -625,7 +626,9 @@ AST::Function Parse_FunctionDef(TokenStream& lex, bool allow_self, bool can_be_p
     }
     
 
-    return AST::Function(lex.end_span(ps), mv$(abi), mv$(flags), mv$(params), mv$(ret_type), mv$(args), is_variadic);
+    auto rv = AST::Function(lex.end_span(ps), mv$(abi), mv$(flags), mv$(params), mv$(ret_type), mv$(args), is_variadic);
+    rv.set_ret_implicit(!has_ret_type);
+    return rv;
 }
 
 AST::Function Parse_FunctionDefWithCode(TokenStream& lex, bool allow_self, std::string abi, AST::Function::Flags flags)
