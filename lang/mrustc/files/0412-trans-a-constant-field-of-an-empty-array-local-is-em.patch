From 6a059ac42dc477ded5a9ca2bb17b75efdfb3e7ba Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 30 Oct 2026 19:50:05 +0000
Subject: [PATCH 412/415] trans: a constant field of an empty array local is
 emitted as a dummy of the element type

bs58 0.4.0 (ares 0.10.0) alphabet.rs:153 `Alphabet::new_unwrap`:
    [][match result { Ok(alphabet) => return alphabet, Err(_) => 0 }]
    .rlib.c: error: 'var1' undeclared   (rv = var1.DATA[0]; // retval = Use(_1.0))

The `[Alphabet; 0]` temporary is a ZST, so codegen never declares it (its
struct is `char _d`, without `DATA`). The index is a known constant, which the
optimiser's known-value pass folds from `_1[_n]` into `_1.0`; the Index arm of
emit_lvalue already had the konst 0.2.20 guard for an empty array, the Field
arm did not.

The Field arm gets the same guard: `(*(T*)0)`, the access is unreachable once
the index is checked (plain and -O both failed before).

Assisted-by: Claude Fable 5.1
---

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 08de2793..cc36e4b8 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -9044,8 +9044,16 @@ namespace {
                     m_of << "[" << field_index << "]";
                 }
                 else if( ty.data().is_Array() ) {
-                    emit_lvalue(inner);
-                    m_of << ".DATA[" << field_index << "]";
+                    if( ty.data().as_Array().size.is_Known() && ty.data().as_Array().size.as_Known() == 0 && this->type_is_bad_zst(ty) ) {
+                        // A constant index into an empty array (the `Index` arm's case after the optimiser folded
+                        // the index): the array isn't declared, and the access is dead after its bounds check.
+                        // bs58 0.4.0 `new_unwrap`: `[][match result { Ok(a) => return a, Err(_) => 0 }]` (ares)
+                        m_of << "(*("; emit_ctype(ty.data().as_Array().inner); m_of << "*)0 /* field of an empty array */)";
+                    }
+                    else {
+                        emit_lvalue(inner);
+                        m_of << ".DATA[" << field_index << "]";
+                    }
                 }
                 else if( const auto* repr = this->dyn_tail_field_repr(ty, field_index) ) {
                     // The trait object tail (or the struct holding it) of an unsized struct: its offset is the end of
