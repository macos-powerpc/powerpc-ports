From 589af0ea0c9e9dfd415cd22303022d8f49a0ec4f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 15:10:55 +0000
Subject: [PATCH 127/128] trans: #[no_mangle] functions are roots of an
 executable

pngquant 3.0.3 rust/rwpng_cocoa.rs (feature "cocoa"):

    #[no_mangle]
    pub extern "C" fn rwpng_read_image32_cocoa(file_handle: *mut FILE, ..) -> pngquant_error { .. }

is only called from rwpng.c, compiled by the build script into
libpngquant.a. For an executable mrustc enumerated only what's reachable
from main (and the start lang item), so the function was never emitted:
"Undefined symbols for architecture ppc: _rwpng_read_image32_cocoa,
referenced from _rwpng_read_image24 in libpngquant.a(rwpng.o)". rustc
emits #[no_mangle]/#[export_name] items in every crate type.

Trans_Enumerate_Main now also roots every non-generic function with a body
and an explicit link name, in all modules (extern block imports, which
have link names but no body, are left out).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/trans/enumerate.cpp | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/src/trans/enumerate.cpp b/src/trans/enumerate.cpp
index 34eb08d4..e5c10a3a 100644
--- a/src/trans/enumerate.cpp
+++ b/src/trans/enumerate.cpp
@@ -155,11 +155,45 @@ namespace MIR {
 }
 
 /// Enumerate trans items starting from `::main` (binary crate)
+namespace {
+    /// Functions with an explicit symbol name (`#[no_mangle]`, `#[export_name]`) are roots of an executable too, as
+    /// rustc emits them: they can be called from linked C code without being reachable from `main`.
+    /// - pngquant 3.0.3: `#[no_mangle] pub extern "C" fn rwpng_read_image32_cocoa` (rust/rwpng_cocoa.rs), called by
+    ///   rwpng.c in the build script's libpngquant.a
+    void Trans_Enumerate_LinkNamed_Mod(EnumState& state, const ::HIR::Module& mod, const ::HIR::SimplePath& mod_path)
+    {
+        for(const auto& vi : mod.m_value_items)
+        {
+            if( const auto* e = vi.second->ent.opt_Function() )
+            {
+                // Only definitions (an extern block's imports have link names too) that aren't generic
+                if( e->m_linkage.name != "" && e->m_code.m_mir && !e->m_params.is_generic() )
+                {
+                    auto p = mod_path + vi.first;
+                    DEBUG("Link-named function " << p << " = " << e->m_linkage.name);
+                    Trans_Params pp;
+                    pp.pp_method = e->m_params.make_empty_params(/*lifetimes_only=*/true);
+                    state.enum_fcn(p, *e, mv$(pp));
+                    state.rv.m_roots.push_back(p);
+                }
+            }
+        }
+        for(const auto& ti : mod.m_mod_items)
+        {
+            if( const auto* e = ti.second->ent.opt_Module() )
+            {
+                Trans_Enumerate_LinkNamed_Mod(state, *e, mod_path + ti.first);
+            }
+        }
+    }
+}
+
 TransList Trans_Enumerate_Main(const ::HIR::Crate& crate)
 {
     static Span sp;
 
     EnumState   state { crate };
+    Trans_Enumerate_LinkNamed_Mod(state, crate.m_root_module, ::HIR::SimplePath(crate.m_crate_name, {}));
 
     auto c_start_path = crate.get_lang_item_path_opt("mrustc-start");
     if( c_start_path == ::HIR::SimplePath() )
