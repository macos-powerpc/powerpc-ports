From 7280fabcb22d7ea70872359fe34d6b4fa67a43f6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 10:21:15 +0000
Subject: [PATCH] minicargo: prefer the workspace member that builds a binary
 named after the directory

sd 1.1.0 is a virtual workspace:

    members = ["sd", "sd-cli", "xtask"]
    sd/Cargo.toml       name = "sd"       (library only)
    sd-cli/Cargo.toml   name = "sd-cli"   [[bin]] name = "sd", path = "src/main.rs"

With no `--package`, minicargo picked the member whose package name matches
the directory (`sd-1.1.0` -> `sd`). That's the library, so the build
succeeded without producing any binary, and the port's destroot failed
("xinstall: Cannot stat: .../release/sd"). cargo builds every member.

Before the package name match, minicargo now picks the one member that
builds a binary with the directory's name: a `[[bin]]` name, or the
package name when `src/main.rs` exists. That binary is what a port
installs. If no member has such a binary, or more than one does, the old
rules apply. `--package` and `default-members` still take precedence.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tools/minicargo/main.cpp | 33 +++++++++++++++++++++++++++------
 1 file changed, 27 insertions(+), 6 deletions(-)

diff --git a/tools/minicargo/main.cpp b/tools/minicargo/main.cpp
index 85fd41e0..cda71393 100644
--- a/tools/minicargo/main.cpp
+++ b/tools/minicargo/main.cpp
@@ -228,6 +228,8 @@ int main(int argc, const char* argv[])
                     ::std::string   rel_path;
                     ::std::string   name;
                     bool    has_bin;
+                    /// `[[bin]]` names, and the package name for `src/main.rs`
+                    ::std::vector<::std::string>    bin_names;
                 };
                 ::std::vector<Candidate>    candidates;
                 // Expand glob members (`crates/*`, `crates/jql-*`): a pattern in the last path component matches the
@@ -265,15 +267,21 @@ int main(int argc, const char* argv[])
                         continue;
                     Candidate   c;
                     c.rel_path = member;
-                    c.has_bin = ::std::ifstream((member_dir / "src" / "main.rs").str()).is_open();
+                    bool has_main_rs = ::std::ifstream((member_dir / "src" / "main.rs").str()).is_open();
+                    c.has_bin = has_main_rs;
                     TomlFile    toml_file(member_toml);
                     for(auto key_val : toml_file)
                     {
                         if( key_val.path.size() == 2 && key_val.path[0] == "package" && key_val.path[1] == "name" )
                             c.name = key_val.value.as_string();
-                        else if( key_val.path[0] == "bin" )
+                        else if( key_val.path[0] == "bin" ) {
                             c.has_bin = true;
+                            if( key_val.path.size() == 3 && key_val.path[2] == "name" )
+                                c.bin_names.push_back(key_val.value.as_string());
+                        }
                     }
+                    if( has_main_rs )
+                        c.bin_names.push_back(c.name);
                     candidates.push_back(::std::move(c));
                 }
 
@@ -321,8 +329,7 @@ int main(int argc, const char* argv[])
                 }
                 if( !sel )
                 {
-                    // Prefer the member whose package name matches the workspace directory
-                    // name (with any `-<version>` suffix removed, as in release tarballs:
+                    // The workspace directory name, with any `-<version>` suffix removed (as in release tarballs:
                     // `kalker-2.2.2` -> `kalker`)
                     auto dir_name = dir.basename();
                     for(size_t pos = dir_name.find('-'); pos != ::std::string::npos; pos = dir_name.find('-', pos+1))
@@ -332,9 +339,23 @@ int main(int argc, const char* argv[])
                             break;
                         }
                     }
+                    // Prefer the one member that builds a binary with that name (what a port installs), which isn't
+                    // always the member with that name
+                    // - sd 1.1.0: `sd` is the library, `sd-cli` has `[[bin]] name = "sd"`
                     for(const auto& c : candidates)
-                        if( c.name == dir_name )
-                            { sel = &c; break; }
+                    {
+                        if( ::std::find(c.bin_names.begin(), c.bin_names.end(), dir_name) != c.bin_names.end() ) {
+                            if( sel ) { sel = nullptr; break; }
+                            sel = &c;
+                        }
+                    }
+                    // Then the member whose package name matches it
+                    if( !sel )
+                    {
+                        for(const auto& c : candidates)
+                            if( c.name == dir_name )
+                                { sel = &c; break; }
+                    }
                 }
                 if( !sel )
                 {
