From dacb5833088822e3cc99075eb458d4cf6640ecb7 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 18:46:29 +0000
Subject: [PATCH] trans: mangle item names with non-ASCII characters
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

half 2.7.1 (recall-cli) died in codegen with
"BUG: src/trans/mangling_v2.cpp:92: Encounteded invalid character in symbol name while
mangling: 'á' in 'ẕ0'". zerocopy-derive (0.8.32+, here 0.8.62) names its per-field
projection markers `ẕ` + the field name and uses them as generic arguments of the
HasField/ProjectField impls it emits from the TryFromBytes derive (which FromZeros/FromBytes
go through); half's `#[derive(FromBytes, ..)] pub struct f16(u16)` gets `enum ẕ0 {}`. Rust
accepts non-ASCII identifiers, the mangler only alphanumerics, `_`, `#` and `-`.

A name containing any byte >= 0x80 is now encoded as `_ <len> _ <escaped>`: alphanumerics
are copied, `_` is doubled and every other byte becomes `_` plus two lower-case hex digits
(`ẕ0` -> `_10__e1_ba_950`). Back-references are `_` followed by a letter, so `_` followed
by a digit was unused at a name position. ASCII names mangle exactly as before.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/trans/mangling_v2.cpp b/src/trans/mangling_v2.cpp
index 357423f3..384600db 100644
--- a/src/trans/mangling_v2.cpp
+++ b/src/trans/mangling_v2.cpp
@@ -72,14 +72,21 @@ public:
     // - "<len:int> <raw_data>" (fully valid identifier)
     // - "<ofs:base26> <len:int> <raw_data1> <raw_data2>" (`#` or `-` present)
     // - "<len:base26> `_` <raw_data2>" (`#` or `-` at the start)
+    // - "`_` <len:int> `_` <escaped>" (non-ASCII identifier, e.g. zerocopy-derive's `enum ẕ0 {}`)
+    //   > Alphanumerics are copied, `_` is doubled, and any other byte is `_` followed by two lower-case hex digits
+    //   > Back-references are `_` followed by a letter, so `_` followed by a digit is free
     void fmt_name(const char* const s)
     {
         size_t size = strlen(s);
         const char* hash_pos = nullptr;
+        bool has_non_ascii = false;
         // Search the string for a '#' or '-' character (only one allowed)
         for(const auto* p = s; *p; p++)
         {
-            if( isalnum(*p) ) {
+            if( static_cast<unsigned char>(*p) >= 0x80 ) {
+                has_non_ascii = true;
+            }
+            else if( isalnum(*p) ) {
             }
             else if( *p == '_' ) {
             }
@@ -93,6 +100,28 @@ public:
             }
         }
 
+        if( has_non_ascii )
+        {
+            std::string escaped;
+            for(const auto* p = s; *p; p++)
+            {
+                auto c = static_cast<unsigned char>(*p);
+                if( c < 0x80 && isalnum(c) ) {
+                    escaped += char(c);
+                }
+                else if( c == '_' ) {
+                    escaped += "__";
+                }
+                else {
+                    escaped += '_';
+                    escaped += "0123456789abcdef"[c >> 4];
+                    escaped += "0123456789abcdef"[c & 0xF];
+                }
+            }
+            m_os << '_' << escaped.size() << '_' << escaped;
+            return ;
+        }
+
         // If there's a hash, then encode such that it's removed
         if( hash_pos != nullptr )
         {
