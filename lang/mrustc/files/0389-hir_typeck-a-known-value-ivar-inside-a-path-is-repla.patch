From c185f25ed13e5e56ac4f802f305e4b13fca34099 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 04:19:18 +0000
Subject: [PATCH] hir_typeck: a known value ivar inside a path is replaced when
 associated types are expanded

crypto-bigint 0.5.5 (localsend-cli 1.18.2) src/uint/mul.rs:287:

    impl<const LIMBS: usize, const HLIMBS: usize> Mul<Uint<HLIMBS>> for Uint<LIMBS>
    where Uint<HLIMBS>: ConcatMixed<Uint<LIMBS>>
    {
        type Output = <Uint<HLIMBS> as ConcatMixed<Self>>::MixedOutput;
        fn mul(self, other: Uint<HLIMBS>) -> Self::Output { Uint::mul(&self, &other) }
    }

died with

    BUG: ASSERT FAIL: src/hir_typeck/helpers.cpp:3147: Set opaque on a non-generic type:
    <Uint<{Infer(1)}> as ConcatMixed<Uint<{Infer(0)}>>>::MixedOutput

The inherent `Uint::mul<const HLIMBS>` returns `<Uint<HLIMBS> as ConcatMixed<Self>>::MixedOutput`
under a where-bound. At the call both const parameters are value ivars, and the argument coercions
bind them to the impl's LIMBS/HLIMBS before the projection is expanded.
expand_associated_types_inplace replaces a bound TYPE ivar with its value (the Infer arm), but its
path-parameter helper walked only the type arguments, so the projection kept `{Infer(N)}`. The
impl's where-bound then matched (compare_with_placeholders resolves value ivars), the item has no
binding there, so the projection was made opaque, and the sanity assertion inspecting the raw type
found neither a generic nor an unknown in it.

expand_associated_types_params now replaces a known value ivar by its value, as expand_ivars_params
has done since the pyo3 get_slot fix.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index 8ef2be66..0d65d159 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -2340,6 +2340,24 @@ void TraitResolution::expand_associated_types_inplace(const Span& sp, ::HIR::Typ
         {
             for(auto& arg : params.m_types)
                 res.expand_associated_types_inplace(sp, arg, stack);
+            // A known value ivar is replaced as a known type ivar is (the `Infer` arm below): otherwise the projection
+            // keeps `{Infer(N)}` after the ivar was bound, and the bound-derived opaque name then holds neither
+            // a generic nor an unknown.
+            // - crypto-bigint 0.5.5 uint/mul.rs:287 `impl<const LIMBS: usize, const HLIMBS: usize> Mul<Uint<HLIMBS>>
+            //   for Uint<LIMBS> where Uint<HLIMBS>: ConcatMixed<Uint<LIMBS>> { fn mul(self, other) { Uint::mul(&self,
+            //   &other) } }`: the inherent method's `<Uint<HLIMBS> as ConcatMixed<Self>>::MixedOutput` was expanded
+            //   with both value ivars already set to the impl's parameters -> "Set opaque on a non-generic type:
+            //   <Uint<{Infer(1)}> as ConcatMixed<Uint<{Infer(0)}>>>::MixedOutput"
+            for(auto& v : params.m_values)
+            {
+                if( v.is_Infer() && v.as_Infer().index != ~0u )
+                {
+                    const auto& known = res.m_ivars.get_value(v);
+                    if( !known.is_Infer() ) {
+                        v = known.clone();
+                    }
+                }
+            }
         }
         static void expand_associated_types_tp(const Span& sp, const TraitResolution& res, ::HIR::TraitPath& input, LList<const ::HIR::TypeRef*> stack)
         {
