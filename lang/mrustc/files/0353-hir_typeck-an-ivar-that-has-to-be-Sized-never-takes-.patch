                         DEBUG("Most accepting pointer class, and most permissive inner type - " << *ent.ty);
                         context.equate_types(sp, ty_l, *ent.ty);
@@ -7662,7 +7679,7 @@ namespace
                 }
                 // TODO: Unsized types? Don't pick an unsized if coercions are present?
