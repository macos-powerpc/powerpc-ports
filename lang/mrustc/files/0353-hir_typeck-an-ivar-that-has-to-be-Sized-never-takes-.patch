         /// TODO: If in fallback mode, there's no infer options, and there are bounds - Pick a random bound
 
+        // An ivar used where the value has to be Sized (`Vec<T>`'s `T`, a call's result, a tuple field) can't take an unsized
+        // possibility. Every rule below that picks a type without `check_ivar_poss__fails_bounds` (which tests this) skips
+        // such a type: `&_ -> &str` destinations and a bound's impl list (`String: PartialEq<_>` = str, &str, String..) gave
+        // `str` while the real type was still to come from a method paused on a fuzzy impl (tsrs 0.18.0 kqueue.rs
+        // `let mut to_remove = Vec::new(); to_remove.extend(..); for p in to_remove { .. *d == &p .. remove(&p) }`).
+        const bool allow_unsized = !(i < context.m_ivars_sized.size() ? context.m_ivars_sized.at(i) : false);
+        auto unsized_for_sized = [&](const ::HIR::TypeRef& t)->bool {
+            if( !allow_unsized && context.m_resolve.type_is_sized(sp, t) == ::HIR::Compare::Unequal ) {
+                DEBUG(i << ": " << t << " is unsized, the ivar has to be Sized");
+                return true;
+            }
+            return false;
+            };
+
         // ---
         // Always rules:
         // ---
@@ -7114,7 +7128,7 @@ namespace
