-                    if(t.ty == t2.ty && t.ty != ty_l)
+                    if(t.ty == t2.ty && t.ty != ty_l && !unsized_for_sized(t.ty))
                     {
                         DEBUG("- Source/Destination type");
                         context.equate_types(sp, ty_l, t.ty);
@@ -7164,9 +7178,6 @@ namespace
