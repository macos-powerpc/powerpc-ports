             }
 
             // TODO: This shouldn't just return, instead the above null placeholders should be tested
@@ -7583,7 +7600,7 @@ namespace
                     }
                     else {
                     }
-                    if( is_max_accepting )
+                    if( is_max_accepting && !unsized_for_sized(*ent.ty) )
