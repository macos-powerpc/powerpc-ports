+namespace {
+    /// Does the type still contain a (non-literal) inference variable, following ivars that are already bound?
+    bool type_contains_unbounded_ivars(const HMTypeInferrence& ivars, const ::HIR::TypeRef& ty)
+    {
+        return visit_ty_with(ty, [&](const ::HIR::TypeRef& t)->bool {
+            const auto& r = ivars.get_type(t);
+            if( type_is_unbounded_infer(r) )
+                return true;
+            // A bound ivar: the walker doesn't see its value, look inside it
+            if( t.data().is_Infer() && !r.data().is_Infer() )
+                return type_contains_unbounded_ivars(ivars, r);
+            return false;
+            });
+    }
+}
