From 8b354600a7dbe36f75680d4a36ba12415f7cbaca Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 03:51:51 +0000
Subject: [PATCH] hir_typeck: a deref coercion may end at an integer/float
 literal ivar

goblin 0.10.5 (py314-maturin 1.15.0) died in typeck:

    elf/header.rs:527:74 error:0: Type mismatch between usize and &mut _/*4:i*/

in `Header::parse`:

    let mut offset = &mut 0;
    for i in 0..SIZEOF_IDENT {
        elf_header.e_ident[i] = bytes.gread(&mut offset)?;
    }
    ...
    elf_header.e_type = bytes.gread_with(offset, endianness)?;

`&mut offset` is `&mut &mut {integer}` passed as scroll's `offset: &mut usize`.
rustc unifies every autoderef level of the source with the destination in
turn, and `{integer}` unifies with `usize`. check_unsize_tys' deref loop
skipped the literal level ("Different types": an Infer tag is not a
Primitive tag), ran out of derefs and fell back to equating `&mut {integer}`
with `usize`.

A level that is a literal ivar (or borrows of one: it can't deref any
further) and is the first level that fits the destination
(`first_unifiable == count`) is now equated with the destination and
gets the deref coercion. When a shallower level already fits (a
destination holding a plain ivar, `&&&{integer}` to `&&_`), the old path
is kept, as rustc would unify there.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 4588dea7..45d2fc12 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -4511,8 +4511,27 @@ namespace {
 
                 types.push_back( out_ty.clone() );
 
+                // A literal ivar can't deref, so a level that is one (or borrows of one) and is the first level that
+                // fits the destination is where rustc unifies (it tries every autoderef level in turn, and
+                // `{integer}` unifies with any integer type).
+                // goblin 0.10.5 elf/header.rs:527 (py314-maturin) `bytes.gread(&mut offset)` with
+                // `let mut offset = &mut 0;` (`&mut &mut {integer}` to `&mut usize`) fell through to equality,
+                // "Type mismatch between usize and &mut _".
+                const auto* lit_p = &out_ty;
+                while( lit_p->data().is_Borrow() )
+                {
+                    lit_p = &context.m_ivars.get_type(lit_p->data().as_Borrow().inner);
+                }
+                if( TU_TEST1(lit_p->data(), Infer, .is_lit()) && first_unifiable == count )
+                {
+                    DEBUG("Literal level fits - " << dst << " == " << out_ty);
+                    if( context_mut )
+                    {
+                        context_mut->equate_types(sp, dst, out_ty);
+                    }
+                }
                 // Types aren't equal
-                if( context.m_ivars.types_equal(dst, out_ty) == false )
+                else if( context.m_ivars.types_equal(dst, out_ty) == false )
                 {
                     // Check if they can be considered equivalent.
                     // - E.g. a fuzzy match, or both are slices/arrays
