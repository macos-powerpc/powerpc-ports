From f6b28ed13bde9646d85767898a897f9bbd026257 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 8 Oct 2026 20:37:13 +0000
Subject: [PATCH 149/149] minicargo: package-level `[patch.crates-io] x = {
 path = .. }`

Only a workspace's `[patch]` table was honoured; a package's own hit
`eh.todo("Support repository patches")`. gccrs's ffi-polonius has no
workspace and maps log, datafrog, polonius-engine and rustc-hash to its
`vendor/` copies that way. Parse it like the workspace table and apply
it through `Repository::add_patch_path`. A patch pointing at a directory
the `--vendor-dir` already registered is skipped, so the same package is
never loaded twice (a second manifest object would make it build twice).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 tools/minicargo/main.cpp       |  4 ++++
 tools/minicargo/manifest.cpp   | 27 +++++++++++++++++++++++++--
 tools/minicargo/manifest.h     |  3 +++
 tools/minicargo/repository.cpp | 14 ++++++++++++++
 4 files changed, 46 insertions(+), 2 deletions(-)

diff --git a/tools/minicargo/main.cpp b/tools/minicargo/main.cpp
index cda71393..5c0a4c10 100644
--- a/tools/minicargo/main.cpp
+++ b/tools/minicargo/main.cpp
@@ -383,6 +383,10 @@ int main(int argc, const char* argv[])
         // 1. Load the Cargo.toml file from the passed directory
         Debug_SetPhase("Load Root");
         auto m = PackageManifest::load_from_toml( dir / "Cargo.toml", &workspace_manifest );
+        // The package's own `[patch.crates-io]` (a workspace's was applied above)
+        for(const auto& p : m.patches()) {
+            repo.add_patch_path(p.first, p.second);
+        }
         m.set_features(opts.features, !opts.no_default_features);
 
         if(false)
diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index 9ef382a6..79db3982 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -848,8 +848,31 @@ void PackageManifest::fill_from_kv(ErrorHandler& eh, const WorkspaceManifest* wm
         }
         else if( section == "patch" )
         {
-            //const auto& repo = key_val.path[1];
-            eh.todo("Support repository patches");
+            // `[patch.crates-io] name = { path = ".." }` on a package, not only on a workspace
+            // - gccrs ffi-polonius: its vendored copies of log/datafrog/polonius-engine/rustc-hash
+            if( key_val.path.size() < 4 ) {
+                eh.error("Too-short path ", key_val.path);
+            }
+            else {
+                const auto& repo_name = key_val.path[1];
+                const auto& package_name = key_val.path[2];
+                if( key_val.path[3] == "path" && key_val.path.size() == 4 ) {
+                    if( key_val.value.m_type != TomlValue::Type::String ) {
+                        eh.error(key_val.path, ": Incorrect type ", key_val.value);
+                    }
+                    else if( repo_name == "crates-io" ) {
+                        auto p = m_manifest_dir / key_val.value.as_string();
+                        DEBUG("Override " << package_name << " = path " << p);
+                        rv.m_patches.emplace( package_name, ::std::move(p) );
+                    }
+                    else {
+                        DEBUG("TODO: Handle patching other types of dependencies");
+                    }
+                }
+                else {
+                    eh.todo("Support non-path repository patches");
+                }
+            }
         }
         else if( section == "profile" )
         {
diff --git a/tools/minicargo/manifest.h b/tools/minicargo/manifest.h
index e22b2e05..af4f913f 100644
--- a/tools/minicargo/manifest.h
+++ b/tools/minicargo/manifest.h
@@ -404,6 +404,8 @@ class PackageManifest
     bool    m_has_default_feature = false;
     ::std::vector<::std::string>    m_active_features;
     AllowedCfg  m_lint_check_cfg;
+    /// `[patch.crates-io] name = { path = ".." }` of this package (a workspace's are in WorkspaceManifest)
+    ::std::map< ::std::string, ::helpers::path> m_patches;
 
     bool m_create_auto_lib = true;
     bool m_create_auto_bins = true;
@@ -432,6 +434,7 @@ public:
     const ::std::string& pkg_license_file() const { return m_pkg_license_file; }
     const ::std::string& pkg_readme() const { return m_pkg_readme; }
     const ::std::string& pkg_rust_version() const { return m_pkg_rust_version; }
+    const ::std::map< ::std::string, ::helpers::path>& patches() const { return m_patches; }
     bool is_std_magic() const {
         return m_manifest_dir == ::helpers::path();
     }
diff --git a/tools/minicargo/repository.cpp b/tools/minicargo/repository.cpp
index d3e47b61..cddb3e97 100644
--- a/tools/minicargo/repository.cpp
+++ b/tools/minicargo/repository.cpp
@@ -127,6 +127,20 @@ void Repository::add_patch_path(const std::string& package_name, ::helpers::path
 {
     auto manifest_path = path / "Cargo.toml";
 
+    // Already known under this path (e.g. `--vendor-dir` pointing at the same `vendor/`): a second manifest object for
+    // the same package would make it build twice
+    {
+        auto abs_path = manifest_path.to_absolute().normalise();
+        auto itp = m_cache.equal_range(package_name);
+        for(auto i = itp.first; i != itp.second; ++i)
+        {
+            if( ::helpers::path(i->second.manifest_path).to_absolute().normalise() == abs_path ) {
+                DEBUG("Patch " << package_name << " = " << path << ": already loaded");
+                return ;
+            }
+        }
+    }
+
     auto loaded_manifest = ::std::shared_ptr<PackageManifest>( new PackageManifest(PackageManifest::load_from_toml(manifest_path, m_workspace_manifest)) );
 
     Entry   cache_ent;
