From a26de7c61aac3c353a87eb767a132b68afd3b9ad Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 17:39:03 +0000
Subject: [PATCH] parse: a range has an end wherever an expression can start
 after its `..`

rustc 1.90 tests/ui, parse-only run:

    lint/unused/issue-90807-unused-paren.rs   for _ in (1..{ 2 }) {}
    error: Unexpected token TOK_BRACE_OPEN, expected TOK_PAREN_CLOSE
    expr/weird-exprs.rs (feature-gated for other reasons)
        .. .. .. .. ..
    error: Unexpected token TOK_DOUBLE_DOT, expected TOK_BRACE_CLOSE

and rustfmt tests/{source,target}/expr.rs `.. .. ..; // (.. (.. (..)))`.

Reference, Range expressions: RangeFromExpr `Expression ..` and
RangeExpr `Expression .. Expression`; which one applies is decided by
whether an expression starts after the `..`. rustc's
is_at_start_of_range_notation_rhs answers "the token can begin
an expression, and a `{` only where a struct literal is allowed"
(so `for _ in 0.. {}` keeps its body).

Parse_Expr1_1 decided by Parse_IsTokValue, a list without `..` /
`..=` (a prefix range as the end, which the previous commit made an
operand), `{`, `<` / `<<` (qualified paths), `&&`, `||` (closures),
labels, `loop` / `while` / `for` / `unsafe` / `move` / `async`,
`return` / `break` / `continue` and `$b:block`. Those start the end
now; `{` only when disallow_struct_literal is clear (parentheses clear
it, so `(1..{ 2 })` has an end and `match 0.. { .. }` does not).

macro_rules expression skimmer (eval.cpp consume_expr): after `..` it
took a `{` as the end also in a condition, swallowing the body of
`for _ in 0.. {}` given as `$e:expr`; under no_struct_lit the `{` now
ends the expression.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index bcce172f..c283646e 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -1854,6 +1854,11 @@ namespace
                 case TOK_SQUARE_CLOSE:
                    cont = false;
                    break;
+                // `for _ in 0.. {}`: no end, the block is the body
+                case TOK_BRACE_OPEN:
+                    if( no_struct_lit )
+                        cont = false;
+                    break;
                 default:
                     break;
                 }
diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index b0146832..0f427154 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -981,8 +981,26 @@ ExprNodeP Parse_Expr1_1(TokenStream& lex)
         }
     }
     assert( tok.type() == TOK_DOUBLE_DOT );
-    // If the next token is part of a value, parse that value
-    if( Parse_IsTokValue( LOOK_AHEAD(lex) ) )
+    // The end is present when an expression can start here (rustc's is_at_start_of_range_notation_rhs): also another
+    // prefix range (`.. ..`), and a block except where a struct literal is not allowed (`for _ in 0.. {}`)
+    bool has_end;
+    switch( LOOK_AHEAD(lex) )
+    {
+    case TOK_DOUBLE_DOT:    case TOK_DOUBLE_DOT_EQUAL:  case TOK_TRIPLE_DOT:
+    case TOK_LT:    case TOK_DOUBLE_LT: case TOK_DOUBLE_AMP:    case TOK_DOUBLE_PIPE:   case TOK_LIFETIME:
+    case TOK_RWORD_LOOP:    case TOK_RWORD_WHILE:   case TOK_RWORD_FOR: case TOK_RWORD_UNSAFE:
+    case TOK_RWORD_MOVE:    case TOK_RWORD_ASYNC:   case TOK_RWORD_RETURN:  case TOK_RWORD_BREAK:
+    case TOK_RWORD_CONTINUE:    case TOK_INTERPOLATED_BLOCK:
+        has_end = true;
+        break;
+    case TOK_BRACE_OPEN:
+        has_end = !CHECK_PARSE_FLAG(lex, disallow_struct_literal);
+        break;
+    default:
+        has_end = Parse_IsTokValue( LOOK_AHEAD(lex) );
+        break;
+    }
+    if( has_end )
     {
         right = next(lex);
     }
diff --git a/src/version.cpp b/src/version.cpp
index f8958fec..e47ac88d 100644
--- a/src/version.cpp
+++ b/src/version.cpp
@@ -13,7 +13,7 @@
 #define VERSION_PATCH   0
 
 // Number of the last patch in this fork's series: every fix commit bumps it
-#define VERSION_SERIES  477
+#define VERSION_SERIES  478
 // rlibs written by an older series are refused (0 = accept all)
 #define VERSION_SERIES_FLOOR    0
 
