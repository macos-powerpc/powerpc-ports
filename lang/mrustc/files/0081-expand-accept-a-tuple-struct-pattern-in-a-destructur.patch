From 55a03a0b04820d744588a83a1a89ee320972dd57 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 6 Oct 2026 01:11:26 +0000
Subject: [PATCH 81/81] expand: accept a tuple struct pattern in a
 destructuring assignment

time 0.3.47 src/parsing/combinator/mod.rs:77 (and :377):

    let digit;
    ParsedItem(input, digit) = any_digit(input)?;

    error:0: N3AST17ExprNode_CallPathE isn't valid on the LHS of an assignemnt

The destructuring-assignment desugaring (RFC 2909) already turned tuple, slice and
struct expressions on the left of `=` into a pattern, but rejected the call form
that spells a tuple struct or variant. Lower `Path(a, b, ..)` to a tuple struct
pattern, sharing the tuple case's handling of `..` (now `lower_tuple`). The path is
resolved later as usual.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/expand/mod.cpp | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/src/expand/mod.cpp b/src/expand/mod.cpp
index af3d459f..19771190 100644
--- a/src/expand/mod.cpp
+++ b/src/expand/mod.cpp
@@ -1204,7 +1204,6 @@ struct CExpandExpr:
                 void visit(::AST::ExprNode_Flow& v) override { invalid(v); }
                 void visit(::AST::ExprNode_LetBinding& v) override { invalid(v); }
                 void visit(::AST::ExprNode_Assign& v) override { invalid(v); }
-                void visit(::AST::ExprNode_CallPath  & v) override { invalid(v); }
                 void visit(::AST::ExprNode_CallMethod& v) override { invalid(v); }
                 void visit(::AST::ExprNode_CallObject& v) override { invalid(v); }
                 void visit(::AST::ExprNode_Loop& v) override { invalid(v); }
@@ -1254,14 +1253,14 @@ struct CExpandExpr:
                         pat(AST::Pattern(v.span(), AST::Pattern::Data::make_Slice({ std::move(subpats) })));
                     }
                 }
-                void visit(::AST::ExprNode_Tuple& v) override {
+                AST::Pattern::TuplePat lower_tuple(const Span& sp, std::vector<AST::ExprNodeP>& values) {
                     bool is_split = false;
                     std::vector<AST::Pattern>   subpats_start;
                     std::vector<AST::Pattern>   subpats;
-                    for(auto& m : v.m_values) {
+                    for(auto& m : values) {
                         if( const auto* e = dynamic_cast<AST::ExprNode_BinOp*>(m.get()) ) {
                             if( e->m_type == ::AST::ExprNode_BinOp::RANGE && !e->m_left && !e->m_right ) {
-                                ASSERT_BUG(v.span(), !is_split, "Multiple `..` in tuple pattern?");
+                                ASSERT_BUG(sp, !is_split, "Multiple `..` in tuple pattern?");
                                 is_split = true;
                                 subpats_start = std::move(subpats);
                                 continue ;
@@ -1270,12 +1269,19 @@ struct CExpandExpr:
                         subpats.push_back(lower(m));
                     }
                     if( is_split ) {
-                        pat(AST::Pattern(AST::Pattern::TagTuple(), v.span(), AST::Pattern::TuplePat { std::move(subpats_start), true, std::move(subpats) }));
+                        return AST::Pattern::TuplePat { std::move(subpats_start), true, std::move(subpats) };
                     }
                     else {
-                        pat(AST::Pattern(AST::Pattern::TagTuple(), v.span(), std::move(subpats)));
+                        return AST::Pattern::TuplePat { std::move(subpats), false, {} };
                     }
                 }
+                void visit(::AST::ExprNode_Tuple& v) override {
+                    pat(AST::Pattern(AST::Pattern::TagTuple(), v.span(), lower_tuple(v.span(), v.m_values)));
+                }
+                // A tuple struct/variant: `ParsedItem(input, digit) = any_digit(input)?;` (time 0.3.47)
+                void visit(::AST::ExprNode_CallPath& v) override {
+                    pat(AST::Pattern(AST::Pattern::TagNamedTuple(), v.span(), v.m_path, lower_tuple(v.span(), v.m_args)));
+                }
 
                 // Just emit as if it's a slot, `UnitStruct = Foo` isn't valid
                 void visit(::AST::ExprNode_NamedValue& v) override { slot(v); }
