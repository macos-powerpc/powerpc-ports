From aac178c5fdf75a2088a4388e309703202f20f919 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 00:58:26 +0000
Subject: [PATCH] lex: an empty source file is an empty token stream, not an uncaught
 EndOfFile

mime_guess 2.0.5 (xplr 1.1.2, `default-features = false`):

    terminate called after throwing an instance of 'Lexer::EndOfFile'

With neither `phf` nor `rev-mappings` enabled, its build script creates
mime_types_generated.rs and writes nothing to it, and impl_bin_search.rs
does `include!(env!("MIME_TYPES_GENERATED_PATH"))`. The Lexer
constructor read the file's first byte with getc_byte() to look for
an UTF-8 BOM, and getc_byte() throws EndOfFile at end of input; nothing
catches it there. An empty `mod x;` file died the same way.

The constructor now peeks at the first byte and only consumes it when
it starts a BOM. Two side effects of the old code are gone as well:
- a file holding only a truncated BOM (`\xEF`) is the "Incomplete BOM"
  error instead of the same abort;
- getc_byte() folds `\r\n` and counts the line, but unget() only put
  the `\n` back, so a CRLF file starting with a blank line reported
  every location one line too far down.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/parse/lex.cpp | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/src/parse/lex.cpp b/src/parse/lex.cpp
index f39119f9..5bb58eb3 100644
--- a/src/parse/lex.cpp
+++ b/src/parse/lex.cpp
@@ -37,20 +37,18 @@ Lexer::Lexer(const ::std::string& filename, AST::Edition edition, ParseState ps)
             throw ::std::runtime_error("Unable to open file '" + filename + "'");
         }
         // Consume the BOM
-        if( this->getc_byte() == '\xef' )
+        // - Peek, as an empty file (e.g. an `include!`d build script output, or an empty module) has no first byte
+        if( m_istream.peek() == 0xEF )
         {
-            if( this->getc_byte() != '\xbb' ) {
+            m_istream.get();
+            if( m_istream.get() != 0xBB ) {
                 throw ::std::runtime_error("Incomplete BOM - missing \\xBB in second position");
             }
-            if( this->getc_byte() != '\xbf' ) {
+            if( m_istream.get() != 0xBF ) {
                 throw ::std::runtime_error("Incomplete BOM - missing \\xBF in third position");
             }
             m_line_ofs = 0;
         }
-        else
-        {
-            m_istream.unget();
-        }
     }
 }
 Lexer::Lexer(::std::istringstream& ss, AST::Edition edition, ParseState ps)
