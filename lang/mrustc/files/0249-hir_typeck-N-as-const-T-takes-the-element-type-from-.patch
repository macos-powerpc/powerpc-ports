From c3301fdb58bb2350df9740a801336bb11c80e0f3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 05:11:32 +0000
Subject: [PATCH 249/250] hir_typeck: `&[?; N] as *const [T]` takes the element
 type from the slice

zerovec 0.11.8 (tree-sitter-cli 0.27.1), varzerovec/slice.rs:112
`VarZeroSlice::new_empty`:

    <null> BUG: src/trans/target.cpp:891: Unsized type in array - [[u8]; 0]

    unsafe { &*(&[] as *const [u8] as *const Self) }

The cast visitor's shortcut for `&[?; N] as *mut ?` offers the destination
pointee as a possible type for the array's unknown element. That is the
element-pointer cast (`&[T; N] as *const T`), but a slice pointee is the
array unsize (`[T; N]: Unsize<[T]>`), so the shortcut offered `[u8]` as
the element, the literal became `[[u8]; 0]`, and trans could not lay it
out.

A slice pointee now equates the element with the slice's element and
leaves the node for the revisit, which takes the existing Unsize path;
a `str` or `dyn` pointee (the whole array would unsize, once its element is
known) makes no offer. Every other pointee keeps the old rule.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index c8cb8c42..075a871a 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -369,6 +369,19 @@ namespace {
                     // If this looks like `&mut [?; N]` -> `*mut ?` then do a possible equate between the two types
                     if( src_inner.data().is_Array() ) {
                         if( const auto* s_e_i = this->context.get_type(src_inner.data().as_Array().inner).data().opt_Infer() ) {
+                            if( const auto* d_s = ity.data().opt_Slice() ) {
+                                // `&[?; N]` -> `*const [T]` is the array unsize (`[T; N]: Unsize<[T]>`), so the element is
+                                // `T`: zerovec 0.11.8 varzerovec/slice.rs:112 `&[] as *const [u8] as *const Self`
+                                // (tree-sitter-cli) took the element-pointer rule and made `[[u8]; 0]`, "Unsized type in
+                                // array" in trans. Revisited once the element is known (the Unsize path below).
+                                this->context.equate_types(sp, src_inner.data().as_Array().inner, d_s->inner);
+                                return ;
+                            }
+                            if( TU_TEST1(ity.data(), Primitive, == ::HIR::CoreType::Str) || ity.data().is_TraitObject() ) {
+                                // An unsized pointee can't be the element type: the whole array unsizes, once its
+                                // element type is known
+                                return ;
+                            }
                             this->context.possible_equate_ivar(sp, s_e_i->index, ity, Context::PossibleTypeSource::UnsizeTo);
                             return ;
                         }
