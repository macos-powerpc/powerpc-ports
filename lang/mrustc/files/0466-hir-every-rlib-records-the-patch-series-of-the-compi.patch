         sorted.push_back( e );
     // 2. Write out string table
     ::std::sort(sorted.begin(), sorted.end(), [](const auto& a, const auto& b){ return a.second > b.second; });
+    // After the sort, so the other strings keep their indices
+    for(const auto& s : m_unreferenced_strings)
