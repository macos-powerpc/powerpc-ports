From b233f7d11ab018be42cbec3cb8bff13336f29d07 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 16:45:30 +0000
Subject: [PATCH] hir: every rlib records the patch series of the compiler that
 wrote it

Ports are built on the G5 in a resume mode that keeps every rlib whose
output exists, also after the compiler was updated. Three "recurring"
bugs were rlibs older than their fix: arti's fs-mistrust rlib built
before 0440 (the C290 stop again), a librsvg built before 0407 (the C256
panic verbatim in audacious), cryptography built before 0421 (komikku).
Nothing in an rlib said which compiler wrote it; telling "this crate
fails again" from "a dependency is stale" took comparing mtimes.

src/version.cpp defines VERSION_SERIES, the number of the last patch of
this fork's series (466 = this commit); every later fix commit bumps it.
HIR_Serialise appends `#mrustc-series=0466` to the string table that
opens the metadata stream (`<rlib>.hir`). No data references it (a `#`
cannot start a crate or item name), and it is appended after the table
is sorted by use count, so every other string keeps its index: a stamped
stream is the unstamped one plus one table entry, and an unstamped write
is byte-identical to what 0465 writes (checked on the decompressed
streams). The layout of the stream does not change: 0465 loads a stamped
rlib and carries an unused string, this compiler reads an rlib without
the entry as "unstamped". Existing rlibs keep loading.

HIR_Deserialise reads the stamp and records crate name -> series. When
compilation ends in Span::error or Span::bug (ERROR, BUG, TODO,
ASSERT_BUG) or in a metadata load failure, one line follows the message
if a loaded crate comes from another series, grouped by series, at most
eight names per group:

    note: crates loaded from rlibs of another mrustc series than this compiler's 0466 (rebuild them before treating this as a new bug): unstamped: e10; 0012: e1, e2, e3, e4, e5, e6, e7, e8 +1 more

Nothing is printed on success or when every crate matches.

VERSION_SERIES_FLOOR (0 = accept everything) is the lowest series this
compiler loads: a fix that makes older rlibs known bad raises it, and
loading one below it stops with

    error: rlib out/old/libdep.rlib (mrustc series 0012) is below the floor 0100 of this compiler (series 0466): delete it and rebuild it

`mrustc --rlib-series [<rlib>...]` prints the compiler's series, then
each rlib's, without compiling (`mrustc: 0466`, `libdep.rlib: 0466`,
`libold.rlib: unstamped`; exit 1 if a file cannot be read). `--version`
and `-vV` are unchanged.

Test hooks: MRUSTC_STAMP_SERIES=<n>|none sets the stamp written,
MRUSTC_SERIES_FLOOR=<n> the floor, so one binary can write "old" rlibs.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/hir/deserialise.cpp b/src/hir/deserialise.cpp
index 41ad08d5..51f759fd 100644
--- a/src/hir/deserialise.cpp
+++ b/src/hir/deserialise.cpp
@@ -16,7 +16,13 @@ namespace {
 #include <mir/mir.hpp>
 #include <macro_rules/macro_rules.hpp>
 #include "serialise_lowlevel.hpp"
+#include "rlib_series.hpp"
+#include <version.hpp>
 #include <typeinfo>
+#include <climits>
+#include <cstring>
+#include <iomanip>
+#include <sstream>
 
 namespace {
     bool des_debug_enabled() {
@@ -1804,14 +1810,107 @@ namespace {
     }
 //}
 
+namespace {
+    // Crate name -> series of the rlib it was loaded from
+    ::std::map<::std::string, unsigned>& loaded_crate_series() {
+        static ::std::map<::std::string, unsigned> rv;
+        return rv;
+    }
+    unsigned series_from_table(const ::HIR::serialise::Reader& in) {
+        const size_t plen = strlen(RLIB_SERIES_PREFIX);
+        for(const auto& s : in.string_table())
+        {
+            if( s.size() > plen && memcmp(s.c_str(), RLIB_SERIES_PREFIX, plen) == 0 )
+            {
+                unsigned rv;
+                if( RlibSeries_Parse(::std::string(s.c_str() + plen, s.size() - plen).c_str(), rv) )
+                    return rv;
+            }
+        }
+        return 0;
+    }
+    void check_series_floor(const ::std::string& filename, unsigned series) {
+        unsigned floor = giVersion_SeriesFloor;
+        // Test hook: MRUSTC_SERIES_FLOOR=<n> replaces the floor
+        if( const char* e = getenv("MRUSTC_SERIES_FLOOR") )
+        {
+            if( !RlibSeries_Parse(e, floor) ) {
+                ::std::cerr << "error: $MRUSTC_SERIES_FLOOR must be a number, got `" << e << "`" << ::std::endl;
+                exit(1);
+            }
+        }
+        if( series < floor )
+        {
+            ::std::cerr << "error: rlib " << filename << " (mrustc series " << RlibSeries_Format(series) << ")"
+                << " is below the floor " << RlibSeries_Format(floor) << " of this compiler (series " << RlibSeries_Format(giVersion_Series) << ")"
+                << ": delete it and rebuild it" << ::std::endl;
+            exit(1);
+        }
+    }
+}
+
+bool RlibSeries_Parse(const char* s, unsigned& out)
+{
+    if( !('0' <= *s && *s <= '9') )
+        return false;
+    char* end = nullptr;
+    unsigned long v = strtoul(s, &end, 10);
+    if( *end != '\0' || v > UINT_MAX )
+        return false;
+    out = static_cast<unsigned>(v);
+    return true;
+}
+::std::string RlibSeries_Format(unsigned series)
+{
+    if( series == 0 )
+        return "unstamped";
+    ::std::stringstream ss;
+    ss << ::std::setw(4) << ::std::setfill('0') << series;
+    return ss.str();
+}
+unsigned RlibSeries_OfFile(const ::std::string& rlib_path)
+{
+    bool is_hir = rlib_path.size() > 4 && rlib_path.compare(rlib_path.size() - 4, 4, ".hir") == 0;
+    ::HIR::serialise::Reader    in{ is_hir ? rlib_path : rlib_path + ".hir" };
+    return series_from_table(in);
+}
+void RlibSeries_PrintNote(::std::ostream& os)
+{
+    ::std::map<unsigned, ::std::vector<const ::std::string*>>   groups;
+    for(const auto& e : loaded_crate_series())
+    {
+        if( e.second != giVersion_Series )
+            groups[e.second].push_back(&e.first);
+    }
+    if( groups.empty() )
+        return ;
+    const size_t MAX_NAMES = 8;
+    os << "note: crates loaded from rlibs of another mrustc series than this compiler's " << RlibSeries_Format(giVersion_Series)
+        << " (rebuild them before treating this as a new bug):";
+    const char* sep = " ";
+    for(const auto& g : groups)
+    {
+        os << sep << RlibSeries_Format(g.first) << ":";
+        for(size_t i = 0; i < g.second.size() && i < MAX_NAMES; i ++)
+            os << (i == 0 ? " " : ", ") << *g.second[i];
+        if( g.second.size() > MAX_NAMES )
+            os << " +" << (g.second.size() - MAX_NAMES) << " more";
+        sep = "; ";
+    }
+    os << ::std::endl;
+}
+
 ::HIR::CratePtr HIR_Deserialise(const ::std::string& filename)
 {
     try
     {
         ::HIR::serialise::Reader    in{ filename + ".hir" };    // HACK!
+        unsigned series = series_from_table(in);
+        check_series_floor(filename, series);
         HirDeserialiser  s { in };
 
         ::HIR::Crate    rv = s.deserialise_crate();
+        loaded_crate_series()[rv.m_crate_name.c_str()] = series;
 
         return ::HIR::CratePtr( mv$(rv) );
     }
@@ -1820,6 +1919,7 @@ namespace {
     catch(const ::std::runtime_error& e)
     {
         ::std::cerr << "Unable to deserialise crate metadata from " << filename << ": " << e.what() << ::std::endl;
+        RlibSeries_PrintNote(::std::cerr);
         ::std::abort();
     }
     #if 0
diff --git a/src/hir/rlib_series.hpp b/src/hir/rlib_series.hpp
new file mode 100644
index 00000000..8cc6900c
--- /dev/null
+++ b/src/hir/rlib_series.hpp
@@ -0,0 +1,23 @@
+/*
+ * MRustC - Rust Compiler
+ * - By John Hodge (Mutabah/thePowersGang)
+ *
+ * hir/rlib_series.hpp
+ * - Patch-series stamp of the compiler that wrote an rlib's metadata
+ */
+#pragma once
+
+#include <iosfwd>
+#include <string>
+
+// The stamp is an entry of the metadata string table that no data references
+constexpr const char* RLIB_SERIES_PREFIX = "#mrustc-series=";
+
+// Decimal series number, false if `s` is anything else
+extern bool RlibSeries_Parse(const char* s, unsigned& out);
+// "0466", or "unstamped" for 0
+extern ::std::string RlibSeries_Format(unsigned series);
+// Series of the rlib at `rlib_path` (0 = unstamped), throws if the metadata cannot be read
+extern unsigned RlibSeries_OfFile(const ::std::string& rlib_path);
+// One `note:` line naming the loaded crates of another series than this compiler's, if any
+extern void RlibSeries_PrintNote(::std::ostream& os);
diff --git a/src/hir/serialise.cpp b/src/hir/serialise.cpp
index fc9fe131..b53bced7 100644
--- a/src/hir/serialise.cpp
+++ b/src/hir/serialise.cpp
@@ -10,6 +10,9 @@
 #include <macro_rules/macro_rules.hpp>
 #include <mir/mir.hpp>
 #include "serialise_lowlevel.hpp"
+#include "rlib_series.hpp"
+#include <version.hpp>
+#include <cstring>
 #include "../hir_typeck/monomorph.hpp"  // monomorphise_path_needed
 
 //namespace {
@@ -1467,6 +1470,22 @@ void HIR_Serialise(const ::std::string& filename, const ::HIR::Crate& crate)
     HirSerialiser  s { out };
     s.serialise_crate(crate);
     s.clear();
+    unsigned series = giVersion_Series;
+    // Test hook: MRUSTC_STAMP_SERIES=<n> writes series n, `none` (or 0) writes no stamp
+    if( const char* e = getenv("MRUSTC_STAMP_SERIES") )
+    {
+        if( strcmp(e, "none") == 0 ) {
+            series = 0;
+        }
+        else if( !RlibSeries_Parse(e, series) ) {
+            ::std::cerr << "error: $MRUSTC_STAMP_SERIES must be a number or `none`, got `" << e << "`" << ::std::endl;
+            exit(1);
+        }
+    }
+    if( series != 0 )
+    {
+        out.add_unreferenced_string(RcString::new_interned(RLIB_SERIES_PREFIX + RlibSeries_Format(series)));
+    }
     out.open(filename);
     s.serialise_crate(crate);
 }
