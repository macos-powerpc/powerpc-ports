From ce66751fe56f10a851fb82f4f649a6c2af973179 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 13:05:21 +0000
Subject: [PATCH 260/261] hir_expand: a lifted const block keeps one slot for
 an or-pattern's repeated binding

time 0.3.54 (ani-cli-rs 0.11.0), formatting/metadata.rs:89, in Lower MIR:

    MIR ERROR: ::"time"::formatting::metadata::lifted#1 BB199/0:
    operator(): Type mismatch:
     dst : ::"core"::num::nonzero::NonZero<u8,>
     src : ::"core"::option::Option<::"core"::num::nonzero::NonZero<u8,>,>

Inside the `const { .. }` block that the static-borrow-constants pass
lifts into its own const:

    TimePrecision::Hour { decimal_digits }
    | TimePrecision::Minute { decimal_digits }
    | TimePrecision::Second { decimal_digits } => {
        if let Some(digits) = decimal_digits { .. }

extract_node renumbers the lifted expression's variables. Its
visit_pattern inserted a binding's slot into the mapping and then set
the slot to `binding_mapping.size()`: for the second and third
alternatives of the or-pattern (the same variable, the same old slot)
the insert was a no-op and the slot became the one the next new
variable, `digits`, received. Those arms then stored the whole
`Option<NonZero<u8>>` into the `NonZero<u8>` local. The same match
outside a const block was fine.

A slot seen before now keeps its mapped slot (the SplitSlice extra
binding too).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_expand/static_borrow_constants.cpp b/src/hir_expand/static_borrow_constants.cpp
index 42b246b0..8ceb5fe8 100644
--- a/src/hir_expand/static_borrow_constants.cpp
+++ b/src/hir_expand/static_borrow_constants.cpp
@@ -859,22 +859,32 @@ namespace static_borrow_constants {
                         }
                     }
                 }
+                // A binding seen before keeps its new slot: the alternatives of an or-pattern bind the same variable
+                // (`Hour { decimal_digits } | Minute { decimal_digits } | ..`, time 0.3.54 metadata.rs:89 in a const
+                // block). Handing every later alternative `binding_mapping.size()` gave it the slot of the NEXT new
+                // variable (`digits` of the `if let Some(digits) = decimal_digits` inside), so that arm wrote the
+                // whole `Option<NonZero<u8>>` into a `NonZero<u8>` local: "MIR ERROR .. lifted#1 .. Type mismatch".
+                unsigned map_slot(unsigned old_slot) {
+                    auto it = binding_mapping.find(old_slot);
+                    if( it != binding_mapping.end() ) {
+                        return it->second;
+                    }
+                    auto idx = static_cast<unsigned>(binding_mapping.size());
+                    binding_mapping.insert(::std::make_pair(old_slot, idx));
+                    return idx;
+                }
                 void visit_pattern(const Span& sp, HIR::Pattern& pat) override {
                     HIR::ExprVisitorDef::visit_pattern(sp, pat);
                     for( auto& pb : pat.m_bindings )
                     {
-                        auto idx = static_cast<unsigned>(binding_mapping.size());
-                        binding_mapping.insert(::std::make_pair(pb.m_slot, idx));
-                        pb.m_slot = idx;
+                        pb.m_slot = map_slot(pb.m_slot);
                     }
 
                     if(auto* e = pat.m_data.opt_SplitSlice())
                     {
                         if( e->extra_bind.is_valid() )
                         {
-                            auto idx = static_cast<unsigned>(binding_mapping.size());
-                            binding_mapping.insert(::std::make_pair(e->extra_bind.m_slot, idx));
-                            e->extra_bind.m_slot = idx;
+                            e->extra_bind.m_slot = map_slot(e->extra_bind.m_slot);
                         }
                     }
                 }
