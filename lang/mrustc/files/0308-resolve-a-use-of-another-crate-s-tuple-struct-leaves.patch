                 }
             TU_ARMA(StructConstructor, e) {
-                pb.binding = ::AST::PathBinding_Value::make_Struct({ nullptr, &crate.m_extern_crates.at(e.ty.crate_name()).m_hir->get_typeitem_by_path(sp, e.ty, true).as_Struct() });
+                const auto& str = crate.m_extern_crates.at(e.ty.crate_name()).m_hir->get_typeitem_by_path(sp, e.ty, true).as_Struct();
+                // A glob skips a constructor this crate can't name (as a single `use` does, see use.cpp)
