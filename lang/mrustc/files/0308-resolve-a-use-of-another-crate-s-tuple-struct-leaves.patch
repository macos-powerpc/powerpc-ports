@@ -25,6 +25,23 @@ namespace {
     const RcString rcstring_crate_builtins = RcString::new_interned(CRATE_BUILTINS);
 }
 
+/// Can another crate name this tuple struct's constructor? (rustc: the constructor's visibility is the narrowest of
+/// the struct's and its fields', so outside the crate one non-`pub` field hides it: a `use` of the struct then imports
+/// only the type, and a value of that name resolves further out)
+/// - swash 0.2.7 internal/var.rs `use skrifa::raw::{.., types::Fixed, ..}` in a body (font_types `pub struct
+///   Fixed(i32)`), then `Fixed(..)` = the module's own `use super::fixed::Fixed`
+/// TODO: The same rule within a crate, and `#[non_exhaustive]` (a `pub(crate)` constructor; not recorded in the HIR)
+bool Resolve_Use_HirStructCtorVisible(const ::HIR::Struct& str)
+{
+    if( const auto* fields = str.m_data.opt_Tuple() ) {
+        for(const auto& f : *fields) {
+            if( !f.publicity.is_global() )
+                return false;
+        }
+    }
+    return true;
+}
+
 
