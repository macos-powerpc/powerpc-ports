From 7aab24f5d2b9e742b81ca181c12f6c3e4d1436df Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 13:42:55 +0000
Subject: [PATCH] consteval: a generic constant read during another constant's
 evaluation gets its associated types expanded

aligned-vec 0.6.4 src/lib.rs:114 `equator::assert!(align.is_power_of_two(), "..")` (mdcat 2.19.0):
    "<null> BUG: src/trans/monomorphise.cpp:186: Exception thrown during evaluation of:
    <&'#local32 ::"aligned_vec-0_6_4_H2"::#4::#0::Source<'#local31,::"equator-0_4_2"::structures::Finalize<bool,>>
    as ::"equator-0_4_2"::traits::DynInfo>::VTABLE"
equator-macro 0.4.2 expands the assertion to a function-local `struct Source<'a, V>` with
`impl<V: DynInfo> DynInfo for &Source<'_, V> { const VTABLE: &'static Self::VTable = &WithSource { source, file,
line, col, vtable: V::VTABLE } }`, used as `(&&Source(&__assert_expr)).vtable()` with `__assert_expr:
Finalize<bool>`. Trans Monomorph evaluates that VTABLE per instance; its promoted literal reads
`<Finalize<bool> as DynInfo>::VTABLE`, a generic impl constant from the equator rlib (`const VTABLE: &'static
Self::VTable = E::VTABLE`). get_const monomorphised that constant's type without expanding the associated type
(the generic-static path next to it uses `monomorph_expand`), so the type stayed
`&<Finalize<bool> as DynInfoType>::VTable`, the return slot had no size (AllocationPtr::allocate: Target_GetSizeOf
false -> `throw Defer()`), and the Defer surfaced as the catch-all BUG in Trans Monomorph.

The nested constant's type (and the `out_ty` handed back) now go through `monomorph_expand`. The two Trans
Monomorph catch sites name a Defer ("Evaluation deferred ...") before the catch-all, so the next one is not
a mystery.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index 59c894c8..c7fca7ac 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -1459,8 +1459,13 @@ namespace MIR { namespace eval {
                     item.m_value_state = HIR::Constant::ValueState::Generic;
                 }
             }
+            // The type's associated types must be expanded, as for a generic static above: `&'static Self::VTable`
+            // of equator 0.4.2's `impl<E: DynInfo> DynInfo for Finalize<E>` read from aligned-vec 0.6.4's expanded
+            // `assert!` (a local `impl DynInfo for &Source<'_, V>` whose VTABLE holds `V::VTABLE`) stayed
+            // `&<Finalize<bool> as DynInfoType>::VTable`, so the return slot had no size and the evaluation threw
+            // Defer: "BUG: monomorphise.cpp:186: Exception thrown during evaluation of: <&Source<..> as DynInfo>::VTABLE"
             if(out_ty)
-                *out_ty = const_ms.monomorph_type(state.sp, c.m_type);
+                *out_ty = root_resolve.monomorph_expand(state.sp, c.m_type, const_ms);
             if( c.m_value_state == HIR::Constant::ValueState::Generic )
             {
                 auto it = c.m_monomorph_cache.find(p);
@@ -1475,7 +1480,7 @@ namespace MIR { namespace eval {
 
                     DEBUG("- Evaluate monomorphed " << p);
                     DEBUG("> const_ms=" << const_ms);
-                    auto ty = const_ms.monomorph_type( item.m_value.span(), item.m_type );
+                    auto ty = root_resolve.monomorph_expand( item.m_value.span(), item.m_type, const_ms );
                     auto val = eval.evaluate_constant(::HIR::ItemPath(p), item.m_value, std::move(ty), std::move(const_ms));
 
                     auto insert_res = item.m_monomorph_cache.insert(std::make_pair(p.clone(), std::move(val)));
diff --git a/src/trans/monomorphise.cpp b/src/trans/monomorphise.cpp
index d5b3cb0d..3953fb0e 100644
--- a/src/trans/monomorphise.cpp
+++ b/src/trans/monomorphise.cpp
@@ -180,6 +180,12 @@ void Trans_Monomorphise_List(const ::HIR::Crate& crate, TransList& list)
             // constant value failed"). Report it against the use rather than crashing.
             ERROR(pp.sp, E0000, "Constant evaluation panicked while evaluating " << path);
         }
+        catch(const ::HIR::Defer&)
+        {
+            // Consteval gave up on a type or value it couldn't resolve (everything is monomorphised here, so that is
+            // a compiler bug): say so, the plain `catch(...)` hid it (aligned-vec 0.6.4 / equator VTABLE, C215)
+            BUG(Span(), "Evaluation deferred (a type without a known size, or an unresolved value) during evaluation of: " << path);
+        }
         catch(...)
         {
             // Deferred - no update
@@ -227,6 +233,12 @@ void Trans_Monomorphise_List(const ::HIR::Crate& crate, TransList& list)
             // constant value failed"). Report it against the use rather than crashing.
             ERROR(pp.sp, E0000, "Constant evaluation panicked while evaluating " << path);
         }
+        catch(const ::HIR::Defer&)
+        {
+            // Consteval gave up on a type or value it couldn't resolve (everything is monomorphised here, so that is
+            // a compiler bug): say so, the plain `catch(...)` hid it (aligned-vec 0.6.4 / equator VTABLE, C215)
+            BUG(Span(), "Evaluation deferred (a type without a known size, or an unresolved value) during evaluation of: " << path);
+        }
         catch(...)
         {
             // Deferred - no update
