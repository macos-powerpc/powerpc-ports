From 4db15dd498110d0fef4683a08dbb9937b6ed41b2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 20:06:00 +0000
Subject: [PATCH] resolve: a lookup follows each glob once (glob cycles were
 searched along every path)

localsend-cli 1.18.2: dtls 0.13.0 sat in Expand for over 1.5 hours with no
output; a sample of the mrustc process showed all of the time in
(anonymous namespace)::ResolveState::find_item / get_module (resolve/common.cpp).

dtls's modules glob-import each other: 336 `use super::*;` / `use crate::x::*;`
over 93 files (flight/flightN.rs `use super::*;` + `use crate::{conn, content,
handshake, ..}::*`, flight/mod.rs `use crate::handshaker::*`, handshaker.rs
`use crate::conn::*`, ...).  Three lookups walk globs with only a stack against
cycles, so they follow every simple path of the glob graph - exponential:

- Expand_Mod's `Use` arm asks Resolve_Lookup_Macro for a macro named like every
  named `use` (macros can be imported by `use`).  None of dtls's are macros, so
  each is a failing find_item search of the whole graph (its antirecurse stack
  only stops at a module already on the stack).
- Resolve Use's Resolve_Use_GetBinding_Mod merges the bindings of every glob it
  reaches (s_use_glob_mod_stack).
- Resolve Index's Resolve_Index_Module_Wildcard__submod copies a module's index
  into the importer and follows its globs (`pub use` globs; static `stack`).

Reproduced here: a skeleton of dtls (its module tree and top-level `use` items,
no code, no dependencies) is still in Expand after 5 minutes with the 0402
binary (and with 0324).  gen.py graphs of N modules that all glob each other:
Expand 0.12 s (N=6), 0.9 s (7), 9.5 s (8), 97 s (9); Resolve Use 0.18 / 1.5 /
15.6 s and Resolve Index 0.67 / 4.9 / 36 s for N = 6 / 7 / 8.

Each lookup now keeps a set of what it already searched:
- find_item: the (module, name, namespace) lookups that came up empty.  A glob,
  a named `use` and an anonymous module's parent continue the search they came
  from; a path walk (get_module) starts its own.
- Resolve_Use_GetBinding_Mod: the (importing module, imported module) globs it
  followed.  A glob that the cycle stack blocked isn't marked, so it can still
  be followed later, as before.
- Resolve_Index_Module_Wildcard: per destination module, the (source module,
  visibility given to the copies) pairs it copied.

A second visit only repeated work (first found / first bound wins): HIR dumps
are identical between the old and new binaries on the N=6 and N=7 graphs and on
the dtls skeleton with stub items.  Now: dtls skeleton Expand 3.6 s with all its
`use` items (0.09 s without the unresolvable extern ones), N=14 under 0.2 s per
phase.

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/resolve/common.cpp b/src/resolve/common.cpp
index 772fb17f..99c5621d 100644
--- a/src/resolve/common.cpp
+++ b/src/resolve/common.cpp
@@ -13,6 +13,8 @@
 #include <ast/expr.hpp>
 #include <hir/hir.hpp>
 #include <stdspan.hpp>  // std::span
+#include <set>
+#include <tuple>
 #include <expand/cfg.hpp>
 #include <synext_macro.hpp>
 
@@ -521,8 +523,35 @@ namespace {
             throw "";
         }
 
-        ResolveItemRef find_item(const AST::Module& mod, const RcString& name, ResolveNamespace ns, ::AST::AbsolutePath* out_path=nullptr)
-        //ResolveModuleRef get_source_module_for_name(const AST::Module& mod, const RcString& name, ResolveNamespace ns, ::AST::AbsolutePath* out_path=nullptr)
+        /// Lookups of one search that came up empty: (module, name, namespace)
+        typedef std::set< std::tuple<const AST::Module*, RcString, ResolveNamespace> >  failed_lookups_t;
+
+        /// Look for `name` in `mod`, through its `use` items and globs.
+        /// `searched` is the set of the search this lookup belongs to (null starts a new search): a glob, a `use` and
+        /// the parent of an anonymous module continue the search they came from, while a path walk (`get_module`) starts
+        /// its own. Each (module, name, namespace) is looked at once per search: without that, a crate whose modules
+        /// glob-import each other (`use super::*;`, `use crate::x::*;`) was searched along every simple path of its glob
+        /// graph for each name it does not define - exponential. dtls 0.13.0 (localsend-cli, 336 globs over 93 files)
+        /// sat in Expand for hours: every named `use` asks for a macro of that name (Expand_Mod's `Use` arm), which
+        /// no module defines.
+        ResolveItemRef find_item(const AST::Module& mod, const RcString& name, ResolveNamespace ns, ::AST::AbsolutePath* out_path=nullptr, failed_lookups_t* searched=nullptr)
+        {
+            failed_lookups_t    new_search;
+            if( !searched ) {
+                searched = &new_search;
+            }
+            auto key = std::make_tuple(&mod, name, ns);
+            if( searched->count(key) > 0 ) {
+                DEBUG("Already searched for " << name << " in " << mod.path() << " (ns=" << ns << ")");
+                return ResolveItemRef::make_None({});
+            }
+            auto rv = find_item_inner(mod, name, ns, out_path, *searched);
+            if( rv.is_None() ) {
+                searched->insert(std::move(key));
+            }
+            return rv;
+        }
+        ResolveItemRef find_item_inner(const AST::Module& mod, const RcString& name, ResolveNamespace ns, ::AST::AbsolutePath* out_path, failed_lookups_t& searched)
         {
             TRACE_FUNCTION_F("Looking for " << name << " in " << mod.path() << " (ns=" << ns << ")");
             if( mod.m_index_populated )
@@ -692,7 +721,7 @@ namespace {
                             TU_MATCH_HDRA( (tgt_mod), {)
                             TU_ARMA(Ast, mod_ptr) {
                                 // NOTE: Recursion
-                                auto rv = this->find_item(*mod_ptr, item_name, ns, out_path);
+                                auto rv = this->find_item(*mod_ptr, item_name, ns, out_path, &searched);
                                 if(!rv.is_None())
                                 {
                                     DEBUG("Found in AST use");
@@ -758,7 +787,7 @@ namespace {
                                 TODO(sp, "ImplicitPrelude? " << e.path);
                                 }
                             TU_ARMA(Ast, sm) {
-                                auto rv = find_item(*sm, name, ns, out_path);
+                                auto rv = find_item(*sm, name, ns, out_path, &searched);
                                 if( !rv.is_None() )
                                 {
                                     DEBUG("Found in AST glob");
@@ -795,7 +824,7 @@ namespace {
                         m = &as_Namespace(this->find_item(*m, tgt_name, ResolveNamespace::Namespace)).as_Ast()->as_Module();
                     }
                 }
-                return find_item(*m, name, ns, out_path);
+                return find_item(*m, name, ns, out_path, &searched);
             }
             DEBUG("Not found");
             return ResolveItemRef::make_None({});
