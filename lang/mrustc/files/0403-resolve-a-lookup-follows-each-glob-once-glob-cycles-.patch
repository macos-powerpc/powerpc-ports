 extern bool Resolve_Use_HirStructCtorVisible(const ::HIR::Struct& str);   // use.cpp
 
 ::std::ostream& operator<<(::std::ostream& os, const IndexName& loc)
@@ -530,7 +533,7 @@ void Resolve_Index_Module_Wildcard__glob_in_hir_mod(
     }
 }
 
-void Resolve_Index_Module_Wildcard__submod(AST::Crate& crate, AST::Module& dst_mod, const AST::Module& src_mod, const AST::Visibility& dst_vis)
+void Resolve_Index_Module_Wildcard__submod(AST::Crate& crate, AST::Module& dst_mod, const AST::Module& src_mod, const AST::Visibility& dst_vis, index_glob_search_t& search)
 {
     static Span sp;
     TRACE_FUNCTION_F(dst_mod.path() << " <= " << src_mod.path());
@@ -540,6 +543,16 @@ void Resolve_Index_Module_Wildcard__submod(AST::Crate& crate, AST::Module& dst_m
         DEBUG("- Avoided recursion");
         return ;
     }
+    // Copy each module (and follow its globs) once per destination and visibility: a second copy adds nothing, and
+    // the stack above only stops cycles, so modules that `pub use` each other's globs were copied along every simple
+    // path of their glob graph (see resolve/common.cpp's find_item)
+    // - The key is the visibility object (a `use` item's), so equal restrictions from two `use` items count twice
+    if( ! search.insert( ::std::make_pair(&src_mod, dst_vis.is_global() ? nullptr : &dst_vis) ).second )
+    {
+        DEBUG("- Already copied");
+        stack.erase(&src_mod);
+        return ;
+    }
 
     // A glob re-export can't make an item more visible than it is: `pub use crate::*` imports the crate's private
     // items (e.g. the implicit `extern crate std`) for local use only. (value-trait 0.12.2's prelude, seen from simd-json)
@@ -579,7 +592,7 @@ void Resolve_Index_Module_Wildcard__submod(AST::Crate& crate, AST::Module& dst_m
             {
                 if( e.name != "" )
                     continue ;
-                Resolve_Index_Module_Wildcard__use_stmt(crate, dst_mod, e, glob_vis(i->vis));
+                Resolve_Index_Module_Wildcard__use_stmt(crate, dst_mod, e, glob_vis(i->vis), search);
             }
         }
     }
@@ -587,7 +600,7 @@ void Resolve_Index_Module_Wildcard__submod(AST::Crate& crate, AST::Module& dst_m
     stack.erase(&src_mod);
 }
 
-void Resolve_Index_Module_Wildcard__use_stmt(AST::Crate& crate, AST::Module& dst_mod, const AST::UseItem::Ent& i_data, const AST::Visibility& vis)
+void Resolve_Index_Module_Wildcard__use_stmt(AST::Crate& crate, AST::Module& dst_mod, const AST::UseItem::Ent& i_data, const AST::Visibility& vis, index_glob_search_t& search)
 {
     const auto& sp = i_data.sp;
     const auto& b = i_data.path.m_bindings.type;
@@ -609,7 +622,7 @@ void Resolve_Index_Module_Wildcard__use_stmt(AST::Crate& crate, AST::Module& dst
         }
         else
         {
-            Resolve_Index_Module_Wildcard__submod(crate, dst_mod, *e->module_, vis);
+            Resolve_Index_Module_Wildcard__submod(crate, dst_mod, *e->module_, vis, search);
         }
     }
     else if( const auto* ep = b.binding.opt_Enum() )
@@ -694,6 +707,7 @@ void Resolve_Index_Module_Wildcard__use_stmt(AST::Crate& crate, AST::Module& dst
 void Resolve_Index_Module_Wildcard(AST::Crate& crate, AST::Module& mod)
 {
     TRACE_FUNCTION_F("mod = " << mod.path());
+    index_glob_search_t search;
     for( const auto& i : mod.m_items )
     {
         if( ! i->data.is_Use() )
@@ -702,7 +716,7 @@ void Resolve_Index_Module_Wildcard(AST::Crate& crate, AST::Module& mod)
         {
             if( e.name != "" )
                 continue ;
-            Resolve_Index_Module_Wildcard__use_stmt(crate, mod, e, i->vis);
+            Resolve_Index_Module_Wildcard__use_stmt(crate, mod, e, i->vis, search);
         }
     }
 
