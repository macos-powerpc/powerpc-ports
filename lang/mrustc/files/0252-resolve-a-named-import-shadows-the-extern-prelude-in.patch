+// Does the module containing this `use` have a local type-namespace item with this name? Such an item shadows
+// the extern prelude (2018+) and the builtin types.
+// Conservative: if the walk fails for any reason, say no.
+static bool Resolve_Use_LocalTypeItemShadows(const AST::Crate& crate, const ::AST::Path& base_path, const RcString& name)
+{
+    bool has_local_shadow = false;
+    const AST::Module* cur_mod = Resolve_Use_WalkToModule(crate, base_path);
+    if( cur_mod )
     {
         for(const auto& item : cur_mod->m_items) {
             if( item->name != name )
@@ -104,6 +109,63 @@ static bool Resolve_Use_LocalTypeItemShadows(const AST::Crate& crate, const ::AS
     return has_local_shadow;
 }
 
+::AST::Path Resolve_Use_AbsolutisePath(const Span& span, const AST::Crate& crate, const ::AST::Path& base_path, ::AST::Path path);
+
+// Does the module containing this `use` have a named import of this name that binds the type namespace to something
+// other than `prelude_crate` (the extern prelude's crate of that name)? It shadows the extern prelude (2018+) like an
+// item does: async-compression 0.4.44 lib.rs `pub use compression_core as core; pub use core::Level;` (rustc: module
+// items and imports come before the extern prelude; a glob that differs from it is an ambiguity error, so globs are
+// not consulted). A value- or macro-only import doesn't count (`use log::{log, info};`).
+// Conservative: if the walk or the import's resolution fails, say no.
+static bool Resolve_Use_LocalImportShadows(const AST::Crate& crate, const ::AST::Path& base_path, const RcString& name, const AST::ExternCrate* prelude_crate)
+{
+    const AST::Module* cur_mod = Resolve_Use_WalkToModule(crate, base_path);
+    if( !cur_mod )
+        return false;
+    for(const auto& item : cur_mod->m_items)
+    {
+        if( !item->data.is_Use() )
+            continue;
+        for(const auto& ent : item->data.as_Use().entries)
+        {
+            if( ent.name != name )
+                continue;
+            // `use core::{self}` (or the `use` being resolved right now): a path can't resolve through its own import
+            if( ent.path.m_class.is_Relative() && !ent.path.nodes().empty() && ent.path.nodes().front().name() == name )
+                continue;
+            ::AST::Path::Bindings   b;
+            if( ent.path.m_bindings.has_binding() ) {
+                b = ent.path.m_bindings.clone();
+            }
+            else {
+                // Not resolved yet (it comes later in the module): resolve it now, guarding against import cycles
+                static ::std::vector<const ::AST::Path*> s_stack;
+                if( ::std::find(s_stack.begin(), s_stack.end(), &ent.path) != s_stack.end() ) {
+                    DEBUG("Recursion on " << ent.path);
+                    continue;
+                }
+                s_stack.push_back(&ent.path);
+                b = Resolve_Use_GetBinding(ent.sp, crate, cur_mod->path(), Resolve_Use_AbsolutisePath(ent.sp, crate, base_path, ent.path), {}, /*types_only=*/true, /*soft_fail=*/true);
+                s_stack.pop_back();
+            }
+            DEBUG("Import " << ent.name << " = " << ent.path << " - type " << b.type.binding.tag_str());
+            if( b.type.is_Unbound() )
+                continue;
+            // The extern prelude's own crate under its own name (`use core::{self}` resolved earlier): same answer
+            if( const auto* e = b.type.binding.opt_Crate() ) {
+                if( e->crate_ == prelude_crate )
+                    continue;
+            }
+            if( const auto* e = b.type.binding.opt_Module() ) {
+                if( !e->module_ && prelude_crate && e->hir.crate == prelude_crate && e->hir.mod == &prelude_crate->m_hir->m_root_module )
+                    continue;
+            }
+            return true;
+        }
+    }
+    return false;
+}
+
 // - Convert self::/super:: paths into non-canonical absolute forms
 ::AST::Path Resolve_Use_AbsolutisePath(const Span& span, const AST::Crate& crate, const ::AST::Path& base_path, ::AST::Path path)
 {
@@ -134,6 +196,16 @@ static bool Resolve_Use_LocalTypeItemShadows(const AST::Crate& crate, const ::AS
             {
                 auto ec_it = AST::g_implicit_crates.find(name);
                 if(ec_it != AST::g_implicit_crates.end())
+                {
+                    auto c_it = crate.m_extern_crates.find(ec_it->second);
+                    const AST::ExternCrate* prelude_crate = c_it != crate.m_extern_crates.end() ? &c_it->second : nullptr;
+                    has_local_shadow = Resolve_Use_LocalImportShadows(crate, base_path, name, prelude_crate);
+                }
+                if( has_local_shadow )
+                {
+                    DEBUG("Local import shadows implicit crate " << name);
+                }
+                else if(ec_it != AST::g_implicit_crates.end())
                 {
                     DEBUG("Found implict crate " << name);
                     e.nodes.erase(e.nodes.begin());
