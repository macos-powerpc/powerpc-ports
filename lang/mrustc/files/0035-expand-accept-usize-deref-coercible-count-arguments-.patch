From d086d159cab294b08202463916b3baa0e3fa9ff9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 00:16:45 +0000
Subject: [PATCH 35/36] expand: accept `&usize` (deref-coercible) `$` count
 arguments in format_args!

`write!(f, "{content:<width$}")` with `width: &usize` (bartib 1.1.0) died
with "Cannot cast to u16 from &usize": the generated `Count::Is(*aN as u16)`
dereferences the `&T` argument binding only once. rustc passes `aN` to
`Argument::from_usize(&usize)`, a coercion site, so `&usize`/`&&usize`
counts are accepted through deref coercion.

Reproduce that coercion site by emitting `{ let c: &usize = aN; *c }`
(plus `as u16` for 1.90+) for `$`-referenced width/precision arguments.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/expand/format_args.cpp | 25 +++++++++++++++++--------
 1 file changed, 17 insertions(+), 8 deletions(-)

diff --git a/src/expand/format_args.cpp b/src/expand/format_args.cpp
index 22def503..d080c66a 100644
--- a/src/expand/format_args.cpp
+++ b/src/expand/format_args.cpp
@@ -904,16 +904,28 @@ namespace {
                                 push_path(toks, crate, {"fmt", "rt", "v1", "Count", variant});
                             }
                         };
+                        // `$`-referenced count argument. `aN` is `&T` for the argument's type `T`; rustc
+                        // hands it to `Argument::from_usize(&usize)` - a coercion site - so `width = &n`
+                        // (`T = &usize`) works through deref coercion. Reproduce that coercion site with a
+                        // typed `let` rather than a bare `*aN` (which can't cast `&usize` to `u16`;
+                        // bartib 1.1.0 `write!(f, "{content:<width$}")` with `width: &usize`).
+                        auto push_count_arg = [&](unsigned int arg_idx) {
+                            toks.push_back( TokenTree(TOK_BRACE_OPEN) );
+                            push_toks(toks, TOK_RWORD_LET, ident("c"), TOK_COLON, TOK_AMP);
+                            push_toks(toks, ident("usize"), TOK_EQUAL, ident(FMT("a" << arg_idx).c_str()), TOK_SEMICOLON);
+                            push_toks(toks, TOK_STAR, ident("c"));
+                            if( TARGETVER_LEAST_1_90 ) {
+                                push_toks(toks, TOK_RWORD_AS, ident("u16"));
+                            }
+                            toks.push_back( TokenTree(TOK_BRACE_CLOSE) );
+                        };
 
                         push_toks(toks, ident("precision"), TOK_COLON );
                         if( frag.args.prec_is_arg || frag.args.prec != 0 ) {
                             push_path_count("Is");
                             push_toks(toks, TOK_PAREN_OPEN);
                             if( frag.args.prec_is_arg ) {
-                                push_toks(toks, TOK_STAR, ident(FMT("a" << frag.args.prec).c_str()) );
-                                if( TARGETVER_LEAST_1_90 ) {
-                                    push_toks(toks, TOK_RWORD_AS, ident("u16"));
-                                }
+                                push_count_arg(frag.args.prec);
                             }
                             else {
                                 push_toks(toks, Token(U128(frag.args.prec), TARGETVER_LEAST_1_90 ? CORETYPE_U16 : CORETYPE_UINT) );
@@ -930,10 +942,7 @@ namespace {
                             push_path_count("Is");
                             push_toks(toks, TOK_PAREN_OPEN);
                             if( frag.args.width_is_arg ) {
-                                push_toks(toks, TOK_STAR, ident(FMT("a" << frag.args.width).c_str()) );
-                                if( TARGETVER_LEAST_1_90 ) {
-                                    push_toks(toks, TOK_RWORD_AS, ident("u16"));
-                                }
+                                push_count_arg(frag.args.width);
                             }
                             else {
                                 push_toks(toks, Token(U128(frag.args.width), TARGETVER_LEAST_1_90 ? CORETYPE_U16 : CORETYPE_UINT) );
