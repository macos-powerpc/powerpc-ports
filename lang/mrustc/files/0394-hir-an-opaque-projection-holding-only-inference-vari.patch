From 3df2bcd62f4649a02525c649cd097d19bf8e70c0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 08:58:35 +0000
Subject: [PATCH] hir: an opaque projection holding only inference variables is
 rigid, not fuzzy

nalgebra 0.32.3 (librsvg 2.58.5) src/geometry/point_construction.rs:75

    impl<T: Scalar, D: DimName> OPoint<T, D> where DefaultAllocator: Allocator<T, D> {
        pub fn from_slice(components: &[T]) -> Self {
            Self::from(OVector::from_row_slice(components))
        }
    }

    warn: Spare rule - _CallPath <Matrix<_,_,Const<1>,<DefaultAllocator as
          Allocator<_,_,Const<1>>>::Buffer/*O*/>>::from_row_slice(..)
    BUG: src/hir_typeck/expr_cs.cpp: Spare rules left after typecheck stabilised

construction.rs defines `from_row_slice` in four inherent impls (`OMatrix<T, R, C>`
with `R, C: DimName`, and the `Dyn` rows/columns variants).  The path type's
`Buffer` projection holds `_` and is marked opaque by the static associated-type
expansion because the impl's where-clause `DefaultAllocator: Allocator<T, D>`
matches it.  rustc keeps such a projection rigid: the non-global where-clause
wins selection (select/mod.rs winnow_candidates), projection then makes no
progress (project.rs, ImplSource::Param), and the method probe can't relate the
rigid projection with the `OMatrix<T, Dyn, C>` impl's `VecStorage<T, Dyn, C>`,
so only the `R: DimName, C: DimName` impl applies.

MatchGenerics::cmp_type compared an opaque projection holding `_` as Fuzzy
(C235, 0385), so both impls stayed candidates and the call was never decided.
Since 0392 a projection that impls match only through `_` stays unbound, so
an opaque projection with `_` now comes from a where-clause (or from no impl
matching at all, also rigid in rustc).  The Fuzzy rule is kept for impl
placeholders only.

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/hir/type.cpp b/src/hir/type.cpp
index 0dda8591..8a9d51d1 100644
--- a/src/hir/type.cpp
+++ b/src/hir/type.cpp
@@ -1024,16 +1024,23 @@ const HIR::GenericParams* HIR::TrackHrbStack::hrb_declaring_lifetime(unsigned id
                 DEBUG("- Fuzzy match due to opaque");
                 return Compare::Fuzzy;
             }
-            // An opaque projection on the right that still holds an inference variable or an impl placeholder is not
-            // a distinct type yet: once those are known it may expand to anything (rustc: a projection that can't be
-            // normalised because of inference variables is ambiguous, never a mismatch). The static resolver marks
-            // such a path opaque when its impl search is only fuzzy; nalgebra 0.32.3 point_conversion.rs:40
+            // An opaque projection on the right that still holds an impl placeholder is not a distinct type yet: once
+            // the impl's parameters are known it may expand to anything. The static resolver marks such a path opaque
+            // when its impl search is only fuzzy; nalgebra 0.32.3 point_conversion.rs:40
             // `Matrix::from_superset_unchecked(&m.coords)` in Resolve UFCS checked the blanket `SameShapeAllocator`
             // impl's bound `DefaultAllocator: Allocator<T, <ShapeConstraint as SameNumberOfRows<_, P>>::Representative, ..>`
             // against `Allocator<T, Const<R>, Const<C>>`: "Failed to find impl with 'from_superset_unchecked'".
+            // An inference variable alone does not make it fuzzy: a projection holding `_` is left unbound when impls
+            // match it only through the `_` (static.cpp expand_associated_types__UfcsKnown), so an OPAQUE one was
+            // matched by a where-clause, and rustc keeps that projection rigid (the where-clause candidate wins
+            // selection, normalisation makes no progress): it never equals a concrete type. nalgebra 0.32.3
+            // point_construction.rs:75 `OVector::from_row_slice(components)` under `DefaultAllocator: Allocator<T, D>`
+            // has `Buffer` = `<DefaultAllocator as Allocator<_, _, U1>>::Buffer`; taking it as fuzzy against the
+            // `OMatrix<T, Dyn, C>` impl's `VecStorage<T, Dyn, C>` left two `from_row_slice` candidates (rustc: only the
+            // `R: DimName, C: DimName` impl) -> "Spare rules left after typecheck stabilised".
             if( xe.binding.is_Opaque() && xe.path.m_data.is_UfcsKnown()
                 && visit_ty_with(x, [](const ::HIR::TypeRef& t){
-                    return t.data().is_Infer() || (t.data().is_Generic() && t.data().as_Generic().is_placeholder());
+                    return t.data().is_Generic() && t.data().as_Generic().is_placeholder();
                     }) )
             {
                 DEBUG("- Fuzzy match due to an opaque projection with unknowns - " << v << " = " << x);
