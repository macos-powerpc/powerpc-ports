+                    auto n = ::std::min<::std::streamoff>(b - a, buf.size());
+                    src.read(buf.data(), n);
+                    ASSERT_BUG(Span(), src.gcount() == n, "Short read from `" << m_outfile_path_c << "`");
+                    dst.write(buf.data(), n);
+                    a += n;
+                }
+                };
+            for(size_t i = 0; i < chunks.size(); i ++)
