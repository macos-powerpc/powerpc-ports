+        /// Write the units (see `m_unit_size`): `<out>.<n>.c` = the declarations (unit 0: with the static
+        /// definitions) + a run of function bodies (+ the trailer in the last). Nothing when the source is one unit.
+        ::std::vector<::std::string> split_units()
+        {
+            ::std::vector<::std::string>    rv;
+            if( m_unit_size == 0 || m_unit_body_ends.empty() ) {
+                return rv;
+            }
+            ::std::ifstream src(m_outfile_path_c, ::std::ios::binary);
+            ASSERT_BUG(Span(), src.is_open(), "Failed to open `" << m_outfile_path_c << "` for reading");
+            src.seekg(0, ::std::ios::end);
+            ::std::streamoff    total = src.tellg();
+            ::std::streamoff    bodies_start = m_unit_statics_end;
+            ::std::streamoff    bodies_end = m_unit_body_ends.back();
+            ::std::vector<::std::pair<::std::streamoff, ::std::streamoff>>   chunks;
+            ::std::streamoff    cur = bodies_start;
+            for(auto e : m_unit_body_ends)
+            {
+                if( e - cur >= static_cast<::std::streamoff>(m_unit_size) ) {
+                    chunks.push_back( ::std::make_pair(cur, e) );
+                    cur = e;
+                }
+            }
+            if( cur < bodies_end || chunks.empty() ) {
+                chunks.push_back( ::std::make_pair(cur, bodies_end) );
+            }
+            if( chunks.size() < 2 ) {
+                return rv;
+            }
+            ::std::vector<char> buf(1 << 20);
+            auto copy_range = [&](::std::ostream& dst, ::std::streamoff a, ::std::streamoff b) {
+                src.seekg(a);
+                while( a < b )
