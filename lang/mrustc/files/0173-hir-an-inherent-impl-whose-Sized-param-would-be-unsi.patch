From d3ebe3a2c4986fd2774d7467a0222a9125226cc6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 07:56:17 +0000
Subject: [PATCH] hir: an inherent impl whose `Sized` param would be unsized
 doesn't match

base64-simd 0.8.0 src/forgiving.rs:51 (skim 5.7.3):

    let dst = dst.as_mut_ptr();     // dst: outref::Out<'d, [u8]>

    Spare rule - _CallMethod {Out<'_, [u8]>}.as_mut_ptr() -> *mut u8
    BUG: expr_cs.cpp: Spare rules left after typecheck stabilised

outref 0.5.2 has `impl<'a, T> Out<'a, T>` (T implicitly Sized) and
`impl<'a, T> Out<'a, [T]>`, and both define `as_mut_ptr`. find_method
picks the `[T]` one (it checks the Sized bound). The resulting
`<Out<[u8]>>::as_mut_ptr` path doesn't say which impl it means, and
the cache population that resolves it again saw both impls and stayed
ambiguous. With typeck made to pick, lifetime inference, MIR lowering
and codegen resolve the path the same way and took the `T = [u8]` impl
("Mismatched types: u8 != [u8]").

TypeImpl::matches_type, which all of them reach through
Crate::find_type_impls, now rejects an inherent impl when a type
parameter without `?Sized` would be matched to a slice, `str` or trait
object. Trait and marker impls are unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir/hir_ops.cpp b/src/hir/hir_ops.cpp
index 012c6bbb..1c7490f3 100644
--- a/src/hir/hir_ops.cpp
+++ b/src/hir/hir_ops.cpp
@@ -35,6 +35,8 @@ namespace {
         ImplMatcher(const ::HIR::GenericParams& impl_generics):
             impl_types(impl_generics.m_types.size())
         {}
+        /// The type matched for impl type param `i` (null if the impl type didn't mention it)
+        const ::HIR::TypeRef* matched_type(size_t i) const { return impl_types[i]; }
 
         ::HIR::Compare match_ty(const ::HIR::GenericRef& g, const ::HIR::TypeRef& ty, ::HIR::t_cb_resolve_type resolve_cb) override {
             assert( g.binding < impl_types.size() );
@@ -52,7 +54,7 @@ namespace {
         }
     };
 
-    bool matches_type_root(const ::HIR::GenericParams& params, const ::HIR::TypeRef& impl_ty, const ::HIR::TypeRef& match_type, ::HIR::t_cb_resolve_type ty_res)
+    bool matches_type_root(const ::HIR::GenericParams& params, const ::HIR::TypeRef& impl_ty, const ::HIR::TypeRef& match_type, ::HIR::t_cb_resolve_type ty_res, bool check_sized=false)
     {
         if( is_unbounded_infer(match_type) || TU_TEST1(match_type.data(), Path, .binding.is_Unbound()) ) {
             return false;
@@ -60,7 +62,25 @@ namespace {
         #if 1
         ImplMatcher m { params };
         auto cmp = impl_ty.match_test_generics_fuzz(Span(), match_type, ty_res, m);
-        return cmp != HIR::Compare::Unequal;
+        if( cmp == HIR::Compare::Unequal )
+            return false;
+        // An inherent impl whose (implicitly) `Sized` param would be a slice, `str` or trait object doesn't apply, and
+        // an inherent path doesn't say which impl it means, so every pass needs this
+        // - base64-simd 0.8.0 forgiving.rs:51: `dst.as_mut_ptr()` on outref 0.5.2's `Out<'_, [u8]>` with both
+        //   `impl<'a, T> Out<'a, T>` and `impl<'a, T> Out<'a, [T]>` (typeck: ambiguous until "Spare rule")
+        if( check_sized )
+        {
+            for(size_t i = 0; i < params.m_types.size(); i ++)
+            {
+                const auto* tp = m.matched_type(i);
+                if( !tp || !params.m_types[i].m_is_sized )
+                    continue ;
+                const auto& t = tp->data().is_Infer() ? ty_res.get_type(Span(), *tp) : *tp;
+                if( t.data().is_Slice() || t.data().is_TraitObject() || t == ::HIR::CoreType::Str )
+                    return false;
+            }
+        }
+        return true;
         #else
         return matches_type_int(impl_ty, match_type, ty_res, true);
         #endif
@@ -80,7 +100,7 @@ bool ::HIR::TraitImpl::matches_type(const ::HIR::TypeRef& type, ::HIR::t_cb_reso
 }
 bool ::HIR::TypeImpl::matches_type(const ::HIR::TypeRef& type, ::HIR::t_cb_resolve_type ty_res) const
 {
-    return matches_type_root(m_params, m_type, type, ty_res);
+    return matches_type_root(m_params, m_type, type, ty_res, /*check_sized=*/true);
 }
 bool ::HIR::MarkerImpl::matches_type(const ::HIR::TypeRef& type, ::HIR::t_cb_resolve_type ty_res) const
 {
