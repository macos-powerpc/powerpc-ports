From 41f040a7771dcd14501b3d3d7b3bc6baee632c2e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 06:14:35 +0000
Subject: [PATCH 104/105] parse: a block-like `:expr` fragment in statement
 position ends the statement

http 1.5.0 (killport 2.0.2) src/header/map.rs, `insert_phase_one!` ->
`probe_loop!`:

    if $probe_var < $len {
        $body
        $probe_var += 1;
    }

    map.rs:1228:19 error:0: Unexpected token TOK_IDENT"probe", expected TOK_BRACE_CLOSE

`$body:expr` is a `{ .. }` block. Written out, a block (or `if`, `match`,
`loop`, `while`, `for`) followed by another statement needs no `;`, and rustc
treats the same expression arriving as an `:expr` fragment the same way.
mrustc sent every interpolated expression to the expression-statement parser,
which then wanted a `;` or the closing `}`. A commented-out stub for this
case (citing rust-lang/rust#78829) was already in place. http 1.3.1 has the
same macros, so any http 1.x hits this.

The block-line parser now takes a `TOK_INTERPOLATED_EXPR` holding one of those
node types the same way as the block written out: an optional `;`, and
a following `.` or `?` still makes it the start of an expression. Any other
fragment goes to the expression-statement parser as before.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/parse/expr.cpp | 31 +++++++++++++++++++++++--------
 1 file changed, 23 insertions(+), 8 deletions(-)

diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index 7b273381..a1c49227 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -398,14 +398,29 @@ ExprNodeP Parse_ExprBlockLine(TokenStream& lex, bool *add_silence)
             }
             return ret;
             }
-        // TODO: if this expression captures a block, then treat it as a statement.
-        // Otherwise, interpret as normal expression
-        // HACK: Just treat a leading `:expr` as a statement (rust-lang/rust #78829) (ref: rustc-1.39.0-src\vendor\indexmap\src\map.rs:1139)
-        //case TOK_INTERPOLATED_EXPR:
-        //    DEBUG(":expr");
-        //    if( dynamic_cast<AST::ExprNode_Block .frag_node()
-        //    PUTBACK(tok, lex);
-        //    return Parse_Stmt(lex);
+        // A `$e:expr` fragment holding a block-like expression ends the statement, as the same tokens written out would:
+        // `$body $probe_var += 1;` (http 1.5.0 `probe_loop!`). Any other expression is an ordinary expression statement.
+        case TOK_INTERPOLATED_EXPR: {
+            const auto& node = tok.frag_node();
+            if( !( dynamic_cast<const AST::ExprNode_Block*>(&node) || dynamic_cast<const AST::ExprNode_If*>(&node)
+                || dynamic_cast<const AST::ExprNode_Match*>(&node) || dynamic_cast<const AST::ExprNode_Loop*>(&node)
+                || dynamic_cast<const AST::ExprNode_While*>(&node) || dynamic_cast<const AST::ExprNode_For*>(&node) ) )
+            {
+                PUTBACK(tok, lex);
+                return Parse_ExprBlockLine_Stmt(lex, *add_silence);
+            }
+            ret = tok.take_frag_node();
+            // Same as a block written out: followed by `.` or `?`, it's the start of an expression
+            if( lex.lookahead(0) == TOK_DOT || lex.lookahead(0) == TOK_QMARK ) {
+                lex.putback( Token(Token::TagTakeIP(), InterpolatedFragment(InterpolatedFragment::EXPR, ret.release())) );
+                return Parse_ExprBlockLine_Stmt(lex, *add_silence);
+            }
+            if( LOOK_AHEAD(lex) == TOK_SEMICOLON ) {
+                GET_TOK(tok, lex);
+                *add_silence = true;
+            }
+            return ret;
+            }
 
         default:
             PUTBACK(tok, lex);
