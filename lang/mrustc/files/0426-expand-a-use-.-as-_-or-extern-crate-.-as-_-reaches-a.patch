From 38826e0d1d19aa07e879cb879f31b02e2b6e9565 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 1 Nov 2026 07:50:52 +0000
Subject: [PATCH] expand: a `use .. as _` or `extern crate .. as _` reaches an attribute
 proc macro as `_`

cargo 0.99.0 (cargo-c 0.10.25) src/cargo/diagnostics/rules/text_direction_codepoint_in_literal.rs:51
`#[instrument(skip_all)]` (tracing-attributes 0.1.31) on a fn whose body has `use toml_writer::ToTomlKey as _;`:
"Unexpected token TOK_INTEGER:28, expected one of TOK_UNDERSCORE or TOK_IDENT". An attribute proc macro gets the
item re-serialised from the AST, and the parser stores an `as _` rename under an anonymous name, a space followed
by a counter (" 28" there). A fn body is serialised by printing the AST (DumpAST_Node) and re-lexing the text, so
the name came back as the integer 28; a module-level `use` or `extern crate .. as _` sent it as an identifier,
which the macro's own string round trip would have turned into the same integer.

ast/dump.cpp prints `_` for such a name in `use` and `extern crate` items, and the item serialiser in
expand/proc_macro.cpp does the same (send_ident_or_underscore).

Assisted-by: Claude Fable 5.1
---

diff --git a/src/ast/dump.cpp b/src/ast/dump.cpp
index 45e25a79..5e0b649b 100644
--- a/src/ast/dump.cpp
+++ b/src/ast/dump.cpp
@@ -927,7 +927,9 @@ void RustPrinter::handle_module(const AST::Module& mod)
                 m_os << "::*";
             }
             else if( ent.path.nodes().size() > 0 && ent.name != ent.path.nodes().back().name() ) {
-                m_os << " as " << ent.name;
+                // An `as _` rename is stored under an anonymous name (a space and a counter); the dump is re-parsed
+                // for proc-macro input (expand/proc_macro.cpp visit_node), so print what was written
+                m_os << " as " << (ent.name.c_str()[0] == ' ' ? "_" : ent.name.c_str());
             }
             else {
             }
@@ -946,7 +948,7 @@ void RustPrinter::handle_module(const AST::Module& mod)
         const auto& e = item.data.as_Crate();
 
         print_attrs(item.attrs);
-        m_os << indent() << "extern crate \"" << e.name << "\" as " << item.name << ";\n";
+        m_os << indent() << "extern crate \"" << e.name << "\" as " << (item.name.c_str()[0] == ' ' ? "_" : item.name.c_str()) << ";\n";
     }
 
     for( const auto& ip : mod.m_items )
diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 1e5c543c..a3da3d78 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -1918,6 +1918,18 @@ namespace {
             m_pmi.send_symbol(";");
         }
 
+        // `use a::B as _;` / `extern crate a as _;` are stored under an anonymous name (a space and a counter,
+        // parse/root.cpp get_optional_ident); the macro must see the `_` that was written (cargo 0.99.0
+        // `#[instrument]` over a body with `use toml_writer::ToTomlKey as _;`: the name came back as the integer)
+        void send_ident_or_underscore(const RcString& name)
+        {
+            if( name.c_str()[0] == ' ' ) {
+                m_pmi.send_rword("_");
+            }
+            else {
+                m_pmi.send_ident(name.c_str());
+            }
+        }
         void visit_use(const RcString& /*name*/, const AST::Visibility& vis, const ::AST::UseItem& item)
         {
             this->visit_vis(vis);
@@ -1947,7 +1959,7 @@ namespace {
             }
             else if( ent.name != ent.path.nodes().back().name() ) {
                 m_pmi.send_rword("as");
-                m_pmi.send_ident( ent.name.c_str() );
+                send_ident_or_underscore(ent.name);
             }
             else {
             }
@@ -2130,7 +2142,7 @@ namespace {
                 m_pmi.send_ident(e.name.c_str());
                 if( name != e.name ) {
                     m_pmi.send_rword("as");
-                    m_pmi.send_ident(name.c_str());
+                    send_ident_or_underscore(name);
                 }
                 m_pmi.send_symbol(";");
                 }
