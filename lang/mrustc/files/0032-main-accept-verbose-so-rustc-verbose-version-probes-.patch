From d1d0151bc2f4d841214a699a49b857e98541cfd0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 00:16:45 +0000
Subject: [PATCH 32/36] main: accept `--verbose` so `rustc --verbose --version`
 probes work

`version_check` (used by proc-macro-error 1.0.4's build script, among
others) runs `$RUSTC --verbose --version` with `--verbose` FIRST. mrustc
rejected it with "Unknown option '--verbose'" before ever reaching the
`--version` handler, so the probe returned no output and the build script
aborted with `called Option::unwrap() on a None value`
(`Channel::read().unwrap()`). autocfg passes `--version --verbose` and so
never noticed, since `--version` exits before the second flag is seen.

Accept `--verbose` as a no-op in the long-option chain.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/main.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/main.cpp b/src/main.cpp
index 61d3badb..fc78e5d4 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1190,6 +1190,11 @@ ProgramParams::ProgramParams(int argc, char *argv[])
                 this->show_help();
                 exit(0);
             }
+            // --verbose  >> Accepted (no effect) so `rustc --verbose --version` probes work: `version_check`
+            //               passes `--verbose` FIRST, so rejecting it never reaches the `--version` handler
+            //               (proc-macro-error's build script then unwraps a `None` channel and aborts)
+            else if( strcmp(arg, "--verbose") == 0 ) {
+            }
             else if( strcmp(arg, "--version" ) == 0 ) {
                 const char* rustc_target = target_version_str(gTargetVersion);
                 // NOTE: Starts the version with "rustc 1.29.100" so build scripts don't get confused
