From 77e2620539c2e68efd5ee93d1ddfc33bbf07f009 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 05:21:03 +0000
Subject: [PATCH 101/105] hir_typeck: coerce between projections of the same
 item by equality once one is opaque

nom 8.0.0 multi/mod.rs:749 (`many0_count`, same in `many1_count`):

    let mut count = 0;
    ...
    Err(Err::Error(_)) => return Ok((input, OM::Output::bind(|| count))),

    error:0: Type mismatch between usize and i32

The return type expects `<<OM as OutputMode>::Output as Mode>::Output<usize>`
(`Mode::Output<T>` is a GAT), and `bind` returns `<..>::Output<_T>`, where `_T`
is the closure's return type, i.e. the integer literal. The tuple field is
a coercion site. The expected side is opaque (its Self type only has a bound).
The other side stays unbound while its argument is an ivar, and
check_coerce_tys returns Unknown whenever either side is an unbound
projection. Nothing else constrains `_T`, so the coercion waited until the
literal fell back to i32, then failed.

The impl for a projection is chosen by its Self type and trait arguments, not
by the item's own arguments. If one of two projections of the same item is
opaque, the other is too, and no CoerceUnsized impl applies to an opaque type.
So treat the coercion as an equality. Equating the two projections then
equates the item arguments (the check_associated path from 0078).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 416e27f5..7a857940 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -4898,6 +4898,24 @@ namespace {
             }
         }
 
+        // Two projections of the same item where only the item's own arguments differ (a GAT's `<X as Tr>::Out<usize>` against
+        // `<X as Tr>::Out<_1>`). The impl is picked by the Self type and trait arguments alone, so if one side is already known
+        // to be opaque then so is the other, and no CoerceUnsized impl applies to an opaque type. This is an equality, and
+        // waiting would leave the ivar in the arguments to its fallback.
+        if( TU_TEST1(dst.data(), Path, .path.m_data.is_UfcsKnown()) && TU_TEST1(src.data(), Path, .path.m_data.is_UfcsKnown()) )
+        {
+            const auto& dpe = dst.data().as_Path().path.m_data.as_UfcsKnown();
+            const auto& spe = src.data().as_Path().path.m_data.as_UfcsKnown();
+            if( (dst.data().as_Path().binding.is_Opaque() || src.data().as_Path().binding.is_Opaque())
+                && dpe.item == spe.item && dpe.trait.m_path == spe.trait.m_path
+                && context.m_ivars.types_equal(dpe.type, spe.type)
+                && context.m_ivars.pathparams_equal(dpe.trait.m_params, spe.trait.m_params) )
+            {
+                DEBUG("Same projection on both sides, one opaque - equality");
+                return CoerceResult::Equality;
+            }
+        }
+
         // If either side is an unbound UFCS, can't know yet
         if( TU_TEST1(dst.data(), Path, .binding.is_Unbound()) || TU_TEST1(src.data(), Path, .binding.is_Unbound()) )
         {
