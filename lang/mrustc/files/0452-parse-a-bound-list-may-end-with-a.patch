From 48b6ba06fdf3288c482ee3dc25f2df1b9ec861b8 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 7 Nov 2026 06:56:04 +0000
Subject: [PATCH] parse: a bound list may end with a `+`

tor-hsclient 0.47.0 (arti 2.7.0) connect.rs:1646 `#[async_trait] trait
MockableCircPool<R>`: `error:0: Unexpected token TOK_COMMA, expected
TOK_LIFETIME`.

async-trait 0.1.92 (expand.rs transform_sig) gives a method's own
lifetime parameter the predicate `'a: 'async_trait + #bounds`, and the
trait's `async fn m_get_or_launch_client_rend<'a>(..)` has no bounds on
`'a`, so the generated where clause reads `'a: 'async_trait +, 'life0:
'async_trait, Self: 'async_trait`. rustc accepts a trailing `+` in every
bound list (`T: Clone +`, `Box<dyn Debug+>`, ui/parser/trailing-plus-in-
bounds.rs); the parser's lifetime-bound loops read the `+` and then
demanded a lifetime, and the type-bound loops only tolerated some
terminators.

Parse_BoundList_Next takes the `+` and continues the list only when the
next token can begin a bound; the lifetime bounds of a generic parameter
and of a where predicate, Parse_TypeBound, trait-object lists and
`impl Trait` bounds all use it.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/parse/common.hpp b/src/parse/common.hpp
index c8f94ac5..8229352b 100644
--- a/src/parse/common.hpp
+++ b/src/parse/common.hpp
@@ -43,6 +43,7 @@ extern AST::PathParams Parse_Path_GenericList(TokenStream& lex);
 
 extern AST::Visibility Parse_Publicity(TokenStream& lex, bool allow_restricted=true);
 extern AST::HigherRankedBounds Parse_HRB(TokenStream& lex);
+extern bool Parse_BoundList_Next(TokenStream& lex);
 extern ::AST::HigherRankedBounds Parse_HRB_Opt(TokenStream& lex);
 extern AST::AttributeList  Parse_ItemAttrs(TokenStream& lex);
 extern void Parse_ParentAttrs(TokenStream& lex, AST::AttributeList& out);
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 7711f72c..b516246e 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -226,6 +226,29 @@ void Parse_Publicity_Inherited(TokenStream& lex, const char* what)
     CHECK_TOK(tok, TOK_GT);
     return rv;
 }
+// A bound list may end with a `+` (rustc: `T: Clone +`, `Box<dyn Debug+>`; async-trait 0.1.92 writes `'a: 'async_trait +`
+// for a method's own lifetime parameter, tor-hsclient 0.47.0): the `+` is taken, and the list goes on only when the
+// next token can begin a bound
+bool Parse_BoundList_Next(TokenStream& lex)
+{
+    if( !lex.getTokenIf(TOK_PLUS) )
+        return false;
+    switch( lex.lookahead(0) )
+    {
+    case TOK_COMMA:
+    case TOK_GT:    case TOK_GTE:   case TOK_DOUBLE_GT: case TOK_DOUBLE_GT_EQUAL:
+    case TOK_BRACE_OPEN:
+    case TOK_SEMICOLON:
+    case TOK_EQUAL:
+    case TOK_PAREN_CLOSE:
+    case TOK_SQUARE_CLOSE:
+    case TOK_RWORD_WHERE:
+    case TOK_EOF:
+        return false;
+    default:
+        return true;
+    }
+}
 ::AST::HigherRankedBounds Parse_HRB_Opt(TokenStream& lex)
 {
     if( lex.lookahead(0) == TOK_RWORD_FOR )
@@ -307,7 +330,7 @@ void Parse_TypeBound(TokenStream& lex, AST::GenericParams& ret, TypeRef checked_
         if( is_paren ) {
             GET_CHECK_TOK(tok, lex, TOK_PAREN_CLOSE);
         }
-    } while( lex.getTokenIf(TOK_PLUS) );
+    } while( Parse_BoundList_Next(lex) );
 }
 
 /// Parse type parameters within '<' and '>' (definition)
@@ -363,7 +386,8 @@ AST::GenericParams Parse_GenericParams(TokenStream& lex)
                     do {
                         GET_CHECK_TOK(tok, lex, TOK_LIFETIME);
                         ret.add_bound(AST::GenericBound::make_Lifetime({ AST::LifetimeRef(ref), get_LifetimeRef(lex, mv$(tok)) }));
-                    } while( GET_TOK(tok, lex) == TOK_PLUS );
+                    } while( Parse_BoundList_Next(lex) );
+                    GET_TOK(tok, lex);
                 }
                 else {
                     GET_TOK(tok, lex);
@@ -440,7 +464,7 @@ void Parse_WhereClause(TokenStream& lex, AST::GenericParams& params)
                 GET_CHECK_TOK(tok, lex, TOK_LIFETIME);
                 auto rhs = get_LifetimeRef(lex, mv$(tok));
                 params.add_bound( AST::GenericBound::make_Lifetime({lhs, rhs}) );
-            } while( lex.getTokenIf(TOK_PLUS) );
+            } while( Parse_BoundList_Next(lex) );
         }
         // Higher-ranked types/lifetimes
         else if( lex.getTokenIf(TOK_RWORD_FOR) )
diff --git a/src/parse/types.cpp b/src/parse/types.cpp
index b1c90594..6ec5f90f 100644
--- a/src/parse/types.cpp
+++ b/src/parse/types.cpp
@@ -303,7 +303,7 @@ TypeRef Parse_Type_Path(TokenStream& lex, ::AST::HigherRankedBounds hrbs, bool a
 
         if( allow_trait_list )
         {
-            while( lex.getTokenIf(TOK_PLUS) )
+            while( Parse_BoundList_Next(lex) )
             {
                 if( lex.getTokenIf(TOK_LIFETIME, tok) ) {
                     lifetimes.push_back(AST::LifetimeRef( /*lex.point_span(),*/ tok.ident() ));
@@ -368,7 +368,7 @@ TypeRef Parse_Type_TraitObject(TokenStream& lex, ::AST::HigherRankedBounds hrbs)
             }
         }
 
-        if( !lex.getTokenIf(TOK_PLUS) )
+        if( !Parse_BoundList_Next(lex) )
             break;
     }
 
@@ -415,7 +415,7 @@ TypeRef Parse_Type_ErasedType(TokenStream& lex, bool allow_trait_list)
             AST::HigherRankedBounds hrbs = Parse_HRB_Opt(lex);
             rv_data.traits.push_back({ mv$(hrbs), Parse_Path(lex, PATH_GENERIC_TYPE) });
         }
-    } while( lex.getTokenIf(TOK_PLUS) );
+    } while( Parse_BoundList_Next(lex) );
 
     return TypeRef(lex.end_span(ps), box$(rv_data));
 }
