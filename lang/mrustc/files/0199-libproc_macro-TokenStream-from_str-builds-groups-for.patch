From 0eac88de35f7137b87a34b3974b9bac58ac66b4a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 17:01:12 +0000
Subject: [PATCH 199/199] libproc_macro: TokenStream::from_str builds groups
 for delimiters

The string lexer emitted `(`, `[`, `{` and their closers as `Punct`
tokens.  proc-macro2 1.0.95+ validates the character of every `Punct` it
wraps and panics on a delimiter: phf_macros 0.13.1 `phf_set!` does
`syn::parse_str("()")` for the unit value, so matroska 0.30.1 (fselect)
died with "unsupported proc macro punctuation character '('" followed
by "Unexpected EOF while reading from child process".

Delimiters now open and close a `Group` (nested through a stack);
mismatched or unclosed delimiters are lex errors.  Unit test `groups`
added beside the existing lexer tests.

Needs libproc_macro rebuilt, and the proc-macro crates relinked against
it (phf_macros here).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 lib/libproc_macro/src/lex.rs | 52 ++++++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/lib/libproc_macro/src/lex.rs b/lib/libproc_macro/src/lex.rs
index 9493dc1a..443f6df4 100644
--- a/lib/libproc_macro/src/lex.rs
+++ b/lib/libproc_macro/src/lex.rs
@@ -81,6 +81,8 @@ impl ::std::str::FromStr for TokenStream {
     fn from_str(src: &str) -> Result<TokenStream, LexError> {
         debug!("TokenStream::from_str({:?})\r", src);
         let mut rv: Vec<crate::TokenTree> = Vec::new();
+        // Delimited groups: the enclosing levels, innermost last (`rv` is the level being read)
+        let mut stack: Vec<(crate::Delimiter, Vec<crate::TokenTree>)> = Vec::new();
         let mut it = CharStream::new(src.chars());
 
         fn err(s: &'static str) -> Result<TokenStream,LexError> {
@@ -118,6 +120,32 @@ impl ::std::str::FromStr for TokenStream {
                 continue ;
             }
 
+            // Delimiters open/close a `Group`, they are not punctuation: proc-macro2 (1.0.95+) rejects a `Punct` of `(`
+            // ("unsupported proc macro punctuation character '('", phf_macros `syn::parse_str("()")` via matroska 0.30.1)
+            if c == '(' || c == '[' || c == '{'
+            {
+                let d = match c { '(' => crate::Delimiter::Parenthesis, '[' => crate::Delimiter::Bracket, _ => crate::Delimiter::Brace };
+                stack.push( (d, ::std::mem::replace(&mut rv, Vec::new())) );
+                it.consume();
+                continue ;
+            }
+            if c == ')' || c == ']' || c == '}'
+            {
+                let d = match c { ')' => crate::Delimiter::Parenthesis, ']' => crate::Delimiter::Bracket, _ => crate::Delimiter::Brace };
+                let (open_d, outer) = match stack.pop()
+                    {
+                    Some(v) => v,
+                    None => return err("Unexpected closing delimiter"),
+                    };
+                if open_d != d {
+                    return err("Mismatched closing delimiter");
+                }
+                let inner = ::std::mem::replace(&mut rv, outer);
+                rv.push(crate::Group::new(d, TokenStream { inner: inner }).into());
+                it.consume();
+                continue ;
+            }
+
             if c == '\''
             {
                 c = match it.consume() {
@@ -484,6 +512,10 @@ impl ::std::str::FromStr for TokenStream {
             }
         }
 
+        if !stack.is_empty() {
+            return err("Unclosed delimiter");
+        }
+
         Ok(TokenStream {
             inner: rv,
             })
@@ -537,6 +569,26 @@ mod tests {
         assert_tt_matches!(it.next());
     }
 
+    #[test]
+    fn groups()
+    {
+        let rv = TokenStream::from_str("f((), [a])").expect("Failed to parse");
+        let mut it = rv.inner.into_iter();
+        assert_tt_matches!(it.next(), Ident::new("f", Span::call_site()).into());
+        let g = match it.next() { Some(TokenTree::Group(g)) => g, v => panic!("Expected group, got {:?}", v) };
+        assert_eq!(g.delimiter(), Delimiter::Parenthesis);
+        let mut it2 = g.stream.inner.into_iter();
+        let g2 = match it2.next() { Some(TokenTree::Group(g)) => g, v => panic!("Expected group, got {:?}", v) };
+        assert_eq!(g2.delimiter(), Delimiter::Parenthesis);
+        assert!(g2.stream.inner.is_empty());
+        assert_tt_matches!(it2.next(), Punct::new(',', Spacing::Alone).into());
+        let g3 = match it2.next() { Some(TokenTree::Group(g)) => g, v => panic!("Expected group, got {:?}", v) };
+        assert_eq!(g3.delimiter(), Delimiter::Bracket);
+        assert_tt_matches!(it2.next());
+        assert_tt_matches!(it.next());
+        assert!(TokenStream::from_str("(]").is_err());
+        assert!(TokenStream::from_str("(").is_err());
+    }
     #[test]
     fn trailing_zero()
     {
