From d469d370aba94a2a0e8aeb32832c1c869528ac2c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 19:16:33 +0000
Subject: [PATCH 70/70] minicargo: let MINICARGO_IGNTOOLS also ignore libraries
 from the -L directories

Setting `MINICARGO_IGNTOOLS` stopped minicargo from rebuilding crates
older than the compiler binary, but not crates older than a library the
compiler found through `-L`: each crate's depfile lists the libstd/libcore
rlibs it linked, and a reinstalled toolchain gives those fresh
timestamps too. So after every mrustc rebuild a MacPorts build restarted
from the first crate, even when the compiler change couldn't have
affected already-built code.

With the variable set, depfile entries inside one of the `-L`
directories are now ignored as well. Crates in the output directory are
still compared, so a rebuilt dependency propagates to its users, and
a touched source still rebuilds its crate. Document the variable in the
help text.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 tools/minicargo/build.cpp | 39 ++++++++++++++++++++++++++++++++++++++-
 tools/minicargo/main.cpp  |  4 ++++
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/tools/minicargo/build.cpp b/tools/minicargo/build.cpp
index 1075345f..7f3c11f3 100644
--- a/tools/minicargo/build.cpp
+++ b/tools/minicargo/build.cpp
@@ -101,6 +101,8 @@ struct RunState
     }
 
     bool outfile_needs_rebuild(const helpers::path& outfile) const;
+    /// Is `file` part of the toolchain (inside one of the `-L` directories)?
+    bool is_toolchain_file(const ::std::string& file) const;
 
     /// Get the crate suffix (stuff added to the crate name to form the filename)
     ::std::string get_crate_suffix(const PackageManifest& manifest) const;
@@ -796,15 +798,46 @@ namespace {
     }
 }
 
+bool RunState::is_toolchain_file(const ::std::string& file) const
+{
+    // Collapse repeated separators: `-L dir/` records its finds as `dir//libfoo.rlib` in the depfile
+    auto squash = [](::std::string s) {
+        ::std::string rv;
+        rv.reserve(s.size());
+        for(char c : s) {
+            if( c == '/' && !rv.empty() && rv.back() == '/' )
+                continue;
+            rv += c;
+        }
+        return rv;
+        };
+    auto f = squash( ::helpers::path(file).to_absolute().str() );
+    for(const auto& d : m_opts.lib_search_dirs)
+    {
+        auto dir = squash( d.to_absolute().str() );
+        if( dir.empty() )
+            continue;
+        if( dir.back() != '/' )
+            dir += '/';
+        if( f.compare(0, dir.size(), dir) == 0 )
+            return true;
+    }
+    return false;
+}
 bool RunState::outfile_needs_rebuild(const helpers::path& outfile) const
 {
+    // `MINICARGO_IGNTOOLS`: don't rebuild only because the toolchain is newer - the compiler binary, or a library in one
+    // of the `-L` directories (libstd reinstalled along with the compiler). Lets an interrupted build resume after
+    // a compiler rebuild that doesn't change code generation. Crates in the output directory are still checked,
+    // so a rebuilt dependency propagates.
+    const bool ignore_tools = getenv("MINICARGO_IGNTOOLS") != nullptr;
     auto ts_result = Timestamp::for_file(outfile);
     if( ts_result == Timestamp::infinite_past() ) {
         // Rebuild (missing)
         DEBUG("Building " << outfile << " - Missing");
         return true;
     }
-    else if( !getenv("MINICARGO_IGNTOOLS") && ts_result < Timestamp::for_file(m_compiler_path) ) {
+    else if( !ignore_tools && ts_result < Timestamp::for_file(m_compiler_path) ) {
         // Rebuild (older than mrustc/minicargo)
         DEBUG("Building " << outfile << " - Older than mrustc (" << ts_result << " < " << Timestamp::for_file(m_compiler_path) << ")");
         return true;
@@ -818,6 +851,10 @@ bool RunState::outfile_needs_rebuild(const helpers::path& outfile) const
         {
             for(const auto& f : it->second)
             {
+                if( ignore_tools && this->is_toolchain_file(f) ) {
+                    DEBUG("Ignoring toolchain dependency " << f << " of " << outfile);
+                    continue;
+                }
                 auto dep_ts = Timestamp::for_file(f);
                 if( ts_result < dep_ts )
                 {
diff --git a/tools/minicargo/main.cpp b/tools/minicargo/main.cpp
index 8a765a4b..c4a5e291 100644
--- a/tools/minicargo/main.cpp
+++ b/tools/minicargo/main.cpp
@@ -738,5 +738,9 @@ void ProgramOptions::help() const
         << "--no-default-features    : \n"
         << "--features <list>        : \n"
         << "--panic <strategy>       : Pass `-C panic=<strategy>` to the compiler (e.g. `unwind`)\n"
+        << "\n"
+        << "Environment:\n"
+        << "MINICARGO_IGNTOOLS=1     : Don't rebuild a crate only because mrustc or a library in a -L directory is newer\n"
+        << "                           than it (resume an interrupted build after a compiler rebuild)\n"
         ;
 }
