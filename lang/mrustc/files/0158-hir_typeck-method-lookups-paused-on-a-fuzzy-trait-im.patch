From dec7760c2961b4cf4c106cd26be09b38d42a2588 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 03:35:45 +0000
Subject: [PATCH 158/159] hir_typeck: method lookups paused on a fuzzy trait
 impl run before fallback guessing

http-body-util 0.1.3 combinators/box_body.rs:68 (drill 0.9.1), after 0144:

    BoxBody::new(crate::Empty::new().map_err(|err| match err {}))

    error: Failed to find an impl of Body for MapErr<Empty<D>,
           closure(Infallible)->!> with Error = E

`map_err` on `Empty<_>` matches `BodyExt`'s blanket impl only fuzzily
(`Empty<_>: Body` needs `_: Buf`), so 0144 paused the lookup until the
ivar-possibility stages pin the receiver. Here nothing but the method's
own result can pin `_`, so the lookup stayed paused into the fallback
stages. "IVar possibilities (fallback)" then gave the closure the `!` of
its body as return type, and only the following "Node revisits
(fallback)" looked `map_err` up. Its `F: FnMut(Self::Error) -> E` bound
would have made the return type `E`, as rustc infers.

A lookup that paused on a Fuzzy-only impl (`DeferredOnFuzzyImpl`, now
reported through an out-flag of `autoderef_find_method`) now runs in
a new "Node revisits (deferred methods)" stage. It sits after the plain
"IVar possibilities" stage and before the first fallback stage, and it
commits to the fuzzy impl as before 0144. The stage runs only when
a lookup actually paused, and it revisits only method calls. The
http-body `Pin<_>` case is pinned by the plain stage and still waits.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 624d7774..a2cd5009 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -97,11 +97,17 @@ namespace {
         /// more extreme actions (e.g. ignoring an ambigious inherent method
         /// and using a trait method instead)
         bool m_is_fallback;
+        /// Method lookups pause on a trait impl that only matches by binding receiver ivars (see `find_method`)
+        bool m_defer_fuzzy_impls;
     public:
         ExprVisitor_Revisit(Context& context, bool fallback=false):
+            ExprVisitor_Revisit(context, fallback, !fallback)
+        {}
+        ExprVisitor_Revisit(Context& context, bool fallback, bool defer_fuzzy_impls):
             context(context),
             m_completed(false),
-            m_is_fallback(fallback)
+            m_is_fallback(fallback),
+            m_defer_fuzzy_impls(defer_fuzzy_impls)
         {}
 
         bool node_completed() const {
@@ -976,7 +982,8 @@ namespace {
             //   back to trait if the inherent is still ambigious.
             ::std::vector<::std::pair<TraitResolution::AutoderefBorrow, ::HIR::Path>> possible_methods;
             // NOTE: Outside fallback mode, a trait impl that only matches by binding receiver ivars pauses the lookup (see `find_method`)
-            unsigned int deref_count = this->context.m_resolve.autoderef_find_method(node.span(), node.m_traits, node.m_trait_param_ivars, ty, node.m_method,  possible_methods, /*defer_fuzzy_impls=*/!this->m_is_fallback);
+            unsigned int deref_count = this->context.m_resolve.autoderef_find_method(node.span(), node.m_traits, node.m_trait_param_ivars, ty, node.m_method,  possible_methods,
+                this->m_defer_fuzzy_impls, &this->context.m_has_fuzzy_deferred_method);
         try_again:
             if( deref_count != ~0u )
             {
@@ -8184,6 +8191,34 @@ void Typecheck_Code_CS(const typeck::ModuleState& ms, t_args& args, const ::HIR:
             }
         } // `if peek_changed` (ivar possibilities)
 
+        // Method lookups paused on a Fuzzy-only trait impl only wait while the stages above can still pin the receiver:
+        // look them up (committing to the fuzzy impl) before the fallback stages guess ivars, as the method's signature may
+        // be what constrains them (http-body-util `Empty::new().map_err(|e| match e {})`: the closure's return type is
+        // `E` from `map_err`'s bound, not the `!` the fallback picks from its body)
+        if( !context.m_ivars.peek_changed() && context.m_has_fuzzy_deferred_method )
+        {
+            DEBUG("--- Node revisits (deferred methods)");
+            context.m_has_fuzzy_deferred_method = false;
+            for( auto it = context.to_visit.begin(); it != context.to_visit.end(); )
+            {
+                ::HIR::ExprNode& node = **it;
+                if( !dynamic_cast<::HIR::ExprNode_CallMethod*>(&node) ) {
+                    ++ it;
+                    continue;
+                }
+                ExprVisitor_Revisit visitor { context, /*fallback=*/false, /*defer_fuzzy_impls=*/false };
+                DEBUG("> " << &node << " " << typeid(node).name() << " -> " << context.m_ivars.fmt_type(node.m_res_type));
+                node.visit( visitor );
+                if( visitor.node_completed() ) {
+                    DEBUG("- Completed " << &node << " - " << typeid(node).name());
+                    it = context.to_visit.erase(it);
+                }
+                else {
+                    ++ it;
+                }
+            }
+        }
+
         // If nothing has changed, 
         if( !context.m_ivars.peek_changed() )
         {
diff --git a/src/hir_typeck/expr_cs.hpp b/src/hir_typeck/expr_cs.hpp
index 84859820..35c84ba5 100644
--- a/src/hir_typeck/expr_cs.hpp
+++ b/src/hir_typeck/expr_cs.hpp
@@ -158,6 +158,8 @@ struct Context
     ::std::vector< ::HIR::ExprNode*>    to_visit;
     /// Callback-based revisits (e.g. for slice patterns handling slices/arrays)
     ::std::vector< ::std::unique_ptr<Revisitor> >   adv_revisits;
+    /// A method lookup in `to_visit` paused on a Fuzzy-only trait impl (`TraitResolution::DeferredOnFuzzyImpl`)
+    bool m_has_fuzzy_deferred_method = false;
 
     // Keep track of if an ivar is used in a context where it has to be Sized
     // - If it is, then we can discount any unsized possibilities
diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index b4a752b2..b364c678 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -4843,7 +4843,8 @@ namespace {
 unsigned int TraitResolution::autoderef_find_method(const Span& sp,
         const HIR::t_trait_list& traits, const ::std::vector<unsigned>& ivars, const ::HIR::TypeRef& top_ty, const RcString& method_name,
         /* Out -> */::std::vector<::std::pair<AutoderefBorrow,::HIR::Path>>& possibilities,
-        bool defer_fuzzy_impls
+        bool defer_fuzzy_impls,
+        /* Out -> */bool* out_deferred_on_fuzzy
         ) const
 {
     try {
@@ -4934,6 +4935,9 @@ unsigned int TraitResolution::autoderef_find_method(const Span& sp,
         return ~0u;
     } catch(const TraitResolution::DeferredOnFuzzyImpl& ) {
         DEBUG("Trait impl match depends on receiver ivars, deferring");
+        if( out_deferred_on_fuzzy ) {
+            *out_deferred_on_fuzzy = true;
+        }
         return ~0u;
     }
 }
diff --git a/src/hir_typeck/helpers.hpp b/src/hir_typeck/helpers.hpp
index 41f7f3a6..6d9fa468 100644
--- a/src/hir_typeck/helpers.hpp
+++ b/src/hir_typeck/helpers.hpp
@@ -292,7 +292,8 @@ public:
     unsigned int autoderef_find_method(const Span& sp,
             const HIR::t_trait_list& traits, const ::std::vector<unsigned>& ivars, const ::HIR::TypeRef& top_ty, const RcString& method_name,
             /* Out -> */::std::vector<::std::pair<AutoderefBorrow,::HIR::Path>>& possibilities,
-            bool defer_fuzzy_impls = false
+            bool defer_fuzzy_impls = false,
+            /* Out -> */bool* out_deferred_on_fuzzy = nullptr
             ) const;
     /// Locate the named field by applying auto-dereferencing.
     /// \return Number of times deref was applied (or ~0 if _ was hit)
