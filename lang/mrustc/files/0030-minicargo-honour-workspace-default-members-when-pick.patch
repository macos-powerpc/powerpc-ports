From c4a2d1248d058bc7ee08a3cc5b519fbf9e7a5fb9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 2 Oct 2026 07:58:42 +0000
Subject: [PATCH 30/31] minicargo: honour `[workspace] default-members` when
 picking the member to build

Virtual workspace roots failed with
    Unknown item in [workspace] `default-members`
Parse the list, and when no `--package` is given restrict the member
auto-selection to those members (cargo builds exactly them by default),
so a workspace like gfold 2026.3.0
    members = ["gfold", "xtask"]
    default-members = ["gfold"]
builds `gfold` without needing `--package`. `--package` still wins.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 tools/minicargo/main.cpp     | 29 +++++++++++++++++++++++++++++
 tools/minicargo/manifest.cpp | 13 +++++++++++++
 tools/minicargo/manifest.h   |  3 +++
 3 files changed, 45 insertions(+)

diff --git a/tools/minicargo/main.cpp b/tools/minicargo/main.cpp
index afafdcca..aed1b894 100644
--- a/tools/minicargo/main.cpp
+++ b/tools/minicargo/main.cpp
@@ -227,6 +227,35 @@ int main(int argc, const char* argv[])
                     candidates.push_back(::std::move(c));
                 }
 
+                // `default-members` lists what cargo builds when no package is selected:
+                // restrict the heuristics below to those members (`--package` still wins)
+                if( !opts.package_name && !workspace_manifest.default_members().empty() )
+                {
+                    auto norm = [](::std::string s) {
+                        if( s.compare(0, 2, "./") == 0 )
+                            s.erase(0, 2);
+                        while( !s.empty() && s.back() == '/' )
+                            s.pop_back();
+                        return s;
+                        };
+                    ::std::vector<Candidate>    defaults;
+                    for(const auto& c : candidates)
+                    {
+                        for(const auto& dm : workspace_manifest.default_members())
+                        {
+                            if( norm(c.rel_path) == norm(dm) || c.name == dm ) {
+                                defaults.push_back(c);
+                                break;
+                            }
+                        }
+                    }
+                    if( !defaults.empty() )
+                    {
+                        DEBUG("Restricting to default-members: " << workspace_manifest.default_members());
+                        candidates = ::std::move(defaults);
+                    }
+                }
+
                 const Candidate*    sel = nullptr;
                 if( opts.package_name )
                 {
diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index 67559d5e..f9d8be64 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -201,6 +201,19 @@ WorkspaceManifest WorkspaceManifest::load_from_toml(const ::helpers::path& works
                     }
                 }
             }
+            else if( key == "default-members" )
+            {
+                if( key_val.path.size() == 2 && key_val.value.m_type == TomlValue::Type::List )
+                {
+                    for(const auto& sv : key_val.value.m_sub_values)
+                    {
+                        if( sv.m_type == TomlValue::Type::String )
+                        {
+                            rv.m_default_members.push_back(sv.as_string());
+                        }
+                    }
+                }
+            }
             else if( key == "exclude" )
             {
                 // Ignore the exclusion list (only members are candidates here)
diff --git a/tools/minicargo/manifest.h b/tools/minicargo/manifest.h
index 53e7cd03..84e25de7 100644
--- a/tools/minicargo/manifest.h
+++ b/tools/minicargo/manifest.h
@@ -335,6 +335,8 @@ class WorkspaceManifest
     ::std::map< ::std::string, ::helpers::path> m_patches;
 
     ::std::vector<::std::string>    m_members;
+    // `[workspace] default-members`: what cargo builds when no package is selected
+    ::std::vector<::std::string>    m_default_members;
 
     // `[workspace.package] version`, inheritable via `version.workspace = true`
     PackageVersion  m_package_version;
@@ -356,6 +358,7 @@ public:
     bool has_package_version() const { return m_package_version_set; }
     const PackageVersion& package_version() const { return m_package_version; }
     const ::std::vector<::std::string>& members() const { return m_members; }
+    const ::std::vector<::std::string>& default_members() const { return m_default_members; }
     const ::std::map< ::std::string, ::helpers::path>& patches() const { return m_patches; }
     const ::std::vector<PackageRef>& dependencies() const { return m_dependencies.main; }
     const ::std::vector<PackageRef>& build_dependencies() const { return m_dependencies.build; }
