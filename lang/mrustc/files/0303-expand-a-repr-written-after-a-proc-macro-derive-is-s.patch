From 85ab2290a24591fa184ff13769e79bb61efdf539 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 17:29:38 +0000
Subject: [PATCH 303/304] expand: a `#[repr]` written after a proc-macro derive
 is still applied

cyclonedx-bom 0.8.1 models/component.rs:199 (py314-maturin):
`#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, strum::Display, Hash)]
#[strum(serialize_all = "kebab-case")] #[repr(u16)] pub enum Classification {
Application = 1, .., UnknownClassification(String) }` = "error: Discrimiant value set on
enum with no `repr` set" (HIR Lower).

A derive is sent its helper attributes and `#[repr]` (TokenSink::attr_is_used), and every
attribute sent was marked inert, so Expand_Attr skipped the `repr` decorator for a `#[repr]`
placed after the derive (one placed before had already run). Only a data-carrying enum with
discriminants errors; a `#[repr(C)]`/`#[repr(u8)]`/`#[repr(transparent)]` after
`#[derive(Serialize)]`, `#[derive(Pod)]`, `#[derive(FromPrimitive)]` .. was silently
dropped. Now only the derive's own helper attributes (`attributes(..)` of the
proc_macro_derive, new TokenSink::attr_is_helper) are marked inert.

Assisted-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 970d4bcb..b09ececb 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -248,6 +248,8 @@ struct TokenSink
     virtual void send_float(eCoreType ct, double v) = 0;
     /// An attribute the receiver claims (a derive's helper attributes), sent even when attributes in general aren't
     virtual bool attr_is_used(const RcString& n) const = 0;
+    /// One of the receiver's own helper attributes (inert once sent; `#[repr]` is sent but isn't one)
+    virtual bool attr_is_helper(const RcString& n) const = 0;
 };
 struct ProcMacroInv:
     public TokenStream,
@@ -434,6 +436,9 @@ public:
     bool attr_is_used(const RcString& n) const override {
         if( n == "repr" )
             return true;
+        return attr_is_helper(n);
+    }
+    bool attr_is_helper(const RcString& n) const override {
         return ::std::find(m_proc_macro_desc.attributes.begin(), m_proc_macro_desc.attributes.end(), n) != m_proc_macro_desc.attributes.end();
     }
 
@@ -1512,7 +1517,12 @@ namespace {
             auto is_local = (a.name().is_trivial() && m_pmi.attr_is_used(a.name().as_trivial()));
             if( this->emit_all_attrs || is_local )
             {
-                if( is_local ) {
+                // A derive's helper attributes are inert (rustc: the derive consumes them). `#[repr]` is sent too but
+                // stays the compiler's: marked inert here, a `#[repr(..)]` written after the derive was never applied
+                // (cyclonedx-bom 0.8.1 component.rs:199 `#[derive(.., strum::Display, ..)] #[repr(u16)] pub enum
+                // Classification { Application = 1, .., UnknownClassification(String) }` = "Discrimiant value set on
+                // enum with no `repr` set"; a `#[repr(C)]`/`#[repr(u8)]` in that position was silently dropped)
+                if( is_local && m_pmi.attr_is_helper(a.name().as_trivial()) ) {
                     a.mark_inert();
                 }
                 DEBUG("Send " << a);
@@ -2088,6 +2098,9 @@ namespace {
         bool attr_is_used(const RcString& n) const override {
             return false;
         }
+        bool attr_is_helper(const RcString& n) const override {
+            return false;
+        }
     };
 }
 ::std::vector<Token> ProcMacro_PatternTokens(const Span& sp, const AST::Pattern& pat, const Ident::Hygiene& hygiene)
