From 9e530397db586cae85c130d383ccd8a8539cb46b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 22:33:51 +0000
Subject: [PATCH] macro_rules: a captured pattern is one alternative of a `pat`
 fragment's or-pattern

httparse 1.10.1 (ast-grep 0.50.0), edition 2018, src/macros.rs `byte_map!`:
`MACRO<::"httparse-1_10_1_H4"::byte_map> BUG: src/macro_rules/eval.cpp:2363: TODO:
Macro_InvokeRules_MatchPattern - No arm matched - (5, 38)` (lib.rs:69 URI_MAP). A 0267
regression: builds up to 0265 took the whole `b'!'..=0x7e | 0x80..=0xFF` as one `pat`.

`byte_map!`'s `$($p:pat)|+` (2018) captures each alternative separately since 0267 and
forwards `$($p)|+` into core's `matches!(.., $pattern:pat)` (2021), so that `pat` sees
`<captured pat> | <captured pat>`. Parse_Pattern already takes that as one or-pattern;
the matcher's lookahead (consume_pat) returned right after an interpolated pattern and
never continued over the `|` (position 5 = TOK_PIPE), so no arm matched. Now an
interpolated pattern is a loop case like any other alternative: with or-patterns
allowed a following `|` continues the pattern (first or later alternative); for
`pat_param` it still ends the fragment..

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 34b0a772..1b98e0cf 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -1246,9 +1246,6 @@ namespace
                 return true;
         }
 
-        if( lex.consume_if(TOK_INTERPOLATED_PATTERN) )
-            return true;
-
         if( allow_or ) {
             lex.consume_if(TOK_PIPE);
         }
@@ -1256,6 +1253,15 @@ namespace
         {
             switch(lex.next())
             {
+            // A pattern captured by an outer macro: with or-patterns allowed it is one alternative of possibly several.
+            // - httparse 1.10.1 (2018) `byte_map!`'s `$($p:pat)|+` captures each alternative (0267) and forwards
+            //   `$($p)|+` to core's `matches!(.., $pattern:pat)` (2021), which must take `<pat> | <pat>` as ONE fragment
+            //   ("No arm matched - (5, 38)" = the `|` after the first captured pattern)
+            case TOK_INTERPOLATED_PATTERN:
+                lex.consume();
+                if( allow_or && lex.consume_if(TOK_PIPE) )
+                    continue;
+                return true;
             case TOK_UNDERSCORE:
                 lex.consume();
                 if( allow_or && lex.consume_if(TOK_PIPE) )
