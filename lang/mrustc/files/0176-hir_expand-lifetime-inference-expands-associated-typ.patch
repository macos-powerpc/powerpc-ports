From 35dfc53f05f69a9f03403c0c411d5f782241f53a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 08:50:34 +0000
Subject: [PATCH] hir_expand: lifetime inference expands associated types in a decayed fn item

bitvec 1.1.1 src/slice/ops.rs:48 (skim 5.7.3):

    return this.sp_bitop_assign(that, BitAnd::bitand, BitAnd::bitand);
    // word_op: fn(usize, usize) -> usize, bool_op: fn(bool, bool) -> bool

    BUG: lifetime_infer.cpp:695: Mismatched types: usize != <usize as BitAnd<usize>>::Output

The lifetime pass handles a fn item cast to a fn pointer by decaying
the item (`NamedFunction::decay`). That only monomorphises the
signature, so `<usize as BitAnd>::bitand` came out returning
`<usize as BitAnd<usize>>::Output`, and the pass then compared it
structurally with the target's `usize`. Any trait method with
an associated-type return used as a function pointer hit this, even
`let f: fn(usize, usize) -> usize = <usize as BitAnd>::bitand;`.

The decayed type now gets its associated types expanded through the visitor's
StaticTraitResolve before the comparison.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_expand/lifetime_infer.cpp b/src/hir_expand/lifetime_infer.cpp
index 3545964d..aef20c67 100644
--- a/src/hir_expand/lifetime_infer.cpp
+++ b/src/hir_expand/lifetime_infer.cpp
@@ -1221,6 +1221,10 @@ namespace {
                     const auto* se = src.data().opt_Function();
                     if( !se ) {
                         tmp = ::HIR::TypeRef( src.data().as_NamedFunction().decay(node.span()) );
+                        // `decay` only monomorphises the signature: expand its associated types, as the target's are
+                        // - bitvec 1.1.1 slice/ops.rs:48: `BitAnd::bitand` as `fn(usize, usize) -> usize` returned
+                        //   `<usize as BitAnd<usize>>::Output` -> "Mismatched types: usize != <usize as BitAnd<usize>>::Output"
+                        m_resolve.expand_associated_types(node.span(), tmp);
                         DEBUG("tmp = " << tmp);
                         DEBUG("dst = " << dst);
                         se = tmp.data().opt_Function();
