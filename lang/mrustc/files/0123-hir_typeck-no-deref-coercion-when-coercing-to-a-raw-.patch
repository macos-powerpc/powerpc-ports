From c193a0573aa108ca83442e25c8ba96e1561bcf6c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 14:06:09 +0000
Subject: [PATCH 123/123] hir_typeck: no deref coercion when coercing to a raw
 pointer

core-graphics 0.24.0 (pngquant 3.0.3) event.rs:

    let cb = Box::new(Box::new(callback) as CGEventTapCallBackFn);   // Box<dyn Fn(..) + 'tap_life>
    let cbr = Box::into_raw(cb);                                       // *mut Box<dyn Fn(..)>
    .. callback_ref: Box::from_raw(cbr), ..                            // field: Box<dyn Fn(..)>

With the field type expected, `T = dyn Fn(..)` for from_raw, so the
argument coerces `*mut Box<dyn Fn>` to `*mut dyn Fn` (Box<dyn Fn> is itself
Fn). The pointer-to-pointer (and borrow-to-pointer) coercion passed its
node to check_unsize_tys, whose deref-coercion search found
`Box<dyn Fn>` derefs to `dyn Fn` and rewrote the node as a reborrow:
"Assertion `m_tag == TAG_Borrow' failed" (type.hpp:236, as_Borrow).
Deref coercions only apply through borrows.

The raw pointer cases now call check_unsize_tys without a node, so only
unsizing is considered (here through `Box`'s own Fn impl, as rustc does);
`*mut Box<u8>` to `*mut u8` is a type mismatch instead of the abort. (This
was hidden behind display.rs until 0118.)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index e827a3d5..c94a75a7 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -5093,7 +5093,10 @@ namespace {
                 ASSERT_BUG(sp, dep->type == se.type, "Pointer strength mismatch");
 
                 // Call unsizing code
-                return check_unsize_tys(context, sp, dep->inner, se.inner, context_mut, node_ptr_ptr);
+                // - No node: a raw pointer can unsize but not deref-coerce (`*mut Box<dyn Fn()>` to `*mut dyn Fn()` is the
+                //   `Box`'s own `Fn` impl, not its target), and the deref rewrite (`add_coerce_borrow`) needs a borrow
+                //   - core-graphics 0.24.0 event.rs:505: `Box::from_raw(cbr)` into a `Box<dyn Fn(..)>` field, `cbr: *mut Box<dyn Fn(..)>`
+                return check_unsize_tys(context, sp, dep->inner, se.inner, context_mut, nullptr);
             }
             else
             {
@@ -5124,7 +5127,8 @@ namespace {
                 }
 
                 // Add downcast
-                switch( check_unsize_tys(context, sp, dep->inner, se.inner, context_mut, node_ptr_ptr) )
+                // - No node: coercing to a raw pointer never derefs (see the pointer case above)
+                switch( check_unsize_tys(context, sp, dep->inner, se.inner, context_mut, nullptr) )
                 {
                 case CoerceResult::Fail:
                     return CoerceResult::Fail;
