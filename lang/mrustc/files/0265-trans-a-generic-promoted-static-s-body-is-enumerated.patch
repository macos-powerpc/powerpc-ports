From 71bc62fed8683edffd8f7b979ce80f6ba8cde300 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 17:29:19 +0000
Subject: [PATCH] trans: a generic promoted static's body is enumerated for the concrete
 items it names

objc2 0.6.5 / objc2-foundation 0.3.2 (tree-sitter-cli 0.27.1, the final link of
the `tree-sitter` bin): `ld: symbol(s) not found for architecture ppc:
_ZRG1cF18objc20_6_5_H104001G11liftedC_1720g, referenced from
liftedC_1584<*const c_void> in libobjc2_foundation-0_3_2.rlib.o`.

Since 0204 a borrow of a constant expression that names a generic constant is
promoted to a GENERIC static; a non-generic borrow nested inside it becomes a plain
private static of the same crate. The generic static is only instantiated by its
users, here in another crate, where the nested static is an external `extern`
(statics loaded from an rlib are never defined downstream). The owning crate's
library enumeration scanned the bodies of generic functions for the concrete items
they name (m_save_code) but skipped generic statics entirely, so objc2 never
defined liftedC_1720 and every user of the generic static failed to link.

Trans_Enumerate_GenericFunctionItems' body becomes Trans_Enumerate_GenericMirItems
(any MIR plus its item's params); Trans_Enumerate_ValItem's Static arm runs it on
every generic static with MIR, visible or not, so the nested promoted statics and
functions it names become roots exactly as for a generic function's body.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/trans/enumerate.cpp b/src/trans/enumerate.cpp
index 91e14749..e8928f40 100644
--- a/src/trans/enumerate.cpp
+++ b/src/trans/enumerate.cpp
@@ -263,17 +263,18 @@ namespace {
                 return true;
         return false;
     }
-    void Trans_Enumerate_GenericFunctionItems(EnumState& state, const Span& sp, const ::HIR::Function& e, MonomorphStatePtr ms)
+    /// Enumerate the concrete items named by the body of a generic item (a function, or a promoted static that names
+    /// a generic constant): a downstream instantiation of the item can only declare them `extern`, so this crate has to
+    /// emit them even though nothing concrete here uses them.
+    void Trans_Enumerate_GenericMirItems(EnumState& state, const Span& sp, const ::MIR::Function& mir_fcn, const ::HIR::GenericParams& item_params, MonomorphStatePtr ms)
     {
-        if( e.m_code.m_mir )
         {
-            const auto& mir_fcn = *e.m_code.m_mir;
-            auto params = e.m_params.make_empty_params(true);
+            auto params = item_params.make_empty_params(true);
             ms.pp_method = &params;
             if( !mir_fcn.trans_enum_state )
             {
                 auto* esp = new MIR::EnumCache();
-                Trans_Enumerate_FillFrom_MIR(*esp, *e.m_code.m_mir);
+                Trans_Enumerate_FillFrom_MIR(*esp, mir_fcn);
                 mir_fcn.trans_enum_state = ::MIR::EnumCachePtr(esp);
             }
 
@@ -304,6 +305,13 @@ namespace {
             }
         }
     }
+    void Trans_Enumerate_GenericFunctionItems(EnumState& state, const Span& sp, const ::HIR::Function& e, MonomorphStatePtr ms)
+    {
+        if( e.m_code.m_mir )
+        {
+            Trans_Enumerate_GenericMirItems(state, sp, *e.m_code.m_mir, e.m_params, mv$(ms));
+        }
+    }
     void Trans_Enumerate_ValItem(EnumState& state, const ::HIR::ValueItem& vi, bool is_visible, ::std::function<::HIR::SimplePath()> get_path)
     {
         TRACE_FUNCTION_F(get_path() << " : " << vi.tag_str() << " is_visible=" << is_visible);
@@ -358,6 +366,15 @@ namespace {
 
                 state.rv.m_roots.push_back(get_path());
             }
+            // A generic static (a promoted borrow that names a generic constant, 0204) is only instantiated by its
+            // users, possibly in another crate. The non-generic items its body names (a nested promoted static,
+            // a function) still have to be defined here, exactly as for the body of a generic function.
+            // - objc2 0.6.5 / objc2-foundation 0.3.2 (tree-sitter-cli): `ld: _ZR..objc2..liftedC_1720g not found`,
+            //   referenced from objc2-foundation's instance of objc2's generic promoted static liftedC_1584<*const c_void>
+            else if( e.m_params.is_generic() && e.m_value.m_mir )
+            {
+                Trans_Enumerate_GenericMirItems(state, sp, *e.m_value.m_mir, e.m_params, MonomorphStatePtr());
+            }
             } break;
         TU_ARM(vi, Function, e) {
             bool is_inline = false;
