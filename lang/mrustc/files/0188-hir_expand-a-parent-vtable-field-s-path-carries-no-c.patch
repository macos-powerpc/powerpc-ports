From a7e6830282f39722628fc03cf726a2d846a665b9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 12:31:33 +0000
Subject: [PATCH 188/188] hir_expand: a parent vtable field's path carries no
 const arguments

A vtable struct's generics are the trait's type params plus the
associated-type slots. The `#parent_N` field of a subtrait's vtable
copied the parent trait's path params, const arguments included, so for
zerocopy 0.8.59's `ProjectField<.., const VARIANT_ID, const FIELD_ID>:
HasField<.., VARIANT_ID, FIELD_ID>` the field was `&HasField#vtable<..,
{VARIANT_ID}, {FIELD_ID}>`. zerocopy itself was fine (Resolve Bind runs
before the vtable pass), but Bind also walks the loaded crates, so the
next crate died: ppv-lite86 0.2.21 (skim 5.7.3) "Too many value
parameters passed to ::zerocopy::HasField#vtable<..>".

The parent path drops the values; Trait::get_vtable_type (the `dyn`
side) does the same so both name the same struct.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir/hir_ops.cpp b/src/hir/hir_ops.cpp
index 1c7490f3..3db0ea26 100644
--- a/src/hir/hir_ops.cpp
+++ b/src/hir/hir_ops.cpp
@@ -1294,6 +1294,8 @@ const ::MIR::Function* HIR::Crate::get_or_gen_mir(const ::HIR::ItemPath& ip, con
     // Copy the param set from the trait in the trait object
     ::HIR::PathParams   vtable_params = MonomorphHrlsOnly(pp_hrls).monomorph_path_params(sp, te.m_trait.m_path.m_params, false);
     vtable_params.m_types.resize( te.m_trait.m_path.m_params.m_types.size() + this->m_type_indexes.size() );
+    // The vtable struct has no const params (see hir_expand/vtable.cpp): a const-generic trait's arguments stay off its path
+    vtable_params.m_values = ThinVector<HIR::ConstGeneric>();
     // - Include associated types on bound
     for(const auto& ty_b : te.m_trait.m_type_bounds) {
         if( this->m_type_indexes.count(ty_b.first) == 0 ) {
diff --git a/src/hir_expand/vtable.cpp b/src/hir_expand/vtable.cpp
index fb7eb129..3702548f 100644
--- a/src/hir_expand/vtable.cpp
+++ b/src/hir_expand/vtable.cpp
@@ -416,7 +416,14 @@ namespace {
                 const auto& pt = tr.m_all_parent_traits[i];
                 auto parent_vtable_spath = pt.m_path.m_path;
                 parent_vtable_spath.update_last_component( RcString::new_interned(FMT( parent_vtable_spath.components().back().c_str() << "#vtable" )) );
-                auto parent_vtable_path = ::HIR::GenericPath(mv$(parent_vtable_spath), pt.m_path.m_params.clone());
+                // The vtable struct's generics are the trait's type params plus the associated-type slots: no const
+                // params (and no lifetimes). A parent trait's const arguments stay in `pt.m_path` but must not reach
+                // its vtable struct's path: zerocopy 0.8.59 `ProjectField<.., const VARIANT_ID, const FIELD_ID>:
+                // HasField<.., VARIANT_ID, FIELD_ID>` -> Resolve Bind of the next crate (ppv-lite86 0.2.21) "Too many
+                // value parameters passed to HasField#vtable<..>"
+                auto parent_params = pt.m_path.m_params.clone();
+                parent_params.m_values = ThinVector<HIR::ConstGeneric>();
+                auto parent_vtable_path = ::HIR::GenericPath(mv$(parent_vtable_spath), mv$(parent_params));
                 auto ty = true || supertrait_flags[i]
                     ? ::HIR::TypeRef::new_borrow( ::HIR::BorrowType::Shared, ::HIR::TypeRef::new_path(mv$(parent_vtable_path), {}) )
                     : ::HIR::TypeRef::new_unit()
