From 7231b196d44a60614b6b268bf26b67c26b794037 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 22 Oct 2026 05:11:11 +0000
Subject: [PATCH] mir: the enum-cast fold evaluates the enum's discriminants
 before reading them

smol_str 0.2.2 src/lib.rs:47 `SmolStr::new_inline_from_ascii` (localsend-cli 1.18.2) = the C compiler:
    "libsmol_str-0_2_2_H6.rlib.c:15792:9: error: 'var0' undeclared (first use in this function); did you mean
    'var90'?  var0.DATA[0] = ((uint8_t *)(var9.DATA)[var7].PTR)[0];   // _0.0 = Use(_9[_7]*.0)"
`const INLINE_CAP: usize = InlineSize::_V23 as usize;` (`#[repr(u8)] enum InlineSize { _V0 = 0, _V1, .., _V23 }`)
was 0 in the whole crate. Constant Evaluate visits a module's items in hash order and reached the array type
`[u8; INLINE_CAP]` of `Repr::Inline` before the enum; evaluating that size ran INLINE_CAP's MIR, and the MIR
optimiser's ConstPropagate folded `Cast(Variant(InlineSize #23) as usize)` from the enum's variant values before they
were evaluated (all 0). The constant kept the 0, so `buf` was a ZST `[u8; 0]` (never declared in C) and every other
use silently got the 0 too: SmolStr's inline buffer had no bytes, the other functions compiled and would fail their
bounds checks at run time.

Target_GetTypeRepr already evaluates an enum's discriminants on demand (ConvertHIR_ConstantEvaluate_Enum); the fold,
the only other reader of the values, now does the same. An enum loaded from an rlib is always evaluated.

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/mir/optimise.cpp b/src/mir/optimise.cpp
index a93f2c9a..840c88be 100644
--- a/src/mir/optimise.cpp
+++ b/src/mir/optimise.cpp
@@ -17,6 +17,7 @@
 #include <cmath>
 #include <iomanip>
 #include <trans/target.hpp>
+#include <hir_conv/main_bindings.hpp>   // ConvertHIR_ConstantEvaluate_Enum
 #include <trans/trans_list.hpp> // Note: This is included for inlining after enumeration and monomorph
 
 #include <hir/expr.hpp> // HACK
@@ -3769,6 +3770,14 @@ bool MIR_Optimise_ConstPropagate(::MIR::TypeResolve& state, ::MIR::Function& fcn
                         const auto& src_ty = state.get_lvalue_type(tmp, se.val);
                         const HIR::Enum& enm = *src_ty.data().as_Path().binding.as_Enum();
                         MIR_ASSERT(state, enm.is_value(), "Casting non-value enum to value");
+                        // Constant evaluation reaches this fold before the enum's own discriminants when a constant
+                        // holding the cast sizes an array type visited earlier (smol_str `[u8; INLINE_CAP]` with
+                        // `INLINE_CAP = InlineSize::_V23 as usize`): evaluate them now, as Target_GetTypeRepr does
+                        // (the unevaluated values are all 0, which the constant then kept)
+                        if( !enm.discriminants_evaluated ) {
+                            ConvertHIR_ConstantEvaluate_Enum(state.m_resolve.m_crate, src_ty.data().as_Path().path.m_data.as_Generic().m_path, enm);
+                            MIR_ASSERT(state, enm.discriminants_evaluated, "Enum discriminants not evaluated - " << src_ty);
+                        }
                         // The discriminant as a value of the repr type, then cast like an integer: `Ordering::Less as
                         // i64` is -1 (the stored value is the 64-bit pattern), a `repr(u128)` one has 128 bits.
                         // (`HIR::Enum::get_value` is 32-bit: `repr(u64)` values past 2^32 and negative values cast to
