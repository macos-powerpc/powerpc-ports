From 5307aeaa18b2e8d4d844830cdf7d0d1c7f224544 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 13:31:26 +0000
Subject: [PATCH 62/64] hir_typeck: keep the impl's method generic names when
 copying the trait signature

After checking an impl method against its trait, Typecheck Outer
replaces the impl method's argument and return types with the
monomorphised trait types so that lifetimes match. The method-level
generics in those types were built from the trait's parameter list, so
they carried the trait's names: rayon 1.10.0 implements
`Producer::fold_with<F>` as `fold_with<G>` (src/iter/map.rs), and its
`folder: G` argument ended up typed `F/*M:0*/` while the body's `G` is
`G/*M:0*/`. The impl matcher tells generics apart by name as well as
binding, so looking up `Folder<P::Item>` for `MapFolder<'_, G, _>`
compared the `G: Folder<..>` bound against `F` and rejected it:

    map.rs:160:38 error:0: Failed to find an impl of Folder<<P as Producer>::Item> for MapFolder<'_,F/*M:0*/,_/*2*/>

Give the identity parameters the impl's type/value names (the counts
are already checked to match). Lifetimes keep the trait's list, which
is what the impl's parameters are replaced with anyway.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_typeck/outer.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/hir_typeck/outer.cpp b/src/hir_typeck/outer.cpp
index 74bfe6c7..92e3b367 100644
--- a/src/hir_typeck/outer.cpp
+++ b/src/hir_typeck/outer.cpp
@@ -842,6 +842,14 @@ namespace {
                     const auto& trait_fcn = v_it->second.as_Function();
 
                     auto fcn_params = trait_fcn.m_params.make_nop_params(1);
+                    // The monomorphised trait types are written back into the impl's signature below (so the lifetimes
+                    // match), so name the method's type/value generics as the impl does, not as the trait does.
+                    // - e.g. rayon 1.10.0 implements `Producer::fold_with<F>` as `fold_with<G>`; a body type `G` and a
+                    //   signature type `F` with the same binding would otherwise look like different generics
+                    for(size_t i = 0; i < std::min(fcn_params.m_types.size(), impl_fcn.m_params.m_types.size()); i ++)
+                        fcn_params.m_types[i] = ::HIR::TypeRef(impl_fcn.m_params.m_types[i].m_name, 256 + i);
+                    for(size_t i = 0; i < std::min(fcn_params.m_values.size(), impl_fcn.m_params.m_values.size()); i ++)
+                        fcn_params.m_values[i] = ::HIR::GenericRef(impl_fcn.m_params.m_values[i].m_name, 256 + i);
                     MonomorphStatePtr   ms { &impl.m_type, &impl.m_trait_args, &fcn_params };
                     HIR::TypeRef    tmp;
                     auto maybe_monomorph = [&](const HIR::TypeRef& ty)->const HIR::TypeRef& {
