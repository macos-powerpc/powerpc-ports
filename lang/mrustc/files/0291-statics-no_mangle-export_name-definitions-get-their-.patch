From 637faec8311455e606b5242a9cb5e248bfce1d97 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 09:50:11 +0000
Subject: [PATCH] statics: `#[no_mangle]` / `#[export_name]` definitions get
 their symbol

A defined static with a link name was emitted under its mangled name, so
C code and other crates' `extern { static X: T; }` failed to link to it:

- plain `#[no_mangle]` (the pre-2024 spelling) wasn't read for statics at
  all: LowerHIR_Static only took `m_markings.link_name`, which
  `#[unsafe(no_mangle)]`, `#[link_name]` and `#[export_name]` set.
  LowerHIR_Function handles the attribute itself, and so does
  LowerHIR_Static now;
- codegen_c's emit_static_proto ignored `m_linkage.name` for
  definitions, while imported statics have always been declared with
  an asm label. The prototype of a defined static with a link name now gets
  the same label (Darwin `_` prefix from get_asm_symbol_name).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir/from_ast.cpp b/src/hir/from_ast.cpp
index ba026d90..f26cf02c 100644
--- a/src/hir/from_ast.cpp
+++ b/src/hir/from_ast.cpp
@@ -2070,6 +2070,10 @@ void _add_mod_mac_item(::HIR::Module& mod, RcString name, ::HIR::Publicity is_pu
         if( e.m_markings.link_name != "" ) {
             linkage.name = e.m_markings.link_name;
         }
+        // The pre-2024 spelling (`#[unsafe(no_mangle)]` sets `link_name`), as LowerHIR_Function handles it
+        else if( attrs.get("no_mangle") ) {
+            linkage.name = name.c_str();
+        }
         // If there's no code, demangle the name (TODO: By ABI) and set linkage.
         else if( linkage.name == "" && !e.value().is_valid() ) {
             linkage.name = name.c_str();
diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 82ff46a3..d48d7c4d 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -3032,6 +3032,12 @@ namespace {
                 m_of << "static ";
             }
             emit_static_ty(type, p, /*is_proto=*/true);
+            // A defined static with a link name (`#[no_mangle]`, `#[export_name]`) is emitted under that symbol, as
+            // functions are (and as imported statics are declared): it was always the mangled name, so C code and
+            // other crates' `extern { static .. }` couldn't reach it
+            if( item.m_linkage.name != "" && m_compiler == Compiler::Gcc ) {
+                m_of << " asm(\"" << get_asm_symbol_name(item.m_linkage.name) << "\")";
+            }
             m_of << ";";
             m_of << "\t// static " << p << " : " << type;
             m_of << "\n";
