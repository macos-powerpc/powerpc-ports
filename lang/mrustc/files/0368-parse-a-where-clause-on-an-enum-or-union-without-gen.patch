From 0f9f1b03e36668dc1204a62795288941ce1d89c4 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 14:06:57 +0000
Subject: [PATCH 368/368] parse: a `where` clause on an enum or union without
 generics

smashquote 0.1.2 src/lib.rs:108 (gitu 0.43.0):
    "lib.rs:110:1 error:0: Unexpected token TOK_RWORD_WHERE, expected TOK_BRACE_OPEN"
`#[derive(Debug)] pub enum UnescapeError where UnescapeError: Send, UnescapeError: Sync, UnescapeError: 'static,
UnescapeError: std::fmt::Display, UnescapeError: std::error::Error { .. }`. Parse_EnumDef and Parse_Union only
looked for `where` after `<..>` generics; Parse_Struct accepts it either way. Both now take an optional `where`
after the optional generics.

Assisted-By: Claude Fable 5.1
---

index a8cbb0ee..69720dfa 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1038,11 +1038,15 @@ AST::Enum Parse_EnumDef(TokenStream& lex, const AST::AttributeList& meta_items)
     if( tok.type() == TOK_LT )
     {
         params = Parse_GenericParams(lex);
-        if(GET_TOK(tok, lex) == TOK_RWORD_WHERE)
-        {
-            Parse_WhereClause(lex, params);
-            tok = lex.getToken();
-        }
+        tok = lex.getToken();
+    }
+    // A `where` clause needs no generics (as for structs): smashquote 0.1.2 `pub enum UnescapeError where
+    // UnescapeError: Send, UnescapeError: Sync, UnescapeError: 'static, ..: Display, ..: Error { .. }`
+    // ("Unexpected token TOK_RWORD_WHERE, expected TOK_BRACE_OPEN")
+    if( tok.type() == TOK_RWORD_WHERE )
+    {
+        Parse_WhereClause(lex, params);
+        tok = lex.getToken();
     }
 
     // Body
@@ -1136,11 +1140,13 @@ AST::Enum Parse_EnumDef(TokenStream& lex, const AST::AttributeList& meta_items)
     if( GET_TOK(tok, lex) == TOK_LT )
     {
         params = Parse_GenericParams(lex);
-        if(GET_TOK(tok, lex) == TOK_RWORD_WHERE)
-        {
-            Parse_WhereClause(lex, params);
-            tok = lex.getToken();
-        }
+        tok = lex.getToken();
+    }
+    // A `where` clause needs no generics (see Parse_EnumDef)
+    if( tok.type() == TOK_RWORD_WHERE )
+    {
+        Parse_WhereClause(lex, params);
+        tok = lex.getToken();
     }
 
     ::std::vector< ::AST::StructItem>   variants;
