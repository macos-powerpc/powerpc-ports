From cdf815977d4e279c1be3f97f0fb6a35776e98c41 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 13:31:26 +0000
Subject: [PATCH 63/64] hir_typeck: identify a non-placeholder generic by its
 binding alone when matching impls

`ftic_check_params`' matcher treated two generics as equal only when
both binding and name matched. Names only matter for placeholders,
which share bindings across placeholder sets; everywhere else (type
ordering, `MatchGenerics` in static.cpp and path.cpp) a generic is its
binding. The same method generic can legitimately appear under two
names, so the extra check produced spurious `Unequal` results (rayon
1.10.0 `MapProducer::fold_with`, see the previous commit).

Compare names only for placeholders.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_typeck/helpers.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index c004712d..c8f72302 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -3714,7 +3714,9 @@ bool TraitResolution::find_trait_impls_crate(const Span& sp,
         {
             if( const auto* e = ty.data().opt_Generic() )
             {
-                if( e->binding == g.binding && e->name == g.name )
+                // Only placeholders are told apart by name, a real generic is identified by its binding alone (the
+                // same method generic can be seen under the trait's name and the impl's, see `visit_trait_impl`)
+                if( e->binding == g.binding && (!g.is_placeholder() || e->name == g.name) )
                 {
                     return ::HIR::Compare::Equal;
                 }
@@ -3760,7 +3762,7 @@ bool TraitResolution::find_trait_impls_crate(const Span& sp,
         {
             if( const auto* e = v.opt_Generic() )
             {
-                if( e->binding == g.binding && e->name == g.name )
+                if( e->binding == g.binding && (!g.is_placeholder() || e->name == g.name) )
                 {
                     return ::HIR::Compare::Equal;
                 }
