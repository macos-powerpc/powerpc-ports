From 5c8f729634322ea38b21d1a10cb1588f439e7231 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 6 Nov 2026 04:34:58 +0000
Subject: [PATCH] expand: a derive path may start with `self::`, `super::` or
 `crate::`

`#[derive(self::m::Clone)]`: "Unexpected token TOK_RWORD_SELF, expected
TOK_IDENT". Found while writing the 0441 kit; rustc accepts all three
heads in a derive list.

get_derive_items read `::x`, `$crate::x` (an interpolated crate string)
and plain `a::b` paths only. It now also reads a `crate::` head (a path
from this crate's root, as Parse_Path builds it), `self::`, and one or
more `super::`, and the derive dispatcher resolves those like any other
path.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/expand/derive.cpp b/src/expand/derive.cpp
index c1c342b7..f168cfed 100644
--- a/src/expand/derive.cpp
+++ b/src/expand/derive.cpp
@@ -2050,7 +2050,27 @@ namespace {
                 rv.push_back(*ty.m_data.as_Path());
             }
             else {
-                auto item = AST::Path::new_relative({}, {});
+                // `self::`, `super::` (repeated) and `crate::` heads, as `Parse_Path` reads them
+                AST::Path   item;
+                if( lex.getTokenIf(TOK_RWORD_CRATE) ) {
+                    lex.getTokenCheck(TOK_DOUBLE_COLON);
+                    item = AST::Path("", ::std::vector<AST::PathNode>());
+                }
+                else if( lex.getTokenIf(TOK_RWORD_SELF) ) {
+                    lex.getTokenCheck(TOK_DOUBLE_COLON);
+                    item = AST::Path::new_self({});
+                }
+                else if( lex.lookahead(0) == TOK_RWORD_SUPER ) {
+                    unsigned int count = 0;
+                    while( lex.getTokenIf(TOK_RWORD_SUPER) ) {
+                        lex.getTokenCheck(TOK_DOUBLE_COLON);
+                        count ++;
+                    }
+                    item = AST::Path::new_super(count, {});
+                }
+                else {
+                    item = AST::Path::new_relative({}, {});
+                }
                 do {
                     item += AST::PathNode(lex.getTokenCheck(TOK_IDENT).ident().name);
                 } while(lex.getTokenIf(TOK_DOUBLE_COLON));
