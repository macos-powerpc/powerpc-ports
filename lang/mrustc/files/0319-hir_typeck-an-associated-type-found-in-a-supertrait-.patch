From 9c5387699f3fea7811be9477cd9c9ae2cd9f311a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 04:18:31 +0000
Subject: [PATCH 319/320] hir_typeck: an associated type found in a supertrait
 with its own `for<'a>` leaves those lifetimes omitted

pyo3 0.28.3 (py-cryptography 48.0.0) src/conversion.rs:542:

    pub trait FromPyObjectOwned<'py>: for<'a> FromPyObject<'a, 'py> {}

    <null> BUG: src/hir_typeck/common.cpp:806: Higher-ranked lifetime parameters were not expected (got /*H:0*/)

in Expand HIR ErasedType (the G5's debug trace): the trait's vtable type
names `<Self as FromPyObjectOwned<'py>>::Error`, and trait_contains_type
found `Error` in the parent `for<'a> FromPyObject<'a, 'py>` and
monomorphised the parent's params `<'a, 'py>` with `'a` bound by the
parent's own binder, which isn't in scope there. The returned trait path
has no binder either: it names the item for some `'a`, so the parent's
higher-ranked lifetimes are now left omitted (path params compare without
lifetimes). Both copies (StaticTraitResolve, TraitResolution) had it; the
two declarations alone were enough.

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index 8d2ec901..158773b4 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -4363,12 +4363,20 @@ bool TraitResolution::trait_contains_type(const Span& sp, const ::HIR::GenericPa
         return true;
     }
 
-    auto monomorph_cb = MonomorphStatePtr(nullptr, &trait_path.m_params, nullptr);
     for(const auto& st : trait_ptr.m_all_parent_traits)
     {
         if( st.m_trait_ptr->m_types.count(name) )
         {
             DEBUG("- Found in " << st);
+            // A parent with its own `for<'a>`: the path names the item for some `'a`, outside that binder, so those
+            // lifetimes are left omitted (path params compare without lifetimes). pyo3 0.28.3 conversion.rs
+            // `trait FromPyObjectOwned<'py>: for<'a> FromPyObject<'a, 'py> {}`, `Error` from FromPyObject for its
+            // vtable: "BUG: Higher-ranked lifetime parameters were not expected (got /*H:0*/)" in Expand HIR ErasedType
+            ::HIR::PathParams   hrb_params;
+            if( st.m_hrtbs ) {
+                hrb_params.m_lifetimes.resize( st.m_hrtbs->m_lifetimes.size() );
+            }
+            auto monomorph_cb = MonomorphStatePtr(nullptr, &trait_path.m_params, nullptr, nullptr, &hrb_params);
             out_path.m_path = st.m_path.m_path;
             out_path.m_params = monomorph_cb.monomorph_path_params(sp, st.m_path.m_params, false);
             return true;
diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index 11361385..bc4350e1 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -2394,11 +2394,17 @@ bool StaticTraitResolve::trait_contains_type(const Span& sp, const ::HIR::Generi
     }
 
     auto ty_Self = ::HIR::TypeRef::new_self();
-    auto monomorph = MonomorphStatePtr(&ty_Self, &trait_path.m_params, nullptr);
     for(const auto& st : trait_ptr.m_all_parent_traits)
     {
         if( st.m_trait_ptr->m_types.count(name) )
         {
+            // A parent with its own `for<'a>`: the path names the item for some `'a`, outside that binder, so those
+            // lifetimes are left omitted (see TraitResolution::trait_contains_type)
+            ::HIR::PathParams   hrb_params;
+            if( st.m_hrtbs ) {
+                hrb_params.m_lifetimes.resize( st.m_hrtbs->m_lifetimes.size() );
+            }
+            auto monomorph = MonomorphStatePtr(&ty_Self, &trait_path.m_params, nullptr, nullptr, &hrb_params);
             out_path.m_path = st.m_path.m_path;
             out_path.m_params = monomorph.monomorph_path_params(sp, st.m_path.m_params, false);
             return true;
