From d3edf5f729d286f2317225ab42db7da85faac558 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 18:02:12 +0000
Subject: [PATCH] hir_typeck: don't type a blocked ivar's coercion source from
 its destination

rars 0.9.4 crates/rars/src/rar50.rs:983:

    for (index, data) in data_volumes.iter().enumerate() {   // data: &Option<&[u8]>
        let Some(data) = data else { shards.push(None); continue; };   // data: &&[u8]
        if data.len() as u64 != meta.file_size || crc32(data) != meta.crc32 { .. }
        else { shards.push(Some(*data)); }                   // *data: &[u8]

failed with "Unsized type not valid here - [u8]". The let-else binding's
type (an ivar) was still unknown while the loop item type resolved
through the iterator's associated types, so the binding was blocked
(possible_equate_ivar_unknown). The variable it flows into had one
coercion source (that blocked ivar) and one destination (`&[u8]`, the
`crc32(data)` argument), and check_ivar_poss's "single each way" rule
picked the concrete destination: `data: &[u8]`, so `*data` was `[u8]`.
The pattern then had no say; rustc types it from the pattern (`&&[u8]`,
auto-derefed at the call).

In the normal (non-fallback) pass, a bare ivar source that is itself
blocked now makes the rule wait; the fallback passes behave as before.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index c94a75a7..93a518cc 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -7100,6 +7100,21 @@ namespace
                             return true;
                         }
                     }
+                    // A bare ivar source that is itself blocked (a pattern binding whose scrutinee isn't known yet, or
+                    // a pending trait decision) will get a type of its own. Picking the destination now would guess it
+                    // from a use: a `&&[u8]` let-else binding passed to a `&[u8]` argument became `&[u8]`, so `*data`
+                    // was `[u8]` (rars 0.9.4 rar50.rs). Wait for it, unless this is a fallback pass.
+                    if( fallback_ty == IvarPossFallbackType::None && !src_noivars )
+                    {
+                        if( const auto* se = context.m_ivars.get_type(*ent_s.ty).data().opt_Infer() )
+                        {
+                            if( se->index < context.possible_ivar_vals.size() && context.possible_ivar_vals[se->index].force_disable )
+                            {
+                                DEBUG("Single each way, but the source " << *ent_s.ty << " is a blocked ivar - wait");
+                                return false;
+                            }
+                        }
+                    }
                     if( dst_valid )
                     {
                         if( dst_noivars )
