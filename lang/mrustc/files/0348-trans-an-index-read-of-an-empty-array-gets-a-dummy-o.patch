From 6a2a1205064c6bf200b6e03ce9c5424c02e10c1a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 22:46:18 +0000
Subject: [PATCH] trans: an index read of an empty array gets a dummy of the element
 type in C

konst 0.2.20 src/string.rs:454 `str_from` (also str_up_to:361, str_range:605; repgrep 0.17.1):
    if is_char_boundary(bytes, start) { .. } else { [/* start is not on a char boundary */][start] }
= the C compiler: "libkonst-0_2_20.rlib.c:4217:15: error: 'var2' undeclared (first use in this function); did you mean
'var4'?  rv = (var2.DATA)[var3]; // retval = Use(_2[_3])". The error path indexes an empty array whose element type
comes from the function's `&str`: `[&str; 0]` is a ZST, and the C backend never declares a local of a zero-sized type
(disallow_empty_structs holds for the GNU mode too) and emits the type's struct as `char _d` without `DATA`, yet the
builtin index lvalue still wrote `var2.DATA[var3]`. Typeck finds libcore's `impl<T, I, const N: usize> Index<I> for
[T; N]` on the array, so MIR lowering keeps the builtin `_2[_3]` (a stand-in core without that impl unsizes to `[T]`
and indexes through `.PTR`, which is why the array impl is in the kit's core).

emit_lvalue, Index of an array of known size 0 that is a bad ZST: `(*(ELEM*)0 /* index of an empty array */)`.
The read is unreachable (the bounds check fails first), so the C compiler only needs the expression to type.

Kit empty-array-index-test (stand-in core with the array Index impl; konst's shape, the array typed with a `u8`
element, a non-empty array keeping `.DATA[i]`; built through the C compiler with and without -O, linked with main.c
and run). 0347: the same "'var0' undeclared".

Assisted-By: Claude Fable 5.1
---

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 5f6e9957..2a1b233a 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -8858,6 +8858,14 @@ namespace {
                 auto inner = val.inner_ref();
                 ::HIR::TypeRef  tmp;
                 const auto& ty = m_mir_res->get_lvalue_type(tmp, inner);
+                if( ty.data().is_Array() && ty.data().as_Array().size.is_Known() && ty.data().as_Array().size.as_Known() == 0 && this->type_is_bad_zst(ty) ) {
+                    // An empty array is a ZST: a local or field of that type isn't declared, and its struct is `char _d`
+                    // without `DATA`. Indexing it is unreachable (the bounds check fails first), so the C compiler gets
+                    // a dummy of the element type. konst 0.2.20 `str_from`: `[/* not a char boundary */][start]` as the
+                    // error path of a `&str`-returning function.
+                    m_of << "(*("; emit_ctype(ty.data().as_Array().inner); m_of << "*)0 /* index of an empty array */)";
+                }
+                else {
                 m_of << "(";
                 if( ty.data().is_Slice() ) {
                     if( inner.is_Deref() )
@@ -8881,6 +8889,7 @@ namespace {
                 emit_lvalue(::MIR::LValue::new_Local(index_local));
                 m_of << "]";
                 }
+                }
             TU_ARMA(Downcast, variant_index) {
                 auto inner = val.inner_ref();
                 ::HIR::TypeRef  tmp;
