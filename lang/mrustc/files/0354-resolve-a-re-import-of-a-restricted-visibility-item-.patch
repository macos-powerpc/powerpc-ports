From caa523aa710b8399b5b51b336cecd59d2d95f568 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 14:42:09 +0000
Subject: [PATCH 354/355] resolve: a re-import of a restricted-visibility item
 widens its index entry, never narrows it

tsrs 0.18.0 (crates/tsrs_ast/src/generated.rs:1050 `impl NodeRareTail for
VariableDeclaration`):

    error:0: Couldn't find type name 'NodeRareTail'

`NodeRareTail` is a `pub(crate)` trait of `ast`; `generated` has
`use crate::ast::*`; the crate root re-exports both modules
(`pub use ast::*; pub use generated::*;`) and `ast` itself has
`use crate::*`. The index pass imports the trait into the root as
`pub(crate)`, then `ast`'s `use crate::*` re-imports the same path into
`ast`, where `_add_item` "widens" the existing entry's visibility with
`AST::Visibility::contains` + `inplace_union`. `contains(x)` was
inverted (it tested that `x` is visible from this scope, i.e. that x's
scope is an ancestor of this one), so `pub(crate)` "did not contain" the
module-private re-import and the union took the private path: the entry
became `pub(in crate::ast)` while its kind still printed as `pub(crate)`.
The glob `crate::generated <= crate::ast` then found the trait invisible
and every other module lost it (the `pub(crate)` fn `rare_tail` too).
`pub` items were never affected (no path = contains everything).

`contains(x)` is now "this is visible from x's own scope" (`pub` contains
everything, nothing restricted contains `pub`); `inplace_union` takes x's
kind and path together when x is wider, and the common ancestor module
of two unrelated restricted scopes instead of a TODO abort. index.cpp is
the only user of either.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/ast/ast.cpp b/src/ast/ast.cpp
index d70beace..8bce6536 100644
--- a/src/ast/ast.cpp
+++ b/src/ast/ast.cpp
@@ -198,25 +198,51 @@ bool Visibility::is_visible(const ::AST::AbsolutePath& from_mod) const
         return true;
     }
 }
+// `this` is at least as visible as `x`: everywhere `x` is visible, `this` is too. `pub` contains everything;
+// a restricted visibility contains `x` when it is visible from `x`'s own scope (`pub(crate)` contains `pub(in crate::ast)`,
+// whose scope lies inside the crate). The old test ran the other way round (`x` visible from this scope), so
+// `pub(crate)` "did not contain" a module-private re-import and `inplace_union` NARROWED it to that module:
+// a `pub(crate)` item of `ast` re-imported into `ast` through `use crate::*` (the root has `pub use ast::*`) then failed
+// the glob visibility check from every other module (tsrs_ast 0.18.0 generated.rs:1050 `impl NodeRareTail for ..`
+// "Couldn't find type name 'NodeRareTail'", tsrs 0.18.0).
 bool Visibility::contains(const ::AST::Visibility& x) const
 {
-    if( m_vis_path ) {
-        return x.is_visible(*m_vis_path);
-    }
-    else {
+    if( !m_vis_path ) {
         return true;
     }
+    if( !x.m_vis_path ) {
+        return false;
+    }
+    return this->is_visible(*x.m_vis_path);
 }
 
 void Visibility::inplace_union(const Visibility& x)
 {
     if( this->contains(x) ) {
+        // Already at least as visible
     }
     else if( x.contains(*this) ) {
+        // `x` is wider: become it (kind and path together, `pub` has no path)
+        m_ty = x.m_ty;
         m_vis_path = x.m_vis_path;
+        m_in_path = x.m_in_path;
     }
     else {
-        TODO(Span(), "Union with incompatible visbility");
+        // Two restricted scopes, neither inside the other (`pub(in a::b)` and `pub(in a::c)`): the smallest scope
+        // that covers both is their common ancestor module.
+        assert(m_vis_path && x.m_vis_path);
+        if( m_vis_path->crate != x.m_vis_path->crate ) {
+            TODO(Span(), "Union with incompatible visbility - " << *this << " and " << x);
+        }
+        size_t n = 0;
+        while( n < m_vis_path->nodes.size() && n < x.m_vis_path->nodes.size() && m_vis_path->nodes[n] == x.m_vis_path->nodes[n] ) {
+            n ++;
+        }
+        auto p = *m_vis_path;
+        p.nodes.resize(n);
+        m_vis_path = std::make_shared<AST::AbsolutePath>(std::move(p));
+        m_in_path.reset();
+        m_ty = (n == 0 ? Ty::PubCrate : Ty::PubIn);
     }
 }
 
