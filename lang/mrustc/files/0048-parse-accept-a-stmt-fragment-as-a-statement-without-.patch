From 1aca24d42aea808aa9d29698c1330f3d29063311 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 07:20:53 +0000
Subject: [PATCH 48/48] parse: accept a `:stmt` fragment as a statement without a `;`

Inside a block, an interpolated `stmt` fragment fell through to the
expression-statement parser, which requires a `;` or the closing `}`
after it. A block-like statement captured as `$action:stmt` and expanded
directly before another statement (clap 3.2's `tags!` in
src/output/help.rs: `$action let rest = ..;`) then failed with
"Unexpected token TOK_RWORD_LET, expected TOK_BRACE_CLOSE".

Handle `TOK_INTERPOLATED_STMT` with the other block-like statements:
an optional `;` (recorded as ending the line), and the existing `.`/`?`
check that turns it back into the start of an expression.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/parse/expr.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index e0d4dff5..3560cab2 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -298,6 +298,21 @@ ExprNodeP Parse_ExprBlockLine(TokenStream& lex, bool *add_silence)
         {
         case TOK_INTERPOLATED_BLOCK:
             return tok.take_frag_node();
+        // A `$x:stmt` fragment is a complete statement (`{ .. }`, `if`, `match`, `let`, an expression, ...)
+        case TOK_INTERPOLATED_STMT:
+            ret = tok.take_frag_node();
+            // If followed by `.` or `?`, it's actually the start of an expression
+            if( lex.lookahead(0) == TOK_DOT || lex.lookahead(0) == TOK_QMARK ) {
+                lex.putback( Token(Token::TagTakeIP(), InterpolatedFragment(InterpolatedFragment::EXPR, ret.release())) );
+                return Parse_ExprBlockLine_Stmt(lex, *add_silence);
+            }
+            // Block-like statements don't need a `;` (`$action let rest = ..;` in clap 3's `tags!`), and rustc rejects
+            // the others without one, so an optional `;` is accepted here.
+            if( LOOK_AHEAD(lex) == TOK_SEMICOLON ) {
+                GET_TOK(tok, lex);
+                *add_silence = true;
+            }
+            return ret;
         case TOK_SEMICOLON:
             // Return a NULL expression, nothing here.
             return nullptr;
