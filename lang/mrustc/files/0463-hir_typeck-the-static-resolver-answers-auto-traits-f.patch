From c357de84613ace04913cf668f38e868ccca1a21c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 16:20:53 +0000
Subject: [PATCH] hir_typeck: the static resolver answers auto traits for `&T`,
 `*T`, `[T]` and `dyn Trait` as typeck does

Found by reading the two trait resolvers side by side, not by a crate.
0416 gave TraitResolution (typeck) rustc's rules: an explicit auto-trait
impl covers a type only through its bounds (`Send for &T where T: Sync`
failing means `&T` is not Send, there is no structural fallback),
a reference, raw pointer or slice follows its pointee or element, and
a trait object has an auto trait only through its own bounds and its
principal trait's supertraits. StaticTraitResolve kept the old answers:
a failed explicit impl fell through to check_auto_trait_impl_destructure,
whose last arm says every type that is not a path, tuple or array
implements every auto trait.

The two then disagree on the same bound. With pyo3's probe shape
(`impl<T: Send> IsSend<T> { const VALUE: bool = true; }` next to
a trait default `false`), Resolve UFCS took the inherent constant for
`IsSend::<&NotSync>` because the static resolver said the bound holds,
and typeck rejected the path: "Failed to find an impl of Send for
&'static NotSync".

The static resolver now has the same rule and the same arms.

Assisted-by: Claude Fable 5.2
---

diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index 8bdab0e5..5f59d118 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -870,11 +870,18 @@ bool StaticTraitResolve::find_impl(
 
         // Positive/negative impls
         bool rv = false;
+        bool positive_type_matched = false;
         ret = this->m_crate.find_auto_trait_impls(trait_path, type, cb_ident, [&](const auto& impl)->bool {
+            positive_type_matched |= impl.is_positive;
             return H::find_impl__auto_trait_check(*this, sp, trait_path, trait_params, type, found_cb, impl, rv);
             });
         if(ret)
             return rv;
+        // An explicit impl covers the type only through its bounds (as TraitResolution::find_trait_impls_crate)
+        if( positive_type_matched ) {
+            DEBUG("- Explicit impl bounds failed, no auto impl");
+            return false;
+        }
 
         // Detect recursion and return true if detected
         static ::std::vector< ::std::tuple< const ::HIR::SimplePath*, const ::HIR::PathParams*, const ::HIR::TypeRef*> >    stack;
@@ -1771,6 +1778,24 @@ bool StaticTraitResolve::find_impl__check_crate(
     {
         return type_impls_trait(e->inner);
     }
+    // The same arms as TraitResolution's: a trait object only through its own bounds and its principal trait's
+    // supertraits (answered by `find_impl` before this), pointers and slices through their pointee / element
+    else if( type.data().is_TraitObject() )
+    {
+        return ::HIR::Compare::Unequal;
+    }
+    else if( const auto* e = type.data().opt_Borrow() )
+    {
+        return type_impls_trait(e->inner);
+    }
+    else if( const auto* e = type.data().opt_Pointer() )
+    {
+        return type_impls_trait(e->inner);
+    }
+    else if( const auto* e = type.data().opt_Slice() )
+    {
+        return type_impls_trait(e->inner);
+    }
     // Otherwise, there's no negative so it must be positive
     else {
         return ::HIR::Compare::Equal;
