From 6ba09908350f83b6b9d6558bbffd5e76d6f0f2ee Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 16:16:30 +0000
Subject: [PATCH] hir_typeck: an opaque projection implements an auto trait
 only through a bound

futures-util 0.3.31 (sad 0.4.32) stream/try_stream/try_buffer_unordered.rs:

    pub struct TryBufferUnordered<St> where St: TryStream {
        #[pin] stream: Fuse<IntoStream<St>>,
        in_progress_queue: FuturesUnordered<IntoFuture<St::Ok>>, ..
    }

Checking an auto trait (Unpin/Send/..) field by field reaches the opaque
`<St as TryStream>::Ok`, which check_auto_trait_impl_destructure didn't
handle: "BUG: src/hir_typeck/helpers.cpp:3563: TODO:
check_auto_trait_impl_destructure - Check trait bounds for bound on
<St as TryStream>::Ok". (It's only reached when no bound was found.)

As for a generic, only a bound (a where clause, or the trait's bounds on
the item) can make an opaque projection implement the auto trait: search
the bounds and answer from them, Unequal otherwise. The full impl search
would come back to this destructure.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/helpers.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index cf228c4d..21e4ac82 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -3560,7 +3560,14 @@ bool TraitResolution::find_trait_impls_crate(const Span& sp,
                 DEBUG("- UfcsKnown of placeholder, returning Fuzzy");
                 return ::HIR::Compare::Fuzzy;
             }
-            TODO(sp, "Check trait bounds for bound on " << type);
+            // Only a bound (a where clause, or the trait's own bounds on the item) can make an opaque projection
+            // implement the auto trait, as for a generic: without one it doesn't (only the bounds are searched here,
+            // the impl search would come back to this destructure)
+            // - futures-util 0.3.31 try_buffer_unordered.rs: `in_progress_queue: FuturesUnordered<IntoFuture<St::Ok>>`
+            auto l_res = ::HIR::Compare::Unequal;
+            this->find_trait_impls_bound(sp, trait, *params_ptr, type, [&](auto, auto cmp){ l_res = cmp; return (cmp == ::HIR::Compare::Equal); });
+            DEBUG("- Opaque UfcsKnown, from bounds: " << l_res);
+            return l_res;
             }
         TU_ARMA(UfcsInherent, pe) {
             TODO(sp, "Auto trait lookup on UFCS Inherent type");
