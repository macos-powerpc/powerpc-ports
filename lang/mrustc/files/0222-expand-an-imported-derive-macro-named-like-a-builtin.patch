From 2aed8a23d282ceea4ea7409b382ca0d926f65bb3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 12:03:57 +0000
Subject: [PATCH] expand: an imported derive macro named like a builtin derive shadows it

derive_item tried mrustc's builtin derivers for any plain derive name before
looking for a derive macro in scope, so a proc-macro derive imported under
a builtin's name never ran. skim 5.7.3 tui/actions.rs:

    use derive_more::{Debug, Eq, PartialEq};
    ..
    #[derive(Debug, Clone, PartialEq, Eq)]
    pub enum Action {
        ..
        #[debug("custom")] #[eq(skip)] #[partial_eq(skip)]
        Custom(ActionCallback),
    }

The builtin Eq asserted every field, skip attribute or not:

    <null> error:0: Failed to find an impl of ::"core-0_0_0"::cmp::Eq for &::"skim-5_7_3_H422040"::tui::actions::ActionCallback

Every `use derive_more::Debug;` (derive_more 1.0+) got the builtin Debug
the same way: an error when a field has no Debug impl, and std-style output
that ignores `#[debug("..")]` / `#[debug(skip)]` otherwise.

In rustc the prelude's derives lose to an import. A derive proc macro of
that name among the module's macro imports (`use`, `#[macro_use]`) now wins
over the builtin; the existing proc-macro path then invokes it. The path
form `#[derive(derive_more::Debug)]` already went to the proc macro.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/expand/derive.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/expand/derive.cpp b/src/expand/derive.cpp
index b43d9b45..c36c9af8 100644
--- a/src/expand/derive.cpp
+++ b/src/expand/derive.cpp
@@ -2159,7 +2159,23 @@ static void derive_item(const Span& sp, const AST::Crate& crate, AST::Module& mo
         if( trait_path.is_trivial() )
         {
             auto dp = find_impl(trait_path.as_trivial());
+            // A derive macro of that name imported into scope (`use derive_more::{Debug, PartialEq, Eq};`, `#[macro_use]`)
+            // shadows the builtin one from the prelude, and understands its own attributes (`#[debug("..")]`, `#[eq(skip)]`)
+            const HIR::ProcMacro* shadowing = nullptr;
             if( dp ) {
+                for(const auto& mi : reverse(mod.m_macro_imports)) {
+                    if( mi.name == trait_path.as_trivial() ) {
+                        if( mi.ref.is_ExternalProcMacro() && mi.ref.as_ExternalProcMacro()->ty == HIR::ProcMacro::Ty::Derive ) {
+                            shadowing = mi.ref.as_ExternalProcMacro();
+                        }
+                        break;
+                    }
+                }
+            }
+            if( shadowing ) {
+                DEBUG("Builtin " << trait_path << " shadowed by " << shadowing->path);
+            }
+            else if( dp ) {
                 mod.add_item(sp, AST::Visibility::make_bare_private(), "", dp->handle_item(sp, opts, item.params(), type, item), {} );
                 continue ;
             }
