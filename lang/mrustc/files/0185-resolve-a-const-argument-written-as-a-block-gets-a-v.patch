From 973dc73076edbef571125df6536896ec14539d1b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 11:48:13 +0000
Subject: [PATCH 185/185] resolve: a const argument written as a block gets a variable context

Resolve Absolute gave an array length its own variable context
(enter_rootblock) but not the const arguments of a path, so a block with
`let`s as a const argument of a where bound, a turbofish or a return
type hit "BUG: src/resolve/absolute.cpp:252: Assigning local when
there's no variable context".

zerocopy 0.8.59's `cryptocorrosion_derive_traits!` emits
`unsafe impl IntoBytes for $name where (): PaddingFree<Self, {
union_padding!(..) }>`, and `union_padding!` expands to such a block:
ppv-lite86 0.2.21 generic.rs:8 (skim 5.7.3).

Const arguments now get the same root block an array length does.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/resolve/absolute.cpp b/src/resolve/absolute.cpp
index 47b525dd..e6e2c65e 100644
--- a/src/resolve/absolute.cpp
+++ b/src/resolve/absolute.cpp
@@ -970,6 +970,10 @@ void Resolve_Absolute_PathParams(/*const*/ Context& context, const Span& sp, ::A
             }
             }
         TU_ARMA(Value, n) {
+            // A const argument is its own expression: a block with `let`s in it (zerocopy 0.8.59 `union_padding!`
+            // inside a `where` bound's `PaddingFree<Self, { .. }>`, ppv-lite86 0.2.21) needs a variable context
+            // the way an array length does.
+            auto _h = context.enter_rootblock();
             Resolve_Absolute_ExprNode(context, *n);
             }
         TU_ARMA(AssociatedTyEqual, a) {
