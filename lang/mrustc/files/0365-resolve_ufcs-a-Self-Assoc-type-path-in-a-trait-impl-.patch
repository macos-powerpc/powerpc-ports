From 1fbca8aa14ff4c4db9d2ba48e01dc8da6e4c2302 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 12:33:58 +0000
Subject: [PATCH] resolve_ufcs: a `Self::Assoc` type path in a trait impl keeps
 the impl's trait params

mp4parse 0.17.0 src/lib.rs:3568 `impl_mul!` (fselect 0.10.3):
    "<null> error:0: Type mismatch between ::"mp4parse-0_17_0"::bounded_uints::U32MulU16/*S*/ and
    ::"mp4parse-0_17_0"::bounded_uints::U32MulU8/*S*/"
`impl std::ops::Mul<$rhs> for $lhs { type Output = $output; fn mul(self, rhs: $rhs) -> Self::Output { ..
Self::Output::new(..) } }`, instantiated twice for `U32` (`Mul<NonZeroU8>` with Output U32MulU8, `Mul<U16>` with
Output U32MulU16). Resolve UFCS blanked the trait params of every `Self::item` path inside an expression, so the
type `Self::Output` became `<U32 as Mul<_>>::Output`; typeck guessed the first Mul impl for the `_` in both bodies,
and the second body's `new` returned U32MulU8 for a U32MulU16 return type.

Blanking is right for a VALUE path: `Self::from(x)` in `impl From<A> for X` is resolved by probing `from` on X, so
another impl of the same trait may be the one, and the params are left to inference. A TYPE path `Self::Assoc` in a
trait impl names the impl's own trait ref (rustc lower_assoc_path on `SelfTyAlias { is_trait_impl }`). The bounds
branch (get_ufcs_known) already limited its blanking to value paths; the two `Self` branches now do the same.

Kit self-aty-impl-params-test: mp4.rs (the crate's shape: the associated type as a call head, as a `let`
annotation and inside `<Self::Output as UpperBounded>::MAX`), from.rs (`Self::from(B)` inside `impl From<A> for X`
must still pick the other impl by inference), neg.rs (an open value path with no matching impl stays an error).
The old binary fails mp4.rs with the port's error.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_conv/resolve_ufcs.cpp b/src/hir_conv/resolve_ufcs.cpp
index 5d49fd6d..93c9d896 100644
--- a/src/hir_conv/resolve_ufcs.cpp
+++ b/src/hir_conv/resolve_ufcs.cpp
@@ -862,8 +862,13 @@ namespace resolve_ufcs {
                     if( locate_in_trait_and_set(pc, trait_path, *m_current_trait,  p.m_data) ) {
                         assert(!p.m_data.is_UfcsUnknown());
                         // Success!
-                        // - If in an expression (and not in a `trait` provided impl), clear the params
-                        if( m_in_expr && !m_in_trait_def ) {
+                        // - If in an expression (and not in a `trait` provided impl), clear the params of a VALUE path:
+                        //   `Self::from(x)` is resolved by probing the type, so another impl of the trait may be the one.
+                        //   A TYPE path (`Self::Output` as a call head, a `let` annotation or a qualified path's type) names
+                        //   the impl's own trait ref (rustc lower_assoc_path on `SelfTyAlias { is_trait_impl }`): mp4parse
+                        //   0.17.0 impl_mul! `Self::Output::new(..)` in `impl Mul<$rhs> for U32`, two Mul impls for U32 =
+                        //   "Type mismatch between U32MulU16 and U32MulU8" (typeck guessed the first impl for `Mul<_>`)
+                        if( m_in_expr && !m_in_trait_def && pc == ::HIR::Visitor::PathContext::VALUE ) {
                             for(auto& t : p.m_data.as_UfcsKnown().trait.m_params.m_types)
                                 t = ::HIR::TypeRef();
                         }
@@ -936,7 +941,8 @@ namespace resolve_ufcs {
                     if( locate_in_trait_and_set(pc, trait_path, *m_current_trait,  p.m_data) ) {
                         assert(!p.m_data.is_UfcsUnknown());
                         // Success!
-                        if( m_in_expr ) {
+                        // - VALUE paths only, as for `Self` above
+                        if( m_in_expr && pc == ::HIR::Visitor::PathContext::VALUE ) {
                             for(auto& t : p.m_data.as_UfcsKnown().trait.m_params.m_types)
                                 t = ::HIR::TypeRef();
                         }
