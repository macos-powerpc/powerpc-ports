From 36227a26dcb16fe2719e47294692d0cb1b988400 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 10:27:32 +0000
Subject: [PATCH] hir_typeck: trait object to trait object coercions equate
 associated types

minijinja 2.19.0 (py314-maturin 1.15.0), after 0290:

    src/value/object.rs:485:1 error:0: Failed to infer type _/*1*/ in
    Box<dyn (DoubleEndedIterator<Item{Iterator}=_/*1*/,>+'#omitted),Global>

    let iter = unsafe {
        std::mem::transmute::<
            Box<dyn DoubleEndedIterator<Item = _>>,
            Box<dyn DoubleEndedIterator<Item = _> + Send + Sync>,
        >(maker(self))     // Box<dyn DoubleEndedIterator<Item = Value> + Send + Sync + 'a>
    };

The argument coerces `dyn DoubleEndedIterator<Item = Value> + Send + Sync`
to `dyn DoubleEndedIterator<Item = _>` (dropping auto traits). That
TraitObject => TraitObject case of check_unsize_tys equated the traits'
type parameters but not their associated type bindings, so nothing
inferred the `_`. The same `let x: &mut dyn Tr<Item = _> = ..` failed.
It also accepted a coercion between different bindings
(`Item = Value` to `Item = u32`), which rustc rejects.

Each binding of the destination is now equated with the source's binding
of the same name.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 45d2fc12..37d1e76d 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -4618,6 +4618,17 @@ namespace {
                     {
                         context_mut->equate_types(sp, tys_d[i], tys_s.at(i));
                     }
+                    // And the associated type bindings: `Box<dyn DoubleEndedIterator<Item = Value> + Send + Sync>` to
+                    // `Box<dyn DoubleEndedIterator<Item = _>>` (minijinja 2.19 object.rs `transmute::<Box<dyn ..<Item = _>>,
+                    // ..>(maker(self))`) left the `_` uninferred
+                    for(const auto& tyb : dep->m_trait.m_type_bounds)
+                    {
+                        auto it = sep->m_trait.m_type_bounds.find(tyb.first);
+                        if( it != sep->m_trait.m_type_bounds.end() )
+                        {
+                            context_mut->equate_types(sp, tyb.second.type, it->second.type);
+                        }
+                    }
                 }
 
                 // 2. Destination markers must be a strict subset
