From 209dc889bcc932f647104a4e368fe0e8f1408e1b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 17:14:52 +0000
Subject: [PATCH 370/372] hir: a trait may carry several lifetime bounds

figment 0.10.19 src/metadata.rs:330 (gitu 0.43.0):
    MACRO<::"figment-0_10_19_H200"::crate::util::cloneable_fn_trait> BUG: ASSERT FAIL:
    src/hir/from_ast.cpp:1616:f.lifetimes().size() == 1
util.rs `cloneable_fn_trait!($Name: $($rest:tt)*)` expands to `trait $Name: $($rest)* + Cloneable + 'static {}`,
and both callers (metadata.rs Interpolator, providers/env.rs FilterMap) end their bounds in `'static`, so the
trait has the lifetime bound twice. The parser collects every lifetime of a supertrait list; HIR Lower asserted
exactly one.

HIR::Trait keeps a single lifetime, used only by the default-object-lifetime rule (lifetime_elision.cpp). All
bounds are lowered now and the trait records `'static` if any bound is `'static`, the single distinct bound
otherwise, and none for several distinct ones (rustc rejects a `dyn Tr` that relies on the default in that case,
so no default is the faithful answer).

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir/from_ast.cpp b/src/hir/from_ast.cpp
index f26cf02c..eb8f7214 100644
--- a/src/hir/from_ast.cpp
+++ b/src/hir/from_ast.cpp
@@ -1611,11 +1611,30 @@ namespace {
     bool trait_reqires_sized = false;
     auto params = LowerHIR_GenericParams(f.params(), &trait_reqires_sized);
 
+    // `trait Tr: 'a + 'b { .. }` - any number of lifetime bounds, duplicates included (figment's `cloneable_fn_trait!`
+    // appends `+ 'static` to caller-written bounds that already end in `'static`).
+    // The trait records the one lifetime the default object lifetime rule (lifetime_elision.cpp) uses: `'static` if any
+    // bound is `'static`, otherwise the single distinct bound. Several distinct non-static bounds leave it unset (rustc
+    // rejects a `dyn Tr` that relies on the default in that case, so no default is the faithful answer).
     ::HIR::LifetimeRef  lifetime;
     if( !f.lifetimes().empty() ) {
-        ASSERT_BUG(f.lifetimes()[0].sp, f.lifetimes().size() == 1, "");
-        lifetime = LowerHIR_LifetimeRef(f.lifetimes()[0].ent);
-        DEBUG("Lifetime " << lifetime << " (" << f.lifetimes()[0].ent << " " << f.lifetimes()[0].ent.binding() << ")");
+        ::std::vector< ::HIR::LifetimeRef>  lifetimes;
+        for(const auto& l : f.lifetimes()) {
+            lifetimes.push_back( LowerHIR_LifetimeRef(l.ent) );
+            DEBUG("Lifetime " << lifetimes.back() << " (" << l.ent << " " << l.ent.binding() << ")");
+        }
+        ::std::sort(lifetimes.begin(), lifetimes.end());
+        lifetimes.erase( ::std::unique(lifetimes.begin(), lifetimes.end()), lifetimes.end() );
+        auto it_static = ::std::find(lifetimes.begin(), lifetimes.end(), ::HIR::LifetimeRef::new_static());
+        if( it_static != lifetimes.end() ) {
+            lifetime = *it_static;
+        }
+        else if( lifetimes.size() == 1 ) {
+            lifetime = lifetimes[0];
+        }
+        else {
+            DEBUG("Several distinct lifetime bounds on " << trait_path << ", no default object lifetime");
+        }
     }
     ::std::vector< ::HIR::TraitPath>    supertraits;
     for(const auto& st : f.supertraits()) {
