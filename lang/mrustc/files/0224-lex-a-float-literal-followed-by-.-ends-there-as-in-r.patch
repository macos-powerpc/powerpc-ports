From 54ba7b83d8ea3d78a74c0d7e26edbba6eb84f5b8 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 13:26:39 +0000
Subject: [PATCH] lex: a float literal followed by `.` ends there, as in rustc

parseFloat turned `<a>.<b>` followed by `.` (not `..`) into the integers
`<a>` `.` `<b>` `.`, a workaround for chained tuple indices from before
digits right after a `.` were lexed as an integer (07ce1420). Tuple indices
never reach it any more (`x.0.1` is `x` `.` `0` `.` `1` through the TOK_DOT
case), so it only split real floats, never into valid code:

    #[rustversion::since(1.36.0)]     // arc-swap 1.8.0 lib.rs:127 (gitui 0.28.1)

reached rustversion as `1 . 36 . 0`; a first literal without a `.` is a nightly date
to rustversion:

    lib.rs:127:15-30 error:0: compile_error! "expected nightly date, like 2026-10-11"

and `2.5.twice()` (any method call on a float literal, `2.0.powi(2)`) was
"Couldn't find the field 5 in i32".

The float now ends at the `.`, which follows as TOK_DOT (with an integer
after it, as the TOK_DOT case does), so `1.36.0` is `1.36` `.` `0` as rustc
lexes it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/parse/lex.cpp | 22 +++++++++-------------
 1 file changed, 9 insertions(+), 13 deletions(-)

diff --git a/src/parse/lex.cpp b/src/parse/lex.cpp
index 682a18d1..f39119f9 100644
--- a/src/parse/lex.cpp
+++ b/src/parse/lex.cpp
@@ -1057,21 +1057,17 @@ double Lexer::parseFloat(U128 whole)
         else {
             this->ungetc();
 
-            //buf[ofs] = '\0';
-            //assert( buf[ofs-1] != '.' );    // Shouldn't be possible (as that would have been handled by the caller as `<int> '..'`
-            DEBUG("Detected double tuple indexing (trailing `.` after a float - " << sbuf << ")");
-            // x.y. -> This should be two integers.
-            // - Parse into `<int> '.' <int>` (ungetting the final `.`)
-            const char* buf = sbuf.data();
-            auto cit = std::find(buf, buf+sbuf.size(), '.');
-            sbuf[cit - sbuf.data()] = '\0';
-            //auto cit = std::find(buf, buf+sizeof(buf), '.');
-            //*cit = '\0';
+            // `<float>.` then anything but another `.`: the float ends there, as in rustc (`2.0.powi(2)`, and
+            // `#[rustversion::since(1.36.0)]` is `1.36` `.` `0`). Tuple indices (`x.0.1`) don't get here: digits right
+            // after a `.` are lexed as an integer (see the TOK_DOT symbol case), so the same is done here.
+            DEBUG("Float followed by `.` - " << sbuf);
             // - Push these in reverse order (as they're popped off the back)
+            if( ch.isdigit() ) {
+                auto val = this->parseInt(nullptr);
+                m_next_tokens.push_back(Token(val, CORETYPE_ANY));
+            }
             m_next_tokens.push_back(TOK_DOT);
-            m_next_tokens.push_back(Token(U128(std::strtoull(cit+1, nullptr, 10)), CORETYPE_ANY));
-            m_next_tokens.push_back(TOK_DOT);
-            m_next_tokens.push_back(Token(U128(std::strtoull(buf  , nullptr, 10)), CORETYPE_ANY));
+            m_next_tokens.push_back(Token::make_float(::std::strtod(sbuf.c_str(), NULL), CORETYPE_ANY));
 
             return std::numeric_limits<double>::quiet_NaN();
         }
