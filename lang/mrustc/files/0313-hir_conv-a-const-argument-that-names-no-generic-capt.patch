From 619e470df9d5cad60e1dbc8a8b1c1d37b59315d6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 01:31:01 +0000
Subject: [PATCH 313/314] hir_conv: a const argument that names no generic
 captures none (bounds with `0`)

cryptography-x509 0.1.0 (py-cryptography 48.0.0) extensions.rs:

    #[derive(asn1::Asn1Read, asn1::Asn1Write)]
    pub enum DistributionPointName<'a, Op: Asn1Operation> {
        #[implicit(0)]
        FullName(name::SequenceOfGeneralName<'a, Op>), .. }

    <null> error:0: Failed to find impl with 'can_parse' for
      asn1::Implicit<<Op as Asn1Operation>::SequenceOfVec<'I0, GeneralName<'I0>>, {0}>

asn1_derive 0.24.1 ("perfect derive") writes the bound
`where asn1::Implicit::<name::SequenceOfGeneralName<'a, Op>, 0>:
asn1::Asn1Readable<'a>` and calls `asn1::Implicit::<.., 0>::can_parse(..)`
in `can_parse` and in `parse(parser: &mut asn1::Parser<'a>)`. Resolve UFCS
takes the trait from the bound only for an equal type (the G5 trace showed
the `can_parse` one matching, the `parse` one not): bind gave every
Unevaluated const argument its scope's generics, `{0=<'a, Op> 1=<..>}`, and
`parse` has one more than the impl, its elided lifetime ('M0), so the two
`0`s printed, and compared, differently.

Bind now gives the scope's generics only to an expression that names one
(a const param, a generic type in a type or path, a generic const argument:
`{ size_of::<T>() }`, `{ T::C }`); a literal or `{ CONST }` captures none,
and equal ones compare equal wherever they are written. Evaluating such
an expression never looked at the captured params.

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_conv/bind.cpp b/src/hir_conv/bind.cpp
index d7bdb5f4..c197969a 100644
--- a/src/hir_conv/bind.cpp
+++ b/src/hir_conv/bind.cpp
@@ -16,6 +16,7 @@
 
 #include <hir_typeck/static.hpp>
 #include <hir_typeck/expr_visit.hpp>    // For ModuleState
+#include <hir_typeck/common.hpp>    // visit_ty_with
 #include <hir/expr_state.hpp>
 
 void ConvertHIR_Bind(::HIR::Crate& crate);
@@ -24,6 +25,35 @@ namespace {
 
     static const ::HIR::TypeRef  ty_Self = ::HIR::TypeRef::new_self();
 
+    /// Does a const argument's expression name a generic of its scope (`{ N + 1 }`, `{ size_of::<T>() }`, `{ T::C }`)?
+    bool const_expr_uses_generics(::HIR::ExprPtr& ep)
+    {
+        struct V: public ::HIR::ExprVisitorDef {
+            bool found = false;
+            void visit(::HIR::ExprNode_ConstParam& node) override {
+                found = true;
+            }
+            void visit_type(::HIR::TypeRef& ty) override {
+                if( visit_ty_with(ty, [](const ::HIR::TypeRef& t){ return t.data().is_Generic(); }) ) {
+                    found = true;
+                }
+                ::HIR::ExprVisitorDef::visit_type(ty);
+            }
+            void visit_path_params(::HIR::PathParams& pp) override {
+                for(const auto& v : pp.m_values) {
+                    if( v.is_Generic() ) {
+                        found = true;
+                    }
+                }
+                ::HIR::ExprVisitorDef::visit_path_params(pp);
+            }
+        } v;
+        if( ep ) {
+            ep->visit(v);
+        }
+        return v.found;
+    }
+
     enum class Target {
         TypeItem,
         Struct,
@@ -338,8 +368,16 @@ namespace {
             HIR::Visitor::visit_path_params(params);
             for(auto& v : params.m_values)
             {
+                // An expression that names no generic (a literal) captures none: with the scope's generics, the `0`
+                // of an impl's `where Implicit<X, 0>: Asn1Readable` bound and the `0` of `Implicit::<X, 0>::can_parse`
+                // in a method with a generic (`parse(p: &mut Parser<'a>)`: its elided lifetime) printed differently,
+                // so the path missed the bound. cryptography-x509 0.1.0 extensions.rs (asn1_derive 0.24.1's
+                // "perfect derive" for `#[implicit(0)] FullName(..)`): "Failed to find impl with 'can_parse'"
                 if(auto* ve = v.opt_Unevaluated())
                 {
+                    if( !const_expr_uses_generics(*(*ve)->expr) ) {
+                        continue;
+                    }
                     if( m_ms.m_impl_generics ) {
                         (*ve)->params_impl = m_ms.m_impl_generics->make_nop_params(0);
                     }
