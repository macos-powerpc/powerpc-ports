From caa0f1080e9fa8a05b3e8c607b5b9124f0aebbcf Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 1 Nov 2026 06:25:39 +0000
Subject: [PATCH 423/425] resolve: a 2018 `::crate::` path in a `use` maps to
 the extern crate whatever the consumer's edition

derive_builder_core_fork_arti 0.11.2 (arti 2.7.0; edition 2015, `extern crate darling;`)
src/macro_options/darling_opts.rs:282 `#[derive(Debug, Clone, FromField)]`: "ASSERT FAIL: src/resolve/use.cpp:1363:
crate.m_extern_crates.count(path_abs.crate.c_str()): Crate '=darling' not loaded". darling_core 0.14.4 (edition 2018)
codegen/attr_extractor.rs:90 emits a block-local `use ::darling::ToTokens;`. The parser marks a 2018 `::name::` path
`=name` by the token's edition (proc-macro output carries the macro crate's edition, macro_rules bodies their
source edition), but Resolve_Use_AbsolutisePath mapped `=name` to the loaded crate only when the crate being
compiled was 2018 or later, so a 2015 crate kept `=darling` and Resolve_Use_GetBinding asserted.
Resolve_Absolute_Path and common.cpp never had that gate, and g_implicit_crates holds every `--extern` crate
whatever the edition. The gate is gone.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/resolve/use.cpp b/src/resolve/use.cpp
index f7641f4d..83eaf1e2 100644
--- a/src/resolve/use.cpp
+++ b/src/resolve/use.cpp
@@ -407,7 +407,9 @@ static bool Resolve_Use_LocalImportShadows(const AST::Crate& crate, const ::AST:
     TU_ARMA(Absolute, e) {
         DEBUG("Absolute " << path);
         // HACK: if the crate name starts with `=` it's a 2018 absolute path (references a crate loaded with `--extern`)
-        if( crate.m_edition >= AST::Edition::Rust2018 && e.crate.c_str()[0] == '=' ) {
+        // The marker follows the TOKEN's edition (a 2018 macro's `use ::darling::..` expanded in a 2015 crate), so
+        // don't gate on the crate's edition (absolute.cpp doesn't either).
+        if( e.crate.c_str()[0] == '=' ) {
             // Absolute paths in 2018 edition are crate-prefixed?
             auto ec_it = AST::g_implicit_crates.find(e.crate.c_str() + 1);
             if(ec_it == AST::g_implicit_crates.end())
