From b7df3079442b1c890839b5519a03fa9a75dc00e2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 03:27:40 +0000
Subject: [PATCH] expand: pass `#[link(kind = "framework")]` libraries as `-framework`

The `#[link]` handler parsed `kind` but discarded it, so an extern block
like core-foundation-sys's `#[link(name = "CoreFoundation", kind =
"framework")]` was linked as `-lCoreFoundation` and the final link of any
binary depending on it (e.g. bartib, via chrono -> iana-time-zone) failed
with `ld: library not found for -lCoreFoundation`.

Encode framework libraries as `framework=<name>`, the form minicargo
already uses for `cargo:rustc-link-lib=framework=<name>`, which the C
backend emits as `-framework <name>`.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/expand/codegen.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/expand/codegen.cpp b/src/expand/codegen.cpp
index 5796aaf6..bfb4e6bd 100644
--- a/src/expand/codegen.cpp
+++ b/src/expand/codegen.cpp
@@ -440,6 +440,7 @@ class CHandler_Link:
             TTStream    lex(sp, ParseState(), mi.data());
             lex.getTokenCheck(TOK_PAREN_OPEN);
             std::string lib_name;
+            std::string kind;
             bool emit = true;
             AST::ExternBlock::Link  link;
 
@@ -458,7 +459,7 @@ class CHandler_Link:
                     auto v = lex.getTokenCheck(TOK_STRING).str();
                     if(v == "")
                         ERROR(sp, E0000, "Empty `kind` on extern block #[link]");
-                    // TODO: save and use the kind
+                    kind = v;
                 }
                 else if( key == "cfg" ) {
                     emit &= check_cfg_stream(lex);
@@ -478,6 +479,13 @@ class CHandler_Link:
             }
             if(link.lib_name == "")
                 ERROR(sp, E0000, "No name in `#[link]`");
+            // Apple frameworks use the same `framework=` encoding as `-l framework=Foo` (from minicargo),
+            // which the C backend turns into `-framework Foo` instead of `-lFoo`
+            // TODO: Use the other kinds (`static`, `dylib`, `raw-dylib`)
+            if( kind == "framework" )
+            {
+                link.lib_name = "framework=" + link.lib_name;
+            }
             if( emit )
             {
                 b->m_libraries.push_back(std::move(link));
