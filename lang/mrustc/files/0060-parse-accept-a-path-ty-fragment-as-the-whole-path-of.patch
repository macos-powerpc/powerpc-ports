From 6184391d488c715d55371e22fc33760e3f9d90bb Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 12:56:58 +0000
Subject: [PATCH 60/64] parse: accept a `:path`/`:ty` fragment as the whole
 path of a `use`

`Parse_Use_Root` took an interpolated path or type at the start of
a `use` only as a prefix, demanding a `::` after it. A fragment that is
the whole path, followed by `as name` or `;`, failed. signal-hook-mio
0.2.5's `implement_signals_with_pipe!` (src/lib.rs) does

    ($pipe:path) => {
        ...
        use $pipe as Pipe;

    lib.rs:32:22 error:0: Unexpected token TOK_RWORD_AS, expected TOK_DOUBLE_COLON

When no `::` follows the fragment, finish the entry there: `as` gives
the name (or `_`), otherwise the path's last node is the name, as
`Parse_Use_Inner` does for a plain path.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/parse/root.cpp | 39 ++++++++++++++++++++++++++++-----------
 1 file changed, 28 insertions(+), 11 deletions(-)

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 5f59f961..ad8e1267 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1698,21 +1698,38 @@ void Parse_Use_Root(TokenStream& lex, ::std::vector<AST::UseItem::Ent>& entries)
         }
         GET_CHECK_TOK(tok, lex, TOK_DOUBLE_COLON);
         break;
-    case TOK_INTERPOLATED_TYPE: {
-        if( !tok.frag_type().is_path() ) {
-            throw ParseError::Unexpected(lex, tok);
+    case TOK_INTERPOLATED_TYPE:
+    case TOK_INTERPOLATED_PATH: {
+        if( tok.type() == TOK_INTERPOLATED_PATH ) {
+            path = mv$(tok.frag_path());
         }
-        auto& p = tok.frag_type().path();
-        if( p.m_class.is_UFCS() ) {
-            throw ParseError::Unexpected(lex, tok);
+        else {
+            if( !tok.frag_type().is_path() ) {
+                throw ParseError::Unexpected(lex, tok);
+            }
+            auto& p = tok.frag_type().path();
+            if( p.m_class.is_UFCS() ) {
+                throw ParseError::Unexpected(lex, tok);
+            }
+            path = std::move(tok.frag_type().path());
+        }
+        // The fragment can also be the whole path: `use $p;` or `use $p as name;`
+        // - e.g. `use $pipe as Pipe;` with `$pipe:path` (signal-hook-mio 0.2.5)
+        if( lex.lookahead(0) != TOK_DOUBLE_COLON )
+        {
+            RcString    name;
+            if( lex.getTokenIf(TOK_RWORD_AS) ) {
+                name = get_optional_ident(lex);
+            }
+            else {
+                ASSERT_BUG(lex.point_span(), path.nodes().size() > 0, "`use` with no path");
+                name = path.nodes().back().name();
+            }
+            entries.push_back({ lex.point_span(), AST::Path(path), ::std::move(name) });
+            return ;
         }
-        path = std::move(tok.frag_type().path());
         GET_CHECK_TOK(tok, lex, TOK_DOUBLE_COLON);
         } break;
-    case TOK_INTERPOLATED_PATH:
-        path = mv$(tok.frag_path());
-        GET_CHECK_TOK(tok, lex, TOK_DOUBLE_COLON);
-        break;
     default:
         if(lex.edition_after(AST::Edition::Rust2018))
         {
