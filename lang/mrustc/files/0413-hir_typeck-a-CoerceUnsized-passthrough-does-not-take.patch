From 6001b73edeff46cb76e904dd19071b3e81c202c8 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 30 Oct 2026 19:50:05 +0000
Subject: [PATCH 413/415] hir_typeck: a CoerceUnsized passthrough does not take
 a borrow strength reduction for an unsize

futures-util 0.3.21 (zee 0.3.2) stream/try_stream/into_async_read.rs:141
`self.into_ref().get_ref().state`, under MIR Optimise (the inlined callee):
    MIR ERROR: <IntoAsyncRead<St> as AsyncBufRead>::poll_fill_buf BB127/1:
    src/mir/cleanup.cpp:792 ASSERT str.m_struct_markings.unsized_field != ~0u
    failed - Unsize on type that doesn't have a ?Sized field - IntoAsyncRead<St>

core's `Pin<&'a mut T>::into_ref(self) -> Pin<&'a T> { Pin { pointer:
self.pointer } }`: the literal's parameter had the field's `&'a mut T` as
source and the return type's `&'a T` as destination, and check_ivar_poss took
the source because the coercion `Pin<&T> := Pin<&mut T>` passed its bounds
check: the Passthrough arm (Pin: `Ptr: CoerceUnsized<U>`) recursed into
`&T := &mut T` without a node, and the borrow case reports a strength
reduction it cannot rewrite as `Unsize`. The literal was wrapped in an
`_Unsize` (a MakeDst pseudo-op while T is generic) that asserts once T is
a sized struct. rustc types the field from the expected `Pin<&'a T>` and
reborrows; `Pin<&mut T>` to `Pin<&T>` itself is E0308.

A passthrough whose field types are borrows of different kinds with equal
pointees is now Equality (no coercion): the guess fails its bounds, the
parameter takes the `&T` destination and the field reborrows.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index df69189a..227aa4f3 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -5163,6 +5163,20 @@ namespace {
                 throw "";
             case ::HIR::StructMarkings::Coerce::Passthrough:
                 DEBUG("Passthough CoerceUnsized");
+                // `Pin<&mut T>` to `Pin<&T>` is no coercion: `&mut T: CoerceUnsized<&T>` needs `T: Unsize<T>`, and the
+                // field can't be reborrowed inside the struct. Without a node the borrow case reports that strength
+                // reduction as an unsize, which wrapped `Pin { pointer: self.pointer }` (core's `Pin::into_ref`, the
+                // literal's parameter guessed from its `&mut T` field) in an `_Unsize` whose MIR cleanup asserts once T
+                // is a sized type (futures-util 0.3.21 IntoAsyncRead::poll_fill_buf, zee). Equality makes that guess
+                // fail its bounds, so the parameter takes the `&T` destination and the field reborrows.
+                if( idst.data().is_Borrow() && isrc.data().is_Borrow() && idst.data().as_Borrow().type != isrc.data().as_Borrow().type )
+                {
+                    if( check_unsize_tys(context, sp, idst.data().as_Borrow().inner, isrc.data().as_Borrow().inner, nullptr, nullptr) == CoerceResult::Equality )
+                    {
+                        DEBUG("Passthrough borrow strength reduction is not a CoerceUnsized");
+                        return CoerceResult::Equality;
+                    }
+                }
                 // TODO: Force emitting `_Unsize` instead of anything else
                 return check_coerce_tys(context, sp, idst, isrc, context_mut, nullptr);
             case ::HIR::StructMarkings::Coerce::Pointer:
