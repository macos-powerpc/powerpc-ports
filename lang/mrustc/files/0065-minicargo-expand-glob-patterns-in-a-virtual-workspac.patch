+                // - e.g. jql 9.0.3 (`members = ["crates/*"]`)
+                ::std::vector<::std::string>    members;
                 for(const auto& member : workspace_manifest.members())
                 {
-                    if( member.find('*') != ::std::string::npos ) {
-                        // Glob members: not supported for auto-selection
+                    auto star = member.find('*');
+                    if( star == ::std::string::npos ) {
+                        members.push_back(member);
                         continue;
                     }
+                    auto slash = member.rfind('/');
+                    if( slash != ::std::string::npos && star < slash ) {
+                        ::std::cerr << "Warning: workspace member `" << member << "` has a wildcard in a directory component, ignored" << ::std::endl;
+                        continue;
+                    }
+                    auto parent = (slash == ::std::string::npos ? ::std::string() : member.substr(0, slash));
+                    auto pattern = member.substr(slash == ::std::string::npos ? 0 : slash + 1);
+                    ::std::vector<::std::string>    matches;
+                    list_directory(parent.empty() ? dir : dir / parent.c_str(), [&](const char* name) {
+                        if( glob_match(pattern.c_str(), name) )
+                            matches.push_back(parent.empty() ? ::std::string(name) : parent + "/" + name);
+                        });
+                    ::std::sort(matches.begin(), matches.end());
+                    DEBUG("Workspace member glob `" << member << "` -> " << matches);
+                    members.insert(members.end(), matches.begin(), matches.end());
+                }
