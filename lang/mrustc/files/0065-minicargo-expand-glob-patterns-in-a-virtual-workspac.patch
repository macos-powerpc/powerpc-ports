+++ b/tools/minicargo/main.cpp
@@ -17,9 +17,66 @@
 #include "build.h"
 #include <toml.h>   // TomlFile (workspace)
 #include <fstream>  // for workspace enumeration
+#include <algorithm>
+#include <functional>
+#ifdef _WIN32
+# include <Windows.h>
+#else
+# include <dirent.h>
+#endif
 #include "cfg.hpp"
 #include "resolve.h"
 
+namespace {
+    /// Call `cb` with the name of every entry of the directory `path` (except `.` and `..`)
+    void list_directory(const ::helpers::path& path, ::std::function<void(const char*)> cb)
+    {
+    #ifdef _WIN32
+        WIN32_FIND_DATA find_data;
+        HANDLE find_handle = FindFirstFile( (path / "*").str().c_str(), &find_data );
+        if( find_handle == INVALID_HANDLE_VALUE )
+            return ;
+        do {
+            if( strcmp(find_data.cFileName, ".") != 0 && strcmp(find_data.cFileName, "..") != 0 )
+                cb(find_data.cFileName);
+        } while( FindNextFile(find_handle, &find_data) );
+        FindClose(find_handle);
+    #else
+        auto* dp = opendir(path.str().c_str());
+        if( dp == nullptr )
+            return ;
+        while( const auto* dent = readdir(dp) )
+        {
+            if( strcmp(dent->d_name, ".") != 0 && strcmp(dent->d_name, "..") != 0 )
+                cb(dent->d_name);
+        }
+        closedir(dp);
+    #endif
+    }
+    /// Shell-style pattern match: `*` matches any run of characters, `?` any single character
+    bool glob_match(const char* pat, const char* s)
+    {
+        for( ; *pat; pat ++, s ++ )
+        {
+            if( *pat == '*' )
+            {
+                while( pat[1] == '*' )
+                    pat ++;
+                for( ; ; s ++ )
+                {
+                    if( glob_match(pat + 1, s) )
+                        return true;
+                    if( !*s )
+                        return false;
+                }
+            }
+            if( !*s || (*pat != '?' && *pat != *s) )
+                return false;
+        }
+        return *s == '\0';
+    }
+}
