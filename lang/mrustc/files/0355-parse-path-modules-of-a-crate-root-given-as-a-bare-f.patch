From f9b65f2f01367456c104fbb2269ae4f133a9c619 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 14:42:09 +0000
Subject: [PATCH 355/355] parse: `#[path]` modules of a crate root given as a bare
 file name

`mrustc root.rs` (no directory part) with `#[path = "m.rs"] pub mod x;`
in the root:

    terminate called after throwing an instance of 'std::runtime_error'
      what():  Empty path being constructed

The `#[path]` arm of the module parser takes the directory of the top
file's name through `dirname()`, which returned "" for a bare name, and
`helpers::path` rejects an empty path. The crate root's own `mainpath`
already falls back to `./` for a bare name (which is why `mod x;` without
`#[path]` worked). minicargo always passes absolute paths, so no port
hits this; hand-run builds and the kits do. Found writing the kit of
the previous commit.

`dirname()` of a name without a separator is now `./`.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 1d48e077..a8cbb0ee 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -37,10 +37,17 @@ Spanned<T> get_spanned(TokenStream& lex, ::std::function<T()> f) {
 // Check the next two tokens
 #define LOOKAHEAD2(lex, tok1, tok2) ((lex).lookahead(0) == (tok1) && (lex).lookahead(1) == (tok2))
 
+// The directory of a file name, as the crate root's `mainpath` below computes it: a bare name (`mrustc lib.rs`,
+// no separator) lives in the current directory, so the result is `./` and never the empty string that
+// `helpers::path` rejects ("Empty path being constructed" from `#[path = "x.rs"] mod m;` in a crate root given
+// as a bare relative name; minicargo always passes absolute paths, hand-run builds and kits do not).
 ::helpers::path dirname(::std::string input) {
     while( input.size() > 0 && input.back() != '/' && input.back() != '\\' ) {
         input.pop_back();
     }
+    if( input.empty() ) {
+        return "./";
+    }
     return input;
 }
 
