From 0c1d652118564598d56dc6f2d76fbaec7fcdfb12 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 10:08:36 +0000
Subject: [PATCH] trans: a C ABI fn pointer typedef declares the pointee of
 a scalarised argument

imagequant-sys 4.0.3 (pngquant 3.0.3) ffi.rs:

    #[repr(transparent)] pub struct AnySyncSendPtr(pub *mut c_void);
    row_callback: unsafe extern "C" fn(*mut MaybeUninit<RGBA>, c_int, c_int, AnySyncSendPtr)

The C ABI scalarisation (0043) writes the newtype argument as the pointer it
wraps, `struct e_..c_void *`, in the function pointer typedef. The type
walker only visits a fn pointer's arguments shallowly, so it guarantees a
forward declaration of `struct s_..AnySyncSendPtr` and nothing for c_void.
When c_void had not been declared yet, the struct tag was scoped to the
typedef's parameter list. The call through the pointer then passed a
file-scope `struct e_..c_void *`, and GCC 14 rejected it ("passing argument
4 of 'arg0' from incompatible pointer type", "expected 'struct e_..c_void *'
but argument is of type 'struct e_..c_void *'").

emit_type_fn now emits the type proto of the pointee (through any number of
pointer/reference layers) of each scalarised argument and return type
before the typedef. This extends 0066, which did the same for a scalarised
`Option<extern "C" fn>`. A repeated struct declaration or identical typedef
is valid C, and the existing output already repeats tuple typedefs.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/trans/codegen_c.cpp | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 1eef1dfa..be76db1b 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -1968,16 +1968,27 @@ namespace {
             // first. The type walker only guarantees forward declarations here, and a scalarised `Option<extern "C"
             // fn(..)>` argument names the inner function type directly instead of the enum's struct.
             // - onig_sys 69.9.1: `OnigEncodingTypeST::apply_all_case_fold` takes an `OnigApplyAllCaseFoldFunc`
+            // Likewise a scalarised pointer newtype names its pointee, which the walker never visited: declare it
+            // here, as a struct first named in a parameter list is a different type from the file-scope one.
+            // - imagequant-sys 4.0.3: `liq_image_create_custom`'s row callback takes an `AnySyncSendPtr(*mut c_void)`
             {
-                auto emit_fn_dep = [&](const ::HIR::TypeRef& t) {
-                    if( t.data().is_Function() ) {
+                auto emit_dep = [&](const ::HIR::TypeRef* scalar, const ::HIR::TypeRef& t) {
+                    if( use_cabi && scalar ) {
+                        const auto* cur = scalar;
+                        while( cur->data().is_Pointer() || cur->data().is_Borrow() ) {
+                            cur = cur->data().is_Pointer() ? &cur->data().as_Pointer().inner : &cur->data().as_Borrow().inner;
+                        }
+                        // Repeated struct declarations and identical typedefs are both allowed in C
+                        emit_type_proto(*cur);
+                    }
+                    else if( t.data().is_Function() ) {
                         emit_type_fn(t);
                         m_of << "\n";
                     }
                     };
-                emit_fn_dep( (use_cabi && cabi.ret) ? *cabi.ret : te.m_rettype );
+                emit_dep(use_cabi ? cabi.ret : nullptr, te.m_rettype);
                 for(unsigned int i = 0; i < te.m_arg_types.size(); i ++) {
-                    emit_fn_dep( (use_cabi && cabi.args[i]) ? *cabi.args[i] : te.m_arg_types[i] );
+                    emit_dep(use_cabi ? cabi.args[i] : nullptr, te.m_arg_types[i]);
                 }
             }
             m_of << "typedef ";
