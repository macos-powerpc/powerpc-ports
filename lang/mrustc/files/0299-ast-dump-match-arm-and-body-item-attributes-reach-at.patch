From 63fcbe1575662acbb4a97d3790dbd24d4a3852ec Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 15:17:50 +0000
Subject: [PATCH 299/300] ast/dump: match-arm and body-item attributes reach
 attribute proc macros

cyclonedx-bom 0.8.1 src/specs/common/tool.rs:66, service.rs:557:
`#[versioned("1.5")] models::tool::Tools::Object { .. } => ..` inside
a `#[versioned(..)] mod`. A function body handed to an attribute proc macro is
printed by the AST dumper (DumpAST_Node) and re-lexed; the dumper printed
match arms, and the `use`/`mod` items of a body's anonymous module, without
their attributes (statements, struct-literal fields and every other item kind
had them). The macro saw a version-gated arm as unconditional and would have
emitted two `None =>` arms, or fields of another version, into each module.

print_attrs on match arms and on `use`/`mod` items.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/ast/dump.cpp b/src/ast/dump.cpp
index c35ea29a..e3893b87 100644
--- a/src/ast/dump.cpp
+++ b/src/ast/dump.cpp
@@ -393,6 +393,10 @@ public:
 
         for( auto& arm : n.m_arms )
         {
+            // The arm's attributes: this text becomes an attribute proc macro's input (DumpAST_Node),
+            // where a `#[cfg]`/`#[versioned("1.3")]` arm sent bare would be kept unconditionally
+            // - cyclonedx-bom 0.8.1 specs/common/tool.rs `#[versioned("1.5")] models::tool::Tools::Object { .. } => ..`
+            print_attrs(arm.m_attrs);
             m_os << indent();
             bool is_first = true;
             for( const auto& pat : arm.m_patterns ) {
@@ -842,6 +846,8 @@ void RustPrinter::handle_module(const AST::Module& mod)
         if( i_data.entries.empty() ) {
             continue ;
         }
+        // Attributes as for every other item kind (a `#[cfg]` `use` in a function body handed to a proc macro)
+        print_attrs(i.attrs);
         m_os << indent() << i.vis << "use ";
         if( i_data.entries.size() > 1 ) {
             m_os << "{";
@@ -894,6 +900,7 @@ void RustPrinter::handle_module(const AST::Module& mod)
         const auto& e = item.data.as_Module();
 
         m_os << "\n";
+        print_attrs(item.attrs);
         m_os << indent() << item.vis << "mod " << item.name << "\n";
         m_os << indent() << "{\n";
         inc_indent();
