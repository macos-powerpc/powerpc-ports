From b0940a1b0b176965126bebfbcfe805ae7ac5a19c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 21:12:45 +0000
Subject: [PATCH] hir_typeck: the operand of a unary `!`/`-` takes the expected
 type of any kind, also a coercion's target

enum-ordinalize-derive 4.4.1 src/lib.rs:433 (localsend-cli 1.18.2, proc-macro, edition 2024):
    let mut counter = Int128::ZERO; ..
    counter = -lit.base10_parse().map_err(|error| syn::Error::new_spanned(lit, error))?;
= "error:0: Failed to find an impl of Neg for ! with Output = Int128". `Int128` is the crate's own enum with
`impl Neg for Int128 { type Output = Int128 }`, `base10_parse<N: FromStr>`. rustc checks the operand of `-`/`!` with
the expression's expectation, whatever its type, and at a coercion site (assignment, `let` with a type, argument,
return) the expectation is the coercion's target, so the `?` match coerces N to `Int128`. 0347's rule (C198) only
equated a PRIMITIVE result type, and here the `-` expression's own type is the still unknown source of the coercion
`Int128 := _`, so the unary-operand stage saw nothing and the next stage picked `!` from the `return` arm of the `?`
match.

The UniOp revisit takes the result type when it is known (any type), else the known target of the coercion whose
source is the node. Still match/block operands only and the same late stage (0351). The coercion sites that are no
ExpectHasType in rustc (cast to a path, index, a binop's rhs ivar) are ones where rustc rejects an unresolved operand,
so they only accept more.

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 82ec6062..01ca5622 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -214,12 +214,34 @@ namespace {
             // ergonomics, after the method calls resolve), so the equate waits for the dedicated stage of the main
             // loop (after the definitive stages and the first guesses, before the never-type pick). A known operand
             // is the `Not`/`Neg` rule's business.
+            // The expectation is any type, not only a primitive one (`Neg for Int128`), and at a coercion site
+            // (`let`, assignment, argument, ..) it is the coercion's target: the expression's own type is then the
+            // coercion's unknown source (enum-ordinalize-derive 4.4.1 lib.rs:433 `counter = -lit.base10_parse()
+            // .map_err(..)?;` with `counter: Int128`).
             if( !val_ty.data().is_Infer() ) {
                 this->m_completed = true;
             }
-            else if( this->m_is_fallback && res_ty.data().is_Primitive() && uniop_operand_takes_expectation(node) ) {
-                this->context.equate_types(sp, val_ty, res_ty);
-                this->m_completed = true;
+            else if( this->m_is_fallback && uniop_operand_takes_expectation(node) ) {
+                const ::HIR::TypeRef* exp_ty = nullptr;
+                if( !res_ty.data().is_Infer() ) {
+                    exp_ty = &res_ty;
+                }
+                else {
+                    for(const auto& c : this->context.link_coerce) {
+                        if( c->right_node_ptr->get() != &node )
+                            continue;
+                        const auto& l = this->context.get_type(c->left_ty);
+                        if( !l.data().is_Infer() ) {
+                            DEBUG("Expectation from coercion R" << c->rule_idx << ": " << l);
+                            exp_ty = &l;
+                        }
+                        break;
+                    }
+                }
+                if( exp_ty ) {
+                    this->context.equate_types(sp, val_ty, *exp_ty);
+                    this->m_completed = true;
+                }
             }
             else {
                 // Neither side known yet (or not the fallback stage)
@@ -8560,8 +8582,9 @@ void Typecheck_Code_CS(const typeck::ModuleState& ms, t_args& args, const ::HIR:
             }
         }
 
-        // The operand of a unary `!`/`-` takes a primitive result type (rustc's expectation coerces the arms of
-        // a match or the tail of a block to it, see the UniOp revisit) once the definitive stages and the guesses above
+        // The operand of a unary `!`/`-` takes the expected type (the result type, or the target of the coercion
+        // whose source the result is; rustc's expectation coerces the arms of a match or the tail of a block to it,
+        // see the UniOp revisit) once the definitive stages and the guesses above
         // left it unknown: before the stage below picks `!` for an ivar whose only known source diverges (the `return`
         // arm of a `?` match, pydantic_core 2.46.5 validators/decimal.rs:148 `if !obj.call(..)?.extract()? {..}`).
         if( !context.m_ivars.peek_changed() )
diff --git a/src/hir_typeck/expr_cs__enum.cpp b/src/hir_typeck/expr_cs__enum.cpp
index 553b869f..83c5aab5 100644
--- a/src/hir_typeck/expr_cs__enum.cpp
+++ b/src/hir_typeck/expr_cs__enum.cpp
@@ -1223,7 +1223,7 @@ namespace typecheck
             const auto& op_trait = this->context.m_crate.get_lang_item_path(node.span(), item_name);
             this->context.equate_types_assoc(node.span(), node.m_res_type,  op_trait, ::HIR::PathParams {}, node.m_value->m_res_type.clone(), "Output", {}, true);
             node.m_value->visit( *this );
-            // An unknown match/block operand can take the result type (see the revisit)
+            // An unknown match/block operand can take the expected type (see the revisit)
             if( uniop_operand_takes_expectation(node) && this->context.get_type(node.m_value->m_res_type).data().is_Infer() ) {
                 this->context.add_revisit(node);
             }
