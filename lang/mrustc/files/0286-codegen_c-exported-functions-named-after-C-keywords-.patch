From 9ae698d44c8a0610e8c0bab525ed80d74991f0ac Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 07:39:39 +0000
Subject: [PATCH] codegen_c: exported functions named after C keywords or
 non-identifiers

A defined function with a link name was named after it in the C with
`#define <mangled> <link name>`. With `#[no_mangle] pub extern "C" fn
short(..)` that made `uint32_t short(uint32_t)`:

    error: two or more data types in declaration specifiers

and an `#[export_name = "a.b"]` (or LLVM's leading `\1`) gave a macro that
isn't an identifier at all. Found while writing the 0285 kit.

Such names (the C11 keywords, GNU `asm`/`typeof`, `bool`/`true`/`false`/
`NULL`, anything that isn't an identifier) now keep the mangled C name and
get the symbol from an asm label on the prototype (on the `__cabi`
wrapper's when there is one), the way statics and imports already do,
with the platform prefix from get_asm_symbol_name. Every other link name
keeps the `#define`, which glue code relies on.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index cc71c82f..82ff46a3 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -233,6 +233,33 @@ namespace {
             return "_" + linkage_name;
         return linkage_name;
     }
+    // A link name that can't be used as the C identifier of a defined function (which `#define <mangled> <name>`
+    // does): a C keyword (`#[no_mangle] pub extern "C" fn short(..)`), or not an identifier at all (`#[export_name =
+    // "a.b"]`, a leading `\1`). Those get the symbol through an asm label on the prototype, as statics and imports do.
+    bool link_name_needs_asm_label(const ::std::string& name)
+    {
+        static const ::std::set<::std::string> c_keywords = {
+            "auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum", "extern",
+            "float", "for", "goto", "if", "inline", "int", "long", "register", "restrict", "return", "short", "signed",
+            "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void", "volatile", "while",
+            "_Alignas", "_Alignof", "_Atomic", "_Bool", "_Complex", "_Generic", "_Imaginary", "_Noreturn",
+            "_Static_assert", "_Thread_local",
+            // GNU and <stdbool.h>/<stddef.h> names the generated C uses
+            "asm", "typeof", "bool", "true", "false", "NULL",
+            };
+        if( name.empty() )
+            return false;
+        if( c_keywords.count(name) )
+            return true;
+        if( !(isalpha(static_cast<unsigned char>(name[0])) || name[0] == '_') )
+            return true;
+        for(char c : name)
+        {
+            if( !(isalnum(static_cast<unsigned char>(c)) || c == '_') )
+                return true;
+        }
+        return false;
+    }
 
     enum class AtomicOp
     {
@@ -3386,6 +3413,8 @@ namespace {
             CAbiSig cabi;
             bool use_cabi = get_cabi_sig_fcn(cabi, item, params);
             const char* sym_suffix = use_cabi ? "__cabi" : "";
+            // (see link_name_needs_asm_label: the label goes on the exported declaration below)
+            const bool asm_label = item.m_linkage.name != "" && m_compiler == Compiler::Gcc && link_name_needs_asm_label(item.m_linkage.name);
             if( item.m_linkage.name != "" )
             {
                 if( item.m_linkage.type == ::HIR::Linkage::Type::Weak && m_compiler == Compiler::Msvc )
@@ -3393,6 +3422,9 @@ namespace {
                     // If this function is implementing an external ABI, just rename it (don't bother with per-compiler trickery).
                     m_of << "#pragma comment(linker, \"/alternatename:" << item.m_linkage.name << "=" << Trans_Mangle(p) << sym_suffix << "\")\n";
                 }
+                else if( asm_label )
+                {
+                }
                 else
                 {
                     // If this function is implementing an external ABI, just rename it (don't bother with per-compiler trickery).
@@ -3427,11 +3459,17 @@ namespace {
                 };
             emit_prefix();
             emit_function_header(p, item, params);
+            if( asm_label && !use_cabi ) {
+                m_of << " asm(\"" << get_asm_symbol_name(item.m_linkage.name) << "\")";
+            }
             m_of << ";\n";
             if( use_cabi )
             {
                 emit_prefix();
                 emit_function_header(p, item, params, &cabi);
+                if( asm_label ) {
+                    m_of << " asm(\"" << get_asm_symbol_name(item.m_linkage.name) << "\")";
+                }
                 m_of << ";\n";
             }
 
