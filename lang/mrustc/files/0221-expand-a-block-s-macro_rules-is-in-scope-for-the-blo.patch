diff --git a/src/ast/expr.hpp b/src/ast/expr.hpp
index 3c31f73d..9c5e78e4 100644
--- a/src/ast/expr.hpp
+++ b/src/ast/expr.hpp
@@ -149,6 +149,9 @@ struct ExprNode_Macro:
     RcString   m_ident;
     ::TokenTree m_tokens;
     bool    m_is_braced;
+    // A `macro_rules!` written in a block: how many of the block's items were parsed before it (it is in scope for the
+    // items after those). `SIZE_MAX` otherwise.
+    size_t  m_block_items_before = SIZE_MAX;
 
     ExprNode_Macro(AST::Path name, RcString ident, ::TokenTree&& tokens, bool is_braced=false):
