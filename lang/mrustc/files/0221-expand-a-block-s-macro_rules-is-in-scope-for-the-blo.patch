@@ -960,18 +960,42 @@ struct CExpandExpr:
 
     void visit(::AST::ExprNode_Block& node) override {
         this->in_assign_lhs = false;
-        unsigned int mod_item_count = 0;
 
         auto prev_modstack = this->expand_state.modstack;
         if( node.m_local_mod ) {
             this->expand_state.modstack = LList<const ::AST::Module*>(&prev_modstack, node.m_local_mod.get());
         }
 
-        // TODO: macro_rules! invocations within the expression list influence this.
-        // > Solution: Defer creation of the local module until during expand.
+        // A `macro_rules!` written in the block is registered when the walk below reaches it, and is in scope for the
+        // block's items after it (not the ones before). So the items are expanded in runs: those before the first
+        // definition now, those up to the next definition right after the walk registers each one, and the rest (with
+        // any the walk adds) after the walk.
+        // - A run stops at the item that followed the next definition when it was parsed, picked before anything
+        //   expands (item macros expand in place and shift the indices, the items themselves don't move)
+        ::std::vector<const AST::Named<AST::Item>*>   parsed_items;
         if( node.m_local_mod ) {
-            Expand_Mod(this->expand_state, node.m_local_mod->path(), *node.m_local_mod);
-            mod_item_count = node.m_local_mod->m_items.size();
+            for(const auto& i : node.m_local_mod->m_items)
+                parsed_items.push_back(i.get());
+        }
+        unsigned int next_item = 0;
+        auto expand_items_to_next_def = [&](::std::vector<AST::ExprNode_Block::Line>::iterator it) {
+            size_t n_before = SIZE_MAX;
+            for(; it != node.m_nodes.end(); ++ it) {
+                if( const auto* m = dynamic_cast<const ::AST::ExprNode_Macro*>(it->node.get()) ) {
+                    if( m->m_block_items_before != SIZE_MAX ) {
+                        n_before = m->m_block_items_before;
+                        break;
+                    }
+                }
+            }
+            auto& lm = *node.m_local_mod;
+            const auto* stop = n_before < parsed_items.size() ? parsed_items[n_before] : nullptr;
+            Expand_Mod(this->expand_state, lm.path(), lm, next_item, stop);
+            while( next_item < lm.m_items.size() && lm.m_items[next_item].get() != stop )
+                next_item ++;
+        };
+        if( node.m_local_mod ) {
+            expand_items_to_next_def(node.m_nodes.begin());
         }
 
         auto saved = this->current_block;
@@ -994,10 +1018,16 @@ struct CExpandExpr:
 
                 assert(it->node.get() == node_mac);
 
+                bool is_block_def = node_mac->m_block_items_before != SIZE_MAX;
                 ::std::vector< ::AST::ExprNode_Block::Line>    new_nodes;
                 this->visit_macro(*node_mac, &new_nodes);
-                for(const auto& n : new_nodes) {
+                for(auto& n : new_nodes) {
                     DEBUG("++ " << *n.node << (n.has_semicolon ? " ;" : ""));
+                    // A `macro_rules!` from an expansion counted the items present now, not the parsed ones; the items
+                    // the expansion adds go after the walk anyway
+                    if( auto* m = dynamic_cast<::AST::ExprNode_Macro*>(n.node.get()) ) {
+                        m->m_block_items_before = SIZE_MAX;
+                    }
                 }
 
                 if(node_mac->m_path.is_valid()) {
@@ -1022,6 +1052,11 @@ struct CExpandExpr:
                     it = node.m_nodes.erase(it);
                     it = node.m_nodes.insert(it, ::std::make_move_iterator(new_nodes.begin()), ::std::make_move_iterator(new_nodes.end()));
                     // NOTE: Doesn't advance the iterator above, we want to re-visit the new node
+
+                    // A definition from the block's source is now registered: expand the items it is in scope for
+                    if( is_block_def && node.m_local_mod ) {
+                        expand_items_to_next_def(it);
+                    }
                 }
             }
             else
@@ -1039,8 +1074,9 @@ struct CExpandExpr:
         this->current_block = saved;
 
         // HACK! Run Expand_Mod twice on local modules.
+        // - Covers the items after the last definition, and the ones the walk added
         if( node.m_local_mod ) {
-            Expand_Mod(this->expand_state, node.m_local_mod->path(), *node.m_local_mod, mod_item_count);
+            Expand_Mod(this->expand_state, node.m_local_mod->path(), *node.m_local_mod, next_item);
         }
 
         this->expand_state.modstack = mv$(prev_modstack);
@@ -1861,8 +1897,9 @@ void Expand_Impl(const ExpandState& es, ::AST::Path modpath, ::AST::Module& mod,
                 // Move out of the module to avoid invalidation if a new macro invocation is added
                 auto mi_owned = mv$(e);
 
+                // Not found yet: left for another pass, as for module items (e.g. a block's `macro_rules!` that a
+                // statement macro expands to)
                 auto ttl = Expand_Macro(es, mod, mi_owned);
-                ASSERT_BUG(mi_owned.span(), ttl, "TODO: Unexpanded macro?");
 
                 if( ttl )
                 {
@@ -1992,9 +2029,10 @@ void Expand_ExternBlock(const ExpandState& es, ::AST::Module& mod, ::AST::Extern
     }
 }
 
-void Expand_Mod(const ExpandState& es, ::AST::AbsolutePath modpath, ::AST::Module& mod, unsigned int first_item)
