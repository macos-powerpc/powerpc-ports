--- a/src/ast/expr.cpp
+++ b/src/ast/expr.cpp
@@ -132,7 +132,9 @@ NODE(ExprNode_Macro, {
     }
     os << "(" << " /*TODO*/ " << ")";
 },{
-    return NEWNODE(ExprNode_Macro, AST::Path(m_path), m_ident, m_tokens.clone());
+    auto rv = NEWNODE(ExprNode_Macro, AST::Path(m_path), m_ident, m_tokens.clone());
+    static_cast<ExprNode_Macro&>(*rv).m_block_items_before = m_block_items_before;
+    return rv;
 })
 
