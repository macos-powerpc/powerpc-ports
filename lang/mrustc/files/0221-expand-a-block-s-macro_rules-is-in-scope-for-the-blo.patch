-    for( unsigned int idx = first_item; idx < mod.m_items.size(); idx ++ )
+    for( unsigned int idx = first_item; idx < mod.m_items.size() && mod.m_items[idx].get() != stop_at; idx ++ )
     {
         auto& i = *mod.m_items[idx];
 
