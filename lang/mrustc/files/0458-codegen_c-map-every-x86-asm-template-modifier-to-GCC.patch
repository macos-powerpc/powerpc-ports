From 72a4a32b85318b0804d64236fe40b06f831eafd3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 9 Nov 2026 05:55:37 +0000
Subject: [PATCH] codegen_c: map every x86 asm! template modifier to GCC's by
 register class

cmov 0.5.4 (arti 2.8.0, x86_64 run) `<u16 as CmovEq>::cmoveq`:
`codegen_c.cpp: Asm2 GCC: modifier x - asm!("xor {0:x}, {1:x}" "cmovz
{2:e}, {3:e}", ..)`.

The GCC template writer knew only `r` (-> GCC `q`) and `e` (-> `k`).
Rust's x86 modifiers map to GCC's (the letters LLVM takes too) by the
operand's register class: reg/reg_abcd `l h x e r` -> `b h w k q`,
xmm/ymm/zmm_reg `x y z` -> `x t g`. Without a modifier Rust names the
class's full register (reg: rax on x86_64, eax on x86; ymm_reg: ymm0)
where GCC's `%0` follows the operand's C type (`ax` for a u16, `xmm0`
for a double), so a bare reg operand now gets `q`/`k` and a bare
*mm_reg one `x`/`t`/`g`; reg_byte and kreg stay bare. A modifier Rust
doesn't have for the class, or any modifier on a non-x86 target, is
a TODO as before. powerpc output is unchanged.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 582bae13..1caa7499 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -6653,6 +6653,47 @@ namespace {
                 return "fr" + name.substr(1);
             return name;
         }
+        // Rust's x86 template modifier -> GCC's (the letters LLVM takes too), by register class; '?' = not one Rust
+        // has. Without a modifier Rust names the class's full register (`reg`: rax, `ymm_reg`: ymm0) where GCC's `%0`
+        // follows the operand's C type (`ax` for a u16, `xmm0` for a double): cmov 0.5.4 x86.rs `xor {0:x}, {1:x}`
+        static char asm_x86_gcc_modifier(AsmCommon::RegisterClass cls, char modifier, bool is_x86_64)
+        {
+            switch(cls)
+            {
+            case AsmCommon::RegisterClass::x86_reg:
+            case AsmCommon::RegisterClass::x86_reg_abcd:
+                switch(modifier)
+                {
+                case '\0': return is_x86_64 ? 'q' : 'k';
+                case 'l':   return 'b';
+                case 'h':   return 'h';
+                case 'x':   return 'w';
+                case 'e':   return 'k';
+                case 'r':   return 'q';
+                }
+                break;
+            case AsmCommon::RegisterClass::x86_xmm:
+            case AsmCommon::RegisterClass::x86_ymm:
+            case AsmCommon::RegisterClass::x86_zmm:
+                switch(modifier)
+                {
+                case '\0':
+                    return cls == AsmCommon::RegisterClass::x86_xmm ? 'x' : cls == AsmCommon::RegisterClass::x86_ymm ? 't' : 'g';
+                case 'x':   return 'x';
+                case 'y':   return 't';
+                case 'z':   return 'g';
+                }
+                break;
+            case AsmCommon::RegisterClass::x86_reg_byte:
+            case AsmCommon::RegisterClass::x86_kreg:
+                if( modifier == '\0' )
+                    return '\0';
+                break;
+            default:
+                break;
+            }
+            return '?';
+        }
         static const char* asm_reg_kind_constraint(AsmRegKind kind)
         {
             switch(kind)
@@ -6868,7 +6909,8 @@ namespace {
                 m_of << indent << "__asm__ ";
                 m_of << "__volatile__"; // Default everything to volatile
                 m_of << "(\"";
-                bool is_intel = (Target_GetCurSpec().m_arch.m_name == "x86" || Target_GetCurSpec().m_arch.m_name == "x86_64") && !se.options.att_syntax;
+                bool is_x86 = Target_GetCurSpec().m_arch.m_name == "x86" || Target_GetCurSpec().m_arch.m_name == "x86_64";
+                bool is_intel = is_x86 && !se.options.att_syntax;
                 if( is_intel )
                     m_of << ".intel_syntax noprefix; ";
                 bool escape_percent = true || !inputs.empty() || !outputs.empty();
@@ -6883,17 +6925,15 @@ namespace {
                             m_of << se.params[f.index].as_Reg().spec.as_Explicit();
                             continue;
                         }
-                        switch( f.modifier )
-                        {
-                        case '\0':
-                            break;
-                        case 'r':
-                            m_of << 'q';    // x86: `q` selects rax explicitly
-                            break;
-                        case 'e':
-                            m_of << 'k';    // x86: `k` selects eax instead of rax
-                            break;
-                        default:
+                        const auto* cls = se.params[f.index].is_Reg() ? se.params[f.index].as_Reg().spec.opt_Class() : nullptr;
+                        if( is_x86 && cls ) {
+                            char m = asm_x86_gcc_modifier(*cls, f.modifier, Target_GetCurSpec().m_arch.m_name == "x86_64");
+                            if( m == '?' )
+                                MIR_TODO(mir_res, "Asm2 GCC: modifier " << f.modifier << " on " << AsmCommon::to_string(*cls) << " - " << stmt);
+                            if( m != '\0' )
+                                m_of << m;
+                        }
+                        else if( f.modifier != '\0' ) {
                             MIR_TODO(mir_res, "Asm2 GCC: modifier " << f.modifier << " - " << stmt);
                         }
                         m_of << arg_mappings.at(f.index);
