diff --git a/tools/minicargo/build.cpp b/tools/minicargo/build.cpp
index 989dd0bc..48194c0d 100644
--- a/tools/minicargo/build.cpp
+++ b/tools/minicargo/build.cpp
@@ -1243,6 +1243,14 @@ RunnableJob Job_BuildTarget::start()
         if(!strcmp(lib.first, "framework")) {
             args.push_back("-l"); args.push_back(format("framework=",lib.second.c_str()));
         }
+        // An explicit `static` keeps its kind: a `staticlib` carries such archives (cxx's and cxx-build's C++ halves
+        // in newsboat's libnewsboat.a); other link outputs link it like any other library
+        else if(!strcmp(lib.first, "static")) {
+            args.push_back("-l"); args.push_back(format("static=",lib.second.c_str()));
+        }
+        else if(!strcmp(lib.first, "static-nobundle")) {
+            args.push_back("-l"); args.push_back(format("static:-bundle=",lib.second.c_str()));
+        }
         else {
             args.push_back("-l"); args.push_back(lib.second.c_str());
         }
