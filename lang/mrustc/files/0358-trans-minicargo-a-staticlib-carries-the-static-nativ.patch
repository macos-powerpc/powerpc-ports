+    /// A native library of the link (`-l`, a build script's `cargo:rustc-link-lib`, `#[link]`): `[kind[:modifiers]=]name`
+    struct NativeLib
+    {
+        /// What the link list gets: the name, or `framework=Name` (which the C backend turns into `-framework Name`)
+        ::std::string   spec;
+        ::std::string   name;
+        /// `static=` (rustc's default modifier `+bundle`): a `staticlib` carries the archive's members
+        bool    bundle = false;
+
+        static NativeLib parse(const ::std::string& s)
+        {
+            NativeLib   rv;
+            rv.spec = s;
+            rv.name = s;
+            auto eq = s.find('=');
+            if( eq == ::std::string::npos )
+                return rv;
+            auto kind = s.substr(0, eq);
+            ::std::string   modifiers;
+            auto colon = kind.find(':');
+            if( colon != ::std::string::npos ) {
+                modifiers = kind.substr(colon+1);
+                kind = kind.substr(0, colon);
+            }
+            if( kind == "framework" ) {
+                rv.name = s.substr(eq+1);
+                rv.spec = "framework=" + rv.name;
+            }
+            else if( kind == "static" || kind == "dylib" ) {
+                rv.name = s.substr(eq+1);
+                rv.spec = rv.name;
+                rv.bundle = (kind == "static" && modifiers.find("-bundle") == ::std::string::npos);
+            }
+            return rv;
+        }
+    };
+
+    /// Write the object members of a Unix `ar` archive (System V/GNU or BSD format) to `dir`, named `<prefix>-<n>-<member>`
+    /// so members of several archives (or same-named members of one) don't collide. Returns the written paths, or an error.
+    bool extract_archive_members(const ::std::string& archive, const ::std::string& dir, const ::std::string& prefix, ::std::vector<::std::string>& out_paths, ::std::string& error)
+    {
+        ::std::ifstream is(archive, ::std::ios::binary);
+        if( !is.is_open() ) {
+            error = "cannot open it";
+            return false;
+        }
+        char magic[8];
+        if( !is.read(magic, 8) || ::std::memcmp(magic, "!<arch>\n", 8) != 0 ) {
+            error = "not an `ar` archive (thin archives are not supported)";
+            return false;
+        }
+        ::std::string   gnu_names;  // GNU `//` member: the long names
+        unsigned    n = 0;
+        for(;;)
+        {
+            char hdr[60];
+            if( !is.read(hdr, 60) ) {
+                break;
+            }
+            if( hdr[58] != '`' || hdr[59] != '\n' ) {
+                error = "malformed member header";
+                return false;
+            }
+            auto field = [&](size_t ofs, size_t len) {
+                ::std::string   f(hdr + ofs, len);
+                auto e = f.find_last_not_of(' ');
+                return e == ::std::string::npos ? ::std::string() : f.substr(0, e+1);
+                };
+            auto name = field(0, 16);
+            size_t  size = ::std::strtoul(field(48, 10).c_str(), nullptr, 10);
+            ::std::string   data(size, '\0');
+            if( size > 0 && !is.read(&data[0], size) ) {
+                error = "truncated member";
+                return false;
+            }
+            if( size % 2 == 1 ) {
+                is.ignore(1);
+            }
+
+            if( name.compare(0, 3, "#1/") == 0 ) {
+                // BSD: the name is the start of the data
+                size_t  len = ::std::strtoul(name.c_str() + 3, nullptr, 10);
+                if( len > data.size() ) {
+                    error = "malformed BSD member name";
+                    return false;
+                }
+                name = data.substr(0, len);
+                name = name.substr(0, name.find('\0'));
+                data.erase(0, len);
+            }
+            else if( name == "//" ) {
+                gnu_names = ::std::move(data);
+                continue;
+            }
+            else if( name == "/" || name == "/SYM64/" ) {
+                // GNU symbol table
+                continue;
+            }
+            else if( name.size() > 1 && name[0] == '/' && '0' <= name[1] && name[1] <= '9' ) {
+                size_t  ofs = ::std::strtoul(name.c_str() + 1, nullptr, 10);
+                if( ofs >= gnu_names.size() ) {
+                    error = "malformed GNU member name";
+                    return false;
+                }
+                name = gnu_names.substr(ofs, gnu_names.find('\n', ofs) - ofs);
+            }
+            if( !name.empty() && name.back() == '/' ) {
+                name.pop_back();
+            }
+            // BSD symbol tables
+            if( name.compare(0, 9, "__.SYMDEF") == 0 ) {
+                continue;
+            }
+            auto slash = name.find_last_of("/\\");
+            if( slash != ::std::string::npos ) {
+                name = name.substr(slash+1);
+            }
+
+            auto path = dir + "/" + prefix + "-" + ::std::to_string(n++) + "-" + name;
+            ::std::ofstream os(path, ::std::ios::binary);
+            os.write(data.data(), data.size());
+            if( !os.good() ) {
+                error = "cannot write " + path;
+                return false;
+            }
+            out_paths.push_back(::std::move(path));
+        }
+        return true;
+    }
 }
 
