From 517a663a2a918bf9756dd24366110b42ee423769 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 15:17:49 +0000
Subject: [PATCH 298/300] expand: an attribute proc macro's input leaves out
 items already removed

cyclonedx-bom 0.8.1 (py314-maturin, after object) src/specs/common/bom.rs:20
`#[versioned("1.3", "1.4", "1.5")] pub(crate) mod base { .. #[cfg(test)]
pub(crate) mod test { .. } }` died with the macro's compile_error:
"cannot parse module: unexpected end of input, expected one of: `fn`,
`extern`, `use`, `static`, .. while using the `#[versioned]` macro" (syn).

Expand_Mod_Early turns every `#[cfg]`-failed item into Item::None (attributes
kept) before any macro runs, and the parser leaves a `#[cfg]`-disabled
`mod x;` it never loaded the same way. The proc-macro input visitor sent such
an item's attributes and then nothing for the item, so the module's last item
reached syn as a bare `#[cfg(test)]` before the closing `}`; an earlier one
would have attached its attributes to the next item (and removed it).

visit_named_item and the trait/impl item loops now send nothing for a None
item. rustc sends the item as written and strips it from the macro's output;
mrustc has already dropped it, so leaving it out of the input is the
equivalent (a macro counting cfg'd-out items would see the difference).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 8c663b72..970d4bcb 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -1838,6 +1838,10 @@ namespace {
             const auto item_vis = ::AST::Visibility::make_bare_private();
             for(const auto& i : trait.items())
             {
+                // Removed (e.g. by `#[cfg]`): nothing to send, attributes included (see visit_named_item)
+                if( i.data.is_None() ) {
+                    continue;
+                }
                 this->visit_attrs(i.attrs);
                 TU_MATCH_HDRA((i.data), {)
                 default:
@@ -1878,6 +1882,10 @@ namespace {
             {
                 const auto& sp = i.sp;
                 const auto& item = *i.data;
+                // Removed (e.g. by `#[cfg]`): nothing to send, attributes included (see visit_named_item)
+                if( item.is_None() ) {
+                    continue;
+                }
                 // The item's own attributes (`#[inline]`, `#[cfg(..)]`) are part of the impl's tokens, as for trait
                 // and module items
                 this->visit_attrs(i.attrs);
@@ -1917,6 +1925,17 @@ namespace {
         /// An item with its own attributes (a `$i:item` fragment, an item in a module)
         void visit_named_item(const AST::Named<AST::Item>& i)
         {
+            // An item already removed keeps its attributes (Expand_Mod_Early: a failed `#[cfg]`, before any macro runs;
+            // the parser: a `#[cfg]`-disabled `mod x;` it never loaded). Sending those attributes alone attaches them to
+            // the next item or leaves them dangling before the closing `}`.
+            // - cyclonedx-bom 0.8.1 specs/common/bom.rs `#[versioned("1.3", "1.4", "1.5")] pub(crate) mod base { ..
+            //   #[cfg(test)] pub(crate) mod test { .. } }`: syn "cannot parse module: unexpected end of input, expected
+            //   one of: `fn`, `extern`, `use`, .. while using the `#[versioned]` macro"
+            // (rustc sends the item as written and strips it from the macro's output; mrustc has already dropped it)
+            if( i.data.is_None() ) {
+                DEBUG("Skip removed item " << i.name);
+                return;
+            }
             this->visit_attrs(i.attrs);
             this->visit_item(i.name, i.vis, i.data);
         }
