From 4fadb6a15b6b99979d9b13011f3151e21e7d422b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 2 Oct 2026 02:38:57 +0000
Subject: [PATCH] hir_typeck: pick a lone Sized generic/opaque coercion target
 in ivar fallback

check_ivar_poss refuses to pick an ivar's only coercion target when that
target came from an unsize check ("HACK: Work around failure in librustc"),
in case the ivar is really something that unsizes to it. If nothing else
resolves the ivar, a later fallback (e.g. a `*const _ as *const U` cast
equating the pointees) can then bind it to an unrelated type.

A generic parameter or an opaque associated type that is known Sized can't
be an unsize target, so pick it. rustc unifies in this situation too.
Concrete target types keep the old behaviour.

Hit by bytemuck 1.23-1.25 checked::try_cast_slice:
    let pod = crate::try_cast_slice(a)?;            // &[_]
    pod.iter().all(|pod| <B as CheckedBitPattern>::is_valid_bit_pattern(pod))
    ... pod.as_ptr() as *const B ...
The closure argument's only target was `&<B as CheckedBitPattern>::Bits`,
it was skipped, and the cast fallback bound the slice element to `B`:
"Type mismatch between <B as CheckedBitPattern>::Bits and B".

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 30e9c0c3..acc6f427 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -7740,6 +7740,15 @@ namespace
                         context.equate_types(sp, ty_l, new_ty);
                         return true;
                     }
+                    else if( (new_ty.data().is_Generic() || TU_TEST1(new_ty.data(), Path, .binding.is_Opaque()))
+                        && context.m_resolve.type_is_sized(sp, new_ty) == ::HIR::Compare::Equal )
+                    {
+                        // An unsize can only target a DST, so a Sized generic/opaque associated type can't be one.
+                        // With no other information left, rustc would unify here too (e.g. `&_ := &<B as Tr>::Assoc`)
+                        DEBUG("Picking " << new_ty << " as the only target (Sized generic/opaque, can't be an unsize target) [" << possible_tys << "]");
+                        context.equate_types(sp, ty_l, new_ty);
+                        return true;
+                    }
                     else
                     {
                         // HACK: Work around failure in librustc
