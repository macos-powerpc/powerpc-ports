From 09dc3ef82a0bf4052a36c65bdc3d17a26b87d0b9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 6 Oct 2026 02:43:01 +0000
Subject: [PATCH 84/84] hir_conv: keep a where-clause's `for<'a>` on the supertraits it declares

palette 0.7.5 src/num.rs:

    pub trait Arithmetics
    where
        Self: Add<Output = Self> + .. + Sized,
        for<'a> Self: Add<&'a Self, Output = Self> + Sub<&'a Self, Output = Self> + ..,
    {}

    BUG: ASSERT FAIL: src/hir_typeck/static.cpp:38:g.idx() < hrls.m_lifetimes.size():
    HRL index out of range

A trait's `Self: Trait` where-clauses are supertraits, and Bind collects them into
`m_all_parent_traits`, both for the trait itself and when recursing into a parent
that has no list yet. It cloned the clause's trait path but not the clause's own
binder (`GenericBound::TraitBound::hrtbs`). So `T: Arithmetics` brought in
`T: Add<&'H0 T>` with an empty binder, and matching it against a use
(`a - b` with `b: &T`) indexed a higher-ranked lifetime that didn't exist. The
other spelling, `trait BitOps: for<'a> BitAnd<&'a Self>` (bool_mask.rs), puts
the binder on the path and was fine.

Move the clause's binder onto the collected path's `m_hrtbs` when the path has none
of its own. Rust rejects a binder in both places (E0316), so there's nothing to combine.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_conv/bind.cpp | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/hir_conv/bind.cpp b/src/hir_conv/bind.cpp
index a6ac41b1..0dff1c7c 100644
--- a/src/hir_conv/bind.cpp
+++ b/src/hir_conv/bind.cpp
@@ -884,6 +884,18 @@ namespace {
                 ::std::vector< ::HIR::TraitPath>    supertraits;
                 ::std::vector<const ::HIR::TraitPath*>  tp_stack;
 
+                /// The trait of a `Self: Trait` where-clause, taking the clause's own `for<'a>` binder along: palette 0.7.5
+                /// `trait Arithmetics where for<'a> Self: Add<&'a Self, Output = Self> + ..` (without the binder
+                /// the supertrait's `'a` refers to nothing - "HRL index out of range")
+                static ::HIR::TraitPath bound_trait_path(const ::std::unique_ptr<::HIR::GenericParams>& bound_hrtbs, const ::HIR::TraitPath& tp)
+                {
+                    auto rv = tp.clone();
+                    if( bound_hrtbs && !bound_hrtbs->is_empty() && !(rv.m_hrtbs && !rv.m_hrtbs->is_empty()) ) {
+                        rv.m_hrtbs = box$(bound_hrtbs->clone());
+                    }
+                    return rv;
+                }
+
                 void enum_supertraits_in(const ::HIR::Trait& tr, ::HIR::TraitPath path)
                 {
                     TRACE_FUNCTION_F(path);
@@ -939,7 +951,7 @@ namespace {
                             if( pt.m_path.m_path == path.m_path.m_path )
                                 continue ;
 
-                            enum_supertraits_in(*pt.m_trait_ptr, monomorph_tp(pt));
+                            enum_supertraits_in(*pt.m_trait_ptr, monomorph_tp(bound_trait_path(be.hrtbs, pt)));
                         }
                     }
 
@@ -1045,7 +1057,7 @@ namespace {
                     continue ;
                 }
 
-                e.enum_supertraits_in(*be.trait.m_trait_ptr, be.trait.clone());
+                e.enum_supertraits_in(*be.trait.m_trait_ptr, Enumerate::bound_trait_path(be.hrtbs, be.trait));
             }
 
             ::std::sort(e.supertraits.begin(), e.supertraits.end());
