From 4f0ef5df6c42816805a0b4be025f5e4c1e544729 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 23:35:07 +0000
Subject: [PATCH 143/143] hir_typeck: a cast to an array or tuple type is the
 trivial cast and pins the source type

`([] as [u8; 0])[0]` (http 1.0 - 1.3.1 `HeaderName::from_static`, its MSRV
1.57 way to panic in a const fn): the cast revisit rejected every cast whose
target is an array or tuple, including this trivial one, before the empty
array literal's element type could be inferred from the target:
`Invalid cast [dst]: from [_; 0] to [u8; 0]`.

rustc accepts a cast between identical types for any type (the
`trivial_casts` lint), so when the target is an array or tuple and the source
is one too (or still an inference variable), equate them; anything else is
still rejected. Kit array-cast-test (compile-only, plain and -O).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs.cpp | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 93a518cc..2033db55 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -265,14 +265,28 @@ namespace {
             TU_ARMA(ErasedType, e) {
                 bad_cast(sp, src_ty, tgt_ty, "dst");
                 }
+            // The only cast to an array or tuple is the trivial one (rustc's `trivial_casts` lint), so it just pins
+            // the source type: `([] as [u8; 0])[0]` (http 1.3.1 `HeaderName::from_static`) infers `[u8; 0]` for `[]`.
             TU_ARMA(Array, e) {
-                bad_cast(sp, src_ty, tgt_ty, "dst");
+                if( src_ty.data().is_Array() || src_ty.data().is_Infer() ) {
+                    this->context.equate_types(sp, tgt_ty, src_ty);
+                    this->m_completed = true;
+                }
+                else {
+                    bad_cast(sp, src_ty, tgt_ty, "dst");
+                }
                 }
             TU_ARMA(Slice, e) {
                 bad_cast(sp, src_ty, tgt_ty, "dst");
                 }
             TU_ARMA(Tuple, e) {
-                bad_cast(sp, src_ty, tgt_ty, "dst");
+                if( src_ty.data().is_Tuple() || src_ty.data().is_Infer() ) {
+                    this->context.equate_types(sp, tgt_ty, src_ty);
+                    this->m_completed = true;
+                }
+                else {
+                    bad_cast(sp, src_ty, tgt_ty, "dst");
+                }
                 }
             TU_ARMA(Borrow, e) {
                 // Emit a coercion and delete this revisit
