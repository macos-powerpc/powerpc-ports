From 84f2dce4fb6709d3aa6c2e296ec0ea88ad941470 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 00:16:45 +0000
Subject: [PATCH 34/36] expand: let an expression-position macro continue past
 a block-like expression

rustc parses the expansion of a macro in expression position as ONE
expression, so `if .. {..} else {..} as libc::c_int` (c2rust output, e.g.
unsafe-libyaml 0.2.11's `AS_HEX_AT!`) is a cast of the whole `if`. mrustc
re-parsed the expansion with the statement-line parser, which stops right
after a block-like expression (statement semantics) and then reported
"Unused tokens at the end of macro expansion - TOK_RWORD_AS".

When the expansion is in expression position (`nodes_out == nullptr`), no
`;` was consumed and tokens remain, push the parsed node back as an
interpolated expression and let `Parse_Expr0` consume the operator chain.
A trailing `;` is still tolerated (semicolon_in_expressions_from_macros).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/expand/mod.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/expand/mod.cpp b/src/expand/mod.cpp
index c4519f33..5d117159 100644
--- a/src/expand/mod.cpp
+++ b/src/expand/mod.cpp
@@ -19,6 +19,7 @@
 #include "../resolve/common.hpp"
 #include "proc_macro.hpp"
 #include "../parse/ttstream.hpp"
+#include "../parse/interpolated_fragment.hpp"  // For re-entering the expression parser with a parsed node
 
 // TODO: Respect the crate attribute #![recursion_limit]
 #define MAX_MACRO_RECURSION 256
@@ -884,6 +885,21 @@ struct CExpandExpr:
                 DEBUG("-- Parsing as expression line");
                 auto newexpr = Parse_ExprBlockLine_WithItems(*ttl, local_mod_ptr, add_silence_if_end);
 
+                // Expression position (`nodes_out == nullptr`): rustc parses the whole expansion as ONE
+                // expression, so a block-like leading expression (`if`/`match`/`loop`/`unsafe {}`/`{}`)
+                // may be followed by `as`, a binary operator, `[..]`, `(..)`, ... The statement-line
+                // parser above stops right after the block (statement semantics), so feed what it
+                // produced back in as the leading operand and let the expression parser take the rest.
+                // (c2rust output: unsafe-libyaml's `if .. {..} else {..} as libc::c_int` macros)
+                if( !nodes_out && newexpr && !add_silence_if_end && ttl->lookahead(0) != TOK_EOF )
+                {
+                    DEBUG("-- Trailing tokens in expression position, continuing as an expression");
+                    ttl->putback( Token(Token::TagTakeIP(), InterpolatedFragment(InterpolatedFragment::EXPR, newexpr.release())) );
+                    newexpr = Parse_Expr0(*ttl);
+                    // A trailing `;` is tolerated (rustc's `semicolon_in_expressions_from_macros` back-compat)
+                    ttl->getTokenIf(TOK_SEMICOLON);
+                }
+
                 if( tmp_local_mod )
                     TODO(node.span(), "Handle edge case where a macro expansion outside of a _Block creates an item");
 
