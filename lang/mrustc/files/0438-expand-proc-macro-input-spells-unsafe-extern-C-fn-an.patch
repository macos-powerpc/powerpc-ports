From 509316ff13b6fe82929fe6e151479a75f4e2b3a7 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 5 Nov 2026 23:48:36 +0000
Subject: [PATCH] expand: proc-macro input spells `unsafe extern "C" fn`,
 and `const async unsafe` on items

pwd-grp 1.0.2 (arti 2.7.0) src/lmockable.rs:74: `#[derive(Deftly)]` on
`struct MockableLibcFunctions { sysconf: unsafe extern "C" fn(c_int) ->
c_long, .. }` fails with "compile_error! expected `fn`".

The proc-macro serialiser prints a bare function type with the TypeRef
printer and re-lexes the text, and that printer wrote the qualifiers as
`extern "C" unsafe fn(..)`; syn reads `extern "C"`, wants `fn`, and finds
`unsafe`. Rust's order is `unsafe extern "C" fn`. The same visitor wrote
a function item's qualifiers as `unsafe const async extern`, where the
grammar (and syn) have `const async unsafe extern`.

Both now follow the grammar. The TypeRef printer is also what
`stringify!` of a type fragment prints.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/ast/types.cpp b/src/ast/types.cpp
index 5821e28c..7acbe864 100644
--- a/src/ast/types.cpp
+++ b/src/ast/types.cpp
@@ -288,10 +288,11 @@ void TypeRef::print(::std::ostream& os, bool is_debug/*=false*/) const
         )
     TU_ARM(m_data, Function, ent) {
         os << ent.info.hrbs;
-        if( ent.info.m_abi != "" )
-            os << "extern \"" << ent.info.m_abi << "\" ";
+        // Rust's order (`unsafe extern "C" fn`): the text is re-lexed as proc-macro input
         if(ent.info.is_unsafe)
             os << "unsafe ";
+        if( ent.info.m_abi != "" )
+            os << "extern \"" << ent.info.m_abi << "\" ";
         os << "fn(";
         for( const auto& arg : ent.info.m_arg_types )
         {
diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 7a255ae4..cf4361e5 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -1809,15 +1809,16 @@ namespace {
         {
             this->visit_vis(vis);
 
-            if( fcn.is_unsafe() ) {
-                m_pmi.send_rword("unsafe");
-            }
+            // Rust's order: `const async unsafe extern "C" fn` (syn stops at anything else with "expected `fn`")
             if( fcn.is_const() ) {
                 m_pmi.send_rword("const");
             }
             if( fcn.is_async() ) {
                 m_pmi.send_rword("async");
             }
+            if( fcn.is_unsafe() ) {
+                m_pmi.send_rword("unsafe");
+            }
             if( fcn.abi() != ABI_RUST ) {
                 m_pmi.send_rword("extern");
                 m_pmi.send_string(fcn.abi());
