From 59ffca36d30aef3027e87bc3c8a89030d9b8566d Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 17:14:52 +0000
Subject: [PATCH 371/372] hir_typeck: a trait object's supertrait keeps its own
 `for<..>` binder in impl lookups

figment 0.10.19 (gitu 0.43.0), `(self.interpolater)(profile, &keys)` on `Box<dyn Interpolator>` where
`trait Interpolator: Fn(&Profile, &[&str]) -> String + Send + Sync + 'static`:
    <null> BUG: ASSERT FAIL: src/hir_typeck/helpers.cpp:41:g.idx() < hrls.m_lifetimes.size():
    HRL index out of range - /*H:0*/ with
The supertrait path carries its own binder (the elided Fn-sugar lifetimes, or an explicit `for<'a>` as in
providers/env.rs FilterMap). The TraitObject arm of find_trait_impls_magic matched the supertrait's params
against the trait OBJECT's binder, which `dyn Interpolator` does not have; its ErasedType arm already fell back
to the supertrait's binder. StaticTraitResolve's TraitObject arm had the same gap: its callback only sees the
params, so it looks the matching parent up in the trait's m_all_parent_traits.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index 61c63b9a..58e5c452 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -1992,7 +1992,12 @@ bool TraitResolution::find_trait_impls(const Span& sp,
                         for(const auto& e : i_tp.m_type_bounds)
                             assoc_clone.insert( ::std::make_pair(e.first, e.second.clone()) );
                         ASSERT_BUG(sp, !e.m_trait.m_hrtbs || !i_tp.m_hrtbs, "TODO: Handle two layers of HRTBs - " << e.m_trait << " and " << i_tp);
-                        auto hrls = get_hrls(sp, e.m_trait.m_hrtbs, i_tp.m_path.m_params, params);
+                        // The supertrait path's own binder declares the HRLs in its params (`trait Tr: Fn(&A) -> B`
+                        // as `dyn Tr`, figment's `Box<dyn Interpolator>`), same as the ErasedType arm below
+                        auto hrls = e.m_trait.m_hrtbs
+                            ? get_hrls(sp, e.m_trait.m_hrtbs, i_tp.m_path.m_params, params)
+                            : get_hrls(sp, i_tp.m_hrtbs      , i_tp.m_path.m_params, params)
+                            ;
                         auto ir = ImplRef(std::move(hrls), type.clone(), i_tp.m_path.m_params.clone(), mv$(assoc_clone));
                         DEBUG("TraitObject: - ir = " << ir);
                         is_supertrait = true;
diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index 60f78822..ea31ec9c 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -468,7 +468,18 @@ bool StaticTraitResolve::find_impl(
             [&](const HIR::PathParams& i_params, ::HIR::TraitPath::assoc_list_t i_assoc)->bool {
                 
                 // Match the input trait params and the output trait params, to resolve HRLs
-                MatchHrls   match_hrls { e.m_trait.m_hrtbs ? *e.m_trait.m_hrtbs : empty_params };
+                // - Declared by the trait object's binder, or by the supertrait path's own one (`trait Tr: Fn(&A) -> B`
+                //   as `dyn Tr`, figment's `Box<dyn Interpolator>`)
+                const ::HIR::GenericParams* hrbs = e.m_trait.m_hrtbs.get();
+                if( !hrbs ) {
+                    for(const auto& pt : e.m_trait.m_trait_ptr->m_all_parent_traits) {
+                        if( pt.m_path.m_path == trait_path && pt.m_hrtbs ) {
+                            hrbs = pt.m_hrtbs.get();
+                            break;
+                        }
+                    }
+                }
+                MatchHrls   match_hrls { hrbs ? *hrbs : empty_params };
                 i_params.match_test_generics_fuzz(sp, *trait_params, HIR::ResolvePlaceholdersNop(), match_hrls);
 
                 // Invoke callback with a proper ImplRef
