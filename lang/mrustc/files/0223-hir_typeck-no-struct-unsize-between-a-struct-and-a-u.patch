From 87a5a4ed9e396c22aa1e247fb336edacfa711bbb Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 12:47:11 +0000
Subject: [PATCH] hir_typeck: no struct unsize between a struct and a union,
 enum or extern type

can_unsize (StaticTraitResolve and TraitResolution) handled two path types
as a struct unsize as soon as either side was a struct that can be unsized,
then took the destination's binding as a struct. servo_arc 0.4.3 lib.rs:325
(ani-cli-rs 0.11.0):

    pub fn heap_ptr(&self) -> *const c_void {
        self.p.as_ptr() as *const ArcInner<T> as *const c_void
    }

`ArcInner<T: ?Sized>` can be unsized and `c_void` is an enum. Lower MIR
asks can_unsize whether a pointer cast makes a fat pointer:

    Assertion failed: (m_tag == TAG_Struct), function as_Struct, file src/hir/type.hpp, line 111.

A struct unsize is only between two instances of one struct, so if either
side is not a struct the answer is now "no". The typecheck copy had the same
hole (not reached by this shape: the coercion code rejects it first).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/helpers.cpp | 7 +++++++
 src/hir_typeck/static.cpp  | 7 +++++++
 2 files changed, 14 insertions(+)

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index 1bdf6e2c..090ce904 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -4683,6 +4683,13 @@ bool TraitResolution::trait_contains_type(const Span& sp, const ::HIR::GenericPa
         if( dst_is_unsizable || src_is_unsizable )
         {
             DEBUG("Struct unsize? " << dst_ty << " <- " << src_ty);
+            // Only between two instances of one struct: the other side can be a union, enum or extern type
+            // (`*const ArcInner<T> as *const c_void` in servo_arc 0.4.3)
+            if( !dst_ty.data().as_Path().binding.is_Struct() || !src_ty.data().as_Path().binding.is_Struct() )
+            {
+                DEBUG("Can't Unsize, one side isn't a struct");
+                return ::HIR::Compare::Unequal;
+            }
             const auto& str = *dst_ty.data().as_Path().binding.as_Struct();
             const auto& dst_gp = dst_ty.data().as_Path().path.m_data.as_Generic();
             const auto& src_gp = src_ty.data().as_Path().path.m_data.as_Generic();
diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index 430c37ef..8350adf6 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -2809,6 +2809,13 @@ bool StaticTraitResolve::can_unsize(const Span& sp, const ::HIR::TypeRef& dst_ty
         if( dst_is_unsizable || src_is_unsizable )
         {
             DEBUG("Struct unsize? " << dst_ty << " <- " << src_ty);
+            // Only between two instances of one struct: the other side can be a union, enum or extern type
+            // (`*const ArcInner<T> as *const c_void` in servo_arc 0.4.3)
+            if( !dst_ty.data().as_Path().binding.is_Struct() || !src_ty.data().as_Path().binding.is_Struct() )
+            {
+                DEBUG("Can't Unsize, one side isn't a struct");
+                return false;
+            }
             const auto& str = *dst_ty.data().as_Path().binding.as_Struct();
             const auto& dst_gp = dst_ty.data().as_Path().path.m_data.as_Generic();
             const auto& src_gp = src_ty.data().as_Path().path.m_data.as_Generic();
