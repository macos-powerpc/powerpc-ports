From 3027997eb9708f4071d63e447abce6fbd053f2ab Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 16:15:14 +0000
Subject: [PATCH] expand: format_args! keeps a precision of 0, and `{:x?}` its
 hex flag

FmtArgs used `prec == 0` for "no precision", so `{:.0}`, `{:.0?}`, `{:8.0}`
and `{:.0e}` lost the precision: `format!("{:.0?}", 2.0f64)` gave "2.0",
not "2". A spec that set nothing else was even taken as a plain `{}`/`{:?}`.
And FmtArgs' `!=` skipped the debug-hex kind, so a lone `{:x?}`/`{:X?}`
also counted as plain and printed decimal. orz 1.6.2 build.rs:

    write!(File::create(out_dir.join("SYMRANK_NEXT_ARRAY.txt"))?, "{:.0?}", [
        vec![0.0; 2], (2 .. SYMRANK_NUM_SYMBOLS).map(..).collect()].concat())?;

wrote float literals, which symrank.rs include!s as `[u16; N]`:

    error:0: Type unificiation of float literal with non-float - u16

A precision is now recorded as given whenever the spec has a `.`, and
`!=` compares the debug-hex kind and that flag.

Only the expansion of these specs changes. library/{core,alloc,std,
proc_macro} 1.90 use none of them outside tests, so libstd needs no
rebuild; crates that print with them do.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/expand/format_args.cpp | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/expand/format_args.cpp b/src/expand/format_args.cpp
index d080c66a..3d02972c 100644
--- a/src/expand/format_args.cpp
+++ b/src/expand/format_args.cpp
@@ -50,6 +50,8 @@ namespace {
         bool width_is_arg = false;
         unsigned int width = 0;
 
+        /// A precision was given (`prec` 0 is a precision too: `{:.0}` prints `2.5f64` as `2`)
+        bool has_prec = false;
         bool prec_is_arg = false;
         unsigned int prec = 0;
 
@@ -61,8 +63,10 @@ namespace {
             CMP(sign);
             CMP(alternate);
             CMP(zero_pad);
+            CMP(debug_ty);
             CMP(width_is_arg);
             CMP(width);
+            CMP(has_prec);
             CMP(prec_is_arg);
             CMP(prec);
             return false;
@@ -87,7 +91,7 @@ namespace {
             if(x.zero_pad) os << "0";
             os << ")";
             os << "Width(" << (x.width_is_arg ? "$" : "") << x.width << ")";
-            os << "Prec(" << (x.prec_is_arg ? "$" : "") << x.prec << ")";
+            if(x.has_prec) os << "Prec(" << (x.prec_is_arg ? "$" : "") << x.prec << ")";
             return os;
         }
     };
@@ -396,6 +400,7 @@ namespace {
                     // Precision
                     if( *s == '.' ) {
                         s ++;
+                        args.has_prec = true;
                         // '*' - Use next argument
                         if( *s == '*' ) {
                             args.prec_is_arg = true;
@@ -441,6 +446,7 @@ namespace {
                             }
                             else {
                                 s = start;
+                                args.has_prec = false;
                                 //ERROR(sp, E0000, "Unexpected character in precision");
                             }
                         }
@@ -876,7 +882,7 @@ namespace {
                             if( frag.args.width_is_arg || frag.args.width != 0 ) {
                                 flags |= 1 << 27;
                             }
-                            if( frag.args.prec_is_arg || frag.args.prec != 0 ) {
+                            if( frag.args.has_prec ) {
                                 flags |= 1 << 28;
                             }
 
@@ -921,7 +927,7 @@ namespace {
                         };
 
                         push_toks(toks, ident("precision"), TOK_COLON );
-                        if( frag.args.prec_is_arg || frag.args.prec != 0 ) {
+                        if( frag.args.has_prec ) {
                             push_path_count("Is");
                             push_toks(toks, TOK_PAREN_OPEN);
                             if( frag.args.prec_is_arg ) {
