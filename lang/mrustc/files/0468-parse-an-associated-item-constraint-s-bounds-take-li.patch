diff --git a/src/parse/paths.cpp b/src/parse/paths.cpp
index 321cf6f9..07b6b278 100644
--- a/src/parse/paths.cpp
+++ b/src/parse/paths.cpp
@@ -297,11 +297,16 @@ AST::Path Parse_Path(TokenStream& lex, bool is_abs, eParsePathGenericMode generi
                     // TODO: Trait list instead of duplicating the name
                     for(;;)
                     {
-                        // In parentheses, as any trait bound (see Parse_TypeBound): `Iterator<Item: (Tr)>`
-                        bool is_paren = lex.getTokenIf(TOK_PAREN_OPEN);
-                        traits.push_back( Parse_Path(lex, PATH_GENERIC_TYPE) );
-                        if( is_paren ) {
-                            GET_CHECK_TOK(tok, lex, TOK_PAREN_CLOSE);
+                        if( lex.getTokenIf(TOK_LIFETIME) ) {
+                            // A lifetime bound (`Iterator<Item: 'static>`) is not kept: lifetimes are not checked
+                        }
+                        else {
+                            // In parentheses, as any trait bound (see Parse_TypeBound): `Iterator<Item: (Tr)>`
+                            bool is_paren = lex.getTokenIf(TOK_PAREN_OPEN);
+                            traits.push_back( Parse_Path(lex, PATH_GENERIC_TYPE) );
+                            if( is_paren ) {
+                                GET_CHECK_TOK(tok, lex, TOK_PAREN_CLOSE);
+                            }
                         }
                         if(lex.lookahead(0) != TOK_PLUS)
                             break;
@@ -311,7 +316,9 @@ AST::Path Parse_Path(TokenStream& lex, bool is_abs, eParsePathGenericMode generi
                             break;
                         }
                     }
-                    rv.m_entries.push_back( ::std::make_pair( mv$(n), std::move(traits) ) );
+                    if( !traits.empty() ) {
+                        rv.m_entries.push_back( ::std::make_pair( mv$(n), std::move(traits) ) );
+                    }
                 }
                 else {
                     throw "Unreachable";
