From 32d5dfaa471e24a00393cb749358e62634087962 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 16 Oct 2026 23:33:44 +0000
Subject: [PATCH 273/274] minicargo: requested `dep/feature` features turn on
 the dependency's feature

maturin passes the features of `[tool.maturin] features` to cargo, typically
`--features pyo3/extension-module`. minicargo expanded `<dep>/<feature>` only inside
a package's own feature lists: a requested one (command line, or a dependency
declaration's `features = [..]`) was activated as a feature of that name, so the
dependency never got `extension-module` and the package got a bogus
`feature="pyo3/extension-module"` cfg.

set_features now runs every requested feature through the same expansion as the
entries of a feature list (`<dep>/<feature>` enables the dependency and its feature,
`<dep>?/<feature>` only the feature).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tools/minicargo/manifest.cpp | 79 ++++++++++++++++++++----------------
 1 file changed, 44 insertions(+), 35 deletions(-)

diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index 9f394937..c900cc97 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -1359,27 +1359,57 @@ void PackageManifest::set_features(const ::std::vector<::std::string>& features,
         DEBUG("Including default features [" << m_default_features << "]");
         add_feature(::std::string("default"));
     }
+    auto iter_all_deps = [&](std::function<void(PackageRef&)> cb) {
+        iter_dep_groups([&](const Dependencies& dg_c) {
+            Dependencies& dg = const_cast<Dependencies&>(dg_c);
+            for(auto& dep : dg.main)
+                cb(dep);
+            for(auto& dep : dg.build)
+                cb(dep);
+            for(auto& dep : dg.dev)
+                cb(dep);
+        });
+    };
+    // `<dep>/<feature>` (`<dep>?/<feature>`: only if the dependency is enabled otherwise): a dependency's feature,
+    // from a feature list or requested directly - as maturin does (`--features pyo3/extension-module`), or a dependency
+    // declaration's `features = [..]`. Returns false for a plain feature name.
+    auto activate_dep_feature = [&](const ::std::string& sub_feat)->bool {
+        auto slash_pos = sub_feat.find('/');
+        if( slash_pos == ::std::string::npos ) {
+            return false;
+        }
+        ::std::string depname = sub_feat.substr(0, slash_pos);
+        bool enable_optional = true;
+        if( depname.back() == '?' ) {
+            depname.pop_back();
+            enable_optional = false;
+        }
+        else {
+            add_feature(depname);
+        }
+        ::std::string depfeat = sub_feat.substr(slash_pos+1);
+        DEBUG("Activate feature '" << depfeat << "' from dependency '" << depname << "'");
+        iter_all_deps([&](PackageRef& dep) {
+            if(dep.m_key == depname) {
+                dep.m_optional_enabled |= enable_optional;
+                dep.m_features.push_back(depfeat);
+                // TODO: Does this need to call `set_features` again?
+            }
+            });
+        return true;
+    };
+
     for(const auto& feat : features)
     {
-        add_feature(feat);
+        if( !activate_dep_feature(feat) ) {
+            add_feature(feat);
+        }
     }
 
     for(size_t i = start; i < m_active_features.size(); i ++)
     {
         const auto featname = m_active_features[i];
 
-        auto iter_all_deps = [&](std::function<void(PackageRef&)> cb) {
