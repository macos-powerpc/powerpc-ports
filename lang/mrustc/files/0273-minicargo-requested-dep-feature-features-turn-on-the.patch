         // Look up this feature
         // NOTE: `default` is stored separately, but can be requested by name (a parent crate's
         // `dep/default` with `default-features = false`, or `--features default`) - expand it too
@@ -1396,28 +1426,7 @@ void PackageManifest::set_features(const ::std::vector<::std::string>& features,
             DEBUG("Activating feature " << featname << " = [" << *feat_list << "]");
             for(const auto& sub_feat : *feat_list)
             {
