From 9b17f55c36b174f8230e9306dfd345e65228a97f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 16:59:41 +0000
Subject: [PATCH 66/66] trans: emit a function pointer typedef's own
 function-pointer types first

A C function pointer typedef spells out its argument and return types,
so any function pointer type among them must already have its typedef.
The type emission order only guarantees forward declarations at that
point, which is enough for the struct that an `Option<extern "C"
fn(..)>` argument used to be written as. Since the C ABI scalar
conversion (0043), that argument is written as the inner function type
itself, and that typedef may not have been emitted yet. onig_sys 69.9.1
(src/ffi.rs) has a callback that takes a callback:

    pub apply_all_case_fold: Option<unsafe extern "C" fn(
        flag: OnigCaseFoldType, f: OnigApplyAllCaseFoldFunc, arg: *mut c_void) -> c_int>

    libonig_sys-69_9_1.rlib.c:369:129: error: unknown type name 't_ZRTFue1C4CePuCeCfPuG2cE9core0_0_03ffi6c_void0gCf'

Before writing a function pointer typedef, emit the typedef of every
function pointer type used in its signature (in the form the signature
actually uses: scalarised or not). `emit_type_fn` already keeps a set
of emitted types, so the later planned emission of the inner type is
a no-op.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/trans/codegen_c.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 99d2e96b..c772ba94 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -1938,6 +1938,22 @@ namespace {
             // Scalarised C ABI signature (see `get_cabi_scalar`), calls through these pointers convert
             CAbiSig cabi;
             bool use_cabi = get_cabi_sig_fnptr(cabi, te);
+            // The argument and return types are written in full, so a function pointer among them needs its typedef
+            // first. The type walker only guarantees forward declarations here, and a scalarised `Option<extern "C"
+            // fn(..)>` argument names the inner function type directly instead of the enum's struct.
+            // - onig_sys 69.9.1: `OnigEncodingTypeST::apply_all_case_fold` takes an `OnigApplyAllCaseFoldFunc`
+            {
+                auto emit_fn_dep = [&](const ::HIR::TypeRef& t) {
+                    if( t.data().is_Function() ) {
+                        emit_type_fn(t);
+                        m_of << "\n";
+                    }
+                    };
+                emit_fn_dep( (use_cabi && cabi.ret) ? *cabi.ret : te.m_rettype );
+                for(unsigned int i = 0; i < te.m_arg_types.size(); i ++) {
+                    emit_fn_dep( (use_cabi && cabi.args[i]) ? *cabi.args[i] : te.m_arg_types[i] );
+                }
+            }
             m_of << "typedef ";
             // TODO: ABI marker, need an ABI enum?
             if( te.m_rettype == ::HIR::TypeRef::new_unit() )
