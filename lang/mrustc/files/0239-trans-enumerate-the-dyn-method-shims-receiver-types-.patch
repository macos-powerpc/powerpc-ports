+::HIR::TypeRef Trans_AutoImpls_DynMethodUnitReceiver(const StaticTraitResolve& resolve, const ::HIR::Path& path)
+{
+    static Span sp;
+    const auto& pe = path.m_data.as_UfcsKnown();
+    const auto& trait_path = pe.trait;
+    const auto& trait = resolve.m_crate.get_trait_by_path(sp, trait_path.m_path);
+    const auto& fcn_def = trait.m_values.at(pe.item).as_Function();
+    auto pp = fcn_def.m_params.make_nop_params(1, true);
+    switch(fcn_def.m_receiver)
+    {
+    case HIR::Function::Receiver::Value:
+    case HIR::Function::Receiver::BorrowOwned:
+        return ::HIR::TypeRef::new_borrow(HIR::BorrowType::Owned, ::HIR::TypeRef::new_unit());
+    case HIR::Function::Receiver::BorrowUnique:
+        return ::HIR::TypeRef::new_borrow(HIR::BorrowType::Unique, ::HIR::TypeRef::new_unit());
+    case HIR::Function::Receiver::BorrowShared:
+        return ::HIR::TypeRef::new_borrow(HIR::BorrowType::Shared, ::HIR::TypeRef::new_unit());
+    case HIR::Function::Receiver::Box: {
+        // `Box<dyn ThisTrait, A>` into `Box<(), A>`
+        MonomorphStatePtr   ms(&pe.type, &trait_path.m_params, &pp);
+        auto self_ty = ms.monomorph_type(sp, fcn_def.m_args.front().second);
+        resolve.expand_associated_types(sp, self_ty);
+        ASSERT_BUG(sp, self_ty.data().is_Path(), path << " - self: " << self_ty);
+        auto gpath = self_ty.data().as_Path().path.m_data.as_Generic().clone();
+        gpath.m_params.m_types.at(0) = ::HIR::TypeRef::new_unit();
+        return HIR::TypeRef::new_path(mv$(gpath), self_ty.data().as_Path().binding.clone());
+        }
+    case HIR::Function::Receiver::Custom: {
+        // `self: Pin<&mut Self>` (Future::poll) and other wrappers, with `Self = ()` (as hir_expand/vtable.cpp clone_self_cb)
+        static const HIR::TypeRef ty_unit = HIR::TypeRef::new_unit();
+        MonomorphStatePtr   ms_unit(&ty_unit, &trait_path.m_params, &pp);
+        auto ty = ms_unit.monomorph_type(sp, fcn_def.m_args.front().second);
+        resolve.expand_associated_types(sp, ty);
+        return ty;
+        }
+    default:
+        TODO(sp, "Handle different receiver types: " << path << " - self: " << fcn_def.m_args.front().second);
+    }
+}
+
