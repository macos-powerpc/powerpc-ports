From 9e8c9f03d22414dd34b2fe7c0e2fa8ab5c8b2a1c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 06:43:46 +0000
Subject: [PATCH] mir: a byte-string pattern against `&[u8; N]` matches element
 by element

imagesize 0.15.0 src/container/dds.rs:68 (fselect 0.10.3):

    let compression = match &fourcc {
        b"DXT1" => DdsCompression::Bc1,
        ..
        [0, 0, 0, 0] => { .. }
        _ => DdsCompression::Unknown,
    };

    BUG: from_hir_match.cpp:3551: Field path mismatch, .*.0 != .*

Match lowering compares a match's arms rule by rule. Through `&`,
a byte-string pattern became one whole-value rule at `.*`. An array
pattern (and `_`) on `[u8; N]` gives one rule per element at `.*.0`,
`.*.1`, and so on. Mixing the two in one match tripped the field-path
assert, or "Arm 1 size doesn't match" with the array arm first.
A byte string with only `_` arms happened to work.

Against an array of known size, a byte string now gives one `u8` value
rule per element, as `[b'D', b'X', b'T', b'1']` would. Byte strings
against `&[u8]` slices keep the whole-value rule (their arms are
`Slice` rules of their own).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/mir/from_hir_match.cpp b/src/mir/from_hir_match.cpp
index 0561d765..7326d9d5 100644
--- a/src/mir/from_hir_match.cpp
+++ b/src/mir/from_hir_match.cpp
@@ -2138,6 +2138,20 @@ void PatternRulesetBuilder::append_from(const Span& sp, const ::HIR::Pattern& pa
                 const auto& s = pe.val.as_String();
                 this->push_rule( PatternRule::make_Value(s) );
             }
+            // `b"DXT1"` against `&[u8; 4]`: one value rule per element, as the array pattern `[b'D', ..]` (or `_`) gives,
+            // since a match's arms are compared rule by rule
+            // - imagesize 0.15.0 container/dds.rs:68: `match &fourcc { b"DXT1" => .., [0, 0, 0, 0] => .., _ => .. }`
+            //   -> "Field path mismatch, .*.0 != .*" (or "Arm 1 size mismatch" with the array arm first)
+            else if( pe.val.is_ByteString() && e.inner.data().is_Array() && e.inner.data().as_Array().size.is_Known() ) {
+                const auto& s = pe.val.as_ByteString().v;
+                ASSERT_BUG(sp, e.inner.data().as_Array().size.as_Known() == s.size(), "Byte string length mismatch - " << ty << " with " << pat);
+                m_field_path.push_back(0);
+                for(auto c : s) {
+                    this->push_rule( PatternRule::make_Value( ::MIR::Constant::make_Uint({ U128(static_cast<uint8_t>(c)), ::HIR::CoreType::U8 }) ) );
+                    m_field_path.back() ++;
+                }
+                m_field_path.pop_back();
+            }
             else if( pe.val.is_ByteString() ) {
                 const auto& s = pe.val.as_ByteString().v;
                 ::std::vector<uint8_t>  data;
