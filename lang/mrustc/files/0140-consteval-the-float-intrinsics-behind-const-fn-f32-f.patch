From 7da056109c87806e6f866d8d7345af2f008282ba Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 20:42:20 +0000
Subject: [PATCH 140/141] consteval: the float intrinsics behind `const fn`
 f32/f64 methods

moxcms 0.8.1 (skim 5.7.3) evaluates `Matrix3f::inverse` in a `const`,
reaching `.abs()`: "MIR TODO: <f64>::abs .. Call intrinsic fabsf64".
`f64::abs`, `copysign`, `floor`, `ceil`, `trunc`, `round`,
`round_ties_even`, `sqrt`, `minimum`/`maximum` (`minnum`/`maxnum`) and
`mul_add` are `const fn` since 1.85; their intrinsics are now evaluated
with <cmath>, in single precision for the f32 forms.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_conv/constant_evaluation.cpp | 44 ++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index 51d958dd..611c7dfc 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -3036,6 +3036,50 @@ namespace HIR {
                 else if( te->name == "is_val_statically_known" ) {
                     dst.write_uint(state, 8, e.args.at(0).is_Constant() || e.args.at(0).is_Borrow());
                 }
+                // Float intrinsics behind `const fn` methods (`f64::abs`/`copysign`/`floor`/.. since 1.85): moxcms 0.8.1
+                // (skim 5.7.3) evaluates `Matrix3f::inverse` -> `determinant` -> `.abs()` in a `const`
+                else if( te->name == "fabsf32" || te->name == "fabsf64"
+                      || te->name == "copysignf32" || te->name == "copysignf64"
+                      || te->name == "floorf32" || te->name == "floorf64"
+                      || te->name == "ceilf32" || te->name == "ceilf64"
+                      || te->name == "truncf32" || te->name == "truncf64"
+                      || te->name == "roundf32" || te->name == "roundf64"
+                      || te->name == "round_ties_even_f32" || te->name == "round_ties_even_f64"
+                      || te->name == "sqrtf32" || te->name == "sqrtf64"
+                      || te->name == "minnumf32" || te->name == "minnumf64"
+                      || te->name == "maxnumf32" || te->name == "maxnumf64"
+                      || te->name == "fmaf32" || te->name == "fmaf64" )
+                {
+                    std::string base(te->name.c_str());
+                    unsigned bits = (base.back() == '2') ? 32 : 64;    // "..f32" / "..f64"
+                    base.resize(base.size() - 3);
+                    if( !base.empty() && base.back() == '_' ) {
+                        base.pop_back();    // round_ties_even_
+                    }
+                    double a = local_state.read_param_float(bits, e.args.at(0));
+                    double r;
+                    if( base == "fabs" )        r = std::fabs(a);
+                    else if( base == "floor" )  r = std::floor(a);
+                    else if( base == "ceil" )   r = std::ceil(a);
+                    else if( base == "trunc" )  r = std::trunc(a);
+                    else if( base == "round" )  r = std::round(a);       // half away from zero, as Rust's `round`
+                    else if( base == "round_ties_even" )    r = std::nearbyint(a); // default rounding mode: ties to even
+                    else if( base == "sqrt" )   r = std::sqrt(a);
+                    else {
+                        double b = local_state.read_param_float(bits, e.args.at(1));
+                        if( base == "copysign" )    r = std::copysign(a, b);
+                        else if( base == "minnum" ) r = (a != a) ? b : (b != b) ? a : std::fmin(a, b);
+                        else if( base == "maxnum" ) r = (a != a) ? b : (b != b) ? a : std::fmax(a, b);
+                        else {
+                            double c = local_state.read_param_float(bits, e.args.at(2));
+                            r = std::fma(a, b, c);
+                        }
+                    }
+                    if( bits == 32 ) {
+                        r = static_cast<float>(r);
+                    }
+                    dst.write_float(state, bits, r);
+                }
                 else if( te->name == "three_way_compare" ) {
                     auto ty = local_state.monomorph_expand(te->params.m_types.at(0));
                     MIR_ASSERT(state, ty.data().is_Primitive(), "`three_way_compare` with non-primitive " << ty);
