From be4f35294bb01dbbd30b86d55628d44c4b107608 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 10:06:29 +0000
Subject: [PATCH 58/59] hir_expand: reborrow a `&mut` in a `let` with a type
 annotation

`let x: &mut T = r;` is a coercion site, so rustc reborrows `r` there
instead of moving it, and `r` stays usable afterwards. mrustc moved it,
and a later use of `r` failed MIR validation. brotli 7.0.0's
`encoder_compress` (src/enc/encode.rs) does

    let output_start = encoded_buffer;
    ...
            let next_out_array: &mut [u8] = output_start;
    ...
        *encoded_size = MakeUncompressedStream(input_start, input_size, output_start);

    MIR ERROR: ..::enc::encode::encoder_compress BB219/2: ensure_valid: Use of non-valid lvalue - _12*

Record on the HIR `let` whether a type was written (typecheck replaces
`m_type` with the inferred type) and reborrow the value in that case. A
`let` without one (or with `_`) still moves, as in rustc.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir/expr.hpp            |  3 +++
 src/hir/from_ast_expr.cpp   | 10 +++++++---
 src/hir_expand/reborrow.cpp |  7 +++++++
 3 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/hir/expr.hpp b/src/hir/expr.hpp
index b1bdcc29..aaf32154 100644
--- a/src/hir/expr.hpp
+++ b/src/hir/expr.hpp
@@ -246,6 +246,9 @@ struct ExprNode_Let:
     ::HIR::Pattern  m_pattern;
     ::HIR::TypeRef  m_type;
     ::HIR::ExprNodeP    m_value;
+    /// The type was written in the source (`let x: T = v;`), making `v` a coercion site - so a `&mut` is reborrowed
+    /// instead of moved. (`m_type` itself is replaced by the inferred type during typecheck)
+    bool    m_type_annotated = false;
 
     ExprNode_Let(Span sp, ::HIR::Pattern pat, ::HIR::TypeRef ty, ::HIR::ExprNodeP val):
         ExprNode(mv$(sp)),
diff --git a/src/hir/from_ast_expr.cpp b/src/hir/from_ast_expr.cpp
index 80c271bf..2a602b9f 100644
--- a/src/hir/from_ast_expr.cpp
+++ b/src/hir/from_ast_expr.cpp
@@ -271,11 +271,15 @@ struct LowerHIR_ExprNode_Visitor:
             ));
         }
         else {
-            m_rv.reset( new ::HIR::ExprNode_Let( v.span(),
+            auto type = LowerHIR_Type( v.m_type );
+            bool type_annotated = !type.data().is_Infer();
+            auto* node = new ::HIR::ExprNode_Let( v.span(),
                 LowerHIR_Pattern( v.m_pat ),
-                LowerHIR_Type( v.m_type ),
+                std::move(type),
                 lower_opt( v.m_value )
-                ) );
+                );
+            node->m_type_annotated = type_annotated;
+            m_rv.reset( node );
         }
     }
     virtual void visit(::AST::ExprNode_Assign& v) override {
diff --git a/src/hir_expand/reborrow.cpp b/src/hir_expand/reborrow.cpp
index c8c02fa7..63259569 100644
--- a/src/hir_expand/reborrow.cpp
+++ b/src/hir_expand/reborrow.cpp
@@ -111,6 +111,13 @@ namespace {
             ::HIR::ExprVisitorDef::visit(node);
             node.m_value = do_reborrow(mv$(node.m_value));
         }
+        void visit(::HIR::ExprNode_Let& node) override {
+            ::HIR::ExprVisitorDef::visit(node);
+            // Only `let x: &mut T = v;` is a coercion site, `let x = v;` moves `v`
+            if( node.m_value && node.m_type_annotated ) {
+                node.m_value = do_reborrow(mv$(node.m_value));
+            }
+        }
         void visit(::HIR::ExprNode_CallPath& node) override {
             ::HIR::ExprVisitorDef::visit(node);
             for(auto& arg : node.m_args) {
