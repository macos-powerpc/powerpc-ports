 namespace {
     // TODO: De-duplicate this with `static.cpp`
@@ -4875,18 +4876,11 @@ bool TraitResolution::trait_contains_type(const Span& sp, const ::HIR::GenericPa
                 return ::HIR::Compare::Unequal;
             }
 
-            // 2. Destination markers must be a strict subset
