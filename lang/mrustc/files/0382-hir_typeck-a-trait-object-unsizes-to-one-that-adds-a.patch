diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index cd5c169e..616a9f4d 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -2792,6 +2792,29 @@ bool StaticTraitResolve::type_is_impossible(const Span& sp, const ::HIR::TypeRef
     throw "";
 }
 
+// A trait object's markers plus the auto traits implied by its data trait's supertraits: `dyn Tr + 'a` unsizes to
+// `dyn Tr + Send` when `Tr: Send` (rustc 1.90 candidate_assembly.rs, "We may upcast to auto traits that are either
+// explicitly listed in the object type's bounds, or implied by the principal trait ref's supertraits"; qh3 2.0.4
+// hpke.rs stores rustls' `Box<dyn HpkeSealer + 'static>` in a `Box<dyn HpkeSealer + Send>` field, `HpkeSealer: Send + Sync`)
+bool HIR_TraitObject_ImpliesMarker(const ::HIR::TypeData::Data_TraitObject& src, const ::HIR::GenericPath& marker)
+{
+    for(const auto& omt : src.m_markers) {
+        if( omt == marker ) {
+            return true;
+        }
+    }
+    if( src.m_trait.m_path.m_path != ::HIR::SimplePath() && src.m_trait.m_trait_ptr )
+    {
+        // (auto traits have no parameters, the path is the identity)
+        for(const auto& pt : src.m_trait.m_trait_ptr->m_all_parent_traits) {
+            if( pt.m_path.m_path == marker.m_path && pt.m_trait_ptr && pt.m_trait_ptr->m_is_marker ) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
 bool StaticTraitResolve::can_unsize(const Span& sp, const ::HIR::TypeRef& dst_ty, const ::HIR::TypeRef& src_ty) const
 {
     TRACE_FUNCTION_F(dst_ty << " <- " << src_ty);
@@ -2915,17 +2938,11 @@ bool StaticTraitResolve::can_unsize(const Span& sp, const ::HIR::TypeRef& dst_ty
                     return false;
                 }
             }
-            // 2. Destination markers must be a strict subset
+            // 2. Destination markers must be a subset of the source's markers and implied auto traits
             for(const auto& mt : de->m_markers)
             {
-                bool found = false;
-                for(const auto& omt : se->m_markers) {
-                    if( omt == mt ) {
-                        found = true;
-                        break;
-                    }
-                }
-                if( !found ) {
+                if( !HIR_TraitObject_ImpliesMarker(*se, mt) ) {
+                    DEBUG("Marker " << mt << " not in source");
                     // Return early.
                     return false;
                 }
