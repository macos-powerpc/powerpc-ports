 namespace {
     inline HIR::ExprNodeP mk_exprnodep(HIR::ExprNode* en, ::HIR::TypeRef ty){ en->m_res_type = mv$(ty); return HIR::ExprNodeP(en); }
@@ -4739,18 +4740,11 @@ namespace {
                     }
                 }
 
-                // 2. Destination markers must be a strict subset
+                // 2. Destination markers must be a subset of the source's markers and implied auto traits
                 for(const auto& mt : dep->m_markers)
                 {
                     // TODO: Fuzzy match
-                    bool found = false;
-                    for(const auto& omt : sep->m_markers) {
-                        if( omt == mt ) {
-                            found = true;
-                            break;
-                        }
-                    }
-                    if( !found ) {
+                    if( !HIR_TraitObject_ImpliesMarker(*sep, mt) ) {
