+    // (`let x: Foo`, a cast, a turbofish argument) takes the defaults as it would outside one. When a parameter without
+    // a default is omitted there (a rustc error), the list is still left to inference.
+    HIR::PathParams get_path_params(const Span& sp, const ::HIR::GenericParams& params_def, const ::HIR::GenericPath& path, bool is_expr, bool infer_defaulted)
     {
