@@ -57,30 +66,81 @@ namespace {
 
         return pp;
     }
+
+    // An alias's own type is a type position, also when the alias is used in a body: a struct/enum/union path in it
+    // with an omitted list takes the defaults here, before Resolve Bind sees the copy in the body and treats it like
+    // something written there (`type B = Br;` + `B::new()` is `Br<false>` in rustc, not `Br<_>`). Lists that are not all
+    // defaulted are left for Resolve Bind to report.
+    void fill_alias_type_defaults(const Span& sp, const ::HIR::Crate& crate, ::HIR::TypeRef& ty)
+    {
+        struct V: public ::HIR::Visitor {
+            const Span& sp;
+            const ::HIR::Crate& crate;
+            V(const Span& sp, const ::HIR::Crate& crate): sp(sp), crate(crate) {}
+            void visit_type(::HIR::TypeRef& ty) override
+            {
+                // The expansion shares nodes with the alias's own type (TypeRef copies are shallow)
+                ty.get_unique();
+                ::HIR::Visitor::visit_type(ty);
+                auto* e = ty.data_mut().opt_Path();
+                if( !e || !e->path.m_data.is_Generic() )
+                    return ;
+                auto& gp = e->path.m_data.as_Generic();
+                const auto& ti = crate.get_typeitem_by_path(sp, gp.m_path);
+                const ::HIR::GenericParams* defs = nullptr;
+                if( const auto* i = ti.opt_Struct() )   defs = &i->m_params;
+                else if( const auto* i = ti.opt_Enum() )    defs = &i->m_params;
+                else if( const auto* i = ti.opt_Union() )   defs = &i->m_params;
+                if( !defs )
+                    return ;
+                auto& pp = gp.m_params;
+                auto ms = MonomorphStatePtr(nullptr, &pp, nullptr);
+                if( pp.m_types.empty() && !defs->m_types.empty() && std::all_of(defs->m_types.begin(), defs->m_types.end(),
+                        [](const HIR::TypeParamDef& p){ return p.m_default != ::HIR::TypeRef(); }) )
+                {
+                    for(size_t i = 0; i < defs->m_types.size(); i ++) {
+                        auto t = ms.monomorph_type(sp, defs->m_types[i].m_default);
+                        pp.m_types.push_back( std::move(t) );
+                    }
+                }
+                if( pp.m_values.empty() && !defs->m_values.empty() && std::all_of(defs->m_values.begin(), defs->m_values.end(),
+                        [](const HIR::ValueParamDef& p){ return !p.m_default.is_Infer(); }) )
+                {
+                    for(size_t i = 0; i < defs->m_values.size(); i ++) {
+                        auto v = ms.monomorph_constgeneric(sp, defs->m_values[i].m_default, /*allow_infer=*/true);
+                        pp.m_values.push_back( std::move(v) );
+                    }
+                }
+                DEBUG("- " << ty);
+            }
+        } v(sp, crate);
+        v.visit_type(ty);
+    }
 }
-::HIR::TypeRef ConvertHIR_ExpandAliases_GetExpansion_GP(const Span& sp, const ::HIR::Crate& crate, const ::HIR::GenericPath& path, bool is_expr)
+::HIR::TypeRef ConvertHIR_ExpandAliases_GetExpansion_GP(const Span& sp, const ::HIR::Crate& crate, const ::HIR::GenericPath& path, bool is_expr, bool infer_defaulted=true)
 {
     const auto& ti = crate.get_typeitem_by_path(sp, path.m_path);
     if(const auto* ep = ti.opt_TypeAlias() )
     {
         const auto& ta = *ep;
         DEBUG(path << " -> type " << ta.m_params.fmt_args() << " = " << ta.m_type);
-        auto pp = get_path_params(sp, ta.m_params, path, is_expr);
+        auto pp = get_path_params(sp, ta.m_params, path, is_expr, infer_defaulted);
         // Monomorphise the exapnded type using the created params
         auto ms = MonomorphStatePtr(nullptr, &pp, nullptr);
         HIR::TypeRef rv = ms.monomorph_type(sp, ta.m_type);
+        fill_alias_type_defaults(sp, crate, rv);
         DEBUG(path << " -> " << path.m_path << pp << " -> " << rv);
         return rv;
     }
     return ::HIR::TypeRef();
 }
 
