From 7605e8fee978b27439e72438164b5a8d2b586262 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 18:15:22 +0000
Subject: [PATCH 267/268] macro_rules: a `pat` fragment takes a top-level
 or-pattern only in a 2021+ macro definition; `pat_param` never does

cssparser 0.35.0 (ani-cli-rs 0.11.0, edition 2018) color.rs:116 match_ignore_ascii_case!:
`MACRO<cssparser::match_ignore_ascii_case> error:0: compile_error! "expected string literal"`.

macros.rs:37 matches `$( $pattern: pat )|+` and the invocation has `"xyz" | "xyz-d65" => ..`.
Every `pat` fragment was parsed with top-level or-patterns allowed (the edition check in
eval.cpp was commented out, and `pat_param` was mapped to the same fragment type), so the
two alternatives became ONE fragment and `_cssparser_internal_max_len!` received
`"xyz" | "xyz-d65"`; syn parses the first string and stops at the `|`.

Rust decides from the edition of the macro's DEFINITION: before 2021, `pat` matches no
top-level `|` (it is `pat_param`); from 2021 on it does; `pat_param` never does.

MacroPatEnt gets PAT_PAT_PARAM, appended to the type enum so rlibs written by older
compilers load unchanged. macro_rules/parse.cpp picks it for `pat` when the defining
lexer's edition is before 2021 and always for `pat_param`; eval.cpp parses the fragment
with AllowOrPattern::No for it (and the consume_pat lookahead agrees); mod.cpp prints it;
hir/deserialise.cpp accepts it.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir/deserialise.cpp b/src/hir/deserialise.cpp
index d6649b92..83a1b250 100644
--- a/src/hir/deserialise.cpp
+++ b/src/hir/deserialise.cpp
@@ -444,6 +444,7 @@ namespace {
                 break;
             case ::MacroPatEnt::PAT_TT: // :tt
             case ::MacroPatEnt::PAT_PAT:    // :pat
+            case ::MacroPatEnt::PAT_PAT_PARAM:    // :pat_param
             case ::MacroPatEnt::PAT_IDENT:
             case ::MacroPatEnt::PAT_PATH:
             case ::MacroPatEnt::PAT_TYPE:
diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 2b7b831c..34b0a772 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -630,9 +630,12 @@ InterpolatedFragment Macro_HandlePatternCap(TokenStream& lex, MacroPatEnt::Type
             PUTBACK(tok, lex);
         return InterpolatedFragment( Parse_TT(lex, false) );
     case MacroPatEnt::PAT_PAT:
-        // TODO: Is this edition check correct? Or should it be uncondiitonally "Yes"?
-        //return InterpolatedFragment( Parse_Pattern(lex, lex.edition_after(AST::Edition::Rust2021) ? AllowOrPattern::Yes : AllowOrPattern::No) );
+        // `pat` of a macro defined in the 2021 edition or later: a top-level or-pattern is one fragment
         return InterpolatedFragment( Parse_Pattern(lex, AllowOrPattern::Yes) );
+    case MacroPatEnt::PAT_PAT_PARAM:
+        // `pat_param`, or `pat` of a macro defined before 2021 (the parse of the definition decided): `|` ends
+        // the fragment, so `$( $p:pat )|+` sees every alternative (cssparser 0.35.0 match_ignore_ascii_case!)
+        return InterpolatedFragment( Parse_Pattern(lex, AllowOrPattern::No) );
     case MacroPatEnt::PAT_TYPE:
         return InterpolatedFragment( Parse_Type(lex) );
     case MacroPatEnt::PAT_EXPR:
@@ -2171,8 +2174,9 @@ namespace
         case MacroPatEnt::PAT_STMT:
             return consume_stmt(lex);
         case MacroPatEnt::PAT_PAT:
-            //return consume_pat(lex, lex.edition_after(AST::Edition::Rust2021));
             return consume_pat(lex, true);
+        case MacroPatEnt::PAT_PAT_PARAM:
+            return consume_pat(lex, false);
         case MacroPatEnt::PAT_META:
             if( lex.next() == TOK_INTERPOLATED_META ) {
                 lex.consume();
diff --git a/src/macro_rules/macro_rules.hpp b/src/macro_rules/macro_rules.hpp
index a22f4bd1..f02a6a7d 100644
--- a/src/macro_rules/macro_rules.hpp
+++ b/src/macro_rules/macro_rules.hpp
@@ -76,6 +76,7 @@ struct MacroPatEnt
         PAT_VIS,
         PAT_LIFETIME,
         PAT_LITERAL,
+        PAT_PAT_PARAM,  // :pat_param, and :pat in a macro defined before the 2021 edition: no top-level or-pattern
     } type;
 
     MacroPatEnt():
diff --git a/src/macro_rules/mod.cpp b/src/macro_rules/mod.cpp
index b1fd1c60..d7f476a4 100644
--- a/src/macro_rules/mod.cpp
+++ b/src/macro_rules/mod.cpp
@@ -198,6 +198,7 @@ MacroRulesPtr::~MacroRulesPtr()
         case MacroPatEnt::PAT_LOOP:  throw "";
         case MacroPatEnt::PAT_TT:    os << "tt";    break;
         case MacroPatEnt::PAT_PAT:   os << "pat";   break;
+        case MacroPatEnt::PAT_PAT_PARAM:   os << "pat_param";   break;
         case MacroPatEnt::PAT_IDENT: os << "ident"; break;
         case MacroPatEnt::PAT_PATH:  os << "path";  break;
         case MacroPatEnt::PAT_TYPE:  os << "type";  break;
@@ -222,6 +223,7 @@ MacroRulesPtr::~MacroRulesPtr()
     case MacroPatEnt::PAT_LOOP:  os << "PAT_LOOP";  break;
     case MacroPatEnt::PAT_TT:    os << "PAT_TT";    break;
     case MacroPatEnt::PAT_PAT:   os << "PAT_PAT";   break;
+    case MacroPatEnt::PAT_PAT_PARAM:   os << "PAT_PAT_PARAM";   break;
     case MacroPatEnt::PAT_IDENT: os << "PAT_IDENT"; break;
     case MacroPatEnt::PAT_PATH:  os << "PAT_PATH";  break;
     case MacroPatEnt::PAT_TYPE:  os << "PAT_TYPE";  break;
diff --git a/src/macro_rules/parse.cpp b/src/macro_rules/parse.cpp
index a1a03067..675bb376 100644
--- a/src/macro_rules/parse.cpp
+++ b/src/macro_rules/parse.cpp
@@ -143,10 +143,10 @@ public:
                     ;
                 else if( type == "tt" )
                     ty = MacroPatEnt::PAT_TT;
-                else if( type == "pat" )    // 
-                    ty = MacroPatEnt::PAT_PAT;
+                else if( type == "pat" )    // matches a top-level or-pattern only from the 2021 edition on (of the macro's definition)
+                    ty = lex.edition_after(AST::Edition::Rust2021) ? MacroPatEnt::PAT_PAT : MacroPatEnt::PAT_PAT_PARAM;
                 else if( type == "pat_param" )  // Added between 39 and 54, explicitly excludes or-patterns
-                    ty = MacroPatEnt::PAT_PAT;
+                    ty = MacroPatEnt::PAT_PAT_PARAM;
                 else if( type == "ident" )
                     ty = MacroPatEnt::PAT_IDENT;
                 else if( type == "path" )
