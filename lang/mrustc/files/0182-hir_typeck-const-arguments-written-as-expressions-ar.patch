From 2c1fe9c5ecf5e0482b7ca5504c84e106a2c08987 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 10:58:56 +0000
Subject: [PATCH] hir_typeck: const arguments written as expressions are
 evaluated, and compared by value

`c.reborrow().project::<D, _, { STRUCT_VARIANT_ID }, { 0 }>()` (zerocopy
0.8.59 impls.rs:1019, skim) failed twice in check_associated once the
single `ReadOnly<T>` impl was selected and the rule's const arguments
were equated with the impl's:

- ConstGeneric::operator== compared two Unevaluated values by the
  identity of their unique_ptr, so the clone a method call's params made
  of `{ STRUCT_VARIANT_ID }` never equalled the clone in its return
  type's projection: "Value mismatch between Unevaluated({..}{
  STRUCT_VARIANT_ID }) and Unevaluated(<the same>)". Two are equal when
  they share the expression (every clone and monomorph does) under the
  same captured generics, or order equal.
- The const-eval pass only reaches impl headers and signatures, so the
  argument in the body stayed Unevaluated while the impl header's
  `{ STRUCT_VARIANT_ID }` was Evaluated: "Value mismatch between
  Unevaluated(..) and Evaluated(FFFF..)". fix_param_count now evaluates
  a const argument whose parameter type names no generics; a deferred
  evaluation leaves it as it was.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir/hir.cpp b/src/hir/hir.cpp
index 1affa755..1f79af10 100644
--- a/src/hir/hir.cpp
+++ b/src/hir/hir.cpp
@@ -60,7 +60,12 @@ namespace HIR {
             return false;
         TU_MATCH_HDRA( (*this, x), {)
         TU_ARMA(Infer, te, xe) return te.index == xe.index;
-        TU_ARMA(Unevaluated, te, xe)    return te == xe;
+        // Two unevaluated values are equal when they share the expression (every monomorph/clone does) under the
+        // same captured generics, or order equal: `te == xe` compared the unique_ptrs, so the clone a method call's
+        // params made of `{ STRUCT_VARIANT_ID }` never equalled the one in its return type's projection.
+        // - zerocopy 0.8.59 impls.rs:1019 (skim) `c.reborrow().project::<D, _, { STRUCT_VARIANT_ID }, { 0 }>()`
+        //   -> "Value mismatch between Unevaluated({..}{ STRUCT_VARIANT_ID }) and Unevaluated({..}{ STRUCT_VARIANT_ID })"
+        TU_ARMA(Unevaluated, te, xe)    return te.get() == xe.get() || te->ord(*xe) == OrdEqual;
         TU_ARMA(Generic, te, xe)    return te == xe;
         TU_ARMA(Evaluated, te, xe)  return EncodedLiteralSlice(*te) == EncodedLiteralSlice(*xe);
         }
diff --git a/src/hir_typeck/expr_cs__enum.cpp b/src/hir_typeck/expr_cs__enum.cpp
index 1d52aece..4245c8ef 100644
--- a/src/hir_typeck/expr_cs__enum.cpp
+++ b/src/hir_typeck/expr_cs__enum.cpp
@@ -8,6 +8,7 @@
 #include "expr_cs.hpp"
 #include "expr_visit.hpp"
 #include <hir/expr.hpp>
+#include <hir_conv/main_bindings.hpp>
 
 #include <algorithm>
 
@@ -130,6 +131,23 @@ namespace typecheck
                 context.m_ivars.add_ivars(params.m_values.back());
             }
         }
+
+        // Evaluate const arguments that are closed expressions now (`{ STRUCT_VARIANT_ID }` in a turbofish):
+        // the const-eval pass only reaches impl headers and signatures, so these stayed Unevaluated and never equalled
+        // the impl header's Evaluated `{ STRUCT_VARIANT_ID }` when the impl was selected.
+        // - zerocopy 0.8.59 impls.rs:1019 (skim) `c.reborrow().project::<D, _, { STRUCT_VARIANT_ID }, { 0 }>()`
+        //   -> "Value mismatch between Unevaluated({..}{ STRUCT_VARIANT_ID }) and Evaluated(FFFF...)"
+        // An expression that still depends on something (Defer) is left as it was.
+        for(size_t i = 0; i < params.m_values.size() && i < param_defs.m_values.size(); i ++)
+        {
+            auto& v = params.m_values[i];
+            const auto& ty = param_defs.m_values[i].m_type;
+            if( v.is_Unevaluated() && v.as_Unevaluated()->expr->m_state && !monomorphise_type_needed(ty) )
+            {
+                ConvertHIR_ConstantEvaluate_ConstGeneric(sp, context.m_crate, ty, v);
+                DEBUG("const arg #" << i << " of " << path << " = " << v);
+            }
+        }
     }
     void fix_param_count(const Span& sp, Context& context, const ::HIR::TypeRef& self_ty, bool use_defaults, const ::HIR::Path& path, const ::HIR::GenericParams& param_defs,  ::HIR::PathParams& params) {
         fix_param_count_(sp, context, self_ty, use_defaults, path, param_defs, params);
