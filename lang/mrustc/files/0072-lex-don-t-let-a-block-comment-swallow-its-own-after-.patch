From 5b82f292a33c6f779c32655628af3ec655223a38 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 20:48:49 +0000
Subject: [PATCH 72/72] lex: don't let a block comment swallow its own `*/`
 after a run of `*`

Inside a block comment the lexer consumed a `*` together with the next
character. When that character was another `*`, both were taken without
looking at the second one, so a closing `*/` preceded by an even-aligned
run of stars was never seen and the comment ran to the end of the file.
Everything after it vanished without an error. value-trait 0.12.2
(src/node/from.rs) separates its sections with

    /********* atoms **********/

so every `From<..> for StaticNode` impl after the first banner was
silently dropped, and simd-json 0.18.1 failed with

    numberparse/correct.rs:409:38 error:0: Failed to find an impl of
        ::"core-0_0_0"::convert::From<f64,> for ::"value_trait-0_12_2_H828"::node::StaticNode

Consume only the `*` and re-examine the following character, so `**/`
closes the comment whatever the alignment. Nested `/* */` handling is
unchanged.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/parse/lex.cpp | 36 ++++++++++++++++++++----------------
 1 file changed, 20 insertions(+), 16 deletions(-)

diff --git a/src/parse/lex.cpp b/src/parse/lex.cpp
index b71ee438..e68279ea 100644
--- a/src/parse/lex.cpp
+++ b/src/parse/lex.cpp
@@ -684,30 +684,34 @@ Token Lexer::getTokenInt()
                         str += ch;
                         ch = this->getc();
                         if( ch == '*' ) {
+                            // Nested comment
                             level ++;
+                            str += ch;
+                            ch = this->getc();
                         }
-                        str += ch;
+                        // else: `ch` is examined by the next iteration
                     }
-                    else {
-                        if( ch == '*' ) {
+                    else if( ch == '*' ) {
+                        ch = this->getc();
+                        if( ch == '/' ) {
+                            if( level == 0 )
+                                break;
+                            level --;
+                            str.push_back('*');
+                            str.push_back('/');
                             ch = this->getc();
-                            if( ch == '/' ) {
-                                if( level == 0 )
-                                    break;
-                                level --;
-                                str.push_back('*');
-                                str.push_back('/');
-                            }
-                            else {
-                                str.push_back('*');
-                                str += ch;
-                            }
                         }
                         else {
-                            str += ch;
+                            // Only the `*` is consumed: `ch` may be another `*` that (with the next `/`) closes
+                            // the comment - consuming it here swallowed the rest of the file after `/**** text ****/`
+                            // (value-trait 0.12.2 src/node/from.rs)
+                            str.push_back('*');
                         }
                     }
-                    ch = this->getc();
+                    else {
+                        str += ch;
+                        ch = this->getc();
+                    }
                 }
                 if( is_doc || is_pdoc )
                 {
