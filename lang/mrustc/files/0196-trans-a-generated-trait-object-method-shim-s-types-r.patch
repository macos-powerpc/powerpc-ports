From 0d10d5d9e987690eacf90abfcc37106294857bf1 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 16:11:25 +0000
Subject: [PATCH] trans: a generated trait-object method shim's types reach
 codegen

0194 generates the `<dyn Trait as Trait>::method` shim for a `Pin<&mut
Self>` receiver with a `Pin<&mut ()>` local.  Codegen only defines the
structs the type enumeration collected, and that runs before
Trans_AutoImpls, so when the shim was the crate's only use of that type
the C compiler got an incomplete struct: sad 0.4.32 (tokio's
`stream_into` polling a boxed future through a function value),
"storage size of 'var50' isn't known" / "type of formal parameter 1 is
incomplete".  tower-lsp-server happened to have the struct from a direct
virtual call elsewhere.

Each shim's MIR now goes through the type visitor
(Trans_Enumerate_Types_Function), seeded with the entries already
collected so nothing is defined twice.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>

diff --git a/src/trans/auto_impls.cpp b/src/trans/auto_impls.cpp
index d29763ef..b480346c 100644
--- a/src/trans/auto_impls.cpp
+++ b/src/trans/auto_impls.cpp
@@ -569,6 +569,8 @@ void Trans_AutoImpls(::HIR::Crate& crate, TransList& trans_list)
             trans_list.m_auto_functions.push_back(box$(new_fcn));
             auto* e = trans_list.add_function(path.clone());
             e->ptr = trans_list.m_auto_functions.back().get();
+            // The shim's own types (its `Pin<&mut ()>`-style receiver, the vtable reference) must reach codegen too
+            Trans_Enumerate_Types_Function(crate, trans_list, path, *e->ptr);
         }
     }
 
diff --git a/src/trans/enumerate.cpp b/src/trans/enumerate.cpp
index e50ec204..ce183467 100644
--- a/src/trans/enumerate.cpp
+++ b/src/trans/enumerate.cpp
@@ -929,6 +929,15 @@ namespace
             DEBUG("Visited a total of " << visited_map.size());
         }
 
+        /// Index the entries already in `out_list` (a visitor made after the main enumeration must not add them again)
+        void init_visited()
+        {
+            visited_map.resize(out_list.size());
+            for(size_t i = 0; i < visited_map.size(); i ++)
+                visited_map[i] = i;
+            ::std::sort(visited_map.begin(), visited_map.end(), [&](size_t a, size_t b){ return out_list[a].first < out_list[b].first; });
+        }
+
         void visit_struct(const ::HIR::GenericPath& path, const ::HIR::Struct& item) {
             static Span sp;
             ::HIR::TypeRef  tmp;
@@ -1363,6 +1372,18 @@ namespace
 } // namespace <empty>
 
 // Enumerate types required for the enumerated items
+/// Types of a function generated after the main enumeration (Trans_AutoImpls' trait-object method shims): codegen only
+/// defines the structs in `m_types`, so a shim's own locals must be added there too.
+/// - sad 0.4.32 / tower-lsp-server 0.23.0: the `<dyn Future as Future>::poll` shim's `Pin<&mut ()>` was nowhere else in
+///   the crate -> "storage size of 'var50' isn't known" from the C compiler
+void Trans_Enumerate_Types_Function(const ::HIR::Crate& crate, TransList& list, const ::HIR::Path& path, const ::HIR::Function& fcn)
+{
+    TRACE_FUNCTION_F(path);
+    TypeVisitor tv { crate, list.m_types, nullptr };
+    tv.init_visited();
+    tv.visit_function(path, fcn, Trans_Params());
+}
+
 void Trans_Enumerate_Types(EnumState& state)
 {
     TRACE_FUNCTION;
diff --git a/src/trans/main_bindings.hpp b/src/trans/main_bindings.hpp
index 089f7120..2a755cc2 100644
--- a/src/trans/main_bindings.hpp
+++ b/src/trans/main_bindings.hpp
@@ -42,6 +42,8 @@ extern TransList Trans_Enumerate_Public(::HIR::Crate& crate, bool link_named_roo
 extern void Trans_Enumerate_Cleanup(const ::HIR::Crate& crate, TransList& list);
 
 extern void Trans_AutoImpls(::HIR::Crate& crate, TransList& trans_list);
+/// Add the types used by a function generated after the main enumeration (see Trans_AutoImpls)
+extern void Trans_Enumerate_Types_Function(const ::HIR::Crate& crate, TransList& list, const ::HIR::Path& path, const ::HIR::Function& fcn);
 
 extern void Trans_Monomorphise_List(const ::HIR::Crate& crate, TransList& list);
 
