From 616c4d23709d50d185e01a605118b754c2364d1c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 05:37:06 +0000
Subject: [PATCH 102/105] macro_rules: a :meta fragment's name may be a path,
 with or without a leading ::

libc 0.2.190 (pngquant 3.0.3) src/unix/mod.rs:52, the first `s2!` block:

    MACRO<::"libc"::custom_struct> BUG: src/macro_rules/eval.cpp:2250: TODO:
      Macro_InvokeRules_MatchPattern - No arm matched - (2, 111), (16, 35)

libc 0.2.190 rewrote its struct macros. `s!`/`s2!` now pass
`#[::core::prelude::v1::derive(::core::clone::Clone, ..)]` to `custom_struct!`,
and that puts every struct attribute through
`emit_struct_definition!`'s `$(#[$attr:meta])*`. That fails for every struct
in the crate. In 0.2.189 this path only appeared inside `cfg_attr(..)`, which
already matched as `IDENT(..)`.

The matcher's `:meta` lookahead only accepted `IDENT`, `IDENT(..)` or
`IDENT = ..`. `Parse_MetaItem`, which parses the captured fragment, has always
taken a path name (optional leading `::`, segments may be keywords) followed
by `(..)`, `[..]` or `= ..`. Make the lookahead accept the same, so the
matcher and the parser agree on the fragment's extent. The derive handler
already accepts `core::prelude::v1::derive` and `::core::clone::Clone`.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/macro_rules/eval.cpp | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 37a9dd5a..4a89507b 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -2084,12 +2084,22 @@ namespace
             if( lex.next() == TOK_INTERPOLATED_META ) {
                 lex.consume();
             }
-            else if( lex.next() == TOK_IDENT )
+            else if( lex.next() == TOK_IDENT || lex.next() == TOK_DOUBLE_COLON )
             {
+                // The name is a path, e.g. `::core::prelude::v1::derive(..)` (libc 0.2.190). Same rules as `Parse_MetaItem`
+                if( lex.consume_if(TOK_DOUBLE_COLON) && lex.next() != TOK_IDENT && !Token::type_is_rword(lex.next()) )
+                    return false;
                 lex.consume();
+                while( lex.consume_if(TOK_DOUBLE_COLON) )
+                {
+                    if( lex.next() != TOK_IDENT && !Token::type_is_rword(lex.next()) )
+                        return false;
+                    lex.consume();
+                }
                 switch(lex.next())
                 {
                 case TOK_PAREN_OPEN:
+                case TOK_SQUARE_OPEN:
                     return consume_tt(lex);
                 case TOK_EQUAL:
                     lex.consume();
