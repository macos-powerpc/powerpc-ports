From c21d6097218101ad3a806339633cfd35eb8bf23c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 00:15:38 +0000
Subject: [PATCH 327/327] minicargo: set CARGO_BIN_NAME for binaries,
 CARGO_CRATE_NAME without dashes

stgit 2.7.0 src/cmd/version.rs:35 ([[bin]] name = "stg"):
    let bin_name = env!("CARGO_BIN_NAME");
    version.rs:35:47 error:0: Environment variable 'CARGO_BIN_NAME' not defined

cargo sets CARGO_BIN_NAME (the target name as written) for binaries and example
binaries, and CARGO_CRATE_NAME (`-` -> `_`) for every target. minicargo set only
CARGO_CRATE_NAME, with the target name's dashes.

Job_Build::start now sets both as cargo does. `--crate-name` keeps the dashed
name of a dashed [[bin]] (unchanged).

Assisted-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/tools/minicargo/build.cpp b/tools/minicargo/build.cpp
index 454706ac..240984b8 100644
--- a/tools/minicargo/build.cpp
+++ b/tools/minicargo/build.cpp
@@ -1331,7 +1331,13 @@ RunnableJob Job_BuildTarget::start()
     for(const auto& e : m_manifest.build_script_output().rustc_env) {
         env.push_back(e.first.c_str(), e.second.c_str());
     }
-    env.push_back("CARGO_CRATE_NAME", m_target.m_name);
+    // cargo: CARGO_CRATE_NAME is the crate name (`-` -> `_`), CARGO_BIN_NAME the target name as written, binaries (and
+    // example binaries) only. stgit 2.7.0 cmd/version.rs:35 `env!("CARGO_BIN_NAME")` was "Environment variable
+    // 'CARGO_BIN_NAME' not defined".
+    env.push_back("CARGO_CRATE_NAME", escape_dashes(m_target.m_name));
+    if( m_target.m_type == PackageTarget::Type::Bin || m_target.m_type == PackageTarget::Type::Example ) {
+        env.push_back("CARGO_BIN_NAME", m_target.m_name);
+    }
     push_env_common(env, m_manifest);
 
     return RunnableJob(parent.m_compiler_path.str().c_str(), std::move(args), std::move(env), outfile + "_dbg.txt");
