From 323d028cc261a0e156abfda1fc6bee092a7ba95f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 8 Oct 2026 18:09:42 +0000
Subject: [PATCH 145/145] hir_typeck: the numeric binop inference link looks
 through one shared reference

colorgrad 0.8.0 preset.rs:227 (xan 0.61.0), `build_preset`'s nested
`fn to_color(c: &u32)`: `((c >> 8) & 0xff) as _` failed with "Type mismatch
between u32 and i32". `&u32 >> {integer}` has ten candidate impls (`Shr<i8>`
.. `Shr<usize>` for `&u32`, core's `forward_ref_binop`), so the shift's
output stayed unknown until the literal defaulted, and `apply_defaults`
makes every remaining integer literal `i32` in one go, the `0xff` included.
The shift rule then resolved to `u32`, and the rule for `&` saw
`u32 & i32`. (The third argument, `c & 0xff`, worked only because
`&u32 & {integer}` has a single candidate impl.)

rustc's builtin-binop hint (`is_builtin_binop` / `enforce_builtin_binop_types`)
looks through one layer of shared reference on either operand before asking
whether both are numeric, because every `forward_ref_binop` impl yields the
value type. The "magic inference link for binops on numerics" in
`check_associated` now does the same: the result is the dereferenced left
operand's type, and for non-shift operators the dereferenced operand types
are equated, so `&u32 >> 8` is `u32` right away and `u32 & 0xff` pins the
literal before any default applies. The rule's own RHS ivar is still the one
marked as an unknown-source type.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index d2898b0f..624d7774 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -5551,8 +5551,21 @@ namespace {
             {
                 // Binary operations - If both types are primitives, the output is the lefthand side
                 // NOTE: Comparison ops don't (currently) see this
-                const auto& left = v.impl_ty; // yes, impl = LHS of binop
-                const auto& right = v.params.m_types.at(0);
+                // Like rustc's builtin-binop hint (`deref_ty_if_possible`), look through one shared reference on
+                // either side: core's `forward_ref_binop` impls all yield the value type. `&u32 >> 8` has ten
+                // candidate impls (`Shr<i8>`..`Shr<usize>` for `&u32`), so without this its output waited for the
+                // literal's default, which lands together with the `0xff` in `((c >> 8) & 0xff)` and leaves
+                // `u32 & i32` ("Type mismatch between u32 and i32", colorgrad 0.8.0 preset.rs `build_preset`).
+                auto deref_shared = [&](const ::HIR::TypeRef& t)->::HIR::TypeRef {
+                    const auto& tr = context.get_type(t);
+                    if( const auto* be = tr.data().opt_Borrow() ) {
+                        if( be->type == ::HIR::BorrowType::Shared )
+                            return context.get_type(be->inner).clone();
+                    }
+                    return tr.clone();
+                    };
+                const auto left = deref_shared(v.impl_ty); // yes, impl = LHS of binop
+                const auto right = deref_shared(v.params.m_types.at(0));
                 const auto& res = v.left_ty;
                 if( H::type_is_num(context.get_type(left)) && H::type_is_num(context.get_type(right)) )
                 {
@@ -5575,13 +5588,13 @@ namespace {
                         context.equate_types(sp, left, right);
                     }
                     if( context.get_type(left).data().is_Infer() && context.get_type(right).data().is_Infer() && context.get_type(res).data().is_Infer() ) {
-                        context.possible_equate_type_unknown(sp, right, Context::IvarUnknownType::To);
+                        context.possible_equate_type_unknown(sp, v.params.m_types.at(0), Context::IvarUnknownType::To);
                         DEBUG("> All are infer, skip");
                         return false;
                     }
                 }
 
-                context.possible_equate_type_unknown(sp, right, Context::IvarUnknownType::To);
+                context.possible_equate_type_unknown(sp, v.params.m_types.at(0), Context::IvarUnknownType::To);
             }
             else
             {
