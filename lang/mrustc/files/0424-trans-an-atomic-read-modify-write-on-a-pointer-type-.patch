From b02e366850c6a91f6b4bd9e185cf38330aa6b853 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 1 Nov 2026 06:25:39 +0000
Subject: [PATCH 424/425] trans: an atomic read-modify-write on a pointer type
 goes through uintptr_t in the C

std 1.90 sys/sync/rwlock/queue.rs (`AtomicPtr<Node>::fetch_or`, `fetch_byte_sub`), mrustc built with clang 20 on
macOS 10.15: "libstd.rlib.c: error: address argument to atomic operation must be a pointer to atomic integer
('_Atomic(tUNIT *) *' invalid)" and "incompatible pointer to integer conversion passing 'struct Node *' to
parameter of type 'long'". core's AtomicPtr::fetch_{or,and,xor,byte_add,byte_sub} call the atomic intrinsics
with `T = *mut u8` and a pointer-typed operand (`ptr::without_provenance_mut(val)`), and emit_atomic_arith cast
the slot to `(T *_Atomic *)` and passed the operand as is. C11's atomic_fetch_{add,sub,and,or,xor} aren't
defined on atomic pointers (and add/sub would take a ptrdiff_t); GCC accepts the form as an extension, clang
rejects it.

For a pointer `T` the slot is now `(uintptr_t _Atomic *)`, the operand `(uintptr_t)`, and the result is cast
back to `T`. Integer atomics are unchanged; load/store/exchange/compare-exchange on pointers are valid C11 and
untouched.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index b47a051f..24a72c34 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -7155,7 +7155,14 @@ namespace {
                 emit_lvalue(e.ret_val); m_of << " = ";
                 switch(m_compiler)
                 {
-                case Compiler::Gcc:
+                case Compiler::Gcc: {
+                    // `AtomicPtr::fetch_{or,and,xor,byte_add,byte_sub}` call these with a pointer `T` and a pointer-typed
+                    // operand; C11's fetch functions aren't defined on `_Atomic(T*)` (clang rejects them, GCC accepts),
+                    // so do the arithmetic on uintptr_t.
+                    bool is_ptr = params.m_types.at(0).data().is_Pointer();
+                    if( is_ptr ) {
+                        m_of << "("; emit_ctype(params.m_types.at(0)); m_of << ")";
+                    }
                     switch(op)
                     {
                     case AtomicOp::Add: m_of << "atomic_fetch_add_explicit";   break;
@@ -7164,8 +7171,12 @@ namespace {
                     case AtomicOp::Or:  m_of << "atomic_fetch_or_explicit";    break;
                     case AtomicOp::Xor: m_of << "atomic_fetch_xor_explicit";   break;
                     }
-                    m_of << "("; emit_atomic_cast(); emit_param(e.args.at(0)); m_of << ", "; emit_param(e.args.at(1)); m_of << ", " << get_atomic_ty_gcc(ordering) << ")";
-                    break;
+                    m_of << "(";
+                    if( is_ptr ) { m_of << "(uintptr_t _Atomic *)"; } else { emit_atomic_cast(); }
+                    emit_param(e.args.at(0)); m_of << ", ";
+                    if( is_ptr ) { m_of << "(uintptr_t)"; }
+                    emit_param(e.args.at(1)); m_of << ", " << get_atomic_ty_gcc(ordering) << ")";
+                    break; }
                 case Compiler::Msvc:
                     switch(op)
                     {
