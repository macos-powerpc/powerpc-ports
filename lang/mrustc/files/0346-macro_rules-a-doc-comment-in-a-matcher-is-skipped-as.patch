From ca35a2917c6b55d578fa15ea2bc75c7b9c793e71 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 21:36:08 +0000
Subject: [PATCH] macro_rules: a doc comment in a matcher is skipped, as rustc
 does

konst 0.2.20 src/string.rs:15 (repgrep 0.17.1): `__declare_string_cmp_fns! { import_path = "konst", equality_fn =
eq_str, ordering_fn = cmp_str, ordering_fn_inner = cmp_str_inner, }` = "BUG: src/macro_rules/eval.cpp:2402: TODO:
Macro_InvokeRules_MatchPattern - No arm matched - (12, 14), (0, 14)". The macro (src/macros/declare_cmp_fn_macros.rs:3)
has a doc comment inside its first arm's matcher:
    ordering_fn = $cmp_str:ident,
    /// Equivalent to ordering_fn, but returns a U8Ordering
    ordering_fn_inner = $cmp_str_inner:ident,
rustc's macro parser skips a doc-comment token in a matcher (the arm matches an invocation without one, which is how
konst builds). mrustc's lexer turns `/// ..` into `# [doc = ".."]` tokens, and Parse_MacroRules_Pat took them as six
tokens the input had to hold, so the arm failed right there (position 12). A doc comment inside a repetition also made
macro_pattern_to_simple_inner report the repetition's entry and the token after it as ambiguous (both `#`).

Parse_MacroRules_Pat: a `#` followed by `[doc = "<string>"]` (with an optional `!` for `//!`) is dropped from the
pattern; anything else starting with `#` is read as plain tokens as before, with the `[`/`]` depth of
a `[]`-delimited matcher kept.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/macro_rules/parse.cpp b/src/macro_rules/parse.cpp
index dada4763..47f40122 100644
--- a/src/macro_rules/parse.cpp
+++ b/src/macro_rules/parse.cpp
@@ -225,6 +225,59 @@ public:
             break;
         case TOK_EOF:
             throw ParseError::Unexpected(lex, tok);
+        case TOK_HASH: {
+            // A doc comment (`/// ..`, `/** .. */`; `//! ..` with a `!`) lexes as `# [doc = ".."]`. In a matcher rustc
+            // skips it, so an invocation needn't hold one: konst 0.2.20 `ordering_fn = $cmp_str:ident, /// ..
+            // ordering_fn_inner = $cmp_str_inner:ident,` invoked without. Recognised by shape: a hand-written
+            // `#[doc = "lit"]` in a matcher would match input tokens in rustc, but nothing writes that.
+            ::std::vector<Token>    seq;
+            seq.push_back(tok);
+            bool    is_doc = false;
+            for(;;)
+            {
+                GET_TOK(tok, lex);
+                if( seq.size() == 1 && tok.type() == TOK_EXCLAM ) {
+                    seq.push_back(tok);
+                    continue ;
+                }
+                // Position in `# [ doc = ".." ]`, the `!` not counted
+                size_t j = seq.size() - (seq.size() > 1 && seq[1].type() == TOK_EXCLAM ? 1 : 0);
+                bool ok = false;
+                switch(j)
+                {
+                case 1: ok = tok.type() == TOK_SQUARE_OPEN;  break;
+                case 2: ok = tok.type() == TOK_IDENT && tok.ident().name == "doc";  break;
+                case 3: ok = tok.type() == TOK_EQUAL;   break;
+                case 4: ok = tok.type() == TOK_STRING;  break;
+                case 5: ok = tok.type() == TOK_SQUARE_CLOSE; break;
+                }
+                if( !ok ) {
+                    PUTBACK(tok, lex);
+                    break;
+                }
+                seq.push_back(tok);
+                if( j == 5 ) {
+                    is_doc = true;
+                    break;
+                }
+            }
+            if( is_doc )
+            {
+                DEBUG("Doc comment in a matcher skipped");
+            }
+            else
+            {
+                // Plain tokens, as `default` makes them (a `[`/`]` counts for a `[]`-delimited matcher)
+                for(auto& t : seq)
+                {
+                    if( t.type() == open )
+                        depth ++;
+                    else if( t.type() == close )
+                        depth --;
+                    ret.push_back( MacroPatEnt(lex.end_span(ps), mv$(t)) );
+                }
+            }
+            break; }
         default:
             ret.push_back( MacroPatEnt(lex.end_span(ps), tok) );
             break;
