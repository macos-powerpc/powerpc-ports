From 9ed771a5acdfe0bb35369196df263368585a1792 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 10:48:51 +0000
Subject: [PATCH 255/255] minicargo: export CARGO_PKG_VERSION_PRE and
 CARGO_MANIFEST_LINKS

ring 0.17.14 (tombi 1.8.4) reads both in build.rs
(`env::var("CARGO_PKG_VERSION_PRE").unwrap()`, then
`assert_eq!(env::var("CARGO_MANIFEST_LINKS").unwrap(), <name>_core_<ver>)`)
and `env!("CARGO_PKG_VERSION_PRE")` in src/prefixed.rs, which is a hard
error when the variable is undefined. Neither was in the environment
minicargo gives build scripts and crate compiles (the
`//env.push_back("CARGO_MANIFEST_LINKS", ..)` line had been commented
out).

push_env_common now sets CARGO_PKG_VERSION_PRE from the manifest
version's prerelease part (empty when absent, as cargo does) and
CARGO_MANIFEST_LINKS only when `[package] links` is set, through a new
PackageManifest::links() accessor. Checked with a `0.1.0-beta.2` +
`links = "mcprobe"` probe crate: the failing job's `Env:` line shows
both, the old binary neither.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 tools/minicargo/build.cpp  | 8 +++++++-
 tools/minicargo/manifest.h | 1 +
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/tools/minicargo/build.cpp b/tools/minicargo/build.cpp
index cc9167cb..39f51cc4 100644
--- a/tools/minicargo/build.cpp
+++ b/tools/minicargo/build.cpp
@@ -830,6 +830,13 @@ namespace {
         env.push_back("CARGO_PKG_VERSION_MAJOR", ::format(manifest.version().major));
         env.push_back("CARGO_PKG_VERSION_MINOR", ::format(manifest.version().minor));
         env.push_back("CARGO_PKG_VERSION_PATCH", ::format(manifest.version().patch));
+        // Empty unless the version has a `-pre` part; ring 0.17.14 reads it in build.rs (`env::var(..).unwrap()`) and
+        // in src/prefixed.rs (`env!`, a hard error when undefined)
+        env.push_back("CARGO_PKG_VERSION_PRE", manifest.version().prerelease);
+        // `links = "..."` from [package]: cargo sets it for the build script and the crate only when present
+        // (ring's build.rs asserts it against the name it derives from the version)
+        if( !manifest.links().empty() )
+            env.push_back("CARGO_MANIFEST_LINKS", manifest.links());
         // Metadata variables: cargo always defines these (empty when absent), and
         // `env!("CARGO_PKG_...")` hard-errors if they are undefined
         env.push_back("CARGO_PKG_AUTHORS", manifest.pkg_authors());
@@ -1358,7 +1365,6 @@ RunnableJob Job_RunScript::start()
     os_support::mkdir(out_dir);
     // Environment variables (key-value list)
     StringListKV    env;
-    //env.push_back("CARGO_MANIFEST_LINKS", manifest.m_links);
     for(const auto& feat : m_manifest.active_features())
     {
         ::std::string   fn = "CARGO_FEATURE_";
diff --git a/tools/minicargo/manifest.h b/tools/minicargo/manifest.h
index af4f913f..2acb12bd 100644
--- a/tools/minicargo/manifest.h
+++ b/tools/minicargo/manifest.h
@@ -434,6 +434,7 @@ public:
     const ::std::string& pkg_license_file() const { return m_pkg_license_file; }
     const ::std::string& pkg_readme() const { return m_pkg_readme; }
     const ::std::string& pkg_rust_version() const { return m_pkg_rust_version; }
+    const ::std::string& links() const { return m_links; }
     const ::std::map< ::std::string, ::helpers::path>& patches() const { return m_patches; }
     bool is_std_magic() const {
         return m_manifest_dir == ::helpers::path();
