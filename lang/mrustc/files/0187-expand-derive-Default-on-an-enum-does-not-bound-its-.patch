From 7ba4002043f95f7e9e9d96f2979956d017928128 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 12:31:33 +0000
Subject: [PATCH 187/188] expand: derive(Default) on an enum does not bound its
 type params

For `#[derive(Default)] enum Maybe<T> { #[default] Absent, Present(T) }`
the derive generated `impl<T: Default> Default for Maybe<T>`, as it does
for structs.  rustc puts no such bound on an enum with a `#[default]`
variant (rustc_builtin_macros deriving/default.rs, skip_path_as_bound):
the default variant is a unit variant, so nothing needs one.  With
`Relation: !Default`, `Maybe<Relation>::default()` then found no impl:
ast-grep-config 0.45.3 maybe.rs:5 (ast-grep 0.45.3) "Failed to find impl
with 'default' for Maybe<Relation>".

The enum impl now bounds only the default variant's field types.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/expand/derive.cpp b/src/expand/derive.cpp
index d37b57b3..b43d9b45 100644
--- a/src/expand/derive.cpp
+++ b/src/expand/derive.cpp
@@ -1241,7 +1241,7 @@ class Deriver_Default:
         return AST::Path::new_ufcs_trait( ::TypeRef(Span()), get_trait_path(core_name), { AST::PathNode(RcString::new_interned("default"), {}) } );
     }
 
-    AST::Impl make_ret(Span sp, const RcString& core_name, const AST::GenericParams& p, const TypeRef& type, ::std::vector<TypeRef> types_to_bound, AST::ExprNodeP node) const
+    AST::Impl make_ret(Span sp, const RcString& core_name, const AST::GenericParams& p, const TypeRef& type, ::std::vector<TypeRef> types_to_bound, AST::ExprNodeP node, bool bound_type_params=true) const
     {
         const AST::Path    trait_path = this->get_trait_path(core_name);
 
@@ -1252,7 +1252,20 @@ class Deriver_Default:
             );
         fcn.set_code( NEWNODE(Block, mv$(node)) );
 
-        AST::GenericParams  params = get_params_with_bounds(sp, p, trait_path, mv$(types_to_bound));
+        AST::GenericParams  params;
+        if( bound_type_params ) {
+            params = get_params_with_bounds(sp, p, trait_path, mv$(types_to_bound));
+        }
+        else {
+            // An enum with a `#[default]` variant: rustc puts no `T: Default` bound on the type params (the default
+            // variant is a unit variant, so nothing needs one) - rustc_builtin_macros deriving/default.rs
+            // `skip_path_as_bound`. ast-grep-config 0.45.3 `#[derive(Default)] enum Maybe<T> { #[default] Absent,
+            // Present(T) }` used as `Maybe<Relation>::default()` with `Relation: !Default`.
+            params = p.clone();
+            for(auto& ty : types_to_bound) {
+                params.add_bound( ::AST::GenericBound::make_IsTrait({ sp, {}, mv$(ty), {}, trait_path }) );
+            }
+        }
 
         AST::Impl   rv( AST::ImplDef( mv$(params), make_spanned(sp, trait_path), type.clone() ) );
         rv.add_function(sp, {}, AST::Visibility::make_bare_private(), false, RcString::new_interned("default"), mv$(fcn));
@@ -1355,7 +1368,7 @@ public:
             node = NEWNODE(StructLiteralPattern, std::move(var_path), mv$(vals));
             }
         }
-        return this->make_ret(sp, opts.core_name, p, type, std::move(bound_tys), std::move(node));
+        return this->make_ret(sp, opts.core_name, p, type, std::move(bound_tys), std::move(node), /*bound_type_params=*/false);
     }
 } g_derive_default;
 
