From 47a4faf3e4b695596a1c5b599e82d0131062cb30 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 14 Oct 2026 19:59:20 +0000
Subject: [PATCH 241/241] hir_typeck: Index waits while a fuzzy impl's bound is
 on an unknown value-type parameter

orz 1.6.2 huffman.rs:151, with `decodings: Vec<u16>` and unchecked-index
0.2.2's `impl<T, I> Index<I> for UncheckedIndex<T> where T: GetUnchecked<I>`:

    unchecked_index(&mut decodings)[bits] = symbol;

    error:0: Failed to find an impl of GetUnchecked<_> for &mut Vec<u16> with Output = _

`unchecked_index`'s `T` was still the ivar of the pending `&mut Vec<u16>`
argument coercion when the index node was visited. The impl's bound on
`T` could only be "assumed fuzzy", the node committed to that single
impl (an Output rule), and the bound failed once `T` was known: Vec has
no GetUnchecked impl. rustc unifies the argument first, rejects the impl
and autoderefs to Vec's IndexMut.

With a single fuzzy impl, the index node now checks the impl's trait
bounds: one on a type parameter that is still a bare ivar taken from the
indexed value (not the index type, `v[i]` with `i` unknown is unchanged)
means the impl can't be judged yet, so the node is revisited later;
fallback mode commits as before.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs.cpp | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 6f0ceaae..c8cb8c42 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -516,6 +516,13 @@ namespace {
                 ::HIR::TypeRef  possible_index_type;
                 ::HIR::TypeRef  possible_res_type;
                 unsigned int count = 0;
+                // A fuzzy impl whose where-clause is on a type parameter that is still a bare ivar from the indexed value
+                // (not from the index) tells nothing yet: `impl<T, I> Index<I> for UncheckedIndex<T> where T: GetUnchecked<I>`
+                // matched `UncheckedIndex<_>` (the `_` still a coercion from `&mut Vec<u16>`), got committed to, and the
+                // bound then failed for `&mut Vec<u16>` - rustc knows `T` by then and autoderefs on to `Vec`'s Index.
+                // orz 1.6.2 huffman.rs:151 `unchecked_index(&mut decodings)[bits] = symbol`, "Failed to find an impl of
+                // GetUnchecked<_> for &mut Vec<u16>"
+                bool bound_on_unknown_value_param = false;
                 bool rv = this->context.m_resolve.find_trait_impls(node.span(), lang_Index, trait_pp, ty, [&](auto impl, auto cmp) {
                     DEBUG("[visit(_Index)] cmp=" << cmp << " - " << impl);
                     possible_res_type = impl.get_type("Output", {});
@@ -524,6 +531,27 @@ namespace {
                         return true;
                     }
                     possible_index_type = impl.get_trait_ty_param(0);
+                    if( const auto* ie = impl.m_data.opt_TraitImpl() ) {
+                        if( ie->impl ) {
+                            for(const auto& b : ie->impl->m_params.m_bounds) {
+                                if( !b.is_TraitBound() )
+                                    continue ;
+                                const auto* ge = b.as_TraitBound().type.data().opt_Generic();
+                                if( !ge || ge->group() != 0 || ge->idx() >= ie->impl_params.m_types.size() )
+                                    continue ;
+                                const auto* bte = this->context.get_type(ie->impl_params.m_types[ge->idx()]).data().opt_Infer();
+                                if( !bte )
+                                    continue ;
+                                // The index type itself (`v[i]` with `i` not known yet) is fine, as before
+                                if( const auto* idx_ie = idx_ty.data().opt_Infer() ) {
+                                    if( idx_ie->index == bte->index )
+                                        continue ;
+                                }
+                                DEBUG("[visit(_Index)] bound " << b.as_TraitBound().type << ": " << b.as_TraitBound().trait << " on a still-unknown param " << ie->impl_params.m_types[ge->idx()]);
+                                bound_on_unknown_value_param = true;
+                            }
+                        }
+                    }
                     return false;
                     });
                 if( rv ) {
@@ -540,6 +568,10 @@ namespace {
                 }
                 else if( count == 1 ) {
                     assert( possible_index_type != ::HIR::TypeRef() );
+                    if( bound_on_unknown_value_param && !this->m_is_fallback ) {
+                        DEBUG("Single fuzzy impl with a bound on a still-unknown parameter of " << ty << ", wait");
+                        return ;
+                    }
                     this->context.equate_types_assoc(node.span(), node.m_res_type,  lang_Index, mv$(trait_pp), ty, "Output", {}, false);
                     break;
                 }
