From 86264ca46a633567ac660c71361f7d40493e6997 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 07:54:34 +0000
Subject: [PATCH 53/59] minicargo: activate a package's `default` feature
 itself, like cargo

With default features enabled, minicargo activated the entries of the
`[features] default` list but never `default` itself, so packages never
saw `feature="default"` (or CARGO_FEATURE_DEFAULT in build scripts).
cargo activates it whenever the package defines it, even as
`default = []`. document-features 0.2.11 (via sig) checks exactly that:

    #[cfg(not(feature = "default"))]
    compile_error!("The feature `default` must be enabled ...");

Activate `default` when the manifest defines it and let the feature
loop expand its entries like any other feature's. That also fixes
`dep/feat` entries in a `default` list: they were activated as literal
feature names, so the dependency's feature was never enabled (only the
`dep/default` path from 12c9cc82 expanded them).

Crate tags don't change: they only hash the named features, which
don't include `default`.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tools/minicargo/manifest.cpp | 26 ++++++++++----------------
 tools/minicargo/manifest.h   |  2 ++
 2 files changed, 12 insertions(+), 16 deletions(-)

diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index 66d5df1c..31743117 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -886,6 +886,7 @@ void PackageManifest::fill_from_kv(ErrorHandler& eh, const WorkspaceManifest* wm
             ::std::vector<::std::string>*   list;
             if(name == "default") {
                 list = &rv.m_default_features;
+                rv.m_has_default_feature = true;
             }
             else {
                 auto tmp = rv.m_features.insert(::std::make_pair(name, ::std::vector<::std::string>()));
@@ -1257,22 +1258,6 @@ void PackageManifest::set_features(const ::std::vector<::std::string>& features,
     TRACE_FUNCTION_F(m_name << " [" << features << "] " << enable_default);
 
     size_t start = m_active_features.size();
-    // 1. Install default features.
-    if(enable_default)
-    {
-        DEBUG("Including default features [" << m_default_features << "]");
-        for(const auto& feat : m_default_features)
-        {
-            auto it = ::std::find(m_active_features.begin(), m_active_features.end(), feat);
-            if(it != m_active_features.end()) {
-                DEBUG("`" << feat << "` already active");
-                continue ;
-            }
-            DEBUG("`" << feat << "` activated");
-            m_active_features.push_back(feat);
-            m_dependencies_loaded = false;
-        }
-    }
 
     auto add_feature = [&](const auto& feat) {
         auto it = ::std::find(m_active_features.begin(), m_active_features.end(), feat);
@@ -1285,6 +1270,15 @@ void PackageManifest::set_features(const ::std::vector<::std::string>& features,
             m_dependencies_loaded = false;
         }
         };
+    // 1. Install default features.
+    // - Like cargo, activate `default` itself (so `feature="default"` is set even for `default = []`, e.g.
+    //   document-features 0.2.11 has `#[cfg(not(feature = "default"))] compile_error!(...)`), its contents are
+    //   expanded below like any other feature.
+    if(enable_default && m_has_default_feature)
+    {
+        DEBUG("Including default features [" << m_default_features << "]");
+        add_feature(::std::string("default"));
+    }
     for(const auto& feat : features)
     {
         add_feature(feat);
diff --git a/tools/minicargo/manifest.h b/tools/minicargo/manifest.h
index 84e25de7..e22b2e05 100644
--- a/tools/minicargo/manifest.h
+++ b/tools/minicargo/manifest.h
@@ -400,6 +400,8 @@ class PackageManifest
 
     ::std::map<::std::string, ::std::vector<::std::string>>    m_features;
     ::std::vector<::std::string>    m_default_features;
+    /// `[features] default` is present (even if empty), so `default` itself is a feature that gets activated
+    bool    m_has_default_feature = false;
     ::std::vector<::std::string>    m_active_features;
     AllowedCfg  m_lint_check_cfg;
 
