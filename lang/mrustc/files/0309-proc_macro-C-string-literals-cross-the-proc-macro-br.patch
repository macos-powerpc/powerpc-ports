+mod literal_tests {
+    use crate::*;
+
+    #[test]
+    fn c_string()
+    {
+        // A C string goes as tag 14 and its bytes (no NUL), both ways (`c"seed"` in openssl's `#[corresponds]` items)
+        let lit = Literal::c_string(::std::ffi::CStr::from_bytes_with_nul(b"se\xffd\0").unwrap());
+        let ts: TokenStream = vec![TokenTree::from(lit), Literal::string("s").into()].into_iter().collect();
+        let mut out = Vec::new();
+        super::send_token_stream(&mut out, ts.clone());
+        assert_eq!(&out[..6], &[14, 4, b's', b'e', 0xff, b'd']);
+        let rv = super::recv_token_stream(&out[..]);
+        assert_eq!(rv.to_string(), ts.to_string());
+        assert!(rv.to_string().starts_with("c\"se\\xffd\""), "{}", rv);
+    }
+}
