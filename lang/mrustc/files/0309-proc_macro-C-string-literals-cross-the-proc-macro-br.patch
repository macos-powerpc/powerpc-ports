+        assert_tt_matches!(it.next(), cstr(b"a\xff\xc3\xa9\xc3\xa9\0"));
+        assert_tt_matches!(it.next(), cstr(b"x\\y\0"));
+        assert_tt_matches!(it.next(), cstr(b"q\"r\0"));
+        assert_tt_matches!(it.next(), Ident::new("c", Span::call_site()).into());
+        assert_tt_matches!(it.next(), Ident::new("crate", Span::call_site()).into());
+        assert_tt_matches!(it.next(), Ident::new("cx", Span::call_site()).into());
+        assert_tt_matches!(it.next(), Literal::string("a").into());
+        assert_tt_matches!(it.next(), Literal::string("b\"").into());
+        assert_tt_matches!(it.next(), Literal::byte_string(b"c").into());
+        assert_tt_matches!(it.next(), Ident::new("x", Span::call_site()).into());
+        assert_tt_matches!(it.next());
+        // Printed C strings lex back to the same bytes
+        let lit = cstr(b"a\xff\xc3\xa9\"\\\x01{\0");
+        let back = TokenStream::from_str(&lit.to_string()).expect("Failed to parse a printed C string");
+        let mut it = back.inner.into_iter();
+        assert_tt_matches!(it.next(), lit);
+        assert_tt_matches!(it.next());
+    }
 }
