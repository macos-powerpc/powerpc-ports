+    #[test]
+    fn c_and_raw_strings()
+    {
+        // In a C string `\x` escapes are bytes, `\u{..}` and other characters UTF-8; `c`/`cr` not starting a
+        // string are identifiers. A raw string ends at the `"` followed by its hashes, and the next token after that.
+        let rv = TokenStream::from_str(r##"c"a\xff\u{e9}é" cr"x\y" cr#"q"r"# c crate cx r"a" r#"b""# br"c" x"##).expect("Failed to parse");
+        let cstr = |b: &[u8]| -> TokenTree { Literal::c_string(::std::ffi::CStr::from_bytes_with_nul(b).unwrap()).into() };
