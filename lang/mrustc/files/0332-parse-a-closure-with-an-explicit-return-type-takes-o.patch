From 223233d2e961aefd78b08750ec3e56ad4bfafdab Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 09:44:17 +0000
Subject: [PATCH] parse: a closure with an explicit return type takes only the block
 as its body, so `|| -> T { .. }()` calls the closure

cryptography-rust 48.0.0 (py314-cryptography) src/pkcs12.rs:276, `#[derive(pyo3::FromPyObject)] enum
CertificateOrPKCS12Certificate { Certificate(Py<Certificate>), PKCS12Certificate(Py<PKCS12Certificate>) }`:
    pkcs12.rs:276:10-30 error:0: Unable to find an implementation of Fn*<(),> for
    ::"core-0_0_0"::result::Result<_/*81*/,::"pyo3-0_28_3_H20080000001"::err::PyErr,>

pyo3-macros-backend 0.28.3 frompyobject.rs (Enum::build) emits, per variant,
    let maybe_ret = || -> PyResult<Self> { extract_tuple_struct_field(obj, "Certificate", 0).map(Self::Certificate) }();
rustc parses a closure with an explicit return type as the block and nothing more (RFC 968,
parse_expr_closure), so the trailing `()` is a postfix call of the closure and `maybe_ret` is its
result. Parse_ExprVal_Closure always took a whole expression as the body, so the body became
`{ .. }()`: a call of the block's `Result` value.

Fix: with a return type and a `{` (or an interpolated block) next, the body is Parse_ExprBlockNode;
the closure is then the value Parse_ExprFC's postfix loop continues from. Without a return type the
body stays a whole expression (`|| { .. }()` calls the block's value, as in rustc). The AST printer
already parenthesises call targets, so attribute-macro output is unchanged in meaning.

Assisted-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index 160d04bf..4c87b7e5 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -1379,12 +1379,22 @@ ExprNodeP Parse_ExprVal_Closure(TokenStream& lex)
     }
 
     auto rt = TypeRef(lex.point_span());
+    bool has_rt = false;
     if( lex.getTokenIf(TOK_THINARROW) ) {
-
         rt = Parse_Type(lex);
+        has_rt = true;
     }
 
-    auto code = Parse_Expr0(lex);
+    // With an explicit return type the body is the block and nothing more (rustc, RFC 968), so what follows applies
+    // to the closure: `|| -> PyResult<Self> { .. }()` calls it (pyo3 0.28's FromPyObject derive for enums). Without
+    // one the body is a whole expression, so `|| { .. }()` there calls the block's value, as in rustc.
+    ExprNodeP   code;
+    if( has_rt && (lex.lookahead(0) == TOK_BRACE_OPEN || lex.lookahead(0) == TOK_INTERPOLATED_BLOCK) ) {
+        code = Parse_ExprBlockNode(lex);
+    }
+    else {
+        code = Parse_Expr0(lex);
+    }
 
     return NEWNODE( AST::ExprNode_Closure, ::std::move(args), ::std::move(rt), ::std::move(code), is_move, is_immovable );
 }
