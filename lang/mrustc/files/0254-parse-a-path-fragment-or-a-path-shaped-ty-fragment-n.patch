From 8fe97071f1d3be23426731783a2b9c8ed7c42905 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 10:48:51 +0000
Subject: [PATCH 254/255] parse: a `:path` fragment, or a path-shaped `:ty`
 fragment, names an attribute

icu_locale_core 2.3.0 (tree-sitter-cli 0.27.1),
preferences/extensions/unicode/keywords/collation.rs:44-60:

    MACRO<..::__enum_keyword> error:0: No #[default] attribute on enum
    with derive(Default)

macros/enum_keyword.rs writes `$([$variant_attr:ty])?` back as
`#[$variant_attr]` (and `$([$derive_attrs:ty])?` as
`#[derive($derive_attrs)]`, which derive.cpp already understood); the
collation keyword passes `[Default]` and `[default]`. rustc's attribute
parser (parse_path) accepts an interpolated path, or an interpolated type
that is a plain path, as the attribute name. Parse_MetaItem sent every
non-ident token into the 1.29+ "value with no name" case, so the variant
carried a nameless `= default` attribute and the derive found no
`#[default]`.

Parse_MetaItem now turns TOK_INTERPOLATED_PATH, or a TOK_INTERPOLATED_TYPE
holding a Relative/Absolute path without generic arguments, into the
AttributeName; the attribute body (`= ..`, `(..)`, `[..]`, none) parses as
before. Any other `:ty` is rejected (rustc: expected identifier) where it
used to be accepted silently.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 7e7cedcf..d54dfc72 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1186,8 +1186,35 @@ AST::Attribute Parse_MetaItem(TokenStream& lex)
     auto ps = lex.start_span();
 
     AST::AttributeName  name;
+    // A `:path` fragment, or a `:ty` fragment that is a plain path, names the attribute (rustc's parse_path takes
+    // both in meta position): icu_locale_core 2.3.0 enum_keyword.rs `$([$variant_attr:ty])?` written back as
+    // `#[$variant_attr]` with `[default]` (keywords/collation.rs). Before, the interpolated token fell into the
+    // nameless `= value` case below and `#[derive(Default)]` found no `#[default]`.
+    if( lex.lookahead(0) == TOK_INTERPOLATED_PATH || lex.lookahead(0) == TOK_INTERPOLATED_TYPE )
+    {
+        GET_TOK(tok, lex);
+        const AST::Path* path = nullptr;
+        if( tok.type() == TOK_INTERPOLATED_PATH ) {
+            path = &tok.frag_path();
+        }
+        else if( tok.frag_type().is_path() ) {
+            path = &tok.frag_type().path();
+        }
+        if( !path || !(path->m_class.is_Relative() || path->m_class.is_Absolute()) ) {
+            throw ParseError::Unexpected(lex, tok);
+        }
+        name.has_leading = path->m_class.is_Absolute();
+        for(const auto& node : path->nodes())
+        {
+            if( !node.args().is_empty() ) {
+                throw ParseError::Unexpected(lex, tok);
+            }
+            name.elems.push_back( node.name() );
+        }
+        GET_TOK(tok, lex);
+    }
     // NOTE: After 1.19 mode, values can be present with no name
-    if( TARGETVER_LEAST_1_29
+    else if( TARGETVER_LEAST_1_29
         && lex.lookahead(0) != TOK_IDENT
         && lex.lookahead(0) != TOK_DOUBLE_COLON
         && lex.lookahead(0) < TOK_RWORD_PUB
