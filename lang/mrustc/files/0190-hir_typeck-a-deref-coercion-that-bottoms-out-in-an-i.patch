From da1ee95c7c8d49f6a6501d09d6767f18fbcdb26a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 13:12:15 +0000
Subject: [PATCH 190/190] hir_typeck: a deref coercion that bottoms out in an ivar
 proposes the right destination

When the source of a coercion dereferences to an inference variable
(`&mut Box<_>` from `bytemuck::zeroed_box()` passed where `&mut [[u32;
257]; 4]` is expected), check_unsize_tys offers the ivar the destination
dereferenced `count - 1` times.  The loop evaluated one autoderef before
testing its bound, so with a single deref it offered the array's unsize
step `[[u32; 257]]` (unsized, discarded) and never the array; the
coercion was finally equated and failed: quantette 0.6.0
quantize/dedup.rs:189 (skim 5.7.3) "Type mismatch between [[u32; 257];
4] and Box<_, Global>".

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 49e52dc9..e68bcfaf 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -4379,11 +4379,17 @@ namespace {
                         if( context_mut )
                         {
                             // Could also be any deref chain of the destination type
+                            // - The ivar sits `count` derefs below the source, so it matches the destination
+                            //   dereferenced `count - 1` times. The loop took one step too many: `&mut Box<_>` to
+                            //   `&mut [[u32; 257]; 4]` offered the ivar `[[u32; 257]]` (the array's unsize step) and
+                            //   never the array, so the coercion was finally equated and failed: quantette 0.6.0
+                            //   dedup.rs:189 `let mut red_prefix = bytemuck::zeroed_box(); chunked_u8_counts::<4>(.., &mut red_prefix)`
                             ::HIR::TypeRef  tmp_ty2;
                             const ::HIR::TypeRef* d_ty_p = &dst;
                             //context_mut->possible_equate_ivar(sp, sep->index, dst, Context::PossibleTypeSource::UnsizeTo);
-                            for(unsigned int i = 0; (d_ty_p = context.m_resolve.autoderef(sp, *d_ty_p, tmp_ty2)) && i < count - 1; i ++)
+                            for(unsigned int i = 0; d_ty_p && i < count - 1; i ++)
                             {
+                                d_ty_p = context.m_resolve.autoderef(sp, *d_ty_p, tmp_ty2);
                             }
                             if( d_ty_p )
                             {
