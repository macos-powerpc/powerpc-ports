From 5d4552adc2e7456f5e5aeb2e1e7325492199634f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 18:15:22 +0000
Subject: [PATCH 268/268] hir_conv: the constant evaluator switches on signed
 integer values

Found by the pat-fragment-edition kit: a constant whose `match` compares a SIGNED integer
against several literal arms (`match x { 1 | 5 => .., _ => .. }` lowers to a SwitchValue with
Signed values) aborted in Constant Evaluate with
"MIR TODO: src/hir_conv/constant_evaluation.cpp:2565: SwitchValue - Signed"; the evaluator
only had the Unsigned arm. The Signed arm reads the value sign-extended (read_sint) and
compares it against each S128(value).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index c21c2df1..e34f301a 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -2572,6 +2572,17 @@ namespace HIR {
                     }
                 }
                 }
+            // A `match` on a signed integer with more than one literal arm (`match x { 1 | 5 => .., _ => .. }`)
+            // in a constant: the same search, sign-extended (`-1i32` is `S128(-1)`, not `0xFFFFFFFF`).
+            TU_ARMA(Signed, vals) {
+                auto v = lit.read_sint(state, ti.bits);
+                for(size_t i = 0; i < vals.size(); i ++) {
+                    if(v.get_inner() == S128(vals[i]).get_inner()) {
+                        target_idx = i;
+                        break;
+                    }
+                }
+                }
             }
             if( target_idx == ~0u ) {
                 return e.def_target;
