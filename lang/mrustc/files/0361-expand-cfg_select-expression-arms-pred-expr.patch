From 7d923047e330b36dc32e69094ee05bb6f4c69596 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 21 Oct 2026 23:22:48 +0000
Subject: [PATCH 361/361] expand: cfg_select! expression arms `pred => expr,`

rustyline 19.0.0 src/completion.rs:413 (fend 1.5.9):
    cfg_select! {
        windows => Owned(s.to_lowercase()), // case-insensitive
        target_os = "macos" => Owned(s.to_lowercase()), // case-insensitive
        _ => Cow::Borrowed(s),
    }
= "completion.rs:414:27 error:0: Unexpected token TOK_PAREN_OPEN, expected TOK_IDENT". mrustc's builtin cfg_select!
took one token tree after each `=>` (the braced form `pred => { tokens }`), so the arm was `Owned` and `(..)` the
next predicate. An arm may also be an expression followed by a comma (optional after the last arm).

A braced arm is unchanged (its tokens are the expansion; a following comma is now accepted); any other arm is parsed
with the expression parser, so commas inside the expression (closure parameters, generic arguments) don't end it,
and the chosen one is returned as an interpolated expression. "cfg_select - Nothing matched" is now reached at the end
of the input (it was an "Unexpected token EOF" before).

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/expand/cfg.cpp b/src/expand/cfg.cpp
index 934b0561..08c8ce79 100644
--- a/src/expand/cfg.cpp
+++ b/src/expand/cfg.cpp
@@ -14,6 +14,7 @@
 #include <ast/crate.hpp>
 #include <ast/attrs.hpp>
 #include <parse/parseerror.hpp>
+#include <parse/interpolated_fragment.hpp>
 
 #include <map>
 #include <set>
@@ -226,16 +227,33 @@ class CCfgSelectExpander:
     {
         DEBUG("cfg_select!() - " << tt);
         auto lex = TTStream(sp, ParseState(), tt);
-        for(;;)
+        while( lex.lookahead(0) != TOK_EOF )
         {
             bool rv = lex.getTokenIf(TOK_UNDERSCORE) || check_cfg_inner(lex);
             lex.getTokenCheck(TOK_FATARROW);
-            auto t = Parse_TT(lex, true);
-            if(rv) {
-                return box$( TTStreamO(sp, ParseState(), std::move(t)) );
+            // An arm is `pred => { tokens }` (the tokens are the expansion), or an expression arm `pred => expr,`
+            // (the comma optional after the last arm): rustyline 19.0.0 completion.rs:413 `cfg_select! { windows =>
+            // Owned(s.to_lowercase()), target_os = "macos" => .., _ => Cow::Borrowed(s), }`. The expression goes through
+            // the expression parser, so commas inside it (closure parameters, generic arguments) don't end the arm.
+            if( lex.lookahead(0) == TOK_BRACE_OPEN )
+            {
+                auto t = Parse_TT(lex, true);
+                lex.getTokenIf(TOK_COMMA);
+                if(rv) {
+                    return box$( TTStreamO(sp, ParseState(), std::move(t)) );
+                }
+            }
+            else
+            {
+                auto e = Parse_Expr0(lex);
+                if( lex.lookahead(0) != TOK_EOF ) {
+                    lex.getTokenCheck(TOK_COMMA);
+                }
+                if(rv) {
+                    return box$( TTStreamO(sp, ParseState(), TokenTree(Token( InterpolatedFragment(InterpolatedFragment::EXPR, e.release()) ))) );
+                }
             }
         }
-        lex.getTokenCheck(TOK_EOF);
 
         ERROR(sp, E0000, "cfg_select - Nothing matched");
     }
