From e96a7be27be7f0896a6bd39f7ffbb3426b5bc01c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 23:13:15 +0000
Subject: [PATCH] parse: a match arm guard may hold a struct literal (it was
 parsed like an `if` condition)

librsvg 2.58.5 (the Rust librsvg port), compiling the rsvg crate:

    rsvg/src/xml/mod.rs:460:1 error:0: Unexpected token TOK_BRACE_OPEN, expected TOK_FATARROW

xinclude_start_element matches an attribute's expanded name:

    match attr.expanded() {
        expanded_name!("", "href") => href = Some(value),
        ref v
            if *v
                == ExpandedName {
                    ns: &ns!(),
                    local: &ln_parse,
                } =>
        {
            parse = Some(value)
        }
        ...

Parse_Expr_Match parsed the guard with Parse_IfLetChain, the `if`/`while`
condition parser, which sets disallow_struct_literal for every operand of the
chain (in a condition, `if a == b {` must open the block). A guard ends with
`=>`, so rustc parses it without NO_STRUCT_LITERAL
(parse_match_guard_condition) and `ExpandedName { .. }` is a struct literal
there.

Parse_IfLetChain takes an allow_struct_literal switch: the `if`/`while`
callers pass false, the match arm passes true, and the three operand parses
(a `let` right-hand side, a plain operand, the `||` fallback) set the flag from it.

Kit guard-struct-literal-test (no_core lib + main.c, 20 checks, plain and -O):
the librsvg shape, `||` chains of two and three literals, `&&` chains with
a functional-update literal, the match inside an `if` condition, a literal in
a call argument. 0403 fails to build it with the error above; passes now.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index e72e497b..0f0c5133 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -489,7 +489,9 @@ ExprNodeP Parse_ExprBlockLine_Stmt(TokenStream& lex, bool& has_semicolon)
     return ret;
 }
 
-std::vector<AST::IfLet_Condition> Parse_IfLetChain(TokenStream& lex)
+/// `if`/`while` condition (no struct literal: `if a == b {` opens the block) or a match arm guard
+/// (`allow_struct_literal`: `=>` ends it, so `ref v if *v == Name { ns: .., local: .. } =>` is a struct literal, as in rustc)
+std::vector<AST::IfLet_Condition> Parse_IfLetChain(TokenStream& lex, bool allow_struct_literal)
 {
     // A fresh expression: `Parse_Stmt` disallows a call/index after a statement-like `if`/`while` (`if c {} [0]`), but
     // that flag is for the token after the block, not for the condition (restored on return)
@@ -506,7 +508,7 @@ std::vector<AST::IfLet_Condition> Parse_IfLetChain(TokenStream& lex)
             GET_CHECK_TOK(tok, lex, TOK_EQUAL);
             ExprNodeP val;
             {
-                SET_PARSE_FLAG(lex, disallow_struct_literal);
+                SavedParseState _sps(lex, lex.parse_state()); lex.parse_state().disallow_struct_literal = !allow_struct_literal;
                 val = Parse_Expr3(lex); // This is just after `||` and `&&`
             }
             conditions.push_back(AST::IfLet_Condition { box$(pat), std::move(val) });
@@ -515,7 +517,7 @@ std::vector<AST::IfLet_Condition> Parse_IfLetChain(TokenStream& lex)
         else {
             ExprNodeP val;
             {
-                SET_PARSE_FLAG(lex, disallow_struct_literal);
+                SavedParseState _sps(lex, lex.parse_state()); lex.parse_state().disallow_struct_literal = !allow_struct_literal;
                 val = Parse_Expr3(lex); // This is just after `||` and `&&`
             }
 
@@ -543,7 +545,7 @@ std::vector<AST::IfLet_Condition> Parse_IfLetChain(TokenStream& lex)
                 prev = NEWNODE(AST::ExprNode_BinOp, AST::ExprNode_BinOp::BOOLAND, ::std::move(prev), ::std::move(conditions[i].value));
             }
             GET_CHECK_TOK(tok, lex, TOK_DOUBLE_PIPE);
-            SET_PARSE_FLAG(lex, disallow_struct_literal);
+            SavedParseState _sps(lex, lex.parse_state()); lex.parse_state().disallow_struct_literal = !allow_struct_literal;
             auto n = Parse_Expr1_5(lex);    // Boolean or
             auto rv = NEWNODE( AST::ExprNode_BinOp, AST::ExprNode_BinOp::BOOLOR, ::std::move(prev), ::std::move(n) );
 
@@ -558,7 +560,7 @@ std::vector<AST::IfLet_Condition> Parse_IfLetChain(TokenStream& lex)
 /// While loop (either as a statement, or as part of an expression)
 ExprNodeP Parse_WhileStmt(TokenStream& lex, Ident lifetime)
 {
-    auto conditions = Parse_IfLetChain(lex);
+    auto conditions = Parse_IfLetChain(lex, /*allow_struct_literal=*/false);
     return NEWNODE( AST::ExprNode_While, lifetime, ::std::move(conditions), Parse_ExprBlockNode(lex) );
 }
 /// For loop (either as a statement, or as part of an expression)
@@ -591,7 +593,7 @@ ExprNodeP Parse_IfStmt(TokenStream& lex)
 
         {
             SET_PARSE_FLAG(lex, disallow_struct_literal);
-            conditions = Parse_IfLetChain(lex);
+            conditions = Parse_IfLetChain(lex, /*allow_struct_literal=*/false);
         }
 
         // Contents
@@ -654,7 +656,7 @@ ExprNodeP Parse_Expr_Match(TokenStream& lex)
 
         if( tok.type() == TOK_RWORD_IF )
         {
-            arm.m_guard = Parse_IfLetChain(lex);
+            arm.m_guard = Parse_IfLetChain(lex, /*allow_struct_literal=*/true);
             GET_TOK(tok, lex);
         }
         CHECK_TOK(tok, TOK_FATARROW);
