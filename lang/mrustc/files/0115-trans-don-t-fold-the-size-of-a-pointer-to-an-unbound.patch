From e49df2524e019f4329fcb89749936a6ac952fc0e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 11:53:08 +0000
Subject: [PATCH 115/115] trans: don't fold the size of a pointer to an unbounded
 `Self` before monomorphisation

In a trait's provided methods the generic passes give `Self` trait-object
metadata (visit_crate_mir sets it for trait items), so
Target_GetSizeAndAlignOf sized `&Self` / `*const Self` as fat pointers and
MIR optimisation folded `size_of::<&Self>()` to two pointers, for every
implementor, sized ones included (16 instead of 8 on x86_64, 8 instead of
4 on ppc; with and without -O). Pre-existing; 0114 made it reachable
through method lookup, e.g. a blanket `impl<T> Name for T` using
size_of::<T>() called on `self` in a provided method now resolves to
`<&Self as Name>`.

A pointer to `Self` whose metadata isn't None/Zero (i.e. no `Sized` bound)
now has no size until monomorphised. The trait-object view of `Self` is
left alone for the other uses.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/trans/target.cpp | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/src/trans/target.cpp b/src/trans/target.cpp
index 4fad78b5..a36cc036 100644
--- a/src/trans/target.cpp
+++ b/src/trans/target.cpp
@@ -761,6 +761,16 @@ void Target_SetCfg(const ::std::string& target_name)
         });
 }
 
+namespace {
+    /// `Self` in a trait's provided method has the trait-object metadata the generic passes give it (see
+    /// `visit_crate_mir`), but without a `Sized` bound it can be implemented by sized types too, so the size of
+    /// a pointer to it is only known once monomorphised. (A `Sized` bound makes the metadata `None`.)
+    /// - `size_of::<&Self>()` in a provided method was folded to two pointers for every implementor
+    bool pointee_is_unbounded_self(const ::HIR::TypeRef& inner, MetadataType md)
+    {
+        return inner.data().is_Generic() && inner.data().as_Generic().is_self() && md != MetadataType::None && md != MetadataType::Zero;
+    }
+}
 bool Target_GetSizeAndAlignOf(const Span& sp, const StaticTraitResolve& resolve, const ::HIR::TypeRef& ty, size_t& out_size, size_t& out_align)
 {
     //TRACE_FUNCTION_FR(ty, "size=" << out_size << ", align=" << out_align);
@@ -921,7 +931,10 @@ bool Target_GetSizeAndAlignOf(const Span& sp, const StaticTraitResolve& resolve,
         out_align = g_target.m_arch.m_pointer_bits / 8;
         // - Size depends on Sized-nes of the parameter
         // TODO: Handle different types of Unsized (ones with different pointer sizes)
-        switch(resolve.metadata_type(sp, te.inner))
+        auto md = resolve.metadata_type(sp, te.inner);
+        if( pointee_is_unbounded_self(te.inner, md) )
+            return false;
+        switch(md)
         {
         case MetadataType::Unknown:
             return false;
@@ -940,7 +953,10 @@ bool Target_GetSizeAndAlignOf(const Span& sp, const StaticTraitResolve& resolve,
         // - Alignment is machine native
         out_align = g_target.m_arch.m_pointer_bits / 8;
         // - Size depends on Sized-nes of the parameter
-        switch(resolve.metadata_type(sp, te.inner))
+        auto md = resolve.metadata_type(sp, te.inner);
+        if( pointee_is_unbounded_self(te.inner, md) )
+            return false;
+        switch(md)
         {
         case MetadataType::Unknown:
             return false;
