From f6c16bd247e42fe2d1ad9e25b361d28608183690 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 22:58:55 +0000
Subject: [PATCH 76/76] hir: convert `path` and `vis` fragments left in a
 nested macro_rules body to tokens

yansi 1.0.1 src/macros.rs `define_property!` writes a `$V:path` capture into the body of
the `macro_rules! $kind` it defines. When HIR lowering flattens such interpolated
fragments back into tokens so the macro can be serialised (`fix_macro_contents`), only
`ty`, `meta` and simple `expr` fragments were handled:

    BUG: src/hir/from_ast.cpp:2847: TODO: emit_token - Convert interpolated macro fragment:
    TOK_INTERPOLATED_PATH:/*2*/Color::Primary/*?*/

Handle `path` the way `ty` already is (print, re-lex), and `vis` through its printer.
Two supporting fixes:

- `emit_path` now prints the plain form instead of the debug form, which wrapped the
  hygiene and the bindings in comments. That exposed that the re-lexing dropped
  an identifier running into end-of-input (`u8` from a `$t:ty` came back as nothing, and
  an exported macro's `-> $t {` then failed to parse in the using crate); the debug form had
  only survived thanks to its trailing `/*?*/`. `emit_from_string` terminates the text.
- `Token::clone` had no case for `TOK_INTERPOLATED_VIS`, so a `$v:vis` written into
  a nested macro body aborted with "Fragment with invalid token type" before lowering was
  reached. Visibility is copyable; clone it.

Checked: the yansi shape locally; `#[macro_export]` macros carrying a converted `path`
and `ty` used from another crate (the call resolves to the defining crate's item);
a `vis` fragment in a nested body.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir/from_ast.cpp | 18 ++++++++++++++----
 src/parse/token.cpp  |  3 +++
 2 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/src/hir/from_ast.cpp b/src/hir/from_ast.cpp
index db911d9c..d295a80d 100644
--- a/src/hir/from_ast.cpp
+++ b/src/hir/from_ast.cpp
@@ -2786,7 +2786,8 @@ public:
                             std::vector<MacroExpansionEnt>  out;
                             void emit_from_string(const std::string& s)
                             {
-                                ::std::istringstream    iss { s };
+                                // The lexer drops an identifier that runs into end-of-input, so terminate the text
+                                ::std::istringstream    iss { s + "\n" };
                                 Lexer   l { iss, AST::Edition::Rust2021, {} };
                                 for(;;) {
                                     auto t = l.getToken();
@@ -2810,7 +2811,9 @@ public:
                             }
                             void emit_path(const ::AST::Path& path) {
                                 ::std::stringstream ss;
-                                ss << path;
+                                // Plain form: the debug form wraps hygiene and bindings in comments, which the lexer
+                                // would only have to skip again
+                                path.print_pretty(ss, /*is_type_context*/false, /*is_debug*/false);
                                 emit_from_string(ss.str());
                             }
                             void emit_type(::TypeRef& ty) {
@@ -2837,15 +2840,22 @@ public:
                             {
                                 switch(tok.type())
                                 {
-                                case TOK_INTERPOLATED_PATH:
                                 case TOK_INTERPOLATED_PATTERN:
                                 case TOK_INTERPOLATED_STMT:
                                 case TOK_INTERPOLATED_BLOCK:
                                 case TOK_INTERPOLATED_ITEM:
-                                case TOK_INTERPOLATED_VIS:
                                     // Emit as a token tree with no separator
                                     TODO(Span(), "Convert interpolated macro fragment: " << tok);
                                     break;
+                                case TOK_INTERPOLATED_PATH:
+                                    // A `$p:path` written into a nested `macro_rules!` body (yansi 1.0.1 `define_property!`)
+                                    emit_path(tok.frag_path());
+                                    break;
+                                case TOK_INTERPOLATED_VIS: {
+                                    ::std::stringstream ss;
+                                    ss << tok.take_frag_vis();
+                                    emit_from_string(ss.str());
+                                    break; }
                                 case TOK_INTERPOLATED_TYPE:
                                     emit_type(tok.frag_type());
                                     break;
diff --git a/src/parse/token.cpp b/src/parse/token.cpp
index 41b806e3..13bd05d7 100644
--- a/src/parse/token.cpp
+++ b/src/parse/token.cpp
@@ -242,6 +242,9 @@ Token Token::clone() const
         case TOK_INTERPOLATED_META:
             rv.m_data = new AST::Attribute( reinterpret_cast<AST::Attribute*>(e)->clone() );
             break;
+        case TOK_INTERPOLATED_VIS:
+            rv.m_data = new AST::Visibility( *reinterpret_cast<AST::Visibility*>(e) );
+            break;
         case TOK_INTERPOLATED_ITEM:
             TODO(Span(Span(),m_pos), "clone interpolated item");
             //rv.m_data = new AST::Named( AST::Item( reinterpret_cast<AST::Attribute*>(e)->clone() ) );
