From eac049b1684111ae2e407eef85744a4150903a27 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 15:06:01 +0000
Subject: [PATCH] trans: the trait-object method shim handles a `Pin<&mut
 Self>` receiver

When `<dyn Trait as Trait>::method` survives to codegen as a function
(taken as a value; a direct call becomes a vtable call in MIR cleanup,
which already unwraps `Pin`), Trans_AutoImpls generates a shim that
loads the vtable and calls through it.  It handled `&self`, `&mut
self`, `self` and `Box<Self>` receivers and stopped on anything else:
tower-lsp-server 0.23.0 (ast-grep 0.45.3), `<dyn Future<..> + Send as
Future>::poll`: "TODO: Trans_AutoImpls - Handle different receiver
types: <dyn Future>::poll - self: Pin<&mut dyn Future<..> + Send>".

A `Custom` receiver is now monomorphised with `Self = ()`, as the vtable
entry's parameter is (hir_expand/vtable.cpp), and rebuilt around the
data pointer through its CoerceUnsized field with the helper the `Box`
case uses.  That helper's leaf keeps the `()`-substituted pointer type,
as mir/cleanup.cpp's copy already does, so the rebuilt wrapper's field
has the type it declares.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/trans/auto_impls.cpp b/src/trans/auto_impls.cpp
index 3057be45..d29763ef 100644
--- a/src/trans/auto_impls.cpp
+++ b/src/trans/auto_impls.cpp
@@ -340,8 +340,10 @@ namespace {
         else if( ty.data().is_Borrow() || ty.data().is_Pointer() )
         {
             out_inner_ptr = lv.clone();
+            // The receiver's own (`()`-substituted) pointer type, as mir/cleanup.cpp does: the enclosing struct
+            // expects it (`Pin<&mut ()>` holds a `&mut ()`, `Arc<()>` a `*const ArcInner<()>`)
             return mutator.in_temporary(
-                ::HIR::TypeRef::new_pointer(::HIR::BorrowType::Shared, ::HIR::TypeRef::new_unit()),
+                mv$(ty),
                 ::MIR::RValue::make_DstPtr({ mv$(lv) })
             );
         }
@@ -518,6 +520,19 @@ void Trans_AutoImpls(::HIR::Crate& crate, TransList& trans_list)
                 auto ty = HIR::TypeRef::new_path(mv$(gpath), new_fcn.m_args.front().second.data().as_Path().binding.clone());
                 lv_ptr = get_unit_ptr(sp, builder, mv$(ty), MIR::LValue::new_Argument(0), lv_self);
                 } break;
+            case HIR::Function::Receiver::Custom: {
+                // `self: Pin<&mut Self>` (Future::poll) and other wrappers: the vtable entry takes the receiver with
+                // `Self = ()` (hir_expand/vtable.cpp clone_self_cb), so rebuild the wrapper around the data pointer
+                // through its CoerceUnsized field, as MIR cleanup does for a virtual call.
+                // - tower-lsp-server 0.23.0 (ast-grep): `<dyn Future<..> + Send as Future>::poll` reached
+                //   as a function value, "TODO: Handle different receiver types"
+                DEBUG("<dyn " << trait_path << ">::" << name << " - Custom receiver " << new_fcn.m_args.front().second);
+                static const HIR::TypeRef ty_unit = HIR::TypeRef::new_unit();
+                MonomorphStatePtr   ms_unit(&ty_unit, &trait_path.m_params, &pp);
+                auto ty = ms_unit.monomorph_type(sp, fcn_def.m_args.front().second);
+                state.resolve.expand_associated_types(sp, ty);
+                lv_ptr = get_unit_ptr(sp, builder, mv$(ty), MIR::LValue::new_Argument(0), lv_self);
+                } break;
             default:
                 TODO(sp, "Handle different receiver types: <dyn " << trait_path << ">::" << name << " - self: " << new_fcn.m_args.front().second);
             }
