-::HIR::TypeRef ImplRef::get_type(const char* name, const HIR::PathParams& params) const
+namespace {
+    // Does a binding for `Assoc<aty_params>` apply to `Assoc<params>`? (types and values; lifetimes are erased later)
+    bool aty_params_match(const HIR::PathParams& aty_params, const HIR::PathParams& params, const HMTypeInferrence* ivars)
+    {
+        return ivars ? ivars->pathparams_equal(aty_params, params) : aty_params == params;
+    }
+    // A binding under a `for<'a>` can name the HRL in its own arguments (`for<'a> Tr<Item<'a> = &'a T>`): that lifetime is
+    // the projection's argument.
+    HIR::PathParams aty_hrls(const HIR::PathParams& hrls, const HIR::PathParams& aty_params, const HIR::PathParams& params)
+    {
+        auto rv = hrls.clone();
+        for(size_t i = 0; i < aty_params.m_lifetimes.size() && i < params.m_lifetimes.size(); i ++)
+        {
+            const auto& l = aty_params.m_lifetimes[i];
+            if( l.is_hrl() )
+            {
+                auto idx = l.as_param().idx();
+                // Untouched slots map the HRL to itself (what MonomorphHrlsOnly does for an index past the end)
+                while( rv.m_lifetimes.size() <= idx )
+                    rv.m_lifetimes.push_back(HIR::LifetimeRef( (3 << 8) | rv.m_lifetimes.size() ));
+                rv.m_lifetimes[idx] = params.m_lifetimes[i];
+            }
+        }
+        return rv;
+    }
+}
