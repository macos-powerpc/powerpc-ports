From 6ce744355061c35e1436101bbba43fba5daf1138 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 19:34:03 +0000
Subject: [PATCH] hir_conv: a struct-like enum variant literal infers its
 enum's omitted parameters

0297 REGRESSION. zerocopy 0.8.56 (ani-cli-rs 0.11.1) src/layout.rs:76, `enum SizeInfo<E = usize> { Sized { size: usize },
SliceDst(TrailingSliceLayout<E>) }` and
    const fn try_to_nonzero_elem_size(&self) -> Option<SizeInfo<NonZeroUsize>> {
        Some(match *self { SizeInfo::Sized { size } => SizeInfo::Sized { size }, .. })
= "layout.rs:86:11 error:0: Type mismatch between NonZero<usize> and usize".

0297 made omitted parameters inferred only at value path heads (`Foo::new()`, `Foo(..)`, `Foo { .. }`) and defaulted
in every other body type. A struct-like VARIANT literal has the HIR type `<SizeInfo>::Sized` (from_ast_expr.cpp), and
the head flag was used up by that UfcsInherent wrapper, so the enum inside it was visited as a plain type position
and took `E = usize`. Both passes (expand_type.cpp, bind.cpp) now hand the flag to the wrapper's inner type; bind.cpp
also sets it for its first, unbound visit of a struct literal's type, which already binds the enum inside the wrapper.

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_conv/bind.cpp b/src/hir_conv/bind.cpp
index bff0bff4..d7bdb5f4 100644
--- a/src/hir_conv/bind.cpp
+++ b/src/hir_conv/bind.cpp
@@ -600,7 +600,12 @@ namespace {
                 DEBUG("- " << ty);
             }
 
+            // A struct-like variant's literal has the type `<Enum>::Variant` (from_ast_expr.cpp): the enum is the head
+            // - zerocopy 0.8.56 layout.rs `enum SizeInfo<E = usize>`: `SizeInfo::Sized { size }` as a `SizeInfo<NonZeroUsize>`
+            if( value_head && TU_TEST1(ty.data(), Path, .path.m_data.is_UfcsInherent()) )
+                m_value_head = true;
             ::HIR::Visitor::visit_type(ty);
+            m_value_head = false;
         }
 
         void visit_type_impl(::HIR::TypeImpl& impl) override
@@ -824,9 +829,12 @@ namespace {
 
                 void visit(::HIR::ExprNode_StructLiteral& node) override
                 {
+                    // `Foo { .. }` is a value path head (the default visit binds `m_type` first; this unbound visit
+                    // already binds the enum inside a variant's `<Enum>::Variant`)
+                    if( node.m_type != ::HIR::TypeRef() )
+                        upper_visitor.m_value_head = true;
                     upper_visitor.visit_type_inner(node.m_type, false);
 
-                    // `Foo { .. }` is a value path head (the default visit binds `m_type` first)
                     if( node.m_type != ::HIR::TypeRef() )
                         upper_visitor.m_value_head = true;
                     ::HIR::ExprVisitorDef::visit(node);
diff --git a/src/hir_conv/expand_type.cpp b/src/hir_conv/expand_type.cpp
index fcd9e2f0..acab896c 100644
--- a/src/hir_conv/expand_type.cpp
+++ b/src/hir_conv/expand_type.cpp
@@ -288,7 +288,11 @@ public:
             }
         }
 
+        // A struct-like variant's literal has the type `<Enum>::Variant` (from_ast_expr.cpp): the enum is the head
+        if( value_head && TU_TEST1(ty.data(), Path, .path.m_data.is_UfcsInherent()) )
+            m_value_head = true;
         ::HIR::Visitor::visit_type(ty);
+        m_value_head = false;
 
         if( const auto* e = ty.data().opt_Path() ) 
         {
