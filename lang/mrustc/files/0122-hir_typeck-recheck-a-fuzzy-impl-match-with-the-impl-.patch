From 069658a3a25db2e055e2072e45ca0fd379305bf6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 14:06:09 +0000
Subject: [PATCH 122/123] hir_typeck: recheck a fuzzy impl match with the impl
 type's projections expanded

tokio 1.43.0 (sad 0.4.32) util/linked_list.rs and runtime/io/registration_set.rs:

    unsafe impl<L: Link> Send for LinkedList<L, L::Target> where L::Target: Send {}
    pub(super) struct Synced { .., registrations: LinkedList<Arc<ScheduledIo>, ScheduledIo>, .. }

runtime/io/driver.rs:86 `_assert::<Handle>()` checks Send field by field
down to Synced. Matching the impl binds `L = Arc<ScheduledIo>`, but
`<L as Link>::Target` against `ScheduledIo` only compares fuzzily (opaque),
so the impl came back as a fuzzy match although all its bounds held, and
the auto trait's field-by-field check asserts on that: "BUG: ASSERT FAIL:
src/hir_typeck/helpers.cpp:3398: Auto trait with no params returned a fuzzy
match from destructure - Send for registration_set::Synced".

In ftic_check_params, once a fuzzy match has bound all of the impl's
parameters, the impl type (and trait arguments) are monomorphised, their
projections expanded, and compared again: Equal is a real match, Unequal
rules the impl out, anything else stays fuzzy. StaticTraitResolve already
does this.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/helpers.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index fb9d9186..cf228c4d 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -3733,6 +3733,27 @@ bool TraitResolution::find_trait_impls_crate(const Span& sp,
     {
         DEBUG("Placeholders not needed");
     }
+    // A projection in the impl type (`impl<L: Link> Send for LinkedList<L, L::Target>`) only matches fuzzily (opaque).
+    // Once the impl's parameters are all bound, expand it and compare again, as StaticTraitResolve does.
+    // - tokio 1.43.0: `Send` for `LinkedList<Arc<ScheduledIo>, ScheduledIo>` inside `Synced`, where an auto trait's
+    //   field-by-field check asserts on a fuzzy answer
+    if( match == ::HIR::Compare::Fuzzy && !placeholders_needed && monomorphise_type_needed(impl_ty) )
+    {
+        auto ms = MonomorphStatePtr(nullptr, &out_impl_params, nullptr);
+        auto impl_ty_mono = this->expand_associated_types(sp, ms.monomorph_type(sp, impl_ty));
+        auto cmp = impl_ty_mono.compare_with_placeholders(sp, type, m_ivars.callback_resolve_infer());
+        if( params_ptr && cmp != ::HIR::Compare::Unequal ) {
+            auto args_mono = ms.monomorph_path_params(sp, impl_trait_args, true);
+            for(auto& t : args_mono.m_types)
+                t = this->expand_associated_types(sp, mv$(t));
+            cmp &= args_mono.compare_with_placeholders(sp, *params_ptr, m_ivars.callback_resolve_infer());
+        }
+        DEBUG("Fuzzy impl match, expanded: " << impl_ty_mono << " vs " << type << " = " << cmp);
+        if( cmp == ::HIR::Compare::Unequal ) {
+            return ::HIR::Compare::Unequal;
+        }
+        match = cmp;
+    }
     auto cb_infer = m_ivars.callback_resolve_infer();
     struct Matcher:
         public ::HIR::MatchGenerics,
