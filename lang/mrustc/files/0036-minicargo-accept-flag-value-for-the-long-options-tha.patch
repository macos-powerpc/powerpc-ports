@@ -543,51 +543,53 @@ int ProgramOptions::parse(int argc, const char* argv[])
         else
         {
             // Long arguments
+            // - Both `--flag value` and `--flag=value` are accepted (cargo-style, as emitted by port build systems)
+            const char* eq = ::std::strchr(arg, '=');
+            ::std::string   flag_name(arg, eq ? static_cast<size_t>(eq - arg) : ::std::strlen(arg));
+            const char* flag = flag_name.c_str();
+            const char* inline_value = eq ? eq + 1 : nullptr;
+            auto get_value = [&]() -> const char* {
+                if( inline_value ) {
+                    return inline_value;
+                }
+                if(i+1 == argc) {
+                    ::std::cerr << "Flag " << arg << " takes an argument" << ::std::endl;
+                    return nullptr;
+                }
+                return argv[++i];
+            };
             if( ::std::strcmp(arg, "--help") == 0 ) {
                 this->help();
                 exit(0);
             }
