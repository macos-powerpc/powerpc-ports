From bd4d9e9aa620c99a8f2aea5d56b072fd1df4cf4f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 02:29:34 +0000
Subject: [PATCH 100/100] codegen_c: fix i128 ctlz/cttz and i128-to-float in
 the emulated prelude

Two value-level bugs in the emulated-i128 helpers, on every target that
emulates 128-bit integers (32-bit targets, MSVC):

- `int128_to_uint128` / `uint128_to_int128` passed `(a.lo, a.hi)` to
  `make128_raw(hi, lo)`, swapping the halves. They only wrap the `ctlz`
  and `cttz` intrinsics on i128, where the second swap left the count in
  the high word and the `.lo` extraction returned 0: `i128::leading_zeros`
  and `trailing_zeros` were always 0 (and n << 64 before 1.90, where the
  intrinsic returned an i128).
- `cast128s_float` / `cast128s_double` computed the magnitude `abs` and
  then converted the untouched two's-complement value, so a negative i128
  cast to f32/f64 came out as minus the wrapped magnitude (about -3.4e38
  for `-5i128 as f64`) instead of the value.

Found while reviewing the prelude for the big-endian layout change and
covered by the same C-driven no_core harness: on a little-endian build
with `emulate-i128 = true` these were the only failing cases (ctlz/cttz
on i128 and the signed casts to float).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/trans/codegen_c.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index d13fe037..b59c3eec 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -731,12 +731,12 @@ namespace {
                     << "static inline float cast128s_float(int128_t v) {"
                     << " int sgn = (v.hi >> 63);"
                     << " int128_t abs = sgn ? neg128s(v) : v;"
-                    << " return (sgn ? -1.0 : 1.0) * cast128_float(make128_raw(v.hi,v.lo));"
+                    << " return (sgn ? -1.0 : 1.0) * cast128_float(make128_raw(abs.hi,abs.lo));"
                     << " }\n"
                     << "static inline double cast128s_double(int128_t v) {"
                     << " int sgn = (v.hi >> 63);"
                     << " int128_t abs = sgn ? neg128s(v) : v;"
-                    << " return (sgn ? -1.0 : 1.0) * cast128_double(make128_raw(v.hi,v.lo));"
+                    << " return (sgn ? -1.0 : 1.0) * cast128_double(make128_raw(abs.hi,abs.lo));"
                     << " }\n"
                     << "static inline int cmp128s(int128_t a, int128_t b) { if(a.hi != b.hi) return (int64_t)a.hi < (int64_t)b.hi ? -1 : 1; if(a.lo != b.lo) return a.lo < b.lo ? -1 : 1; return 0; }\n"
                     // Returns true if overflow happens (if negative with pos,pos or positive with neg,neg)
@@ -772,8 +772,8 @@ namespace {
                     << "static inline int128_t xor128s(int128_t a, int128_t b) { int128_t v = { .lo = a.lo ^ b.lo, .hi = a.hi ^ b.hi }; return v; }\n"
                     << "static inline int128_t shl128s(int128_t a, uint32_t b) { int128_t v; if(b == 0) { return a; } else if(b < 64) { v.lo = a.lo << b; v.hi = (a.hi << b) | (a.lo >> (64 - b)); } else { v.hi = a.lo << (b - 64); v.lo = 0; } return v; }\n"
                     << "static inline int128_t shr128s(int128_t a, uint32_t b) { int128_t v; if(b == 0) { return a; } else if(b < 64) { v.lo = (a.lo >> b)|(a.hi << (64 - b)); v.hi = (int64_t)a.hi >> b; } else { v.lo = (int64_t)a.hi >> (b - 64); v.hi = (int64_t)a.hi < 0 ? -1 : 0; } return v; }\n"
-                    << "static inline uint128_t int128_to_uint128(int128_t a) { return make128_raw(a.lo, a.hi); }\n"
-                    << "static inline int128_t uint128_to_int128(uint128_t a) { return make128s_raw(a.lo, a.hi); }\n"
+                    << "static inline uint128_t int128_to_uint128(int128_t a) { return make128_raw(a.hi, a.lo); }\n"
+                    << "static inline int128_t uint128_to_int128(uint128_t a) { return make128s_raw(a.hi, a.lo); }\n"
                     ;
             }
             else
