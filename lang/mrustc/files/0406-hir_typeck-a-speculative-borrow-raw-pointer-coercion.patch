From 8c7699aae0f1ec3ba6cada490f041c362bbbcc7a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 26 Oct 2026 01:37:09 +0000
Subject: [PATCH] hir_typeck: a speculative borrow -> raw pointer coercion
 check rejects the candidate instead of erroring

librsvg 2.58.5 (the Rust librsvg port), compiling the librsvg_c staticlib:

    <null> error:0: Type mismatch between *mut ::"core-0_0_0"::ffi::c_void/*E*/ and &'#omitted _/*6*/ - Mutability not compatible

librsvg-c/src/handle.rs:261 declares `#[property(name = "dpi-x", construct, type = f64,
set = Self::set_dpi_x, ..)]` (dpi-y and base-uri are the same shape), for which
`#[derive(glib::Properties)]` (glib-macros 0.19.0, properties.rs:594) generates

    pub fn set_dpi_x<'a>(&self, value: impl Borrow<<<f64 as Property>::Value as HasParamSpec>::SetValue>) {
        self.set_property_from_value("dpi-x", &::std::convert::From::from(std::borrow::Borrow::borrow(&value)))
    }

`Borrow::borrow(&value)` yields `&_` (the `Borrowed` ivar is only pinned through the
parameter's bound later), so `From::from(..)` leaves `Value: From<_/*4*/>` with the
coercion rule `_/*4*/ := &_/*6*/`.  The ivar-possibility pass then tests every
`From<X> for Value` impl against that coercion (check_ivar_poss__fails_bounds ->
check_coerce_tys with no mutable context), and the borrow-to-raw-pointer arm of
check_coerce_tys hard-errored on glib's `impl From<Pointer> for Value`
(`*mut c_void := &_`, a mutability mismatch) instead of ruling that candidate out.

A speculative check (context_mut == nullptr) now returns CoerceResult::Fail there,
which the possibility checks read as "bound failed"; a committed `&T -> *mut T`
coercion still reports the type error.  The remaining candidates behave as before:
the ivar settles on the `From<&T> for Value` impl, as rustc does.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 8f49834f..df69189a 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -5392,6 +5392,13 @@ namespace {
                 // Borrows can coerce to pointers while reducing in strength
                 // - Shared < Unique. If the destination is not weaker or equal to the source, it's an error
                 if( !(dep->type <= se.type) ) {
+                    // A speculative check (an ivar possibility tested against the coercion, no context to update)
+                    // just rules this candidate out: `*mut c_void` is one of the `From<X> for Value` impls
+                    // offered for `From::from(Borrow::borrow(&value))` (glib-macros 0.19 property setters)
+                    if( !context_mut ) {
+                        DEBUG("Borrow -> raw pointer mutability mismatch, not a candidate - " << dst << " := " << src);
+                        return CoerceResult::Fail;
+                    }
                     ERROR(sp, E0000, "Type mismatch between " << dst << " and " << src << " - Mutability not compatible");
                 }
 
