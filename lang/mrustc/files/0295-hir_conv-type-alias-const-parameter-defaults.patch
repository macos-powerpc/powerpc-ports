From 9f2656179c8d00ba38221bd17e157dff7183c378 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 13:59:16 +0000
Subject: [PATCH] hir_conv: type alias const parameter defaults

object 0.38.1 (py314-maturin 1.15.0) died in "Resolve Type Aliases":

    <null> BUG: src/hir_conv/expand_type.cpp:48: TODO: get_path_params - Populate default value params

build/elf.rs has `pub type Symbols<'data, const DYNAMIC: bool = false> = Table<Symbol<'data, DYNAMIC>>;`, used as
`Symbols<'data>`. Alias expansion filled omitted type parameters from their defaults but had only a TODO for const
parameters. They are now monomorphised the same way, against the parameter list filled so far, so a default may name
an earlier parameter that was itself defaulted (`type A<const N: usize = 2, const M: usize = N>`).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_conv/expand_type.cpp b/src/hir_conv/expand_type.cpp
index 06ba862c..9aecaba7 100644
--- a/src/hir_conv/expand_type.cpp
+++ b/src/hir_conv/expand_type.cpp
@@ -42,10 +42,14 @@ namespace {
             ERROR(sp, E0000, "Mismatched type-generic count in " << path << ", expected " << params_def.m_types.size() << " got " << pp.m_types.size());
         }
 
+        // A value default may name an earlier value parameter that was itself defaulted
+        // (`type A<const N: usize = 2, const M: usize = N>`), so monomorphise against the list filled so far.
+        // object 0.38.1 build/elf.rs: `pub type Symbols<'data, const DYNAMIC: bool = false> = Table<Symbol<'data, DYNAMIC>>;`
+        auto ms_v = MonomorphStatePtr(nullptr, &pp, nullptr);
         pp.m_values.reserve( params_def.m_values.size() );
         while( pp.m_values.size() < params_def.m_values.size() && !params_def.m_values[pp.m_values.size()].m_default.is_Infer() ) {
-            //pp.m_values.push_back( ms_o.monomorph_va(sp, params_def.m_values[pp.m_values.size()].m_default) );
-            TODO(sp, "Populate default value params");
+            auto v = ms_v.monomorph_constgeneric(sp, params_def.m_values[pp.m_values.size()].m_default, /*allow_infer=*/true);
+            pp.m_values.push_back( std::move(v) );
         }
         if( pp.m_values.size() != params_def.m_values.size() ) {
             ERROR(sp, E0000, "Mismatched const-generic count in " << path << ", expected " << params_def.m_values.size() << " got " << pp.m_values.size());
