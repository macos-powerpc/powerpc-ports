From 664eb668f5867a60b212acce5c05d5e51968270e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 1 Nov 2026 06:25:39 +0000
Subject: [PATCH 425/425] trans: emit `xgetbv` as its encoding, not the mnemonic

std_detect 1.90 on x86 (issue #457): "libstd_detect-0_1_5_H0.rlib.c:684:no such instruction: `xgetbv'". The
`llvm.x86.xgetbv` intrinsic (core_arch xsave.rs `_xgetbv`, which std_detect's cache init calls) was emitted as
`__asm__ ("xgetbv" : "=a" (lo), "=d" (hi) : "c" (arg0))`; assemblers that predate XSAVE, such as Apple's cctools
`as` used by GCC and by `clang -fno-integrated-as` on macOS, reject the mnemonic. The encoding, `.byte 0x0f,
0x01, 0xd0`, is the same on i386 and x86-64, independent of the asm syntax, and every assembler takes it.

Assisted-by: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index 24a72c34..a38d5ccc 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -3549,7 +3549,8 @@ namespace {
                     {
                     case Compiler::Gcc:
                         m_of << "\tuint32_t lo, hi;\n";
-                        m_of << "\t__asm__ __volatile__ (\"xgetbv\" : \"=a\" (lo), \"=d\" (hi) : \"c\" (arg0) );\n";
+                        // Encoded, not the mnemonic: assemblers that predate XSAVE (Apple's cctools `as`) reject `xgetbv`
+                        m_of << "\t__asm__ __volatile__ (\".byte 0x0f, 0x01, 0xd0\" : \"=a\" (lo), \"=d\" (hi) : \"c\" (arg0) );\n";
                         m_of << "\treturn lo | ((uint64_t)hi << 32);\n";
                         break;
                     case Compiler::Msvc:
