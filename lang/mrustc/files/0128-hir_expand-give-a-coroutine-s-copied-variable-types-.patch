From 2370f9570d73f0cb8a9b83b60cdb1b4a7342a9c4 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 15:10:55 +0000
Subject: [PATCH 128/128] hir_expand: give a coroutine's copied variable types
 the struct path of closures extracted from its body

tokio 1.43.0 (sad 0.4.32) sync/oneshot.rs:700:

    pub async fn closed(&mut self) {
        let closed = poll_fn(|cx| self.poll_closed(cx));
        closed.await;
    }

The closure is extracted first and the body's node types are fixed up to
its struct path, but the coroutine lowering copies the locals' (and
captures') types from the function's binding types, which still named the
closure by its node type. The generated poll function then had a local of
type `PollFn<closure[..]>` assigned a `PollFn<closure#I_closed_..>`:
"MIR ERROR: <future#I_closed_552<'I0,T> as Future>::poll BB9/0: Type
mismatch: dst PollFn<closure[0x..]>, src PollFn<closure#I_closed_549<..>>".

After coroutine_vars, async blocks and generators run the fixup's type
rewrite over the new locals and the struct entries, through the
coroutine's monomorphiser (before it is frozen).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_expand/closures.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/hir_expand/closures.cpp b/src/hir_expand/closures.cpp
index ba5eb31a..ff0c7bc7 100644
--- a/src/hir_expand/closures.cpp
+++ b/src/hir_expand/closures.cpp
@@ -1599,6 +1599,22 @@ namespace {
                 this->struct_ents.at(0).ent.data_mut().as_Path().path.m_data.as_Generic().m_params.m_types.at(0) = std::move(ty);
             }
         };
+        /// A closure in the coroutine's body was extracted already, but the variable types the coroutine copies (its
+        /// locals and captures) still name it by its node type: give them its struct path (through this coroutine's
+        /// monomorphiser, before it is frozen), as the fixup does for the body.
+        /// - tokio 1.43.0 sync/oneshot.rs: `let closed = poll_fn(|cx| self.poll_closed(cx)); closed.await;`
+        ///   in an async fn -> MIR "Type mismatch: PollFn<closure[..]> vs PollFn<closure#I_closed_..>"
+        void fix_coroutine_var_types(CrVars& cr_vars, const Monomorph& monomorph_cb) const
+        {
+            ExprVisitor_Fixup   fixup { m_resolve.m_crate, nullptr, monomorph_cb, &m_out };
+            for(auto& ty : cr_vars.new_locals) {
+                if( ty != ::HIR::TypeRef() )
+                    fixup.visit_type(ty);
+            }
+            for(auto& ent : cr_vars.struct_ents) {
+                fixup.visit_type(ent.ent);
+            }
+        }
         CrVars coroutine_vars(const Span& sp, const ::HIR::ExprNode_Generator::AvuCache& avu_cache, unsigned n_args, const Monomorph& monomorph_cb) const
         {
             CrVars  rv;
@@ -1703,6 +1719,7 @@ namespace {
 
             // Generate the structure, 
             auto cr_vars = coroutine_vars(node.span(), node.m_avu_cache, 1 + (TARGETVER_LEAST_1_74 ? 1 : 0), monomorph_cb);
+            fix_coroutine_var_types(cr_vars, monomorph_cb);
 
             {
                 TRACE_FUNCTION_F("-- Rewrite variables");
@@ -1854,6 +1871,7 @@ namespace {
             auto monomorph_cb = create_params(sp, m_resolve, params, constructor_path_params);
 
             auto cr_vars = coroutine_vars(node.span(), node.m_avu_cache, 2, monomorph_cb);
+            fix_coroutine_var_types(cr_vars, monomorph_cb);
 
             {
                 ExprVisitor_GeneratorRewrite visitor_rewrite(monomorph_cb, cr_vars.variable_rewrites);
