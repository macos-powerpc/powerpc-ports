From aaa573573263501cb44aa88759412872da5deb97 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 17:53:06 +0000
Subject: [PATCH] hir_expand: a closure's `[v; N]` repeat count is renumbered
 with its other generics

image-webp 0.2.4 (skim 5.7.3) lossless_transform.rs:461
`apply_color_indexing_transform_small_table<const W_BITS: u8, const
EXP_ENTRY_SIZE: usize>` builds `[0u8; EXP_ENTRY_SIZE]` inside a closure
passed to `.map(..)`. Extracting the closure renumbers the parent's
generics into the closure impl's own (impl-level) list: types, paths and
`ExprNode_ConstParam` were rewritten, but `ExprNode_ArraySized::m_size`
(the repeat count, a ConstGeneric that isn't part of any visited type)
kept the parent's `EXP_ENTRY_SIZE/*M:1*/`. MIR lowering copied it into
the `SizedArray` count; inlining the closure's `Fn::call` into its own
`FnMut`/`FnOnce` shims (impl params only) then hit "BUG:
hir_typeck/common.cpp:729 Value param EXP_ENTRY_SIZE/*M:1*/ out of range
for (max 0)".

ExprVisitor_Mutate (closures) and ExprVisitor_GeneratorRewrite
(coroutines/async blocks) now run `monomorph_arraysize` on the count,
next to the ConstParam rewrite.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_expand/closures.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/hir_expand/closures.cpp b/src/hir_expand/closures.cpp
index ff0c7bc7..0710e4dc 100644
--- a/src/hir_expand/closures.cpp
+++ b/src/hir_expand/closures.cpp
@@ -325,6 +325,11 @@ namespace {
         void visit(HIR::ExprNode_ConstParam& node) override {
             node.m_binding = m_monomorphiser.get_value(node.span(), HIR::GenericRef("", node.m_binding)).as_Generic().binding;
         }
+        // `[v; N]`: the repeat count names the parent's generics too (it isn't part of a visited type/path)
+        void visit(HIR::ExprNode_ArraySized& node) override {
+            ::HIR::ExprVisitorDef::visit(node);
+            node.m_size = m_monomorphiser.monomorph_arraysize(node.span(), node.m_size);
+        }
 
         ::HIR::ExprNodeP get_self(const Span& sp) const
         {
@@ -1552,6 +1557,11 @@ namespace {
             void visit(HIR::ExprNode_ConstParam& node) override {
                 node.m_binding = m_monomorph.get_value(node.span(), HIR::GenericRef("", node.m_binding)).as_Generic().binding;
             }
+            // `[v; N]`: the repeat count names the parent's generics too (it isn't part of a visited type/path)
+            void visit(HIR::ExprNode_ArraySized& node) override {
+                ::HIR::ExprVisitorDef::visit(node);
+                node.m_size = m_monomorph.monomorph_arraysize(node.span(), node.m_size);
+            }
 
             // Custom visitor that only updates the captures and path
             // - Don't want to visit the patterns within
