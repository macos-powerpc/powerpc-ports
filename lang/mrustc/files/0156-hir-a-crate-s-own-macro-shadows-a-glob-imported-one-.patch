From c97e6ea983529a069613202a08a76191bc63fcc4 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 01:29:25 +0000
Subject: [PATCH] hir: a crate's own macro shadows a glob-imported one of the same name

tokio-macros 2.7.2 (tokio 1.53.1, skim 5.7.3) defines
`#[proc_macro_attribute] pub fn test`. The built plugin exported seven
macros and no `test`, so tokio's lib.rs:681 `pub use tokio_macros::test;`
failed:

    Unable to resolve `use` target ::"tokio_macros-2_7_2"::test

Expansion registered all eight (the G5's `-Z dump-ast` showed them) and the
same sources export all eight here against a stand-in std. The real std's
prelude carries the builtin `test` attribute macro, and the implicit
prelude glob puts it into the crate root's macro table as a private
import. HIR lowering adds that entry first, then adds the crate's own
macros (exported macro_rules, re-exports, proc macros) with a map insert
that keeps the existing key: the proc macro was silently dropped, and
the private import it lost to is not what the crate exports. A stand-in
std whose prelude exports a `test` macro reproduces it exactly.

A crate's own item shadows a glob import, so an existing Import entry of
that name is replaced; anything else of that name is a bug.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir/from_ast.cpp | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/hir/from_ast.cpp b/src/hir/from_ast.cpp
index a6c75d01..975dce57 100644
--- a/src/hir/from_ast.cpp
+++ b/src/hir/from_ast.cpp
@@ -2708,7 +2708,22 @@ public:
         if(e.second.is_MacroRules() ) {
             ASSERT_BUG(Span(), !e.second.as_MacroRules()->m_rules.empty(), "Empty macro? - " << e.first);
         }
-        rv.m_root_module.m_macro_items.insert( ::std::make_pair(e.first, box$(HIR::VisEnt<HIR::MacroItem> { HIR::Publicity::new_global(), mv$(e.second) })) );
+        auto ent = box$(HIR::VisEnt<HIR::MacroItem> { HIR::Publicity::new_global(), mv$(e.second) });
+        auto it = rv.m_root_module.m_macro_items.find(e.first);
+        if( it != rv.m_root_module.m_macro_items.end() )
+        {
+            // The root module already has this name from a glob import (the prelude: `test` is a builtin attribute
+            // macro there). The crate's own macro shadows a glob import, as any local item does.
+            // - tokio-macros 2.7.2 `#[proc_macro_attribute] pub fn test`: the plugin exported seven macros and no
+            //   `test` (tokio 1.53.1 "Unable to resolve `use` target tokio_macros::test"), only with the real std
+            ASSERT_BUG(Span(), it->second->ent.is_Import(), "Duplicate macro item in crate root: " << e.first << " (" << it->second->ent.tag_str() << ")");
+            DEBUG("Crate macro `" << e.first << "` shadows the glob-imported " << it->second->ent.as_Import().path);
+            it->second = mv$(ent);
+        }
+        else
+        {
+            rv.m_root_module.m_macro_items.insert( ::std::make_pair(e.first, mv$(ent)) );
+        }
     }
 
     LowerHIR_Module_Impls(crate.m_root_module,  rv);
