From bc43fb44d72609c1a23d8d7865a87cf28b7fee04 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 30 Oct 2026 19:59:04 +0000
Subject: [PATCH 415/415] proc_macro: a forwarded macro_rules fragment reaches
 a proc macro as an invisible group

bunt 0.2.8 (jwt-cli 6.2.0 decode.rs:191) `println!("{$red+bold}...{/$}")`:
    compile_error! "expected none or () delimited group, but found different
    token tree (note: do not use the macros from `bunt-macros` directly, ...)"

bunt's `println!` hands the format string (`$format_str:literal`, inside
`[..]`) and every argument (`$arg:expr`) to the proc macro `bunt_macros::
writeln!`, whose parser requires each to be a `Delimiter::None` or `()`
group. rustc passes a forwarded fragment (`expr`, `literal`, `ty`, `pat`,
`path`, `stmt`, `block`, `meta`; not `ident`, `lifetime`, `tt`) as
an invisible group (1.90 proc_macro_server.rs turns every
`Invisible(MetaVar(_))` tree into a `Delimiter::None` Group). mrustc's
protocol had none: the fragment went over as its bare tokens.

Protocol tags 15/16 (`TokenClass::GroupNoneOpen/Close`, libproc_macro
`Token::GroupNoneOpen/Close`): the compiler brackets each interpolated
fragment with them (the parentheses an operator expression gets stay inside),
libproc_macro's reader builds `Group::new(Delimiter::None, ..)`, its writer
still prints nothing for such a group (output groups come back as their
tokens, as before) and the compiler's output reader skips the tags should
a child echo them. The fake proc macros of the kits know the tags; the expected
dumps of the fragment-forwarding kits change accordingly.

Assisted-by: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/lib/libproc_macro/src/protocol.rs b/lib/libproc_macro/src/protocol.rs
index adb6b57c..253d5f98 100644
--- a/lib/libproc_macro/src/protocol.rs
+++ b/lib/libproc_macro/src/protocol.rs
@@ -25,6 +25,11 @@ pub enum Token
     SpanDef(SpanDef),
     /// Suffix of the preceding literal (`"re"i`)
     Suffix(String),
+    /// Start of an invisible (`Delimiter::None`) group: a macro_rules fragment (`$e:expr`, `$t:ty`, `$p:pat`, ..)
+    /// forwarded to the macro, as rustc hands them over. Only the compiler sends these.
+    GroupNoneOpen,
+    /// End of an invisible group
+    GroupNoneClose,
 }
 pub struct SpanDef {
     pub idx: usize,
@@ -106,6 +111,8 @@ impl<R: ::std::io::Read> Reader<R>
             v as u8
             }),
         14 => Token::CString(self.get_byte_vec()),
+        15 => Token::GroupNoneOpen,
+        16 => Token::GroupNoneClose,
         _ => panic!("Unknown tag byte: {:#x}", hdr_b),
         })
     }
@@ -217,6 +224,8 @@ impl<T: ::std::io::Write> Writer<T>
         Token::Suffix(v) => { self.putb(12); self.put_bytes(v.as_bytes()); },
         Token::ByteChar(v) => { self.putb(13); self.put_u128v(v as u128); },
         Token::CString(v) => { self.putb(14); self.put_bytes(&v[..]); },
+        Token::GroupNoneOpen => { self.putb(15); },
+        Token::GroupNoneClose => { self.putb(16); },
         }
     }
     pub fn write_sym(&mut self, v: &[u8])
diff --git a/lib/libproc_macro/src/serialisation.rs b/lib/libproc_macro/src/serialisation.rs
index 0f0d4f51..68a98c3e 100644
--- a/lib/libproc_macro/src/serialisation.rs
+++ b/lib/libproc_macro/src/serialisation.rs
@@ -9,6 +9,8 @@ pub fn recv_token_stream<R: ::std::io::Read>(reader: R) -> TokenStream
     let mut s = Reader::new(reader);
     return get_subtree(&mut s, "");
 
+    /// An invisible group ends with `Token::GroupNoneClose`, not a symbol
+    const NONE_GROUP_END: &str = "\u{0}";
     fn get_subtree<R: ::std::io::Read>(s: &mut Reader<R>, end: &'static str) -> TokenStream {
         let mut toks: Vec<TokenTree> = Vec::new();
         while let Some(t) = s.read_ent()
@@ -41,6 +43,10 @@ pub fn recv_token_stream<R: ::std::io::Read>(reader: R) -> TokenStream
                     },
                 Token::EndOfStream if end == "" => return TokenStream { inner: toks, },
                 Token::Symbol(ref s) if s == end => return TokenStream { inner: toks, },
+                // A forwarded macro_rules fragment (`$e:expr`, ..): an invisible group, as rustc gives it
+                Token::GroupNoneOpen => { Group::new(Delimiter::None, get_subtree(s, NONE_GROUP_END)).into() },
+                Token::GroupNoneClose if end == NONE_GROUP_END => return TokenStream { inner: toks, },
+                Token::GroupNoneClose => panic!("Protocol error: invisible group closed inside a `{}` group", end),
                 Token::Symbol(ref s) if s == "" => panic!("Unexpected end-of-stream marker"),
                 Token::EndOfStream => panic!("Unexpected end-of-stream marker"),
                 Token::Symbol(sym) => {
diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
