         this->send_bytes(val, ::std::strlen(val));
@@ -572,6 +585,16 @@ namespace {
             return false;
         }
         void visit_token(const ::Token& tok)
+        {
+            // A `:literal` fragment (one token, or `-` and a number; `Token::m_literal_frag`) is an invisible group
+            // like the parsed fragments below: bunt-macros reads its format string out of one
+            if( tok.is_literal_frag_first() )
+                m_pmi.send_none_group_open();
+            visit_token_inner(tok);
+            if( tok.is_literal_frag_last() )
+                m_pmi.send_none_group_close();
+        }
+        void visit_token_inner(const ::Token& tok)
         {
             switch(tok.type())
             {
@@ -585,27 +608,41 @@ namespace {
             case TOK_COMMENT:
                 BUG(sp, "Unexpected whitepace in tokenstream");
                 break;
+            // A forwarded macro_rules fragment is an invisible (`Delimiter::None`) group to the proc macro, as rustc
+            // sends it: bunt 0.2.8's `println!` hands each `$arg:expr` to bunt-macros' `writeln!`, whose parser
+            // takes "none or () delimited group"s for the arguments (jwt-cli 6.2.0). `ident`, `lifetime` and `tt`
+            // fragments are plain tokens.
             case TOK_INTERPOLATED_TYPE:
+                m_pmi.send_none_group_open();
                 visit_type(const_cast<::Token&>(tok).frag_type());
+                m_pmi.send_none_group_close();
                 break;
             case TOK_INTERPOLATED_PATH:
+                m_pmi.send_none_group_open();
                 visit_path(const_cast<::Token&>(tok).frag_path());
+                m_pmi.send_none_group_close();
                 break;
             // A `:pat` fragment forwarded to a proc macro
             // - tokio 1.53.1 `select!`: `$crate::select_priv_clean_pattern!($bind)` (interprocess 2.4.4, skim)
             case TOK_INTERPOLATED_PATTERN:
+                m_pmi.send_none_group_open();
                 visit_pattern(const_cast<::Token&>(tok).frag_pattern());
+                m_pmi.send_none_group_close();
                 break;
             case TOK_INTERPOLATED_STMT:
             case TOK_INTERPOLATED_BLOCK:
+                m_pmi.send_none_group_open();
                 visit_node( const_cast<::Token&>(tok).frag_node() );
+                m_pmi.send_none_group_close();
                 break;
             // A `:expr` fragment: i18n-embed-fl 0.9.4 `fl!` emits `args.insert("duration", #value.into())` for age
             // 0.11.1 error.rs `duration = (1 << (required - target))` (kbs2); the dump had dropped the source's
-            // parentheses, so the output re-parsed as `1 << (required - target).into()`
+            // parentheses, so the output re-parsed as `1 << (required - target).into()`. The parentheses stay inside
+            // the invisible group: the group itself comes back flattened (libproc_macro prints none), they don't.
             case TOK_INTERPOLATED_EXPR: {
                 const auto& e = const_cast<::Token&>(tok).frag_node();
                 bool wrap = expr_fragment_needs_parens(e);
+                m_pmi.send_none_group_open();
                 if( wrap ) {
                     m_pmi.send_symbol("(");
                 }
@@ -613,9 +650,12 @@ namespace {
                 if( wrap ) {
                     m_pmi.send_symbol(")");
                 }
+                m_pmi.send_none_group_close();
                 } break;
             case TOK_INTERPOLATED_META:
+                m_pmi.send_none_group_open();
                 visit_meta_item(const_cast<::Token&>(tok).frag_meta());
+                m_pmi.send_none_group_close();
                 break;
             case TOK_INTERPOLATED_ITEM:
             case TOK_INTERPOLATED_VIS:
@@ -2165,6 +2205,9 @@ namespace {
             ASSERT_BUG(Span(), t != TOK_NULL, "Unknown symbol `" << val << "`");
             out.push_back(::std::move(t));
         }
+        // mrustc tokens have no invisible groups: a fragment's tokens are collected as written
+        void send_none_group_open() override {}
+        void send_none_group_close() override {}
         void send_rword(const char* val) override {
             auto t = Lex_FindOperator(val);
             if( t == TOK_NULL )
@@ -2852,6 +2895,10 @@ Token ProcMacroInv::realGetToken_() {
         break;
     case TokenClass::Suffix:
         BUG(this->m_parent_span, "Literal suffix from child process without a string literal");
+    case TokenClass::GroupNoneOpen:
+    case TokenClass::GroupNoneClose:
+        // An invisible group echoed back (libproc_macro prints none today): its tokens are read as written
+        return this->realGetToken_();
     case TokenClass::Symbol: {
         auto val = this->recv_bytes();
         if( val == "" ) {
diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index c9238c59..bb322e1e 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -692,6 +692,9 @@ InterpolatedFragment Macro_HandlePatternCap(TokenStream& lex, MacroPatEnt::Type
             }
             GET_TOK(tok, lex);
             toks.push_back(tok);
+            // A `:literal` fragment is an invisible group to a proc macro (see Token::m_literal_frag)
+            toks.front().tok().set_literal_frag(true, false);
+            toks.back().tok().set_literal_frag(false, true);
             return InterpolatedFragment( TokenTree(lex.get_edition(), lex.get_hygiene(), std::move(toks)) );
         }
         switch(tok.type())
@@ -712,6 +715,7 @@ InterpolatedFragment Macro_HandlePatternCap(TokenStream& lex, MacroPatEnt::Type
         default:
             throw ParseError::Unexpected(lex, tok, {TOK_INTEGER, TOK_FLOAT, TOK_STRING, TOK_BYTESTRING, TOK_CSTRING, TOK_RWORD_TRUE, TOK_RWORD_FALSE});
         }
+        tok.set_literal_frag(true, true);
         return InterpolatedFragment( TokenTree(lex.get_edition(), lex.get_hygiene(), tok) );
     }
     throw "";
