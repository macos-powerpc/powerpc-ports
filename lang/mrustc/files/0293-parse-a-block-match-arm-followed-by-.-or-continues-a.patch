From 6ba321bb8b49f61f3a7bcf4fb1fd1442572d744c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 10:40:59 +0000
Subject: [PATCH] parse: a block match arm followed by `.` or `?` continues as
 an expression

xh 0.26.2 (edition 2024) failed to parse:

    src/main.rs:486:15 error:0: Unexpected token TOK_DOT

    Body::Raw(body) => {
        if args.form {
            request_builder.header(CONTENT_TYPE, ..)
        } else {
            request_builder.header(ACCEPT, ..).header(CONTENT_TYPE, ..)
        }
    }
    .body(body),

Match arm bodies go through Parse_Stmt, which returned a `{ .. }` block
as soon as it closed. A block statement (Parse_ExprBlockLine) already
treats a following `.` or `?` as the start of an expression; Parse_Stmt now
does the same: the block is put back as an interpolated expression and
parsed with Parse_Expr0. A binary operator after the block still ends the
arm, as in rustc.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index c6ac8c40..892b378c 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -742,9 +742,17 @@ ExprNodeP Parse_Stmt(TokenStream& lex)
         return Parse_FlowControl(lex, AST::ExprNode_Flow::BREAK);
     case TOK_RWORD_RETURN:
         return Parse_FlowControl(lex, AST::ExprNode_Flow::RETURN);
-    case TOK_BRACE_OPEN:
+    case TOK_BRACE_OPEN: {
         PUTBACK(tok, lex);
-        return Parse_ExprBlockNode(lex);
+        auto rv = Parse_ExprBlockNode(lex);
+        // A block followed by `.` or `?` starts an expression, as in a block's statements (Parse_ExprBlockLine): a match
+        // arm `Body::Raw(body) => { .. }.body(body),` (xh 0.26.2 main.rs:486)
+        if( lex.lookahead(0) == TOK_DOT || lex.lookahead(0) == TOK_QMARK ) {
+            lex.putback( Token(Token::TagTakeIP(), InterpolatedFragment(InterpolatedFragment::EXPR, rv.release())) );
+            return Parse_Expr0(lex);
+        }
+        return rv;
+        }
     case TOK_RWORD_IF:
     case TOK_RWORD_WHILE:
     case TOK_RWORD_FOR:
