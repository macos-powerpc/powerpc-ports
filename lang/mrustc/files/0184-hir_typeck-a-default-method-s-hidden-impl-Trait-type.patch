From da14b9dbce47941ff30bdda71cf688046a993440 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 11:48:13 +0000
Subject: [PATCH 184/185] hir_typeck: a default method's hidden `impl Trait`
 type keeps the method's generics from trait to impl

A trait method returning `impl Trait` gets a hidden `erased#<method>_<n>`
associated type whose generics are the method's own.  When the method
has a default body, the trait carries the hidden type's default value,
which names those generics (the `'M0` of `&self`).  ImplRef::get_type
monomorphised that default from the trait to the impl with no method
params at all; with a lifetime parameter on the trait the monomorphiser's
"no params present" passthrough no longer applied, so the first impl of
such a trait died in Trans Enumerate:

  trait SgNode<'r>: Clone {
      fn children(&self) -> impl ExactSizeIterator<Item = Self>;
      fn named_children(&self) -> impl Iterator<Item = Self> { .. }
  }
  impl<'r> SgNode<'r> for Node<'r> { .. }

ast-grep-core 0.45.3 (ast-grep 0.45.3) source.rs:30 / tree_sitter/mod.rs:138:
"<null> BUG: src/hir_typeck/common.cpp:791: Method lifetime parameters
were not expected (got /*M:0*/)".

The first step now maps the default's own generics to themselves
(make_nop_params(1)), and the second step maps them to the projection's
arguments as it does for a GAT's.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/impl_ref.cpp b/src/hir_typeck/impl_ref.cpp
index 80fc3fca..f4878050 100644
--- a/src/hir_typeck/impl_ref.cpp
+++ b/src/hir_typeck/impl_ref.cpp
@@ -335,8 +335,15 @@ namespace {
         {
             static const HIR::TypeRef ty_self = ::HIR::TypeRef::new_self();
             if( e.trait_ptr->m_types.count(name) && e.trait_ptr->m_types.at(name).m_default != HIR::TypeRef() ) {
+                const auto& aty_def = e.trait_ptr->m_types.at(name);
                 // Monomorph twice, first from trait to trait impl, second from trait impl to current
-                auto def = MonomorphStatePtr(&ty_self, &e.impl->m_trait_args, nullptr).monomorph_type(sp, e.trait_ptr->m_types.at(name).m_default);
+                // - The default's own generics (group 1: a GAT's, or for a default method's hidden `erased#` type the
+                //   method's, such as the `'M0` of `&self`) stay as they are for the second step to map to `params`.
+                //   With no method params at all here: ast-grep-core 0.45.3 `trait SgNode<'r> { fn named_children(&self)
+                //   -> impl Iterator<Item = Self> { .. } }` -> Trans Enumerate "Method lifetime parameters were not
+                //   expected (got /*M:0*/)"
+                auto aty_nop = aty_def.m_generics.make_nop_params(1);
+                auto def = MonomorphStatePtr(&ty_self, &e.impl->m_trait_args, &aty_nop).monomorph_type(sp, aty_def.m_default);
                 return this->get_cb_monomorph_traitimpl(sp, params).monomorph_type(sp, def);
             }
             // A hidden `erased#<method>_<n>` type (see `find_erased_slot`): take it from the impl method's return type
