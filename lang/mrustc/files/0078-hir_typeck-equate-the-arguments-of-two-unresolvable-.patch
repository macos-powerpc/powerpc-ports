From 71c323340164d33ae97cfc1131e03e3b151f5903 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 6 Oct 2026 00:19:13 +0000
Subject: [PATCH 78/78] hir_typeck: equate the arguments of two unresolvable
 projections of the same item

nom 8.0.0 branch/mod.rs:149 (the `alt_trait_inner!` expansion for `Choice<(A, B, C, ..)>`),
which nests `<OM::Error as Mode>::combine(<OM::Error as Mode>::combine(e1, e2, ..), e3, ..)`
with `Mode::Output<T>` a GAT:

    warn:0: Typecheck ran for too many iterations, max - 5000
    BUG: src/hir_typeck/expr_cs.cpp:8316: Spare rules left after typecheck stabilised

The inner call's result `<<OM as OutputMode>::Error as Mode>::Output<_V>` is passed where
the outer call expects `<..>::Output<_T>`. Neither projection can be resolved: the Self
type only has a bound, and a projection containing ivars stays Unbound. Equating the two
added the associated-type rule `Output<_V> = <..>::Output<_T>`. `check_associated` found
the bound, saw that the result was the rule's own projection, marked it opaque (upstream
071df7e0) and equated it with the other side, which was still Unbound, so
`equate_types_inner` added the same rule with the sides swapped. That repeated every pass,
so typecheck never reached the fallback phases that resolve the remaining coercions.

On that path, if the other side is the same projection (same Self type, trait, trait
arguments and item) then equate the item's own arguments and consume the rule. An
unresolvable projection equals another only when the arguments match, which is how rustc
relates rigid aliases. Mismatched arguments now give a normal type mismatch error
instead of the BUG.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs.cpp | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index f44333f7..0da29245 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -5747,6 +5747,30 @@ namespace {
                         DEBUG("Would re-create the same rule, setting opaque");
                         output_type.data_mut().as_Path().binding = ::HIR::TypePathBinding::make_Opaque({});
                         #endif
+
+                        // If the other side is the same projection with only the item's own arguments differing (a GAT's
+                        // `<X as Tr>::Out<_1>` against `<X as Tr>::Out<T>`), then equating the two types just pushes this rule
+                        // again with the sides swapped. A projection that can't be resolved is equal to another only if the
+                        // arguments are, so equate those instead.
+                        const auto& l_t = context.get_type(v.left_ty);
+                        if( l_t.data().is_Path() && l_t.data().as_Path().path.m_data.is_UfcsKnown() )
+                        {
+                            const auto& lpe = l_t.data().as_Path().path.m_data.as_UfcsKnown();
+                            if( lpe.item == pe.item && lpe.trait.m_path == pe.trait.m_path
+                                && context.m_ivars.types_equal(lpe.type, pe.type)
+                                && context.m_ivars.pathparams_equal(lpe.trait.m_params, pe.trait.m_params)
+                                && lpe.params.m_types.size() == pe.params.m_types.size()
+                                && lpe.params.m_values.size() == pe.params.m_values.size() )
+                            {
+                                DEBUG("Same opaque projection on both sides, equating the item arguments");
+                                auto l_params = lpe.params.clone();
+                                for(size_t i = 0; i < l_params.m_types.size(); i ++)
+                                    context.equate_types(sp, l_params.m_types[i], pe.params.m_types[i]);
+                                for(size_t i = 0; i < l_params.m_values.size(); i ++)
+                                    context.equate_values(sp, l_params.m_values[i], pe.params.m_values[i]);
+                                return true;
+                            }
+                        }
                     }
                 }
                 context.equate_types(sp, v.left_ty, output_type);
