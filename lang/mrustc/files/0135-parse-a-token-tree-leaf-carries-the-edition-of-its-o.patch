From 74b95560fa08a8d81acde06cf4b0c0f5e7eb6bd6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 18:08:38 +0000
Subject: [PATCH] parse: a token tree leaf carries the edition of its own token

nix 0.17.0 (edition 2015, diskonaut 0.11.0) src/sys/sendfile.rs:35:

    cfg_if! { if #[cfg(any(target_os = "freebsd", ..))] { use sys::uio::IoVec; .. } }

with cfg-if 0.1.10 (edition 2018) failed to resolve: "Cannot find
component 2 of crate::sys::sendfile::sys::uio::IoVec". The captured
`use sys::uio::IoVec;` was parsed with 2018 rules (module-relative)
although its tokens come from a 2015 crate.

Two off-by-ones in how editions travel with tokens:
- Parse_TT read `lex.get_edition()` before `lex.getToken()`, so each leaf
  got its predecessor's edition. A macro's output mixes body tokens (the
  macro's edition) with captured ones (the invocation's): when cfg_if!
  re-invokes itself with `$crate::cfg_if! { @__items .. ($($tokens)*) }`
  the first captured token after the body's `{` turned 2018, and every
  expansion level moved the damage one token further (`use` at level 2,
  `use sys` at level 3).
- TTStream (the stream a macro invocation is matched from) only updated
  its edition on entering/leaving a group, never for a leaf, unlike
  TTStreamO. Capturing `$($tokens:tt)*` inside a body-written `( .. )`
  group then stamped the group's edition on the fragments.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/parse/expr.cpp     | 4 +++-
 src/parse/ttstream.cpp | 6 ++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index a1c49227..709d2e36 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -1648,8 +1648,10 @@ TokenTree Parse_TT(TokenStream& lex, bool unwrapped)
     TokenTree   rv;
     TRACE_FUNCTION_FR("", rv);
 
-    auto edition = lex.get_edition();
+    // NOTE: The edition is that of the token just fetched (a macro's output mixes tokens of its body's edition with
+    // tokens captured from the invocation); reading it before `getToken` gave every leaf its predecessor's edition.
     Token tok = lex.getToken();
+    auto edition = lex.get_edition();
     eTokenType  closer = TOK_PAREN_CLOSE;
     switch(tok.type())
     {
diff --git a/src/parse/ttstream.cpp b/src/parse/ttstream.cpp
index bda22620..a3032ee8 100644
--- a/src/parse/ttstream.cpp
+++ b/src/parse/ttstream.cpp
@@ -33,8 +33,13 @@ Token TTStream::realGetToken()
         assert( m_stack.back().second );
         const TokenTree& tree = *m_stack.back().second;
 
+        // NOTE: Leaves carry their own edition (like TTStreamO): a macro's output mixes tokens from its body with
+        // tokens captured from the invocation, e.g. `cfg_if!` (edition 2018) re-invoking itself with `$($tokens)*`
+        // from a 2015 crate. Matching that inner invocation must see 2015 on those tokens, or a captured
+        // `use sys::uio::IoVec;` is parsed as a 2018 (module-relative) path.
         if(idx == 0 && tree.is_token()) {
             idx ++;
+            m_edition = tree.get_edition();
             m_hygiene_ptr = &tree.hygiene();
             DEBUG(tree.tok());
             return tree.tok();
@@ -45,6 +50,7 @@ Token TTStream::realGetToken()
             const TokenTree&    subtree = tree[idx];
             idx ++;
             if( subtree.size() == 0 ) {
+                m_edition = subtree.get_edition();
                 m_hygiene_ptr = &subtree.hygiene();
                 DEBUG(subtree.tok());
                 return subtree.tok().clone();
