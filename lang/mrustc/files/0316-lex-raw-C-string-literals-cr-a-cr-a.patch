From 74d4c6660be4c849d51bae5ecfa5019c2da3100a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 02:26:14 +0000
Subject: [PATCH] lex: raw C string literals (`cr"a"`, `cr#"a"#`)

pyo3 0.28.3 (py-cryptography 48.0.0) src/conversions/num_complex.rs:235,
in `#[cfg(test)] mod tests` (lexed before cfg is applied):

    let module = PyModule::from_code(py, cr#"
    class A:
        def __complex__(self): return 3.0+1.2j
    ..
                    "#, c"test.py", &generate_unique_module_name("test"))

    num_complex.rs:235:21 error:0: Unexpected token TOK_HASH, expected TOK_PAREN_CLOSE

The lexer knew `c"..."` but not raw C strings: `cr` was an identifier.
An identifier `cr` followed by `"` or `#` now goes to the raw string reader,
which makes a C string token of the text (its UTF-8 bytes, no escapes);
`cr#` not followed by a string is an error. libproc_macro's lexer has
handled them since 0309.

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/parse/lex.cpp b/src/parse/lex.cpp
index 5f6d050f..07780cb6 100644
--- a/src/parse/lex.cpp
+++ b/src/parse/lex.cpp
@@ -817,7 +817,7 @@ Token Lexer::getTokenInt()
     throw "Fell off the end of getTokenInt";
 }
 
-Token Lexer::getTokenInt_RawString(bool is_byte)
+Token Lexer::getTokenInt_RawString(bool is_byte, bool is_cstring)
 {
     // Raw string (possibly byte)
     Codepoint ch = this->getc();
@@ -828,6 +828,10 @@ Token Lexer::getTokenInt_RawString(bool is_byte)
         ch = this->getc();
     }
     if( ch != '"' ) {
+        if( is_cstring ) {
+            // (Only called for `cr"` and `cr#`)
+            throw ParseError::Generic(*this, "Expected '\"' after hashes following `cr`");
+        }
         // 'b' or 'br' identifier
         if( hashes == 0 ) {
             this->ungetc(); // Unget the not '"'
@@ -891,7 +895,8 @@ Token Lexer::getTokenInt_RawString(bool is_byte)
             }
         }
     }
-    return Token(is_byte ? TOK_BYTESTRING : TOK_STRING, mv$(val), realGetHygiene());
+    // A raw C string's value is its text, as UTF-8 bytes (no escapes)
+    return Token(is_cstring ? TOK_CSTRING : is_byte ? TOK_BYTESTRING : TOK_STRING, mv$(val), realGetHygiene());
 }
 Token Lexer::getTokenInt_Identifier(Codepoint leader, Codepoint leader2, bool parse_reserved_word)
 {
@@ -904,6 +909,11 @@ Token Lexer::getTokenInt_Identifier(Codepoint leader, Codepoint leader2, bool pa
         str += ch;
         ch = this->getc();
     }
+    // Raw C string literal: `cr"a"`, `cr#"a"#` (pyo3 0.28.3 src/conversions/num_complex.rs:235)
+    if( str == "cr" && (ch == '"' || ch == '#') ) {
+        this->ungetc();
+        return this->getTokenInt_RawString(/*is_byte=*/false, /*is_cstring=*/true);
+    }
     if( ch == '\"') {
         // C String literal
         if( str == "c" ) {
diff --git a/src/parse/lex.hpp b/src/parse/lex.hpp
index 346602d8..eedb1c0e 100644
--- a/src/parse/lex.hpp
+++ b/src/parse/lex.hpp
@@ -60,7 +60,7 @@ private:
     Token getTokenInt();
 
     signed int getSymbol();
-    Token getTokenInt_RawString(bool is_byte);
+    Token getTokenInt_RawString(bool is_byte, bool is_cstring=false);
     Token getTokenInt_Identifier(Codepoint ch, Codepoint ch2='\0', bool parse_reserved_word=true);
     enum class NumMode {
         BIN,
