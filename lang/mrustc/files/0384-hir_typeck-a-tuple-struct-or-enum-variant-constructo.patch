From cf4faffe528eb53358c5e7b2fcf5e24ba8bc0b3a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 00:44:18 +0000
Subject: [PATCH 384/385] hir_typeck: a tuple-struct or enum-variant
 constructor call applies the type's bounds

gio 0.19.0 (librsvg 2.58.5) src/subclass/action_group.rs:391/449

    struct PtrHolder<T, F: Fn(*mut T) + 'static>(*mut T, F);
    ...
    instance.set_qdata(
        state_type_quark,
        PtrHolder(state_type, |ptr| glib::ffi::g_free(ptr as *mut _)),
    );

failed with `warn: Spare rule - _Cast {_/*50*/} -> *mut c_void` and then
`BUG: src/hir_typeck/expr_cs.cpp:8826: Spare rules left after typecheck
stabilised`.

The closure's parameter type is only given by the struct's `F: Fn(*mut T)`
bound, and the _TupleVariant visitor (expr_cs__enum.cpp) never turned the
type's generic bounds into rules: a struct literal and a function call do
(apply_bounds_as_rules), and the constructor-as-a-value arms of _PathValue
had the call commented out. rustc treats a constructor as a function whose
predicates are the type's, so closure signature deduction sees the bound.
The same gap let `Needs(No)` for `struct Needs<T: Marker>(T)` through
unchecked while `Needs { 0: No }` was rejected.

_TupleVariant now applies the struct's / enum's bounds (impl level, the path
params as the monomorph state, as the struct-literal visitor does) and
the STRUCT_CONSTR / ENUM_VAR_CONSTR arms of _PathValue apply them to
the constructor value.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_typeck/expr_cs__enum.cpp b/src/hir_typeck/expr_cs__enum.cpp
index 83c5aab5..1a38c6ea 100644
--- a/src/hir_typeck/expr_cs__enum.cpp
+++ b/src/hir_typeck/expr_cs__enum.cpp
@@ -1429,6 +1429,21 @@ namespace typecheck
                 this->context.equate_types_coerce(node.span(), *des_ty,  node.m_args[i]);
             }
 
+            // Convert the bounds on the type into rules (as `_StructLiteral` does): a constructor is a function whose
+            // predicates are the type's, so `struct PtrHolder<T, F: Fn(*mut T)>(*mut T, F)` gives a closure argument
+            // its parameter type (gio 0.19.0 subclass/action_group.rs:449 `PtrHolder(p, |ptr| g_free(ptr as *mut _))`:
+            // "Spare rule - _Cast {_} -> *mut c_void")
+            TU_MATCH_HDRA( (ty.data().as_Path().binding), {)
+            default:
+                break;
+            TU_ARMA(Enum, e) {
+                apply_bounds_as_rules(context, sp, e->m_params, monomorph_cb, /*is_impl_level=*/true);
+                }
+            TU_ARMA(Struct, e) {
+                apply_bounds_as_rules(context, sp, e->m_params, monomorph_cb, /*is_impl_level=*/true);
+                }
+            }
+
             auto _ = this->push_inner_coerce_scoped(true);
             for( auto& val : node.m_args ) {
                 val->visit( *this );
@@ -1931,7 +1946,8 @@ namespace typecheck
                     fix_param_count(sp, this->context, ::HIR::TypeRef(), false, e, s.m_params, e.m_params);
 
                     auto ms = MonomorphStatePtr(nullptr, &e.m_params, nullptr);
-                    //apply_bounds_as_rules(this->context, sp, s.m_params, monomorph_cb, /*is_impl_level=*/true);
+                    // The constructor's predicates are the type's (`let f = PtrHolder; f(p, |ptr| ..)`, see _TupleVariant)
+                    apply_bounds_as_rules(this->context, sp, s.m_params, ms, /*is_impl_level=*/true);
                     auto ty = HIR::TypeRef(HIR::TypeData::make_NamedFunction({ node.m_path.clone(), &s }));
 
                     this->context.equate_types(sp, node.m_res_type, ty);
@@ -1949,7 +1965,7 @@ namespace typecheck
                     //const auto& var_data = str.m_data.as_Tuple();
 
                     auto ms = MonomorphStatePtr(nullptr, &e.m_params, nullptr);
-                    //apply_bounds_as_rules(this->context, sp, enm.m_params, monomorph_cb, /*is_impl_level=*/true);
+                    apply_bounds_as_rules(this->context, sp, enm.m_params, ms, /*is_impl_level=*/true);
                     auto ty = HIR::TypeRef(HIR::TypeData::make_NamedFunction({
                         node.m_path.clone(),
                         HIR::TypeData_NamedFunction_Ty::make_EnumConstructor({ &enm, idx })
