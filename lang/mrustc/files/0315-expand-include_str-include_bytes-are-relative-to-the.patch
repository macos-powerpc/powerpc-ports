From 516e46e7b8224071f397221c4794a08200341a16 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 02:12:42 +0000
Subject: [PATCH] expand: include_str!/include_bytes! are relative to the invoking file,
 also in an inline module

bindgen 0.72.1 (py314-qh3 2.0.4) codegen/mod.rs:5401, inside
`pub(crate) mod utils { .. }` (line 5258) of codegen/mod.rs:

    include_str!("./bitfield_unit_raw_ref_macros.rs")

    codegen/mod.rs:5401:1 error:0: Cannot open file
      .../bindgen-0.72.1/codegen/utils/./bitfield_unit_raw_ref_macros.rs for include_str!

Paths in include_str!/include_bytes! are relative to the source file of the
(outermost) invocation, as rustc resolves them from the call site.
mrustc used the module's file path, which for an inline module is the
directory its `mod x;` children would be in (codegen/utils/). include!
already used the invocation's file (Span::get_top_file_span); all three now
share include_base(), which falls back to the module path when the
outermost span isn't in a file (get_top_file_span stops with a TODO then).

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/expand/include.cpp b/src/expand/include.cpp
index 9b450609..93ff0605 100644
--- a/src/expand/include.cpp
+++ b/src/expand/include.cpp
@@ -29,6 +29,22 @@ namespace {
         return mv$( string_np->m_value );
     }
 
+    /// What `include!`, `include_str!` and `include_bytes!` paths are relative to: the source file of the outermost
+    /// invocation (rustc: the call site). The module's own path is a directory for an inline module: bindgen 0.72.1
+    /// codegen/mod.rs:5401 `include_str!("./bitfield_unit_raw_ref_macros.rs")` inside `pub(crate) mod utils { .. }`
+    /// looked in codegen/utils/. Falls back to it when the outermost span isn't in a file.
+    ::std::string include_base(const Span& sp, const AST::Module& mod)
+    {
+        const Span* top = &sp;
+        while( top->get() && (*top)->parent_span != Span() ) {
+            top = &(*top)->parent_span;
+        }
+        if( const auto* ts = dynamic_cast<const SpanInner_Source*>(top->get()) ) {
+            return ts->filename.c_str();
+        }
+        return mod.m_file_info.path;
+    }
+
     ::std::string get_path_relative_to(const ::std::string& base_path, ::std::string path)
     {
         DEBUG(base_path << ", " << path);
@@ -84,8 +100,7 @@ class CIncludeExpander:
         auto path = get_string(sp, lex, crate, mod);
         GET_CHECK_TOK(tok, lex, TOK_EOF);
 
-        //::std::string file_path = get_path_relative_to(mod.m_file_info.path, mv$(path));
-        ::std::string file_path = get_path_relative_to(sp.get_top_file_span().filename.c_str(), mv$(path));
+        ::std::string file_path = get_path_relative_to(include_base(sp, mod), mv$(path));
         crate.m_extra_files.push_back(file_path);
 
         try {
@@ -112,7 +127,7 @@ class CIncludeBytesExpander:
         auto path = get_string(sp, lex, crate, mod);
         GET_CHECK_TOK(tok, lex, TOK_EOF);
 
-        ::std::string file_path = get_path_relative_to(mod.m_file_info.path, mv$(path));
+        ::std::string file_path = get_path_relative_to(include_base(sp, mod), mv$(path));
         crate.m_extra_files.push_back(file_path);
 
         ::std::ifstream is(file_path);
@@ -139,7 +154,7 @@ class CIncludeStrExpander:
         auto path = get_string(sp, lex, crate, mod);
         GET_CHECK_TOK(tok, lex, TOK_EOF);
 
-        ::std::string file_path = get_path_relative_to(mod.m_file_info.path, mv$(path));
+        ::std::string file_path = get_path_relative_to(include_base(sp, mod), mv$(path));
         crate.m_extra_files.push_back(file_path);
 
         ::std::ifstream is(file_path);
