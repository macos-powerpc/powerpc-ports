From f0f87c1412c49153d7b2577062cef351152d7af9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 12:49:13 +0000
Subject: [PATCH] hir_typeck: apply a generic parameter's default to the ivar
 its ivar was unified with

core-graphics 0.24.0 (pngquant 3.0.3) display.rs:591, with core-foundation
0.10.1's `pub struct CFArray<T = *const c_void>`:

    let array_opt: Option<CFArray> = unsafe { .. Some(CFArray::wrap_under_create_rule(array_ref)) .. };
    .. modes.into_iter().map(|value0| { let x = *value0.deref() as *mut CGDisplayMode; .. })

Nothing but the default fixes T. Both the annotation's `CFArray` and the
`CFArray::` path got an ivar carrying the default (`*const c_void`), and
the two were unified into a third ivar before the generic defaults were
applied. The defaults loop only applied a default to an ivar that still
resolved to itself, so neither applied, and T stayed unknown: "Spare Rule
- _ : FromVoid", "Spare rule - _Cast {_} -> *mut CGDisplayMode", "BUG:
src/hir_typeck/expr_cs.cpp:8368: Spare rules left after typecheck
stabilised".

A default is now applied to whatever unknown ivar its ivar resolves to
(the first one to get there wins).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 2d598c45..811c1073 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -8281,7 +8281,11 @@ void Typecheck_Code_CS(const typeck::ModuleState& ms, t_args& args, const ::HIR:
                 {
                     const auto& ty_l = context.m_ivars.get_type(i);
 
-                    if( TU_TEST1(ty_l.data(), Infer, .index == i) )
+                    // The ivar may since have been unified with another still unknown ivar, which then holds no
+                    // default itself: apply this one to the ivar it resolves to (the first default to get there wins).
+                    // - core-graphics 0.24.0: `let a: Option<CFArray> = Some(CFArray::wrap_under_create_rule(..))`,
+                    //   two `CFArray<_>` (`T = *const c_void`) unified before the defaults are applied
+                    if( const auto* te = ty_l.data().opt_Infer() )
                     {
                         if( ent.types_default.size() != 1 )
                         {
@@ -8289,7 +8293,7 @@ void Typecheck_Code_CS(const typeck::ModuleState& ms, t_args& args, const ::HIR:
                         }
                         else
                         {
-                            context.m_ivars.set_ivar_to(i, ent.types_default.begin()->clone());
+                            context.m_ivars.set_ivar_to(te->index, ent.types_default.begin()->clone());
                         }
                     }
                 }
