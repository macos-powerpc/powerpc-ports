From 1a58b4e90795da2f8f789a5f57d847978b9f3afc Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 14:32:05 +0000
Subject: [PATCH] minicargo: a binary of a package without a library waits for
 the build script

pngquant 3.0.3 has no library, a `[[bin]]` and a build script that compiles
its C half with cc (`cargo:rustc-link-lib=static=pngquant`,
`cargo:rustc-link-search=native=$OUT_DIR`). For such a root package the
build script job was created but the binary's job didn't depend on it, so
with -j2 the binary was compiled while the script was still running and
got none of its link flags (they're read from the parsed script output
when the job starts):

    Undefined symbols for architecture ppc: "_pngquant_main_internal", ..

The binary job now depends on the script run job (and is rebuilt when it
runs), as a library job does.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tools/minicargo/build.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/tools/minicargo/build.cpp b/tools/minicargo/build.cpp
index 7f3c11f3..6d981950 100644
--- a/tools/minicargo/build.cpp
+++ b/tools/minicargo/build.cpp
@@ -581,6 +581,15 @@ bool BuildList::build(BuildOptions opts, unsigned num_jobs, bool dry_run)
             is_dirty |= convert_state.handle_dep(job->m_dependencies, output_ts, k);
         }
         else {
+            // Without a library, the build script is run for the binaries, which need its output (link flags, cfgs,
+            // env) when they start: wait for it, as a library does
+            // - pngquant 3.0.3: the C half (`cc` -> libpngquant.a, `cargo:rustc-link-lib=static=pngquant`) was missing
+            //   from the binary's link when the binary started before the script had finished
+            if( bs_job_name != "" ) {
+                job->m_dependencies.push_back(bs_job_name);
+                is_dirty = true;
+            }
+            job->m_build_script = build_script;
             m_root_manifest.iter_main_dependencies([&](const PackageRef& dep) {
                 if( !dep.is_disabled() )
                 {
