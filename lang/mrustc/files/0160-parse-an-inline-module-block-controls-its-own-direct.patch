From 91f45832259510a11f94af20db4b525b589ba529 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 04:21:05 +0000
Subject: [PATCH] parse: an inline module block controls its own directory

interprocess 2.4.4 src/local_socket.rs (skim 5.7.3):

    mod stream {
        pub(super) mod r#enum;
        ..
    }

    error: Can't find file for 'enum' in '.../local_socket/stream/'

An inline `mod blk { .. }` takes as its path the directory its `mod x;`
items load from. In a non-mod.rs file (local_socket.rs) that directory
already includes the file's module name, `local_socket/stream/`. The
block still inherited "doesn't control its directory" from that file,
so `mod x;` inside it applied the non-mod.rs rule again,
`dirname(path) / <module name> / x`, and looked for
`local_socket/stream/stream/enum.rs`. Blocks in lib.rs, main.rs or
mod.rs files control their directory, which is why only this case
failed. Every `mod x;` inside such a block failed the same way; the raw
identifier is incidental.

The block now always controls its directory. Only `mod x;` items in
blocks under a non-mod.rs parent change, and those could never load
before.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 63cd2c5a..ed353089 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -2435,6 +2435,12 @@ namespace {
         case TOK_BRACE_OPEN:
             submod.m_file_info.path = sub_path.str() + "/";
             submod.m_file_info.in_mod_block = true;
+            // The block's path is already the directory its `mod x;` items load from (for a non-mod.rs parent it
+            // includes that file's module name), so the block controls it: the non-controlling rule would add the
+            // block's own name again
+            // - interprocess 2.4.4 local_socket.rs `mod stream { pub(super) mod r#enum; }`: looked for
+            //   `local_socket/stream/stream/enum.rs` -> "Can't find file for 'enum'"
+            submod.m_file_info.controls_dir = true;
             submod.m_file_info.is_disabled = !H::check_item_cfg(meta_items);
             // TODO: If cfg fails, just eat the TT until a matching #[cfg]?
             // - Or, mark the file infor as not being valid (so child modules don't try to load)
