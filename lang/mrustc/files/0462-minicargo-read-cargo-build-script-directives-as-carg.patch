From 05c46b91933e0f7329f9ade987262d80cdf7b76a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 11 Nov 2026 10:10:23 +0000
Subject: [PATCH] minicargo: read `cargo::` build script directives as `cargo:` ones

sequoia-cert-store 0.7.6 (meli 0.9.0, through sqz) prints
`cargo::rustc-cfg=certd` and `cargo::rustc-cfg=pep`, the double-colon
form Cargo 1.77 added. minicargo only knew `cargo:`, so the key came out
as `:rustc-cfg`, matched nothing and the line was dropped without a
word: the crate was built without its certd and pep cfgs. The same
happened to every other directive written that way (rustc-env,
rustc-link-lib, rustc-link-search, ...).

Both forms now give the same directive. In the new form a links
crate's metadata is `cargo::metadata=KEY=VALUE` (DEP_<LINKS>_<KEY> for
dependent build scripts), and any other unknown key (warning, error)
is not metadata. Metadata names follow cargo's envify, `-` -> `_`, and
a line without `=` is skipped instead of read past its end.

Assisted-by: Claude Opus 5.5
---

diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index 28d01613..5b1d4939 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -1575,12 +1575,43 @@ void PackageManifest::load_build_script(const ::std::string& path)
         std::getline(is, line);
         if( line.compare(0, 5+1, "cargo:") == 0 )
         {
-            size_t start = 5+1;
-            size_t eq_pos = line.find_first_of('=');
+            // `cargo::KEY=VALUE` (Cargo 1.77) is the same directive, and a links crate's metadata is `cargo::metadata=KEY=VALUE`
+            bool double_colon = line.compare(0, 7, "cargo::") == 0;
+            size_t start = double_colon ? 7 : 5+1;
+            size_t eq_pos = line.find_first_of('=', start);
+            bool is_metadata = false;
+            if( double_colon && line.compare(start, eq_pos - start, "metadata") == 0 && eq_pos != ::std::string::npos ) {
+                start = eq_pos + 1;
+                eq_pos = line.find_first_of('=', start);
+                is_metadata = true;
+            }
+            if( eq_pos == ::std::string::npos ) {
+                DEBUG("No `=` in build script output line `" << line << "`");
+                continue;
+            }
             ::helpers::string_view  key { line.c_str() + start, eq_pos - start };
             ::helpers::string_view  value { line.c_str() + eq_pos + 1, line.size() - eq_pos - 1 };
 
-            if( key == "minicargo-pre-build" ) {
+            // DEP_<links>_<key> for the build scripts of dependent packages (cargo's envify: uppercase, `-` -> `_`)
+            auto push_metadata = [&]() {
+                if( this->m_links == "" ) {
+                    DEBUG("Metadata '" << key << "' = '" << value << "' from a package without `links`");
+                    return;
+                }
+                ::std::string   varname;
+                varname += "DEP_";
+                for(auto c : this->m_links)
+                    varname += c == '-' ? '_' : static_cast<char>(::std::toupper(c));
+                varname += "_";
+                for(auto c : key)
+                    varname += c == '-' ? '_' : static_cast<char>(::std::toupper(c));
+                rv.downstream_env.push_back(::std::make_pair( varname, static_cast<::std::string>(value) ));
+            };
+
+            if( is_metadata ) {
+                push_metadata();
+            }
+            else if( key == "minicargo-pre-build" ) {
                 rv.pre_build_commands.push_back(value);
             }
             // cargo:rustc-link-search=foo/bar/baz
@@ -1686,15 +1717,9 @@ void PackageManifest::load_build_script(const ::std::string& path)
             }
             // - Ignore
             else {
-                if( this->m_links != "" && std::find(key.begin(), key.end(), '-') == key.end() ) {
-                    ::std::string   varname;
-                    varname += "DEP_";
-                    for(auto c : this->m_links)
-                        varname += ::std::toupper(c);
-                    varname += "_";
-                    for(auto c : key)
-                        varname += ::std::toupper(c);
-                    rv.downstream_env.push_back(::std::make_pair( varname, static_cast<::std::string>(value) ));
+                // Any other `cargo:KEY` is metadata; in the `cargo::` form it's an unknown directive (warning, error)
+                if( !double_colon && this->m_links != "" && std::find(key.begin(), key.end(), '-') == key.end() ) {
+                    push_metadata();
                 }
                 else {
                     DEBUG("TODO: '" << key << "' = '" << value << "'");
