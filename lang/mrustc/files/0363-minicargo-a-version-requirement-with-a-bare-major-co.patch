From 98dcf3fe96ad9cba2034ccce48a0dfa500669ec5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 09:12:39 +0000
Subject: [PATCH] minicargo: a version requirement with a bare major covers
 every version with that major

arti 2.7.0 (`--package arti`):
    While processing .../num_enum_derive-0.7.6
    EXCEPTION: Unable to find a manifest for proc-macro-crate:>=1.0,<=3.0
num_enum_derive 0.7.6 has `proc-macro-crate = { version = ">= 1, <= 3", optional = true }` and the vendored
proc-macro-crate is 3.x. Cargo reads omitted version parts as the range they leave open: `<= 3` = `< 4.0.0`,
`> 3` = `>= 4.0.0`, `= 3` = `>= 3.0.0, < 4.0.0`. minicargo filled the omitted minor with 0 and compared it, so
`<= 3` rejected 3.4.0, `> 1` accepted 1.5.0 and `=2` rejected 2.3.0 (only caret and tilde had the bare-major
rule). `I.J` forms were already right: the patch is left out of comparisons when it was not written.

Kit version-spec-minicargo-test (dry run): arti's shape plus every operator with a bare major, highest version
within the range, negatives, and the `I.J` / `I.J.K` / `>=`/`<` forms as controls. 0362: 4 of 16 fail, the first
with the arti message.

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index 3f255b78..28d01613 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -2001,18 +2001,31 @@ PackageVersionSpec PackageVersionSpec::from_string(const ::std::string& s)
             v.minor = 0;
             v.patch = 0;
             v.patch_set = false;
-            // Bare major version (e.g. `chrono = "0"` in vergen 3.2): caret/tilde semantics for a
-            // lone major are "any version with this major" - `0` matches `0.4.x` (unlike `0.0`)
-            if( ty == PackageVersionSpec::Bound::Type::Compatible || ty == PackageVersionSpec::Bound::Type::MinorCompatible )
+            // Bare major version: a lone major stands for every version with this major, as cargo reads it
+            // - `0` (caret), `~0` and `=0` match `0.4.x` (e.g. `chrono = "0"` in vergen 3.2; unlike `0.0`)
+            // - `<= 3` is `< 4.0.0` (num_enum_derive 0.7.6 `proc-macro-crate = ">= 1, <= 3"`), `> 3` is `>= 4.0.0`
+            // - `>= 3` and `< 3` are the same as `3.0.0`
+            // (`I.J` needs nothing: `patch_set = false` leaves the patch out of comparisons)
+            switch(ty)
             {
+            case PackageVersionSpec::Bound::Type::Compatible:
+            case PackageVersionSpec::Bound::Type::MinorCompatible:
+            case PackageVersionSpec::Bound::Type::Equal:
                 rv.m_bounds.push_back(PackageVersionSpec::Bound { PackageVersionSpec::Bound::Type::GreaterEqual, v });
-                rv.m_bounds.push_back(PackageVersionSpec::Bound { PackageVersionSpec::Bound::Type::Less, PackageVersion { v.major + 1 } });
-
-                while( pos < s.size() && isblank(s[pos]) )
-                    pos ++;
-                if(pos == s.size())
-                    break ;
-                continue ;
+                ty = PackageVersionSpec::Bound::Type::Less;
+                v = PackageVersion { v.major + 1 };
+                break;
+            case PackageVersionSpec::Bound::Type::LessEqual:
+                ty = PackageVersionSpec::Bound::Type::Less;
+                v = PackageVersion { v.major + 1 };
+                break;
+            case PackageVersionSpec::Bound::Type::Greater:
+                ty = PackageVersionSpec::Bound::Type::GreaterEqual;
+                v = PackageVersion { v.major + 1 };
+                break;
+            case PackageVersionSpec::Bound::Type::GreaterEqual:
+            case PackageVersionSpec::Bound::Type::Less:
+                break;
             }
         }
 
