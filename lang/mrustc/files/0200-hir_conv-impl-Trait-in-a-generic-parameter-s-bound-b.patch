From d667b22c0c4fdbf691eec35270ed9d9fece83385 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 17:20:25 +0000
Subject: [PATCH] hir_conv: `impl Trait` in a generic parameter's bound becomes
 a generic like in an argument

Argument-position `impl Trait` is turned into an unnamable generic
parameter when the function's argument types are bound. The same
`impl Trait` inside a generic parameter's bound was never visited in
that mode, so it hit the "not a return type" error: security-framework
3.7.0 trust.rs:178 `fn set_trust_ocsp_response<I: Iterator<Item = impl
AsRef<[u8]>>>(&mut self, ocsp_response: I)` (tombi), "Use of an erased
type outside of a function return - impl AsRef<[u8]>+use<'M0,>".

visit_function now visits the function's bounds first, with the same
conversion; each bound is taken out while it is visited since the
conversion appends to the bound list.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_conv/bind.cpp b/src/hir_conv/bind.cpp
index 7299fe96..cb1838aa 100644
--- a/src/hir_conv/bind.cpp
+++ b/src/hir_conv/bind.cpp
@@ -656,6 +656,18 @@ namespace {
             auto _ = this->m_ms.set_item_generics(item.m_params);
             m_fcn_ptr = &item;
 
+            // `impl Trait` in a generic parameter's bound (`fn set<I: Iterator<Item = impl AsRef<[u8]>>>(&mut self,
+            // it: I)`, security-framework 3.7.0 trust.rs:178) is argument position too: it becomes a generic the same
+            // way. Each bound is taken out while it is visited, as the conversion appends to the bound list (which
+            // may move the entries); the appended bounds name the new generic and hold no erased type.
+            for(size_t i = 0; i < item.m_params.m_bounds.size(); i ++)
+            {
+                auto bound = ::std::move(item.m_params.m_bounds[i]);
+                TRACE_FUNCTION_F("BOUND " << bound);
+                ::HIR::Visitor::visit_generic_bound(bound);
+                item.m_params.m_bounds[i] = ::std::move(bound);
+            }
+
             // Visit arguments
             // - Used to convert `impl Trait` in argument position into generics
             // - Done first so the path in return-position `impl Trait` is valid
