From b8c847e2f6078ee3158bb55387fdda2cb80ff467 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 17:58:59 +0000
Subject: [PATCH] trans: a shim's type visitor indexes a type's full entry, not
 its prototype

0196 runs the type visitor over each trait-object method shim, seeded
with the types the main enumeration already collected. That list can
hold a type twice: a shallow entry (a prototype, from a use behind
a reference or pointer) and the later full definition. The seed indexed
whichever of the two the sort left first, and when that was the shallow
one the shim's visit "upgraded" it by appending another full entry, so
the C file defined the struct twice: the libstd 1.90 rebuild on the G5
with 0196, "redefinition of struct e_..Result<(), fmt::Error>" (and the
"incompatible types" errors that follow from the duplicate definitions)
from `format_symbol_name` calling `<dyn fmt::Write>::write_str` through
a function value.

The seed now sorts a full entry before a shallow one of the same type
and keeps only the first, so the shim's visit finds the definition and
returns early.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/trans/enumerate.cpp b/src/trans/enumerate.cpp
index ce183467..8f72d14a 100644
--- a/src/trans/enumerate.cpp
+++ b/src/trans/enumerate.cpp
@@ -935,7 +935,19 @@ namespace
             visited_map.resize(out_list.size());
             for(size_t i = 0; i < visited_map.size(); i ++)
                 visited_map[i] = i;
-            ::std::sort(visited_map.begin(), visited_map.end(), [&](size_t a, size_t b){ return out_list[a].first < out_list[b].first; });
+            // A type can be listed twice, shallow (a prototype, e.g. from a fn-pointer signature) and later in full:
+            // index the full entry, or this visitor would append a second full definition after finding the shallow
+            // one ("redefinition of struct" from the C compiler: libstd 1.90 `Result<(), fmt::Error>`, returned by
+            // the `<dyn fmt::Write>::write_str` shim that `format_symbol_name` calls through a function value)
+            ::std::sort(visited_map.begin(), visited_map.end(), [&](size_t a, size_t b){
+                if( out_list[a].first != out_list[b].first )
+                    return out_list[a].first < out_list[b].first;
+                return out_list[a].second < out_list[b].second;    // full (false) sorts before shallow (true)
+                });
+            visited_map.erase(
+                ::std::unique(visited_map.begin(), visited_map.end(), [&](size_t a, size_t b){ return out_list[a].first == out_list[b].first; }),
+                visited_map.end()
+                );
         }
 
         void visit_struct(const ::HIR::GenericPath& path, const ::HIR::Struct& item) {
