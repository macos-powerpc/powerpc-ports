+        // An identifier directly after a literal is its suffix (lazy_regex `"re"i`)
+        fn take_suffix<T: Iterator<Item=char>>(it: &mut CharStream<T>, val: crate::token_tree::LiteralValue) -> crate::token_tree::LiteralValue
+        {
+            if !it.is_complete() && (it.cur() == '_' || it.cur().is_alphabetic()) {
+                let s = get_ident(it, String::new());
+                crate::token_tree::LiteralValue::Suffixed(Box::new(val), s)
+            }
+            else {
+                val
+            }
+        }
 
         'outer: while ! it.is_complete()
         {
@@ -338,13 +349,14 @@ impl ::std::str::FromStr for TokenStream {
