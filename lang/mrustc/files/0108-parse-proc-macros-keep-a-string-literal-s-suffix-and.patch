-                        rv.push(Literal {
-                            span: crate::Span::call_site(),
-                            val: if is_byte {
+                        let val = if is_byte {
                                 crate::token_tree::LiteralValue::ByteString(s.into_bytes())
                             } else {
                                 crate::token_tree::LiteralValue::String(s)
-                            }
+                            };
+                        rv.push(Literal {
+                            span: crate::Span::call_site(),
+                            val: take_suffix(&mut it, val),
