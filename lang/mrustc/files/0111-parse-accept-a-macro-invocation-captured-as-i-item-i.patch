From 1346be2f8e36280d58f8d8c8e95f84b20aa34a50 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 10:42:27 +0000
Subject: [PATCH] parse: accept a macro invocation captured as `$i:item` inside
 an impl or trait body

tokio 1.43.0 runtime/scheduler/multi_thread/handle/metrics.rs:

    impl Handle {
        cfg_unstable_metrics! {
            cfg_64bit_metrics! { pub(crate) fn spawned_tasks_count(&self) -> u64 { .. } }
            ..
        }
    }

cfg_unstable_metrics! re-emits each `$item:item` with `#[cfg(tokio_unstable)]`
in front, and the first item is itself a macro invocation. Parse_Impl_Item
had no case for an interpolated MacroInv item: "BUG: src/parse/root.cpp:1330:
TODO: Parse_Impl_Item - Interpolated item into impl: MacroInv".

The impl path now stores it as an impl macro item, the same as a direct
invocation. The fragment's attributes stay on it, so the `#[cfg]` still
removes it. Parse_Trait_Item already returns an invocation as a MacroInv
item, so it now accepts the interpolated form too. All impl-level cfg macros
in tokio 1.43.0 hold `fn`, `const` (already handled) or nested invocations.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/parse/root.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index a5b2eee9..63cd2c5a 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -776,6 +776,7 @@ AST::Named<AST::Item> Parse_Trait_Item(TokenStream& lex)
         TU_ARMA(Function, e) { (void)e; }
         TU_ARMA(Static, e) { (void)e; }
         TU_ARMA(Type, e) { (void)e; }
+        TU_ARMA(MacroInv, e) { (void)e; }
         }
         return item;
     }
@@ -1335,6 +1336,12 @@ void Parse_Impl_Item(TokenStream& lex, AST::Impl& impl)
             TU_ARMA(Static, e) {
                 impl.add_static(item.span, std::move(item.attrs), item.vis, false, item.name, std::move(e) );
                 }
+            // A macro invocation captured as `$i:item`, kept with its attributes (so a `#[cfg]` still removes it)
+            // - tokio 1.43.0: `cfg_unstable_metrics! { cfg_64bit_metrics! { .. } .. }` in `impl Handle`
+            TU_ARMA(MacroInv, e) {
+                impl.add_macro_invocation( std::move(e) );
+                impl.items().back().attrs = std::move(item.attrs);
+                }
             //TU_ARMA(Type, e) {
             //    impl.add_type(item.span, std::move(item.attrs), item.vis, false, item.name, std::move(e.m_params), std::move(e.m_type));
             //    }
