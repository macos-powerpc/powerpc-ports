-TransList Trans_Enumerate_Public(::HIR::Crate& crate)
+TransList Trans_Enumerate_Public(::HIR::Crate& crate, bool link_named_roots)
 {
     static Span sp;
     EnumState   state { crate };
 
     Trans_Enumerate_Public_Mod(state, crate.m_root_module,  ::HIR::SimplePath(crate.m_crate_name,{}), true);
+    // A static archive is consumed by C code: like in an executable, its `#[no_mangle]`/`#[export_name]` functions
