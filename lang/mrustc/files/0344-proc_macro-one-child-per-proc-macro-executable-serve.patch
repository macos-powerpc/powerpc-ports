+    /// An idle proc-macro child in server mode: a child built against a libproc_macro that knows
+    /// `MRUSTC_PROC_MACRO_SERVER=1` keeps serving invocations after its first (the next request is a macro name on its
+    /// stdin), so one process per executable serves the whole expand pass. That is rustc's model (a proc-macro crate is
+    /// loaded once per crate compilation) and the one proc macros rely on for state between invocations: enum_dispatch
+    /// links `#[enum_dispatch] enum` and `#[enum_dispatch(Enum)] trait` through process globals and emits the impls
+    /// from whichever invocation runs second. It also saves a process spawn per invocation.
+    struct PooledChild
+    {
+        pid_t   pid;
+        int     child_stdin;
+        int     child_stdout;
+    };
+    /// Executable path -> its idle child (at most one per executable, so state lives in a single process)
+    ::std::map<::std::string, PooledChild>  g_proc_macro_pool;
+
+    bool proc_macro_pool_enabled()
+    {
+        static int  enabled = -1;
+        if( enabled < 0 ) {
+            const char* v = getenv(PROC_MACRO_SERVER_VAR);
+            enabled = (v && ::std::strcmp(v, "0") == 0) ? 0 : 1;
+            if( !enabled ) {
+                DEBUG("Proc-macro children stay one-shot (" << PROC_MACRO_SERVER_VAR << "=0)");
+            }
+        }
+        return enabled != 0;
+    }
+    /// EOF where the child waits for its next request: it exits
+    void close_pooled_child(const PooledChild& c)
+    {
+        close(c.child_stdin);
+        close(c.child_stdout);
+        int status;
+        waitpid(c.pid, &status, 0);
+    }
+}
+#endif
+/// End of the expand pass: the pooled children have served their last invocation
+void ProcMacro_ClosePool()
+{
+#ifndef _WIN32
+    for(const auto& e : g_proc_macro_pool)
+    {
+        DEBUG("Closing child " << e.second.pid << " of " << e.first);
+        close_pooled_child(e.second);
+    }
+    g_proc_macro_pool.clear();
+#endif
+}
