+#ifndef _WIN32
+namespace {
+    /// Set to `1` for the children (see below); `0` in the compiler's own environment keeps every child one-shot
+    const char PROC_MACRO_SERVER_VAR[] = "MRUSTC_PROC_MACRO_SERVER";
+    /// What a server-mode child writes after its output (lib/libproc_macro/src/lib.rs `MORE_MARKER`)
+    const uint8_t PROC_MACRO_MORE_MARKER = 1;
