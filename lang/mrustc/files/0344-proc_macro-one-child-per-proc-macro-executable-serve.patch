+/// The next request in server mode: a macro name as a v128 length and its bytes. `None` at EOF: the compiler has
+/// closed the pipe, there is nothing more to do
+fn read_request(stdin: &mut /*dyn */::std::io::Read) -> Option<String>
+{
+    use std::io::Read;
+    let mut len = 0usize;
+    let mut ofs = 0;
+    loop
+    {
+        let mut b = [0u8];
+        match stdin.read(&mut b)
+        {
+        Ok(1) => {},
+        Ok(0) if ofs == 0 => return None,
+        Ok(_) => panic!("Unexpected EOF in a proc macro request"),
+        Err(e) => panic!("Error reading from stdin - {}", e),
+        }
+        len |= ((b[0] & 0x7F) as usize) << ofs;
+        if b[0] < 128 {
+            break;
+        }
+        ofs += 7;
+    }
+    let mut buf = vec![0u8; len];
+    stdin.read_exact(&mut buf).expect("Error reading a proc macro request");
+    Some(String::from_utf8(buf).expect("Invalid UTF-8 macro name from compiler"))
+}
+
 pub fn is_available() -> bool {
