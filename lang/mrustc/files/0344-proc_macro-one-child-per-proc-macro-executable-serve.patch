+/// Called once the output's end marker has been read. A server-mode child (lib/libproc_macro/src/lib.rs `main`) then
+/// writes `PROC_MACRO_MORE_MARKER` and waits for its next request on stdin, so it goes to the pool for the next
+/// invocation of its executable; a one-shot child (an older libproc_macro, `MRUSTC_PROC_MACRO_SERVER=0`, every
+/// Windows child) closes its stdout instead and the destructor reaps it.
+void ProcMacroInv::release_child()
+{
+#ifndef _WIN32
+    if( this->handles.child_pid == 0 )
+        return ;
+    uint8_t v = 0;
+    ssize_t n;
+    do {
+        n = read(this->handles.child_stdout, &v, 1);
+    } while( n < 0 && errno == EINTR );
+    if( n == 0 ) {
+        DEBUG("Child " << this->handles.child_pid << " is one-shot");
+        return ;
+    }
+    if( n < 0 ) {
+        BUG(this->m_parent_span, "Error while reading from child process, " << strerror(errno));
+    }
+    if( v != PROC_MACRO_MORE_MARKER ) {
+        BUG(this->m_this_span, "Unexpected byte " << static_cast<int>(v) << " from the child process after its output");
+    }
+    PooledChild c = { this->handles.child_pid, this->handles.child_stdin, this->handles.child_stdout };
+    this->handles.child_pid = 0;
+    this->handles.child_stdin = -1;
+    this->handles.child_stdout = -1;
+    if( g_proc_macro_pool.count(m_executable) ) {
+        // A second child of the executable (an invocation nested in the reading of another's output): keep one, so
+        // state stays in a single process
+        DEBUG("Closing the extra child " << c.pid << " of " << m_executable);
+        close_pooled_child(c);
     }
+    else {
+        DEBUG("Child " << c.pid << " of " << m_executable << " waits for the next invocation");
+        g_proc_macro_pool.insert(::std::make_pair(m_executable, c));
+    }
+#endif
+}
+void ProcMacroInv::send_request_name(const char* name)
+{
+#ifdef _WIN32
+    BUG(m_parent_span, "Proc macro children aren't pooled on Windows");
+#else
+    // Straight to the pipe: the `MRUSTC_DUMP_PROCMACRO` dump holds one invocation's input, which a child replays
+    // from a file (one-shot), not the pool's requests
+    ::std::vector<uint8_t>  buf;
+    size_t len = ::std::strlen(name);
+    uint64_t v = len;
+    while( v >= 128 ) {
+        buf.push_back( static_cast<uint8_t>(v & 0x7F) | 0x80 );
+        v >>= 7;
+    }
+    buf.push_back( static_cast<uint8_t>(v) );
+    buf.insert(buf.end(), name, name + len);
+    if( write(this->handles.child_stdin, buf.data(), buf.size()) != static_cast<ssize_t>(buf.size()) )
+        BUG(m_parent_span, "Error writing to child, " << strerror(errno));
 #endif
 }
