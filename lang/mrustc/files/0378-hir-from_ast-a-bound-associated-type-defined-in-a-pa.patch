@@ -753,17 +759,57 @@ namespace {
     }
 
     struct H {
+        // The trait's parameters as the path writes them, the omitted ones taken from the trait's defaults: a parent
+        // trait's path is spelled in terms of all of them (`RelativeEq<Rhs = Self>: AbsDiffEq<Rhs>`, approx 0.5.1).
+        // A default names the bound's own type as `Self` (simba 0.8.1 `trait RealField: RelativeEq<Epsilon = Self>`,
+        // `fn f<T: RelativeEq<Epsilon = T>>`); `Resolve Bind` fills the bound's own path the same way, later.
+        static ::HIR::PathParams fill_defaults(
+            const Span& sp, const ::HIR::TypeRef& self_ty, const ::HIR::PathParams& params,
+            const ::std::function<::HIR::TypeRef(size_t)>& get_default, size_t n_params
+            )
+        {
+            auto rv = params.clone();
+            while( rv.m_types.size() < n_params )
+            {
+                auto def = get_default(rv.m_types.size());
+                if( def.data().is_Infer() ) {
+                    // No default: a rustc error, and the monomorphiser's "out of range" below if the parent uses it
+                    break;
+                }
+                auto ms = MonomorphStatePtr(&self_ty, &rv, nullptr);
+                auto ty = ms.monomorph_type(sp, def, /*allow_infer=*/false);
+                rv.m_types.push_back( mv$(ty) );
+            }
+            return rv;
+        }
+        static ::HIR::PathParams fill_defaults_hir(const Span& sp, const ::HIR::TypeRef& self_ty, const ::HIR::PathParams& params, const ::HIR::GenericParams& defs)
+        {
+            return fill_defaults(sp, self_ty, params, [&](size_t i){ return defs.m_types[i].m_default.clone(); }, defs.m_types.size());
+        }
+        static ::HIR::PathParams fill_defaults_ast(const Span& sp, const ::HIR::TypeRef& self_ty, const ::HIR::PathParams& params, const ::AST::GenericParams& defs)
+        {
+            ::std::vector<const ::AST::TypeParam*>  tps;
+            for(const auto& p : defs.m_params) {
+                if( const auto* tp = p.opt_Type() ) {
+                    tps.push_back(tp);
+                }
+            }
+            return fill_defaults(sp, self_ty, params, [&](size_t i){ return LowerHIR_Type(tps[i]->get_default()); }, tps.size());
+        }
+        // `path` names a trait in the terms of some scope; `self_ty` is the type the path bounds in that scope; `ms`
+        // maps that scope to the caller's. Returns the (monomorphised) path of the trait defining `name`, or empty.
         static ::HIR::GenericPath find_source_trait_hir(
             const Span& sp,
             const ::HIR::GenericPath& path, const HIR::Trait& trait, const RcString& name,
-            const Monomorphiser& ms
+            const ::HIR::TypeRef& self_ty, const Monomorphiser& ms
             )
         {
             auto it = trait.m_types.find(name);
             if(it != trait.m_types.end()) {
                 return ms.monomorph_genericpath(sp, path, /*allow_infer=*/false);
             }
-            auto cb = MonomorphStatePtr(&ty_Self, &path.m_params, nullptr);
+            auto params = fill_defaults_hir(sp, self_ty, path.m_params, trait.m_params);
+            auto cb = MonomorphStatePtr(&self_ty, &params, nullptr);
             for(const auto& st : trait.m_all_parent_traits)
             {
                 // NOTE: st.m_trait_ptr isn't populated yet
@@ -781,7 +827,7 @@ namespace {
         static ::HIR::GenericPath find_source_trait_ast(
             const Span& sp,
             const ::HIR::GenericPath& path, const AST::Trait& trait, const RcString& name,
-            const Monomorphiser& ms
