From 7c6631fbaa832fbb6364328e04bc2d37045c11cb Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 14:45:25 +0000
Subject: [PATCH] mir: a `let` of type `!` that gets a value ends its path as
 unreachable

tree-sitter-cli 0.27.1 (its own CLI crate) main.rs:2192 `parse_range`:

    let err_msg = format!("Invalid range '{range}', expected 'start:end'");
    let mut parts = range.split(':');
    let Some(part) = parts.next() else {
        Err(anyhow!(err_msg))?
    };
    let Ok(start) = part.parse::<usize>() else {
        Err(anyhow!(err_msg))?
    };

    MIR ERROR: ::"bin#"::parse_range BB88/0: ensure_valid: Use of non-valid
      lvalue - _4

The `?`'s Ok type is `!`, so its `Continue(v) => v` arm completes the else
block with a `!` value. let-else is lowered to
`_ => loop { let _: ! = $else; }`, and in MIR that completed path took the
loop's back-edge into the else block again, which moved `err_msg` (_4)
a second time. rustc treats any `!`-typed value as unreachable.

MIR lowering of `let` now ends the current block with `Diverge` when the
let's type is `!` and the value expression completed (as it already does
after a call returning `!`), so neither the loop nor the code after it
sees that path.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/mir/from_hir.cpp b/src/mir/from_hir.cpp
index b79b1b0d..f44d9e00 100644
--- a/src/mir/from_hir.cpp
+++ b/src/mir/from_hir.cpp
@@ -1007,6 +1007,15 @@ namespace {
                 }
                 auto res = m_builder.get_result(node.span());
 
+                // A `!` value can't exist, so the path that yielded one is unreachable (as after a call returning `!`).
+                // - tree-sitter-cli 0.27.1 main.rs:2201 `let Some(part) = parts.next() else { Err(anyhow!(err_msg))? };`:
+                //   the `?`'s `Continue(v) => v` arm completes the let-else's `loop { let _: ! = $else; }`, and the loop
+                //   back-edge ran the else block again, moving `err_msg` twice.
+                if( node.m_type.data().is_Diverge() ) {
+                    m_builder.end_block( ::MIR::Terminator::make_Diverge({}) );
+                    return ;
+                }
+
                 // Shortcut for `let foo = bar;` (avoids the extra temporary that would need to be optimised out)
                 if( node.m_pattern.m_data.is_Any() && std::all_of(node.m_pattern.m_bindings.begin(), node.m_pattern.m_bindings.end(), [](const HIR::PatternBinding& pb){ return pb.m_type == ::HIR::PatternBinding::Type::Move;}) )
                 {
