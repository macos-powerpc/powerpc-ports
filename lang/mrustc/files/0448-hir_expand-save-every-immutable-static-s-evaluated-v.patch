From fd679ad1f5fe815795b6135c654b8bbd7bbd1ab6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 6 Nov 2026 08:46:13 +0000
Subject: [PATCH] hir_expand: save every immutable static's evaluated value in
 the rlib, not only Copy ones

utf8_iter 1.1.0 (termscp 1.2.2) handler.rs:34 `const
SEQUENCE_FOR_REPLACEMENT_CHARACTER: ThreeByteSequence = const { ..
ThreeByteSequence::try_new(0xEF, 0xBF, 0xBD) .. }`: `MIR ERROR:
<utf_types::utf8::ThreeByteSequence>::try_new BB0/3:
src/hir_conv/constant_evaluation.cpp:1270 ASSERT tmp_ty != HIR::TypeRef()
failed - Type not set?`.

utf_types' `pub const fn`s read its private `static UTF8_DATA: Utf8Data`
(a `#[repr(align(64))]` struct holding a table; a const fn may read an
immutable static since Rust 1.83). An rlib stored a static's evaluated
literal only when static_borrow_constants marked it (c7c8376f: immutable,
Copy, no interior mutability), and Utf8Data is not Copy, so the consumer's
constant evaluation found "No value and no mir" and the indexed static had
no type.

Drop the Copy requirement: every immutable static without interior
mutability saves its literal (the loader marks it `m_no_emit_value`,
so a dependent still references the defining crate's symbol). The
interior-mutability check now runs for non-Copy statics too, so a missing
`unsafe_cell` lang item (a no_core crate) means "nothing is interior
mutable" instead of an error.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/hir_expand/static_borrow_constants.cpp b/src/hir_expand/static_borrow_constants.cpp
index b862aed9..fa7cd7f6 100644
--- a/src/hir_expand/static_borrow_constants.cpp
+++ b/src/hir_expand/static_borrow_constants.cpp
@@ -1293,8 +1293,13 @@ namespace static_borrow_constants {
                 ev.visit_node_ptr(item.m_value);
 
 
+                // The evaluated value goes into the rlib for every immutable static whose bytes cannot change:
+                // a dependent crate's constant evaluation may read it through a `const fn` (allowed since Rust 1.83),
+                // whatever its type. Copy was required before, so utf_types 1.0.0 `static UTF8_DATA: Utf8Data`
+                // (a non-Copy struct holding a table) had no value for utf8_iter 1.1.0 handler.rs:34
+                // `const { .. ThreeByteSequence::try_new(0xEF, 0xBF, 0xBD) .. }`: "No value and no mir", then
+                // "constant_evaluation.cpp:1270 ASSERT tmp_ty != HIR::TypeRef() failed - Type not set?"
                 if( !item.m_is_mut
-                    && m_resolve.type_is_copy(item.m_value->span(), item.m_type)
                     && m_resolve.type_is_interior_mutable(item.m_value->span(), item.m_type) == HIR::Compare::Unequal
                     ) {
                     item.m_save_literal = true;
diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index c816d0e8..8bdab0e5 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -3147,7 +3147,8 @@ HIR::Compare StaticTraitResolve::type_is_interior_mutable(const Span& sp, const
 
         TU_ARMA(Struct, pbe) {
             const HIR::GenericPath& p = e.path.m_data.as_Generic();
-            if( p.m_path == m_crate.get_lang_item_path(sp, "unsafe_cell") ) {
+            // No `unsafe_cell` lang item (a no_core crate): nothing can be interior mutable
+            if( p.m_path == m_crate.get_lang_item_path_opt("unsafe_cell") ) {
                 return HIR::Compare::Equal;
             }
             // TODO: Cache this result?
