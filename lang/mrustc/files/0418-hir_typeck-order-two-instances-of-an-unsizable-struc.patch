From 34d5428be9f1f660e5e7231766e9c540d7cccfc9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 31 Oct 2026 00:34:14 +0000
Subject: [PATCH 418/418] hir_typeck: order two instances of an unsizable
 struct by their ?Sized parameter

jaq-all 0.4.0 (jaq 3.1.2) src/data.rs:111
`(if runner.null_input { null } else { data.inputs }).try_for_each(..)`
with `null: &RcIter<Box<Once<Result<Val, _>>>>` and
`data.inputs: &RcIter<dyn Iterator<Item = Result<Val, String>>>`
(jaq-std 3.0.4 `RcIter<I: ?Sized>(RefCell<I>)`):
    BUG: src/hir_typeck/expr_cs.cpp:6923: TODO: get_ordering_ty - RcIter<dyn
    Iterator<..>> with RcIter<_> - LHS is Path, RHS is unsize-capable struct

The two arms are the coercion sources of the `if` result ivar, which
the method call needs resolved. check_ivar_poss orders the sources by
restrictiveness, and get_ordering_ty had a TODO for two instances of one
unsizable struct. rustc's LUB coercion unsizes the first arm to the second.

For two instances of the same `can_unsize` struct the ordering now follows
the struct's ?Sized parameter: the instance whose parameter is unsized
(a slice, a trait object, or recursively such a struct instance) is the less
specific one, OrdGreater like `[T]` against `[T; N]`; both unsized and
different is unordered; both sized is equal, as for plain structs.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 1a04c371..bb67cd6e 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -6865,6 +6865,23 @@ namespace
             }
             throw "";
         }
+        /// Is this type an unsized instance: a slice, a trait object, or an unsizable struct whose ?Sized parameter is one
+        static bool is_unsized_instance(const Context& context, const ::HIR::TypeRef& ty)
+        {
+            if( ty.data().is_Slice() || ty.data().is_TraitObject() )
+                return true;
+            if( const auto* te = ty.data().opt_Path() )
+            {
+                if( TU_TEST1(te->binding, Struct, ->m_struct_markings.can_unsize) && te->path.m_data.is_Generic() )
+                {
+                    const auto& params = te->path.m_data.as_Generic().m_params.m_types;
+                    unsigned idx = te->binding.as_Struct()->m_struct_markings.unsized_param;
+                    if( idx < params.size() )
+                        return is_unsized_instance(context, context.m_ivars.get_type(params[idx]));
+                }
+            }
+            return false;
+        }
         /// Ordering of `l` relative to `r` for ?unsizing
         /// - OrdLess means that the LHS is less restrictive
         static Ordering get_ordering_ty(const Span& sp, const Context& context, const ::HIR::TypeRef& l, const ::HIR::TypeRef& r, bool& out_unordered)
@@ -6918,9 +6935,30 @@ namespace
                     {
                         TODO(sp, l << " with " << r << " - LHS is Path, RHS is opaque type");
                     }
-                    else if( TU_TEST1(te_r.binding, Struct, ->m_struct_markings.can_unsize) )
+                    else if( TU_TEST1(te_r.binding, Struct, ->m_struct_markings.can_unsize) && te_l.binding == te_r.binding
+                        && te_l.path.m_data.is_Generic() && te_r.path.m_data.is_Generic() )
                     {
-                        TODO(sp, l << " with " << r << " - LHS is Path, RHS is unsize-capable struct");
+                        // Two instances of one unsizable struct (`RcIter<I: ?Sized>`): the one whose ?Sized parameter
+                        // is unsized is the less specific, the other unsizes to it (as `[T]` against `[T; N]`)
+                        // - jaq-all 0.4.0 `if .. { &RcIter<Box<..>> } else { &RcIter<dyn Iterator<..>> }` as a receiver
+                        const auto& str = *te_r.binding.as_Struct();
+                        const auto& pl = te_l.path.m_data.as_Generic().m_params.m_types;
+                        const auto& pr = te_r.path.m_data.as_Generic().m_params.m_types;
+                        unsigned idx = str.m_struct_markings.unsized_param;
+                        if( idx < pl.size() && idx < pr.size() )
+                        {
+                            const auto& tl = context.m_ivars.get_type(pl[idx]);
+                            const auto& tr = context.m_ivars.get_type(pr[idx]);
+                            bool ul = is_unsized_instance(context, tl);
+                            bool ur = is_unsized_instance(context, tr);
+                            if( ul != ur ) {
+                                return ul ? OrdGreater : OrdLess;
+                            }
+                            if( ul && tl != tr ) {
+                                out_unordered = true;
+                            }
+                        }
+                        return OrdEqual;
                     }
                     else
                     {
