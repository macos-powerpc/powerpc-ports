From b94f19fdad4d2bde3496ccf349f4697406ce1821 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 14 Oct 2026 19:59:19 +0000
Subject: [PATCH 238/241] libproc_macro: Span::start, end, line, column and
 file (stable 1.88)

time-macros 0.2.32 (ani-cli-rs 0.11.0) keeps error positions with
`span.start()`/`span.end()`:

    helpers/mod.rs:65:51 error:0: No applicable methods for {::"proc_macro-0_0_0_H1"::span::Span}.start

Rust 1.88 stabilised the position API. Spans here are indices into the
table the compiler sent and nothing new can be defined after it is
frozen, so `start()` and `end()` return the span itself (a diagnostic
then points at the whole token rather than its edge); `line()` and
`column()` read the recorded start position, `file()` the recorded path
for display (`local_file()` already existed).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 lib/libproc_macro/src/span.rs | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/lib/libproc_macro/src/span.rs b/lib/libproc_macro/src/span.rs
index 3257b861..7f55c573 100644
--- a/lib/libproc_macro/src/span.rs
+++ b/lib/libproc_macro/src/span.rs
@@ -73,6 +73,39 @@ impl Span
         _ => panic!("Undefined span #{}", self.0),
         }
     }
+
+    // 1.88: the stable position API (time-macros 0.2.32 helpers/mod.rs:65 `span.start()`/`span.end()`)
+    // - Spans are indices into the table the compiler sent, and nothing new can be defined, so `start`/`end`
+    //   are the span itself (diagnostics then point at the whole token rather than its edge)
+    /// An empty span pointing to directly before this span
+    pub fn start(&self) -> Span {
+        *self
+    }
+    /// An empty span pointing to directly after this span
+    pub fn end(&self) -> Span {
+        *self
+    }
+    /// The one-indexed line of the source file where the span starts
+    pub fn line(&self) -> usize {
+        match unsafe { assert!(SPANS_COMPLETE); SPANS.get(self.0) } {
+        Some(&Some(ref v)) => v.lines.start,
+        _ => 0,
+        }
+    }
+    /// The one-indexed column of the source file where the span starts
+    pub fn column(&self) -> usize {
+        match unsafe { assert!(SPANS_COMPLETE); SPANS.get(self.0) } {
+        Some(&Some(ref v)) => v.bytes.start,
+        _ => 0,
+        }
+    }
+    /// The path to the source file in which this span occurs, for display purposes
+    pub fn file(&self) -> String {
+        match unsafe { assert!(SPANS_COMPLETE); SPANS.get(self.0) } {
+        Some(&Some(ref v)) => v.file.path().display().to_string(),
+        _ => String::new(),
+        }
+    }
 }
 
 /// The inner definition of a span
