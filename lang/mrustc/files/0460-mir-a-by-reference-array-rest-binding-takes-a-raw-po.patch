From 62f5095148fd206967ae4ae79f5c2bf39bdb7e6a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 10 Nov 2026 12:48:16 +0000
Subject: [PATCH 460/461] mir: a by-reference array rest binding takes a raw
 pointer to its first element

sha3 0.12.0 (arti 2.8.0) utils::deserialize
`let [state_src @ .., cursor_src] = ser_state;` with `ser_state: &[u8; 201]`:
`MIR ERROR: src/mir/check.cpp:1060 ASSERT dst_ty.data().as_Pointer().inner
== s_e.inner failed - Casting borrow to invalid type: *const [u8; 200] from
&'#omitted u8`.

get_value_for_binding_path's array branch, by-reference binding, borrowed
the first element as `&T` and cast that borrow straight to `*const [T; N-k]`.
A borrow only casts to a pointer of the same pointee (rustc rejects
`&u32 as *const u8` with E0606 too, so the MIR check is right); the slice
branch next to it already takes a raw borrow first. Now: raw borrow of the
first element (`*const T` / `*mut T`), pointer-to-pointer cast to the
sub-array pointer, dereference.

The same statement also cloned the pointer type in one argument and moved
it in another (`lvalue_or_temp(sp, ptr_ty.clone(), make_Cast({..,
mv$(ptr_ty)}))`). GCC evaluates the move first, so with GCC every
by-reference array rest binding segfaulted in Lower MIR (hir/type.hpp:316,
null m_ptr) before the MIR check could run; the cast RValue is now built
before the call. By-value rest bindings (an array literal from the fields)
were unaffected.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/mir/from_hir.cpp b/src/mir/from_hir.cpp
index 1a83d5c6..48f6078b 100644
--- a/src/mir/from_hir.cpp
+++ b/src/mir/from_hir.cpp
@@ -467,16 +467,18 @@ namespace {
                         lval = m_builder.lvalue_or_temp(sp, mv$(ret_ty), ::MIR::RValue::make_Array({ std::move(array_vals) }));
                     }
                     else {
-                        // Create a pointer to this array, by casting the source
+                        // Raw pointer to the first element (a borrow only casts to a pointer of the same pointee)
                         ::HIR::BorrowType   bt = H::get_borrow_type(sp, *b.binding);
                         ::MIR::LValue ptr_val = m_builder.lvalue_or_temp(sp,
-                            ::HIR::TypeRef::new_borrow( bt, std::move(inner_type) ),
-                            ::MIR::RValue::make_Borrow({ bt, false, ::MIR::LValue::new_Field( lval.clone(), static_cast<unsigned int>(b.split_slice.first) ) })
+                            ::HIR::TypeRef::new_pointer( bt, std::move(inner_type) ),
+                            ::MIR::RValue::make_Borrow({ bt, true, ::MIR::LValue::new_Field( lval.clone(), static_cast<unsigned int>(b.split_slice.first) ) })
                         );
 
-                        // 3. Create a slice pointer
+                        // 3. Cast it to a pointer to the sub-array
+                        // (the cast is built first: argument evaluation order would otherwise clone a moved-from type)
                         auto ptr_ty = ::HIR::TypeRef::new_pointer(bt, std::move(ret_ty));
-                        lval = m_builder.lvalue_or_temp(sp, ptr_ty.clone(), ::MIR::RValue::make_Cast({ mv$(ptr_val), mv$(ptr_ty) }) );
+                        auto cast_val = ::MIR::RValue::make_Cast({ mv$(ptr_val), ptr_ty.clone() });
+                        lval = m_builder.lvalue_or_temp(sp, mv$(ptr_ty), mv$(cast_val));
                         // 4. And dereference it
                         lval = ::MIR::LValue::new_Deref(std::move(lval));
                     }
