From 6a822cbfdb3cffe2a62f86bc2d028e0715346f84 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 17:57:13 +0000
Subject: [PATCH] hir_conv: a pattern constant from a generic trait takes the
 trait params of its impl

read-fonts 0.37.0 generated/generated_aat.rs:49 (agg 1.9.0):
`match format { Lookup0Marker::FORMAT => Ok(Self::Format0(..)), .. }` with
`trait Format<T> { const FORMAT: T; }` and `impl Format<u16> for Lookup0Marker` =
"<null> BUG: ASSERT FAIL: src/hir_typeck/helpers.cpp:799:e->index != ~0u: Encountered
non-populated IVar" (Typecheck Expressions).

Resolve UFCS turns the pattern into `<Lookup0Marker as Format<_>>::FORMAT`, leaving the
trait's omitted type param blank as it does for a value path in an expression (typeck infers
those). A constant in a pattern gets no inference: typeck takes its type from the bound
constant, so the blank survived to the final pass, which asserted on it. The resolver already
matches the impl to bind the constant; it now takes the trait params from that impl.

Assisted-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_conv/resolve_ufcs.cpp b/src/hir_conv/resolve_ufcs.cpp
index 0afa1afe..66940728 100644
--- a/src/hir_conv/resolve_ufcs.cpp
+++ b/src/hir_conv/resolve_ufcs.cpp
@@ -1072,16 +1072,30 @@ namespace resolve_ufcs {
                     }
                     }
                 TU_ARMA(UfcsKnown, pe) {
+                    // A value path in an expression leaves the trait's omitted type params blank (`_`, see
+                    // set_from_trait_impl) for typeck to infer, but typeck infers nothing for a constant in a PATTERN
+                    // (its type comes from `binding`), and the final typeck pass then asserts on the blank ("Encountered
+                    // non-populated IVar"): read-fonts 0.37.0 generated_aat.rs:49 `match format { Lookup0Marker::FORMAT
+                    // => .. }` with `trait Format<T> { const FORMAT: T; }`. The matched impl names them.
+                    ::HIR::PathParams   impl_trait_params;
                     bool rv = this->m_resolve.find_impl(sp,  pe.trait.m_path, &pe.trait.m_params, pe.type, [&](const auto& impl, bool) {
                         if( !impl.m_data.is_TraitImpl() ) {
                             return true;
                         }
                         ve.binding = &impl.m_data.as_TraitImpl().impl->m_constants.at( pe.item ).data;
+                        impl_trait_params = impl.get_trait_params();
                         return true;
                         });
                     if( !rv ) {
                         ERROR(sp, E0000, "Constant " << ve.path << " couldn't be found");
                     }
+                    for(size_t i = 0; i < pe.trait.m_params.m_types.size() && i < impl_trait_params.m_types.size(); i ++)
+                    {
+                        if( pe.trait.m_params.m_types[i] == ::HIR::TypeRef() && impl_trait_params.m_types[i] != ::HIR::TypeRef() ) {
+                            DEBUG("Trait param " << i << " of " << ve.path << " = " << impl_trait_params.m_types[i] << " (from the impl)");
+                            pe.trait.m_params.m_types[i] = std::move(impl_trait_params.m_types[i]);
+                        }
+                    }
                     }
                 }
             }
