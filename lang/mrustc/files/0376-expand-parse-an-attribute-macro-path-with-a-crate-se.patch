From bc47c896fe1010846600f88e79d213d3ab61151f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 24 Oct 2026 02:26:39 +0000
Subject: [PATCH 376/377] expand/parse: an attribute macro path with a `crate::`,
 `self::`, `super::` or leading `::` head

gix-protocol 0.68.0 (gitoxide 0.61.0, blocking-client), src/fetch/arguments/io.rs:2-3
`#[crate::bisync::only_async] use futures_lite::io::AsyncWriteExt;` with lib.rs
`pub mod bisync { pub use gix_macros::{discard as only_async, keep as only_sync, sync as bisync}; }`:

    error:0: Cannot find component 3 of crate::fetch::arguments::io::futures_lite::io::AsyncWriteExt/*?*/ (_)

Parse_MetaItem reads an attribute's name with get_tok_ident_rword, so a leading keyword is kept as a plain
element (`crate`, `bisync`, `only_async`), and Expand_LookupMacro turned every attribute name into a path
relative to the current module. `crate::bisync::only_async` therefore looked for an item named `crate` in
`fetch::arguments::io`, found nothing, and the attribute was silently left unexpanded (unknown attributes
are ignored); the `use` of a crate this build has no dependency on then failed in Resolve Use. gix_macros'
`discard` returns an empty token stream: the item was meant to disappear.

Expand_LookupMacro now builds the path the way Parse_Path reads the written form: `crate::x` (and
`::crate::x`) is this crate's root, `self::x` and `super::x` (counted) the module tree, a leading `::`
the crate root in 2015 or an extern crate in 2018+ (the parser's `=name` spelling). Parse_MetaItem's
interpolated-path branch (`#[$p]` with `$p:path`/`:ty`) records the same heads instead of dropping
an absolute path's crate: `crate::x` keeps `crate`, `::name::x` its leading `::` and name, `self::`/`super::`
their keywords. Impl items go through the same lookup.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/expand/mod.cpp b/src/expand/mod.cpp
index 93b60ec7..4368ae83 100644
--- a/src/expand/mod.cpp
+++ b/src/expand/mod.cpp
@@ -368,11 +368,60 @@ bool Expand_Attrs_CfgOnly(const ExpandState& es, AST::AttributeList& attrs)
     return !remove;
 }
 
+/// An attribute's name is read with any leading keyword kept as a plain element (`Parse_MetaItem`), so build the path
+/// the way `Parse_Path` reads the written form: `crate::x` is this crate's root, `self::x`/`super::x` the module tree,
+/// a leading `::` the crate root (2015) or an extern crate (2018+, the parser's `=name` spelling). Before, every name
+/// became a path relative to the current module and `#[crate::bisync::only_async]` (gix-protocol 0.68.0
+/// fetch/arguments/io.rs; `mod bisync` re-exports gix_macros' `discard` under that name) looked for an item named
+/// `crate` there: the attribute was silently left unexpanded and the `use futures_lite::io::AsyncWriteExt` it should
+/// have removed failed in Resolve Use ("Cannot find component 3 of crate::fetch::arguments::io::futures_lite::..").
 MacroRef Expand_LookupMacro(const Span& mi_span, const ::AST::Crate& crate, LList<const AST::Module*> modstack, const AST::AttributeName& path)
 {
-    AST::Path   p = AST::Path::new_relative({}, {});
-    for(const auto& ent : path.elems) {
-        p += AST::PathNode(ent);
+    const auto& elems = path.elems;
+    size_t  ofs = 0;
+    auto count_supers = [&]() {
+        unsigned int count = 0;
+        while( ofs < elems.size() && elems[ofs] == "super" ) {
+            count ++;
+            ofs ++;
+        }
+        return count;
+    };
+    auto crate_root = [](RcString crate_name) {
+        return AST::Path(::std::move(crate_name), ::std::vector<AST::PathNode>());
+    };
+    AST::Path   p;
+    if( path.has_leading ) {
+        if( elems.size() > 1 && elems[0] == "crate" ) {
+            // `::crate::x`
+            ofs = 1;
+            p = crate_root("");
+        }
+        else if( elems.size() > 1 && crate.m_edition >= AST::Edition::Rust2018 ) {
+            p = crate_root(RcString::new_interned(::std::string("=") + elems[0].c_str()));
+            ofs = 1;
+        }
+        else {
+            p = crate_root("");
+        }
+    }
+    else if( elems.size() > 1 && elems[0] == "crate" ) {
+        ofs = 1;
+        p = crate_root("");
+    }
+    else if( elems.size() > 1 && elems[0] == "self" ) {
+        ofs = 1;
+        auto n = count_supers();
+        p = (n > 0 ? AST::Path::new_super(n, {}) : AST::Path::new_self({}));
+    }
+    else if( elems.size() > 1 && elems[0] == "super" ) {
+        p = AST::Path::new_super(count_supers(), {});
+    }
+    else {
+        p = AST::Path::new_relative({}, {});
+    }
+    for(; ofs < elems.size(); ofs ++) {
+        p += AST::PathNode(elems[ofs]);
     }
     return Expand_LookupMacro(mi_span, crate, modstack, p);
 }
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 69720dfa..e3d27f7d 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1242,10 +1242,39 @@ AST::Attribute Parse_MetaItem(TokenStream& lex)
         else if( tok.frag_type().is_path() ) {
             path = &tok.frag_type().path();
         }
-        if( !path || !(path->m_class.is_Relative() || path->m_class.is_Absolute()) ) {
+        if( !path ) {
             throw ParseError::Unexpected(lex, tok);
         }
-        name.has_leading = path->m_class.is_Absolute();
+        // Record the path's head the way the written form below does (`Expand_LookupMacro` reads both back as
+        // a path): `crate::x` keeps `crate`, 2018's `::name::x` (the parser's `=name`) a leading `::` and `name`,
+        // `self::`/`super::` their keywords
+        TU_MATCH_HDRA( (path->m_class), {)
+        default: {
+            throw ParseError::Unexpected(lex, tok);
+            }
+        TU_ARMA(Relative, e) {
+            }
+        TU_ARMA(Absolute, e) {
+            if( e.crate == "" ) {
+                name.elems.push_back("crate");
+            }
+            else if( e.crate.c_str()[0] == '=' ) {
+                name.has_leading = true;
+                name.elems.push_back( RcString::new_interned(e.crate.c_str() + 1) );
+            }
+            else {
+                name.has_leading = true;
+            }
+            }
+        TU_ARMA(Self, e) {
+            name.elems.push_back("self");
+            }
+        TU_ARMA(Super, e) {
+            for(unsigned int i = 0; i < e.count; i ++) {
+                name.elems.push_back("super");
+            }
+            }
+        }
         for(const auto& node : path->nodes())
         {
             if( !node.args().is_empty() ) {
