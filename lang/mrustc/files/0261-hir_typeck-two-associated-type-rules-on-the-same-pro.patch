From 2434cb37ef9dcee6687487c70dace612718cb152 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 13:05:21 +0000
Subject: [PATCH 261/261] hir_typeck: two associated-type rules on the same
 projection name the same type

ring 0.17.14 (tombi 1.8.4), arithmetic/bigint.rs:452-460 `elem_exp_vartime`:

    bigint.rs:456:33 warn:0: Spare Rule - _/*104*/ = < (_/*104*/,_/*104*/,)
      as ::"ring"::arithmetic::montgomery::ProductEncoding >::Output
    <null> warn:0: Spare Rule - ::"ring"::arithmetic::montgomery::R =
      < (_/*104*/,_/*104*/,) as ..::ProductEncoding >::Output
    <null> BUG: src/hir_typeck/expr_cs.cpp:8606: Spare rules left after
      typecheck stabilised

    let mut acc = base.clone_into(out);
    while .. {
        acc = elem_squared(acc, m);     // -> Elem<M, <(E, E) as ProductEncoding>::Output>
        if .. { acc = elem_mul(&base, acc, m); }
    }
    acc                                 // Elem<M, R>

A method call is resolved only at the revisit stage, so the first pass
had already equated acc's encoding with the projection of itself; the
call's `Elem<M, R>` then only added a second rule on the same projection,
and neither is solvable on its own (several impls produce `R`). rustc
checks in order and never sees the cycle.

A projection has one value, so the left sides of two rules on the
identical projection are equal. A last-resort stage before the ivar
fallbacks ("Associated types (shared projection)") equates them when
trait, item, self type and parameters agree (types_equal /
the pathparams_equal; operator rules excluded).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 5fe6a1f5..22aece64 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -8367,6 +8367,39 @@ void Typecheck_Code_CS(const typeck::ModuleState& ms, t_args& args, const ::HIR:
             }
         }
 
+        // Two associated-type rules on the same projection name the same type: `_34 = <(_34,_34) as ProductEncoding>::
+        // Output` and `R = <(_34,_34) as ProductEncoding>::Output` (ring 0.17.14 bigint.rs:452-460 `let mut acc =
+        // base.clone_into(out); .. acc = elem_squared(acc, m); .. acc` - the loop's assignment tied the encoding to the
+        // projection of itself before the method call, resolved only at revisit, could pin it to `R`; rustc checks in
+        // order). A projection has one value, so the left sides are equal; nothing else can break such a cycle.
+        if( !context.m_ivars.peek_changed() )
+        {
+            DEBUG("--- Associated types (shared projection)");
+            for(size_t i = 0; i < context.link_assoc.size() && !context.m_ivars.peek_changed(); i ++)
+            {
+                const auto& a = context.link_assoc[i];
+                if( a.name == "" || a.is_operator )
+                    continue;
+                for(size_t j = i+1; j < context.link_assoc.size(); j ++)
+                {
+                    const auto& b = context.link_assoc[j];
+                    if( b.name == "" || b.is_operator )
+                        continue;
+                    if( a.trait != b.trait || a.name != b.name )
+                        continue;
+                    if( !context.m_ivars.types_equal(a.impl_ty, b.impl_ty) )
+                        continue;
+                    if( !context.m_ivars.pathparams_equal(a.params, b.params) || !context.m_ivars.pathparams_equal(a.aty_pp, b.aty_pp) )
+                        continue;
+                    if( context.m_ivars.types_equal(a.left_ty, b.left_ty) )
+                        continue;
+                    DEBUG("- " << a << " and " << b << " name the same projection: equate");
+                    context.equate_types(a.span, a.left_ty, b.left_ty);
+                    break;
+                }
+            }
+        }
+
         // If nothing has changed, 
         if( !context.m_ivars.peek_changed() )
         {
