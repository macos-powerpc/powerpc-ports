@@ -391,6 +392,10 @@ struct EscapedByteString {
     case TOK_NEWLINE:    return "\n";
     case TOK_WHITESPACE: return " ";
     case TOK_COMMENT:    return "/*" + m_data.as_String() + "*/";
+    // Interpolated fragments print as Rust source (the AST dump used for proc macro input), not the debug form:
+    // `stringify!($e)` of an `$e:expr` is re-lexed at run time by quote's `parse(stringify!($other))` (the
+    // `$other:tt` arm takes every forwarded fragment), and the debug printer's `|state/*1*/?: _,|->_ (state).f(,)`
+    // doesn't lex (pest_generator 2.9.0 generate_rule! `$pattern:expr` -> handlebars 6.4.4 "invalid token stream").
     case TOK_INTERPOLATED_TYPE:
         reinterpret_cast<const ::TypeRef*>(m_data.as_Fragment())->print(ss, false);
         return ss.str();
@@ -398,15 +403,13 @@ struct EscapedByteString {
         reinterpret_cast<const ::AST::Path*>(m_data.as_Fragment())->print_pretty(ss, true);
         return ss.str();
     case TOK_INTERPOLATED_PATTERN:
-        // TODO: Use a pretty printer too?
-        return FMT( *reinterpret_cast<const ::AST::Pattern*>(m_data.as_Fragment()) );
+        DumpAST_Pattern(ss, *reinterpret_cast<const ::AST::Pattern*>(m_data.as_Fragment()));
+        return ss.str();
     case TOK_INTERPOLATED_STMT:
     case TOK_INTERPOLATED_BLOCK:
-    case TOK_INTERPOLATED_EXPR: {
-        ::std::stringstream ss;
-        reinterpret_cast<const ::AST::ExprNode*>(m_data.as_Fragment())->print(ss);
+    case TOK_INTERPOLATED_EXPR:
+        DumpAST_Node(ss, *reinterpret_cast<const ::AST::ExprNode*>(m_data.as_Fragment()));
         return ss.str();
-        }
     case TOK_INTERPOLATED_META: return "/*:meta*/";
     case TOK_INTERPOLATED_ITEM: return "/*:item*/";
     case TOK_INTERPOLATED_VIS: {
@@ -481,8 +484,10 @@ struct EscapedByteString {
             return FMT(s << "_" << coretype_name(m_data.as_Float().m_datatype));
         }
         }
-    case TOK_STRING:    return FMT("\"" << EscapedString(m_data.as_String()) << "\"" << m_suffix << m_hygiene);
-    case TOK_CSTRING:   return FMT("c\"" << EscapedString(m_data.as_String()) << "\"" << m_suffix << m_hygiene);
+    // No hygiene marker (`"x"/*1*/`, and `/**/` for none): this is the `stringify!` text, re-lexed at run time by proc
+    // macros and shown in panic messages (the debug form is `operator<<`)
+    case TOK_STRING:    return FMT("\"" << EscapedString(m_data.as_String()) << "\"" << m_suffix);
+    case TOK_CSTRING:   return FMT("c\"" << EscapedString(m_data.as_String()) << "\"" << m_suffix);
     case TOK_BYTESTRING:return FMT("b\"" << EscapedByteString(m_data.as_String()) << "\"" << m_suffix);
     case TOK_HASH:  return "#";
     case TOK_UNDERSCORE:return "_";
