+/// With emulated TLS, the runtime frees the TLS of an exiting thread from the
+/// destructor of a key it creates at the first TLS access, and macOS runs key
+/// destructors in creation order. Create `DTORS` when the image is loaded,
+/// before that access, so that `run` finds the TLS variables still alive.
+#[cfg(all(target_thread_local, target_enforce_emulated_tls))]
+#[used]
+#[unsafe(link_section = "__DATA,__mod_init_func")]
+static CREATE_DTORS_AT_LOAD: extern "C" fn() = {
+    extern "C" fn create_dtors() {
+        DTORS.force();
+    }
+    create_dtors
+};
+
