On macOS before 10.7 there is no _tlv_atexit, so with emulated TLS
(--cfg target_enforce_emulated_tls) use the key-based guard of the other
Unix platforms instead of the Apple one, and build the key module for it.

The emulated TLS runtime frees the TLS of an exiting thread from the
destructor of a pthread key which it creates at the first TLS access, and
macOS runs key destructors in the order of key creation. Create the guard's
key when the image is loaded (__mod_init_func), before that access, so that
its destructor runs first and the destructor list and the TLS variables are
still alive when the destructors run.

--- a/library/std/src/sys/thread_local/mod.rs
+++ b/library/std/src/sys/thread_local/mod.rs
@@ -80,7 +80,7 @@
 /// should ensure that these functions are called at the right times.
 pub(crate) mod guard {
     cfg_if::cfg_if! {
-        if #[cfg(all(target_thread_local, target_vendor = "apple"))] {
+        if #[cfg(all(target_thread_local, target_vendor = "apple", not(target_enforce_emulated_tls)))] {
             mod apple;
             pub(crate) use apple::enable;
         } else if #[cfg(target_os = "windows")] {
@@ -139,6 +139,7 @@
                 target_family = "unix",
             ),
             all(not(target_thread_local), target_vendor = "apple"),
+            all(target_vendor = "apple", target_enforce_emulated_tls),
             target_os = "teeos",
             all(target_os = "wasi", target_env = "p1", target_feature = "atomics"),
