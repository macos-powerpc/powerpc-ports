From 0bb7d6a92353400f102c0b6666fbf5508382c053 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 5 Nov 2026 12:07:50 +0000
Subject: [PATCH 430/430] trans: tuples whose last element is unsized
 (`PhantomData<(I, O, E, str)>`)

askama_parser 0.16.0 (zoxide 0.10.0): "BUG: ASSERT FAIL:
src/trans/target.cpp:1373: Unsized item isn't the last item in
(Stateful<..>, &str, ErrMode<ErrorContext>, str, )".

winnow 1.0.2 combinator/impls.rs:300 `Verify<F, G, I, O, O2, E>` with
`O2: ?Sized` holds `marker: PhantomData<(I, O, E, O2)>`, and askama_parser
calls `.verify(|s: &str| ..)` on parsers returning `&str`, so O2 = str and
the phantom tuple ends in an unsized element. Trans enumerate visits
a struct constructor's type parameters, so such a tuple becomes an emitted
type with drop glue, and its layout sorted every element by (align, size),
which moved the unsized one off the end.

- target.cpp: a tuple whose last element is unsized is laid out like
  a struct with a DST tail (AllButFinal); sized tuples are unchanged.
- static.cpp metadata_type: a tuple takes the metadata of its last element
  (was: always None), so `&(u16, dyn Tr)` and `&move (.., str)` are fat
  pointers; the drop glue of such a tuple applied `.META` to a thin pointer
  before. Tuple unsizing (can_unsize) is still not supported.
- codegen_c.cpp: no sizeof assert for an unsized tuple (as for structs).

Assisted-by: Claude Fable 5.1
---

diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index c6aaee6c..c816d0e8 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -3433,11 +3433,10 @@ MetadataType StaticTraitResolve::metadata_type(const Span& sp, const ::HIR::Type
         return MetadataType::TraitObject;
         }
     TU_ARMA(Tuple, e) {
-        // TODO: Unsized tuples? are they a thing?
-        //for(const auto& ty : e)
-        //    if( !type_is_sized(sp, ty) )
-        //        return false;
-        return MetadataType::None;
+        // The last element may be unsized (`(I, O, E, str)` as a `PhantomData` parameter): the tuple takes its metadata
+        if( e.empty() )
+            return MetadataType::None;
+        return this->metadata_type(sp, e.back(), err_on_unknown);
         }
     }
     throw "bug";
diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index a38d5ccc..59954c6d 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -2671,7 +2671,8 @@ namespace {
 
                     emit_struct_inner(ty, repr, /*packing_max_align=*/0);
 
-                    if( repr->size > 0 )
+                    // Unsized tail (`(.., str)` as a phantom type parameter): no fixed size to check
+                    if( repr->size > 0 && repr->size != SIZE_MAX )
                     {
                         m_of << "typedef char sizeof_assert_"; emit_ctype(ty); m_of << "[ (sizeof("; emit_ctype(ty); m_of << ") == " << repr->size << ") ? 1 : -1 ];\n";
                     }
diff --git a/src/trans/target.cpp b/src/trans/target.cpp
index 0a12074e..277d7aee 100644
--- a/src/trans/target.cpp
+++ b/src/trans/target.cpp
@@ -1487,7 +1487,8 @@ namespace {
                 }
                 ents.push_back(Ent { idx++, size, align, t.clone() });
             }
-            sorting = StructSorting::All;
+            // The last element may be unsized (e.g. `PhantomData<(I, O, E, str)>`): it has to stay last
+            sorting = (!ents.empty() && ents.back().size == SIZE_MAX) ? StructSorting::AllButFinal : StructSorting::All;
         }
         else
         {
