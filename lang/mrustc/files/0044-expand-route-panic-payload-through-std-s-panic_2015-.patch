From a5753b5b3b45defa487aac7248f6589aa1fe9b65 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 05:33:40 +0000
Subject: [PATCH 44/44] expand: route `panic!(payload)` through std's `panic_2015` in
 2015/2018 crates

The built-in `panic!` expander always forwards to `core::panic::
panic_2015` on Rust >= 1.55. Its single-argument arm is
`panic_str_2015(&str)`, so `panic!(AbortNow)` (proc-macro-error 1.0.4)
or `panic!(format!(..))` in an edition 2015/2018 crate failed with
"Type mismatch between &str and AbortNow". In rustc the `panic!` of
a std crate expands to `std::panic::panic_2015`, whose single-argument arm
is `std::rt::begin_panic`, accepting any `Any + Send` payload.

The two macros are otherwise identical, and constant evaluation knows
core's entry points but not `begin_panic`, so only the differing form
is routed through std: a 2015/2018 edition invocation with a single
argument that isn't a string literal (looking through `$msg:expr`
fragments), in a crate that links std. Everything else is expanded as
before.

The `panic_2015`/`panic_2021` choice now also uses the edition of the
invocation (the defining crate when expanded from another crate's
macro), which the expander already computed but didn't use, matching
rustc's span-based dispatch.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/expand/panic.cpp | 40 ++++++++++++++++++++++++++++++++++++++--
 1 file changed, 38 insertions(+), 2 deletions(-)

diff --git a/src/expand/panic.cpp b/src/expand/panic.cpp
index 4f9eb152..faf6e986 100644
--- a/src/expand/panic.cpp
+++ b/src/expand/panic.cpp
@@ -8,6 +8,7 @@
 #include <synext_macro.hpp>
 #include <parse/interpolated_fragment.hpp>
 #include <ast/crate.hpp>
+#include <ast/expr.hpp>
 #include <hir/hir.hpp>
 #include "../parse/ttstream.hpp"
 #include "../parse/common.hpp"
@@ -16,6 +17,33 @@
 class CExpander_panic:
     public ExpandProcMacro
 {
+    /// `panic!(<payload>)`: a single argument that isn't a string literal
+    static bool is_payload_panic(const TokenTree& tt)
+    {
+        const TokenTree* first = nullptr;
+        if( tt.is_token() ) {
+            first = &tt;
+        }
+        else if( tt.size() > 0 ) {
+            first = &tt[0];
+        }
+        if( !first ) {
+            return false;
+        }
+        if( !first->is_token() ) {
+            // Parenthesised/bracketed/braced expression
+            return true;
+        }
+        const auto& t = first->tok();
+        if( t.type() == TOK_STRING ) {
+            return false;
+        }
+        if( t.type() == TOK_INTERPOLATED_EXPR ) {
+            // A `$msg:expr` fragment: look through to the literal (NOTE: `frag_node` has no const overload)
+            return dynamic_cast<const AST::ExprNode_String*>( &const_cast<Token&>(t).frag_node() ) == nullptr;
+        }
+        return true;
+    }
     ::std::unique_ptr<TokenStream> expand(const Span& sp, const ::AST::Crate& crate, const TokenTree& tt, AST::Module& mod) override
     {
         Token   tok;
@@ -24,9 +52,16 @@ class CExpander_panic:
         if( tt.hygiene().has_mod_path() && tt.hygiene().mod_path().crate != "" ) {
             edition = crate.m_extern_crates.at(tt.hygiene().mod_path().crate).m_hir->m_edition;
         }
+        bool is_edition_2015 = (edition == AST::Edition::Rust2015 || edition == AST::Edition::Rust2018);
+        // `std::panic::panic_2015` differs from `core::panic::panic_2015` in one form only: for a single non-literal
+        // argument it calls `std::rt::begin_panic`, which takes any `Any + Send` payload (`panic!(AbortNow)`,
+        // `panic!(format!(..))`), where core's `panic_str_2015` requires a `&str`. Route that form through `std` when
+        // it's loaded; everything else stays on `core`'s version, which is identical and is what constant evaluation
+        // knows how to handle.
+        bool use_std = crate.m_load_std == AST::Crate::LOAD_STD && (TARGETVER_MOST_1_54 || (is_edition_2015 && is_payload_panic(tt)));
         ::std::vector<TokenTree> toks;
         toks.push_back( Token(TOK_DOUBLE_COLON) );
-        if( crate.m_load_std == AST::Crate::LOAD_STD && TARGETVER_MOST_1_54 ) {
+        if( use_std ) {
             toks.push_back( Token(TOK_STRING, std::string(crate.m_ext_cratename_std.c_str()), {}) );
         }
         else {
@@ -35,7 +70,8 @@ class CExpander_panic:
         toks.push_back( Token(TOK_DOUBLE_COLON) );
         toks.push_back( Token(TOK_IDENT, RcString::new_interned("panic")) );
         toks.push_back( Token(TOK_DOUBLE_COLON) );
