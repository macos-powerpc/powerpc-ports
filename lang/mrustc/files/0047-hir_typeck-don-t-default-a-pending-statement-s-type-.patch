From 4be95081c3616ae63bf3a880371d82e026062737 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 07:13:01 +0000
Subject: [PATCH 47/47] hir_typeck: don't default a pending statement's type to `()`

An expression statement whose type is still an inference variable gets
a `RevisitDefaultUnit` rule, which sets it to `()` in fallback mode. It ran
in the "Node revisits (fallback)" stage, before the final ivar fallbacks,
so a method call whose receiver type was still unknown at that point was
given `()` and then failed once the receiver resolved:

    yaml_serde-0.10.4/src/value/mod.rs:635:63 error: Type mismatch
    between () and &mut Value

(`mapping.entry(k).or_insert(v);` inside `while let Some(node) =
stack.pop()`, with `stack`'s element type only fixed by the deferred
`stack.push(self)` coercion.)

A node that is itself still in the revisit queue will get its type from
its own resolution, so the default is skipped for it; statements whose
type is genuinely unconstrained still default to `()`.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs__enum.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/hir_typeck/expr_cs__enum.cpp b/src/hir_typeck/expr_cs__enum.cpp
index 2fd6f634..14499b35 100644
--- a/src/hir_typeck/expr_cs__enum.cpp
+++ b/src/hir_typeck/expr_cs__enum.cpp
@@ -648,6 +648,13 @@ namespace typecheck
                                         return true;
                                     }
                                     if( is_fallback ) {
+                                        // If the node itself is still waiting to be resolved (e.g. a method call on
+                                        // a receiver whose type is only known after the final ivar fallbacks), its type
+                                        // comes from that resolution: defaulting now would conflict with it later.
+                                        if( ::std::find(context.to_visit.begin(), context.to_visit.end(), node) != context.to_visit.end() ) {
+                                            DEBUG("Node still pending, not defaulting to ()");
+                                            return false;
+                                        }
                                         context.equate_types(node->span(), ty, HIR::TypeRef::new_unit());
                                         return true;
                                     }
