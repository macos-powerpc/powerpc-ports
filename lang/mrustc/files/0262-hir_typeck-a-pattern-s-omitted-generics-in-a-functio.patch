From 23eab415bcbd5367891a033f7c0a64a30208cfb2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 14:39:48 +0000
Subject: [PATCH] hir_typeck: a pattern's omitted generics in a function
 argument are inferred, not defaulted

ring 0.17.14 (tombi 1.8.4) bits.rs:125:

    pub struct BitLength<T = usize>(T);
    impl TryFrom<BitLength<u64>> for BitLength<core::num::NonZeroU64> {
        fn try_from(BitLength(value): BitLength<u64>) -> Result<Self, Self::Error> {
            value.try_into().map(BitLength)
        }
    }

    <null> error:0: Type mismatch between u64 and usize

Outer typeck (check_parameters) replaced every `_` generic outside a body
with the parameter's default, so the argument pattern became
`BitLength<usize>(value)` and its match-ergonomics revisit clashed with
the argument's `BitLength<u64>`. rustc infers a pattern path's omitted
arguments from the matched value, as mrustc already does inside bodies.

outer.cpp: a visit_pattern override marks pattern paths; there an omitted
type parameter stays `_` (types written inside the pattern are a type
position again). Typeck gives those `_` ivars like any body pattern;
expr_cs.cpp now also applies the final ivar values to the argument
patterns (they sit outside the expression tree, so the Apply visitor
never saw them; the 0113 alias case left raw ivars there too).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 22aece64..4588dea7 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -8655,6 +8655,9 @@ void Typecheck_Code_CS(const typeck::ModuleState& ms, t_args& args, const ::HIR:
 
         ExprVisitor_Apply   visitor { context };
         visitor.visit_node_ptr( expr );
+        // Argument patterns sit outside the tree, but their paths get ivars for omitted generics too
+        for(auto& arg : args)
+            visitor.visit_pattern(expr->span(), arg.first);
     }
 
     // - De-duplicate types
diff --git a/src/hir_typeck/outer.cpp b/src/hir_typeck/outer.cpp
index 92e3b367..f330bd94 100644
--- a/src/hir_typeck/outer.cpp
+++ b/src/hir_typeck/outer.cpp
@@ -105,6 +105,7 @@ namespace {
         ::HIR::ItemPath* m_fcn_path = nullptr;
         ::HIR::Function* m_fcn_ptr = nullptr;
         unsigned int m_fcn_erased_count = 0;
+        bool m_in_pattern = false;
 
         ::std::vector< ::HIR::TypeRef* >    m_self_types;
         ::std::vector< ::HIR::LifetimeRef* >    m_current_lifetime;
@@ -251,7 +252,10 @@ namespace {
 
             for(unsigned int i = 0; i < param_vals.m_types.size(); i ++)
             {
-                if( param_vals.m_types[i] == ::HIR::TypeRef() ) {
+                // A pattern's path is inferred from the value it matches, so an omitted parameter stays `_` for typeck
+                // (as it does in a body), it doesn't take the default.
+                // - ring 0.17.14 bits.rs:125: `fn try_from(BitLength(value): BitLength<u64>)`, `struct BitLength<T = usize>(T)`
+                if( param_vals.m_types[i] == ::HIR::TypeRef() && !m_in_pattern ) {
                     // TODO: Why is this pulling in the default? Why not just leave it as-is
 
                     //if( param_def.m_types[i].m_default == ::HIR::TypeRef() )
@@ -350,7 +354,11 @@ namespace {
                 m_cur_params_level = 3;
             }
 
+            // A type written inside a pattern (`BitLength::<Wrap>(v)`) is a type position again
+            auto saved_in_pattern = m_in_pattern;
+            m_in_pattern = false;
             ::HIR::Visitor::visit_type(ty);
+            m_in_pattern = saved_in_pattern;
 
             m_cur_params       = saved_params.first ;
             m_cur_params_level = saved_params.second;
@@ -408,6 +416,14 @@ namespace {
             }
         }
 
+        void visit_pattern(::HIR::Pattern& pat) override
+        {
+            auto saved = m_in_pattern;
+            m_in_pattern = true;
+            ::HIR::Visitor::visit_pattern(pat);
+            m_in_pattern = saved;
+        }
+
         void visit_generic_path(::HIR::GenericPath& p, PathContext pc) override
         {
             static Span sp;
