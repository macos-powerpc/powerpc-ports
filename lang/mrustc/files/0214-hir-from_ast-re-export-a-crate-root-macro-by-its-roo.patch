From 27f6c0c1369b1c8da7a769f21c206b495b2fd413 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 02:18:48 +0000
Subject: [PATCH] hir/from_ast: re-export a crate-root macro by its root path,
 not where `use` first found it

icu_locid_transform_data 1.5.0 (gitui 0.28.1, and every icu4x `*_data` crate)
has `include!("../data/macros.rs")` as its whole lib.rs; that file declares
`#[macro_use] #[path = "macros/x.rs.data"] mod x;` modules holding
`#[macro_export] macro_rules! __impl_x` and re-exports each one as
`pub use __impl_x as impl_x;`. It died in HIR lowering with
"BUG: src/hir/hir.cpp:361: Could not find macro name in
::"icu_locid_transform_data-1_5_0"::locid_transform_likelysubtags_sr_v1::__impliterable_locid_transform_likelysubtags_sr_v1".

A `#[macro_export]` macro_rules written in a module file is moved to the crate
root before expansion (`Expand_Mod_Early`). One that a macro expansion produced
(here `include!`) is moved by the post-stage `macro_export` decorator, which
only runs in the final expansion pass. By then the first pass had run
`#[macro_use]` on the module (importing the macro into the root as
`crate::x::__impl_x`) and the `use`, which recorded that path for `impl_x`. The
crate's macro re-export list is built from those expand-time imports and
replaces the root's (correct) import from name resolution, so `impl_x` pointed
at a module that no longer has the macro.

Building the re-export list now looks the referenced macro up among the macros
the crate root defines (by identity) and uses its root path when it is there.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir/from_ast.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/hir/from_ast.cpp b/src/hir/from_ast.cpp
index c8118423..877703ff 100644
--- a/src/hir/from_ast.cpp
+++ b/src/hir/from_ast.cpp
@@ -2550,6 +2550,8 @@ public:
     // - Extract exported macros
     {
         TRACE_FUNCTION_FR("macros", "macros");
+        /// Macros defined in the crate root (`#[macro_export]` moves them there), by their definition
+        ::std::map<const MacroRules*, RcString> root_macro_names;
         ::std::vector< ::AST::Module*>    mods;
         mods.push_back( &crate.m_root_module );
         do
@@ -2561,6 +2563,7 @@ public:
                 if( mac.data->m_exported ) {
                     HIR::MacroItem  mi;
                     if( &mod == &crate.m_root_module ) {
+                        root_macro_names[&*mac.data] = mac.name;
                         mi = mv$(mac.data);
                     }
                     else {
@@ -2608,6 +2611,17 @@ public:
             if( mac.is_pub || (mac.ref.is_MacroRules() && mac.ref.as_MacroRules()->m_exported) ) {
                 // Add to the re-export list
                 auto path = ::HIR::SimplePath(mac.path.crate == "" ? g_crate_name : mac.path.crate, mac.path.nodes);
+                // A `#[macro_export]` macro is moved to the crate root, but one that a macro expansion defined (a module
+                // from `include!`) only in the final expansion pass: `#[macro_use]` and a `use` naming it had already
+                // recorded the module it was defined in, where HIR has no such macro.
+                // - icu_locid_transform_data 1.5.0: `include!("../data/macros.rs")` = `#[macro_use] mod x;` (holding
+                //   `#[macro_export] macro_rules! __impl_x`) + `pub use __impl_x as impl_x;`
+                if( mac.path.crate == "" && mac.ref.is_MacroRules() ) {
+                    auto it = root_macro_names.find(mac.ref.as_MacroRules());
+                    if( it != root_macro_names.end() ) {
+                        path = ::HIR::SimplePath(g_crate_name, { it->second });
+                    }
+                }
                 auto res = macros.insert( std::make_pair(mac.name, HIR::MacroItem::make_Import({path})) );
                 if( !res.second ) {
                     DEBUG("Conflict in imported vs local macros: " << mac.name);
