-        void visit_tuple_pattern(const AST::Pattern::TuplePat& v)
+        // The comma between two list entries: rustc hands a proc macro the tokens as written, and a trailing comma is
+        // only there when the source wrote one. derive-deftly re-emits a field's type (`$ftype`) into tor-config's
+        // `strip_option!{..}`, whose `Option < $t:ty >` arm can't take `Option<CfgPath,>` (tor-ptmgr 0.47.0 config.rs:23)
