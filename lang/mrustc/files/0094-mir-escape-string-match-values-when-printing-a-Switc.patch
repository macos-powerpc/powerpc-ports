From 5eaa46066369dd2426122cc49eb56bf09dd2d82f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 6 Oct 2026 23:48:56 +0000
Subject: [PATCH] mir: escape string match values when printing a SwitchValue

codegen_c writes every terminator into the C output as a `// ^ ...`
comment. The SwitchValue printer wrote string and byte-string match
values raw, so a `"\n"` arm put a newline into the comment and the rest
of it became C code. syntect 5.3.0 util::as_latex_escaped
(`match text { " " => .., "\n" => continue, _ => () }`):

    error: missing terminating " character
      " => bb2, " " => bb16, else bb14)
    error: label 'bb14' used but not defined

Print strings with FmtEscaped (as StaticString constants already are)
and byte strings with the escaping used for Bytes constants.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/mir/mir.cpp | 45 +++++++++++++++++++++++++++------------------
 1 file changed, 27 insertions(+), 18 deletions(-)

diff --git a/src/mir/mir.cpp b/src/mir/mir.cpp
index 322cb35b..94a2b767 100644
--- a/src/mir/mir.cpp
+++ b/src/mir/mir.cpp
@@ -12,6 +12,27 @@
 #include <trans/target.hpp> // Target_GetPointerBits
 
 namespace MIR {
+    namespace {
+        // Escaped like a byte string literal: these end up in `//` comments in the C output, where a raw newline would
+        // end the comment early.
+        void fmt_bytes(::std::ostream& os, const ::std::vector<uint8_t>& e) {
+            os << "b\"";
+            os << ::std::hex;
+            for(auto v : e)
+            {
+                if( v == '\\' || v == '"' )
+                    os << "\\" << v;
+                else if( ' ' <= v && v < 0x7F )
+                    os << v;
+                else if( v < 16 )
+                    os << "\\x0" << (unsigned int)v;
+                else
+                    os << "\\x" << ((unsigned int)v & 0xFF);
+            }
+            os << "\"";
+            os << ::std::dec;
+        }
+    }
     ::std::ostream& operator<<(::std::ostream& os, const Constant& v) {
         TU_MATCHA( (v), (e),
         (Int,
@@ -31,21 +52,7 @@ namespace MIR {
             os << (e.v ? "true" : "false");
             ),
         (Bytes,
-            os << "b\"";
-            os << ::std::hex;
-            for(auto v : e)
-            {
-                if( v == '\\' || v == '"' )
-                    os << "\\" << v;
-                else if( ' ' <= v && v < 0x7F )
-                    os << v;
-                else if( v < 16 )
-                    os << "\\x0" << (unsigned int)v;
-                else
-                    os << "\\x" << ((unsigned int)v & 0xFF);
-            }
-            os << "\"";
-            os << ::std::dec;
+            fmt_bytes(os, e);
             ),
         (StaticString,
             os << "\"" << FmtEscaped(e) << "\"";
@@ -456,11 +463,13 @@ namespace MIR {
                 ),
             (String,
                 for(unsigned int j = 0; j < e.targets.size(); j ++)
-                    os << "\"" << ve[j] << "\" => bb" << e.targets[j] << ", ";
+                    os << "\"" << FmtEscaped(ve[j]) << "\" => bb" << e.targets[j] << ", ";
                 ),
             (ByteString,
-                for(unsigned int j = 0; j < e.targets.size(); j ++)
-                    os << "b\"" << ve[j] << "\" => bb" << e.targets[j] << ", ";
+                for(unsigned int j = 0; j < e.targets.size(); j ++) {
+                    fmt_bytes(os, ve[j]);
+                    os << " => bb" << e.targets[j] << ", ";
+                }
                 )
             )
             os << "else bb" << e.def_target << ")";
