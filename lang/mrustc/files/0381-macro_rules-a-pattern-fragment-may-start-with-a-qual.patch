From 41c659fe4532b78e2d29a53ac02cdd251e1d8d56 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 24 Oct 2026 08:40:46 +0000
Subject: [PATCH] macro_rules: a pattern fragment may start with a qualified path

x509-cert 0.2.5 (py314-qh3 2.0.4) src/anchor.rs:124

    #[derive(Clone, Debug, PartialEq, Eq, Choice)]
    pub enum TrustAnchorChoice {
        Certificate(Certificate),
        #[asn1(context_specific = "1", tag_mode = "EXPLICIT", constructed = "true")]
        TbsCertificate(TbsCertificate),
        ..
    }

failed with `BUG: src/macro_rules/eval.cpp:2409: TODO:
Macro_InvokeRules_MatchPattern - No arm matched - (2, 28)`.

der_derive's `Choice` derive emits

    matches!(tag, <Certificate as ::der::FixedTag>::TAG
                | ::der::Tag::ContextSpecific { constructed: true, number: ::der::TagNumber::N1 } | ..)

(an untagged variant's tag is the qualified-path constant, a context-specific
one a struct pattern) and core's one-arm `matches!` takes the pattern as
`$pattern:pat`.  The macro matcher's lookahead for a pattern fragment
(consume_pat) knew every pattern head except a qualified path
`<T as Trait>::CONST` / `<T>::CONST`, so the arm failed at position 2, the
`<`.  The real pattern parser accepted those patterns all along; only macro
fragments were affected.

consume_pat, the range-bound lookahead (`<T as Lim>::MIN..=<T as Lim>::MAX`,
`..=<T as Tr>::MAX`) and the `a .. b` end now take `<`/`<<` through
consume_path, which already walked `<..>::`.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 74c584a0..4d56cf35 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -1230,6 +1230,8 @@ namespace
         case TOK_RWORD_CRATE:
         case TOK_DOUBLE_COLON:
         case TOK_INTERPOLATED_PATH:
+        case TOK_LT:
+        case TOK_DOUBLE_LT:
             return consume_path(lex);
         case TOK_DASH:
             lex.consume();
@@ -1287,7 +1289,12 @@ namespace
             case TOK_RWORD_CRATE:
             case TOK_DOUBLE_COLON:
             case TOK_INTERPOLATED_PATH:
-                consume_path(lex);
+            // A qualified path constant `<T as Trait>::CONST` / `<T>::CONST` (der_derive's `Choice` derive emits
+            // `matches!(tag, <Certificate as ::der::FixedTag>::TAG | ::der::Tag::ContextSpecific { .. })`, x509-cert 0.2.5)
+            case TOK_LT:
+            case TOK_DOUBLE_LT:
+                if( !consume_path(lex) )
+                    return false;
                 if( lex.next() == TOK_BRACE_OPEN ) {
                     if( !consume_tt(lex) )
                         return false;
@@ -1372,6 +1379,8 @@ namespace
                 case TOK_RWORD_CRATE:
                 case TOK_DOUBLE_COLON:
                 case TOK_INTERPOLATED_PATH:
+                case TOK_LT:
+                case TOK_DOUBLE_LT:
                 case TOK_DASH:
                 case TOK_STRING:
                 case TOK_BYTESTRING:
