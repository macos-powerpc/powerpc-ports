From e16570bfaaca6e6ba98cfe1150cae7f683ddb802 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 24 Oct 2026 05:47:12 +0000
Subject: [PATCH] hir_expand/closures: register the generics named by a nested
 closure's path before the parameter list is frozen

gifski 1.34.0 src/minipool.rs new_scope:
  let thread = move || { catch_unwind(move || consumer(failed)) .. };
  std::iter::repeat(thread).enumerate().take(..).map(move |(n, thread)| { .. spawn_scoped(scope, thread) })
"<null> BUG: ASSERT FAIL: src/hir_expand/closures.cpp:795: !m_frozen: get_type would add a new param after
freeze - C/*M:1*/".

Closure extraction collects the generics a closure needs while it monomorphises the closure's argument,
return, local and capture types, then freezes the list. A closure TYPE inside those is passed through
unchanged (the monomorphiser's NodeType arm) and only rewritten to its struct path by ExprVisitor_Fixup
afterwards, through the same monomorphiser, when the generics that path names can no longer be added:
the `thread` closure captured `consumer: C`, the `.map` closure takes it as an argument and captures only
`scope` and `name`. The closure monomorphiser now registers the parameters (lifetimes, types, values) named
by a nested closure/generator/async path when it meets the closure type; local lifetimes stay with
the fixup's mode handling. (A commented-out attempt at this sat in Monomorph::monomorph_type.)

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_expand/closures.cpp b/src/hir_expand/closures.cpp
index 05d275c1..6263a459 100644
--- a/src/hir_expand/closures.cpp
+++ b/src/hir_expand/closures.cpp
@@ -850,9 +850,34 @@ namespace {
             }
 
             ::HIR::TypeRef monomorph_type(const Span& sp, const ::HIR::TypeRef& tpl, bool allow_infer=true) const override {
-                //if( const auto* te = tpl.data().opt_Closure() ) {
-                //    this->monomorph_genericpath(sp, te->node->m_obj_path, allow_infer);
-                //}
+                // A closure type is passed through here and only rewritten to its struct path (`closure#N<C, ..>`) by
+                // ExprVisitor_Fixup, after this list is frozen. Register the generics that path names now: gifski
+                // 1.34.0 minipool.rs `repeat(thread).map(move |(n, thread)| spawn_scoped(scope, thread))` takes the
+                // `thread` closure (which captured `consumer: C`) as an argument while capturing nothing of type `C`
+                // ("get_type would add a new param after freeze - C/*M:1*/"). Local lifetimes are left to the fixup's
+                // own mode handling, only parameters are registered.
+                if( const auto* nt = tpl.data().opt_NodeType() ) {
+                    const ::HIR::GenericPath* p = nullptr;
+                    TU_MATCH_HDRA((*nt), {)
+                    TU_ARMA(Closure, node_p) { p = &node_p->m_obj_path_base; }
+                    TU_ARMA(Generator, node_p) { p = &node_p->m_obj_path_base; }
+                    TU_ARMA(Async, node_p) { p = &node_p->m_obj_path_base; }
+                    }
+                    if( p && *p != ::HIR::GenericPath() ) {
+                        DEBUG("Register generics of nested closure " << *p);
+                        for(const auto& l : p->m_params.m_lifetimes) {
+                            if( l.is_param() ) {
+                                this->monomorph_lifetime(sp, l);
+                            }
+                        }
+                        for(const auto& t : p->m_params.m_types) {
+                            this->monomorph_type(sp, t, allow_infer);
+                        }
+                        for(const auto& v : p->m_params.m_values) {
+                            this->monomorph_constgeneric(sp, v, allow_infer);
+                        }
+                    }
+                }
                 return Monomorphiser::monomorph_type(sp, tpl, allow_infer);
             }
 
