From 3da592a0b37b4d80a6e1f0ab10d2bd121fe5a2ed Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 11:04:37 +0000
Subject: [PATCH] hir_expand: a coroutine's capture borrows get the closure
 lowering's sentinel lifetime

The coroutine lowering builds the borrow nodes for an async block's or
generator's by-reference captures after the lifetime pass, with the
lifetime left unset. The closure lowering gives its own capture borrows
the `MAX_LOCAL + 1` sentinel for that reason: when the coroutine sits in
a closure body or in another coroutine, that enclosing lowering
monomorphises the capture nodes again (through its body-rewrite visitor,
which passes no span) and rejects an unset lifetime.

tower-lsp-server 0.23.0 (ast-grep 0.45.3) transport.rs:129, the
non-`move` `async { .. framed_stdin.next().await .. }` block of the async
fn `serve`: "<null> BUG: src/hir_expand/closures.cpp:866: Found unbound
lifetime when monomorphising closure? '#omitted".

Coroutine capture borrows now use the same sentinel.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_expand/closures.cpp b/src/hir_expand/closures.cpp
index e8452b5e..05d275c1 100644
--- a/src/hir_expand/closures.cpp
+++ b/src/hir_expand/closures.cpp
@@ -1730,15 +1730,20 @@ namespace {
                 case ::HIR::ValueUsage::Move: {
                     // No wrapping needed (drop handled by custom drop glue)
                     } break;
+                // The borrow node's lifetime is the same sentinel the closure lowering uses (above): these nodes are
+                // made after the lifetime pass, and when the coroutine sits in a closure body, that closure's own
+                // lowering monomorphises them again and rejects an unset lifetime.
+                // - tower-lsp-server 0.23.0 (ast-grep): a non-`move` `async { .. }` in a closure, borrowing one of
+                //   the closure's variables -> "closures.cpp:866: Found unbound lifetime when monomorphising closure? '#omitted"
                 case ::HIR::ValueUsage::Borrow:
                     rv.capture_nodes.back()->m_res_type = cap_ty.clone();
-                    cap_ty = ::HIR::TypeRef::new_borrow(::HIR::BorrowType::Shared, std::move(cap_ty));
+                    cap_ty = ::HIR::TypeRef::new_borrow(::HIR::BorrowType::Shared, std::move(cap_ty), HIR::LifetimeRef(HIR::LifetimeRef::MAX_LOCAL + 1));
                     rv.struct_ents.back().ent = ::HIR::TypeRef::new_borrow(::HIR::BorrowType::Shared, std::move(rv.struct_ents.back().ent));
                     rv.capture_nodes.back() = HIR::ExprNodeP(new ::HIR::ExprNode_Borrow(sp, ::HIR::BorrowType::Shared, std::move(rv.capture_nodes.back())));
                     break;
                 case ::HIR::ValueUsage::Mutate:
                     rv.capture_nodes.back()->m_res_type = cap_ty.clone();
-                    cap_ty = ::HIR::TypeRef::new_borrow(::HIR::BorrowType::Unique, std::move(cap_ty));
+                    cap_ty = ::HIR::TypeRef::new_borrow(::HIR::BorrowType::Unique, std::move(cap_ty), HIR::LifetimeRef(HIR::LifetimeRef::MAX_LOCAL + 1));
                     rv.struct_ents.back().ent = ::HIR::TypeRef::new_borrow(::HIR::BorrowType::Unique, std::move(rv.struct_ents.back().ent));
                     rv.capture_nodes.back() = HIR::ExprNodeP(new ::HIR::ExprNode_Borrow(sp, ::HIR::BorrowType::Unique, std::move(rv.capture_nodes.back())));
                     break;
