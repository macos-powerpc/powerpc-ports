diff --git a/src/macro_rules/def_site.hpp b/src/macro_rules/def_site.hpp
new file mode 100644
index 00000000..a7734bb4
--- /dev/null
+++ b/src/macro_rules/def_site.hpp
@@ -0,0 +1,27 @@
+/*
+ * MRustC - Rust Compiler
+ * - By John Hodge (Mutabah/thePowersGang)
+ *
+ * macro_rules/def_site.hpp
+ * - Definition-site scoping of the locals a `macro_rules!` body can see
+ *
+ * A macro body's identifiers are resolved in the scope of the macro's *definition*: a local that is in scope at the
+ * invocation but was declared after the `macro_rules!` item (e.g. a pattern binding in the arm that invokes the macro)
+ * must not be found. Hygiene contexts alone can't tell the two apart (both locals carry the enclosing function's
+ * context), so the definition position is recorded per expansion and compared with each local's declaration position.
+ */
+#pragma once
+#include <ident.hpp>
+#include <span.hpp>
+
+class MacroRules;
+
+/// Record where `rules` was defined (called when the `macro_rules!` item is parsed)
+extern void Macro_SetDefinitionSpan(const MacroRules& rules, const Span& sp);
+/// Drop the record for a destroyed `MacroRules`
+extern void Macro_ForgetDefinitionSpan(const MacroRules& rules);
+/// Record that tokens with hygiene `body_hygiene` come from the body of a macro defined at `def_sp` (no-op if unknown)
+extern void Macro_SetBodyDefinitionSite(const Ident::Hygiene& body_hygiene, const MacroRules& rules);
+/// Can an identifier with hygiene `use_ctx` see a local declared at `local_sp`?
+/// - True unless `use_ctx` is a known macro body and the local was declared at or after the macro's definition
+extern bool Macro_BodyCanSeeLocal(const Ident::Hygiene& use_ctx, const Span& local_sp);
diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 469dbd12..96307bd8 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -11,11 +11,77 @@
 #include <parse/ttstream.hpp>
 #include <parse/common.hpp>
 #include <limits.h>
+#include <map>
 #include "pattern_checks.hpp"
 #include <parse/interpolated_fragment.hpp>
 #include <ast/expr.hpp>
 #include <ast/crate.hpp>
 #include <hir/hir.hpp>  // HIR::Crate
+#include "def_site.hpp"
+
+// --- Definition-site scoping of macro bodies (see def_site.hpp)
+namespace {
+    struct DefPos {
+        RcString    file;
+        unsigned int    line;
+        unsigned int    ofs;
+    };
+    ::std::map<const MacroRules*, Span>   g_macro_def_spans;
+    ::std::map<Ident::Hygiene, DefPos>   g_body_def_pos;
+    /// Source position of the outermost file span behind `sp`, if there is one
+    bool get_file_pos(const Span& sp, DefPos& out)
+    {
+        const Span* top = &sp;
+        while( top->get() && (*top)->parent_span != Span() ) {
+            top = &(*top)->parent_span;
+        }
+        if( const auto* ts = dynamic_cast<const SpanInner_Source*>(top->get()) ) {
+            if( ts->filename == "" )
+                return false;
+            out.file = ts->filename;
+            out.line = ts->start_line;
+            out.ofs = ts->start_ofs;
+            return true;
+        }
+        return false;
+    }
+}
+void Macro_SetDefinitionSpan(const MacroRules& rules, const Span& sp)
+{
+    g_macro_def_spans[&rules] = sp;
+}
+void Macro_ForgetDefinitionSpan(const MacroRules& rules)
+{
+    g_macro_def_spans.erase(&rules);
+}
+void Macro_SetBodyDefinitionSite(const Ident::Hygiene& body_hygiene, const MacroRules& rules)
+{
+    auto it = g_macro_def_spans.find(&rules);
+    if( it == g_macro_def_spans.end() )
+        return ;
+    DefPos  dp;
+    if( get_file_pos(it->second, dp) ) {
+        g_body_def_pos[body_hygiene] = dp;
+    }
+}
+bool Macro_BodyCanSeeLocal(const Ident::Hygiene& use_ctx, const Span& local_sp)
+{
+    auto it = g_body_def_pos.find(use_ctx);
+    if( it == g_body_def_pos.end() )
+        return true;
+    DefPos  lp;
+    if( !get_file_pos(local_sp, lp) )
+        return true;
+    // Positions are those of the outermost file span, so everything parsed from one macro expansion shares its
+    // invocation's position. Only a local that is definitely later (same file, later position) is hidden; an
+    // equal position or another file can't be ordered and keeps the previous behaviour.
+    const auto& dp = it->second;
+    if( lp.file != dp.file )
+        return true;
+    if( lp.line == dp.line && lp.ofs == dp.ofs )
+        return true;
+    return lp.line < dp.line || (lp.line == dp.line && lp.ofs < dp.ofs);
+}
 
  // Map of: LoopIndex=>(Path=>Count)
 typedef std::map<unsigned, std::map< std::vector<unsigned>, unsigned > >    loop_counts_t;
@@ -513,6 +579,8 @@ public:
 
     Position getPosition() const override;
     Span outerSpan() const override { return m_invocation_span; }
+    /// Hygiene given to the tokens of the macro body
+    const Ident::Hygiene& body_hygiene() const { return m_hygiene; }
     Ident::Hygiene realGetHygiene() const override;
     AST::Edition realGetEdition() const override;
     Token realGetToken() override;
@@ -633,10 +701,12 @@ InterpolatedFragment Macro_HandlePatternCap(TokenStream& lex, MacroPatEnt::Type
     // Run through the expansion counting the number of times each fragment is used
     Macro_InvokeRules_CountSubstUses(bound_tts, rule.m_contents);
 
-    TokenStream* ret_ptr = new MacroExpander(
+    auto* ret_ptr = new MacroExpander(
         name, sp, crate.m_edition, rules.m_is_macro_item, rules.m_hygiene, rule.m_contents, mv$(bound_tts), rules.m_source_crate == "" ? crate.m_crate_name_real : rules.m_source_crate,
         rules.m_edition
         );
+    // The body's identifiers resolve as if written at the macro's definition (see def_site.hpp)
+    Macro_SetBodyDefinitionSite(ret_ptr->body_hygiene(), rules);
 
     return ::std::unique_ptr<TokenStream>( ret_ptr );
 }
