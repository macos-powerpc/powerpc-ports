From 5ac7d756a04addbeac4e9350c7a2aa093571d000 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 24 Oct 2026 01:01:14 +0000
Subject: [PATCH] hir_typeck: expand associated types inside an erased type's
 origin path

jaq-core 3.1.2 (jaq 3.1.2) src/filter.rs:626, the `Ast::Path(f, path)` arm
of `Id::paths`:

    let path = path.map_ref(|i| {
        let cv = (cv.0.clone(), cv.1 .0.clone());
        crate::into_iter::collect_if_once(move || i.run(cv))
    });
    flat_map_then_with(f.paths(cv), path, |y, path| {
        flat_map_then_with(path.explode(), y, |path, y| { .. })
    })

    error:0: Type mismatch
     - impl Iterator<..> /*fn <Path<Either<Once<<Box<dyn Iterator<Item = R>>
           as Iterator>::Item>, Delay<closure>>>>::explode#0*/
    != impl Iterator<..> /*fn <Path<Either<Once<R>, Delay<closure>>>>::explode#0*/

`collect_if_once` returns `Either<Once<I::Item>, Delay<F>>`, so the receiver
of `explode` (an inherent `-> impl Iterator` method) is spelled with the
projection `<Box<dyn Iterator<Item = R>> as Iterator>::Item` until it is
expanded. The method's erased return type took its impl arguments from the
receiver at that point, and neither associated-type expander (typeck's
TraitResolution, nor StaticTraitResolve) looked inside an erased type
("Recurse?"): the node kept the unexpanded spelling in the erased type's
origin path while the post-typeck validator rebuilt the return type from the
(expanded) receiver, and erased types compare their origins strictly. The
minimal trigger is `mk(b).explode()` with `fn mk<I: Iterator>(i: I) ->
Path<Once<I::Item>>`; free functions, trait methods and the UFCS form get
their arguments through ivars and were not affected. Old bug (0324 fails).

Both expanders now expand an erased type's origin path arguments (Generic,
UfcsInherent incl. impl params, UfcsKnown), a Known inner type and the
bounds (`impl Tr<Assoc = ..>`), as they do for every other type;
TraitResolution::has_associated_type already reported those as needing
expansion.

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index 58e5c452..f32c4898 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -2452,7 +2452,36 @@ void TraitResolution::expand_associated_types_inplace(const Span& sp, ::HIR::Typ
             H::expand_associated_types_params(sp, *this, m.m_params, stack);
         }
     TU_ARMA(ErasedType, e) {
-        // Recurse?
+        // The origin's path arguments and the bounds are types like any other (see StaticTraitResolve's arm)
+        TU_MATCH_HDRA( (e.m_inner), {)
+        TU_ARMA(Fcn, ee) {
+            TU_MATCH_HDRA( (ee.m_origin.m_data), {)
+            TU_ARMA(Generic, pe) {
+                H::expand_associated_types_params(sp, *this, pe.m_params, stack);
+                }
+            TU_ARMA(UfcsInherent, pe) {
+                expand_associated_types_inplace(sp, pe.type, stack);
+                H::expand_associated_types_params(sp, *this, pe.params, stack);
+                H::expand_associated_types_params(sp, *this, pe.impl_params, stack);
+                }
+            TU_ARMA(UfcsKnown, pe) {
+                expand_associated_types_inplace(sp, pe.type, stack);
+                H::expand_associated_types_params(sp, *this, pe.params, stack);
+                H::expand_associated_types_params(sp, *this, pe.trait.m_params, stack);
+                }
+            TU_ARMA(UfcsUnknown, pe) {
+                BUG(sp, "Encountered UfcsUnknown");
+                }
+            }
+            }
+        TU_ARMA(Known, ee) {
+            expand_associated_types_inplace(sp, ee, stack);
+            }
+        TU_ARMA(Alias, ee) {
+            }
+        }
+        for(auto& t : e.m_traits)
+            H::expand_associated_types_tp(sp, *this, t, stack);
         }
     TU_ARMA(Array, e) {
         ConvertHIR_ConstantEvaluate_ArraySize(sp, m_crate, m_vis_path, e.size);
diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index ea31ec9c..cd5c169e 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -1859,7 +1859,21 @@ void StaticTraitResolve::expand_associated_types_inner(const Span& sp, ::HIR::Ty
             expand_associated_types_params(sp, m.m_params);
         }
     TU_ARMA(ErasedType, e) {
-        // Recurse?
+        // The origin's path arguments and the bounds are types like any other: one erased type is otherwise spelled
+        // two ways (jaq-core `path.explode()`: `<Box<dyn Iterator<Item = X>> as Iterator>::Item` vs `X` in the
+        // origin), and erased types compare their origins strictly.
+        TU_MATCH_HDRA( (e.m_inner), {)
+        TU_ARMA(Fcn, ee) {
+            expand_associated_types_path(sp, ee.m_origin);
+            }
+        TU_ARMA(Known, ee) {
+            expand_associated_types_inner(sp, ee);
+            }
+        TU_ARMA(Alias, ee) {
+            }
+        }
+        for(auto& t : e.m_traits)
+            expand_associated_types_tp(sp, t);
         }
     TU_ARMA(Array, e) {
         ConvertHIR_ConstantEvaluate_ArraySize(sp, m_crate, HIR::SimplePath(m_crate.m_crate_name, {}), e.size);
