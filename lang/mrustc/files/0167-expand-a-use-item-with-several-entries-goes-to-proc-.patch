From a7e017768f0b2ad6bc8758226b921a3e14c94791 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 06:36:07 +0000
Subject: [PATCH] expand: a `use` item with several entries goes to proc macros
 as one group

ratatui 0.30.2 src/widgets.rs:690 (skim 5.7.3):

    #[instability::unstable(feature = "widget-ref")]
    pub use {stateful_widget_ref::StatefulWidgetRef, widget_ref::WidgetRef};

    BUG: proc_macro.cpp: TODO: visit_use - Multiple items

An attribute proc macro gets its whole item, and the input serialiser
only handled a `use` with a single entry. A use tree is stored
flattened (one full path per entry), so several entries are now sent
as `use { a::A, b::B as C, d::*, };`, each entry written as before
(new visit_use_ent: glob, rename).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index a1a76f4d..824a392e 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -1690,23 +1690,34 @@ namespace {
             m_pmi.send_rword("use");
 
             if( item.entries.size() == 1 ) {
-                visit_path(item.entries[0].path);
-                if( item.entries[0].name == "" ) {
-                    m_pmi.send_symbol("::");
-                    m_pmi.send_symbol("*");
-                }
-                else if( item.entries[0].name != item.entries[0].path.nodes().back().name() ) {
-                    m_pmi.send_rword("as");
-                    m_pmi.send_ident( item.entries[0].name.c_str() );
-                }
-                else {
-                }
+                visit_use_ent(item.entries[0]);
             }
             else {
-                TODO(sp, "Multiple items");
+                // The entries are full paths (a `use a::{b, c}` tree is flattened), so send them as one group
+                // - ratatui 0.30.2 widgets.rs:690: `#[instability::unstable(..)] pub use {x::A, y::B};`
+                m_pmi.send_symbol("{");
+                for(const auto& ent : item.entries) {
+                    visit_use_ent(ent);
+                    m_pmi.send_symbol(",");
+                }
+                m_pmi.send_symbol("}");
             }
             m_pmi.send_symbol(";");
         }
+        void visit_use_ent(const ::AST::UseItem::Ent& ent)
+        {
+            visit_path(ent.path);
+            if( ent.name == "" ) {
+                m_pmi.send_symbol("::");
+                m_pmi.send_symbol("*");
+            }
+            else if( ent.name != ent.path.nodes().back().name() ) {
+                m_pmi.send_rword("as");
+                m_pmi.send_ident( ent.name.c_str() );
+            }
+            else {
+            }
+        }
 
         void visit_impl_hdr(const ::AST::ImplDef& impl)
         {
