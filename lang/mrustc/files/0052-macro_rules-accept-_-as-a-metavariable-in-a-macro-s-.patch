From 64e08214a16954d0bbfcc90006d4db1d1bcd036b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 06:38:38 +0000
Subject: [PATCH 52/59] macro_rules: accept `$_` as a metavariable in a macro's
 expansion

`_` is a valid metavariable name. The pattern parser already accepted
`$_:tt`, but the expansion parser only looked up `$` followed by
an identifier or keyword, so using the binding failed. konst_macro_rules
0.2.19 (src/iter.rs) relies on it to write repetitions in the
`macro_rules!` items one macro generates: it is invoked with a bare `$`
bound as `$_:tt`, and its expansion contains

    macro_rules! __cim_method_not_found_err {
        ($func:ident $($_($fn)?)* $($($_($st_func)?)*)*) => { ... };

which failed with

    iter.rs:60:31 error:0: Unexpected token TOK_UNDERSCORE

Look `$_` up like any other named metavariable. The pattern side now
also names the binding `_` rather than an empty string, which only
changes debug output.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/macro_rules/parse.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/macro_rules/parse.cpp b/src/macro_rules/parse.cpp
index ee2b8373..acd109bf 100644
--- a/src/macro_rules/parse.cpp
+++ b/src/macro_rules/parse.cpp
@@ -129,7 +129,7 @@ public:
                     throw ParseError::Unexpected(lex, tok);
             case TOK_UNDERSCORE:
             case TOK_IDENT: {
-                auto name = tok.type() == TOK_IDENT ? tok.ident().name : (tok.type() == TOK_UNDERSCORE ? RcString() : RcString::new_interned(tok.to_str()));
+                auto name = tok.type() == TOK_IDENT ? tok.ident().name : RcString::new_interned(tok.to_str());
                 GET_CHECK_TOK(tok, lex, TOK_COLON);
                 GET_CHECK_TOK(tok, lex, TOK_IDENT);
                 RcString type = tok.ident().name;
@@ -497,7 +497,8 @@ struct ContentLoopVariableUse
             {
                 ret.push_back( MacroExpansionEnt(NAMEDVALUE_MAGIC_CRATE) );
             }
-            else if( tok.type() == TOK_IDENT || Token::type_is_rword(tok.type()) )
+            // - `$_` is a valid name too, e.g. a `$_:tt` bound to `$` to write repetitions in a nested `macro_rules!` (konst_macro_rules 0.2.19)
+            else if( tok.type() == TOK_IDENT || tok.type() == TOK_UNDERSCORE || Token::type_is_rword(tok.type()) )
             {
                 // Look up the named parameter in the list of param names for this arm
                 auto name = tok.type() == TOK_IDENT ? tok.ident().name : RcString::new_interned(tok.to_str());
