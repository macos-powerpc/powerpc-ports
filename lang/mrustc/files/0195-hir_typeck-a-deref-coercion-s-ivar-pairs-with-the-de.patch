From b8be13efccca73ec76e4af5285f3f8bbf05986b3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 15:35:39 +0000
Subject: [PATCH] hir_typeck: a deref coercion's ivar pairs with the destination
 level that unifies

0190 changed the fallback for a coercion whose source dereferences to
an inference variable: it offered the variable the destination dereferenced
one time fewer than before. That was right for `&mut Box<_>` to `&mut
[[u32; 257]; 4]` and wrong for `&UniCase<S>` to `&UniCase<CowStr>`,
where the coercion is a unification and `S` belongs with `CowStr`, the
destination's deref: pulldown-cmark 0.13.4 (skim 5.7.3) parse.rs:1998
`self.0.contains_key(&UniCase::new(key.into()))` then wanted `From<&str>
for UniCase<CowStr>`.

rustc unifies before it deref-coerces. The variable, `count` derefs
below the source, now pairs with the destination dereferenced
`count - first_unifiable` times, where first_unifiable is the shallowest
source level that could unify with the destination (0 for the same
constructor, giving the old behavior); with no such level it pairs
with the destination itself (a full deref coercion, the Box case).
An unresolved destination level offers nothing.

Kit: box-ivar-deref-test gains pulldown.rs (fails with 0190 alone).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index e68bcfaf..5930a48d 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -4365,6 +4365,9 @@ namespace {
             const ::HIR::TypeRef*   out_ty_p = &src;
             unsigned int count = 0;
             ::std::vector< ::HIR::TypeRef>  types;
+            // The shallowest source level that could unify with the destination (rustc unifies before it
+            // deref-coerces), for pairing an ivar found below with the right destination level
+            unsigned int first_unifiable = (src.compare_with_placeholders(sp, dst, context.m_ivars.callback_resolve_infer()) != ::HIR::Compare::Unequal ? 0 : UINT_MAX);
             while( (out_ty_p = context.m_resolve.autoderef(sp, *out_ty_p, tmp_ty)) )
             {
                 const auto& out_ty = context.m_ivars.get_type(*out_ty_p);
@@ -4379,18 +4382,30 @@ namespace {
                         if( context_mut )
                         {
                             // Could also be any deref chain of the destination type
-                            // - The ivar sits `count` derefs below the source, so it matches the destination
-                            //   dereferenced `count - 1` times. The loop took one step too many: `&mut Box<_>` to
-                            //   `&mut [[u32; 257]; 4]` offered the ivar `[[u32; 257]]` (the array's unsize step) and
-                            //   never the array, so the coercion was finally equated and failed: quantette 0.6.0
-                            //   dedup.rs:189 `let mut red_prefix = bytemuck::zeroed_box(); chunked_u8_counts::<4>(.., &mut red_prefix)`
+                            // - The ivar sits `count` derefs below the source. The coercion unifies at the shallowest
+                            //   source level that can unify with the destination (`first_unifiable`), so the ivar
+                            //   pairs with the destination dereferenced `count - first_unifiable` times; with no such
+                            //   level it pairs with the destination itself (a full deref coercion).
+                            //   `&UniCase<S>` to `&UniCase<CowStr>` (same constructor) pairs `S` with `CowStr`:
+                            //   pulldown-cmark 0.13.4 parse.rs:1998 `contains_key(&UniCase::new(key.into()))` (skim)
+                            //   wanted `From<&str> for UniCase<CowStr>` when paired with the destination itself.
+                            //   `&mut Box<_>` to `&mut [[u32; 257]; 4]` pairs `_` with the array: quantette 0.6.0
+                            //   dedup.rs:189 `zeroed_box()` was offered the array's unsize step `[[u32; 257]]` by the
+                            //   old loop, which always dereferenced the destination `count` times.
                             ::HIR::TypeRef  tmp_ty2;
                             const ::HIR::TypeRef* d_ty_p = &dst;
-                            //context_mut->possible_equate_ivar(sp, sep->index, dst, Context::PossibleTypeSource::UnsizeTo);
-                            for(unsigned int i = 0; d_ty_p && i < count - 1; i ++)
+                            unsigned int dst_derefs = (first_unifiable == UINT_MAX ? 0 : count - first_unifiable);
+                            DEBUG("first_unifiable=" << first_unifiable << " count=" << count << " -> dst_derefs=" << dst_derefs);
+                            for(unsigned int i = 0; d_ty_p && i < dst_derefs; i ++)
                             {
                                 d_ty_p = context.m_resolve.autoderef(sp, *d_ty_p, tmp_ty2);
                             }
+                            // An unresolved destination says nothing about the source's deref target
+                            if( d_ty_p && context.m_ivars.get_type(*d_ty_p).data().is_Infer() )
+                            {
+                                DEBUG("Destination level is an ivar, no deref target to offer");
+                                d_ty_p = nullptr;
+                            }
                             if( d_ty_p )
                             {
                                 // TODO: This should be a `DerefTo` (can't do other unsizings?)
@@ -4412,6 +4427,10 @@ namespace {
                     DEBUG("Src derefed to a placeholder generic type (" << out_ty << "), return Unknown");
                     return CoerceResult::Unknown;
                 }
+                if( first_unifiable == UINT_MAX && out_ty.compare_with_placeholders(sp, dst, context.m_ivars.callback_resolve_infer()) != ::HIR::Compare::Unequal )
+                {
+                    first_unifiable = count;
+                }
 
                 if( TU_TEST1(out_ty.data(), Path, .binding.is_Unbound()) )
                 {
