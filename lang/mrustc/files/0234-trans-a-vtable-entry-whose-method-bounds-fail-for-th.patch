+    /// Whether the trait bounds of `params` (a trait method's where-clauses) hold once monomorphised by `ms`
+    bool Trans_Enumerate_BoundsHold(const StaticTraitResolve& resolve, const Span& sp, const ::HIR::GenericParams& params, const Monomorphiser& ms)
+    {
+        DEBUG("Bounds = " << params.fmt_bounds());
+        for(const auto& b : params.m_bounds)
+        {
+            if( !b.is_TraitBound() )    continue;
+            const auto& be = b.as_TraitBound();
+
+            auto b_ty_mono = resolve.monomorph_expand(sp, be.type, ms);
+            auto b_tp_mono = ms.monomorph_traitpath(sp, be.trait, false);
+            resolve.expand_associated_types_tp(sp, b_tp_mono);
+
+            DEBUG("Check " << b_ty_mono << ": " << b_tp_mono);
+            bool rv = resolve.find_impl(sp, b_tp_mono.m_path.m_path, b_tp_mono.m_path.m_params, b_ty_mono, [&](const ImplRef& impl, bool) {
+                for(const auto& ty_b : b_tp_mono.m_type_bounds) {
+                    const auto& ty = impl.get_type(ty_b.first.c_str(), ty_b.second.aty_params);
+                    DEBUG("ATY " << ty_b.first << " " << ty << " ?= exp " << ty_b.second.type);
+                    if( ty != ty_b.second.type ) {
+                        return false;
+                    }
+                }
+                return true;
+                });
+            if( !rv )
+                return false;
+        }
+        return true;
+    }
