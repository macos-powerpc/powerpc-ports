+bool Trans_Enumerate_VTableMethodPresent(const StaticTraitResolve& resolve, const ::HIR::TypeRef& type, const ::HIR::GenericPath& trait_path, const ::HIR::Function& fcn)
+{
+    static Span sp;
+    auto method_pp = fcn.m_params.make_empty_params(true);
+    auto ms = MonomorphStatePtr(&type, &trait_path.m_params, &method_pp);
+    return Trans_Enumerate_BoundsHold(resolve, sp, fcn.m_params, ms);
+}
