From b81766d09110c3e913211d4d2c8d9b9e322ebcaf Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 17:25:06 +0000
Subject: [PATCH] lex: a raw lifetime `'r#name` is `'name` from edition 2021

rustc 1.90 tests/ui, parse-only run:

    lifetimes/raw/simple.rs       fn foo<'r#struct>() {}
    lifetimes/raw/lifetimes-eq.rs fn test<'r#a>(x: &'a ()) {}
    lifetimes/raw/prim-lt.rs      fn foo<'r#i32>() {}
    rust-2024/raw-gen-lt.rs       fn foo<'r#gen>() {}
    error: Unexpected token TOK_HASH, expected one of TOK_GT or TOK_GTE
    lifetimes/raw/static-lt.rs    const FOO: &'r#static str = ..;
    error: Unexpected token TOK_HASH

Reference, Tokens > Lifetimes and loop labels: RAW_LIFETIME is
`'r#` IDENTIFIER_OR_KEYWORD (not followed by `'`), edition 2021 and
later; `'r#a` names the same lifetime as `'a`
(lifetimes/raw/lifetimes-eq.rs, static-lt.rs: `'r#static` is
`'static`). In 2015 and 2018 the same text is three tokens `'r` `#`
`name` (lifetimes/raw/three-tokens.rs, passing before and after).

The lexer read `'r` as a lifetime and left `#`. From 2021 it now reads
`'r#` followed by an identifier start as one lifetime token named by
the identifier; `'r#` followed by anything else stays `'r` then `#`.
A lifetime received from a proc macro as `r#name` is also `name`
(expand/proc_macro.cpp), as raw identifiers already were.

Grammar copies: macro_rules fragments (`$lt:lifetime`, `tt`) and the
parser take the lifetime token; the proc-macro visitor and ast/dump
print the plain name, which means the same.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index e8514929..61e88232 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -3071,6 +3071,10 @@ Token ProcMacroInv::realGetToken_() {
         }
     case TokenClass::Lifetime: {
         auto val = this->recv_bytes();
+        // A raw lifetime `'r#name` is `'name`
+        if( val.size() > 2 && val[0] == 'r' && val[1] == '#' ) {
+            return Token(TOK_LIFETIME, RcString::new_interned(val.c_str() + 2));
+        }
         return Token(TOK_LIFETIME, RcString::new_interned(val));
         }
     case TokenClass::String: {
diff --git a/src/parse/lex.cpp b/src/parse/lex.cpp
index 07780cb6..dffc3a7d 100644
--- a/src/parse/lex.cpp
+++ b/src/parse/lex.cpp
@@ -778,6 +778,21 @@ Token Lexer::getTokenInt()
                             str += ch;
                             ch = this->getc();
                         }
+                        // A raw lifetime `'r#name` (2021+) is `'name`; before 2021 it is `'r` `#` `name`
+                        if( str == "r" && ch == '#' && m_edition >= AST::Edition::Rust2021 ) {
+                            ch = this->getc();
+                            if( issym(ch) && !(ch.v >= '0' && ch.v <= '9') ) {
+                                str.clear();
+                                while( issym(ch) )
+                                {
+                                    str += ch;
+                                    ch = this->getc();
+                                }
+                            }
+                            else {
+                                m_next_tokens.push_back(TOK_HASH);
+                            }
+                        }
                         this->ungetc();
                         return Token(TOK_LIFETIME, Ident(this->realGetHygiene(), RcString::new_interned(str)));
                     }
diff --git a/src/version.cpp b/src/version.cpp
index 32457e58..5abbc711 100644
--- a/src/version.cpp
+++ b/src/version.cpp
@@ -13,7 +13,7 @@
 #define VERSION_PATCH   0
 
 // Number of the last patch in this fork's series: every fix commit bumps it
-#define VERSION_SERIES  474
+#define VERSION_SERIES  475
 // rlibs written by an older series are refused (0 = accept all)
 #define VERSION_SERIES_FLOOR    0
 
