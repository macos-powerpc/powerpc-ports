From 2795ce5061737875ad249ba8b3595b452ee184ac Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 2 Oct 2026 02:27:32 +0000
Subject: [PATCH] hir_conv: fix const-eval integer widths for `char` and
 SwitchValue

Two width bugs in the constant evaluator, both silent miscompiles:

- `char` had TypeInfo width 21, so casts/arithmetic read and wrote it as
  3 bytes while literal constants were written as the full 4-byte slot.
  On little-endian the low 3 bytes happen to line up; on big-endian they
  are the high bytes, so `97u8 as char` evaluated to 0x6100 and comparisons
  against char literals read the wrong bytes. Use the storage width (32).

- SwitchValue read the scrutinee with `read_uint(state, ti.bits/8)`,
  passing a byte count as a bit count, so only one byte was ever read.
  On little-endian values >= 256 were truncated (`match 257u32 { 1 => ..`
  took the `1` arm); on big-endian the MSB was read, so every match on
  a multi-byte integer or char took the wrong arm.

Hit by shlex 1.3.0 on powerpc-apple-darwin: `const fn unquoted_ok(c: u8)`
matching on `c as char`, evaluated in a const initializer, fell through to
an unreachable block ("run_terminator: Unexpected terminator - Diverge").

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_conv/constant_evaluation.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index ecf1a0d8..1d3f9ae9 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -924,7 +924,8 @@ namespace {
 
             case ::HIR::CoreType::Isize: return TypeInfo { Signed  , Target_GetPointerBits() };
             case ::HIR::CoreType::Usize: return TypeInfo { Unsigned, Target_GetPointerBits() };
-            case ::HIR::CoreType::Char: return TypeInfo { Unsigned, 21 };
+            // `char` is stored as a full u32; a 21-bit width would make reads/writes use 3 bytes (wrong offset on big-endian)
+            case ::HIR::CoreType::Char: return TypeInfo { Unsigned, 32 };
             case ::HIR::CoreType::Bool: return TypeInfo { Unsigned, 1 };
 
 
@@ -2489,7 +2490,7 @@ namespace HIR {
         TU_ARMA(SwitchValue, e) {
             HIR::TypeRef    tmp;
             const auto& ty = state.get_lvalue_type(tmp, e.val);
-                auto ti = TypeInfo::for_type(ty);
+            auto ti = TypeInfo::for_type(ty);
             auto lit = local_state.get_lval(e.val);
 
             unsigned target_idx = ~0u;
@@ -2497,7 +2498,7 @@ namespace HIR {
             default:
                 MIR_TODO(state, "SwitchValue - " << e.values.tag_str());
             TU_ARMA(Unsigned, vals) {
-                auto v = lit.read_uint(state, ti.bits/8);
+                auto v = lit.read_uint(state, ti.bits);
                 for(size_t i = 0; i < vals.size(); i ++) {
                     if(v == vals[i]) {
                         target_idx = i;
