From fbd024b8aa9ac2b3575da99942d8a215a52520ba Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 03:10:27 +0000
Subject: [PATCH] hir_typeck: a projection whose only unknown is a const
 argument waits for it

pyo3 0.28.3 (py-cryptography 48.0.0) src/pycell/impl_.rs:271:

    let tp_free = actual_type
        .get_slot(TP_FREE)
        .expect("PyBaseObject_Type should have tp_free");

    impl_.rs:271:66 error:0: No applicable methods for
      {<pyo3::internal::get_slot::Slot<Infer(0)> as GetSlotImpl>::Type}.expect

with `fn get_slot<const S: c_int>(&self, slot: Slot<S>) -> <Slot<S> as
GetSlotImpl>::Type where Slot<S>: GetSlotImpl` and `impl_slots!` writing
`const TP_FREE: Slot<{ ffi::Py_tp_free }>` and one `impl GetSlotImpl for
Slot<{ ffi::$slot }>` per slot.

The call's return type was set up while `S` was still unknown: both impls
matched fuzzily, and as the path held no type ivar
(pathparams_contain_ivars looked at type arguments only), the projection
was taken as an opaque name for good ("won't ever be able to"). And once
the value ivar was inferred from the argument (V#0 = 74),
expand_ivars_params still left `Infer(0)` in the types that held it.

- pathparams_contain_ivars counts value ivars as it counts type ivars, so
  the projection is tried again later.
- expand_ivars_params puts a known value ivar's value into the params.

With a single impl the fuzzy match already bound the value, which is why
only multi-impl cases failed (the smallest: two impls for `S2<74>` and
`S2<75>`).

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index bf4572a1..8d2ec901 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -621,6 +621,18 @@ void HMTypeInferrence::expand_ivars_params(::HIR::PathParams& params)
 {
     for(auto& arg : params.m_types)
         expand_ivars(arg);
+    // A known value ivar too: `<Slot<{Infer(0)}> as GetSlotImpl>::Type` stayed unresolvable after `S` was inferred from
+    // the argument (pyo3 0.28.3 pycell/impl_.rs:271 `type_obj.get_slot(TP_FREE).expect(..)`, one impl per slot value)
+    for(auto& v : params.m_values)
+    {
+        if( v.is_Infer() && v.as_Infer().index != ~0u )
+        {
+            const auto& known = this->get_value(v);
+            if( !known.is_Infer() ) {
+                v = known.clone();
+            }
+        }
+    }
 }
 
 void HMTypeInferrence::add_ivars(::HIR::TypeRef& type)
@@ -1041,6 +1053,12 @@ bool HMTypeInferrence::pathparams_contain_ivars(const ::HIR::PathParams& pps, bo
         if(this->type_contains_ivars(ty, only_unbound))
             return true;
     }
+    // Value ivars count as type ivars do: with only these unknown, `<Slot<{Infer(0)}> as GetSlotImpl>::Type` (an impl
+    // per value) was taken as an opaque name for good, before `S` was inferred from the argument (pyo3 0.28.3)
+    for( const auto& v : pps.m_values ) {
+        if( v.is_Infer() && (!only_unbound || v.as_Infer().index == ~0u) )
+            return true;
+    }
     return false;
 }
 bool HMTypeInferrence::type_contains_ivars(const ::HIR::TypeRef& ty, bool only_unbound) const {
