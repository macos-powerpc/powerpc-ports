From 9de50060fd992cd8ebbbe572a18479f25eedf8aa Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 05:07:40 +0000
Subject: [PATCH] hir_typeck: an unresolved projection is Sized when its
 associated type's definition is

nalgebra 0.32.3 (librsvg 2.58.5) src/geometry/point_simba.rs:21

    impl<T: Scalar + SimdValue, const D: usize> SimdValue for Point<T, D> where T::Element: Scalar {
        fn splat(val: Self::Element) -> Self { OVector::splat(val.coords).into() }
    }

died in Resolve UFCS with

    error:0: Failed to find impl with 'splat' for Matrix<_,_,Const<1>,ArrayStorage<_,{Infer},1>>

The static resolver checks the `SimdValue for OMatrix<T, R, C>` impl's bounds with `T` and `R`
unknown. `DefaultAllocator: Allocator<T::Element, R, C>` sets the Allocator impl's `T: Scalar`
parameter to `<_ as SimdValue>::Element`, a projection whose binding is still Unbound (its self type
is an inference variable, so the static expansion cannot even mark it opaque). The implicit Sized
check in find_impl__check_crate_raw asked metadata_type, whose Unbound arm answered Unknown: every
Allocator impl was rejected, so no SimdValue impl matched.

metadata_type now looks the associated type up (through supertraits) and answers None (Sized) when
its definition carries no `?Sized`, as rustc treats an associated type as Sized unless declared
`?Sized`; a `?Sized` associated type keeps returning Unknown. Typeck's own type_is_sized already
fell through for Unbound and Opaque projections, only the static resolver failed hard.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_typeck/static.cpp b/src/hir_typeck/static.cpp
index 616a9f4d..36599635 100644
--- a/src/hir_typeck/static.cpp
+++ b/src/hir_typeck/static.cpp
@@ -3252,6 +3252,25 @@ MetadataType StaticTraitResolve::metadata_type(const Span& sp, const ::HIR::Type
     TU_ARMA(Path, e) {
         TU_MATCH_HDRA( (e.binding), { )
         TU_ARMA(Unbound, pbe) {
+            // A projection that can't be resolved yet (its self type or arguments hold inference variables, as the
+            // impl-bound checks of Resolve UFCS see it): the associated type's definition still says whether it is
+            // Sized - an associated type is Sized unless declared `?Sized`.
+            // - nalgebra 0.32.3 geometry/point_simba.rs:21 `OVector::splat(val.coords)`: `impl SimdValue for
+            //   OMatrix<T, R, C>` bound `DefaultAllocator: Allocator<T::Element, R, C>` with `T` unknown set the
+            //   Allocator impl's `T: Scalar` parameter to `<_ as SimdValue>::Element`, whose implicit Sized bound
+            //   "failed" -> no Allocator impl -> no SimdValue impl -> "Failed to find impl with 'splat'"
+            if( const auto* pe = e.path.m_data.opt_UfcsKnown() )
+            {
+                ::HIR::GenericPath  trait_path;
+                if( this->trait_contains_type(sp, pe->trait, m_crate.get_trait_by_path(sp, pe->trait.m_path), pe->item.c_str(), trait_path) )
+                {
+                    const auto& trait = m_crate.get_trait_by_path(sp, trait_path.m_path);
+                    auto it = trait.m_types.find(pe->item);
+                    if( it != trait.m_types.end() && it->second.is_sized ) {
+                        return MetadataType::None;
+                    }
+                }
+            }
             // TODO: Should this return something else?
             return MetadataType::Unknown;
             }
