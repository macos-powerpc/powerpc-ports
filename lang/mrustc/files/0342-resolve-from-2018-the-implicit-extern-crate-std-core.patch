+// The implicit `extern crate std;` (`core` for `#![no_std]`) at the root: from 2018 no path can name it (def-site
+// hygiene in rustc), it only feeds `#[macro_use]` and the extern prelude (see is_hidden_std_injection in index.cpp)
+static bool Resolve_Use_IsHiddenStdInjection(const AST::Crate& crate, const AST::Named<AST::Item>& item)
+{
+    return crate.m_edition >= AST::Edition::Rust2018 && item.data.is_Crate() && item.attrs.has("#std_injection");
+}
