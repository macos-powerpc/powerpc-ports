diff --git a/src/expand/mod.cpp b/src/expand/mod.cpp
index 0b34b556..942ae5e8 100644
--- a/src/expand/mod.cpp
+++ b/src/expand/mod.cpp
@@ -2713,6 +2713,12 @@ void Expand(::AST::Crate& crate)
         AST::AttributeName  name;
         name.elems.push_back("macro_use");
         attrs.push_back( AST::Attribute(Span(), mv$(name), {}) );
+        // The injected item has def-site hygiene in rustc: from 2018 no path names it (`crate::std`, `self::std`), only
+        // its `#[macro_use]` and the extern prelude entry count (resolve skips items with this marker, which no source
+        // attribute can spell)
+        AST::AttributeName  marker;
+        marker.elems.push_back("#std_injection");
+        attrs.push_back( AST::Attribute(Span(), mv$(marker), {}) );
         // NOTE: For `macro_use` we want to import this first, but for item lookup, we want it to be last.
         // - Solution, add to the end - but pre-visit the attributes
         crate.m_root_module.m_items.push_back(
diff --git a/src/resolve/index.cpp b/src/resolve/index.cpp
index 5424f5e0..cca3713e 100644
--- a/src/resolve/index.cpp
+++ b/src/resolve/index.cpp
@@ -123,6 +123,16 @@ void _add_item_value(const Span& sp, AST::Module& mod, const RcString& name, con
     _add_item(sp, mod, IndexName::Value, name, vis, mv$(ir), error_on_collision);
 }
 
+namespace {
+    /// The implicit `extern crate std;` (`core` for `#![no_std]`) at the root: from 2018 no path can name it, as its
+    /// rustc counterpart has def-site hygiene (pyo3 0.28.3: `pub use crate::conversions::*;` brings
+    /// `conversions::std` to the root, and `use crate::std::num::nb_index` means that module)
+    bool is_hidden_std_injection(const AST::Crate& crate, const AST::Named<AST::Item>& item)
+    {
+        return crate.m_edition >= AST::Edition::Rust2018 && item.data.is_Crate() && item.attrs.has("#std_injection");
+    }
+}
+
 void Resolve_Index_Module_Base(const AST::Crate& crate, AST::Module& mod)
 {
     TRACE_FUNCTION_F("mod = " << mod.path());
@@ -162,7 +172,11 @@ void Resolve_Index_Module_Base(const AST::Crate& crate, AST::Module& mod)
             _add_item(i->span, mod, IndexName::Namespace, i->name, i->vis,  mv$(p));
