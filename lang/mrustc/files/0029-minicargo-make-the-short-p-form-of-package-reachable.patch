From 1a768509c3b034c8261a07bed0c237e8b08561e8 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 2 Oct 2026 07:58:42 +0000
Subject: [PATCH 29/31] minicargo: make the short `-p` form of `--package`
 reachable

`-p` was only checked inside the long-option chain, which is never
entered for single-dash arguments, so `minicargo . -p foo` failed with
"Unknown flag -p". Handle it in the short-option switch.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 tools/minicargo/main.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/tools/minicargo/main.cpp b/tools/minicargo/main.cpp
index c16ae11e..afafdcca 100644
--- a/tools/minicargo/main.cpp
+++ b/tools/minicargo/main.cpp
@@ -489,6 +489,13 @@ int ProgramOptions::parse(int argc, const char* argv[])
             case 'n':
                 this->dry_run = true;
                 break;
+            case 'p':
+                if(i+1 == argc) {
+                    ::std::cerr << "Flag " << arg << " takes an argument" << ::std::endl;
+                    return 1;
+                }
+                this->package_name = argv[++i];
+                break;
             case 'g':
                 this->enable_debug = true;
                 break;
@@ -569,7 +576,7 @@ int ProgramOptions::parse(int argc, const char* argv[])
                 }
                 this->panic_strategy = argv[++i];
             }
-            else if( ::std::strcmp(arg, "--package") == 0 || ::std::strcmp(arg, "-p") == 0 ) {
+            else if( ::std::strcmp(arg, "--package") == 0 ) {
                 if(i+1 == argc) {
                     ::std::cerr << "Flag " << arg << " takes an argument" << ::std::endl;
                     return 1;
