From a8816ceadda73c307f85574612e9602c5834b4b4 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 12:11:20 +0000
Subject: [PATCH] expand: pass `$crate` to proc macros as one `$crate` ident,
 and map it back

core-graphics 0.24.0 (pngquant 3.0.3) color_space.rs:14 uses foreign-types
0.5.0's

    macro_rules! foreign_type { ($($t:tt)*) => { $crate::foreign_type_impl!($crate $($t)*); } }

whose proc macro parses the leading `$crate` as a syn::Path. In another
crate's macro_rules expansion mrustc writes `$crate` as `::"<crate>"`
(a `::` and a string literal holding the crate name), and that went to the
proc macro as is: compile_error! "expected identifier".

The proc macro now gets a single Ident `$crate`, as rustc gives it, and
a `$crate` ident coming back is turned into `::"<crate>"` again for the
crate it stood for. `$crate` from two different crates in one invocation's
input can't be told apart on the way back, so that stops with a TODO.
(AST paths in interpolated fragments are sent their own way and are
unchanged.)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/expand/proc_macro.cpp | 40 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index dfb1a877..dab9af37 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -304,6 +304,17 @@ public:
     void send_ident(const Ident& val) {
         send_ident(val.name.c_str());
     }
+    /// `$crate` naming another crate (`::"<crate>"` in a macro_rules expansion), mapped back on the way out
+    void send_dollar_crate(const ::std::string& crate_name) {
+        if( m_dollar_crate == "" ) {
+            m_dollar_crate = crate_name;
+        }
+        else if( m_dollar_crate != crate_name ) {
+            m_dollar_crate_ambiguous = true;
+        }
+        this->send_u8(static_cast<uint8_t>(TokenClass::Ident));
+        this->send_bytes("$crate", 6);
+    }
     void send_lifetime(const char* val) {
         this->send_u8(static_cast<uint8_t>(TokenClass::Lifetime));
         this->send_bytes(val, ::std::strlen(val));
@@ -406,6 +417,11 @@ public:
     virtual Ident::Hygiene realGetHygiene() const override;
 private:
     Token realGetToken_();
+    /// The crate `$crate` stands for in this invocation's input (see `send_dollar_crate`)
+    ::std::string   m_dollar_crate;
+    bool    m_dollar_crate_ambiguous = false;
+    /// Crate name to return after the `::` that a `$crate` from the child process maps to
+    ::std::string   m_pending_dollar_crate;
     void send_u8(uint8_t v);
     void send_bytes(const void* val, size_t size);
     void send_bytes_raw(const void* val, size_t size);
@@ -669,6 +685,16 @@ namespace {
             {
                 for(size_t i = 0; i < tt.size(); i ++)
                 {
+                    // `$crate` from another crate's macro_rules is `::"<crate>"` here (see the macro_rules evaluator),
+                    // which isn't Rust syntax. Proc macros get it as rustc gives it to them, one `$crate` ident.
+                    // - foreign-types 0.5.0: `foreign_type!` forwards `$crate` to a proc macro that parses it as a Path
+                    if( i + 1 < tt.size() && tt[i].is_token() && tt[i].tok().type() == TOK_DOUBLE_COLON
+                        && tt[i+1].is_token() && tt[i+1].tok().type() == TOK_STRING && tt[i+1].tok().suffix() == "" )
+                    {
+                        m_pmi.send_dollar_crate(tt[i+1].tok().str());
+                        i ++;
+                        continue;
+                    }
                     visit_tokentree(tt[i]);
                 }
             }
@@ -2078,6 +2104,12 @@ Position ProcMacroInv::getPosition() const {
     return Position(m_parent_span);
 }
 Token ProcMacroInv::realGetToken() {
+    if( m_pending_dollar_crate != "" ) {
+        auto rv = Token(TOK_STRING, ::std::move(m_pending_dollar_crate), this->get_hygiene());
+        m_pending_dollar_crate.clear();
+        DEBUG("ProcMacroInv: " << rv << " ($crate)");
+        return rv;
+    }
     auto rv = this->realGetToken_();
     // A string literal may be followed by its suffix (the stream always ends with an end marker, so there is a next byte)
     if( rv == TOK_STRING || rv == TOK_BYTESTRING ) {
@@ -2130,6 +2162,14 @@ Token ProcMacroInv::realGetToken_() {
         if( val == "_" || val == "r#_" ) {
             return TOK_UNDERSCORE;
         }
+        // A `$crate` passed in (see `send_dollar_crate`) is the same `::"<crate>"` path prefix again
+        if( val == "$crate" && m_dollar_crate != "" ) {
+            if( m_dollar_crate_ambiguous ) {
+                TODO(this->m_parent_span, "`$crate` from more than one crate in the input of one proc macro invocation");
+            }
+            m_pending_dollar_crate = m_dollar_crate;
+            return Token(TOK_DOUBLE_COLON);
+        }
         auto t = Lex_FindReservedWord(val, m_edition);
         if( t != TOK_NULL )
             return t;
