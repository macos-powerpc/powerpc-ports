From f38afd137f18efbefa265348502a4c1070fe1873 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 00:15:38 +0000
Subject: [PATCH 326/327] hir_typeck: a literal's pointee through `&mut n as
 *mut _ as *mut T` is left to the defaults

sysinfo 0.33.1 src/unix/apple/cpu.rs:322 (bat 0.26.1):
    let mut num_cpu = 0;
    ..
    if !get_sys_value(mem::size_of::<u32>(), &mut num_cpu as *mut _ as *mut _, &mut mib) { num_cpu = 1; }
    .. for i in 0..num_cpu { .. format!("{}", i + 1) .. }
    <null> BUG: src/hir_typeck/helpers.cpp:932: Setting primitive to ::"core-0_0_0"::ffi::c_void/*E*/

`value: *mut c_void`, and nothing but the literal types `num_cpu`. The
pointer-to-pointer cast's fallback revisit unified the pointees (`c_void ==
{integer}`). The same rule made `&mut m as *mut _ as *mut u8` a "Type mismatch
between u8 and i32": the first cast only recorded the literal as a possibility
for its `_`, the second cast's fallback pinned that `_` to u8, the literal then
defaulted to i32.

rustc: the reference-to-pointer coercion unifies the first cast's pointee with
the literal (`*mut {integer}`), a pointer-to-pointer cast never unifies
pointees, and the literal defaults to i32/f64 at the end.

ExprNode_Cast revisit (expr_cs.cpp):
- Borrow -> Pointer with a literal pointee: equate the pointees at once
  (a literal can't unsize). A concrete non-primitive target pointee (`&mut 0.0
  as *mut c_void`, rejected by rustc as well) is an "Invalid cast [literal
  pointee]" error instead of the unification's BUG.
- Pointer -> Pointer in fallback: a literal source pointee is never unified;
  the node waits for the literal's default and completes on the next pass.

Assisted-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 7c70ab1f..e5124083 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -356,6 +356,26 @@ namespace {
 
                     // This is also a semi-coercion point, so need to run the same sort of rules
 
+                    // A literal can't unsize: `&mut n as *mut _` with `n` typed by nothing but its literal takes the
+                    // literal as the pointee, as rustc's reference-to-pointer coercion does. Left as a possibility, the
+                    // pointee ivar could take a later cast's type first (`&mut m as *mut _ as *mut u8`: "Type mismatch
+                    // between u8 and i32" once the literal defaulted).
+                    if( const auto* s_e_i = src_inner.data().opt_Infer() )
+                    {
+                        if( s_e_i->is_lit() )
+                        {
+                            // A concrete pointee that isn't a primitive can't be it (`&mut 0.0 as *mut c_void`, rustc:
+                            // "casting `&mut {float}` as `*mut c_void` is invalid"): an error, where the unification
+                            // would be the "Setting primitive to" BUG
+                            if( !ity.data().is_Infer() && !ity.data().is_Primitive() ) {
+                                bad_cast(sp, src_ty, tgt_ty, "literal pointee");
+                            }
+                            this->context.equate_types(sp, ity, src_inner);
+                            this->m_completed = true;
+                            return ;
+                        }
+                    }
+
                     // If either the source or the destination inner tyes are infer - add back rules
                     if( const auto* s_e_i = src_inner.data().opt_Infer() )
                     {
@@ -442,6 +462,16 @@ namespace {
                             this->context.possible_equate_ivar_bounds(sp, src_inner.data().as_Infer().index, std::move(tys));
                             return ;
                         }
+                        // rustc never unifies the pointees of a pointer-to-pointer cast: a literal's ivar is left to the
+                        // defaults (i32/f64) and the cast is revisited once it has its type. `let mut num_cpu = 0; ..
+                        // get_sys_value(.., &mut num_cpu as *mut _ as *mut _, ..)` (a `*mut c_void` parameter, sysinfo
+                        // 0.33.1 apple/cpu.rs:335, bat) was "BUG helpers.cpp:932 Setting primitive to c_void", and
+                        // `&mut m as *mut _ as *mut u8` "Type mismatch between u8 and i32" (the pointee took `u8` here,
+                        // the literal its default).
+                        if( src_inner.data().as_Infer().is_lit() )
+                        {
+                            return ;
+                        }
                         this->context.equate_types(sp, dst_inner, src_inner);
                     }
                     else
