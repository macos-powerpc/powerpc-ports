From e23ea9c018797bfaf04c172273129a98997bced5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 6 Nov 2026 02:12:03 +0000
Subject: [PATCH] expand: a macro-generated `#[macro_export]` macro's earlier
 imports follow it to the crate root

tor-llcrypto 0.47.0 (arti 2.7.0): "BUG: src/hir/hir.cpp:366: Could not find
macro name in ::tor_llcrypto::util::ct::
derive_deftly_template_PartialEqFromCtEq".

util/ct.rs has `define_derive_deftly! { export PartialEqFromCtEq: .. }`,
which expands to `#[macro_export] macro_rules!
derive_deftly_template_PartialEqFromCtEq`, then `pub(crate) use {..};`
of both templates in the same module, and pk.rs imports one with
`use crate::util::ct::derive_deftly_template_PartialEqFromCtEq;`.

A hand-written `#[macro_export]` macro is moved to the crate root before
the first expand pass. One that a macro expansion defines stays in its
module until the export decorator runs in the final pass, so the first
pass had already recorded the `use` as a macro import at
`crate::util::ct::<name>` (and child modules' textual-scope copies at
the same path). Resolve Use then bound the re-export to itself, HIR got
no macro in `util::ct`, and the check of pk's import found nothing.

When the export handler moves the macro, every macro import in the crate
that refers to it at its old location now points at the crate root.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/expand/macro_rules.cpp b/src/expand/macro_rules.cpp
index fd7797d3..0ac6787d 100644
--- a/src/expand/macro_rules.cpp
+++ b/src/expand/macro_rules.cpp
@@ -329,6 +329,28 @@ class CMacroExportHandler:
                 e.data->m_hygiene.set_mod_path(mv$(mp));
             }
 
+            // A macro expansion's `macro_rules!` is only moved here, in the final pass: re-point the imports the first
+            // pass recorded at its old location (`use` in the module or below, child modules' textual scope)
+            struct H {
+                static void repoint(AST::Module& m, const MacroRules* mr, const AST::AbsolutePath& from, const AST::AbsolutePath& to) {
+                    for(auto& mi : m.m_macro_imports) {
+                        if( mi.ref.is_MacroRules() && mi.ref.as_MacroRules() == mr && mi.path == from ) {
+                            DEBUG(m.path() << ": Import " << mi.name << " = " << from << " -> " << to);
+                            mi.path = to;
+                        }
+                    }
+                    for(auto& i : m.m_items) {
+                        if( auto* sm = i->data.opt_Module() )
+                            repoint(*sm, mr, from, to);
+                    }
+                    for(auto& am : m.anon_mods()) {
+                        if( am )
+                            repoint(*am, mr, from, to);
+                    }
+                }
+            };
+            H::repoint(crate.m_root_module, &*e.data, mod.path() + name, AST::AbsolutePath("", {name}));
+
             e.data->m_exported = true;
             DEBUG("- Export macro " << name << "!");
             crate.m_root_module.macros().push_back( mv$(e) );
