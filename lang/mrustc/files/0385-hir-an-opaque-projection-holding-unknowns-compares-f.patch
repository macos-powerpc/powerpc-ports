From 019aca0cd15d232c68d3130809d4919645b8d0e6 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 25 Oct 2026 00:44:18 +0000
Subject: [PATCH 385/385] hir: an opaque projection holding unknowns compares
 fuzzily, not unequal

nalgebra 0.32.3 (librsvg 2.58.5) src/geometry/point_conversion.rs:40

    fn from_superset_unchecked(m: &OPoint<T2, D>) -> Self {
        Self::from(Matrix::from_superset_unchecked(&m.coords))
    }

failed in Resolve UFCS with `error:0: Failed to find impl with
'from_superset_unchecked' for Matrix<_,_,_,_> (in <Matrix<_,_,_,_> as
_>::from_superset_unchecked)`.

The in-scope trait search (resolve_ufcs.cpp set_from_trait_impl) runs the
static find_impl for `SubsetOf<?> for Matrix<_,_,_,_>`. The only candidate
is `impl SubsetOf<OMatrix<T2,R2,C2>> for OMatrix<T1,R1,C1> where
DefaultAllocator: SameShapeAllocator<T1,R1,C1,R2,C2>, ..`, whose blanket
impl requires `DefaultAllocator: Allocator<T, SameShapeR<R1,R2>,
SameShapeC<C1,C2>>`. With every parameter unknown the projections
`<ShapeConstraint as SameNumberOfRows<_, P>>::Representative` can't be
expanded; StaticTraitResolve's EAT marks such a path opaque, and
MatchGenerics::cmp_type then compared it with the Allocator impls' `Const<R>`
/ `Dyn` as Unequal, so every impl was rejected and the bound "failed".

An opaque projection on the right-hand side that still contains an
inference variable or an impl placeholder is not a distinct type yet: once
those are known it may expand to anything (rustc: a projection that can't
be normalised because of inference variables is ambiguous, never
a mismatch). cmp_type's Path arm now returns Fuzzy for it; an opaque
projection without unknowns (`<T as Tr>::A` for a generic T) keeps comparing
Unequal.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir/type.cpp b/src/hir/type.cpp
index 629f1ff7..0dda8591 100644
--- a/src/hir/type.cpp
+++ b/src/hir/type.cpp
@@ -8,6 +8,7 @@
 #include "type.hpp"
 #include <span.hpp>
 #include "expr.hpp" // Hack for cloning array types
+#include <hir_typeck/common.hpp>  // visit_ty_with
 #include <cstdint>
 
 namespace HIR {
@@ -1023,6 +1024,21 @@ const HIR::GenericParams* HIR::TrackHrbStack::hrb_declaring_lifetime(unsigned id
                 DEBUG("- Fuzzy match due to opaque");
                 return Compare::Fuzzy;
             }
+            // An opaque projection on the right that still holds an inference variable or an impl placeholder is not
+            // a distinct type yet: once those are known it may expand to anything (rustc: a projection that can't be
+            // normalised because of inference variables is ambiguous, never a mismatch). The static resolver marks
+            // such a path opaque when its impl search is only fuzzy; nalgebra 0.32.3 point_conversion.rs:40
+            // `Matrix::from_superset_unchecked(&m.coords)` in Resolve UFCS checked the blanket `SameShapeAllocator`
+            // impl's bound `DefaultAllocator: Allocator<T, <ShapeConstraint as SameNumberOfRows<_, P>>::Representative, ..>`
+            // against `Allocator<T, Const<R>, Const<C>>`: "Failed to find impl with 'from_superset_unchecked'".
+            if( xe.binding.is_Opaque() && xe.path.m_data.is_UfcsKnown()
+                && visit_ty_with(x, [](const ::HIR::TypeRef& t){
+                    return t.data().is_Infer() || (t.data().is_Generic() && t.data().as_Generic().is_placeholder());
+                    }) )
+            {
+                DEBUG("- Fuzzy match due to an opaque projection with unknowns - " << v << " = " << x);
+                return Compare::Fuzzy;
+            }
         }
         return rv;
         }
