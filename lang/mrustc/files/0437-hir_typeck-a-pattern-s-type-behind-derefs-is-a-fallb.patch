From b06e4883e861840a5fb33f6d04d525a8e46a0214 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 5 Nov 2026 23:03:57 +0000
Subject: [PATCH] hir_typeck: a pattern's type behind derefs is a fallback for
 the ivar, not a possibility

cargo 0.99.0 src/cargo/core/compiler/mod.rs:552 (cargo-c 0.10.25),
a regression of 0432: "Failed to find an impl of IntoIterator for
Iter<'_, LibraryPath> with Item = LibraryPath".

`let mut library_paths = vec![]; library_paths.extend(out.library_paths
.iter()); library_paths.sort_by_key(|p| match p { LibraryPath::
CargoArtifact(_) => 0, LibraryPath::External(_) => 1 });`. The closure's
parameter becomes `&_1` while `_1` is still pending on Vec's two `Extend`
impls (`Extend<T>` would make it `&LibraryPath`; `Extend<&T> for Vec<T:
Copy>` is a candidate until the Copy bound is checked). 0432 offered the
pattern's enum as a normal-stage possibility for `_1`; it was taken, and
the `IntoIterator<Item = LibraryPath>` bound of `extend` then failed.
rustc never meets this: the extend call is resolved before the closure is
checked.

Behind one or more derefs the pattern's type is now used only by the
fallback revisit (a direct equate once nothing else resolved the ivar).
The derive-deftly case that 0432 was written for has no other source and
is still resolved there; the no-deref case is unchanged.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 808671c5..c16cfa0d 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -3099,6 +3099,12 @@ void Context::handle_pattern(const Span& sp, ::HIR::Pattern& pat, const ::HIR::T
                                 }
                             }
                         }
+                        // Behind derefs the pattern's type is only a fallback: the ivar may still get its value from
+                        // a bound the pattern knows nothing about. cargo 0.99.0 compiler/mod.rs:552 `library_paths.extend(
+                        // v.iter())` then `.sort_by_key(|p| match p { LibraryPath::CargoArtifact(_) => 0, .. })`: `p: &_`,
+                        // and `_` is `&LibraryPath` from Vec's `Extend<T>` impl, still pending while `Extend<&T> for
+                        // Vec<T: Copy>` is a candidate; offered as a possibility, `LibraryPath` won and the bound failed.
+                        const bool behind_derefs = n_deref > 0 && !possible_type.data().is_Borrow();
                         if( possible_type_p )
                         {
                             const auto& possible_type = *possible_type_p;
@@ -3107,6 +3113,10 @@ void Context::handle_pattern(const Span& sp, ::HIR::Pattern& pat, const ::HIR::T
                                 DEBUG("Fallback equate " << possible_type);
                                 context.equate_types(sp, *ty_p, possible_type);
                             }
+                            else if( behind_derefs )
+                            {
+                                DEBUG("Behind " << n_deref << " derefs: " << possible_type << " only as the fallback");
+                            }
                             else if( const auto* te = ty_p->data().opt_Infer() )
                             {
                                 // If this is a slice pattern (i.e. the possible type is an array), then add deref-to-slice too
