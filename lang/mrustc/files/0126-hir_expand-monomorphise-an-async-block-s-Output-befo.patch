From 9097e605524429308b54b5122643ece9158621f9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 14:36:44 +0000
Subject: [PATCH 126/126] hir_expand: monomorphise an async block's Output
 before its generics move into the impl

The Future impl generated for an async block monomorphised its Output
type through the block's monomorphiser after `impl.m_params =
std::move(params)`, and that monomorphiser refers to `params`. For
a generic async fn whose output names one of its generics (tokio 1.43.0
`async fn lookup_host<T>(..) -> io::Result<impl Iterator>`, whose Output
is `io::Result<<T as ToSocketAddrsPriv>::Iter>`; or just
`async fn id<T>(x: T) -> T`) the lookup then found no parameters:
"BUG: ASSERT FAIL: closures.cpp:752: constructor_path_params.m_types.size()
== params.m_types.size()" (before 0120 the same shape failed at
closures.cpp:763 "get_type would add a new param after freeze").

The Output type is now monomorphised first.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_expand/closures.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/hir_expand/closures.cpp b/src/hir_expand/closures.cpp
index 289aeb99..ba5eb31a 100644
--- a/src/hir_expand/closures.cpp
+++ b/src/hir_expand/closures.cpp
@@ -1981,10 +1981,13 @@ namespace {
 
 
             // -- Create impl
+            // The output type goes through `monomorph_cb`, which refers to `params`: before they move into the impl
+            // - tokio 1.43.0: `async fn lookup_host<T>(host: T) -> io::Result<impl Iterator<..>>` (Output names `T`)
+            auto output_ty = monomorph_cb.monomorph_type(sp, return_ty);
             ::HIR::TraitImpl    impl;
             impl.m_params = std::move(params);
             impl.m_type = ::HIR::TypeRef::new_path( ::HIR::GenericPath(gen_struct_path, impl.m_params.make_nop_params(0)), &gen_struct_ref );
-            impl.m_types.insert(std::make_pair( RcString::new_interned("Output"), ::HIR::TraitImpl::ImplEnt<HIR::TypeRef> { false, monomorph_cb.monomorph_type(sp, return_ty) } ));
+            impl.m_types.insert(std::make_pair( RcString::new_interned("Output"), ::HIR::TraitImpl::ImplEnt<HIR::TypeRef> { false, std::move(output_ty) } ));
             impl.m_methods.insert(std::make_pair( RcString::new_interned("poll"), ::HIR::TraitImpl::ImplEnt<HIR::Function> { false, std::move(fcn_resume) } ));
             m_out.trait_impls.push_back(std::make_pair("future_trait", std::move(impl)));
         }
