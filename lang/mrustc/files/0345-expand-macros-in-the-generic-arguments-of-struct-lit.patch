From 83f7a3107486aecfa3618c3b64a5607205904c11 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 20:23:47 +0000
Subject: [PATCH 345/345] expand: macros in the generic arguments of
 struct-literal and pattern paths are expanded

konst_macro_rules 0.2.19 src/into_iter/range_into_iter.rs:242 (repgrep 0.17.1), `all_range_impls!{usize}` ->
range_exc_impls! -> int_range_shared! -> iterator_shared! (internal_macros.rs:21-25):
    pub const fn rev(self) -> $crate::__choose!($is_forward $Rev $Self) {
        let Self $fields = self;
        type Type<T> = T;
        Type::<$crate::__choose!($is_forward $Rev $Self)> $fields
    }
= "MACRO<::"konst_macro_rules"::iterator_shared> BUG: src/resolve/absolute.cpp:2262: Resolve_Absolute_Type -
Encountered an unexpanded macro in type - ::"konst_macro_rules"::__choose!". The return type was expanded; the macro
in the struct literal's turbofish was not: the expand pass's expression visitor visited a struct literal's base value
and fields but never its path (`ExprNode_StructLiteral`, and the destructuring-assignment
`ExprNode_StructLiteralPattern`), unlike call and value paths, so a macro in the path's generic arguments stayed as
written until resolve. `Expand_Pattern` had the same gap for the paths of struct, tuple-struct and value patterns
(`G::<choose!(..)> { x }`, `W::<choose!(..)>(z)`, `En::<choose!(..)>::V`). Not a regression, and the macro nesting
doesn't matter: a plain `Type::<crate::choose!(true B A)> { x }` fails the same way.

Expand_Path on those paths (its generic arguments go through Expand_PathParams -> Expand_Type, as for every other
path).

Assisted-By: Claude Fable 5.1
---

diff --git a/src/expand/mod.cpp b/src/expand/mod.cpp
index a4cb3ebe..93b60ec7 100644
--- a/src/expand/mod.cpp
+++ b/src/expand/mod.cpp
@@ -567,10 +567,14 @@ void Expand_Pattern(const ExpandState& es, ::AST::Module& mod, ::AST::Pattern& p
     TU_ARMA(Value, e) {
         //Expand_Expr(crate, modstack, e.start);
         //Expand_Expr(crate, modstack, e.end);
+        if( e.start.is_Named() )    Expand_Path(es, mod, e.start.as_Named());
+        if( e.end.is_Named() )      Expand_Path(es, mod, e.end.as_Named());
         }
     TU_ARMA(ValueLeftInc, e) {
         //Expand_Expr(crate, modstack, e.start);
         //Expand_Expr(crate, modstack, e.end);
+        if( e.start.is_Named() )    Expand_Path(es, mod, e.start.as_Named());
+        if( e.end.is_Named() )      Expand_Path(es, mod, e.end.as_Named());
         }
     TU_ARMA(Tuple, e) {
         for(auto& sp : e.start)
@@ -579,12 +583,16 @@ void Expand_Pattern(const ExpandState& es, ::AST::Module& mod, ::AST::Pattern& p
             Expand_Pattern(es, mod, sp, is_refutable);
         }
     TU_ARMA(StructTuple, e) {
+        // A pattern path's generic arguments can hold macros too (`Type::<choose!(..)> { .. }`, see the struct
+        // literal visitor)
+        Expand_Path(es, mod, e.path);
         for(auto& sp : e.tup_pat.start)
             Expand_Pattern(es, mod, sp, is_refutable);
         for(auto& sp : e.tup_pat.end)
             Expand_Pattern(es, mod, sp, is_refutable);
         }
     TU_ARMA(Struct, e) {
+        Expand_Path(es, mod, e.path);
         for(auto& subpat : e.sub_patterns) {
             if( !Expand_Attrs_CfgOnly(es, subpat.attrs) ) {
                 subpat.name = RcString();
@@ -1499,6 +1507,8 @@ struct CExpandExpr:
         m_try_stack = std::move(try_stack);
     }
     void visit(::AST::ExprNode_StructLiteral& node) override {
+        // The path's generic arguments can hold macros: `Type::<$crate::__choose!(..)> { .. }` (konst_macro_rules)
+        Expand_Path(this->expand_state, this->cur_mod(),  node.m_path);
         this->visit_nodelete(node, node.m_base_value);
         for(auto& val : node.m_values)
         {
@@ -1518,6 +1528,7 @@ struct CExpandExpr:
         }
     }
     void visit(::AST::ExprNode_StructLiteralPattern& node) override {
+        Expand_Path(this->expand_state, this->cur_mod(),  node.m_path);
         for(auto& val : node.m_values)
         {
             Expand_Attrs_CfgAttr(val.attrs);
