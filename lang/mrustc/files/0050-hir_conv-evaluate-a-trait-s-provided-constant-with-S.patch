From d100b6d9239a5e7ca7df93c1400782d06708360a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 09:09:54 +0000
Subject: [PATCH 50/50] hir_conv: evaluate a trait's provided constant with `Self`
 generic the first time

`get_const` evaluates a still-unknown constant once from its generic
definition before falling back to per-monomorph evaluation. For
a trait's provided constant reached as `<f64 as FloatTraits>::EXP_MASK`
(zmij 1.0.21: an array size in a struct field, evaluated before the
trait's own constants are visited), that first evaluation got no `Self`
binding, because `evaluate_constant` only infers one for paths that name
the trait item directly. `Self::NUM_EXP_BITS` in the default expression
therefore became `<_ as FloatTraits>::NUM_EXP_BITS`, the impl search for
`_` matched both impls, and ordering them aborted:

    <null> BUG: src/hir/hir_ops.cpp:133: Mismatched types - f64 and f32

Bind `Self` to the trait's generic `Self` for that evaluation, so it
defers as designed and the constant is then evaluated per type with the
real `Self`. An `_` left in a constant path now also defers instead of
being resolved through the impl list.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_conv/constant_evaluation.cpp | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index 5ccd34e2..e0ec23a6 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -1304,7 +1304,9 @@ namespace MIR { namespace eval {
             auto p = ms.monomorph_path(state.sp, in_p);
             root_resolve.expand_associated_types_path(state.sp, p);
             // If there's any mention of generics in this path, then return Literal::Defer
-            if( visit_path_tys_with(p, [&](const auto& ty)->bool { return ty.data().is_Generic(); }) )
+            // - An unresolved `_` means the evaluation context didn't know a type (e.g. no `Self`): equally not evaluable
+            //   here, and resolving it through the impl list would be a guess.
+            if( visit_path_tys_with(p, [&](const auto& ty)->bool { return ty.data().is_Generic() || ty.data().is_Infer(); }) )
             {
                 DEBUG("Return Literal::Defer for constant " << p << " which references a generic parameter");
                 throw Defer();
@@ -1327,6 +1329,20 @@ namespace MIR { namespace eval {
                 MonomorphState  temp_ms;
                 temp_ms.pp_impl = &temp_pp_impl;
                 temp_ms.pp_method = &temp_pp_method;
+                // A trait's provided constant reached through `<Type as Trait>::NAME` (e.g. before the trait itself has been
+                // visited): this first evaluation is of the generic definition, so `Self` is the trait's `Self`, not `Type`.
+                // Without it `Self::OTHER` became `<_ as Trait>::OTHER` and matched every impl (zmij's `f64::EXP_MASK` in
+                // an array size). `evaluate_constant` only infers this for paths naming the trait item directly.
+                if( const auto* pe = p.m_data.opt_UfcsKnown() )
+                {
+                    const auto& tr = root_resolve.m_crate.get_trait_by_path(state.sp, pe->trait.m_path);
+                    auto it = tr.m_values.find(pe->item);
+                    if( it != tr.m_values.end() && it->second.is_Constant() && &it->second.as_Constant() == &c )
+                    {
+                        DEBUG("- Trait-provided constant, evaluating with `Self` generic");
+                        temp_ms.self_ty = ::HIR::TypeRef::new_self();
+                    }
+                }
                 DEBUG("- Evaluate " << p);
                 try
                 {
