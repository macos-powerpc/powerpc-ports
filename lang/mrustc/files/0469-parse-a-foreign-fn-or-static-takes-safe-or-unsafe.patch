From e50d097f32e96283a6e91c2a4af9f705d21c7597 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 16:58:34 +0000
Subject: [PATCH] parse: a foreign fn or static takes `safe` or `unsafe`

rustc 1.90 tests/ui, parse-only run:

    unpretty/extern-static.rs                  pub unsafe static STATIC: ();
    linking/executable-no-mangle-strip.rs      unsafe static THIS_SYMBOL..: usize;
    linkage-attr/raw-dylib/elf/glibc-x86_64.rs unsafe fn nftw_2_2_5(..) -> c_int;
    error: Unexpected token TOK_RWORD_UNSAFE, expected one of TOK_RWORD_FN
    or TOK_RWORD_STATIC or TOK_RWORD_TYPE

Reference, External blocks: ExternalItem is `Visibility? ( StaticItem |
Function )`, StaticItem starts with `ItemSafety? static`, Function with
FunctionQualifiers (`const? async? ItemSafety? ..`), ItemSafety is
`safe | unsafe` (the items of an `unsafe extern` block, edition 2024
and stable since 1.82).

Parse_ExternBlock_Item took `safe` (any next token) and no `unsafe`. It
now takes either keyword when `fn` or `static` follows. Nothing records
the safety: a foreign item stays unsafe to use, as before.

Grammar copies: the macro_rules item skimmer reads an extern block's
body as one token tree; the proc-macro visitor and ast/dump do not
print foreign items.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 0e23f660..bc372890 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1673,16 +1673,12 @@ AST::Named<AST::Item> Parse_ExternBlock_Item(TokenStream& lex, const std::string
     }
 
     auto vis = Parse_Publicity(lex);
-    if( GET_TOK(tok, lex) == TOK_IDENT ) {
-        if( tok.ident() == "safe" ) {
-            // TODO: Check that the next token is TOK_RWORD_FN
-        }
-        else {
+    // ItemSafety (`safe` / `unsafe`) before a foreign fn or static (`unsafe extern` blocks, edition 2024)
+    if( lex.lookahead(1) == TOK_RWORD_FN || lex.lookahead(1) == TOK_RWORD_STATIC )
+    {
+        GET_TOK(tok, lex);
+        if( !(tok.type() == TOK_RWORD_UNSAFE || (tok.type() == TOK_IDENT && tok.ident() == "safe")) )
             PUTBACK(tok, lex);
-        }
-    }
-    else {
-        PUTBACK(tok, lex);
     }
     switch( GET_TOK(tok, lex) )
     {
