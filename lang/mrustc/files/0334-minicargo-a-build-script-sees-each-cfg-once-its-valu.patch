From a7a99b76c7f639653c97d9ac239fc6dee4d9062f Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 13:19:28 +0000
Subject: [PATCH] minicargo: a build script sees each cfg once, its values
 comma-joined as cargo does; `target_vendor` has one value

objc-sys@0.3.5 (alacritty 0.17.0): the build script panicked with "Must specify the desired runtime using Cargo
features on non-Apple platforms" on powerpc-apple-darwin. It takes the Apple runtime when
`env::var("CARGO_CFG_TARGET_VENDOR") == "apple"` (the `apple` feature is a no-op in 0.3.5), and the environment
minicargo gave it held `CARGO_CFG_TARGET_VENDOR=` ahead of `CARGO_CFG_TARGET_VENDOR=apple`: getenv returns the first
entry of a name.

Two causes:
- src/trans/target.cpp Target_SetCfg added the `""` default for `target_vendor` after the per-OS value, but
  Cfg_SetValue fills a multimap and never replaces, so `cfg(target_vendor = "")` held on every target and
  `-Z print-cfgs` listed both values. The vendor is now chosen once and set once.
- tools/minicargo/cfg.cpp Cfg_ToEnvironment pushed one environment entry per cfg value (`CARGO_CFG_TARGET_HAS_ATOMIC=8`,
  `=16`, ... as separate entries, only the first of them visible to a build script). cargo sets one variable per cfg
  name with the values sorted and joined by `,` (`CARGO_CFG_TARGET_HAS_ATOMIC=16,32,8,cas,ptr`); minicargo now does
  the same (an empty value joins too, so an old compiler's duplicate shows as `,apple`).

Assisted-By: Claude Fable 5.1
---

diff --git a/src/trans/target.cpp b/src/trans/target.cpp
index d5cba327..0b5eda02 100644
--- a/src/trans/target.cpp
+++ b/src/trans/target.cpp
@@ -701,43 +701,48 @@ void Target_SetCfg(const ::std::string& target_name)
     }
     Cfg_SetValue("target_family", g_target.m_family);
 
+    // `target_vendor` gets exactly one value. `Cfg_SetValue` ADDS to a multimap (it never replaces), so an
+    // unconditional `""` default after the per-OS value made `cfg(target_vendor = "")` hold on every target, and
+    // minicargo handed build scripts `CARGO_CFG_TARGET_VENDOR=` next to `CARGO_CFG_TARGET_VENDOR=apple` (a build
+    // script's `getenv` sees whichever comes first: objc-sys 0.3.5 chooses its runtime by `target_vendor == "apple"`).
+    ::std::string   target_vendor;
     if( g_target.m_os_name == "linux" )
     {
         Cfg_SetFlag("linux");
-        Cfg_SetValue("target_vendor", "gnu");
+        target_vendor = "gnu";
     }
 
     if( g_target.m_os_name == "macos" )
     {
         Cfg_SetFlag("apple");
-        Cfg_SetValue("target_vendor", "apple");
+        target_vendor = "apple";
     }
 
     if( g_target.m_os_name == "freebsd" )
     {
         Cfg_SetFlag("freebsd");
-        Cfg_SetValue("target_vendor", "unknown");
+        target_vendor = "unknown";
     }
 
     if( g_target.m_os_name == "netbsd" )
     {
         Cfg_SetFlag("netbsd");
-        Cfg_SetValue("target_vendor", "unknown");
+        target_vendor = "unknown";
     }
 
     if( g_target.m_os_name == "openbsd" )
     {
         Cfg_SetFlag("openbsd");
-        Cfg_SetValue("target_vendor", "unknown");
+        target_vendor = "unknown";
     }
 
     if( g_target.m_os_name == "dragonfly" )
     {
         Cfg_SetFlag("dragonfly");
-        Cfg_SetValue("target_vendor", "unknown");
+        target_vendor = "unknown";
     }
 
-    Cfg_SetValue("target_vendor", "");  // NOTE: Doesn't override a pre-set value
+    Cfg_SetValue("target_vendor", target_vendor);
     Cfg_SetValue("target_env", g_target.m_env_name);
     Cfg_SetValue("target_os", g_target.m_os_name);
     Cfg_SetValue("target_pointer_width", FMT(g_target.m_arch.m_pointer_bits));
diff --git a/tools/minicargo/cfg.cpp b/tools/minicargo/cfg.cpp
index 26d4daf3..8e9eaf62 100644
--- a/tools/minicargo/cfg.cpp
+++ b/tools/minicargo/cfg.cpp
@@ -18,6 +18,8 @@
 #include <fstream>
 #include <unordered_map>
 #include <unordered_set>
+#include <map>
+#include <set>
 #include <cctype>   // toupper
 
 class CfgParseLexer
@@ -180,6 +182,9 @@ bool Cfg_Check(const char* cfg_string, const std::vector<std::string>& features,
     return gCfgChecker.check_cfg(cfg_string, features, allowed_cfg);
 }
 /// Dump configuration as CARGO_CFG_<name>
+/// - As cargo does it: ONE variable per cfg name, a multi-valued cfg's values sorted and joined with `,`
+///   (`CARGO_CFG_TARGET_HAS_ATOMIC=16,32,8,cas,ptr`). One entry per value put the same name into the build script's
+///   environment several times, and `getenv` only ever returns the first of those.
 void Cfg_ToEnvironment(StringListKV& out)
 {
     struct H {
@@ -201,9 +206,23 @@ void Cfg_ToEnvironment(StringListKV& out)
             return ss.str();
         }
     };
+    std::map<std::string, std::set<std::string>>   values;
     for(const auto& v : gCfgChecker.values)
     {
-        out.push_back(H::make_name(v.first), v.second);
+        values[v.first].insert(v.second);
+    }
+    for(const auto& kv : values)
+    {
+        std::string joined;
+        bool first = true;
+        for(const auto& v : kv.second)
+        {
+            if( !first )
+                joined += ",";
+            joined += v;
+            first = false;
+        }
+        out.push_back(H::make_name(kv.first), joined);
     }
     for(const auto& flag : gCfgChecker.flags)
     {
