 src/hir_conv/constant_evaluation.cpp |  6 +++++-
 src/hir_conv/constant_evaluation.hpp |  8 ++++++++
 src/trans/monomorphise.cpp           | 12 ++++++++++++
 3 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index 1d3f9ae9..64370dfd 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -3076,7 +3076,11 @@ namespace HIR {
                 if( fcn.m_linkage.name == "" ) {
                 }
                 else if( fcn.m_linkage.name == "panic_impl" ) {
-                    MIR_TODO(state, "panic in constant evaluation");
+                    // Reached `panic!()`. Not an error by itself (see `ConstEvalPanic`): unwind to the
+                    // caller, which either leaves the constant unevaluated (eager pass) or reports the
+                    // use (Trans Monomorph).
+                    DEBUG("panic in constant evaluation (" << *fcn_path << ")");
+                    throw ConstEvalPanic();
                 }
                 else {
                     MIR_TODO(state, "Call extern function `" << fcn.m_linkage.name << "` (" << *fcn_path << ")");
diff --git a/src/hir_conv/constant_evaluation.hpp b/src/hir_conv/constant_evaluation.hpp
index b8405070..84f2cba3 100644
--- a/src/hir_conv/constant_evaluation.hpp
+++ b/src/hir_conv/constant_evaluation.hpp
@@ -22,6 +22,14 @@ namespace HIR {
 // expected to catch and treat as "leave for a later pass to retry".
 struct Defer {};
 
+// Thrown when constant evaluation reaches `panic!()` (a call to the `panic_impl` hook).
+// Derives from `Defer` so the eager "Constant Evaluate" pass simply leaves the constant
+// unevaluated: rustc only evaluates associated constants when something uses them, so a
+// panicking constant that nothing uses must compile (zerocopy 0.7's
+// `<cell::Ref<[u8]> as ByteSlice>::INTO_REF_INTO_MUT_ARE_SOUND` is a deliberate `panic!()`
+// guard). A use of such a constant is reported when its monomorphised value is required.
+struct ConstEvalPanic: public Defer {};
+
 struct Evaluator
 {
     class Newval
diff --git a/src/trans/monomorphise.cpp b/src/trans/monomorphise.cpp
index ebb0fc09..be0d221b 100644
--- a/src/trans/monomorphise.cpp
+++ b/src/trans/monomorphise.cpp
@@ -174,6 +174,12 @@ void Trans_Monomorphise_List(const ::HIR::Crate& crate, TransList& list)
             // 2. Store evaluated HIR::Literal in c.m_monomorph_cache
             c.m_monomorph_cache.insert(::std::make_pair( path.clone(), ::std::move(new_lit) ));
         }
+        catch(const ::HIR::ConstEvalPanic&)
+        {
+            // A `panic!()` was reached while evaluating a constant that IS used (rustc: "evaluation of
+            // constant value failed"). Report it against the use rather than crashing.
+            ERROR(pp.sp, E0000, "Constant evaluation panicked while evaluating " << path);
+        }
         catch(...)
         {
             // Deferred - no update
@@ -208,6 +214,12 @@ void Trans_Monomorphise_List(const ::HIR::Crate& crate, TransList& list)
