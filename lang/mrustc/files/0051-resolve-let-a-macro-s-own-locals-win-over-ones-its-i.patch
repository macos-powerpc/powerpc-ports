From 0ab65260b33f2c4e552b2744151b6eb6989dd74b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 04:33:05 +0000
Subject: [PATCH 51/59] resolve: let a macro's own locals win over ones its
 input binds

A macro body can see the locals around the macro's definition: a local
is visible when its hygiene context is the use's context or an
ancestor of it. Local lookup took the innermost visible local, so a
local bound inside the expansion by the macro's *input* (also in an
ancestor context) shadowed the macro's own local of the same name.
rug 1.28.1's `int_rat!` (src/ext/xmpq.rs) does

    let (num, den) = unsafe { rat.as_mut_numer_denom_no_canonicalization() };
    let $den: &Integer = &*den;
    $body
    xmpz::set_1(den);

with `den` passed as `$den`, so the final `den` (the macro's `&mut`)
resolved to the caller's `&Integer` binding:

    Type mismatch between &mut Integer and &Integer - Borrow classes differ

Return a local with exactly the use's hygiene as soon as it is found.
One only visible through an ancestor context is kept as a fallback
while the search continues outwards, and still wins over a same-named
item or const generic found before an exact match, as it did before.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/resolve/absolute.cpp | 29 ++++++++++++++++++++++++++---
 1 file changed, 26 insertions(+), 3 deletions(-)

diff --git a/src/resolve/absolute.cpp b/src/resolve/absolute.cpp
index 232a49af..5e6bf15f 100644
--- a/src/resolve/absolute.cpp
+++ b/src/resolve/absolute.cpp
@@ -641,6 +641,16 @@ namespace
                     }
                 }
             }
+            // A local seen through an outer hygiene context (a macro body seeing locals around the macro's definition) only
+            // binds if no local with the exact same context is found further out. Locals bound by the macro's input inside
+            // the expansion are also seen that way, and must not shadow the macro's own bindings.
+            // - e.g. `let (num, den) = ...; let $den: &Integer = &*den; $body; set_1(den);` (rug 1.28.1)
+            unsigned fallback_var = ~0u;
+            auto get_fallback_var = [&]() {
+                ::AST::Path rv(name);
+                rv.bind_variable( fallback_var );
+                return rv;
+                };
             for(auto it = m_name_context.rbegin(); it != m_name_context.rend(); ++ it)
             {
                 TU_MATCH_HDRA( (*it), {)
@@ -648,6 +658,9 @@ namespace
                     DEBUG("- Module " << e.mod->path());
                     ::AST::Path rv;
                     if( this->lookup_in_mod(*e.mod, name, mode,  rv) ) {
+                        if( fallback_var != ~0u ) {
+                            return get_fallback_var();
+                        }
                         return rv;
                     }
                     }
@@ -698,14 +711,18 @@ namespace
                     else {
                         for( auto it2 = e.variables.rbegin(); it2 != e.variables.rend(); ++ it2 )
                         {
-                            if( it2->first.name == name ) {
-                                DEBUG("> Match: Hygiene " << it2->first.hygiene << " check against src_context");
+                            if( it2->first.name != name ) {
+                                continue ;
                             }
-                            if( it2->first.name == name && it2->first.hygiene.is_visible(src_context) ) {
+                            DEBUG("> Match: Hygiene " << it2->first.hygiene << " check against src_context");
+                            if( it2->first.hygiene == src_context ) {
                                 ::AST::Path rv(name);
                                 rv.bind_variable( it2->second );
                                 return rv;
                             }
+                            if( fallback_var == ~0u && it2->first.hygiene.is_visible(src_context) ) {
+                                fallback_var = it2->second;
+                            }
                         }
                     }
                     }
@@ -729,6 +746,9 @@ namespace
                         for(auto it2 = e.constants.rbegin(); it2 != e.constants.rend(); ++it2)
                         {
                             if( it2->name == name ) {
+                                if( fallback_var != ~0u ) {
+                                    return get_fallback_var();
+                                }
                                 ::AST::Path rv(name);
                                 rv.m_bindings.value.set(AST::AbsolutePath(), AST::PathBinding_Value::make_Generic({ it2->value.to_binding() }));
                                 return rv;
@@ -743,6 +763,9 @@ namespace
                     }
                 }
             }
+            if( fallback_var != ~0u ) {
+                return get_fallback_var();
+            }
 
             // Top-level module
             DEBUG("- Top module (" << m_mod.path() << ")");
