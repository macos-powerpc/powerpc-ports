From e7428b11b6f552f8a283d8cf7cdedad01a543fd5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 2 Oct 2026 03:36:30 +0000
Subject: [PATCH] parse: accept inner attributes at the start of trait bodies

rustc allows inner attributes (`#![...]`, `//!`, `/*! */`) at the top of
a `trait { }` block, as it does for `impl` blocks. Parse_Impl already calls
Parse_ParentAttrs after the opening brace; Parse_TraitDef didn't, so the
item parser saw `#!` and failed:
    Unexpected token TOK_EXCLAM, expected TOK_SQUARE_OPEN

Parse them onto the trait's own attribute list.

Hit by fs_at 0.2.1 (navi): `pub trait OpenOptionsExt { /*! ... */ fn mode(..); }`

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/parse/root.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 9f4f8662..5f59f961 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -903,7 +903,7 @@ AST::Named<AST::Item> Parse_Trait_Item(TokenStream& lex)
     return ::AST::Named<::AST::Item>( lex.end_span(ps), mv$(item_attrs), AST::Visibility::make_global(), mv$(name), mv$(rv) );
 }
 
-AST::Trait Parse_TraitDef(TokenStream& lex, const AST::AttributeList& meta_items, AST::GenericParams params)
+AST::Trait Parse_TraitDef(TokenStream& lex, AST::AttributeList& meta_items, AST::GenericParams params)
 {
     TRACE_FUNCTION;
 
@@ -951,6 +951,8 @@ AST::Trait Parse_TraitDef(TokenStream& lex, const AST::AttributeList& meta_items
     AST::Trait trait( mv$(params), mv$(supertraits), mv$(lifetimes) );
 
     CHECK_TOK(tok, TOK_BRACE_OPEN);
+    // Inner attributes (e.g. a `/*! ... */` doc comment) apply to the trait itself
+    Parse_ParentAttrs(lex, meta_items);
     while( GET_TOK(tok, lex) != TOK_BRACE_CLOSE )
     {
         PUTBACK(tok, lex);
