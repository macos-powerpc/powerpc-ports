From d319d07847b28f7605e6ccccc6a6af3dbe6087b7 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 16:26:49 +0000
Subject: [PATCH] hir_typeck: an opaque type dereferences through its bounds,
 supertrait bindings included

Two failures of one rule: an `impl Trait` return type is a parameter
with bounds.

pyo3 0.30.1 (py314-hypothesis) impl_/pyclass.rs:1029,
`<T as PyClassWithFreeList>::get_free_list(py).insert(..)` with
a method returning `impl DerefMut<Target = ..>`:

    error:0: No applicable methods for {impl DerefMut+use<..>
    /*fn <T as PyClassWithFreeList>::get_free_list#0*/}.insert

`DerefMut<Target = X>` binds `Target`, an item of the supertrait Deref.
The opaque-type arm of find_trait_impls answered `Deref` from the
supertrait list without the bound's own bindings, so autoderef got
an unnamed `Target` and found no method of `X`. The where-clause arm
(`T: DerefMut<Target = X>`) has merged them since 0283, and the static
resolver always did. The trait-object arm had the same gap
(`dyn DerefMut<Target = X>`).

cap-primitives 4.0.3 (uv) fs/via_parent/rename.rs:30, `&old_path` with
`old_path: impl Deref<Target = Path>` passed as `&Path`:

    error:0: Type mismatch between Path and impl Deref+'#omitted+use<..>
    /*fn ..strip_dir_suffix#0*/

check_unsize_tys returns early for source types that cannot
deref-coerce, by listing those that can: generic, path, borrow.
An opaque type can, through its bound.

Assisted-by: Claude Fable 5.2
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 9783dd5a..0237490e 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -4630,6 +4630,12 @@ namespace {
             else if( src.data().is_Borrow() )
             {
             }
+            // An opaque type derefs through its bounds, like a bounded parameter
+            // - cap-primitives 4.0.3 fs/via_parent/rename.rs:30: `&old_path` with `old_path: impl Deref<Target = Path>`
+            //   passed as `&Path`: "Type mismatch between Path and impl Deref+.."
+            else if( src.data().is_ErasedType() )
+            {
+            }
             else
             {
                 DEBUG("Target isn't a trait object, and sources can't Deref");
diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index 7f83028c..3ba1d11e 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -2042,6 +2042,11 @@ bool TraitResolution::find_trait_impls(const Span& sp,
                         ::HIR::TraitPath::assoc_list_t assoc_clone;
                         for(const auto& e : i_tp.m_type_bounds)
                             assoc_clone.insert( ::std::make_pair(e.first, e.second.clone()) );
+                        // The object's own bindings for the supertrait's items (`dyn DerefMut<Target = X>` binds Deref's
+                        // `Target`), as for a bounded parameter below
+                        for(const auto& aty : e.m_trait.m_type_bounds)
+                            if( aty.second.source_trait.m_path == i_tp.m_path.m_path )
+                                assoc_clone.insert( ::std::make_pair(aty.first, aty.second.clone()) );
                         ASSERT_BUG(sp, !e.m_trait.m_hrtbs || !i_tp.m_hrtbs, "TODO: Handle two layers of HRTBs - " << e.m_trait << " and " << i_tp);
                         // The supertrait path's own binder declares the HRLs in its params (`trait Tr: Fn(&A) -> B`
                         // as `dyn Tr`, figment's `Box<dyn Interpolator>`), same as the ErasedType arm below
@@ -2088,6 +2093,14 @@ bool TraitResolution::find_trait_impls(const Span& sp,
                         ::HIR::TraitPath::assoc_list_t assoc_clone;
                         for(const auto& e : i_tp.m_type_bounds)
                             assoc_clone.insert( ::std::make_pair(e.first, e.second.clone()) );
+                        // The bound's own bindings for the supertrait's items: `impl DerefMut<Target = X>` binds Deref's
+                        // `Target`, as `T: DerefMut<Target = X>` does for a parameter (below). Without it the opaque
+                        // type dereferenced to an unnamed `Target` and no method of `X` was found.
+                        // - pyo3 0.30.1 impl_/pyclass.rs:1029 `<T as PyClassWithFreeList>::get_free_list(py).insert(..)`
+                        //   (`-> impl DerefMut<Target = ..>`): "No applicable methods for {impl DerefMut+use<..>}.insert"
+                        for(const auto& aty : trait_path.m_type_bounds)
+                            if( aty.second.source_trait.m_path == i_tp.m_path.m_path )
+                                assoc_clone.insert( ::std::make_pair(aty.first, aty.second.clone()) );
                         ASSERT_BUG(sp, !trait_path.m_hrtbs || !i_tp.m_hrtbs, "TODO: Handle two layers of HRTBs - " << trait_path << " and " << i_tp);
                         auto hrls = trait_path.m_hrtbs
                             ? get_hrls(sp, trait_path.m_hrtbs, i_tp.m_path.m_params, params)
