From b1d5ad756920e950570f5f9e1b8ba4f1ddd73ae8 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 21:55:27 +0000
Subject: [PATCH] hir_expand: a borrow of a constant expression naming a generic
 constant is promoted to a static

A borrow of a constant expression is lifted into a `static`; inside
a generic item the static takes the item's generics, and Trans evaluates
its value for each instance (Trans_Monomorphise_List), which is how
a generic function pointer in such a value already worked. A path to
a generic constant was still refused ("Constant path is still generic"),
so the borrow stayed a borrow of a temporary. tokio 1.43.0
runtime/task/raw.rs:

  pub(super) fn vtable<T: Future, S: Schedule>() -> &'static Vtable {
      &Vtable { poll: poll::<T, S>, ..,
                trailer_offset: OffsetHelper::<T, S>::TRAILER_OFFSET, .. }
  }

returned a pointer into its own stack frame: "Lifetime bound '#local0:
'static failed", which MRUSTC_LIFETIME_ERRORS=warn (as the mrustc
PortGroup builds) turns into a warning. Every task header then held
a dangling vtable pointer; sad 0.4.32 on powerpc-apple-darwin failed
tokio's debug check of the task layout at start-up (the trailer offset
read back as 0x20000 instead of 56):

  thread 'main' panicked at :0:0:
  assertion `left == right` failed
    left: 5252920
   right: 5383936

Generic constant paths now count as constant, subject to the same
interior-mutability check as other constants.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_expand/static_borrow_constants.cpp b/src/hir_expand/static_borrow_constants.cpp
index 1ee7daa1..42b246b0 100644
--- a/src/hir_expand/static_borrow_constants.cpp
+++ b/src/hir_expand/static_borrow_constants.cpp
@@ -396,13 +396,14 @@ namespace static_borrow_constants {
             switch(v.tag())
             {
             case StaticTraitResolve::ValuePtr::TAG_Constant:
-                if( monomorphise_path_needed(node.m_path) ) {
-                    DEBUG("Constant path is still generic, can't transform into a `static`");
-                }
-                else {
-                    m_is_constant = !is_maybe_interior_mut(node);
-                    DEBUG(node.m_path << " m_is_constant=" << m_is_constant);
-                }
+                // A generic constant path is fine too: the promoted `static` then takes the generics, and its value is
+                // evaluated for each instance in Trans_Monomorphise_List (as for a generic function pointer).
+                // - tokio 1.43.0 runtime/task/raw.rs `vtable::<T, S>()` returns `&Vtable { poll: poll::<T, S>, ..,
+                //   trailer_offset: OffsetHelper::<T, S>::TRAILER_OFFSET, .. }`; unpromoted, it was a pointer to the
+                //   callee's stack frame ("Lifetime bound '#local0: 'static failed", only a warning under
+                //   MRUSTC_LIFETIME_ERRORS=warn), and sad 0.4.32 failed tokio's task layout check at run time
+                m_is_constant = !is_maybe_interior_mut(node);
+                DEBUG(node.m_path << " m_is_constant=" << m_is_constant << (monomorphise_path_needed(node.m_path) ? " (generic)" : ""));
                 break;
             case StaticTraitResolve::ValuePtr::TAG_Function:
                 m_is_constant = true;
