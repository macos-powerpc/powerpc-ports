From 3a52b371651d77d3f58187137231fe4684cd6748 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 14:05:53 +0000
Subject: [PATCH] hir_conv: struct/enum const parameter defaults are monomorphised

Found while fixing 0295 (object 0.38.1): Resolve Bind's fix_param_count copied a const parameter default into the
use site as is. A default naming an earlier parameter, `struct S<const N: usize, const M: usize = N>`, then named
whatever parameter 0 was at the use site:
- `pub struct V<const Q: usize>(pub [u16; Q], pub S<3>)` got `S<3, Q>`: V<7> was 24 bytes instead of 20, silently;
- `pub struct U(pub S<2>)` died in MIR Optimise: "Value param N/*I:0*/ out of range for (max 0)".
The default is now monomorphised against the list filled so far, like the type defaults next to it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_conv/bind.cpp b/src/hir_conv/bind.cpp
index cb1838aa..a0bc74e7 100644
--- a/src/hir_conv/bind.cpp
+++ b/src/hir_conv/bind.cpp
@@ -145,7 +145,11 @@ namespace {
                     }
                     else {
                         // TODO: Anything to be worried about with Unevaluated?, it may not have had its params set yet
-                        params.m_values.push_back(val.m_default.clone());
+                        // A default can name an earlier parameter (`struct S<const N: usize, const M: usize = N>`), so it
+                        // is monomorphised like a type default: copied as is, `S<3>` in `struct V<const Q: usize>` got `M = Q`.
+                        MonomorphStatePtr   ms(self_ty, &params, nullptr);
+                        auto v = ms.monomorph_constgeneric(sp, val.m_default, /*allow_infer=*/true);
+                        params.m_values.push_back( mv$(v) );
                     }
                 }
             }
