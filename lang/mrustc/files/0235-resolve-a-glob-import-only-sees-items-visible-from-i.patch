     const RcString& des_item_name,
     ::std::span< const ::AST::Module* > parent_modules,
-    bool types_only = false
+    bool types_only = false,
+    /// A lookup on behalf of a glob import from `source_mod_path`: only items visible from there
+    bool glob_vis = false
     );
 ::AST::Path::Bindings Resolve_Use_GetBinding__ext(const Span& span, const ::AST::Crate& crate, const AST::ExternCrate& ec, const ::HIR::Module& hmodr, const ::AST::Path& path, unsigned int start, AST::AbsolutePath ap={});
 ::AST::Path::Bindings Resolve_Use_GetBinding__ext(const Span& span, const ::AST::Crate& crate, const ::AST::Path& path,  const AST::ExternCrate& ec, unsigned int start);
@@ -438,7 +440,8 @@ void Resolve_Use_Mod(const ::AST::Crate& crate, ::AST::Module& mod, ::AST::Path
         const ::AST::Crate& crate, const ::AST::AbsolutePath& source_mod_path, const ::AST::Module& mod,
         const RcString& des_item_name,
         ::std::span< const ::AST::Module* > parent_modules,
-        bool types_only// = false
+        bool types_only,// = false
+        bool glob_vis// = false
     )
 {
     ::AST::Path::Bindings   rv;
@@ -476,6 +479,14 @@ void Resolve_Use_Mod(const ::AST::Crate& crate, ::AST::Module& mod, ::AST::Path
 
         if( item.name == des_item_name ) {
             auto p = mod.path() + item.name;
+            // A glob only imports what is visible from the importing module: wasmparser 0.244.0 `pub use
+            // crate::readers::*` (readers.rs `pub use self::core::*`, core.rs a private `mod types;`) must not hand the
+            // root readers' `types` ahead of `pub use crate::validator::*`'s `pub mod types` - `use
+            // crate::types::CoreTypeId` in readers/core/types.rs, "Unable to resolve `use` target"
+            if( glob_vis && !item.vis.is_visible(source_mod_path) ) {
+                DEBUG("Ignore item " << item.name << " (" << item.vis << ") not visible from " << source_mod_path << " for a glob");
+                continue ;
+            }
             DEBUG("Matching item: " << item.data.tag_str());
             TU_MATCH_HDRA( (item.data), {)
             TU_ARMA(None, _e) {
@@ -735,7 +746,7 @@ void Resolve_Use_Mod(const ::AST::Crate& crate, ::AST::Module& mod, ::AST::Path
                         if( ::std::find(s_use_glob_mod_stack.begin(), s_use_glob_mod_stack.end(), &*e.module_) == s_use_glob_mod_stack.end() )
                         {
                             s_use_glob_mod_stack.push_back( &*e.module_ );
-                            rv.merge_from( Resolve_Use_GetBinding_Mod(span, crate, mod.path(), *e.module_, des_item_name, {}) );
+                            rv.merge_from( Resolve_Use_GetBinding_Mod(span, crate, mod.path(), *e.module_, des_item_name, {}, /*types_only=*/false, /*glob_vis=*/true) );
                             s_use_glob_mod_stack.pop_back();
                         }
                         else
