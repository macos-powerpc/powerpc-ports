From 0e6906e6e185af633703ff3e5c87edf8c395d42e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 21:43:45 +0000
Subject: [PATCH] hir_typeck: the operand of a unary `!`/`-` takes the result
 type when nothing else gives it one

py314-pydantic_core 2.46.5 src/validators/decimal.rs:148:75 (edition 2024):
    if !decimal.call_method0(intern!(py, "is_finite"))?.extract()? { .. }
= "error:0: Failed to find an impl of FromPyObject<'_, '_> for !". `extract::<T>()` leaves T to inference; rustc checks
the operand of `!` and `-` with the expression's own expectation (the builtin operators keep their type), so the match
`?` desugars to is checked expecting `bool` and its value arm coerces T to `bool`. mrustc's typeck only added the
`<T as Not>::Output == bool` rule, which no impl set resolves backwards (`bool` and `&bool` both give `bool`), so T had
nothing but the never-type fallback: `!` from the `return` arm of that match.

The first pass registers a revisit when the operand's type is unknown; the revisit equates an unknown operand with
a primitive result type and leaves a known operand to the `Not`/`Neg` rule. The revisit printer shows the node.

Assisted-By: Claude Fable 5.1
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 946b4460..9af8e6da 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -200,7 +200,25 @@ namespace {
             no_revisit(node);
         }
         void visit(::HIR::ExprNode_UniOp& node) override {
-            no_revisit(node);
+            const auto& sp = node.span();
+            const auto& res_ty = this->context.get_type(node.m_res_type);
+            const auto& val_ty = this->context.get_type(node.m_value->m_res_type);
+            TRACE_FUNCTION_F(::HIR::ExprNode_UniOp::opname(node.m_op) << " {" << val_ty << "} -> " << res_ty);
+            // rustc checks the operand of `!`/`-` with the expression's own expectation (the builtin operators keep
+            // their type), so `if !obj.call(..)?.extract()? {..}` makes `extract` return `bool`: the `?` match's
+            // value arm is coerced to it (pydantic_core 2.46.5 validators/decimal.rs:148; the other arm is a `return`,
+            // so the type variable had nothing but the never-type fallback, `!` from the 2024 edition). An unknown
+            // operand takes a primitive result type; a known one is the `Not`/`Neg` rule's business.
+            if( !val_ty.data().is_Infer() ) {
+                this->m_completed = true;
+            }
+            else if( res_ty.data().is_Primitive() ) {
+                this->context.equate_types(sp, val_ty, res_ty);
+                this->m_completed = true;
+            }
+            else {
+                // Neither side known yet
+            }
         }
         void visit(::HIR::ExprNode_Borrow& node) override {
             no_revisit(node);
@@ -2010,7 +2028,7 @@ namespace {
             no_revisit(node);
         }
         void visit(::HIR::ExprNode_UniOp& node) override {
-            no_revisit(node);
+            m_os << "_UniOp " << ::HIR::ExprNode_UniOp::opname(node.m_op) << " {" << fmt_res_ty(*node.m_value) << "}";
         }
         void visit(::HIR::ExprNode_Borrow& node) override {
             no_revisit(node);
diff --git a/src/hir_typeck/expr_cs__enum.cpp b/src/hir_typeck/expr_cs__enum.cpp
index 0eec828e..bfc66b7f 100644
--- a/src/hir_typeck/expr_cs__enum.cpp
+++ b/src/hir_typeck/expr_cs__enum.cpp
@@ -1223,6 +1223,10 @@ namespace typecheck
             const auto& op_trait = this->context.m_crate.get_lang_item_path(node.span(), item_name);
             this->context.equate_types_assoc(node.span(), node.m_res_type,  op_trait, ::HIR::PathParams {}, node.m_value->m_res_type.clone(), "Output", {}, true);
             node.m_value->visit( *this );
+            // An unknown operand can take the result type (see the revisit)
+            if( this->context.get_type(node.m_value->m_res_type).data().is_Infer() ) {
+                this->context.add_revisit(node);
+            }
         }
         void visit(::HIR::ExprNode_Borrow& node) override
         {
