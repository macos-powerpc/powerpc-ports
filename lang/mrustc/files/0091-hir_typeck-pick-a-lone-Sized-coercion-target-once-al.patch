From 6f6d1df81dfa851334f315af8512dded9a7cc873 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 6 Oct 2026 19:38:27 +0000
Subject: [PATCH] hir_typeck: pick a lone Sized coercion target once all its bounds failed

check_ivar_poss won't pick an ivar's only target when it came from
an unsize check (the 2019 "work around failure in librustc"), and 4fadb6a1
only exempted Sized generic/opaque targets. For a concrete target the
ivar then stays open until a fallback binds it, e.g. a `*mut _ as *mut U`
cast equating the pointees, to a type the coercion rejects.

nix 0.19/0.23 getpeername (src/sys/socket/mod.rs):

    let mut addr = mem::MaybeUninit::uninit();
    libc::getpeername(fd, addr.as_mut_ptr() as *mut libc::sockaddr, &mut len);
    sockaddr_storage_to_addr(&addr.assume_init(), len as usize)

    error:0: Type mismatch between libc::sockaddr_storage and libc::sockaddr

The cast's bound (`sockaddr`) was already removed because it fails the
`&sockaddr_storage` coercion, leaving the target as the only option. If
the ivar had bounds and all of them were ruled out, no `==` or source
option remains, and the target is Sized (so it can't be an unsize
target), pick it, as rustc's coercion would unify it. Without bounds, or
with any other option left, the old behaviour is kept.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/expr_cs.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 0da29245..416e27f5 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -7774,6 +7774,17 @@ namespace
                         context.equate_types(sp, ty_l, new_ty);
                         return true;
                     }
+                    else if( ivar_ent.has_bounded && !ivar_ent.bounded.empty()
+                        && ::std::none_of(possible_tys.begin(), possible_tys.end(), [](const PossibleType& p){ return p.cls == PossibleType::Equal || p.is_source(); })
+                        && context.m_resolve.type_is_sized(sp, new_ty) == ::HIR::Compare::Equal )
+                    {
+                        // Same for a concrete Sized target, but only once every bounded option was ruled out above: the
+                        // fallback that set those bounds (e.g. `*mut _ as *mut U` equating the pointees) can then only fail.
+                        // - nix 0.23 getpeername: `MaybeUninit::uninit()` cast to `*mut sockaddr`, used as `&sockaddr_storage`
+                        DEBUG("Picking " << new_ty << " as the only target (Sized, all bounds failed) [" << possible_tys << "]");
+                        context.equate_types(sp, ty_l, new_ty);
+                        return true;
+                    }
                     else
                     {
                         // HACK: Work around failure in librustc
