From 07edf780a01eea5be906e035d3c656d9c6adb32d Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 18:27:41 +0000
Subject: [PATCH] macro_rules: an `item` fragment may be a `static mut`

Found while checking the item skimmer for the type-alias where clauses
(0472), no crate reported it:

    macro_rules! item { ($i:item) => { $i }; }
    item!(pub static mut COUNTER: u32 = 0;);
    BUG: src/macro_rules/eval.cpp: TODO: Macro_InvokeRules_MatchPattern
    - No arm matched - (2, 79)

Reference, Static items: StaticItem is `ItemSafety? static mut?
IDENTIFIER : Type ( = Expression )? ;`. consume_item (eval.cpp) went
from `static` straight to the name; it takes the optional `mut` now.
The parser always took it.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index d925c584..0bf3db6d 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -2151,9 +2151,10 @@ namespace
                 return false;
 
             break;
-        // static FOO
+        // static [mut] FOO
         case TOK_RWORD_STATIC:
             lex.consume();
+            lex.consume_if(TOK_RWORD_MUT);
             if( !lex.consume_if(TOK_IDENT) )
                 return false;
             if( !lex.consume_if(TOK_COLON) )
diff --git a/src/version.cpp b/src/version.cpp
index d000022c..24085c03 100644
--- a/src/version.cpp
+++ b/src/version.cpp
@@ -13,7 +13,7 @@
 #define VERSION_PATCH   0
 
 // Number of the last patch in this fork's series: every fix commit bumps it
-#define VERSION_SERIES  485
+#define VERSION_SERIES  486
 // rlibs written by an older series are refused (0 = accept all)
 #define VERSION_SERIES_FLOOR    0
 
