From 9bcc1d7d07290b282ff0206ae35db58b76f81162 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 7 Nov 2026 04:56:48 +0000
Subject: [PATCH] expand: asm! template lines may be expression fragments and macro calls

cmov 0.5.4 (arti 2.8.0 on x86_64) backends/x86.rs:52: `MACRO<cmov>
error:0: Unexpected token TOK_INTERPOLATED_EXPR:"cmovnz {1:e}, {2:e}",
expected TOK_IDENT`.

`cmov!` expands to `asm! { "test {0}, {0}", $instruction, in(reg_byte)
.. }` with the instruction as an `$instruction:expr` fragment in the
second template position. The template loop only went on over raw string
tokens (and `#[cfg]` attributes), so the fragment was read as an operand
keyword. rustc parses every argument before the first operand, `options`
or `clobber_abi` as a template expression: a string literal, a fragment
holding one, or a macro call such as `concat!`.

The loop now also continues over an interpolated expression (`expr` and
`literal` fragments) and an identifier followed by `!`; the line itself
was already parsed as an expression.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/expand/asm.cpp b/src/expand/asm.cpp
index e2063b95..e4dc4b72 100644
--- a/src/expand/asm.cpp
+++ b/src/expand/asm.cpp
@@ -44,6 +44,23 @@ namespace
             return tok.to_str().c_str();
         throw ParseError::Unexpected(lex, tok, TOK_IDENT);
     }
+
+    // rustc reads every argument before the first operand, `options(..)` or `clobber_abi(..)` as another template
+    // line: a string literal, an `expr`/`literal` fragment holding one, or a macro call (`concat!`)
+    bool is_template_line(TokenStream& lex)
+    {
+        switch(lex.lookahead(0))
+        {
+        case TOK_STRING:
+        case TOK_HASH:
+        case TOK_INTERPOLATED_EXPR:
+            return true;
+        case TOK_IDENT:
+            return lex.lookahead(1) == TOK_EXCLAM;
+        default:
+            return false;
+        }
+    }
 }
 
 class CLlvmAsmExpander:
@@ -282,7 +299,7 @@ public:
                 break;
             }
             GET_CHECK_TOK(tok, lex, TOK_COMMA);
-        } while( lex.lookahead(0) == TOK_STRING || lex.lookahead(0) == TOK_HASH );
+        } while( is_template_line(lex) );
 
 
         std::vector<AST::ExprNode_Asm2::Param>  params;
