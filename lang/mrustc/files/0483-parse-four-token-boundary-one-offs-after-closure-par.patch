             if(sym == TOK_DOT) {
+                // Also past whitespace and comments: `tuple. 0.0`, `tuple./*c*/0.0` are tuple indices too
                 auto ch = this->getc();
+                for(;;)
+                {
+                    if( ch.isspace() ) {
+                        ch = this->getc();
+                    }
+                    else if( ch == '/' && m_istream.peek() == '/' ) {
+                        while( ch != '\n' )
+                            ch = this->getc();
+                    }
+                    else if( ch == '/' && m_istream.peek() == '*' ) {
+                        this->getc();
+                        unsigned depth = 1;
+                        Codepoint prev = 0;
+                        while( depth > 0 ) {
+                            ch = this->getc();
+                            if( prev == '/' && ch == '*' ) { depth ++; ch = 0; }
+                            else if( prev == '*' && ch == '/' ) { depth --; ch = 0; }
+                            prev = ch;
+                        }
+                        ch = this->getc();
+                    }
+                    else {
+                        break;
+                    }
+                }
                 this->ungetc();
                 if( ch.isdigit() ) {
                     auto val = this->parseInt(nullptr);
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index e0b79fe4..f72f08e6 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -231,6 +231,12 @@ void Parse_Publicity_Inherited(TokenStream& lex, const char* what)
 // next token can begin a bound
 bool Parse_BoundList_Next(TokenStream& lex)
 {
+    // `T: Clone += ()`: a trailing `+` and the `=` of a default, lexed as one token
+    if( lex.lookahead(0) == TOK_PLUS_EQUAL ) {
+        lex.getToken();
+        lex.putback(Token(TOK_EQUAL));
+        return false;
+    }
     if( !lex.getTokenIf(TOK_PLUS) )
         return false;
     switch( lex.lookahead(0) )
