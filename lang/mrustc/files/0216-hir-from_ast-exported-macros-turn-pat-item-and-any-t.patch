+namespace {
+    /// Collects what `Visitor` sends as mrustc tokens (for `ProcMacro_PatternTokens`/`ProcMacro_ItemTokens`)
+    struct TokenCollector:
+        public TokenSink
+    {
+        ::std::vector<Token>&   out;
+        /// Every identifier gets this hygiene (the names are all `Visitor` has)
+        Ident::Hygiene  hygiene;
+
+        TokenCollector(::std::vector<Token>& out, Ident::Hygiene hygiene):
+            out(out),
+            hygiene(::std::move(hygiene))
+        {
+        }
+
+        void send_symbol(const char* val) override {
+            auto t = Lex_FindOperator(val);
+            ASSERT_BUG(Span(), t != TOK_NULL, "Unknown symbol `" << val << "`");
+            out.push_back(::std::move(t));
+        }
+        void send_rword(const char* val) override {
+            auto t = Lex_FindOperator(val);
+            if( t == TOK_NULL )
+                t = Lex_FindReservedWord(val, AST::Edition::Rust2021);
+            if( t == TOK_NULL )
+                t = Token(TOK_IDENT, Ident(hygiene, RcString::new_interned(val)));
+            out.push_back(::std::move(t));
+        }
+        void send_ident(const char* val) override {
+            out.push_back(Token(TOK_IDENT, Ident(hygiene, RcString::new_interned(val))));
+        }
+        // `::"<crate>"`, as the macro_rules evaluator writes `$crate` naming another crate
+        void send_dollar_crate(const ::std::string& crate_name) override {
+            out.push_back(Token(TOK_DOUBLE_COLON));
+            out.push_back(Token(TOK_STRING, crate_name, hygiene));
+        }
+        void send_lifetime(const char* val) override {
+            out.push_back(Token(TOK_LIFETIME, Ident(hygiene, RcString::new_interned(val))));
+        }
+        void send_string(const ::std::string& s) override {
+            out.push_back(Token(TOK_STRING, s, hygiene));
+        }
+        void send_bytestring(const ::std::string& s) override {
+            out.push_back(Token(TOK_BYTESTRING, s, hygiene));
+        }
+        void send_suffix(const RcString& s) override {
+            if( s.size() > 0 ) {
+                ASSERT_BUG(Span(), !out.empty(), "Literal suffix with no literal");
+                out.back().set_suffix(s);
+            }
+        }
+        void send_char(uint32_t ch) override {
+            out.push_back(Token(U128(ch), CORETYPE_CHAR));
+        }
+        void send_int(eCoreType ct, U128 v) override {
+            out.push_back(Token(v, ct));
+        }
+        void send_float(eCoreType ct, double v) override {
+            out.push_back(Token::make_float(v, ct));
+        }
+        // Sent anyway: `emit_all_attrs` (and nothing gets marked used)
+        bool attr_is_used(const RcString& n) const override {
+            return false;
+        }
+    };
+}
+::std::vector<Token> ProcMacro_PatternTokens(const Span& sp, const AST::Pattern& pat, const Ident::Hygiene& hygiene)
+{
+    ::std::vector<Token>    rv;
+    TokenCollector  tc(rv, hygiene);
+    Visitor v(sp, tc);
+    v.emit_all_attrs = true;
+    v.raw_cfg_attr = true;
+    v.visit_pattern(pat);
+    return rv;
+}
+::std::vector<Token> ProcMacro_TypeTokens(const Span& sp, const TypeRef& ty, const Ident::Hygiene& hygiene)
+{
+    ::std::vector<Token>    rv;
+    TokenCollector  tc(rv, hygiene);
+    Visitor v(sp, tc);
+    v.visit_type(ty);
+    return rv;
+}
+::std::vector<Token> ProcMacro_ItemTokens(const Span& sp, const AST::Named<AST::Item>& item, const Ident::Hygiene& hygiene)
+{
+    ::std::vector<Token>    rv;
+    TokenCollector  tc(rv, hygiene);
+    Visitor v(sp, tc);
+    v.emit_all_attrs = true;
+    v.raw_cfg_attr = true;
+    v.visit_named_item(item);
+    return rv;
+}
