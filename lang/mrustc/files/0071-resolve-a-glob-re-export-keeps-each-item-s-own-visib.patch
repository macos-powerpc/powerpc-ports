diff --git a/src/resolve/common.cpp b/src/resolve/common.cpp
index 7f1ddbb0..f0df3398 100644
--- a/src/resolve/common.cpp
+++ b/src/resolve/common.cpp
@@ -804,21 +804,32 @@ namespace {
                     DEBUG("Found `" << item_name << "` in HIR namespace");
                     const HIR::TypeItem*    ti;
                     if(const auto* p = it->second->ent.opt_Import()) {
-                        if(out_path) {
-                            *out_path = sp_to_ap(p->path);
-                        }
-                        const auto& ext_crate = H::get_crate(sp, crate, p->path);
-                        if( p->path.components().empty() ) {
-                            return ResolveItemRef_Type(&ext_crate);
+                        // Follow the import, and any import it leads to: a glob re-export of a re-export
+                        // (or of a `pub extern crate`) records the intermediate path, not the final item
+                        const HIR::SimplePath*  path = &p->path;
+                        for(;;)
+                        {
+                            if(out_path) {
+                                *out_path = sp_to_ap(*path);
+                            }
+                            const auto& ext_crate = H::get_crate(sp, crate, *path);
+                            if( path->components().empty() ) {
+                                return ResolveItemRef_Type(&ext_crate);
+                            }
+                            ti = &ext_crate.get_typeitem_by_path(sp, *path, true);
+                            const auto* p2 = ti->opt_Import();
+                            if( !p2 ) {
+                                break;
+                            }
+                            DEBUG("Following namespace import `" << *path << "` -> `" << p2->path << "`");
+                            path = &p2->path;
                         }
-                        ti = &ext_crate.get_typeitem_by_path(sp, p->path, true);
                     }
                     else {
                         if(out_path)
                             out_path->nodes.push_back(item_name);
                         ti = &it->second->ent;
                     }
-                    ASSERT_BUG(sp, !ti->is_Import(), "Recursive namespace import in HIR: " << it->second->ent.as_Import().path << " pointed to " << ti->as_Import().path);
                     return ResolveItemRef_Type(ti);
                 }
                 } break;
@@ -828,17 +839,27 @@ namespace {
                     DEBUG("Found `" << item_name << "` in HIR value");
                     const HIR::ValueItem*    vi;
                     if(const auto* p = it->second->ent.opt_Import()) {
-                        if(out_path) {
-                            *out_path = sp_to_ap(p->path);
+                        // Follow a chain of imports (see the namespace case above)
+                        const HIR::SimplePath*  path = &p->path;
+                        for(;;)
+                        {
+                            if(out_path) {
+                                *out_path = sp_to_ap(*path);
+                            }
+                            vi = &H::get_crate(sp, crate, *path).get_valitem_by_path(sp, *path, true);
+                            const auto* p2 = vi->opt_Import();
+                            if( !p2 ) {
+                                break;
+                            }
+                            DEBUG("Following value import `" << *path << "` -> `" << p2->path << "`");
+                            path = &p2->path;
                         }
-                        vi = &H::get_crate(sp, crate, p->path).get_valitem_by_path(sp, p->path, true);
                     }
                     else {
                         if(out_path)
                             out_path->nodes.push_back(item_name);
                         vi = &it->second->ent;
                     }
-                    ASSERT_BUG(sp, !vi->is_Import(), "Recursive value import in HIR: " << it->second->ent.as_Import().path << " pointed to " << vi->as_Import().path);
                     return ResolveItemRef_Value(vi);
                 }
                 } break;
