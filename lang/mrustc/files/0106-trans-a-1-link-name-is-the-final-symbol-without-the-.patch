From 75038576385211751734c75b01da6a394258027b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 07:55:24 +0000
Subject: [PATCH 106/107] trans: a `\1` link name is the final symbol, without
 the Apple underscore

aws-lc-sys 0.45.0 (aws-lc-rs, rustls 0.23's default provider) pregenerated
bindings, all ~1040 fns:

    #[link_name = "\u{1}_aws_lc_0_45_0_AES_encrypt"]   // Apple
    #[link_name = "\u{1}aws_lc_0_45_0_AES_encrypt"]    // other targets

For LLVM a leading \1 means "use this symbol as is". Extern fn declarations
passed the \1 into the asm label, so the C had
`asm("_\x01_aws_lc_0_45_0_AES_encrypt")` and the assembler rejected it
("junk at end of line"). Extern statics stripped the \1 but then still
added the Apple `_`, giving `__name`. Every aws-lc-sys binding file uses
this form, so aws-lc-sys could not build with mrustc on any target.

Both now go through get_asm_symbol_name. A \1 name loses the \1 and is
otherwise used verbatim. Other names get `_` on Apple targets, as before.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/trans/codegen_c.cpp | 25 ++++++++++++++++---------
 1 file changed, 16 insertions(+), 9 deletions(-)

diff --git a/src/trans/codegen_c.cpp b/src/trans/codegen_c.cpp
index b59c3eec..1eef1dfa 100644
--- a/src/trans/codegen_c.cpp
+++ b/src/trans/codegen_c.cpp
@@ -221,6 +221,19 @@ namespace {
         return rv;
     }
 
+    // Assembler symbol for an `asm("...")` label naming an extern item.
+    // LLVM treats a leading \1 as "this is the final symbol, add no platform prefix" (bindgen emits it, e.g.
+    // aws-lc-sys `\u{1}_aws_lc_0_45_0_AES_encrypt` on Apple), so strip it and use the rest verbatim. Otherwise Apple
+    // targets (not only macOS) prefix `_`.
+    ::std::string get_asm_symbol_name(const ::std::string& linkage_name)
+    {
+        if( !linkage_name.empty() && linkage_name[0] == '\1' )
+            return linkage_name.substr(1);
+        if( Target_GetCurSpec().m_os_name == "macos" )
+            return "_" + linkage_name;
+        return linkage_name;
+    }
+
     enum class AtomicOp
     {
         Add,
@@ -2691,7 +2704,7 @@ namespace {
             auto type = params.monomorph(m_resolve, item.m_type);
 
             // LLVM supports prepending a symbol name with \1 to prevent further mangling.
-            // Since we're targeting C, not LLVM, strip off this prefix.
+            // Since we're targeting C, not LLVM, strip off this prefix (the asm label below uses `get_asm_symbol_name`).
             std::string linkage_name = item.m_linkage.name;
             if( !linkage_name.empty() && linkage_name[0] == '\1' ) {
                 linkage_name = linkage_name.substr(1);
@@ -2737,10 +2750,7 @@ namespace {
             emit_static_ty(type, p, /*is_proto=*/true);
             if( linkage_name != "" && m_compiler == Compiler::Gcc)
             {
-                if (Target_GetCurSpec().m_os_name == "macos") // Not macOS only, but all Apple platforms.
-                    m_of << " asm(\"_" << linkage_name << "\")";
-                else
-                    m_of << " asm(\"" << linkage_name << "\")";
+                m_of << " asm(\"" << get_asm_symbol_name(item.m_linkage.name) << "\")";
             }
             m_of << ";";
             m_of << "\t// static " << p << " : " << type;
@@ -3149,10 +3159,7 @@ namespace {
                 switch(m_compiler)
                 {
                 case Compiler::Gcc:
-                    if (Target_GetCurSpec().m_os_name == "macos") // Not macOS only, but all Apple platforms.
-                        m_of << " asm(\"_" << item.m_linkage.name << "\")";
-                    else
-                        m_of << " asm(\"" << item.m_linkage.name << "\")";
+                    m_of << " asm(\"" << get_asm_symbol_name(item.m_linkage.name) << "\")";
                     break;
                 case Compiler::Msvc:
                     break;
