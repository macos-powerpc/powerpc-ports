From fc7c25673437ce9f5c4e5cfbf0398c4fde605d07 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 17 Oct 2026 15:17:50 +0000
Subject: [PATCH 300/300] ast: print every `super` of a path

Found writing arm-attr-pm-test: AST::Path's printer wrote `super::super::K`
as `super::K` (one `super` whatever the count). DumpAST_Node output (function
bodies) feeds attribute proc macros, so a body naming `super::super::X` inside
an attribute-macro'd module came back naming the wrong module ("Unable to
resolve `use` target crate::body::K"). Signatures and module items go through
the proc-macro visitor's own visit_path, which already sent them all.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/ast/path.cpp b/src/ast/path.cpp
index 4048a059..504caeba 100644
--- a/src/ast/path.cpp
+++ b/src/ast/path.cpp
@@ -427,7 +427,12 @@ void Path::print_pretty(::std::ostream& os, bool is_type_context, bool is_debug)
         }
         }
     TU_ARMA(Super, ent) {
-        os << "super";
+        // Every `super` of the path: this text is re-lexed as an attribute proc macro's input (DumpAST_Node prints
+        // function bodies), where `super::super::K` written as `super::K` names the wrong module
+        for(unsigned i = 0; i < ent.count; i ++)
+        {
+            os << (i > 0 ? "::super" : "super");
+        }
         for(const auto& n : ent.nodes)
         {
             os << "::";
