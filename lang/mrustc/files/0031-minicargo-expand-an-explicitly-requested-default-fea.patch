From 12c9cc823ab0368bfd3576e76e023d6c66a2c28d Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 2 Oct 2026 07:58:42 +0000
Subject: [PATCH 31/31] minicargo: expand an explicitly requested `default`
 feature

`default` is stored separately from the named features, so when it was
requested by name - a parent's `dep/default` on a dependency declared
with `default-features = false`, or `--features default` - it was marked
active (and emitted as `--cfg feature="default"`) but its sub-features
were never activated.

Hit by ab_glyph 0.2.x -> ab_glyph_rasterizer 0.1.10 (mdcat):
    ab_glyph_rasterizer = { version = "0.1.2", default-features = false }
    std = ["ab_glyph_rasterizer/default", ...]
ab_glyph_rasterizer got `feature="default"` but not `feature="std"` and
failed on its
    compile_error!("You need to activate either the `std` or `libm` feature.")

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 tools/minicargo/manifest.cpp | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/tools/minicargo/manifest.cpp b/tools/minicargo/manifest.cpp
index f9d8be64..66d5df1c 100644
--- a/tools/minicargo/manifest.cpp
+++ b/tools/minicargo/manifest.cpp
@@ -1307,11 +1307,20 @@ void PackageManifest::set_features(const ::std::vector<::std::string>& features,
         };
 
         // Look up this feature
+        // NOTE: `default` is stored separately, but can be requested by name (a parent crate's
+        // `dep/default` with `default-features = false`, or `--features default`) - expand it too
+        const ::std::vector<::std::string>* feat_list = nullptr;
         auto it = m_features.find(featname);
-        if( it != m_features.end() )
+        if( it != m_features.end() ) {
+            feat_list = &it->second;
+        }
+        else if( featname == "default" ) {
+            feat_list = &m_default_features;
+        }
+        if( feat_list )
         {
-            DEBUG("Activating feature " << featname << " = [" << it->second << "]");
-            for(const auto& sub_feat : it->second)
+            DEBUG("Activating feature " << featname << " = [" << *feat_list << "]");
+            for(const auto& sub_feat : *feat_list)
             {
                 auto slash_pos = sub_feat.find('/');
                 if( slash_pos != ::std::string::npos ) {
