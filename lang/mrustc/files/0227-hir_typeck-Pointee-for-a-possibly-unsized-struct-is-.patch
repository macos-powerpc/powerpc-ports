From 8108a99e604735f6125b1c259065b689b0a91466 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 11 Oct 2026 15:00:10 +0000
Subject: [PATCH] hir_typeck: Pointee for a possibly-unsized struct is its
 unsized param's

find_trait_impls_magic's `Pointee` arm had a TODO for a struct whose last
field may be unsized (`DstType::Possible`). Since 1.90, `ptr::null_mut`
needs `T: ?Sized + Thin`, so any `null_mut()` of such a struct reached it.
backtrace 0.3.72 lib.rs:152 (yj 1.2.4):

    static mut LOCK: *mut Mutex<()> = ptr::null_mut();

    BUG: src/hir_typeck/helpers.cpp:1537: TODO: find_trait_impls_magic -
    m_lang_Pointee - ::"std-0_0_0"::sync::poison::mutex::Mutex<(),>

Such a struct now has the metadata of the param that decides it, through
any nesting, as StaticTraitResolve already does (static.cpp). An unresolved
param gives a fuzzy match, like a top-level ivar.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_typeck/helpers.cpp | 30 +++++++++++++++++++++---------
 1 file changed, 21 insertions(+), 9 deletions(-)

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index 572dadb8..29358661 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -1498,14 +1498,26 @@ bool TraitResolution::find_trait_impls_magic(const Span& sp,
         static auto name_Metadata = RcString::new_interned("Metadata");
         // TODO: This logic is near identical to the logic in `static.cpp` - can it be de-duplicated?
 
+        // A struct whose last field may be unsized has the metadata of the param that decides it (as in static.cpp):
+        // `static mut LOCK: *mut Mutex<()> = ptr::null_mut();` needs `Mutex<()>: Thin` - backtrace 0.3.72 lib.rs:152
+        const auto* meta_src = &type;
+        while( meta_src->data().is_Path() && meta_src->data().as_Path().binding.is_Struct()
+            && meta_src->data().as_Path().binding.as_Struct()->m_struct_markings.dst_type == HIR::StructMarkings::DstType::Possible )
+        {
+            const auto& str = *meta_src->data().as_Path().binding.as_Struct();
+            meta_src = &this->m_ivars.get_type(meta_src->data().as_Path().path.m_data.as_Generic().m_params.m_types.at(str.m_struct_markings.unsized_param));
+            DEBUG("Metadata from the unsized param: " << *meta_src);
+        }
+        const auto& inner = *meta_src;
+
         HIR::TypeRef    meta_ty;
-        if( type.data().is_Infer() || (type.data().is_Path() && type.data().as_Path().binding.is_Unbound()) ) {
+        if( inner.data().is_Infer() || (inner.data().is_Path() && inner.data().as_Path().binding.is_Unbound()) ) {
             return callback( ImplRef(type.clone(), HIR::PathParams(), ::HIR::TraitPath::assoc_list_t()), ::HIR::Compare::Fuzzy );
         }
         // Generics (or opaque ATYs)
-        else if( type.data().is_Generic() || (type.data().is_Path() && type.data().as_Path().binding.is_Opaque()) ) {
+        else if( inner.data().is_Generic() || (inner.data().is_Path() && inner.data().as_Path().binding.is_Opaque()) ) {
             // If the type is `Sized` return `()` as the type
-            if( type_is_sized(sp, type) != HIR::Compare::Unequal ) {
+            if( type_is_sized(sp, inner) != HIR::Compare::Unequal ) {
                 meta_ty = HIR::TypeRef::new_unit();
             }
             else {
@@ -1514,27 +1526,27 @@ bool TraitResolution::find_trait_impls_magic(const Span& sp,
             }
         }
         // Trait object: `Metadata=DynMetadata<T>`
-        else if( type.data().is_TraitObject() ) {
+        else if( inner.data().is_TraitObject() ) {
             meta_ty = ::HIR::TypeRef::new_path(
-                ::HIR::GenericPath(this->m_crate.get_lang_item_path(sp, "dyn_metadata"), HIR::PathParams(type.clone())),
+                ::HIR::GenericPath(this->m_crate.get_lang_item_path(sp, "dyn_metadata"), HIR::PathParams(inner.clone())),
                 &m_crate.get_struct_by_path(sp, this->m_crate.get_lang_item_path(sp, "dyn_metadata"))
                 );
         }
         // Slice and str
-        else if( type.data().is_Slice() || TU_TEST1(type.data(), Primitive, == HIR::CoreType::Str) ) {
+        else if( inner.data().is_Slice() || TU_TEST1(inner.data(), Primitive, == HIR::CoreType::Str) ) {
             meta_ty = HIR::CoreType::Usize;
         }
         // Structs: Can delegate their metadata
-        else if( type.data().is_Path() && type.data().as_Path().binding.is_Struct() )
+        else if( inner.data().is_Path() && inner.data().as_Path().binding.is_Struct() )
         {
-            const auto& str = *type.data().as_Path().binding.as_Struct();
+            const auto& str = *inner.data().as_Path().binding.as_Struct();
             switch(str.m_struct_markings.dst_type)
             {
             case HIR::StructMarkings::DstType::None:
                 meta_ty = HIR::TypeRef::new_unit();
                 break;
             case HIR::StructMarkings::DstType::Possible:
-                TODO(sp, "m_lang_Pointee - " << type);
+                BUG(sp, "m_lang_Pointee - " << inner << " not unwrapped");
             case HIR::StructMarkings::DstType::Slice:
                 meta_ty = HIR::CoreType::Usize;
                 break;
