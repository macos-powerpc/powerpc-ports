From 8ac7e35672f10d99a8d7e75b24e60c81a396a6e4 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 7 Oct 2026 12:05:29 +0000
Subject: [PATCH] hir_conv: Resolve UFCS sets a type alias's generics as impl
 generics

tokio 1.43.0 (sad 0.4.32) runtime/task/list.rs:64:

    type List<S> = sharded_list::ShardedList<Task<S>, <Task<S> as Link>::Target>;
    unsafe impl<S> linked_list::Link for Task<S> { .. }

A type alias's parameters are impl-level (`S/*I:0*/`), but Resolve UFCS
registered them as item generics. Expanding `<Task<S> as Link>::Target`
checks the impl's implicit `S: Sized`, metadata_type looked `S/*I:0*/` up
in the impl generics and found none: "BUG: ASSERT FAIL:
src/hir_typeck/static.cpp:3113:m_impl_generics: Encountered generic
S/*I:0*/ without impl generics available". (Bound lookups worked either
way, which is all the 1.90 libcore case that re-enabled this needed.)

Use set_impl_generics, as lifetime elision and the generic HIR visitor do
for type aliases.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/hir_conv/resolve_ufcs.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/hir_conv/resolve_ufcs.cpp b/src/hir_conv/resolve_ufcs.cpp
index cd355943..b2f98142 100644
--- a/src/hir_conv/resolve_ufcs.cpp
+++ b/src/hir_conv/resolve_ufcs.cpp
@@ -123,7 +123,10 @@ namespace resolve_ufcs {
         void visit_type_alias(::HIR::ItemPath p, ::HIR::TypeAlias& item) override {
             // NOTE: Disabled, because generics in type aliases are never checked
             // Re-enabled to resolve a UFCS properly (1.90.0 libcore)
-            auto _ = m_resolve.set_item_generics(item.m_params);
+            // A type alias's parameters are impl-level (`I:n`), as in the other passes: as item generics, an impl's
+            // implicit `Sized` bound checked on one found nothing.
+            // - tokio 1.43.0: `type List<S> = ShardedList<Task<S>, <Task<S> as Link>::Target>;`
+            auto _ = m_resolve.set_impl_generics(MetadataType::Unknown, item.m_params);
             ::HIR::Visitor::visit_type_alias(p, item);
         }
         void visit_trait(::HIR::ItemPath p, ::HIR::Trait& trait) override {
