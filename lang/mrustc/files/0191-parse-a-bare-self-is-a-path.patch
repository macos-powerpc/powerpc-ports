From 32375774393e5492503148853ebd168da763b470 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 13:50:29 +0000
Subject: [PATCH] parse: a bare `self` is a path

Parse_Path required `::` after `self`.  A `$x:path` macro fragment can be
a bare `self` (rustc accepts it), and the fragment's token stream ends
right after it: ast-grep-language 0.45.3 (ast-grep 0.45.3) lib.rs:474
`execute_lang_method! { self, pre_process_pattern, query }` with the
matcher `($me: path, $method: ident, ..)` died with "Unexpected token
TOK_EOF, expected TOK_DOUBLE_COLON".

`self` not followed by `::` now yields the value path the expression
parser builds for it.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/parse/paths.cpp b/src/parse/paths.cpp
index 68b00e83..4cb53864 100644
--- a/src/parse/paths.cpp
+++ b/src/parse/paths.cpp
@@ -32,6 +32,13 @@ AST::Path Parse_Path(TokenStream& lex, eParsePathGenericMode generic_mode)
         return mv$(tok.frag_type().path());
 
     case TOK_RWORD_SELF:
+        // A bare `self` is a path too (the value, as the expression parser makes it): rustc accepts it for
+        // a `$x:path` fragment - ast-grep-language 0.45.3 `execute_lang_method!{ self, .. }` with `($me: path, ..)`
+        // (ast-grep); the fragment's token stream ends after it, "Unexpected token TOK_EOF, expected TOK_DOUBLE_COLON"
+        if( LOOK_AHEAD(lex) != TOK_DOUBLE_COLON ) {
+            static const RcString rcstring_self = RcString::new_interned("self");
+            return AST::Path(rcstring_self);
+        }
         GET_CHECK_TOK(tok, lex, TOK_DOUBLE_COLON);
         return AST::Path::new_self(Parse_PathNodes(lex, generic_mode));
 
