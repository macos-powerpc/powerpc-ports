From 99177ff8d092a3e1a3b2cf18c269889dea1866f2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 07:49:25 +0000
Subject: [PATCH 323/324] hir_conv: the types inside a `{ expr }` const generic
 argument of a path in a fn body get their aliases and `Self` expanded

cryptography 48.0.0 src/rust/src/oid.rs:21 (and 22 more constructors):

    pub(crate) type CryptographyResult<T> = Result<T, CryptographyError>;
    #[pyo3::pymethods]
    impl ObjectIdentifier {
        #[new]
        fn new(value: &str) -> CryptographyResult<Self> { .. }
    }

    <null> BUG: src/hir_conv/bind.cpp:458: TypeAlias encountered after `Resolve Type Aliases`
      - ::"cryptography_rust-0_1_0"::error::CryptographyResult<Self/**/,>/*?*/

pyo3 0.28's `#[new]` wrapper ends in

    tp_new_impl::<_, { IsPyClass::<#output>::VALUE }, { IsInitializerTuple::<#output>::VALUE }>(py, result, _slf)

with `#output` the constructor's return type as written. The expression
visitors of "Resolve Type Aliases" (Expander) and "Resolve HIR Self Type"
(Expander_Self) reached the types of an expression's paths through
ExprVisitorDef::visit_path_params, which visits only the type arguments;
the only const-argument expression they descended into was an array
size (`[T; { .. }]`). The alias (and the `Self`) inside the braces
survived to Resolve Bind, which asserts on it.

Both inner visitors now override visit_path_params and visit the
expression of every Unevaluated const argument, as they do for array
sizes (the other passes - Resolve Bind, Resolve UFCS, Constant Evaluate -
already walked those expressions).

Assisted-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir_conv/expand_type.cpp b/src/hir_conv/expand_type.cpp
index acab896c..d06db86c 100644
--- a/src/hir_conv/expand_type.cpp
+++ b/src/hir_conv/expand_type.cpp
@@ -590,6 +590,20 @@ public:
                 }
                 ::HIR::ExprVisitorDef::visit(node);
             }
+            // A `{ expr }` const generic argument of a path in an expression holds types too (ExprVisitorDef only visits
+            // the type arguments): pyo3 0.28's `#[new]` wrapper `tp_new_impl::<_, { IsPyClass::<CryptographyResult<Self>>::VALUE },
+            // ..>(py, result, _slf)` reached Resolve Bind with the alias (and `Self`) intact (cryptography 48.0.0 oid.rs:21)
+            void visit_path_params(::HIR::PathParams& pp) override
+            {
+                ::HIR::ExprVisitorDef::visit_path_params(pp);
+                for(auto& v : pp.m_values)
+                {
+                    if( v.is_Unevaluated() )
+                    {
+                        upper_visitor.visit_expr(*v.as_Unevaluated()->expr);
+                    }
+                }
+            }
         };
 
         if( expr.get() != nullptr )
@@ -714,6 +728,20 @@ public:
                 }
                 ::HIR::ExprVisitorDef::visit(node);
             }
+            // A `{ expr }` const generic argument of a path in an expression holds types too (ExprVisitorDef only visits
+            // the type arguments): pyo3 0.28's `#[new]` wrapper `tp_new_impl::<_, { IsPyClass::<CryptographyResult<Self>>::VALUE },
+            // ..>(py, result, _slf)` reached Resolve Bind with the alias (and `Self`) intact (cryptography 48.0.0 oid.rs:21)
+            void visit_path_params(::HIR::PathParams& pp) override
+            {
+                ::HIR::ExprVisitorDef::visit_path_params(pp);
+                for(auto& v : pp.m_values)
+                {
+                    if( v.is_Unevaluated() )
+                    {
+                        upper_visitor.visit_expr(*v.as_Unevaluated()->expr);
+                    }
+                }
+            }
         };
 
         if( expr.get() != nullptr )
