From 73d5ca2a66d6f8f90f8bc0aa7890c3f4bb38055e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 6 Nov 2026 06:05:57 +0000
Subject: [PATCH] expand: a `$v:vis` fragment forwarded to a proc macro is sent
 as an invisible group

tor-linkspec 0.47.0 (arti 2.7.0) ids/by_id.rs:10: `MACRO<::tor_basic_utils::
n_key_list> BUG: src/expand/proc_macro.cpp:669: TODO: visit_token_inner -
TOK_INTERPOLATED_...`.

tor-basic-utils 0.47.0 n_key_list.rs takes `$vis:vis struct $mapname ..` and
expands to `paste!{ $vis struct $mapname .. impl .. { $vis fn new() .. } }`.
paste is a function-like proc macro, so the invocation's token tree carries
the visibility as a TOK_INTERPOLATED_VIS token, and the serialiser's
visit_token_inner had no arm for it (the `$i:item` arm came in 0304).

rustc hands a forwarded `$v:vis` over as a `Delimiter::None` group of its
tokens, empty for a private one (syn's Visibility::parse reads that as
inherited). The serialiser now does the same; the reader already drops the
group markers on the way back.

Assisted-by: Claude Fable 5.1
---

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 18e0669e..a7add828 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -665,8 +665,15 @@ namespace {
                 visit_named_item(named);
                 m_pmi.send_none_group_close();
                 } break;
-            case TOK_INTERPOLATED_VIS:
-                TODO(sp, "TOK_INTERPOLATED_...");
+            // A visibility fragment (`$v:vis`) forwarded to a proc macro: an invisible group of its tokens, empty for
+            // a private one (rustc: an empty `Delimiter::None` group, which syn's Visibility::parse reads as inherited)
+            // - tor-basic-utils 0.47.0 n_key_list.rs:121 `paste!{ $vis struct $mapname .. { $vis fn new() -> Self .. } }`
+            case TOK_INTERPOLATED_VIS: {
+                auto vis = tok.clone().take_frag_vis();
+                m_pmi.send_none_group_open();
+                this->visit_vis(vis);
+                m_pmi.send_none_group_close();
+                } break;
             // Value tokens
             case TOK_IDENT:     m_pmi.send_ident(tok.ident().name.c_str());   break;  // TODO: Raw idents
             case TOK_LIFETIME:  m_pmi.send_lifetime(tok.ident().name.c_str());  break;  // TODO: Hygine?
