From 29e07c4443aaba7e9ed96fa8f183a350c570a699 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 12:09:00 +0000
Subject: [PATCH] parse: an extern block takes an `$item:item` fragment from a macro
 expanded inside it

ring 0.17.14 (tombi 1.8.4), src/prefixed.rs through aead/aes/fallback.rs:25
`set_encrypt_key!`:

    MACRO<..::prefixed_item> error:0: Unexpected token
    TOK_INTERPOLATED_ITEM:Function(aes_nohw_set_encrypt_key), expected one
    of TOK_RWORD_FN or TOK_RWORD_STATIC or TOK_RWORD_TYPE

`prefixed_extern! { fn $name(..) -> ..; }` expands to `extern "C" {
prefixed_item! { link_name $name { $vis fn $name(..) -> ..; } } }`, and
`prefixed_item!` hands the block `#[link_name = concat!(prefix!(),
stringify!($name))] $item` with `$item:item`. Parse_ExternBlock_Item
(also what Expand_ExternBlock parses a macro's output with) only took the
`fn`, `static` and `type` keywords.

An interpolated bodiless fn now becomes the foreign prototype as the
keyword path makes it (the block's ABI, unsafe to call, the implicit
return flag carried over), an interpolated static the foreign static;
the attributes written before the fragment join the item's own. A fn
with a body, a const, or any other item kind is an error.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 3afddc9c..86c1c1fa 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1507,6 +1507,37 @@ AST::Named<AST::Item> Parse_ExternBlock_Item(TokenStream& lex, const std::string
     auto meta_items = Parse_ItemAttrs(lex);
     SET_ATTRS(lex, meta_items);
 
+    // An `$item:item` fragment handed back by a macro expanded inside the block: ring 0.17.14 prefixed.rs
+    // `prefixed_item! { link_name $name { $vis fn $name(..) -> ..; } }` in `extern "C" { .. }` (tombi 1.8.4). A bodiless
+    // fn becomes the foreign prototype the keyword path makes (the block's ABI, unsafe to call), a static the
+    // foreign static; the attributes written before the fragment join the item's own.
+    if( lex.lookahead(0) == TOK_INTERPOLATED_ITEM )
+    {
+        GET_TOK(tok, lex);
+        auto item = tok.take_frag_item();
+        for(auto& mi : meta_items.m_items)
+            item.attrs.m_items.push_back( mv$(mi) );
+        TU_MATCH_HDRA( (item.data), {)
+        default:
+            ERROR(item.span, E0000, "Unexpected " << item.data.tag_str() << " item in an extern block (from a macro)");
+        TU_ARMA(Function, e) {
+            if( e.code().is_valid() ) {
+                ERROR(item.span, E0000, "Function with a body in an extern block (from a macro)");
+            }
+            auto fcn = ::AST::Function( e.sp(), abi, AST::Function::Flags::make_unsafe(), mv$(e.params()), mv$(e.rettype()), mv$(e.args()), e.is_variadic() );
+            fcn.set_ret_implicit(e.is_ret_implicit());
+            return AST::Named<AST::Item> { item.span, mv$(item.attrs), item.vis, item.name, ::AST::Item( mv$(fcn) ) };
+            }
+        TU_ARMA(Static, e) {
+            if( e.s_class() == ::AST::Static::CONST ) {
+                ERROR(item.span, E0000, "`const` item in an extern block (from a macro)");
+            }
+            auto st = ::AST::Static( e.s_class(), e.type().clone(), ::AST::Expr() );
+            return AST::Named<AST::Item> { item.span, mv$(item.attrs), item.vis, item.name, ::AST::Item( mv$(st) ) };
+            }
+        }
+    }
+
     auto ps = lex.start_span();
 
     {
