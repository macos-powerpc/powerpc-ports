From 288e8868b39eff8ff85f792647b72c7138f268e2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 18 Oct 2026 03:38:15 +0000
Subject: [PATCH] hir_typeck: a cast to a fn pointer from a type not known yet
 waits for it

pyo3 0.28.3 (py-cryptography 48.0.0, py314-qh3 2.0.4)
src/pyclass/create_type_object.rs:694:

    let (get, set, closure): (Option<ffi::getter>, Option<ffi::setter>, *mut c_void) =
        match self {
            &Self::Getter(closure) => {
                ..
                (Some(getter), None, closure as Getter as _)
            } ..

    create_type_object.rs:694:63 error:0: Invalid cast [fcn src]:
    from _/*6*/
     to  unsafe extern "Rust" fn(Python<'H0>, *mut PyObject) -> Result<*mut PyObject, PyErr>

`closure` (a pattern binding) had no type yet when the cast was first
looked at, and a fn-pointer target took any source it didn't know as
an invalid cast. Like the pointer target, it now waits while the source is
an ivar, and in fallback takes it as the fn pointer itself (the trivial cast);
an integer literal is still an error.

Assisted-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/hir_typeck/expr_cs.cpp b/src/hir_typeck/expr_cs.cpp
index 37d1e76d..7c70ab1f 100644
--- a/src/hir_typeck/expr_cs.cpp
+++ b/src/hir_typeck/expr_cs.cpp
@@ -456,6 +456,21 @@ namespace {
                 TU_MATCH_HDRA( (src_ty.data()), {)
                 default:
                     bad_cast(sp, src_ty, tgt_ty, "fcn src");
+                // Not known yet: wait, and in fallback take it as the fn pointer itself (the trivial cast). The binding of
+                // a pattern typed later - pyo3 0.28.3 create_type_object.rs:694 `match self { &Self::Getter(closure) =>
+                // (Some(getter), None, closure as Getter as _) .. }` was "Invalid cast [fcn src]: from _ to unsafe fn(..)"
+                TU_ARMA(Infer, s_e) {
+                    if( s_e.is_lit() ) {
+                        bad_cast(sp, src_ty, tgt_ty, "fcn src");
+                    }
+                    else if( this->m_is_fallback ) {
+                        this->context.equate_types(sp, tgt_ty, src_ty);
+                        this->m_completed = true;
+                    }
+                    else {
+                        DEBUG("- Source type is still _");
+                    }
+                    }
                 TU_ARMA(NodeType, s_e) {
                     if(const auto*const* sn_pp = s_e.opt_Closure()) {
                         auto pp = e.hrls.make_empty_params(true);
