From d21793c34d0fc38c1ea363c4f052ea01aed2969a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 18:06:24 +0000
Subject: [PATCH] parse: a const generic parameter's default may be a negative
 literal

rust-analyzer parser test_data inline/ok/const_param_default_literal.rs
(no tests/ui pass test has it), parse-only run:

    struct A<const N: i32 = -1>;
    error: Unexpected token TOK_DASH

Reference, Generic parameters: ConstParam is `const IDENTIFIER : Type
( = Block | IDENTIFIER | -? LiteralExpression )?`; the `-?` before the
literal is part of the production (unambiguous: a default is followed
only by `,` or `>`).

Parse_GenericParams took a block or Parse_ExprVal (no unary minus).
A default starting with `-` is now read by Parse_Expr13, as the generic
argument list already reads `-1` in `S<-1>`; lowering and const
evaluation take the negation like any other const expression.

Grammar copies: the macro_rules skimmer reads generics as an angle
token tree; the proc-macro visitor and ast/dump print the default
expression.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index f72f08e6..f08bae18 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -415,6 +415,10 @@ AST::GenericParams Parse_GenericParams(TokenStream& lex)
                 if( lex.lookahead(0) == TOK_BRACE_OPEN ) {
                     val = Parse_ExprBlock(lex);
                 }
+                // `-? LiteralExpression`: a negative literal (`const N: i32 = -1`)
+                else if( lex.lookahead(0) == TOK_DASH ) {
+                    val = AST::Expr(Parse_Expr13(lex));
+                }
                 else {
                     val = Parse_ExprVal(lex);
                 }
diff --git a/src/version.cpp b/src/version.cpp
index 18a122b4..520b97c4 100644
--- a/src/version.cpp
+++ b/src/version.cpp
@@ -13,7 +13,7 @@
 #define VERSION_PATCH   0
 
 // Number of the last patch in this fork's series: every fix commit bumps it
-#define VERSION_SERIES  483
+#define VERSION_SERIES  484
 // rlibs written by an older series are refused (0 = accept all)
 #define VERSION_SERIES_FLOOR    0
 
