From c5ae916bc244dfcdfefef540f33651548161456b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 10:48:51 +0000
Subject: [PATCH 253/255] macro_rules: a `<-` token (negative literal const
 argument) inside an expr/ty/path fragment

time 0.3.54 (ani-cli-rs 0.11.0) and 0.3.55 (cargo-c 0.10.25),
formatting/formattable.rs:77-82, inside `fmt_component_match!`:

    MACRO<::"time-0_3_55_H410040d"::fmt_component_match> BUG:
    src/macro_rules/eval.cpp:2343: TODO: Macro_InvokeRules_MatchPattern -
    No arm matched - (9, 41)

`try_likely_ok!($value.calendar_year($state).narrow::<-9_999, 9_999>()
.ok_or_else(..))` with `($e:expr)`: token 9 of the input is `<-`
(TOK_THINARROW_LEFT), the lexer's single token for `<` followed by
a negative literal const generic argument. 0247 taught the real parser's
method-call arm to split it, but the macro matcher's hand-rolled
consumers (consume_expr / consume_path / consume_type / consume_tt_angle)
only accepted `<` and `<<` where generic arguments start, so the only arm
failed and the matcher aborted.

is_generic_open() now takes `<-` as well in all those places; the
consumer only has to step over the arguments, nothing to split. Found on
the way: the path consumer took no generic arguments right after `::` in
type mode, so `$t:ty` = `R::<5, 5>` and `$p:path` = `R::<5, 5>::f` ended
the arm even with positive arguments; accepted now.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 1823990a..2b12b4eb 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -917,6 +917,14 @@ namespace
     bool consume_type(TokenStreamRO& lex);
 
     // Consume an entire TT
+    // Tokens that can open a generic argument list: `<`, `<<` (a qualified path as the first argument), and `<-` -
+    // the lexer makes one token out of `<` and a negative literal const argument (`year.narrow::<-99, 99>()`, time
+    // 0.3.54 formatting/formattable.rs:80 inside `try_likely_ok!($e:expr)`; `ri16::<-9_999, 9_999>`, `ri8<-25, 25>`).
+    // The real parser splits it (Parse_Path, Parse_ExprFC); this consumer only has to step over it.
+    bool is_generic_open(eTokenType t)
+    {
+        return t == TOK_LT || t == TOK_DOUBLE_LT || t == TOK_THINARROW_LEFT;
+    }
     bool consume_tt(TokenStreamRO& lex)
     {
         TRACE_FUNCTION;
@@ -960,7 +968,7 @@ namespace
         lex.consume();
         for(;;)
         {
-            if( lex.next() == TOK_LT || lex.next() == TOK_DOUBLE_LT )
+            if( is_generic_open(lex.next()) )
             {
                 level += (lex.next() == TOK_DOUBLE_LT ? 2 : 1);
             }
@@ -1034,7 +1042,7 @@ namespace
             break;
         case TOK_IDENT:
             lex.consume();
-            if( type_mode && (lex.next() == TOK_LT || lex.next() == TOK_DOUBLE_LT || lex.next() == TOK_PAREN_OPEN) )
+            if( type_mode && (is_generic_open(lex.next()) || lex.next() == TOK_PAREN_OPEN) )
                 ;
             // Allow a lone ident
             else if( lex.next() != TOK_DOUBLE_COLON )
@@ -1053,7 +1061,7 @@ namespace
             return false;
         }
 
-        if( type_mode && (lex.next() == TOK_LT || lex.next() == TOK_DOUBLE_LT) )
+        if( type_mode && is_generic_open(lex.next()) )
         {
             if( !consume_tt_angle(lex) )
                 return false;
@@ -1066,7 +1074,9 @@ namespace
             {
                 lex.consume();
             }
-            else if( !type_mode && (lex.next() == TOK_LT || lex.next() == TOK_DOUBLE_LT) )
+            // Generic arguments right after `::` in type mode too: `$t:ty` = `R::<5, 5>`, `$p:path` =
+            // `R::<-5, 5>::new_unchecked` are valid for rustc (found on the way; they ended the arm before)
+            else if( is_generic_open(lex.next()) )
             {
                 if( !consume_tt_angle(lex) )
                     return false;
@@ -1074,7 +1084,7 @@ namespace
             else if( lex.next() == TOK_IDENT )
             {
                 lex.consume();
-                if( type_mode && (lex.next() == TOK_LT || lex.next() == TOK_DOUBLE_LT) )
+                if( type_mode && is_generic_open(lex.next()) )
                 {
                     if( !consume_tt_angle(lex) )
                         return false;
@@ -1602,7 +1612,7 @@ namespace
                     {
                         if( lex.consume_if(TOK_DOUBLE_COLON) )
                         {
-                            if( !(lex.next() == TOK_LT || lex.next() == TOK_DOUBLE_LT) )
+                            if( !is_generic_open(lex.next()) )
                                 return false;
                             if( !consume_tt_angle(lex) )
                                 return false;
