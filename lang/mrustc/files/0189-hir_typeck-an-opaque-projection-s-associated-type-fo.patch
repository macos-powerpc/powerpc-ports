diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index 49f762a2..37848cab 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -2812,6 +2812,23 @@ void TraitResolution::expand_associated_types_inplace__UfcsKnown(const Span& sp,
                 }
                 DEBUG("B " << bound.m_path);
                 DEBUG("-> " << bound_tp);
+                // The binding may be for a supertrait's type: `ExactSizeIterator<Item = Self>` binds `Iterator::Item`.
+                // - ast-grep-core 0.45.3 `fn children(&self) -> impl ExactSizeIterator<Item = Self>` (RPITIT) reached
+                //   through `D: Doc` from ast-grep-config: `<<D::Node<'_> as SgNode<'_>>::erased#children_0 as Iterator>::Item`
+                //   stayed opaque, so `Map<that, closure>: Iterator` (`F: FnMut(I::Item)`) never matched the closure's
+                //   impl and `.filter` had "No applicable methods"
+                if( bound_tp != pe.trait ) {
+                    auto it = bound.m_type_bounds.find( pe.item );
+                    if( it != bound.m_type_bounds.end() && it->second.source_trait.m_path == pe.trait.m_path
+                        && m_ivars.pathparams_equal(cb_placeholders_trait.monomorph_path_params(sp, it->second.source_trait.m_params, false), pe.trait.m_params)
+                        && m_ivars.pathparams_equal(cb_placeholders_trait.monomorph_path_params(sp, it->second.aty_params, false), pe.params) )
+                    {
+                        input = monomorphise_type_needed(it->second.type) ? cb_placeholders_trait.monomorph_type(sp, it->second.type) : it->second.type.clone();
+                        DEBUG("- Found replacement (supertrait binding): " << input);
+                        this->expand_associated_types_inplace(sp, input, stack);
+                        return ;
+                    }
+                }
                 if( bound_tp == pe.trait ) {
                     auto it = bound.m_type_bounds.find( pe.item );
                     // A GAT's binding only applies to the same arguments
