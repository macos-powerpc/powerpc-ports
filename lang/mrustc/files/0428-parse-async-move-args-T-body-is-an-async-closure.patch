+        // - futures-copy 0.5.0 (arti 2.7.0) copy_buf.rs:256 `MockRuntime::test_with_various(async |rt| { .. })`
+        if( lex.lookahead(0) == TOK_PIPE || lex.lookahead(0) == TOK_DOUBLE_PIPE
+         || (lex.lookahead(0) == TOK_RWORD_MOVE && (lex.lookahead(1) == TOK_PIPE || lex.lookahead(1) == TOK_DOUBLE_PIPE)) )
+        {
+            return Parse_ExprVal_Closure(lex, /*is_async=*/true);
+        }
         bool is_move = lex.getTokenIf(TOK_RWORD_MOVE);
         return NEWNODE(AST::ExprNode_AsyncBlock, Parse_ExprBlockNode(lex, AST::ExprNode_Block::Type::Bare), is_move);
     }
