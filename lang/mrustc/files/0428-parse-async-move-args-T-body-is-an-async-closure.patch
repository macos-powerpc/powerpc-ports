+        // Closures (`async [move] |..| ..` since 1.85, `async [move] {` stays a block below)
+        bool is_closure = lex.next() == TOK_RWORD_MOVE || lex.next() == TOK_PIPE || lex.next() == TOK_DOUBLE_PIPE;
