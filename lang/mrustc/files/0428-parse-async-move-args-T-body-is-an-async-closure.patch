-        this->visit(n.m_code);
+        // An async closure's body is the async block the parser wrapped it in
+        if( n.m_is_async ) {
+            this->visit(dynamic_cast<AST::ExprNode_AsyncBlock&>(*n.m_code).m_inner);
+        }
+        else {
+            this->visit(n.m_code);
+        }
         m_os << " }";
     }
