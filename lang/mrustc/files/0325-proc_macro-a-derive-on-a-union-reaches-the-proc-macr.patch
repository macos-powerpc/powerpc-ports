From 79731d4531a4d862dbff64b3e2c3e9e1d9cd2e51 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 00:15:38 +0000
Subject: [PATCH 325/327] proc_macro: a derive on a `union` reaches the proc
 macro (visit_union was a TODO)

ppv-lite86 0.2.20 src/generic.rs:9 (pastel 0.12.0):
    #[repr(C)]
    #[derive(Clone, Copy, FromBytes, AsBytes, FromZeroes)]
    pub union vec128_storage { d: [u32; 4], q: [u64; 2] }
    generic.rs:9:10-55 BUG: src/expand/proc_macro.cpp:1692: TODO: visit_union - visit_union

zerocopy 0.7.35's derives on a union: the proc-macro bridge's item visitor had
cases for structs and enums only (the builtin Clone/Copy derives handle unions,
which is why ppv-lite86 0.2.21's `#[derive(Clone, Copy)] pub union` in skim
never got here).

visit_union now sends `<vis> union <Name><params> <where-bounds> { <attrs> <vis>
<name>: <type>, .. }` like a braced struct; `union` goes as an identifier token
(a contextual keyword, as rustc's token stream has it).

Assisted-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 0ca02e40..e8f47f33 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -1687,9 +1687,27 @@ namespace {
             }
             m_pmi.send_symbol("}");
         }
+        // A derive on a union: ppv-lite86 0.2.20 generic.rs:9 `#[repr(C)] #[derive(Clone, Copy, FromBytes, AsBytes,
+        // FromZeroes)] pub union vec128_storage { d: [u32; 4], q: [u64; 2] }` (pastel) was "TODO: visit_union". Same
+        // shape as a braced struct (`union` is a contextual keyword: an identifier token).
         void visit_union(const RcString& name, const AST::Visibility& vis, const ::AST::Union& unn)
         {
-            TODO(sp, "visit_union");
+            this->visit_vis(vis);
+            m_pmi.send_rword("union");
+            m_pmi.send_ident(name.c_str());
+            this->visit_params(unn.params());
+            this->visit_bounds(unn.params());
+            m_pmi.send_symbol("{");
+            for( const auto& si : unn.m_variants )
+            {
+                this->visit_attrs(si.m_attrs);
+                this->visit_vis(si.m_vis);
+                m_pmi.send_ident(si.m_name.c_str());
+                m_pmi.send_symbol(":");
+                this->visit_type(si.m_type);
+                m_pmi.send_symbol(",");
+            }
+            m_pmi.send_symbol("}");
         }
 
         void visit_function(const RcString& name, const AST::Visibility& vis, const ::AST::Function& fcn)
