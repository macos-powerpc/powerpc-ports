From 432f0f75fdb8af0fdd540753154e9bd536197c98 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 10:48:24 +0000
Subject: [PATCH 59/59] main: print only the version line for `--version`
 without `--verbose`

rustc prints a single `rustc 1.X.Y (...)` line for `--version`; the
`release:`/commit details only come with `--verbose`. mrustc always
printed its build details after the version line, and rustversion
1.0.22's build script parses the LAST line of `rustc --version`:

    Error: unexpected output from `rustc --version`: "rustc 1.90.100 (mrustc v0.12.0 :)\nrelease: 1.90.100\n- Build time: ...\n- Commit:  (dirty tree)\n"

Print the rest only when `--verbose` is also given (in either order,
as autocfg passes `--version --verbose` and version_check
`--verbose --version`), so their output is unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/main.cpp | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/main.cpp b/src/main.cpp
index fc78e5d4..56b80df1 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -9,6 +9,7 @@
 #include <iomanip>
 #include <string>
 #include <set>
+#include <algorithm>
 #include <version.hpp>
 #include <string_view.hpp>
 #include "parse/lex.hpp"
@@ -1199,9 +1200,14 @@ ProgramParams::ProgramParams(int argc, char *argv[])
                 const char* rustc_target = target_version_str(gTargetVersion);
                 // NOTE: Starts the version with "rustc 1.29.100" so build scripts don't get confused
                 ::std::cout << "rustc " << rustc_target << ".100 (mrustc " << Version_GetString() << ")" << ::std::endl;
-                ::std::cout << "release: " << rustc_target << ".100" << ::std::endl;    // `autoconfig` looks for this line
-                ::std::cout << "- Build time: " << gsVersion_BuildTime << ::std::endl;
-                ::std::cout << "- Commit: " << gsVersion_GitHash << (gbVersion_GitDirty ? " (dirty tree)" : "") << ::std::endl;
+                // Like rustc, the rest only with `--verbose` (in either order) - `rustversion` parses the LAST line of
+                // plain `--version` output as `rustc 1.X.Y ...`
+                if( ::std::any_of(argv + 1, argv + argc, [](const char* a){ return strcmp(a, "--verbose") == 0; }) )
+                {
+                    ::std::cout << "release: " << rustc_target << ".100" << ::std::endl;    // `autoconfig` looks for this line
+                    ::std::cout << "- Build time: " << gsVersion_BuildTime << ::std::endl;
+                    ::std::cout << "- Commit: " << gsVersion_GitHash << (gbVersion_GitDirty ? " (dirty tree)" : "") << ::std::endl;
+                }
                 exit(0);
             }
             // --out-dir <dir>  >> Set the output directory for automatically-named files
