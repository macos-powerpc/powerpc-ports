From d06bf0f7e9c181ba22f488a13748c9a9f60904e9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 07:16:25 +0000
Subject: [PATCH 170/171] expand: associated types with bounds go to proc
 macros

ratatui 0.30.2 src/widgets/stateful_widget_ref.rs:68 (skim 5.7.3):

    #[instability::unstable(feature = "widget-ref")]
    pub trait StatefulWidgetRef { type State: ?Sized; .. }

    BUG: proc_macro.cpp: TODO: visit_trait - associated type with bounds - State

An attribute proc macro gets the whole trait, and the input serialiser
had a TODO for associated types with bounds. Those are stored as
`Self: ..` entries in `m_self_bounds`, and are now sent as
`: A + ?B + !C + 'd` (new visit_assoc_type_bounds). A GAT's where
clause (`type Gat<'a>: X where Self: 'a;`), dropped before, now goes
out too. And a missing default, stored as `_`, is no longer sent as
`= _`, which made every associated type in such a trait unparseable
for the plugin.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index 824a392e..608099f0 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -1312,6 +1312,37 @@ namespace {
                 m_pmi.send_symbol(">");
             }
         }
+        /// The `Self: ..` bounds of an associated type, as `: A + ?B + 'c`
+        void visit_assoc_type_bounds(const Span& sp, const AST::GenericParams& self_bounds)
+        {
+            bool first = true;
+            for(const auto& b : self_bounds.m_bounds)
+            {
+                if( b.is_None() )
+                    continue ;
+                m_pmi.send_symbol(first ? ":" : "+");
+                first = false;
+                TU_MATCH_HDRA((b), {)
+                default:
+                    TODO(sp, "visit_assoc_type_bounds - " << b.tag_str());
+                TU_ARMA(IsTrait, be) {
+                    visit_hrbs(be.inner_hrbs);
+                    visit_path(be.trait);
+                    }
+                TU_ARMA(MaybeTrait, be) {
+                    m_pmi.send_symbol("?");
+                    visit_path(be.trait);
+                    }
+                TU_ARMA(NotTrait, be) {
+                    m_pmi.send_symbol("!");
+                    visit_path(be.trait);
+                    }
+                TU_ARMA(TypeLifetime, be) {
+                    m_pmi.send_lifetime(be.bound.name().name.c_str());
+                    }
+                }
+            }
+        }
         void visit_bounds(const AST::GenericParams& params)
         {
             if( !params.m_bounds.empty() )
@@ -1776,16 +1807,18 @@ namespace {
                 TU_ARMA(Static, e) {
                     this->visit_static(i.name, item_vis, e);
                     }
-                // An associated type. Bounds live in `m_self_bounds` encoded as `Self: ...`, not the shape needed here, so only the un-bounded form is emitted.
+                // An associated type. Its bounds live in `m_self_bounds` encoded as `Self: ...`: sent as `: A + ?B + 'c`
+                // - ratatui 0.30.2 widgets/stateful_widget_ref.rs: `#[instability::unstable(..)] pub trait
+                //   StatefulWidgetRef { type State: ?Sized; .. }`
                 TU_ARMA(Type, e) {
-                    if( !e.m_self_bounds.m_bounds.empty() ) {
-                        TODO(i.span, "visit_trait - associated type with bounds - " << i.name);
-                    }
                     this->visit_vis(item_vis);
                     m_pmi.send_rword("type");
                     m_pmi.send_ident(i.name.c_str());
                     this->visit_params(e.m_params);
-                    if( e.m_type.is_valid() ) {
+                    this->visit_assoc_type_bounds(i.span, e.m_self_bounds);
+                    this->visit_bounds(e.m_params);
+                    // No default is stored as `_`
+                    if( e.m_type.is_valid() && !e.m_type.is_wildcard() ) {
                         m_pmi.send_symbol("=");
                         this->visit_type(e.m_type);
                     }
