From e64e426235e4362bbfd291a241ca12405c4039c4 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 17:35:33 +0000
Subject: [PATCH] parse: `break` in a condition leaves a following `{` to the
 body

rustc 1.90 tests/ui, parse-only run:

    consts/const-labeled-break.rs       const _: () = 'a: while break 'a {};
    nll/assign-while-to-immutable.rs    let y: () = 'l: while break 'l {};
    error: Unexpected token TOK_SEMICOLON, expected TOK_BRACE_OPEN
    for-loop-while/loop-break-value.rs  'inner_loop: while break 'inner_loop {
    error: Unexpected token TOK_RWORD_BREAK, expected TOK_BRACE_OPEN
    expr/weird-exprs.rs                 loop { if break { } }
    error: Unexpected token TOK_BRACE_CLOSE, expected TOK_BRACE_OPEN

Reference, Loops and other breakable expressions: BreakExpression is
`break LIFETIME_OR_LABEL? Expression?`; Expressions > "Expression
statements"/struct-expression restriction: in the condition of `if` /
`while` and the scrutinee of `match` (ExpressionExceptStructExpression)
a `{` cannot start a struct expression. rustc's parse_expr_break takes
no value when the next token is `{` under that restriction, so the `{`
is the body of the enclosing `while` / `if`.

Parser (expr.cpp Parse_FlowControl): `break` followed by `{` while
disallow_struct_literal is set has no value; elsewhere `break { 3 }`
still takes the block. `return` keeps taking it, as rustc does.

macro_rules expression skimmer (eval.cpp consume_expr): the same rule
for `break` inside a condition it skims with no_struct_lit
(`$e:expr` given `'l: while break 'l {}` failed: the value swallowed
the body).

Assisted-by: Claude Opus 5.5
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index f464e00b..bcce172f 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -1592,11 +1592,15 @@ namespace
             {
             case TOK_RWORD_CONTINUE:
             case TOK_RWORD_BREAK:
-                lex.consume();
-                lex.consume_if(TOK_LIFETIME);
-                if(0)
-            case TOK_RWORD_RETURN:
-                lex.consume();
+            case TOK_RWORD_RETURN: {
+                bool is_break = (lex.next() == TOK_RWORD_BREAK);
+                if( lex.next() != TOK_RWORD_RETURN ) {
+                    lex.consume();
+                    lex.consume_if(TOK_LIFETIME);
+                }
+                else {
+                    lex.consume();
+                }
                 switch(lex.next())
                 {
                 case TOK_EOF:
@@ -1606,12 +1610,19 @@ namespace
                 case TOK_BRACE_CLOSE:
                 case TOK_SQUARE_CLOSE:
                     break;
+                // In a condition or scrutinee, a `{` after `break` is the body: `'l: while break 'l {}`
+                case TOK_BRACE_OPEN:
+                    if( is_break && no_struct_lit )
+                        break;
+                    if( !consume_expr(lex) )
+                        return false;
+                    break;
                 default:
                     if( !consume_expr(lex) )
                         return false;
                     break;
                 }
-                break;
+                break; }
             case TOK_IDENT:
             case TOK_INTERPOLATED_PATH:
             case TOK_DOUBLE_COLON:
diff --git a/src/parse/expr.cpp b/src/parse/expr.cpp
index 84cca586..b0146832 100644
--- a/src/parse/expr.cpp
+++ b/src/parse/expr.cpp
@@ -711,6 +711,12 @@ ExprNodeP Parse_FlowControl(TokenStream& lex, AST::ExprNode_Flow::Type type)
     case TOK_PAREN_CLOSE:
     case TOK_SQUARE_CLOSE:
         break;
+    // In a condition or scrutinee, a `{` after `break` is the body: `'l: while break 'l {}`, `if break {}`
+    case TOK_BRACE_OPEN:
+        if( type == AST::ExprNode_Flow::BREAK && CHECK_PARSE_FLAG(lex, disallow_struct_literal) )
+            break;
+        val = Parse_Expr0(lex);
+        break;
     default:
         val = Parse_Expr0(lex);
         break;
diff --git a/src/version.cpp b/src/version.cpp
index d84aaff0..f8958fec 100644
--- a/src/version.cpp
+++ b/src/version.cpp
@@ -13,7 +13,7 @@
 #define VERSION_PATCH   0
 
 // Number of the last patch in this fork's series: every fix commit bumps it
-#define VERSION_SERIES  476
+#define VERSION_SERIES  477
 // rlibs written by an older series are refused (0 = accept all)
 #define VERSION_SERIES_FLOOR    0
 
