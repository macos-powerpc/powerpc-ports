From ad6a34c517bb7dd001d42e2e0ee2e6dda9a5f608 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 14 Oct 2026 19:59:19 +0000
Subject: [PATCH 236/241] expand: format_args! skips whitespace before a fragment's `}`

pest 2.3.0 (rq 1.0.4) error.rs:444 pads its fragments:

    format!("{s    }--> {p}{ls}:{c}\n{s    } |\n{ls:w$} | {line}", s = spacing, ..)

and format_args.cpp accepted only `:` or `}` right after the argument:

    MACRO<::"alloc-0_0_0"::format> error:0: Malformed formatting fragment, unexpected

rustc's parser (`consume_closing_brace`) skips whitespace before the
closing brace, after the argument and after the format spec, and `{ }`
is the next positional. The fragment parser does the same (and, more
leniently than rustc, also before `:`). The type-specifier tail is
restructured so `{:x? }` and `{:x }` are taken too; an unknown specifier
is still an error.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/expand/format_args.cpp | 52 +++++++++++++++++++++++---------------
 1 file changed, 32 insertions(+), 20 deletions(-)

diff --git a/src/expand/format_args.cpp b/src/expand/format_args.cpp
index 3d02972c..8beb5c4b 100644
--- a/src/expand/format_args.cpp
+++ b/src/expand/format_args.cpp
@@ -268,6 +268,14 @@ namespace {
                 const char* trait_name;
                 FmtArgs args;
 
+                // Whitespace around the argument is skipped, as by rustc's `consume_closing_brace`/`position`: pest
+                // 2.3.0 error.rs:444 pads `{s    } |`. (rustc only allows it before `}`, not before `:`.)
+                auto skip_ws = [&]() {
+                    while( s < s_end && (*s == ' ' || *s == '\t' || *s == '\n' || *s == '\r') )
+                        s ++;
+                    };
+                skip_ws();
+
                 // Formatting parameter
                 if( *s != ':' && *s != '}' ) {
                     // Parse either an integer or an identifer
@@ -295,6 +303,7 @@ namespace {
                     // - If index is ~0u at the end of this block, it's set to the next arg
                     // - This allows {:.*} to format correctly (taking <prec> then <arg>)
                 }
+                skip_ws();
 
                 // If next character is ':', parse extra information
                 if( *s == ':' ) {
@@ -456,6 +465,7 @@ namespace {
                         }
                     }
 
+                    skip_ws();
                     if( s == s_end )
                         ERROR(sp, E0000, "Unexpected end of formatting string");
 
@@ -465,36 +475,38 @@ namespace {
                     {
                         trait_name = "Display";
                     }
-                    else if( s[1] == '}' )
-                    {
-                        switch(s[0])
-                        {
-                        default:
-                            ERROR(sp, E0000, "Unknown formatting type specifier '" << *s << "'");
-                        case '?': s++; trait_name = "Debug" ; break;
-                        case 'b': s++; trait_name = "Binary"; break;
-                        case 'o': s++; trait_name = "Octal" ; break;
-                        case 'x': s++; trait_name = "LowerHex"; break;
-                        case 'X': s++; trait_name = "UpperHex"; break;
-                        case 'p': s++; trait_name = "Pointer" ; break;
-                        case 'e': s++; trait_name = "LowerExp"; break;
-                        case 'E': s++; trait_name = "UpperExp"; break;
-                        }
-                        assert(*s == '}');
-                    }
                     else
                     {
-                        if( strncmp(s, "x?}", 3) == 0 ) {
+                        if( strncmp(s, "x?", 2) == 0 ) {
                             args.debug_ty = FmtArgs::Debug::LowerHex;
                             trait_name = "Debug";
+                            s += 2;
                         }
-                        else if( strncmp(s, "X?}", 3) == 0 ) {
+                        else if( strncmp(s, "X?", 2) == 0 ) {
                             args.debug_ty = FmtArgs::Debug::UpperHex;
                             trait_name = "Debug";
+                            s += 2;
                         }
                         else {
-                            TODO(sp, "Parse formatting fragment at \"" << fmt_frag_str << "\" (long type) - s=...\"" << s << "\"");
+                            switch(s[0])
+                            {
+                            default:
+                                TODO(sp, "Parse formatting fragment at \"" << fmt_frag_str << "\" (long type) - s=...\"" << s << "\"");
+                            case '?': trait_name = "Debug" ; break;
+                            case 'b': trait_name = "Binary"; break;
+                            case 'o': trait_name = "Octal" ; break;
+                            case 'x': trait_name = "LowerHex"; break;
+                            case 'X': trait_name = "UpperHex"; break;
+                            case 'p': trait_name = "Pointer" ; break;
+                            case 'e': trait_name = "LowerExp"; break;
+                            case 'E': trait_name = "UpperExp"; break;
+                            }
+                            s ++;
                         }
+                        // Whitespace before `}` again (`{:x }`)
+                        skip_ws();
+                        if( *s != '}' )
+                            ERROR(sp, E0000, "Unknown formatting type specifier in \"" << fmt_frag_str << "\"");
                     }
                 }
                 else {
