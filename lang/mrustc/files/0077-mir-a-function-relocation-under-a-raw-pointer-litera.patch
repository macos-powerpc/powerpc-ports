From d10110069e0af53e8e6a98d99d9966b24ad01e91 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 5 Oct 2026 23:22:01 +0000
Subject: [PATCH 77/77] mir: a function relocation under a raw pointer literal
 is the function's address, not a static

yansi 1.0.1 src/global.rs `static ENABLED: AtomicCondition = AtomicCondition::DEFAULT;`
where `AtomicCondition::from` stores `value.0 as *mut ()` (a `fn() -> bool` cast to a raw
pointer) in an `AtomicPtr<()>`:

    MIR ERROR: ::yansi::global::ENABLED BB0/0: src/mir/helpers.cpp:62 ASSERT v.is_Static()
    failed - LValue::Static not a static - <Condition>::os_support : Function

Const evaluation produced the value with a relocation naming the function. When MIR
cleanup turned that literal back into MIR, the `Pointer` arm of
`MIR_Cleanup_LiteralToRValue` handed every relocation to the `Borrow` logic, which looks
the path up as a static.

If the relocation names a function, emit `Constant::ItemAddr` typed as the function's
`fn` pointer type and cast that to the raw pointer type, which is what the original
`f as *mut ()` lowers to outside const evaluation.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/mir/cleanup.cpp | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/mir/cleanup.cpp b/src/mir/cleanup.cpp
index 6e585463..0d4d59b8 100644
--- a/src/mir/cleanup.cpp
+++ b/src/mir/cleanup.cpp
@@ -421,8 +421,22 @@ namespace {
         throw "";
         }
     TU_ARMA(Pointer, te) {
-        if(lit.get_reloc())
+        if(const auto* data_reloc = lit.get_reloc())
         {
+            // A function pointer cast to a raw pointer (`value.0 as *mut ()` in yansi 1.0.1's `AtomicCondition`):
+            // the relocation names a function, not a static, so take its address as a `fn` pointer and cast that.
+            if( data_reloc->p )
+            {
+                MonomorphState  ms;
+                auto v = state.m_resolve.get_value(state.sp, *data_reloc->p, ms, /*signature_only*/true);
+                if( v.is_Function() )
+                {
+                    auto fcn_ty = v.as_Function()->make_ptr_ty(state.sp, ms);
+                    DEBUG("Function pointer " << *data_reloc->p << " : " << fcn_ty << " as " << ty);
+                    auto lval = mutator.in_temporary( mv$(fcn_ty), ::MIR::RValue( ::MIR::Constant::make_ItemAddr(box$(params.monomorph_path(state.sp, *data_reloc->p))) ) );
+                    return ::MIR::RValue::make_Cast({ mv$(lval), mv$(ty) });
+                }
+            }
             // Share logic with `Borrow` below, but wrap returned value in a cast op
             auto ty_borrow = ::HIR::TypeRef::new_borrow(te.type, te.inner.clone());
             auto rval = MIR_Cleanup_LiteralToRValue(state, mutator, lit, ty_borrow.clone(), params, mv$(path));
