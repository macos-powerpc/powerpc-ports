From e9ee411b5d83719c16c51e2bbeda5fb259f57b13 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 6 Nov 2026 03:01:36 +0000
Subject: [PATCH] parse, expand: an impl item keeps its written visibility,
 and proc macros receive it

tor-persist 0.47.0 (arti 2.7.0) src/err.rs:9: "Unable to resolve `use`
target ::fs_mistrust::anon_home::PathExt".

fs-mistrust 0.16.0 anon_home.rs has `#[ext] pub impl Path { .. }`. The
`extend` attribute macro reads the visibility written before `impl` and
gives the generated `trait PathExt` that visibility; rustc only rejects
`pub impl` after expansion. mrustc's parser gave every impl item a fixed
`pub` visibility and the proc-macro serialiser sent none, so extend saw
`impl Path` and generated a private trait.

The parser now keeps the visibility written on `impl` and `unsafe impl`
(none = private, as for every other item; nothing reads an impl's
visibility otherwise, and derive-generated impls were already private),
and the serialiser sends it before the impl.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/expand/proc_macro.cpp b/src/expand/proc_macro.cpp
index cf4361e5..18e0669e 100644
--- a/src/expand/proc_macro.cpp
+++ b/src/expand/proc_macro.cpp
@@ -2178,6 +2178,7 @@ namespace {
                 visit_static(name, vis, e);
                 }
             TU_ARMA(Impl, e) {
+                this->visit_vis(vis);
                 visit_impl(e);
                 }
             TU_ARMA(Use, e) {
diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 4cf01f74..3a57df64 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -2388,7 +2388,7 @@ namespace {
             else {
                 BUG(lex.point_span(), "Parse_Impl returned a variant other than Impl or NegImpl");
             }
-            return ::AST::Named< ::AST::Item> { Span(), mv$(meta_items), AST::Visibility::make_global(), "", mv$(impl) };
+            return ::AST::Named< ::AST::Item> { Span(), mv$(meta_items), mv$(vis), "", mv$(impl) };
             }
         // `unsafe auto trait`
         case TOK_IDENT:
@@ -2470,7 +2470,8 @@ namespace {
     // `impl`
     case TOK_RWORD_IMPL: {
         auto impl = Parse_Impl(lex, meta_items);
-        return ::AST::Named< ::AST::Item> { Span(), std::move(meta_items), AST::Visibility::make_global(), "", std::move(impl) };
+        // `pub impl` is rejected only after expansion: an attribute macro reads it (extend 1.2.0 `#[ext] pub impl T`)
+        return ::AST::Named< ::AST::Item> { Span(), std::move(meta_items), std::move(vis), "", std::move(impl) };
         }
     // `trait`
     case TOK_RWORD_TRAIT: {
