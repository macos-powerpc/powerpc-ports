From 123573955d87384c309b696fb6c3a49f7f08c8bb Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 4 Oct 2026 01:54:41 +0000
Subject: [PATCH 38/38] hir_expand: keep the enclosing function's types on
 coroutine capture nodes

The coroutine (`async` block) lowering typed the capture expressions it
leaves in the enclosing function with `cap_ty`, the captured variable's
type after remapping into the generated state struct's own generics. A
captured variable whose type mentions one of the enclosing function's
lifetime parameters therefore produced a temporary typed with the
generator's impl lifetime (`&mut &'I1 mut dyn Iterator<..>`) inside a
free function, and MIR validation died with "Impl lifetime parameters
were not expected (got /*I:1*/)" (cc 1.2.67 `run_commands_in_parallel`,
which captures `cmds: &mut dyn Iterator<..>` in an `async` block).

Use the variable's original type for the capture nodes and the remapped
type only for the state struct field, which is what the closure lowering
already does.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_expand/closures.cpp | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/hir_expand/closures.cpp b/src/hir_expand/closures.cpp
index 85a7e37b..6852e630 100644
--- a/src/hir_expand/closures.cpp
+++ b/src/hir_expand/closures.cpp
@@ -1568,8 +1568,18 @@ namespace {
                 rv.new_locals.push_back( monomorph_cb.monomorph_type(sp, m_variable_types.at(cap.first)) );
 
                 rv.capture_usages.push_back(cap.second);
-                auto cap_ty = monomorph_cb.monomorph_type(sp, m_variable_types.at(cap.first));
-                rv.struct_ents.push_back(HIR::VisEnt<HIR::TypeRef> { HIR::Publicity::new_none(), cap_ty.clone() });
+                // Two views of the captured variable's type:
+                // - `cap_ty`: as seen from the ENCLOSING function (its own generic space). Used for the
+                //   capture expressions, which stay in the enclosing function's body.
+                // - `ty_mono`: remapped into the generator's own parameters. Used for the state struct's
+                //   field (same split as the closure lowering above).
+                // Using `ty_mono` for the capture nodes leaked the generator's impl lifetimes (`'I1`) into
+                // the enclosing function's MIR: cc 1.2.67 `run_commands_in_parallel(.., cmds: &mut dyn
+                // Iterator<..>)` captures `cmds` in an `async` block, and MIR validation then died with
+                // "Impl lifetime parameters were not expected (got /*I:1*/)".
+                auto cap_ty = m_variable_types.at(cap.first).clone();
+                auto ty_mono = monomorph_cb.monomorph_type(sp, cap_ty);
+                rv.struct_ents.push_back(HIR::VisEnt<HIR::TypeRef> { HIR::Publicity::new_none(), ty_mono.clone() });
                 rv.capture_nodes.push_back(HIR::ExprNodeP(new ::HIR::ExprNode_Variable(sp, "", cap.first)));
                 switch(cap.second)
                 {
