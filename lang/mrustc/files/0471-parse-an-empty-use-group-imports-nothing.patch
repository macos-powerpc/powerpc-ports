From ba1df996dfe2193fe168adee7398dcf04da03672 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 18 Nov 2026 17:06:47 +0000
Subject: [PATCH] parse: an empty use group imports nothing

rustc 1.90 tests/ui, parse-only run:

    imports/empty-import-prefix-pass.rs, -pass-2015.rs   use {{}};
    issues/issue-47673.rs                                use {{}, {}};
    privacy/import-list-stem-visibility-issue-119126.rs  pub(crate) use inner::{};
    error: Unexpected token TOK_BRACE_OPEN

Reference, Use declarations: UseTree is `(SimplePath? ::)? *
| (SimplePath? ::)? { (UseTree (, UseTree)* ,?)? } | SimplePath (as
..)?`: the list inside the braces is optional. Macro-generated code
produces empty groups from empty repetitions.

Parse_Use_Inner rejected `{` directly followed by `}`. Its loop already
ends at a `}` in the position after a comma, so dropping the check
makes an empty group add no entry. A `use` item without entries was
already handled: resolve iterates no entries, ast/dump skips it, the
proc-macro visitor sends `use {};`.

Grammar copies: the macro_rules item skimmer reads a `use` item up to
its `;`.

Assisted-by: Claude Opus 5.5
---

diff --git a/src/parse/root.cpp b/src/parse/root.cpp
index 00a5b810..a8bd135c 100644
--- a/src/parse/root.cpp
+++ b/src/parse/root.cpp
@@ -1792,14 +1792,10 @@ void Parse_Use_Inner(TokenStream& lex, ::std::vector<AST::UseItem::Ent>& entries
             path.append( AST::PathNode( tok.ident().name, {}) );
             break;
         case TOK_BRACE_OPEN:
-            // Can't be an empty list
-            if( LOOK_AHEAD(lex) == TOK_BRACE_CLOSE ) {
-                throw ParseError::Unexpected(lex, tok);
-            }
             // Keep looping until a comma
             do {
                 if( lex.getTokenIf(TOK_BRACE_CLOSE, tok) ) {
-                    // Trailing comma
+                    // Trailing comma, or an empty group (`use a::{};`, `use {{}};`): it imports nothing
                     break;
                 }
                 // - Handle `self` in braces differently
diff --git a/src/version.cpp b/src/version.cpp
index 3fb43b77..cafb55ec 100644
--- a/src/version.cpp
+++ b/src/version.cpp
@@ -13,7 +13,7 @@
 #define VERSION_PATCH   0
 
 // Number of the last patch in this fork's series: every fix commit bumps it
-#define VERSION_SERIES  470
+#define VERSION_SERIES  471
 // rlibs written by an older series are refused (0 = accept all)
 #define VERSION_SERIES_FLOOR    0
 
