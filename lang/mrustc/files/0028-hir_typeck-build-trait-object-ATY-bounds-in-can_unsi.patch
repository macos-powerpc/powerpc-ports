From d1806a93db1f2250276fe124d3d9f503110fbcaf Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 2 Oct 2026 07:58:42 +0000
Subject: [PATCH 28/31] hir_typeck: build trait-object ATY bounds in can_unsize
 instead of hitting a TODO

The `(Trait) <- Foo` arm of TraitResolution::can_unsize builds a refined
trait-object type from the impl that matched the source. For every
associated-type bound on the destination it looked up the value and then
unconditionally hit
    TODO: operator() - Monomorph ::core::future::Future from  to
because the bound's `source_trait` path (written in terms of the trait
object's own params) was never rewritten in terms of the matched impl's
params.

Do the rewrite: when the impl's trait params differ from the destination's,
substitute the destination's params with the impl's in the source trait
path; when they're the same (the common case, including param-less traits
like Future) keep it as is. Also carry the destination's lifetime bound
over to the refined type instead of leaving it default-initialised.

Hit by futures-task 0.3.32/0.3.34 future_obj.rs:258
    unsafe impl<'a, T, F> UnsafeFutureObj<'a, T> for Pin<Box<F>>
    where F: Future<Output = T> + 'a {
        fn into_raw(self) -> *mut (dyn Future<Output = T> + 'a) {
            let mut this = mem::ManuallyDrop::new(self);
            unsafe { this.as_mut().get_unchecked_mut() as *mut _ }
        }
which casts `*mut F` to `*mut (dyn Future<Output = T> + 'a)`.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_typeck/helpers.cpp | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index a253f9b4..c004712d 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -4582,6 +4582,7 @@ bool TraitResolution::trait_contains_type(const Span& sp, const ::HIR::GenericPa
 
         ::HIR::TypeData::Data_TraitObject  tmp_e;
         tmp_e.m_trait.m_path = de->m_trait.m_path.m_path;
+        tmp_e.m_lifetime = de->m_lifetime;
 
         // Check data trait first.
         if( de->m_trait.m_path.m_path == ::HIR::SimplePath() ) {
@@ -4605,9 +4606,26 @@ bool TraitResolution::trait_contains_type(const Span& sp, const ::HIR::GenericPa
                             // Run EAT
                             atyv = this->expand_associated_types( sp, ::HIR::TypeRef::new_path( mv$(p), {} ) );
                         }
-                        TODO(sp, "Monomorph " << aty.second.source_trait << " from " << de->m_trait.m_path.m_params << " to " << tmp_e.m_trait.m_path.m_params);
+                        // The ATY's source trait path is written in terms of the trait object's own params. If the
+                        // impl matched with different (more concrete) params, rewrite those params to the impl's values.
+                        auto source_trait = aty.second.source_trait.clone();
+                        const auto& de_params = de->m_trait.m_path.m_params;
+                        const auto& impl_params = tmp_e.m_trait.m_path.m_params;
+                        if( de_params != impl_params && de_params.m_types.size() == impl_params.m_types.size() )
+                        {
+                            source_trait.m_params = clone_path_params_with(sp, source_trait.m_params, [&](const ::HIR::TypeRef& t, ::HIR::TypeRef& out)->bool {
+                                for(size_t i = 0; i < de_params.m_types.size(); i ++) {
+                                    if( t == de_params.m_types[i] ) {
+                                        out = impl_params.m_types[i].clone();
+                                        return true;
+                                    }
+                                }
+                                return false;
+                                });
+                            DEBUG("Monomorph " << aty.second.source_trait << " from " << de_params << " to " << impl_params << " = " << source_trait);
+                        }
                         tmp_e.m_trait.m_type_bounds[aty.first] = ::HIR::TraitPath::AtyEqual {
-                            aty.second.source_trait.clone(),    // TODO: Monomorph from `de->m_trait.m_path.m_params` to `tmp_e.m_trait.m_path.m_params`
+                            mv$(source_trait),
                             {},
                             mv$(atyv)
                         };
