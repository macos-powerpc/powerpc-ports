diff --git a/src/parse/lex.cpp b/src/parse/lex.cpp
index 602f087f..c6f3f799 100644
--- a/src/parse/lex.cpp
+++ b/src/parse/lex.cpp
@@ -317,6 +317,65 @@ Ident::Hygiene Lexer::realGetHygiene() const
 {
     return m_hygiene;
 }
+// rustc_lexer::strip_shebang: after a `#!` at the start of a file, is the next token (past whitespace and non-doc
+// comments, on any line) a `[`? Reads ahead and returns the stream to where it was.
+static bool Lex_ShebangIsAttribute(::std::istream& is)
+{
+    auto start = is.tellg();
+    if( start == ::std::istream::pos_type(-1) ) {
+        is.clear();
+        return is.peek() == '[';
+    }
+    bool rv = false;
+    for(;;)
+    {
+        int c = is.get();
+        if( c == EOF )
+            break;
+        if( c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f' )
+            continue;
+        if( c == '/' && is.peek() == '/' ) {
+            is.get();
+            int c3 = is.get();
+            // `//!` and `///` (not `////`) are doc comments, a token
+            if( c3 == '!' || (c3 == '/' && is.peek() != '/') )
+                break;
+            while( c3 != EOF && c3 != '\n' )
+                c3 = is.get();
+            continue;
+        }
+        if( c == '/' && is.peek() == '*' ) {
+            is.get();
+            int cc = is.get();
+            // `/*!` and `/**` (not `/**/` or `/***`) are doc comments
+            if( cc == '!' || (cc == '*' && is.peek() != '*' && is.peek() != '/') )
+                break;
+            unsigned depth = 1;
+            int prev = 0;
+            while( cc != EOF )
+            {
+                if( prev == '/' && cc == '*' ) {
+                    depth ++;
+                    cc = 0;
+                }
+                else if( prev == '*' && cc == '/' ) {
+                    if( --depth == 0 )
+                        break;
+                    cc = 0;
+                }
+                prev = cc;
+                cc = is.get();
+            }
+            continue;
+        }
+        rv = (c == '[');
+        break;
+    }
+    is.clear();
+    is.seekg(start);
+    return rv;
+}
