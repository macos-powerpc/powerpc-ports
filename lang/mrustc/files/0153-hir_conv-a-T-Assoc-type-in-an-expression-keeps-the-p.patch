From fa9002eaead2e123b04fe7bfd4df567d71184521 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 8 Oct 2026 22:15:21 +0000
Subject: [PATCH] hir_conv: a `T::Assoc` type in an expression keeps the params
 of the bound naming it

similar 3.2.0 (ast-grep 0.45.3) src/algorithms/preflight.rs:79, with
`Old: Index<usize> + ?Sized`:

    if type_name::<Old::Output>() != type_name::<New::Output>() {

    error: Failed to infer type _ in type_name<<Old as Index<_>>::Output>

Resolve UFCS finds `Output` through the `Index<usize>` bound, then, for
any path inside an expression, blanks the trait's type params so typeck
infers them.  That is right for a value path (`T::from(x)` under
`T: From<A> + From<B>` picks its bound by inference), but a type path has
nothing to infer from: rustc requires `T::Output` to name exactly one
bound (E0221 otherwise), and in a turbofish nothing else ever unifies
with that `_`.  Keep the bound's params for type context, blank them for
value context only.  Upstream's own comment at the spot asks whether to
limit the blanking ("Only do this when there's multiple options?").

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hir_conv/resolve_ufcs.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/hir_conv/resolve_ufcs.cpp b/src/hir_conv/resolve_ufcs.cpp
index b2f98142..92fa417d 100644
--- a/src/hir_conv/resolve_ufcs.cpp
+++ b/src/hir_conv/resolve_ufcs.cpp
@@ -437,8 +437,14 @@ namespace resolve_ufcs {
                     e.params.m_lifetimes.resize( aty.m_generics.m_lifetimes.size() );
                 }
             }
+            // In an expression, a value path (`T::from(x)` with `T: From<A> + From<B>`) picks its bound by inference, so
+            // the trait's type params are left for typeck to fill. A type path (`T::Output` in a turbofish or a `let`
+            // annotation) must name exactly one bound (rustc E0221 otherwise), so that bound's params stay: nothing
+            // else would ever bind them.
+            // - similar 3.2.0 preflight.rs:79: `type_name::<Old::Output>()` with `Old: Index<usize> + ?Sized` ->
+            //   "Failed to infer type _ in type_name<<Old as Index<_>>::Output>"
             // TODO: Only do this when there's multiple options?
-            if( m_in_expr )
+            if( m_in_expr && pc == HIR::Visitor::PathContext::VALUE )
             {
                 auto s = trait_path.m_params.m_types.size();
                 trait_path.m_params.m_types.resize(0);
