From 5282d2e3c7e0c5140d44b6291183e234a03904ab Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 19 Oct 2026 15:12:25 +0000
Subject: [PATCH] macro_rules: an `expr` fragment can start with a label or be
 a `while let`

Found while writing the kit for 0338: `macro_rules! se { ($e:expr) => { stringify!($e) } }` with
`se!('l: loop { break 'l x; })` = "BUG: src/macro_rules/eval.cpp:2369: TODO: Macro_InvokeRules_MatchPattern - No arm
matched". The arm matcher's expression lookahead (consume_expr) had no case for a leading label (`'l: loop {..}`,
`'l: while ..`, `'l: for ..`, `'l: {..}` are expressions, rustc's parse_expr_labeled), and parsed `while`'s condition as
a plain expression, so `while let PAT = EXPR {..}` failed at `let` (`if let` was handled).

consume_expr: a lifetime followed by `:` and a loop keyword or `{` goes on with the loop/block; anything else after
a lifetime is still no expression (a `$l:lifetime` arm keeps `'a`). `while let` takes the pattern and `=` as `if let`
does.

Assisted-By: Claude Opus 5.5 (1M context)
---

diff --git a/src/macro_rules/eval.cpp b/src/macro_rules/eval.cpp
index 1b98e0cf..45034357 100644
--- a/src/macro_rules/eval.cpp
+++ b/src/macro_rules/eval.cpp
@@ -1443,6 +1443,24 @@ namespace
                 }
             } while(inner_cont);
 
+            // A label: `'l: loop {..}`, `'l: while ..`, `'l: for ..`, `'l: {..}` (the loop/block itself follows)
+            if( lex.next() == TOK_LIFETIME )
+            {
+                lex.consume();
+                if( !lex.consume_if(TOK_COLON) )
+                    return false;
+                switch(lex.next())
+                {
+                case TOK_RWORD_LOOP:
+                case TOK_RWORD_WHILE:
+                case TOK_RWORD_FOR:
+                case TOK_BRACE_OPEN:
+                    break;
+                default:
+                    return false;
+                }
+            }
+
             // :: -> path
             // ident -> path
             // '<' -> path
@@ -1557,6 +1575,14 @@ namespace
                 break;
             case TOK_RWORD_WHILE:
                 lex.consume();
+                // `while let PAT = EXPR`, as `if let` below
+                if( lex.consume_if(TOK_RWORD_LET) )
+                {
+                    if( !consume_pat(lex) )
+                        return false;
+                    if( !lex.consume_if(TOK_EQUAL) )
+                        return false;
+                }
                 if( !consume_expr(lex, true) )
                     return false;
                 if( lex.next() != TOK_BRACE_OPEN )
