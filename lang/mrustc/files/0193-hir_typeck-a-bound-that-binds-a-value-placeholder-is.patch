From 7e1941c3457838a54637b62ee29aa5f5ea0a6cd1 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 9 Oct 2026 14:32:46 +0000
Subject: [PATCH] hir_typeck: a bound that binds a value placeholder is a candidate,
 not a decision

0192 left a const parameter the request gave as an inference variable
to the impl's bounds, as a placeholder. That broke libcore 1.90:
core_simd const_ptr.rs:106 `Simd::splat(..).simd_eq(self)` on
`Simd<_, _>`, where `impl<T, const N: usize> SimdPartialEq for Simd<T,
N> where LaneCount<N>: SupportedLaneCount` has a `LaneCount` impl per
lane count: "No applicable methods for {Simd<_, Infer(0)>}.simd_eq".

Two things were wrong.  Fuzzy generic matching reported a literal impl
value against a value placeholder as Unequal, where an inference
variable (or a type placeholder) is Fuzzy, so the bound failed outright
(path.cpp). And once it can match, a bound whose impl binds the
placeholder decides nothing while another impl could bind it
differently, yet returned an exact match with the first impl's value.
Such a match is now a candidate like a fuzzy one: the search goes on,
a single candidate is used (quantette's `Oklab: ArrayCast<Array = [f32;
3]>`), and candidates that disagree leave the placeholder unbound so the
request's inference variable stays, as before 0192 (helpers.cpp).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---

diff --git a/src/hir/path.cpp b/src/hir/path.cpp
index b8002b1d..60805578 100644
--- a/src/hir/path.cpp
+++ b/src/hir/path.cpp
@@ -449,6 +449,11 @@ Ordering HIR::TraitPath::ord(const TraitPath& x) const
             if( val_t.is_Infer() || val_x.is_Infer() ) {
                 return Compare::Fuzzy;
             }
+            // A placeholder (an impl param left to its bounds) is as undecided as an ivar - as it is for types
+            // (`impl SupportedLaneCount for LaneCount<1>` against `LaneCount<{placeholder}>` must not be Unequal)
+            if( TU_TEST1(val_x, Generic, .is_placeholder()) ) {
+                return Compare::Fuzzy;
+            }
             if( val_t != val_x ) {
                 if( val_t.is_Unevaluated() || val_x.is_Unevaluated() ) {
                     return Compare::Fuzzy;
diff --git a/src/hir_typeck/helpers.cpp b/src/hir_typeck/helpers.cpp
index ed1f7a42..af6a9ef0 100644
--- a/src/hir_typeck/helpers.cpp
+++ b/src/hir_typeck/helpers.cpp
@@ -4061,6 +4061,23 @@ bool TraitResolution::find_trait_impls_crate(const Span& sp,
                     }
 
                     DEBUG("[ftic_check_params] impl_cmp = " << impl_cmp << ", cmp = " << cmp);
+                    // A bound whose impl bound a value placeholder (`LaneCount<N>: SupportedLaneCount` with N left to
+                    // the bounds, see GetParams::match_val) decides nothing while another impl could bind it
+                    // differently: it is a candidate like a fuzzy match. One candidate is used; disagreeing ones
+                    // leave the placeholder unbound, so the request's ivar stays.
+                    // - core_simd const_ptr.rs:106 `Simd::splat(..).simd_eq(self)` on `Simd<_, _>`: the first
+                    //   `LaneCount` impl bound N := 1 -> "No applicable methods for {Simd<_, Infer(0)>}.simd_eq"
+                    if( cmp == ::HIR::Compare::Equal )
+                    {
+                        bool values_bound = placeholders.m_values.size() != saved_ph.m_values.size();
+                        for(size_t i = 0; !values_bound && i < placeholders.m_values.size(); i ++) {
+                            values_bound = placeholders.m_values[i] != saved_ph.m_values[i];
+                        }
+                        if( values_bound ) {
+                            DEBUG("[ftic_check_params] This impl bound a value placeholder (" << placeholders.m_values << ") - a candidate, keep looking");
+                            cmp = ::HIR::Compare::Fuzzy;
+                        }
+                    }
                     if( cmp == ::HIR::Compare::Fuzzy )
                     {
                         found_fuzzy_match |= true;
