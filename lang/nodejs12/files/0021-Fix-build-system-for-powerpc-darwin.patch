From 394d266c8fcb58706afe57ad6987400c807dfba1 Mon Sep 17 00:00:00 2001
From: barracuda156 <vital.had@gmail.com>
Date: Wed, 26 Aug 2026 17:51:07 +0000
Subject: [PATCH] Fix build system for powerpc-darwin

- do not assume clang on mac when targeting ppc/ppc64; gcc is the only
  viable compiler there
- link libatomic where gcc needs it for 64-bit atomics on 32-bit
  targets; on mac this must go through xcode_settings (plain ldflags
  are ignored by the darwin gyp generators), but only for non-static
  targets: gyp passes OTHER_LDFLAGS to 'libtool -static' as well, and
  Apple libtool errors out on -l flags in static archives
- map __ppc__/__ppc64__ (Darwin gcc spellings) in host_arch_cc()
- respect the port's deployment target instead of hardcoding 10.10;
  set ppc/ppc64 ARCHS; drop -Wl,-no_pie and -Werror=undefined-inline
- O2 instead of O3, disable v8 debugging features (binary size: the
  32-bit linker address space is a hard constraint)
- define V8_TARGET_ARCH_PPC only for 32-bit ppc in toolchain.gypi
- unbreak cares config for non-x86 darwin
---
 common.gypi                            | 54 +++++++++++++++++++++++---
 configure.py                           |  4 +-
 deps/cares/config/darwin/ares_config.h |  2 +-
 node.gyp                               |  1 -
 node.gypi                              |  3 --
 tools/v8_gypfiles/toolchain.gypi       | 22 +++++++----
 6 files changed, 67 insertions(+), 19 deletions(-)

diff --git a/common.gypi b/common.gypi
index 2bfae46..9e1cb5a 100644
--- a/common.gypi
+++ b/common.gypi
@@ -38,6 +38,9 @@
 
     ##### V8 defaults for Node.js #####
 
+    # Try reduce ridiculous size of static libs.
+    'v8_enable_debugging_features': 0,
+
     # Old time default, now explicitly stated.
     'v8_use_snapshot': 1,
 
@@ -132,7 +135,7 @@
       }, {
         'openssl_product': '<(STATIC_LIB_PREFIX)openssl<(STATIC_LIB_SUFFIX)',
       }],
-      ['OS=="mac"', {
+      ['OS=="mac" and target_arch!="ppc" and target_arch!="ppc64"', {
         'clang%': 1,
       }],
       ['target_arch in "ppc64 s390x"', {
@@ -197,7 +200,7 @@
             }],
           ],
         },
-        'cflags': [ '-O3' ],
+        'cflags': [ '-O2' ],
         'conditions': [
           ['OS=="solaris"', {
             # pull in V8's postmortem metadata
@@ -240,7 +243,12 @@
           }
         },
         'xcode_settings': {
-          'GCC_OPTIMIZATION_LEVEL': '3', # stop gyp from defaulting to -Os
+          'GCC_OPTIMIZATION_LEVEL': '2', # stop gyp from defaulting to -Os
+          # gyp's xcode emulation injects -gdwarf-2 unless this is set (env
+          # CFLAGS never reach the compiler on mac). With debug info the v8
+          # static archives approach 2GB, which the 32-bit cctools libtool
+          # cannot vm_allocate.
+          'GCC_GENERATE_DEBUGGING_SYMBOLS': 'NO',
         },
       }
     },
@@ -460,8 +468,25 @@
           }],
         ],
       }],
+      # gcc needs libatomic for 64-bit atomics on 32-bit targets. On mac
+      # only xcode_settings are honored, plain ldflags are ignored, but
+      # OTHER_LDFLAGS also get passed to 'libtool -static', which rejects
+      # -l flags, so keep it away from static_library targets.
+      ['target_arch in "arm mips ppc"', {
+        'conditions': [
+          ['OS=="mac"', {
+            'target_conditions': [
+              ['_type!="static_library"', {
+                'xcode_settings': { 'OTHER_LDFLAGS': [ '-latomic' ] },
+              }],
+            ],
+          }, {
+            'ldflags': [ '-latomic' ],
+          }],
+        ],
+      }],
       ['OS=="mac"', {
-        'defines': ['_DARWIN_USE_64_BIT_INODE=1'],
+        'defines': ['_DARWIN_USE_64_BIT_INODE=1', '__STDC_FORMAT_MACROS', '_DARWIN_C_SOURCE'],
         'xcode_settings': {
           'ALWAYS_SEARCH_USER_PATHS': 'NO',
           'GCC_CW_ASM_SYNTAX': 'NO',                # No -fasm-blocks
@@ -471,10 +496,11 @@
           'GCC_ENABLE_CPP_RTTI': 'NO',              # -fno-rtti
           'GCC_ENABLE_PASCAL_STRINGS': 'NO',        # No -mpascal-strings
           'PREBINDING': 'NO',                       # No -Wl,-prebind
-          'MACOSX_DEPLOYMENT_TARGET': '10.10',      # -mmacosx-version-min=10.10
+          'MACOSX_DEPLOYMENT_TARGET': '@OSX_V@',      # -mmacosx-version-min=@OSX_V@
           'USE_HEADERMAP': 'NO',
           'OTHER_CFLAGS': [
             '-fno-strict-aliasing',
+            '-fpermissive',
           ],
           'WARNING_CFLAGS': [
             '-Wall',
@@ -487,7 +513,6 @@
           ['_type!="static_library"', {
             'xcode_settings': {
               'OTHER_LDFLAGS': [
-                '-Wl,-no_pie',
                 '-Wl,-search_paths_first',
               ],
             },
@@ -508,6 +533,23 @@
               ],
             },
           }],
+          # Pin the C++ standard: the block below setting gnu++1y is
+          # clang-only, and without an explicit -std modern gcc defaults
+          # to gnu++17 (gcc 11-15) or gnu++20 (gcc 16+), both untested
+          # with this V8 (C++20 breaks it outright: 'requires' keyword,
+          # rewritten comparison operators).
+          ['target_arch=="ppc"', {
+            'xcode_settings': {
+              'ARCHS': ['ppc'],
+              'OTHER_CPLUSPLUSFLAGS': ['-std=gnu++14'],
+            },
+          }],
+          ['target_arch=="ppc64"', {
+            'xcode_settings': {
+              'ARCHS': ['ppc64'],
+              'OTHER_CPLUSPLUSFLAGS': ['-std=gnu++14'],
+            },
+          }],
           ['clang==1', {
             'xcode_settings': {
               'GCC_VERSION': 'com.apple.compilers.llvm.clang.1_0',
diff --git a/configure.py b/configure.py
index e6485a7..1be6361 100755
--- a/configure.py
+++ b/configure.py
@@ -952,7 +952,9 @@ def host_arch_cc():
     '__MIPSEL__'  : 'mipsel',
     '__mips__'    : 'mips',
     '__PPC64__'   : 'ppc64',
-    '__PPC__'     : 'ppc64',
+    '__ppc64__'   : 'ppc64',
+    '__PPC__'     : 'ppc',
+    '__ppc__'     : 'ppc',
     '__x86_64__'  : 'x64',
     '__s390x__'   : 's390x',
   }
diff --git a/deps/cares/config/darwin/ares_config.h b/deps/cares/config/darwin/ares_config.h
index 6625ecc..c2e2069 100644
--- a/deps/cares/config/darwin/ares_config.h
+++ b/deps/cares/config/darwin/ares_config.h
@@ -354,7 +354,7 @@
 /* #undef NEED_THREAD_SAFE */
 
 /* cpu-machine-OS */
-#define OS "x86_64-apple-darwin16.7.0"
+/* #define OS "x86_64-apple-darwin16.7.0" */
 
 /* Name of package */
 #define PACKAGE "c-ares"
diff --git a/node.gyp b/node.gyp
index 3bb6ce3..d5dd0b1 100644
--- a/node.gyp
+++ b/node.gyp
@@ -297,7 +297,6 @@
         '-Wendif-labels',
         '-W',
         '-Wno-unused-parameter',
-        '-Werror=undefined-inline',
       ],
     },
 
diff --git a/node.gypi b/node.gypi
index 116c1c7..8b79045 100644
--- a/node.gypi
+++ b/node.gypi
@@ -26,9 +26,6 @@
   },
 
   'conditions': [
-    [ 'clang==1', {
-      'cflags': [ '-Werror=undefined-inline', ]
-    }],
     [ 'node_shared=="false" and "<(_type)"=="executable"', {
       'msvs_settings': {
         'VCManifestTool': {
diff --git a/tools/v8_gypfiles/toolchain.gypi b/tools/v8_gypfiles/toolchain.gypi
index 0876b16..680cfc7 100644
--- a/tools/v8_gypfiles/toolchain.gypi
+++ b/tools/v8_gypfiles/toolchain.gypi
@@ -291,10 +291,12 @@
           ],
       }],  # s390x
       ['v8_target_arch=="ppc" or v8_target_arch=="ppc64"', {
-        'defines': [
-          'V8_TARGET_ARCH_PPC',
-        ],
         'conditions': [
+          ['v8_target_arch=="ppc"', {
+            'defines': [
+              'V8_TARGET_ARCH_PPC',
+            ],
+          }],
           ['v8_target_arch=="ppc64"', {
             'defines': [
               'V8_TARGET_ARCH_PPC64',
@@ -1011,7 +1013,7 @@
               }],
             ],
             'xcode_settings': {
-              'ARCHS': [ 'i386' ],
+              'ARCHS': [ 'ppc' ],
             },
           }],
           ['_toolset=="target"', {
@@ -1029,12 +1031,12 @@
               }],
             ],
             'xcode_settings': {
-              'ARCHS': [ 'i386' ],
+              'ARCHS': [ 'ppc' ],
             },
           }],
         ],
       }],
-      ['(OS=="linux" or OS=="android") and \
+      ['(OS=="linux" or OS=="mac" or OS=="android") and \
         (v8_target_arch=="x64" or v8_target_arch=="arm64" or \
          v8_target_arch=="ppc64" or v8_target_arch=="s390x")', {
         'target_conditions': [
@@ -1045,6 +1047,9 @@
                 'ldflags': [ '-m64' ]
               }],
              ],
+             'xcode_settings': {
+               'ARCHS': [ 'ppc64' ],
+             },
            }],
           ['_toolset=="target"', {
              'conditions': [
@@ -1052,7 +1057,10 @@
                  'cflags': [ '-m64' ],
                  'ldflags': [ '-m64' ],
                }],
-             ]
+             ],
+             'xcode_settings': {
+               'ARCHS': [ 'ppc64' ],
+             },
            }],
          ],
       }],
