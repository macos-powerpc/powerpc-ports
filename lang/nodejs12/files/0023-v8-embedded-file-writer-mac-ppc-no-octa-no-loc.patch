From: Claude <noreply@anthropic.com>
Date: Thu, 27 Aug 2026 00:20:00 +0000
Subject: [PATCH] v8: embedded-file-writer: emit cctools-compatible asm on
 ppc-darwin

cctools as has no .octa pseudo-op, which the mac embedded file writer
uses (via the base-class default) for the embedded builtins blob, so
assembling mksnapshot's embedded.S fails. Override
ByteChunkDataDirective/WriteByteChunk to emit .long words instead,
mirroring the AIX writer (the other big-endian PPC target); the
generic chunk loop handles trailing bytes with .byte already.

Also drop the .loc/.file debug-line directives on ppc: numbered .file
and .loc support in cctools is doubtful, and debug line info is
dispensable for the embedded blob.

Directives already proven fine with this assembler (.private_extern,
.balign, .long, // comments) are left untouched.
---
 .../embedded/platform-embedded-file-writer-mac.cc  | 30 ++++++++++++++++++++++
 .../embedded/platform-embedded-file-writer-mac.h   |  5 ++++
 2 files changed, 35 insertions(+)

--- a/deps/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.cc
+++ b/deps/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.cc
@@ -4,6 +4,8 @@
 
 #include "src/snapshot/embedded/platform-embedded-file-writer-mac.h"
 
+#include <cstring>  // For memcpy.
+
 namespace v8 {
 namespace internal {
 
@@ -75,7 +77,11 @@
 
 void PlatformEmbeddedFileWriterMac::SourceInfo(int fileid, const char* filename,
                                                int line) {
+#if !(defined(V8_TARGET_ARCH_PPC) || defined(V8_TARGET_ARCH_PPC64))
+  // Omitted on ppc: cctools as does not support the .loc directive. Debug
+  // line info is dispensable for the embedded blob.
   fprintf(fp_, ".loc %d %d\n", fileid, line);
+#endif
 }
 
 void PlatformEmbeddedFileWriterMac::DeclareFunctionBegin(const char* name) {
@@ -95,7 +101,10 @@
 
 void PlatformEmbeddedFileWriterMac::DeclareExternalFilename(
     int fileid, const char* filename) {
+#if !(defined(V8_TARGET_ARCH_PPC) || defined(V8_TARGET_ARCH_PPC64))
+  // Omitted on ppc: cctools as does not support numbered .file directives.
   fprintf(fp_, ".file %d \"%s\"\n", fileid, filename);
+#endif
 }
 
 void PlatformEmbeddedFileWriterMac::FileEpilogue() {}
@@ -105,5 +114,22 @@
   return fprintf(fp_, "  %s ", DirectiveAsString(directive));
 }
 
+#if defined(V8_TARGET_ARCH_PPC) || defined(V8_TARGET_ARCH_PPC64)
+DataDirective PlatformEmbeddedFileWriterMac::ByteChunkDataDirective() const {
+  // cctools as does not support the .octa directive. PPC uses a fixed 4 byte
+  // instruction set, so using .long matches the AIX writer and prevents any
+  // unnecessary padding.
+  return kLong;
+}
+
+int PlatformEmbeddedFileWriterMac::WriteByteChunk(const uint8_t* data) {
+  DCHECK_EQ(ByteChunkDataDirective(), kLong);
+  // Use memcpy for the read since {data} is not guaranteed to be aligned.
+  uint32_t value;
+  memcpy(&value, data, sizeof(value));
+  return HexLiteral(value);
+}
+#endif
+
 }  // namespace internal
 }  // namespace v8
--- a/deps/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.h
+++ b/deps/v8/src/snapshot/embedded/platform-embedded-file-writer-mac.h
@@ -47,6 +47,11 @@
 
   int IndentedDataDirective(DataDirective directive) override;
 
+#if defined(V8_TARGET_ARCH_PPC) || defined(V8_TARGET_ARCH_PPC64)
+  DataDirective ByteChunkDataDirective() const override;
+  int WriteByteChunk(const uint8_t* data) override;
+#endif
+
  private:
   void DeclareSymbolGlobal(const char* name);
 
-- 
2.39.5
