From 796cea925783b20984bc41d08129419ecce3d362 Mon Sep 17 00:00:00 2001
From: barracuda156 <vital.had@gmail.com>
Date: Wed, 26 Aug 2026 17:47:43 +0000
Subject: [PATCH 15/21] ppc: add Darwin 32-bit ABI support

The 32-bit ppc constants introduced by the ppc32 patchset describe the
SysV/ELF ABI (8-byte linkage area, LR save at 4(r1), stack parameters
at 8(r1)). Darwin uses an AIX-like ABI instead: 24-byte linkage area
with the LR save word at 8(r1), a caller-allocated 32-byte parameter
save area at 24(r1), and 16-byte stack alignment.

With the SysV constants, any C function called from generated code
stores its LR at 8(r1) and may home its parameters at 24(r1)..55(r1),
clobbering the caller's frame contents - i.e. silent stack corruption
on every CallCFunction / CEntry / JSEntry crossing.

Also mark Darwin as passing handles in registers: like AIX (and unlike
32-bit SysV), the Darwin ABI passes small aggregates by value in GPRs.
---
 deps/v8/src/codegen/ppc/constants-ppc.h |  2 +-
 deps/v8/src/codegen/ppc/register-ppc.h  | 22 +++++++++++++++++++++-
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/deps/v8/src/codegen/ppc/constants-ppc.h b/deps/v8/src/codegen/ppc/constants-ppc.h
index 2b481b18..2432cc7f 100644
--- a/deps/v8/src/codegen/ppc/constants-ppc.h
+++ b/deps/v8/src/codegen/ppc/constants-ppc.h
@@ -29,7 +29,7 @@
 #endif
 
 #if !(V8_HOST_ARCH_PPC || V8_HOST_ARCH_PPC64) || V8_OS_AIX || \
-    V8_TARGET_ARCH_PPC64
+    V8_TARGET_ARCH_PPC64 || V8_OS_MACOSX
 #define ABI_PASSES_HANDLES_IN_REGS 1
 #else
 #define ABI_PASSES_HANDLES_IN_REGS 0
diff --git a/deps/v8/src/codegen/ppc/register-ppc.h b/deps/v8/src/codegen/ppc/register-ppc.h
index 1aa1d338..684307a6 100644
--- a/deps/v8/src/codegen/ppc/register-ppc.h
+++ b/deps/v8/src/codegen/ppc/register-ppc.h
@@ -145,7 +145,27 @@ const int kNumSafepointRegisters = 32;
 // The following constants describe the stack frame linkage area as
 // defined by the ABI.  Note that kNumRequiredStackFrameSlots must
 // satisfy alignment requirements (rounding up if required).
-#if V8_TARGET_ARCH_PPC
+#if V8_TARGET_ARCH_PPC && V8_OS_MACOSX
+// Darwin 32-bit ABI (AIX-like linkage area, 4-byte slots):
+// [0] back chain
+// [1] saved CR
+// [2] saved LR
+// [3] reserved
+// [4] reserved
+// [5] saved TOC (unused on Darwin)
+// [6] Parameter1 save area
+// ...
+// [13] Parameter8 save area
+// [14] Parameter9 slot (if necessary)
+// ...
+// The caller must always allocate the linkage area plus the 32-byte
+// parameter save area (14 slots, 56 bytes); round up to 16 slots (64
+// bytes) to keep the stack 16-byte aligned as the ABI requires.
+const int kNumRequiredStackFrameSlots = 16;
+const int kStackFrameLRSlot = 2;
+const int kStackFrameExtraParamSlot = 14;
+#elif V8_TARGET_ARCH_PPC
+// 32-bit SysV/ELF ABI (Linux).
 const int kNumRequiredStackFrameSlots = 4;
 const int kStackFrameLRSlot = 1;
 const int kStackFrameExtraParamSlot = 2;
