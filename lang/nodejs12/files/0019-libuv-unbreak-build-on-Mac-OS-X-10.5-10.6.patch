From 2cb57f300efb8d6727a5958ebf55cb9a04c1185a Mon Sep 17 00:00:00 2001
From: barracuda156 <vital.had@gmail.com>
Date: Wed, 26 Aug 2026 17:49:40 +0000
Subject: [PATCH 19/21] libuv: unbreak build on Mac OS X 10.5/10.6

pthread_setname_np is 10.6+; IP_ADD_SOURCE_MEMBERSHIP needs the 10.7
SDK.
---
 deps/uv/src/unix/darwin-proctitle.c | 5 +++++
 deps/uv/src/unix/udp.c              | 9 +++++++--
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/deps/uv/src/unix/darwin-proctitle.c b/deps/uv/src/unix/darwin-proctitle.c
index 5288083e..6f07fdf7 100644
--- a/deps/uv/src/unix/darwin-proctitle.c
+++ b/deps/uv/src/unix/darwin-proctitle.c
@@ -28,6 +28,7 @@
 #include <string.h>
 
 #include <TargetConditionals.h>
+#include <AvailabilityMacros.h>
 
 #if !TARGET_OS_IPHONE
 #include "darwin-stub.h"
@@ -41,9 +42,13 @@ static int uv__pthread_setname_np(const char* name) {
   strncpy(namebuf, name, sizeof(namebuf) - 1);
   namebuf[sizeof(namebuf) - 1] = '\0';
 
+#if TARGET_OS_IPHONE || (MAC_OS_X_VERSION_MIN_REQUIRED >= 1060)
   err = pthread_setname_np(namebuf);
   if (err)
     return UV__ERR(err);
+#else
+  (void) err;  /* pthread_setname_np is 10.6+ */
+#endif
 
   return 0;
 }
diff --git a/deps/uv/src/unix/udp.c b/deps/uv/src/unix/udp.c
index 7d699a16..0f8f9927 100644
--- a/deps/uv/src/unix/udp.c
+++ b/deps/uv/src/unix/udp.c
@@ -31,6 +31,9 @@
 #include <xti.h>
 #endif
 #include <sys/un.h>
+#if defined(__APPLE__)
+#include <AvailabilityMacros.h>
+#endif
 
 #define UV__UDP_DGRAM_MAXSIZE (64 * 1024)
 
@@ -855,7 +858,8 @@ static int uv__udp_set_membership6(uv_udp_t* handle,
     !defined(__NetBSD__) &&                                         \
     !defined(__ANDROID__) &&                                        \
     !defined(__DragonFly__) &                                       \
-    !defined(__QNX__)
+    !defined(__QNX__) &&                                            \
+    (!defined(__APPLE__) || MAC_OS_X_VERSION_MAX_ALLOWED >= 1070)
 static int uv__udp_set_source_membership4(uv_udp_t* handle,
                                           const struct sockaddr_in* multicast_addr,
                                           const char* interface_addr,
@@ -1047,7 +1051,8 @@ int uv_udp_set_source_membership(uv_udp_t* handle,
     !defined(__NetBSD__) &&                                         \
     !defined(__ANDROID__) &&                                        \
     !defined(__DragonFly__) &&                                      \
-    !defined(__QNX__)
+    !defined(__QNX__) &&                                            \
+    (!defined(__APPLE__) || MAC_OS_X_VERSION_MAX_ALLOWED >= 1070)
   int err;
   union uv__sockaddr mcast_addr;
   union uv__sockaddr src_addr;
