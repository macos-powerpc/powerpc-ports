# bnoordhuis/v8-cmake has no 12.4 tag, so 0000-v8-cmake-build-harness.patch
# carries the harness itself: the 13 files of v8-cmake proper
# (CMakeLists.txt, cmake/, patches/, update_v8.*) with the CMake side based
# on the upstream 11.6 tag plus the v8-9.4 port's ppc wiring and the 12.4
# deltas (C++20; vendored abseil via add_subdirectory, EXCLUDE_FROM_ALL,
# closure linked into v8_libbase; third_party/glibc math sources; fp16
# include path; torque list regenerated from BUILD.gn; sparkplug/maglev and
# all 64-bit-only features off; POSIX trap-handler gated to x64/arm64; the
# CFI-deoptimizer and vtune TUs dropped from the GLOBs), and the one source
# edit update_v8.py would apply at import time (code_generator.py must not
# lstrip('/') an absolute inspector-protocol dir). Nothing else - the
# whole v8/ tree arrives verbatim from the node distfile, and the series
# below applies with no fuzz, no offsets, no rejects.

# The ppc-darwin series, re-derived for 12.4 from the G5-validated v8-9.4
# series (every 9.4 patch is accounted for; 9.4's 0007/0014/0028/0035
# proved obsolete at 12.4 - fixed upstream, covered by v8config detection,
# carried in-harness, and refuted by a selector-overlap audit respectively).
# Highlights of what changed shape at 12.4:
# - the instruction selector is template<Adapter> (Turbofan/Turboshaft);
#   all selector patches are re-derived in template form and validated for
#   both instantiations (0005-0006: 32-bit guards, restored pair-op
#   visitors upstream had deleted from the ppc backend).
# - 0001-0003 patch the now-required vendored abseil for darwin-ppc
#   (pthread_mach_thread_np fallback, copts/hwaes, TLS gate for
#   gcc/libstdc++, C++17-types workaround gated to libc++).
# - Liftoff: upstream implemented full ppc64 Liftoff; on ppc32 it stays
#   disabled (PrepareStackFrame bails to TurboFan) and the 64-bit-only
#   paths are compiled out (0032-0033), including upstream's uncompilable
#   generic register-defs fallback.
# - SharedArrayBuffer atomics: upstream deleted both MIPS32's per-lane
#   guards and its own PPC runtime routing, so 0035 routes 64-bit
#   Atomics.load/store and whole-op exchange/compareExchange/add/sub/and/
#   or/xor through the C++ runtime (libatomic; sub-word ops become
#   word-masked lwarx loops - no lbarx/lharx on G3/G4/G5).
# - bool-ABI (4-byte big-endian bool): upstream has adopted uint8_t flag
#   bytes nearly everywhere since 9.4; 0036-0037 fix the survivors
#   (Debug::is_active_/hook_on_function_call_, javascript_execution_assert,
#   four fast-API sizeof(bool) asserts across both compiler pipelines).
# Known limitations: wasm-threads i64/sub-word atomics would reach
# named-operator fatals if a module using them is instantiated (the
# feature-disable is on the deferred list); wasm SIMD modules are rejected
# with a clean CompileError (SupportsWasmSimd128 is false below POWER9).

# Any modern python works: the only build-time python consumer is the
# inspector code_generator.py, which sys.path-inserts --jinja_dir ahead of
# site-packages and therefore always uses the VENDORED jinja2 3.1.2 +
# markupsafe (no py-jinja2 port needed, unlike v8-9.4 whose comment
# predates checking this).  Verified with CPython 3.14.7: configure clean,
# generated inspector sources byte-identical to a 3.12 run.
set py_ver              3.14
set py_ver_nodot        [string map {. {}} ${py_ver}]

# ICU i18n: the harness builds V8 with V8_INTL_SUPPORT against MacPorts'
# ICU (CMake's FindICU; V8 12.4 static-asserts ICU >= 73), which is what
# upstream does by default and brings the whole JS Intl.* namespace,
# RegExp Unicode property escapes (\p{...} under /u - the biggest
# ecosystem hit when absent), real localeCompare, String.prototype.
# normalize and locale-aware case mapping. Beyond the intl sources the
# harness builds and runs V8's gen-regexp-special-case tool, whose output
# (the ECMAScript case-folding special cases, derived from ICU data)
# compiles into v8_base. The installed archive set is unchanged, but
# the archives now reference libicui18n/libicuuc/libicudata: an embedder
# linking them supplies those itself - nodejs22 is configured
# --with-intl=system-icu for that reason, and the two ports flip
# together. d8 links the ICU dylibs. (The gettext/glib2 dependencies
# the port used to carry were never referenced by the CMake build.)
depends_build-append    port:python${py_ver_nodot}
depends_lib-append      path:lib/pkgconfig/icu-uc.pc:icu

configure.python        ${prefix}/bin/python${py_ver}

# Unpacking all of node would cost ~1 GB for the 98 MB subtree we want, so
# the extract phase pulls out deps/v8 by hand instead.
extract {
    system -W ${workpath} "${extract.cmd} ${extract.pre_args} \
        ${distpath}/node-v${node_version}${extract.suffix} \
        | tar -xf - node-v${node_version}/deps/v8"

    xinstall -d ${worksrcpath}
    move ${workpath}/node-v${node_version}/deps/v8 ${worksrcpath}/v8
    delete ${workpath}/node-v${node_version}
}

