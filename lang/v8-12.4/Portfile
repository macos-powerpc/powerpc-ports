# V8 12.4.254 is the V8 vendored by the nodejs-22 LTS line.
name                    v8-12.4
version                 12.4.254.21
# revision 1: embedder features node expects (promise hooks, promise internal
# field, siphash) + BUILD.gn feature defaults the harness had missed, and
# ICU i18n on (see the ICU comment below) - all in
# files/0000-v8-cmake-build-harness.patch; the archives change, so rebuild.
revision                1

# The engine comes from node's release tarball rather than the upstream v8
# archive for the same reasons as v8-9.4: node-22 ships this exact V8 with
# its own floating patches, and that patched tree is what the ppc-darwin
# series below was derived against; and node vendors every V8 DEPS checkout
# the CMake build needs (abseil-cpp complete with its own CMakeLists,
# third_party/glibc ieee754 math, fp16, jinja2, markupsafe, zlib,
# inspector_protocol, trace_event).  Verified byte- and mode-identical:
# node-v22.23.2/deps/v8 IS the port's v8/ tree, no exceptions.
#
# Unlike v8-9.4, no googletest distfile: the 12.4 harness excludes
# crdtp/status_test_support.cc (the one test-target file the crdtp GLOB
# used to sweep in), so node's googletest copy - pruned to gtest_prod.h -
# is sufficient.
#
# NOTE: node 22 receives maintenance releases until 2027-04. The engine
# stays 12.4.254.x, but on a distfile bump re-verify that the series still
# applies without fuzz (upstream floats patches into deps/v8).
set node_version        22.23.2

use_xz                  yes

master_sites            https://nodejs.org/dist/v${node_version}/

