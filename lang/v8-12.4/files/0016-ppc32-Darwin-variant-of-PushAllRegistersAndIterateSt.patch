From 34653788e04430e84fc5cdfc9e2f66c6626dc528 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:34:41 +0000
Subject: [PATCH 16/52] ppc32: Darwin variant of
 PushAllRegistersAndIterateStack

The cppgc conservative-stack-scan helper was written for ELF ppc64 and
AIX only: cctools' assembler has no .type/.hidden pseudo-ops, requires
rN register operand names, and Mach-O C symbols carry a leading
underscore -- and the body is 64-bit (std/stdu/ld) besides.

Add a Darwin 32-bit branch following the pattern of the x64 file's
__APPLE__ block: 24-byte linkage area with lr saved at 8(r1) in the
caller's frame, a 144-byte 16-byte-aligned frame with a 32-byte
parameter area for the callback call, and all nonvolatile GPRs
(r13..r31, per the Darwin ABI -- r13 is nonvolatile here, unlike SysV)
pushed at sp+56..sp+128 where the scan walking upward from sp sees
them. The ELF/AIX asm is unchanged under !__APPLE__.

Found by the G5 build (error #6). The 8.x harnesses never compiled
heap/base/asm at all; this surface is new with the 9.4 harness.

[Re-anchored onto 12.4 from the 9.4 series; hunks applied without modification.]
---
 .../heap/base/asm/ppc/push_registers_asm.cc   | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/v8/src/heap/base/asm/ppc/push_registers_asm.cc b/v8/src/heap/base/asm/ppc/push_registers_asm.cc
index f879980..2077c63 100644
--- a/v8/src/heap/base/asm/ppc/push_registers_asm.cc
+++ b/v8/src/heap/base/asm/ppc/push_registers_asm.cc
@@ -16,6 +16,65 @@
 
 // AIX Runtime process stack:
 // https://www.ibm.com/support/knowledgecenter/ssw_aix_71/assembler/idalangref_runtime_process.html
+
+#if defined(__APPLE__)
+// Darwin PowerPC, 32-bit only (Mach-O, cctools assembler): no .type or
+// .hidden pseudo-ops, C symbols carry a leading underscore, and register
+// operands must be written r0..r31.
+//
+// Darwin 32-bit PowerPC ABI: r1 is the stack pointer, 16-byte aligned at
+// calls; the caller's linkage area is 24 bytes (back chain, saved CR at 4,
+// saved LR at 8, three reserved words); the parameter area starts at
+// sp+24; GPR13..GPR31 are nonvolatile.
+//
+// Frame layout: 24-byte linkage + 32-byte parameter area for the callback
+// call + r13..r31 save slots at sp+56..sp+128 + 12 bytes of padding =
+// 144 bytes, preserving 16-byte alignment.
+asm(".text                                              \n"
+    ".align 2                                           \n"
+    ".globl _PushAllRegistersAndIterateStack            \n"
+    ".private_extern _PushAllRegistersAndIterateStack   \n"
+    "_PushAllRegistersAndIterateStack:                  \n"
+    // Save lr in the caller's linkage area.
+    "  mflr r0                                          \n"
+    "  stw r0, 8(r1)                                    \n"
+    "  stwu r1, -144(r1)                                \n"
+    // Push all callee-saved registers so the conservative scan sees them.
+    "  stw r13, 56(r1)                                  \n"
+    "  stw r14, 60(r1)                                  \n"
+    "  stw r15, 64(r1)                                  \n"
+    "  stw r16, 68(r1)                                  \n"
+    "  stw r17, 72(r1)                                  \n"
+    "  stw r18, 76(r1)                                  \n"
+    "  stw r19, 80(r1)                                  \n"
+    "  stw r20, 84(r1)                                  \n"
+    "  stw r21, 88(r1)                                  \n"
+    "  stw r22, 92(r1)                                  \n"
+    "  stw r23, 96(r1)                                  \n"
+    "  stw r24, 100(r1)                                 \n"
+    "  stw r25, 104(r1)                                 \n"
+    "  stw r26, 108(r1)                                 \n"
+    "  stw r27, 112(r1)                                 \n"
+    "  stw r28, 116(r1)                                 \n"
+    "  stw r29, 120(r1)                                 \n"
+    "  stw r30, 124(r1)                                 \n"
+    "  stw r31, 128(r1)                                 \n"
+    // Pass 1st parameter (r3) unchanged (Stack*).
+    // Pass 2nd parameter (r4) unchanged (StackVisitor*).
+    // Save 3rd parameter (r5; IterateStackCallback).
+    "  mr r6, r5                                        \n"
+    // Pass 3rd parameter as sp (stack pointer).
+    "  mr r5, r1                                        \n"
+    // Call the callback.
+    "  mtctr r6                                         \n"
+    "  bctrl                                            \n"
+    // Discard all the registers.
+    "  addi r1, r1, 144                                 \n"
+    // Restore lr.
+    "  lwz r0, 8(r1)                                    \n"
+    "  mtlr r0                                          \n"
+    "  blr                                              \n");
+#else  // !defined(__APPLE__)
 asm(
 #if defined(_AIX)
     ".csect .text[PR]                                   \n"
@@ -95,3 +154,4 @@ asm(
     "  ld 2, 24(1)                                     \n"
 #endif
     "  blr                                             \n");
+#endif  // !defined(__APPLE__)
-- 
2.43.0

