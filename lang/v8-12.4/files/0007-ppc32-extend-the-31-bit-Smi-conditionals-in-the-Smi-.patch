From 3a3f48655a3578a6697350c3d652a58313accd53 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:32:59 +0000
Subject: [PATCH 07/52] ppc32: extend the 31-bit-Smi conditionals in the Smi
 masm helpers

12.4 re-derivation of the 9.4-series patch 0013, byte-for-byte in
spirit: on 32-bit, Smis are 31-bit just as under pointer compression,
so extend the V8_COMPRESS_POINTERS || V8_31BIT_SMIS_ON_64BIT_ARCH
conditionals with V8_TARGET_ARCH_PPC in the five SmiLiteral helpers
(Cmp/Cmpl/Add/Sub/AndSmiLiteral - their fast paths use the
width-lowered CmpS32/CmpU64/AddS64/AndU64 helpers and are correct for
32-bit Smis), in SmiToPtrArrayOffset (the 64-bit else branch computes
kSmiShift - kSystemPointerSizeLog2 which underflows for kSmiShift ==
1), and around the upper-half-int static_assert block (which requires
kSmiTagSize + kSmiShiftSize == 32).  The only drift since 9.4 is
cosmetic: Smi parameters became Tagged<Smi> and STATIC_ASSERT became
static_assert.

Both header asserts were the first hard errors in the cross-g++14
-fsyntax-only run of the selector TU; with this patch that run is
error-free until cc1plus exhausts the box's memory in late template
instantiation (no diagnostics in any ppc file).
---
 v8/src/codegen/ppc/macro-assembler-ppc.cc | 15 ++++++++++-----
 v8/src/codegen/ppc/macro-assembler-ppc.h  |  6 ++++--
 2 files changed, 14 insertions(+), 7 deletions(-)

diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index 5012ecc..c142cad 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -3833,7 +3833,8 @@ void MacroAssembler::CopySignF64(DoubleRegister dst, DoubleRegister lhs,
 
 void MacroAssembler::CmpSmiLiteral(Register src1, Tagged<Smi> smi,
                                    Register scratch, CRegister cr) {
-#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH)
+#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH) || \
+    defined(V8_TARGET_ARCH_PPC)
   CmpS32(src1, Operand(smi), scratch, cr);
 #else
   LoadSmiLiteral(scratch, smi);
@@ -3843,7 +3844,8 @@ void MacroAssembler::CmpSmiLiteral(Register src1, Tagged<Smi> smi,
 
 void MacroAssembler::CmplSmiLiteral(Register src1, Tagged<Smi> smi,
                                     Register scratch, CRegister cr) {
-#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH)
+#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH) || \
+    defined(V8_TARGET_ARCH_PPC)
   CmpU64(src1, Operand(smi), scratch, cr);
 #else
   LoadSmiLiteral(scratch, smi);
@@ -3853,7 +3855,8 @@ void MacroAssembler::CmplSmiLiteral(Register src1, Tagged<Smi> smi,
 
 void MacroAssembler::AddSmiLiteral(Register dst, Register src, Tagged<Smi> smi,
                                    Register scratch) {
-#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH)
+#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH) || \
+    defined(V8_TARGET_ARCH_PPC)
   AddS64(dst, src, Operand(smi.ptr()), scratch);
 #else
   LoadSmiLiteral(scratch, smi);
@@ -3863,7 +3866,8 @@ void MacroAssembler::AddSmiLiteral(Register dst, Register src, Tagged<Smi> smi,
 
 void MacroAssembler::SubSmiLiteral(Register dst, Register src, Tagged<Smi> smi,
                                    Register scratch) {
-#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH)
+#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH) || \
+    defined(V8_TARGET_ARCH_PPC)
   AddS64(dst, src, Operand(-(static_cast<intptr_t>(smi.ptr()))), scratch);
 #else
   LoadSmiLiteral(scratch, smi);
@@ -3873,7 +3877,8 @@ void MacroAssembler::SubSmiLiteral(Register dst, Register src, Tagged<Smi> smi,
 
 void MacroAssembler::AndSmiLiteral(Register dst, Register src, Tagged<Smi> smi,
                                    Register scratch, RCBit rc) {
-#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH)
+#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH) || \
+    defined(V8_TARGET_ARCH_PPC)
   AndU64(dst, src, Operand(smi), scratch, rc);
 #else
   LoadSmiLiteral(scratch, smi);
diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.h b/v8/src/codegen/ppc/macro-assembler-ppc.h
index 4904546..f1d7ace 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.h
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.h
@@ -1102,7 +1102,8 @@ class V8_EXPORT_PRIVATE MacroAssembler : public MacroAssemblerBase {
   // Pointer compression Support
 
   void SmiToPtrArrayOffset(Register dst, Register src) {
-#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH)
+#if defined(V8_COMPRESS_POINTERS) || defined(V8_31BIT_SMIS_ON_64BIT_ARCH) || \
+    defined(V8_TARGET_ARCH_PPC)
     static_assert(kSmiTag == 0 && kSmiShift < kSystemPointerSizeLog2);
     ShiftLeftU64(dst, src, Operand(kSystemPointerSizeLog2 - kSmiShift));
 #else
@@ -1845,7 +1846,8 @@ class V8_EXPORT_PRIVATE MacroAssembler : public MacroAssemblerBase {
     bne(not_smi_label, cr0);
   }
 
-#if !defined(V8_COMPRESS_POINTERS) && !defined(V8_31BIT_SMIS_ON_64BIT_ARCH)
+#if !defined(V8_COMPRESS_POINTERS) && !defined(V8_31BIT_SMIS_ON_64BIT_ARCH) && \
+    !defined(V8_TARGET_ARCH_PPC)
   // Ensure it is permissible to read/write int value directly from
   // upper half of the smi.
   static_assert(kSmiTag == 0);
-- 
