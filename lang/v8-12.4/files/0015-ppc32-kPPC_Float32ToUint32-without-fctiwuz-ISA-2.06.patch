From fc7adc2a09ecc9f9b13be0526b18e4641d88bec0 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:34:41 +0000
Subject: [PATCH 15/52] ppc32: kPPC_Float32ToUint32 without fctiwuz (ISA 2.06)

fctiwuz does not exist on G3/G4/G5.  A float32 held in an FPR is a
valid double, so reuse the DoubleToUint32 two-range sequence ([0,2^31)
converts directly; [2^31,2^32) converts input-2^31 and restores the top
bit).  NaN takes the direct path and sets FPSCR[VXCVI], which the
saturating wrapper below turns into 0; other out-of-range inputs are
excluded by the consumers' own range checks, as in the kPPC_DoubleToUint32
case.  kPPC_Float32ToInt32 already uses fctiwz (base FPU) and needs no
change.

[Re-anchored onto 12.4 from the 9.4 series; hunks applied without modification.]
---
 .../backend/ppc/code-generator-ppc.cc         | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/v8/src/compiler/backend/ppc/code-generator-ppc.cc b/v8/src/compiler/backend/ppc/code-generator-ppc.cc
index b65544f..60b9201 100644
--- a/v8/src/compiler/backend/ppc/code-generator-ppc.cc
+++ b/v8/src/compiler/backend/ppc/code-generator-ppc.cc
@@ -1909,8 +1909,34 @@ CodeGenerator::CodeGenResult CodeGenerator::AssembleArchInstruction(
       if (set_overflow_to_min_u32) {
         __ mtfsb0(VXCVI);  // clear FPSCR:VXCVI bit
       }
+#if V8_TARGET_ARCH_PPC64
       __ fctiwuz(kScratchDoubleReg, i.InputDoubleRegister(0));
       __ MovDoubleLowToInt(i.OutputRegister(), kScratchDoubleReg);
+#else
+      {
+        // fctiwuz is ISA 2.06 (POWER7+), absent on G3/G4/G5.  A float32
+        // held in an FPR is a valid double, so reuse the DoubleToUint32
+        // two-range sequence: [0,2^31) converts directly, [2^31,2^32)
+        // converts input-2^31 and restores the top bit.  NaN takes the
+        // direct path and sets VXCVI for the saturating wrapper below;
+        // other out-of-range inputs are excluded by the consumers.
+        Label above31, done_u;
+        __ LoadDoubleLiteral(kScratchDoubleReg, base::Double(2147483648.0),
+                             kScratchReg);
+        __ fcmpu(i.InputDoubleRegister(0), kScratchDoubleReg);
+        __ bge(&above31);
+        __ ConvertDoubleToInt32(i.InputDoubleRegister(0), i.OutputRegister(0),
+                                kScratchDoubleReg);
+        __ b(&done_u);
+        __ bind(&above31);
+        __ fsub(kScratchDoubleReg, i.InputDoubleRegister(0),
+                kScratchDoubleReg);
+        __ ConvertDoubleToInt32(kScratchDoubleReg, i.OutputRegister(0),
+                                kScratchDoubleReg);
+        __ xoris(i.OutputRegister(0), i.OutputRegister(0), Operand(0x8000));
+        __ bind(&done_u);
+      }
+#endif
       if (set_overflow_to_min_u32) {
         // Avoid UINT32_MAX as an overflow indicator and use 0 instead,
         // because 0 allows easier out-of-bounds detection.
-- 
