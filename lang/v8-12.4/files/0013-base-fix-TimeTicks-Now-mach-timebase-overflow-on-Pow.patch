From a03d8692f6c63cc9d2b3f80e2a37fff0304e6a86 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:34:19 +0000
Subject: [PATCH 13/52] base: fix TimeTicks::Now() mach timebase overflow on
 PowerPC Darwin

On PowerPC the timebase ticks at tens of MHz, so numer/denom is
~1000000000/33333333 rather than 1/1: the upstream expression divides
by 1000 first and then multiplies by numer, which wraps uint64_t after
a few days of host uptime, turning the monotonic clock into a sawtooth
(GC heuristics, compiler dispatcher and profiler deadlines all consume
it). Split the scaling so no intermediate exceeds 2^64. Same fix as
nodejs12 ppc-darwin patch 0027 (and the standalone MacPorts libuv fix
d67b01ad for the identical pattern).

[Re-anchored onto 12.4 from the 9.4 series; hunks applied without modification.]
---
 v8/src/base/platform/time.cc | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/v8/src/base/platform/time.cc b/v8/src/base/platform/time.cc
index dda0823..ae8caf4 100644
--- a/v8/src/base/platform/time.cc
+++ b/v8/src/base/platform/time.cc
@@ -742,8 +742,15 @@ TimeTicks TimeTicks::Now() {
     DCHECK_EQ(KERN_SUCCESS, result);
     USE(result);
   }
-  ticks = (mach_absolute_time() / Time::kNanosecondsPerMicrosecond *
-           info.numer / info.denom);
+  // On PowerPC the timebase ticks at tens of MHz, so numer/denom is
+  // ~1000000000/33333333 rather than 1/1: multiplying the raw tick count by
+  // numer overflows uint64_t within minutes of host uptime, and dividing by
+  // 1000 first only defers the wrap to a few days. Split the scaling so no
+  // intermediate value can exceed 2^64.
+  uint64_t t = mach_absolute_time();
+  ticks = ((t / info.denom) * info.numer +
+           (t % info.denom) * info.numer / info.denom) /
+          Time::kNanosecondsPerMicrosecond;
 #elif V8_OS_SOLARIS
   ticks = (gethrtime() / Time::kNanosecondsPerMicrosecond);
 #elif V8_OS_FUCHSIA
