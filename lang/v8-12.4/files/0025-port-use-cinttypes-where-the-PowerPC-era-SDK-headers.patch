From 5fc16b38bfacd6853992b1cb2bf37bb9aea1355c Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:42:44 +0000
Subject: [PATCH 25/52] port: use cinttypes where the PowerPC-era SDK headers
 need it

12.4 re-derivation of the 9.4-series patch 0011, reduced to the two
hunks that still apply: v8-runtime-agent-impl.cc and
module-instantiate.cc get <cinttypes> so the PRI* format macros come
from the C++ header on the 10.4/10.5 SDKs.  The rest of the 9.4 patch
is obsolete upstream: base/logging.h and v8-string-conversions.h
already include <cstdint>, and the mips/mips64 backends (two more
cinttypes hunks) were removed from V8 entirely.  The arm64 constants
hunk is dropped as that header is never compiled on this target.
---
 v8/src/inspector/v8-runtime-agent-impl.cc | 2 +-
 v8/src/wasm/module-instantiate.cc         | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/v8/src/inspector/v8-runtime-agent-impl.cc b/v8/src/inspector/v8-runtime-agent-impl.cc
index 9741121..2e3fbff 100644
--- a/v8/src/inspector/v8-runtime-agent-impl.cc
+++ b/v8/src/inspector/v8-runtime-agent-impl.cc
@@ -30,7 +30,7 @@
 
 #include "src/inspector/v8-runtime-agent-impl.h"
 
-#include <inttypes.h>
+#include <cinttypes>
 
 #include <memory>
 
diff --git a/v8/src/wasm/module-instantiate.cc b/v8/src/wasm/module-instantiate.cc
index 51b9d1e..c41ec16 100644
--- a/v8/src/wasm/module-instantiate.cc
+++ b/v8/src/wasm/module-instantiate.cc
@@ -4,6 +4,8 @@
 
 #include "src/wasm/module-instantiate.h"
 
+#include <cinttypes>
+
 #include "src/api/api-inl.h"
 #include "src/asmjs/asm-js.h"
 #include "src/base/atomicops.h"
-- 
2.43.0

