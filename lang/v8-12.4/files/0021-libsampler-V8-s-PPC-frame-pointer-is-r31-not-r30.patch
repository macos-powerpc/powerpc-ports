From 864dace410c317a34e102dc4693090d152c948c6 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:38:24 +0000
Subject: [PATCH 21/52] libsampler: V8's PPC frame pointer is r31, not r30

Same fix as nodejs12 ppc-darwin patch 0017: V8 codegen uses r31 as fp
(register-ppc.h aliases fp = r31), so sampling __r30 produced bogus
stack walks in the profiler.

[Re-anchored onto 12.4 from the 9.4 series; hunks applied without modification.]
---
 v8/src/libsampler/sampler.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/v8/src/libsampler/sampler.cc b/v8/src/libsampler/sampler.cc
index 06d20b6..deebdcc 100644
--- a/v8/src/libsampler/sampler.cc
+++ b/v8/src/libsampler/sampler.cc
@@ -502,7 +502,8 @@ void SignalHandler::FillRegisterState(void* context, RegisterState* state) {
 #elif V8_HOST_ARCH_PPC || V8_HOST_ARCH_PPC64
   state->pc = reinterpret_cast<void*>(mcontext->__ss.__srr0);
   state->sp = reinterpret_cast<void*>(mcontext->__ss.__r1);
-  state->fp = reinterpret_cast<void*>(mcontext->__ss.__r30);
+  // V8's PPC frame pointer is r31 (see register-ppc.h), not r30.
+  state->fp = reinterpret_cast<void*>(mcontext->__ss.__r31);
   state->lr = reinterpret_cast<void*>(mcontext->__ss.__lr);
 #endif  // V8_HOST_ARCH_*
 #elif V8_OS_FREEBSD
