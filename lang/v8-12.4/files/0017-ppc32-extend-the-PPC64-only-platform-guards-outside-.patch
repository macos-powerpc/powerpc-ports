From 26f338edf3e6584edd9de94398128f30a794b6b0 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:35:03 +0000
Subject: [PATCH 17/52] ppc32: extend the PPC64-only platform guards outside
 the backend

Replay of the platform hunks from the validated 9.4 series' patch 0032,
of the same class: arch ladders/guards that only know
V8_TARGET_ARCH_PPC64 because upstream dropped 32-bit PowerPC.

- wasm/jump-table-assembler.h: add the V8_TARGET_ARCH_PPC constants
  block, RE-DERIVED for 12.4's emit sequences, which changed since 9.4:
  the near slot is now a single relative b (kJumpTableSlotSize = 1
  instruction, far-table fallback beyond +-32MB), and the far slot
  gained an 8-byte patchable data tail behind a used < size - 8 CHECK -
  on 32-bit the sequence is a 2-instruction lis/ori mov + lwz (LoadU64
  width-lowered) + mtctr + bctr = 20 bytes used, giving
  kFarJumpTableSlotSize = 32 (the 9.4-derived 16 would fail the CHECK
  at runtime).  Lazy-compile stays mov+mov+mtctr+bctr = 6 instructions.
  Line size 32 (G4 cache line, divides the G5's 128).
- wasm/jump-table-assembler.cc: compile the ppc emit code on ppc32 too
  (all width-lowered by the masm layer).
- compiler/c-linkage.cc: enable the ppc block, which already carries
  the Darwin cases (r13-r30 callee-saved under V8_OS_MACOSX, 14 shadow
  words for non-LE) -- required for correct JIT-to-C calls (ieee754
  sqrt/pow etc.).
- diagnostics/eh-frame.cc: exclude ppc32 from the placeholder branch;
  the real writer is used together with diagnostics/ppc/eh-frame-ppc.cc
  (keeping the placeholders would be a duplicate-symbol link error).
- diagnostics/ppc/eh-frame-ppc.cc: kDataAlignmentFactor is -4 on
  32-bit (same split the 8.4 and 9.4 series shipped).
- compiler/backend/code-generator.cc: block the trampoline pool around
  the fixed-size deoptimization exits on ppc32 as well; the pool
  mechanics are PPC-family-wide, not 64-bit-specific.

[Re-anchored onto 12.4 from the 9.4 series; every hunk applied clean,
but the jump-table constants were re-derived against 12.4's emitters
as described above.]
---
 v8/src/compiler/backend/code-generator.cc |  2 +-
 v8/src/compiler/c-linkage.cc              |  2 +-
 v8/src/diagnostics/eh-frame.cc            |  2 +-
 v8/src/diagnostics/ppc/eh-frame-ppc.cc    |  4 ++++
 v8/src/wasm/jump-table-assembler.cc       |  2 +-
 v8/src/wasm/jump-table-assembler.h        | 14 ++++++++++++++
 6 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/v8/src/compiler/backend/code-generator.cc b/v8/src/compiler/backend/code-generator.cc
index 033e836..3ef9068 100644
--- a/v8/src/compiler/backend/code-generator.cc
+++ b/v8/src/compiler/backend/code-generator.cc
@@ -368,7 +368,7 @@ void CodeGenerator::AssembleCode() {
   std::sort(deoptimization_exits_.begin(), deoptimization_exits_.end(), cmp);
 
   {
-#ifdef V8_TARGET_ARCH_PPC64
+#if V8_TARGET_ARCH_PPC || V8_TARGET_ARCH_PPC64
     v8::internal::Assembler::BlockTrampolinePoolScope block_trampoline_pool(
         masm());
 #endif
diff --git a/v8/src/compiler/c-linkage.cc b/v8/src/compiler/c-linkage.cc
index af7c4be..d932c8e 100644
--- a/v8/src/compiler/c-linkage.cc
+++ b/v8/src/compiler/c-linkage.cc
@@ -85,7 +85,7 @@ namespace {
 #define CALLEE_SAVE_REGISTERS s0, s1, s2, s3, s4, s5, s6, s7, s8, fp
 #define CALLEE_SAVE_FP_REGISTERS f24, f25, f26, f27, f28, f29, f30, f31
 
-#elif V8_TARGET_ARCH_PPC64
+#elif V8_TARGET_ARCH_PPC || V8_TARGET_ARCH_PPC64
 // ===========================================================================
 // == ppc & ppc64 ============================================================
 // ===========================================================================
diff --git a/v8/src/diagnostics/eh-frame.cc b/v8/src/diagnostics/eh-frame.cc
index ff249c2..67ae5d9 100644
--- a/v8/src/diagnostics/eh-frame.cc
+++ b/v8/src/diagnostics/eh-frame.cc
@@ -11,7 +11,7 @@
 
 #if !defined(V8_TARGET_ARCH_X64) && !defined(V8_TARGET_ARCH_ARM) &&     \
     !defined(V8_TARGET_ARCH_ARM64) && !defined(V8_TARGET_ARCH_S390X) && \
-    !defined(V8_TARGET_ARCH_PPC64)
+    !defined(V8_TARGET_ARCH_PPC) && !defined(V8_TARGET_ARCH_PPC64)
 
 // Placeholders for unsupported architectures.
 
diff --git a/v8/src/diagnostics/ppc/eh-frame-ppc.cc b/v8/src/diagnostics/ppc/eh-frame-ppc.cc
index 8f7198c..4ccb796 100644
--- a/v8/src/diagnostics/ppc/eh-frame-ppc.cc
+++ b/v8/src/diagnostics/ppc/eh-frame-ppc.cc
@@ -10,7 +10,11 @@ namespace internal {
 
 const int EhFrameConstants::kCodeAlignmentFactor = 4;
 // all PPC are 4 bytes instruction
+#if V8_TARGET_ARCH_PPC64
 const int EhFrameConstants::kDataAlignmentFactor = -8;  // 64-bit always -8
+#else
+const int EhFrameConstants::kDataAlignmentFactor = -4;
+#endif
 
 void EhFrameWriter::WriteReturnAddressRegisterCode() {
   WriteULeb128(kLrDwarfCode);
diff --git a/v8/src/wasm/jump-table-assembler.cc b/v8/src/wasm/jump-table-assembler.cc
index cf480b9..bbd43ce 100644
--- a/v8/src/wasm/jump-table-assembler.cc
+++ b/v8/src/wasm/jump-table-assembler.cc
@@ -442,7 +442,7 @@ void JumpTableAssembler::SkipUntil(int offset) {
   DCHECK_EQ(offset, pc_offset());
 }
 
-#elif V8_TARGET_ARCH_PPC64
+#elif V8_TARGET_ARCH_PPC || V8_TARGET_ARCH_PPC64
 void JumpTableAssembler::EmitLazyCompileJumpSlot(uint32_t func_index,
                                                  Address lazy_compile_target) {
   int start = pc_offset();
diff --git a/v8/src/wasm/jump-table-assembler.h b/v8/src/wasm/jump-table-assembler.h
index 80ea425..5ecdc2d 100644
--- a/v8/src/wasm/jump-table-assembler.h
+++ b/v8/src/wasm/jump-table-assembler.h
@@ -207,6 +207,20 @@ class V8_EXPORT_PRIVATE JumpTableAssembler : public MacroAssembler {
   static constexpr int kJumpTableSlotSize = 8;
   static constexpr int kFarJumpTableSlotSize = 16;
   static constexpr int kLazyCompileTableSlotSize = 20;
+#elif V8_TARGET_ARCH_PPC
+  // Same emitters as ppc64 (the jump-table-assembler.cc guard spans the
+  // family).  Near slot: one relative b (far-table fallback beyond
+  // +-32MB).  Far slot: mov is a fixed 2-instruction lis/ori pair on
+  // 32-bit (no constant pool here) and LoadU64 width-lowers to lwz, so
+  // mov+lwz+mtctr+bctr = 5 instructions, 20 bytes used; the emitter
+  // CHECKs used < size - 8 (the 8-byte reserved data tail), giving 32.
+  // Lazy-compile: mov+mov+mtctr+bctr = 6 instructions exactly (32-bit
+  // mov is at most 2 instructions, shorter forms are nop-padded).  32
+  // is the G4 cache line and divides the G5's 128.
+  static constexpr int kJumpTableLineSize = 32;
+  static constexpr int kJumpTableSlotSize = 1 * kInstrSize;
+  static constexpr int kFarJumpTableSlotSize = 8 * kInstrSize;
+  static constexpr int kLazyCompileTableSlotSize = 6 * kInstrSize;
 #elif V8_TARGET_ARCH_PPC64
   static constexpr int kJumpTableLineSize = 64;
   static constexpr int kJumpTableSlotSize = 1 * kInstrSize;
