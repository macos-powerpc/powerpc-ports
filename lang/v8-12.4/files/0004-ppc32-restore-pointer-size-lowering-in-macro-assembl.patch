From 6fe1be7fc496f1109a3d2112e8f53247cc132559 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Sun, 30 Aug 2026 06:22:05 +0000
Subject: [PATCH 04/52] ppc32: restore pointer-size lowering in macro-assembler
 helpers

V8 9.0 flattened the old pointer-size-aware LoadP/StoreP/CmpP helper
family into U64-named helpers that emit 64-bit instructions
unconditionally.  On a 32-bit build nothing can legitimately operate on
64-bit GPR data (kSystemPointerSize is 4, Int64Lowering splits wasm i64,
and the 64-bit opcodes are excluded from the instruction list), so every
U64 helper reachable from 32-bit-compiled code is by construction a
pointer-size operation.  Restore the 32-bit lowering inside the helper
definitions, which recovers all call sites without touching them:

- MEM_OP_WITH_ALIGN_LIST (12.4 shape: the WithUpdate pair):
  LoadU64WithUpdate->lwzu/lwzux, StoreU64WithUpdate->stwu/stwux
- MEM_OP_WITH_ALIGN_PREFIXED_LIST (new since 9.4, Power10 prefixed
  forms): LoadS32->lwz/plwz/lwzx, LoadU64->lwz/plwz/lwzx,
  StoreU64->stw/pstw/stwx (the prefixed rip_op only runs under
  PPC_10_PLUS, never on 32-bit hardware, but must name word forms)
- MulS64: mulld -> mullw
- ShiftLeftU64/ShiftRightU64/ShiftRightS64 (imm and reg forms):
  sldi/srdi/sradi/sld/srd/srad -> slwi/srwi/srawi/slw/srw/sraw
- AddS32/SubS32/MulS32/AndU32/OrU32/XorU32: drop the extsw
  canonicalization (RC stays on the base op, same visible result)
- ZeroExtByte/ZeroExtHalfWord: clrldi -> clrlwi; ZeroExtWord32: mr
- LoadS32LE: drop extsw after LoadU32LE

CmpS64/CmpU64 need no change: the raw cmp/cmpl/cmpi/cmpli emitters
already select the L bit by target arch.  AddS64/SubS64/AndU64/OrU64/
XorU64 use width-agnostic instructions.  Popcnt64, the U64 count-zeros
helpers, and DivS64/DivU64/ModS64/ModU64 keep their 64-bit bodies:
their only consumers are the 64-bit opcode cases and Liftoff, both
compiled out or disabled on ppc32.

12.4 re-derivation of the 9.4 patch: TurboAssembler is now
MacroAssembler; the memory-op macro region was reorganized for the
prefixed forms (LoadU64WithUpdate no longer needs pulling out of
MEM_OP_LIST - it has its own WithAlign slot); everything else carries
over hunk-for-hunk.
---
 v8/src/codegen/ppc/macro-assembler-ppc.cc | 89 +++++++++++++++++++++++
 1 file changed, 89 insertions(+)

diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index 5e957d3..5012ecc 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -3403,25 +3403,33 @@ void MacroAssembler::SubS64(Register dst, Register src, const Operand& value,
 void MacroAssembler::AddS32(Register dst, Register src, Register value,
                             RCBit r) {
   AddS64(dst, src, value, LeaveOE, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::AddS32(Register dst, Register src, const Operand& value,
                             Register scratch, RCBit r) {
   AddS64(dst, src, value, scratch, LeaveOE, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::SubS32(Register dst, Register src, Register value,
                             RCBit r) {
   SubS64(dst, src, value, LeaveOE, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::SubS32(Register dst, Register src, const Operand& value,
                             Register scratch, RCBit r) {
   SubS64(dst, src, value, scratch, LeaveOE, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::MulS64(Register dst, Register src, const Operand& value,
@@ -3430,25 +3438,37 @@ void MacroAssembler::MulS64(Register dst, Register src, const Operand& value,
     mulli(dst, src, value);
   } else {
     mov(scratch, value);
+#if V8_TARGET_ARCH_PPC64
     mulld(dst, src, scratch, s, r);
+#else
+    mullw(dst, src, scratch, s, r);
+#endif
   }
 }
 
 void MacroAssembler::MulS64(Register dst, Register src, Register value, OEBit s,
                             RCBit r) {
+#if V8_TARGET_ARCH_PPC64
   mulld(dst, src, value, s, r);
+#else
+  mullw(dst, src, value, s, r);
+#endif
 }
 
 void MacroAssembler::MulS32(Register dst, Register src, const Operand& value,
                             Register scratch, OEBit s, RCBit r) {
   MulS64(dst, src, value, scratch, s, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::MulS32(Register dst, Register src, Register value, OEBit s,
                             RCBit r) {
   MulS64(dst, src, value, s, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::DivS64(Register dst, Register src, Register value, OEBit s,
@@ -3573,52 +3593,76 @@ void MacroAssembler::XorU64(Register dst, Register src, Register value,
 void MacroAssembler::AndU32(Register dst, Register src, const Operand& value,
                             Register scratch, RCBit r) {
   AndU64(dst, src, value, scratch, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::AndU32(Register dst, Register src, Register value,
                             RCBit r) {
   AndU64(dst, src, value, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::OrU32(Register dst, Register src, const Operand& value,
                            Register scratch, RCBit r) {
   OrU64(dst, src, value, scratch, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::OrU32(Register dst, Register src, Register value,
                            RCBit r) {
   OrU64(dst, src, value, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::XorU32(Register dst, Register src, const Operand& value,
                             Register scratch, RCBit r) {
   XorU64(dst, src, value, scratch, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::XorU32(Register dst, Register src, Register value,
                             RCBit r) {
   XorU64(dst, src, value, r);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst, r);
+#endif
 }
 
 void MacroAssembler::ShiftLeftU64(Register dst, Register src,
                                   const Operand& value, RCBit r) {
+#if V8_TARGET_ARCH_PPC64
   sldi(dst, src, value, r);
+#else
+  slwi(dst, src, value, r);
+#endif
 }
 
 void MacroAssembler::ShiftRightU64(Register dst, Register src,
                                    const Operand& value, RCBit r) {
+#if V8_TARGET_ARCH_PPC64
   srdi(dst, src, value, r);
+#else
+  srwi(dst, src, value, r);
+#endif
 }
 
 void MacroAssembler::ShiftRightS64(Register dst, Register src,
                                    const Operand& value, RCBit r) {
+#if V8_TARGET_ARCH_PPC64
   sradi(dst, src, value.immediate(), r);
+#else
+  srawi(dst, src, value.immediate(), r);
+#endif
 }
 
 void MacroAssembler::ShiftLeftU32(Register dst, Register src,
@@ -3638,17 +3682,29 @@ void MacroAssembler::ShiftRightS32(Register dst, Register src,
 
 void MacroAssembler::ShiftLeftU64(Register dst, Register src, Register value,
                                   RCBit r) {
+#if V8_TARGET_ARCH_PPC64
   sld(dst, src, value, r);
+#else
+  slw(dst, src, value, r);
+#endif
 }
 
 void MacroAssembler::ShiftRightU64(Register dst, Register src, Register value,
                                    RCBit r) {
+#if V8_TARGET_ARCH_PPC64
   srd(dst, src, value, r);
+#else
+  srw(dst, src, value, r);
+#endif
 }
 
 void MacroAssembler::ShiftRightS64(Register dst, Register src, Register value,
                                    RCBit r) {
+#if V8_TARGET_ARCH_PPC64
   srad(dst, src, value, r);
+#else
+  sraw(dst, src, value, r);
+#endif
 }
 
 void MacroAssembler::ShiftLeftU32(Register dst, Register src, Register value,
@@ -3968,9 +4024,17 @@ void MacroAssembler::AndSmiLiteral(Register dst, Register src, Tagged<Smi> smi,
     }                                                                         \
   }
 
+#if V8_TARGET_ARCH_PPC64
 #define MEM_OP_WITH_ALIGN_LIST(V) \
   V(LoadU64WithUpdate, ldu, ldux) \
   V(StoreU64WithUpdate, stdu, stdux)
+#else
+// On 32-bit, the "U64" memory ops are pointer-size ops (kSystemPointerSize
+// is 4 and 64-bit GPR data does not exist), so they lower to word forms.
+#define MEM_OP_WITH_ALIGN_LIST(V)  \
+  V(LoadU64WithUpdate, lwzu, lwzux) \
+  V(StoreU64WithUpdate, stwu, stwux)
+#endif
 
 #define MEM_OP_WITH_ALIGN_FUNCTION(name, ri_op, rr_op)           \
   void MacroAssembler::name(Register reg, const MemOperand& mem, \
@@ -3981,10 +4045,21 @@ MEM_OP_WITH_ALIGN_LIST(MEM_OP_WITH_ALIGN_FUNCTION)
 #undef MEM_OP_WITH_ALIGN_LIST
 #undef MEM_OP_WITH_ALIGN_FUNCTION
 
+#if V8_TARGET_ARCH_PPC64
 #define MEM_OP_WITH_ALIGN_PREFIXED_LIST(V) \
   V(LoadS32, lwa, plwa, lwax)              \
   V(LoadU64, ld, pld, ldx)                 \
   V(StoreU64, std, pstd, stdx)
+#else
+// Pointer-size lowering, see MEM_OP_WITH_ALIGN_LIST above.  LoadS32 of a
+// 32-bit register is a plain word load.  The prefixed forms are never
+// executed (PPC_10_PLUS), but must name word-form emitters to stay
+// consistent.
+#define MEM_OP_WITH_ALIGN_PREFIXED_LIST(V) \
+  V(LoadS32, lwz, plwz, lwzx)              \
+  V(LoadU64, lwz, plwz, lwzx)              \
+  V(StoreU64, stw, pstw, stwx)
+#endif
 
 #define MEM_OP_WITH_ALIGN_PREFIXED_FUNCTION(name, ri_op, rip_op, rr_op)       \
   void MacroAssembler::name(Register reg, const MemOperand& mem,              \
@@ -4089,7 +4164,9 @@ void MacroAssembler::LoadS32LE(Register dst, const MemOperand& mem,
                                Register scratch) {
 #ifdef V8_TARGET_BIG_ENDIAN
   LoadU32LE(dst, mem, scratch);
+#if V8_TARGET_ARCH_PPC64
   extsw(dst, dst);
+#endif
 #else
   LoadS32(dst, mem, scratch);
 #endif
@@ -5696,15 +5773,27 @@ void MacroAssembler::CallForDeoptimization(Builtin target, int, Label* exit,
 }
 
 void MacroAssembler::ZeroExtByte(Register dst, Register src) {
+#if V8_TARGET_ARCH_PPC64
   clrldi(dst, src, Operand(56));
+#else
+  clrlwi(dst, src, Operand(24));
+#endif
 }
 
 void MacroAssembler::ZeroExtHalfWord(Register dst, Register src) {
+#if V8_TARGET_ARCH_PPC64
   clrldi(dst, src, Operand(48));
+#else
+  clrlwi(dst, src, Operand(16));
+#endif
 }
 
 void MacroAssembler::ZeroExtWord32(Register dst, Register src) {
+#if V8_TARGET_ARCH_PPC64
   clrldi(dst, src, Operand(32));
+#else
+  if (dst != src) mr(dst, src);
+#endif
 }
 
 void MacroAssembler::Trap() { stop(); }
-- 
