From b2dd4dc11538375fa7df80235ae7ed1f11aecaa7 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:43:59 +0000
Subject: [PATCH 26/52] build_config: 256KB V8 heap pages on Darwin PPC (4KB OS
 pages)

12.4 re-derivation of the 9.4-series patch 0024.  The oversized
kPageSizeBits = 19 special case exists for 64KB-page PPC Linux; Darwin
PPC has 4KB OS pages, so take the generic 256KB branch (kPageSizeBits
18) like every other 4KB-page platform, keeping heap layout consistent
with the validated 8.4/9.4 ppc-darwin builds.  The site moved since
9.4: v8config.h owns arch/endian detection now and build_config.h keys
the page size on the HOST arch (equal to target on the native G5
builds), so the Darwin exclusion lands on the host-arch condition.

Also folds in what remains of 9.4's patch 0014 (build_config macro
fixes): nothing.  The detection that patch amended moved into
include/v8config.h, where gcc's always-on _ARCH_PPC covers host and
target detection on ppc-darwin, endianness is doubly covered by
__BIG_ENDIAN__ and the harness's explicit V8_TARGET_ARCH_PPC_BE, and
include/ must stay byte-identical for the external-V8 node builds, so
no change is made or needed there.
---
 v8/src/base/build_config.h | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/v8/src/base/build_config.h b/v8/src/base/build_config.h
index 9ed4c8f..32b26fd 100644
--- a/v8/src/base/build_config.h
+++ b/v8/src/base/build_config.h
@@ -50,9 +50,11 @@ constexpr int kReturnAddressStackSlotCount =
     V8_TARGET_ARCH_STORES_RETURN_ADDRESS_ON_STACK ? 1 : 0;
 
 // Number of bits to represent the page size for paged spaces.
-#if (defined(V8_HOST_ARCH_PPC) || defined(V8_HOST_ARCH_PPC64)) && !defined(_AIX)
+#if (defined(V8_HOST_ARCH_PPC) || defined(V8_HOST_ARCH_PPC64)) && \
+    !defined(_AIX) && !defined(V8_OS_DARWIN)
 // Native PPC linux has large (64KB) physical pages.
-// Simulator (and Aix) need to use the same value as x64.
+// Simulator (and Aix) need to use the same value as x64; Darwin PPC has
+// 4KB OS pages and uses the generic 256KB V8 pages below.
 constexpr int kPageSizeBits = 19;
 #elif defined(ENABLE_HUGEPAGE)
 // When enabling huge pages, adjust V8 page size to take up exactly one huge
