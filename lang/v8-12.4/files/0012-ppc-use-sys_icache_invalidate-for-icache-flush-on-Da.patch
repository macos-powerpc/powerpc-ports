From 35c91a1b7d4d77fb7cf81cc86db32f1e8e31c6a8 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:34:19 +0000
Subject: [PATCH 12/52] ppc: use sys_icache_invalidate for icache flush on
 Darwin
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The generic flush loop relies on a runtime icache line size probe that
has no Darwin implementation, so it would assume 128-byte lines —
correct on G5 only by coincidence, and silently skipping 3/4 of the
lines on G4 (32-byte lines). sys_icache_invalidate (10.5+) goes through
the commpage routine, which reads the per-CPU cache line size. Same fix
as nodejs12 ppc-darwin patch 0016; the OS::DebugBreak half of that fix
is already covered by patch 0007 here, and Assembler::bkpt already
emits twge r2,r2 (0x7D821008) upstream in 8.3.

[Re-anchored onto 12.4 from the 9.4 series; hunks applied without modification.]
---
 v8/src/codegen/ppc/cpu-ppc.cc | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/v8/src/codegen/ppc/cpu-ppc.cc b/v8/src/codegen/ppc/cpu-ppc.cc
index a5f1e32..62c058b 100644
--- a/v8/src/codegen/ppc/cpu-ppc.cc
+++ b/v8/src/codegen/ppc/cpu-ppc.cc
@@ -8,6 +8,10 @@
 
 #include "src/codegen/cpu-features.h"
 
+#if V8_OS_MACOSX
+#include <libkern/OSCacheControl.h>  // sys_icache_invalidate, 10.5+
+#endif
+
 #define INSTR_AND_DATA_CACHE_COHERENCY PPC_6_PLUS
 
 namespace v8 {
@@ -15,6 +19,12 @@ namespace internal {
 
 void CpuFeatures::FlushICache(void* buffer, size_t size) {
 #if !defined(USE_SIMULATOR)
+#if V8_OS_MACOSX
+  // Let libSystem pick the cache line size: the runtime probe below has no
+  // Darwin implementation and would assume 128-byte lines, which is wrong
+  // on G4 (32-byte lines). The commpage routine also dispatches per-CPU.
+  sys_icache_invalidate(buffer, size);
+#else
   if (CpuFeatures::IsSupported(INSTR_AND_DATA_CACHE_COHERENCY)) {
     __asm__ __volatile__(
         "sync \n"
@@ -41,6 +51,7 @@ void CpuFeatures::FlushICache(void* buffer, size_t size) {
         : "r"(pointer));
   }
 
+#endif  // V8_OS_MACOSX
 #endif  // !USE_SIMULATOR
 }
 }  // namespace internal
