+#if V8_TARGET_ARCH_PPC64
+// On 32-bit targets the generic selector defines the Word64 visitors.
 template <typename Adapter>
 void InstructionSelectorT<Adapter>::VisitWord64AtomicLoad(node_t node) {
   OperandGeneratorT<Adapter> g(this);
@@ -2955,6 +2977,7 @@ void InstructionSelectorT<Adapter>::VisitWord64AtomicLoad(node_t node) {
   LoadRepresentation load_rep = load.loaded_rep();
   VisitLoadCommon(this, node, load_rep);
