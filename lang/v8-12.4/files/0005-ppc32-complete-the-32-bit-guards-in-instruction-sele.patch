 template <typename Adapter>
 void InstructionSelectorT<Adapter>::VisitWord32AtomicStore(node_t node) {
@@ -2967,6 +2990,8 @@ void InstructionSelectorT<Adapter>::VisitWord32AtomicStore(node_t node) {
                    store_params.order());
 }
 
+#if V8_TARGET_ARCH_PPC64
+// On 32-bit targets the generic selector defines the Word64 visitors.
 template <typename Adapter>
 void InstructionSelectorT<Adapter>::VisitWord64AtomicStore(node_t node) {
   auto store = this->store_view(node);
@@ -2977,6 +3002,7 @@ void InstructionSelectorT<Adapter>::VisitWord64AtomicStore(node_t node) {
   VisitStoreCommon(this, node, store_params.store_representation(),
