 void InstructionSelectorT<Adapter>::VisitWord64AtomicExchange(node_t node) {
   ArchOpcode opcode;
@@ -3072,6 +3100,7 @@ void InstructionSelectorT<Adapter>::VisitWord64AtomicExchange(node_t node) {
   }
