   VisitAtomicCompareExchange(this, node, opcode);
 }
 
+#if V8_TARGET_ARCH_PPC64
+// On 32-bit targets the generic selector defines the Word64 visitors.
 template <typename Adapter>
 void InstructionSelectorT<Adapter>::VisitWord64AtomicCompareExchange(
     node_t node) {
@@ -3176,6 +3207,7 @@ void InstructionSelectorT<Adapter>::VisitWord64AtomicCompareExchange(
   }
   VisitAtomicCompareExchange(this, node, opcode);
 }
+#endif
 
 template <typename Adapter>
 void VisitAtomicBinaryOperation(InstructionSelectorT<Adapter>* selector,
@@ -3278,7 +3310,17 @@ void InstructionSelectorT<Adapter>::VisitWord64AtomicBinaryOperation(
           kPPC_Atomic##op##Int16, kPPC_Atomic##op##Uint16,                 \
           kPPC_Atomic##op##Int32, kPPC_Atomic##op##Uint32,                 \
           kPPC_Atomic##op##Int64, kPPC_Atomic##op##Uint64);                \
-  }                                                                        \
