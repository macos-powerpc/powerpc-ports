From f4ebe9cb8bb76535c9b286a2703e1d7940656a5c Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:40:24 +0000
Subject: [PATCH 22/52] port: Register specs for powerpc darwin

12.4 re-derivation of the 9.4-series patch 0008.  In the 32-bit Darwin
ABI r13 is just a regular callee-saved register (it has no TLS or
small-data role like on ELF), so make it allocatable and
callee-saved there.  Three shapes drifted since 9.4:

- register-ppc.h: upstream itself adopted the composable
  ALWAYS_ALLOCATABLE_GENERAL_REGISTERS shape our 9.4 patch introduced
  (plus MAYBE macros for the constant-pool r28 and cage r27), so the
  Darwin r13 case is now just one more MAYBE_ALLOCATABLE_R13 appended
  to the composition.
- reglist-ppc.h (split out of register-ppc.h upstream): RegList became
  a typed class with initializer lists, so the Darwin kCalleeSaved is
  {r13, r14..r30, fp} / kNumCalleeSaved 19 instead of raw bit math.
- c-linkage.cc: CALLEE_SAVE_REGISTERS became a comma list; the Darwin
  variant prepends r13.  STACK_SHADOW_WORDS stays 14 for non-LE, which
  covers the Darwin linkage area + eight parameter save words; comment
  annotations (AIX and Darwin, TOC slot reserved on Darwin) carried
  over.

Note V8_OS_MACOSX is V8_OS_DARWIN since V8 10.x; like the 9.4 series
this keys on the host-OS macro, which is correct for the native G5
builds these ports use.
---
 v8/src/codegen/ppc/register-ppc.h | 15 ++++++++++++---
 v8/src/codegen/ppc/reglist-ppc.h  |  9 +++++++++
 v8/src/compiler/c-linkage.cc      |  9 ++++++++-
 3 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/v8/src/codegen/ppc/register-ppc.h b/v8/src/codegen/ppc/register-ppc.h
index db7b127..6265912 100644
--- a/v8/src/codegen/ppc/register-ppc.h
+++ b/v8/src/codegen/ppc/register-ppc.h
@@ -35,10 +35,19 @@ namespace internal {
 #define MAYBE_ALLOCATABLE_CAGE_REGISTERS(V)  V(r27)
 #endif
 
+// In the 32-bit Darwin ABI r13 is just a regular callee-saved register
+// (no TLS/small-data role like on ELF), so it can be allocated.
+#if V8_OS_DARWIN && V8_TARGET_ARCH_PPC
+#define MAYBE_ALLOCATABLE_R13(V) V(r13)
+#else
+#define MAYBE_ALLOCATABLE_R13(V)
+#endif
+
 #define ALLOCATABLE_GENERAL_REGISTERS(V)  \
   ALWAYS_ALLOCATABLE_GENERAL_REGISTERS(V) \
   MAYBE_ALLOCATEABLE_CONSTANT_POOL_REGISTER(V) \
-  MAYBE_ALLOCATABLE_CAGE_REGISTERS(V)
+  MAYBE_ALLOCATABLE_CAGE_REGISTERS(V) \
+  MAYBE_ALLOCATABLE_R13(V)
 
 #define LOW_DOUBLE_REGISTERS(V)                           \
   V(d0)  V(d1)  V(d2)  V(d3)  V(d4)  V(d5)  V(d6)  V(d7)  \
@@ -93,13 +102,13 @@ namespace internal {
 const int kNumRequiredStackFrameSlots = 12;
 const int kStackFrameLRSlot = 2;
 const int kStackFrameExtraParamSlot = 12;
-#else  // AIX
+#else  // AIX and Darwin
 // [0] back chain
 // [1] condition register save area
 // [2] link register save area
 // [3] reserved for compiler
 // [4] reserved by binder
-// [5] TOC save area
+// [5] TOC save area on AIX; reserved on Darwin
 // [6] Parameter1 save area
 // ...
 // [13] Parameter8 save area
diff --git a/v8/src/codegen/ppc/reglist-ppc.h b/v8/src/codegen/ppc/reglist-ppc.h
index 4f9a9ef..a17b0da 100644
--- a/v8/src/codegen/ppc/reglist-ppc.h
+++ b/v8/src/codegen/ppc/reglist-ppc.h
@@ -38,10 +38,19 @@ const int kNumJSCallerSaved = 9;
 int JSCallerSavedCode(int n);
 
 // Callee-saved registers preserved when switching from C to JavaScript
+#if V8_OS_DARWIN && V8_TARGET_ARCH_PPC
+// In the 32-bit Darwin ABI r13 is just a regular callee-saved register.
+const RegList kCalleeSaved = {r13, r14, r15, r16, r17, r18, r19, r20, r21,
+                              r22, r23, r24, r25, r26, r27, r28, r29, r30,
+                              fp};
+
+const int kNumCalleeSaved = 19;
+#else
 const RegList kCalleeSaved = {r14, r15, r16, r17, r18, r19, r20, r21, r22,
                               r23, r24, r25, r26, r27, r28, r29, r30, fp};
 
 const int kNumCalleeSaved = 18;
+#endif
 
 const DoubleRegList kCallerSavedDoubles = {d0, d1, d2, d3,  d4,  d5,  d6,
                                            d7, d8, d9, d10, d11, d12, d13};
diff --git a/v8/src/compiler/c-linkage.cc b/v8/src/compiler/c-linkage.cc
index d932c8e..87f6085 100644
--- a/v8/src/compiler/c-linkage.cc
+++ b/v8/src/compiler/c-linkage.cc
@@ -91,13 +91,20 @@ namespace {
 // ===========================================================================
 #ifdef V8_TARGET_LITTLE_ENDIAN  // ppc64le linux
 #define STACK_SHADOW_WORDS 12
-#else  // AIX
+#else  // AIX and Darwin
 #define STACK_SHADOW_WORDS 14
 #endif
 #define PARAM_REGISTERS r3, r4, r5, r6, r7, r8, r9, r10
+#if V8_OS_DARWIN
+// In the 32-bit Darwin ABI r13 is just a regular callee-saved register.
+#define CALLEE_SAVE_REGISTERS                                                \
+  r13, r14, r15, r16, r17, r18, r19, r20, r21, r22, r23, r24, r25, r26, r27, \
+      r28, r29, r30
+#else
 #define CALLEE_SAVE_REGISTERS                                                \
   r14, r15, r16, r17, r18, r19, r20, r21, r22, r23, r24, r25, r26, r27, r28, \
       r29, r30
+#endif
 
 #define CALLEE_SAVE_FP_REGISTERS                                             \
   d14, d15, d16, d17, d18, d19, d20, d21, d22, d23, d24, d25, d26, d27, d28, \
