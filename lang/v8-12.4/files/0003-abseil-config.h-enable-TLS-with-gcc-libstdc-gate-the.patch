From 2cd67e3b3f2b17783143751be92b4ee23a6f93ac Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Sun, 30 Aug 2026 03:58:46 +0000
Subject: [PATCH 03/52] abseil: config.h - enable TLS with gcc/libstdc++, gate
 the Apple C++17-types workaround to libc++

Two forward-ports absent from the 20240722-era patch stack, re-derived
here for the absl vintage V8 12.4 vendors (HEAD 2024-03-11, which still
carries the older __ASYLO__ spelling of the TLS gate):

1. ABSL_HAVE_TLS: upstream only enables it on Linux/Asylo, so on
   Darwin-PowerPC with MacPorts gcc the pthread-key fallback is used
   even though libstdc++ advertises working (emulated) TLS via
   _GLIBCXX_HAVE_TLS.  Drop the OS gate - the compiler/library checks
   are the meaningful ones.  This is the fix that entered the
   powerpc-ports abseil port only at 20260526 (commit 054e1818); the
   default TLS choice is wrong in every earlier stack, including the
   one this series otherwise builds on.  Consumer:
   per_thread_tls.h -> ABSL_PER_THREAD_TLS_KEYWORD.

2. ABSL_INTERNAL_APPLE_CXX17_TYPES_UNAVAILABLE: the block assumes
   macOS == libc++.  The availability-marker problem it works around
   is libc++-only; with gcc/libstdc++ the real std::optional /
   std::variant / std::string_view work at any deployment target, so
   without this gate absl silently substitutes its own shims.  Gate on
   _LIBCPP_VERSION, matching the port's fix-config.h (a hunk the
   current port stack no longer carries only because upstream absl
   dropped the whole block by 20260817).
---
 v8/third_party/abseil-cpp/absl/base/config.h | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/v8/third_party/abseil-cpp/absl/base/config.h b/v8/third_party/abseil-cpp/absl/base/config.h
index 5fa9f0e..dc6c728 100644
--- a/v8/third_party/abseil-cpp/absl/base/config.h
+++ b/v8/third_party/abseil-cpp/absl/base/config.h
@@ -231,12 +231,13 @@ static_assert(ABSL_INTERNAL_INLINE_NAMESPACE_STR[0] != 'h' ||
 #endif
 
 // ABSL_HAVE_TLS is defined to 1 when __thread should be supported.
-// We assume __thread is supported on Linux or Asylo when compiled with Clang or
-// compiled against libstdc++ with _GLIBCXX_HAVE_TLS defined.
+// We assume __thread is supported when compiled with Clang or compiled
+// against libstdc++ with _GLIBCXX_HAVE_TLS defined; the OS gate served
+// no purpose (libstdc++ already advertises whether TLS works, emulated
+// or native) and wrongly excluded gcc on Darwin, where emutls is fine.
 #ifdef ABSL_HAVE_TLS
 #error ABSL_HAVE_TLS cannot be directly set
-#elif (defined(__linux__) || defined(__ASYLO__)) && \
-    (defined(__clang__) || defined(_GLIBCXX_HAVE_TLS))
+#elif defined(__clang__) || defined(_GLIBCXX_HAVE_TLS)
 #define ABSL_HAVE_TLS 1
 #endif
 
@@ -542,7 +543,11 @@ static_assert(ABSL_INTERNAL_INLINE_NAMESPACE_STR[0] != 'h' ||
 // and
 // https://github.com/llvm/llvm-project/commit/0bc451e7e137c4ccadcd3377250874f641ca514a
 // The second has the actually correct versions, thus, is what we copy here.
-#if defined(__APPLE__) &&                                         \
+// Note, this only holds for libc++: the availability-marker limitation is a
+// libc++ artifact, and libstdc++ ships its own C++17 types with no OS
+// availability gating, so with gcc these types are fully usable regardless
+// of the deployment target.
+#if defined(__APPLE__) && defined(_LIBCPP_VERSION) &&             \
     ((defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) &&   \
       __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 101300) ||  \
      (defined(__ENVIRONMENT_IPHONE_OS_VERSION_MIN_REQUIRED__) &&  \
