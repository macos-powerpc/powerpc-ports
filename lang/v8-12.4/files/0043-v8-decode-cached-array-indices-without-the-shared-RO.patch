From 95cbd79339c7cf73b5f69d5ce77fae26a688eafe Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 1 Sep 2026 21:23:33 +0000
Subject: [PATCH 43/52] v8: decode cached array indices without the
 shared-RO-heap accessor

G5 build error #5 of the 12.4 port (v8_base, ast-value-factory.cc).
AstRawString::AsArrayIndex fetches the hash seed through the zero-arg
ReadOnlyHeap::GetReadOnlyRoots(), which is declared only under
V8_SHARED_RO_HEAP.  GN turns v8_enable_shared_ro_heap on for every
configuration except third-party-heap (with pointer compression off it
is unconditionally true), so upstream never compiles this TU without
it - but the CMake harness has never defined V8_SHARED_RO_HEAP, and
the 9.4 port was built and G5-validated in the same non-shared
posture, which this series keeps: an unrelated semantic switch at
half-built state would invalidate every object compiled so far and
re-open config-specific paths in TUs the parade has already cleared.

The seed parameter of DecodeArrayIndexFromHashField is [[maybe_unused]]
and only read under V8_ENABLE_SEEDED_ARRAY_INDEX_HASH (off here, as in
GN's default), so in the non-shared configuration the call decodes
identically with HashSeed::Default(); a #error couples the two macros
in case seeded array-index hashing is ever enabled without a shared RO
heap.

Class sweep: this is the ONLY zero-arg GetReadOnlyRoots() call site in
the tree (the many GetReadOnlyRoots() hits elsewhere are the unrelated
HeapObject member), and SoleReadOnlyHeap/shared_ro_heap_ never escape
the read-only-heap files; every other V8_SHARED_RO_HEAP reference
guards internally.  Nothing else in the build should trip this class.
---
 v8/src/ast/ast-value-factory.cc | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/v8/src/ast/ast-value-factory.cc b/v8/src/ast/ast-value-factory.cc
index 8af2d51..de0f2b3 100644
--- a/v8/src/ast/ast-value-factory.cc
+++ b/v8/src/ast/ast-value-factory.cc
@@ -77,13 +77,28 @@ template EXPORT_TEMPLATE_DEFINE(
 template EXPORT_TEMPLATE_DEFINE(
     V8_EXPORT_PRIVATE) void AstRawString::Internalize(LocalIsolate* isolate);
 
+#if !defined(V8_SHARED_RO_HEAP) && defined(V8_ENABLE_SEEDED_ARRAY_INDEX_HASH)
+#error Seeded array-index hashes require the shared-read-only-heap hash seed \
+in AstRawString::AsArrayIndex.
+#endif
+
 bool AstRawString::AsArrayIndex(uint32_t* index) const {
   // The StringHasher will set up the hash. Bail out early if we know it
   // can't be convertible to an array index.
   if (!IsIntegerIndex()) return false;
   if (length() <= Name::kMaxCachedArrayIndexLength) {
+#ifdef V8_SHARED_RO_HEAP
     *index = StringHasher::DecodeArrayIndexFromHashField(
         raw_hash_field_, HashSeed(ReadOnlyHeap::GetReadOnlyRoots()));
+#else
+    // Without a shared read-only heap there is no process-global path to the
+    // roots' hash seed, and ReadOnlyHeap::GetReadOnlyRoots() only exists in
+    // the shared configuration.  The seed is only consumed when array-index
+    // hashes are seeded (excluded above), so the default seed decodes
+    // identically.
+    *index = StringHasher::DecodeArrayIndexFromHashField(raw_hash_field_,
+                                                         HashSeed::Default());
+#endif  // V8_SHARED_RO_HEAP
     return true;
   }
   // Might be an index, but too big to cache it. Do the slow conversion. This
