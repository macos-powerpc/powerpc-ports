From d5761faea675aef354d0bdaa2ad61be1b80bb6b9 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 22:59:00 +0000
Subject: [PATCH 37/52] ppc32: fast-API bool assumptions vs 4-byte darwin-ppc32
 bool

12.4 re-derivation of the 9.4-series patch 0034.  Same two cases,
doubled in site count: the fast-API lowering now exists in both the
Turbofan pipeline (effect-control-linearizer.cc, plus the extracted
fast-api-calls.cc BuildFastApiCall used by maglev/CSA) and the
turboshaft pipeline (fast-api-call-lowering-reducer.h) -- both
instantiations compile on ppc32 even though instruction selection
uses the Turbofan adapter, so all four asserts need the treatment:

- WrapFastCall-class sites (fast-api-calls.cc, reducer's
  PropagateException prologue) byte-store/load the
  javascript_execution_assert isolate field from generated code.
  Retype the field to uint8_t (the established bool-ABI convention
  for codegen-visible booleans): a byte store to a 4-byte big-endian
  bool would hit the MSB and change nothing.  The C++ side only
  touches the field through its accessors (assert-scope), where
  uint8_t and bool interconvert implicitly.

- kBool-return sites (effect-control-linearizer, reducer's
  ConvertReturnValue) mask a C bool return value with 0xFF.  On
  darwin-ppc32 the return register holds a canonical 0/1 word, which
  the mask handles equally well; relax the asserts to allow both
  ABIs (the embedder-facing v8::FastApiCallbackOptions cannot be
  retyped).

The whole path remains runtime-dead on ppc32 (--turbo-fast-api-calls
gates it and no CFunction is registered by d8/node on this target),
but the TUs must compile.
---
 v8/src/compiler/effect-control-linearizer.cc           |  7 ++++++-
 v8/src/compiler/fast-api-calls.cc                      |  3 ++-
 .../turboshaft/fast-api-call-lowering-reducer.h        | 10 ++++++++--
 v8/src/execution/isolate.h                             |  4 +++-
 4 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/v8/src/compiler/effect-control-linearizer.cc b/v8/src/compiler/effect-control-linearizer.cc
index c04e0cf..02fbf9e 100644
--- a/v8/src/compiler/effect-control-linearizer.cc
+++ b/v8/src/compiler/effect-control-linearizer.cc
@@ -7115,7 +7115,12 @@ Node* EffectControlLinearizer::LowerFastApiCall(Node* node) {
           case CTypeInfo::Type::kVoid:
             return __ UndefinedConstant();
           case CTypeInfo::Type::kBool:
-            static_assert(sizeof(bool) == 1, "unsupported bool size");
+            // With a one-byte bool the 0xFF mask isolates the defined low
+            // byte of the return register; on darwin-ppc32 (sizeof(bool)
+            // == 4) the register holds a canonical 0/1 word, which the
+            // mask also handles.
+            static_assert(sizeof(bool) == 1 || sizeof(bool) == 4,
+                          "unsupported bool size");
             return ChangeBitToTagged(
                 __ Word32And(c_call_result, __ Int32Constant(0xFF)));
           case CTypeInfo::Type::kInt32:
diff --git a/v8/src/compiler/fast-api-calls.cc b/v8/src/compiler/fast-api-calls.cc
index aa687fa..39af65a 100644
--- a/v8/src/compiler/fast-api-calls.cc
+++ b/v8/src/compiler/fast-api-calls.cc
@@ -213,7 +213,8 @@ Node* FastApiCallBuilder::WrapFastCall(const CallDescriptor* call_descriptor,
   // Disable JS execution
   Node* javascript_execution_assert = __ ExternalConstant(
       ExternalReference::javascript_execution_assert(isolate()));
-  static_assert(sizeof(bool) == 1, "Wrong assumption about boolean size.");
+  // javascript_execution_assert is uint8_t, not bool: the byte accesses
+  // below would break on a 4-byte big-endian bool (darwin-ppc32).
 
   if (v8_flags.debug_code) {
     auto do_store = __ MakeLabel();
diff --git a/v8/src/compiler/turboshaft/fast-api-call-lowering-reducer.h b/v8/src/compiler/turboshaft/fast-api-call-lowering-reducer.h
index 4b5d9f8..9d524b5 100644
--- a/v8/src/compiler/turboshaft/fast-api-call-lowering-reducer.h
+++ b/v8/src/compiler/turboshaft/fast-api-call-lowering-reducer.h
@@ -469,7 +469,12 @@ class FastApiCallLoweringReducer : public Next {
       case CTypeInfo::Type::kVoid:
         return __ HeapConstant(factory_->undefined_value());
       case CTypeInfo::Type::kBool:
-        static_assert(sizeof(bool) == 1, "unsupported bool size");
+        // With a one-byte bool the 0xFF mask isolates the defined low
+        // byte of the return register; on darwin-ppc32 (sizeof(bool) ==
+        // 4) the register holds a canonical 0/1 word, which the mask
+        // also handles.
+        static_assert(sizeof(bool) == 1 || sizeof(bool) == 4,
+                      "unsupported bool size");
         return __ ConvertWord32ToBoolean(
             __ Word32BitwiseAnd(result, __ Word32Constant(0xFF)));
       case CTypeInfo::Type::kInt32:
@@ -594,7 +599,8 @@ class FastApiCallLoweringReducer : public Next {
     // Disable JS execution.
     OpIndex js_execution_assert = __ ExternalConstant(
         ExternalReference::javascript_execution_assert(isolate_));
-    static_assert(sizeof(bool) == 1, "Wrong assumption about boolean size.");
+    // javascript_execution_assert is uint8_t, not bool: the byte accesses
+    // below would break on a 4-byte big-endian bool (darwin-ppc32).
     if (v8_flags.debug_code) {
       V<Word32> old_value =
           __ LoadOffHeap(js_execution_assert, MemoryRepresentation::Int8());
diff --git a/v8/src/execution/isolate.h b/v8/src/execution/isolate.h
index 8f40fe7..dd3e4b3 100644
--- a/v8/src/execution/isolate.h
+++ b/v8/src/execution/isolate.h
@@ -537,7 +537,9 @@ using DebugObjectCache = std::vector<Handle<HeapObject>>;
   V(int, embedder_wrapper_type_index, -1)                                     \
   V(int, embedder_wrapper_object_index, -1)                                   \
   V(compiler::NodeObserver*, node_observer, nullptr)                          \
-  V(bool, javascript_execution_assert, true)                                  \
+  /* uint8_t, not bool: written/read as a byte by generated code (fast */     \
+  /* API calls); bool is 4 bytes and big-endian on darwin-ppc32.        */    \
+  V(uint8_t, javascript_execution_assert, true)                               \
   V(bool, javascript_execution_throws, true)                                  \
   V(bool, javascript_execution_dump, true)                                    \
   V(uint32_t, javascript_execution_counter, 0)                                \
