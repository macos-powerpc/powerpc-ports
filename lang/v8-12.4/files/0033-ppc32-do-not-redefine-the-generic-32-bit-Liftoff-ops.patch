From e0896a2ddee8abcd88a4bbbf54d75d29033936df Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 22:48:41 +0000
Subject: [PATCH 33/52] ppc32: do not redefine the generic 32-bit Liftoff ops

12.4 re-derivation of the 9.4-series patch 0033, same design (the
PPC64-only sub-list), with one 12.4 addition found by the cross-g++
rig: u32_to_uintptr.

liftoff-assembler-inl.h implements emit_i64_{and,or,xor} and their
immediate forms generically for all 32-bit platforms (register-pair
half operations, shared by ia32/arm/riscv32) under
V8_TARGET_ARCH_32_BIT, and emit_u32_to_uintptr as a no-op there.  The
ppc header's BINOP_LIST defined the same six functions via
AndU64/OrU64/XorU64 and its UNOP_LIST defined u32_to_uintptr via
ZeroExtWord32 -- redefinition errors on ppc32, invisible to a literal
scan (the definitions are token-pasted, the known linkaudit blind
spot).

Hoist those entries into BINOP_LIST_I64_LOGIC/UNOP_LIST_UINTPTR
sub-lists that are empty on ppc32.  The remaining i64 entries
(add/sub/mul/shifts/clz/ctz/signextend/popcnt) have no generic 32-bit
counterparts and stay: they compile via the width-lowered masm helpers
and are dead on ppc32 (Liftoff bails out in PrepareStackFrame).

Verified by preprocessing under both arch views: the ppc64 expansion
keeps the identical definition set (gcc -E full-text comparison, only
the in-list position of u32_to_uintptr moves), and the ppc32 view's
duplicate-definition count drops from exactly these seven to zero.
---
 .../baseline/ppc/liftoff-assembler-ppc-inl.h  | 48 ++++++++++++++-----
 1 file changed, 36 insertions(+), 12 deletions(-)

diff --git a/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h b/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h
index 1a7c8ae..f9a3f4f 100644
--- a/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h
+++ b/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h
@@ -1272,7 +1272,18 @@ void LiftoffAssembler::LoadSpillAddress(Register dst, int offset,
 #define LFR_TO_REG(reg) reg.gp()
 
 // V(name, instr, dtype, stype, dcast, scast, rcast, return_val, return_type)
+// u32_to_uintptr is implemented generically for all 32-bit platforms in
+// liftoff-assembler-inl.h (a no-op there); defining it here as well would
+// be a redefinition on ppc32.
+#if V8_TARGET_ARCH_PPC64
+#define UNOP_LIST_UINTPTR(V) \
+  V(u32_to_uintptr, ZeroExtWord32, Register, Register, , , USE, , void)
+#else
+#define UNOP_LIST_UINTPTR(V)
+#endif
+
 #define UNOP_LIST(V)                                                         \
+  UNOP_LIST_UINTPTR(V)                                                       \
   V(f32_abs, fabs, DoubleRegister, DoubleRegister, , , USE, , void)          \
   V(f32_neg, fneg, DoubleRegister, DoubleRegister, , , USE, , void)          \
   V(f32_sqrt, fsqrt, DoubleRegister, DoubleRegister, , , ROUND_F64_TO_F32, , \
@@ -1319,9 +1330,32 @@ void LiftoffAssembler::LoadSpillAddress(Register dst, int offset,
 UNOP_LIST(EMIT_UNOP_FUNCTION)
 #undef EMIT_UNOP_FUNCTION
 #undef UNOP_LIST
+#undef UNOP_LIST_UINTPTR
 
 // V(name, instr, dtype, stype1, stype2, dcast, scast1, scast2, rcast,
 // return_val, return_type)
+// The i64 and/or/xor operations (including the immediate forms) are
+// implemented generically for all 32-bit platforms in
+// liftoff-assembler-inl.h via register-pair half operations; defining
+// them here as well would be a redefinition on ppc32.
+#if V8_TARGET_ARCH_PPC64
+#define BINOP_LIST_I64_LOGIC(V)                                                \
+  V(i64_and, AndU64, LiftoffRegister, LiftoffRegister, LiftoffRegister,        \
+    LFR_TO_REG, LFR_TO_REG, LFR_TO_REG, USE, , void)                           \
+  V(i64_or, OrU64, LiftoffRegister, LiftoffRegister, LiftoffRegister,          \
+    LFR_TO_REG, LFR_TO_REG, LFR_TO_REG, USE, , void)                           \
+  V(i64_xor, XorU64, LiftoffRegister, LiftoffRegister, LiftoffRegister,        \
+    LFR_TO_REG, LFR_TO_REG, LFR_TO_REG, USE, , void)                           \
+  V(i64_andi, AndU64, LiftoffRegister, LiftoffRegister, int32_t, LFR_TO_REG,   \
+    LFR_TO_REG, Operand, USE, , void)                                          \
+  V(i64_ori, OrU64, LiftoffRegister, LiftoffRegister, int32_t, LFR_TO_REG,     \
+    LFR_TO_REG, Operand, USE, , void)                                          \
+  V(i64_xori, XorU64, LiftoffRegister, LiftoffRegister, int32_t, LFR_TO_REG,   \
+    LFR_TO_REG, Operand, USE, , void)
+#else
+#define BINOP_LIST_I64_LOGIC(V)
+#endif
+
 #define BINOP_LIST(V)                                                          \
   V(f32_copysign, CopySignF64, DoubleRegister, DoubleRegister, DoubleRegister, \
     , , , USE, , void)                                                         \
@@ -1354,18 +1388,7 @@ UNOP_LIST(EMIT_UNOP_FUNCTION)
   V(i32_and, AndU32, Register, Register, Register, , , , USE, , void)          \
   V(i32_or, OrU32, Register, Register, Register, , , , USE, , void)            \
   V(i32_xor, XorU32, Register, Register, Register, , , , USE, , void)          \
-  V(i64_and, AndU64, LiftoffRegister, LiftoffRegister, LiftoffRegister,        \
-    LFR_TO_REG, LFR_TO_REG, LFR_TO_REG, USE, , void)                           \
-  V(i64_or, OrU64, LiftoffRegister, LiftoffRegister, LiftoffRegister,          \
-    LFR_TO_REG, LFR_TO_REG, LFR_TO_REG, USE, , void)                           \
-  V(i64_xor, XorU64, LiftoffRegister, LiftoffRegister, LiftoffRegister,        \
-    LFR_TO_REG, LFR_TO_REG, LFR_TO_REG, USE, , void)                           \
-  V(i64_andi, AndU64, LiftoffRegister, LiftoffRegister, int32_t, LFR_TO_REG,   \
-    LFR_TO_REG, Operand, USE, , void)                                          \
-  V(i64_ori, OrU64, LiftoffRegister, LiftoffRegister, int32_t, LFR_TO_REG,     \
-    LFR_TO_REG, Operand, USE, , void)                                          \
-  V(i64_xori, XorU64, LiftoffRegister, LiftoffRegister, int32_t, LFR_TO_REG,   \
-    LFR_TO_REG, Operand, USE, , void)                                          \
+  BINOP_LIST_I64_LOGIC(V)                                                      \
   V(i32_shli, ShiftLeftU32, Register, Register, int32_t, , ,                   \
     INT32_AND_WITH_1F, USE, , void)                                            \
   V(i32_sari, ShiftRightS32, Register, Register, int32_t, , ,                  \
@@ -1421,6 +1444,7 @@ UNOP_LIST(EMIT_UNOP_FUNCTION)
 
 BINOP_LIST(EMIT_BINOP_FUNCTION)
 #undef BINOP_LIST
+#undef BINOP_LIST_I64_LOGIC
 #undef EMIT_BINOP_FUNCTION
 #undef SIGN_EXT
 #undef INT32_AND_WITH_1F
