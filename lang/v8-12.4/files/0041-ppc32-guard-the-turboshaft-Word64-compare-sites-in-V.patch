From 4b55e298da5cdb7aff3ffc3d265a44ee1bdbf32a Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 1 Sep 2026 07:49:50 +0000
Subject: [PATCH 41/52] ppc32: guard the turboshaft Word64-compare sites in
 VisitWordCompareZero
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

G5 build error #4a of the 12.4 port (v8_base,
instruction-selector-ppc.cc, TurboshaftAdapter instantiation).
VisitWord64Compare is (correctly) defined only under
V8_TARGET_ARCH_PPC64, and the Turbofan VisitWordCompareZero's Word64
cases are guarded — but the TurboshaftAdapter specialization gained
its own copies of the same combining logic between 9.4 and 12.4 and
those call sites were not: the Word64 ComparisonOp case and the
kWord64Sub/kWord64BitwiseAnd else-if arms.  Both now carry the same
PPC64 guard shape as their Turbofan twins (compiled out; ppc32 falls
through to the generic compare-against-zero, which never executes for
Word64 inputs — turboshaft is staged off for ppc32 and 64-bit ops are
pair-lowered before instruction selection).

Why the rig missed it: the call is name-dependent, so lookup happens
at instantiation, and the selector TU is above this box's 961MB
instantiation ceiling — parse-level -fsyntax-only (which validated
this file) never sees it.  New instantiation-free check added for the
class: split the file into ppc32-live/dead preprocessor regions,
collect free helpers defined ONLY in dead regions, scan live text for
calls.  Result after this patch: PPC64-only helpers are exactly
{VisitWord64Compare, VisitTryTruncateDouble}, zero live calls to
either.  ppcheck balanced; the guarded regions are unchanged under
PPC64.
---
 v8/src/compiler/backend/ppc/instruction-selector-ppc.cc | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/v8/src/compiler/backend/ppc/instruction-selector-ppc.cc b/v8/src/compiler/backend/ppc/instruction-selector-ppc.cc
index 1a72eb6..1df5def 100644
--- a/v8/src/compiler/backend/ppc/instruction-selector-ppc.cc
+++ b/v8/src/compiler/backend/ppc/instruction-selector-ppc.cc
@@ -2692,10 +2692,12 @@ void InstructionSelectorT<TurboshaftAdapter>::VisitWordCompareZero(
           cont->OverwriteAndNegateIfEqual(
               GetComparisonFlagCondition(*comparison));
           return VisitWord32Compare(this, value, cont);
+#if V8_TARGET_ARCH_PPC64
         case RegisterRepresentation::Word64():
           cont->OverwriteAndNegateIfEqual(
               GetComparisonFlagCondition(*comparison));
           return VisitWord64Compare(this, value, cont);
+#endif
         case RegisterRepresentation::Float32():
           switch (comparison->kind) {
             case ComparisonOp::Kind::kEqual:
@@ -2771,11 +2773,13 @@ void InstructionSelectorT<TurboshaftAdapter>::VisitWordCompareZero(
     } else if (value_op.Is<Opmask::kWord32BitwiseAnd>()) {
       return VisitWordCompare(this, value, kPPC_Tst32, cont, true,
                               kInt16Imm_Unsigned);
+#if V8_TARGET_ARCH_PPC64
     } else if (value_op.Is<Opmask::kWord64Sub>()) {
       return VisitWord64Compare(this, value, cont);
     } else if (value_op.Is<Opmask::kWord64BitwiseAnd>()) {
       return VisitWordCompare(this, value, kPPC_Tst64, cont, true,
                               kInt16Imm_Unsigned);
+#endif
     } else if (value_op.Is<StackPointerGreaterThanOp>()) {
       cont->OverwriteAndNegateIfEqual(kStackPointerGreaterThanCondition);
       return VisitStackPointerGreaterThan(value, cont);
-- 
