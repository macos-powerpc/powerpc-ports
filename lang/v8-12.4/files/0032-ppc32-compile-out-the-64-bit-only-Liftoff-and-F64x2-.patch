From 5a925295fcb838ef325b431a7400886f591e123a Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 22:48:30 +0000
Subject: [PATCH 32/52] ppc32: compile out the 64-bit-only Liftoff and
 F64x2-lane paths

12.4 re-derivation of the 9.4-series patch 0030, grown to match the
much larger 12.4 surface: at 9.4 the ppc Liftoff port was stubs and
the F64x2 lane sequences lived in the code generator; at 12.4 upstream
implemented full ppc64 Liftoff and moved the lane sequences into masm
helpers.  The failure class is unchanged (G5 error #5's
arch-dependent-arity blind spot): MovDoubleToInt64/MovInt64ToDouble
take a register pair on ppc32, and ConvertInt64To*/
ConvertUnsignedInt64To*/ConvertDoubleToUnsignedInt64 exist only on
ppc64.  All guarded sites are unreachable on ppc32: wasm SIMD never
validates (SupportsWasmSimd128() is false, modules get a clean
CompileError) and Liftoff bails out in PrepareStackFrame before
emitting any code.

- macro-assembler: F64x2Splat/F64x2ExtractLane/F64x2ReplaceLane bodies
  become UNREACHABLE on ppc32 (covers both the code-generator cases
  and the Liftoff SIMD calls in one place).
- liftoff-assembler-ppc-inl.h: LoadConstant's kF64 arm (as at 9.4) and
  the emit_type_conversion cases that use the 64-bit helper forms
  (i64<->f32/f64 conversions incl. the saturating forms, I32UConvert
  via ConvertDoubleToUnsignedInt64, and the 64-bit reinterprets);
  compiled-out cases fall to the switch's default UNREACHABLE.
- liftoff-assembler-defs.h: share the ppc64 cache-register/
  frame-setup-register definitions with ppc32.  The generic #else
  fallback does not compile at all (it never declares
  kLiftoffFrameSetupFunctionReg, which the following static_asserts
  reference), and every register named in the ppc64 branch exists on
  ppc32.

Validated with the cross-g++14 rig: the redefinition/arity errors in a
ppc32 -fsyntax-only parse of the liftoff TU are gone, and a gcc -E
full-text comparison of the ppc64 view is byte-identical.
---
 v8/src/codegen/ppc/macro-assembler-ppc.cc     | 21 ++++++++++++++++
 v8/src/wasm/baseline/liftoff-assembler-defs.h |  6 ++++-
 .../baseline/ppc/liftoff-assembler-ppc-inl.h  | 24 ++++++++++++++++++-
 3 files changed, 49 insertions(+), 2 deletions(-)

diff --git a/v8/src/codegen/ppc/macro-assembler-ppc.cc b/v8/src/codegen/ppc/macro-assembler-ppc.cc
index 8a3bbbd..1ea4f9c 100644
--- a/v8/src/codegen/ppc/macro-assembler-ppc.cc
+++ b/v8/src/codegen/ppc/macro-assembler-ppc.cc
@@ -4600,10 +4600,19 @@ void MacroAssembler::StoreSimd128LE(Simd128Register src, const MemOperand& mem,
 
 void MacroAssembler::F64x2Splat(Simd128Register dst, DoubleRegister src,
                                 Register scratch) {
+#if V8_TARGET_ARCH_PPC64
   constexpr int lane_width_in_bytes = 8;
   MovDoubleToInt64(scratch, src);
   mtvsrd(dst, scratch);
   vinsertd(dst, dst, Operand(1 * lane_width_in_bytes));
+#else
+  // The F64x2 lane sequences move a double through a GPR
+  // (MovDoubleToInt64/MovInt64ToDouble), which takes a register pair on
+  // ppc32. Wasm SIMD never validates there (SupportsWasmSimd128 is
+  // false, modules get a clean CompileError) and Liftoff bails out, so
+  // these helpers are never reached.
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::F32x4Splat(Simd128Register dst, DoubleRegister src,
@@ -4638,10 +4647,16 @@ void MacroAssembler::F64x2ExtractLane(DoubleRegister dst, Simd128Register src,
                                       uint8_t imm_lane_idx,
                                       Simd128Register scratch1,
                                       Register scratch2) {
+#if V8_TARGET_ARCH_PPC64
   constexpr int lane_width_in_bytes = 8;
   vextractd(scratch1, src, Operand((1 - imm_lane_idx) * lane_width_in_bytes));
   mfvsrd(scratch2, scratch1);
   MovInt64ToDouble(dst, scratch2);
+#else
+  // See F64x2Splat: dead on ppc32, and MovInt64ToDouble takes a
+  // register pair there.
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::F32x4ExtractLane(DoubleRegister dst, Simd128Register src,
@@ -4703,6 +4718,7 @@ void MacroAssembler::F64x2ReplaceLane(Simd128Register dst, Simd128Register src1,
                                       DoubleRegister src2, uint8_t imm_lane_idx,
                                       Register scratch1,
                                       Simd128Register scratch2) {
+#if V8_TARGET_ARCH_PPC64
   constexpr int lane_width_in_bytes = 8;
   if (src1 != dst) {
     vor(dst, src1, src1);
@@ -4714,6 +4730,11 @@ void MacroAssembler::F64x2ReplaceLane(Simd128Register dst, Simd128Register src1,
     mtvsrd(scratch2, scratch1);
     vinsertd(dst, scratch2, Operand((1 - imm_lane_idx) * lane_width_in_bytes));
   }
+#else
+  // See F64x2Splat: dead on ppc32, and MovDoubleToInt64 takes a
+  // register pair there.
+  UNREACHABLE();
+#endif
 }
 
 void MacroAssembler::F32x4ReplaceLane(Simd128Register dst, Simd128Register src1,
diff --git a/v8/src/wasm/baseline/liftoff-assembler-defs.h b/v8/src/wasm/baseline/liftoff-assembler-defs.h
index d7329e2..1947cc2 100644
--- a/v8/src/wasm/baseline/liftoff-assembler-defs.h
+++ b/v8/src/wasm/baseline/liftoff-assembler-defs.h
@@ -114,8 +114,12 @@ constexpr DoubleRegList kLiftoffAssemblerFpCacheRegs = {
 // For the "WasmLiftoffFrameSetup" builtin.
 constexpr Register kLiftoffFrameSetupFunctionReg = r7;
 
-#elif V8_TARGET_ARCH_PPC64
+#elif V8_TARGET_ARCH_PPC64 || V8_TARGET_ARCH_PPC
 
+// On ppc32 Liftoff is disabled (PrepareStackFrame bails out) and these
+// constants are compile-time-only; the generic #else fallback below does
+// not compile (it lacks kLiftoffFrameSetupFunctionReg), so share the
+// ppc64 definitions -- every named register exists on ppc32.
 constexpr RegList kLiftoffAssemblerGpCacheRegs = {r3, r4,  r5,  r6,  r7, r8,
                                                   r9, r10, r11, r15, cp};
 
diff --git a/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h b/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h
index 4a7a230..1a7c8ae 100644
--- a/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h
+++ b/v8/src/wasm/baseline/ppc/liftoff-assembler-ppc-inl.h
@@ -337,11 +337,17 @@ void LiftoffAssembler::LoadConstant(LiftoffRegister reg, WasmValue value) {
       break;
     }
     case kF64: {
+#if V8_TARGET_ARCH_PPC64
       UseScratchRegisterScope temps(this);
       Register scratch = temps.Acquire();
       mov(scratch, Operand(value.to_f64_boxed().get_bits()));
       MovInt64ToDouble(reg.fp(), scratch);
       break;
+#else
+      // MovInt64ToDouble takes a register pair on ppc32. Liftoff bails
+      // out in PrepareStackFrame there, so this is never reached.
+      UNREACHABLE();
+#endif
     }
     default:
       UNREACHABLE();
@@ -1289,7 +1295,6 @@ void LiftoffAssembler::LoadSpillAddress(Register dst, int offset,
     LFR_TO_REG, LFR_TO_REG, USE, , void)                                     \
   V(i64_ctz, CountTrailingZerosU64, LiftoffRegister, LiftoffRegister,        \
     LFR_TO_REG, LFR_TO_REG, USE, , void)                                     \
-  V(u32_to_uintptr, ZeroExtWord32, Register, Register, , , USE, , void)      \
   V(i32_signextend_i8, extsb, Register, Register, , , USE, , void)           \
   V(i32_signextend_i16, extsh, Register, Register, , , USE, , void)          \
   V(i64_signextend_i8, extsb, LiftoffRegister, LiftoffRegister, LFR_TO_REG,  \
@@ -1610,6 +1615,12 @@ bool LiftoffAssembler::emit_type_conversion(WasmOpcode opcode,
       ConvertUnsignedIntToDouble(src.gp(), dst.fp());
       return true;
     }
+#if V8_TARGET_ARCH_PPC64
+    // The i64<->float conversions and the 64-bit reinterprets use the
+    // 64-bit forms of the Convert*/Mov* masm helpers, which take
+    // register pairs on ppc32 (or do not exist there). Liftoff bails
+    // out in PrepareStackFrame on ppc32, so the compiled-out cases fall
+    // to the default UNREACHABLE.
     case kExprF64SConvertI64: {
       ConvertInt64ToDouble(src.gp(), dst.fp());
       return true;
@@ -1626,6 +1637,7 @@ bool LiftoffAssembler::emit_type_conversion(WasmOpcode opcode,
       ConvertUnsignedInt64ToFloat(src.gp(), dst.fp());
       return true;
     }
+#endif  // V8_TARGET_ARCH_PPC64
     case kExprI32SConvertF64:
     case kExprI32SConvertF32: {
       LoadDoubleLiteral(kScratchDoubleReg, base::Double(0.0), r0);
@@ -1639,6 +1651,9 @@ bool LiftoffAssembler::emit_type_conversion(WasmOpcode opcode,
       boverflow(trap, cr7);
       return true;
     }
+#if V8_TARGET_ARCH_PPC64
+    // I32UConvert goes through ConvertDoubleToUnsignedInt64 (PPC64-only)
+    // and the I64 conversions read the result via MovDoubleToInt64.
     case kExprI32UConvertF64:
     case kExprI32UConvertF32: {
       mtfsb0(VXCVI);  // clear FPSCR:VXCVI bit
@@ -1677,6 +1692,7 @@ bool LiftoffAssembler::emit_type_conversion(WasmOpcode opcode,
       boverflow(trap, cr7);
       return true;
     }
+#endif  // V8_TARGET_ARCH_PPC64
     case kExprI32SConvertSatF64:
     case kExprI32SConvertSatF32: {
       Label done, src_is_nan;
@@ -1713,6 +1729,7 @@ bool LiftoffAssembler::emit_type_conversion(WasmOpcode opcode,
       bind(&done);
       return true;
     }
+#if V8_TARGET_ARCH_PPC64
     case kExprI64SConvertSatF64:
     case kExprI64SConvertSatF32: {
       Label done, src_is_nan;
@@ -1749,22 +1766,27 @@ bool LiftoffAssembler::emit_type_conversion(WasmOpcode opcode,
       bind(&done);
       return true;
     }
+#endif  // V8_TARGET_ARCH_PPC64
     case kExprI32ReinterpretF32: {
       MovFloatToInt(dst.gp(), src.fp(), kScratchDoubleReg);
       return true;
     }
+#if V8_TARGET_ARCH_PPC64
     case kExprI64ReinterpretF64: {
       MovDoubleToInt64(dst.gp(), src.fp());
       return true;
     }
+#endif
     case kExprF32ReinterpretI32: {
       MovIntToFloat(dst.fp(), src.gp(), r0);
       return true;
     }
+#if V8_TARGET_ARCH_PPC64
     case kExprF64ReinterpretI64: {
       MovInt64ToDouble(dst.fp(), src.gp());
       return true;
     }
+#endif
     default:
       UNREACHABLE();
   }
