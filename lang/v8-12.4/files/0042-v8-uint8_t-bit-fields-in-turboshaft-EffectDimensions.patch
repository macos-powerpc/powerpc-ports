From 1f29970f923fd9d63c9f69ab08d356952593fcaa Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Tue, 1 Sep 2026 21:04:46 +0000
Subject: [PATCH 42/52] v8: uint8_t bit-fields in turboshaft
 EffectDimensions/OpEffects

G5 build error #4b of the 12.4 port (v8_base, first TU including
turboshaft/operations.h).  EffectDimensions bit_casts itself to/from
Bits = uint8_t and OpEffects (which embeds two EffectDimensions) to
Bits = uint32_t; both round-trips static_assert same-size.  Darwin
ppc32 gcc has sizeof(bool) == 4 and allocates bit-fields in units of
the declared type (PCC_BITFIELD_TYPE_MATTERS), so bool:1 imposes
4-byte alignment: sizeof(EffectDimensions) becomes 4 (vs 1) and
sizeof(OpEffects) 12 (vs 4) - the G5 reported all four bit_cast
directions failing.

Retype the ten bool:1 bit-fields of the two Bits-contract structs to
uint8_t:1.  On every Itanium-ABI target uint8_t:1 packs identically
to bool:1 (probe-verified on linux-ppc32: layout unchanged), and the
fields are only ever read in boolean context or assigned true/false
literals - a bit-field of either type yields the same 0/1 values, and
operations.cc's produce_consume takes bool by value, so behaviour is
identical everywhere.

Sweep of the class (same 4-byte-bool family as the 0036/0037 Debug
and fast-API fixes, new turboshaft manifestation): operations.h has
17 bool:1 bit-fields - the other 7 live in LoadOp::Kind, which has NO
size contract (operator== is field-wise, hash_value builds the bits
by hand) and only grows benignly.  Tree-wide, the only other compiled
bool-bit-field structs (backing-store.h, control-equivalence.h,
property-descriptor.h) carry no sizeof asserts or bit_casts either.
All uses of the ten retyped fields outside the header are value
context (stream output, if-conditions, false-assignment in
wasm-revec-reducer, which ppc32 does not compile anyway).

Rig note: this class is invisible to the linux cross-compiler on
principle - the linux ppc32 ABI has a 1-byte bool, so both asserts
hold there; only source-level analysis (or the G5 itself) can catch
Darwin-bool layout breaks.
---
 v8/src/compiler/turboshaft/operations.h | 27 ++++++++++++++++---------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/v8/src/compiler/turboshaft/operations.h b/v8/src/compiler/turboshaft/operations.h
index 5eabc6f..ea8ba9a 100644
--- a/v8/src/compiler/turboshaft/operations.h
+++ b/v8/src/compiler/turboshaft/operations.h
@@ -430,30 +430,35 @@ class InputsRepFactory {
 struct EffectDimensions {
   // Produced by loads, consumed by operations that should not move before loads
   // because they change memory.
-  bool load_heap_memory : 1;
-  bool load_off_heap_memory : 1;
+  // These bit-fields are uint8_t rather than bool: bit_cast to/from Bits
+  // requires sizeof == 1, but Darwin/ppc32 has a 4-byte bool and its ABI
+  // allocates bit-fields in units of the declared type, which would make
+  // the struct 4 bytes.  uint8_t:1 packs identically to bool:1 on all
+  // Itanium-ABI targets, so the layout is unchanged elsewhere.
+  uint8_t load_heap_memory : 1;
+  uint8_t load_off_heap_memory : 1;
 
   // Produced by stores, consumed by operations that should not move before
   // stores because they load or store memory.
-  bool store_heap_memory : 1;
-  bool store_off_heap_memory : 1;
+  uint8_t store_heap_memory : 1;
+  uint8_t store_off_heap_memory : 1;
 
   // Operations that perform raw heap access (like initialization) consume
   // `before_raw_heap_access` and produce `after_raw_heap_access`.
   // Operations that need the heap to be in a consistent state produce
   // `before_raw_heap_access` and consume `after_raw_heap_access`.
-  bool before_raw_heap_access : 1;
+  uint8_t before_raw_heap_access : 1;
   // Produced by operations that access raw/untagged pointers into the
   // heap or keep such a pointer alive, consumed by operations that can GC to
   // ensure they don't move before the raw access.
-  bool after_raw_heap_access : 1;
+  uint8_t after_raw_heap_access : 1;
 
   // Produced by any operation that can affect whether subsequent operations are
   // executed, for example by branching, deopting, throwing or aborting.
   // Consumed by all operations that should not be hoisted before a check
   // because they rely on it. For example, loads usually rely on the shape of
   // the heap object or the index being in bounds.
-  bool control_flow : 1;
+  uint8_t control_flow : 1;
   // We need to ensure that the padding bits have a specified value, as they are
   // observable in bitwise operations.
   uint8_t unused_padding : 1;
@@ -533,12 +538,14 @@ struct OpEffects {
   // observable pointer equality are examples. Producing identity doesn't
   // restrict reordering in straight-line code, but we must prevent using GVN or
   // moving identity-producing operations in- or out of loops.
-  bool can_create_identity : 1;
+  // uint8_t rather than bool bit-fields for the same Darwin/ppc32
+  // bit_cast-size reason as in EffectDimensions above.
+  uint8_t can_create_identity : 1;
   // If the operation can allocate and therefore can trigger GC.
-  bool can_allocate : 1;
+  uint8_t can_allocate : 1;
   // Instructions that have no uses but are `required_when_unused` should not be
   // removed.
-  bool required_when_unused : 1;
+  uint8_t required_when_unused : 1;
   // We need to ensure that the padding bits have a specified value, as they are
   // observable in bitwise operations.  This is split into two fields so that
   // also MSVC creates the correct object layout.
