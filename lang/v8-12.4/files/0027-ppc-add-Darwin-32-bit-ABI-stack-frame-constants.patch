From f020222980688bcad153b6768f7654d0c82b0837 Mon Sep 17 00:00:00 2001
From: barracuda156 <barracuda@macos-powerpc.org>
Date: Mon, 31 Aug 2026 02:44:44 +0000
Subject: [PATCH 27/52] ppc: add Darwin 32-bit ABI stack frame constants

12.4 re-derivation of the 9.4-series patch 0017, applied on top of the
re-derived register-spec patch: upstream has no 32-bit SysV branch, so
Darwin-ppc32 would fall into the AIX #else with 14 required slots.
With 4-byte slots that is only 56 bytes, and the Darwin ABI requires
16-byte stack alignment, so C callees would clobber V8 frames exactly
as in the original 8.4-era finding.  Insert a Darwin-32 branch with 16
required slots (64 bytes), LR slot 2, extra-param slot 14 (validated
on the G5 by the v8-8.3/8.4/9.4 and node12/node16 ports).  Only drift:
V8_OS_MACOSX is V8_OS_DARWIN now.
---
 v8/src/codegen/ppc/register-ppc.h | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/v8/src/codegen/ppc/register-ppc.h b/v8/src/codegen/ppc/register-ppc.h
index 6265912..8d902be 100644
--- a/v8/src/codegen/ppc/register-ppc.h
+++ b/v8/src/codegen/ppc/register-ppc.h
@@ -102,6 +102,24 @@ namespace internal {
 const int kNumRequiredStackFrameSlots = 12;
 const int kStackFrameLRSlot = 2;
 const int kStackFrameExtraParamSlot = 12;
+#elif V8_TARGET_ARCH_PPC && V8_OS_DARWIN
+// Darwin 32-bit ABI: AIX-like linkage area with 4-byte slots.
+// [0] back chain
+// [1] condition register save area
+// [2] link register save area
+// [3] reserved for compiler
+// [4] reserved by binder
+// [5] TOC save area (unused on Darwin)
+// [6] Parameter1 save area
+// ...
+// [13] Parameter8 save area
+// [14] Parameter9 slot (if necessary)
+// ...
+// 14 slots are only 56 bytes; the Darwin ABI requires 16-byte stack
+// alignment, so round the required frame up to 16 slots (64 bytes).
+const int kNumRequiredStackFrameSlots = 16;
+const int kStackFrameLRSlot = 2;
+const int kStackFrameExtraParamSlot = 14;
 #else  // AIX and Darwin
 // [0] back chain
 // [1] condition register save area
