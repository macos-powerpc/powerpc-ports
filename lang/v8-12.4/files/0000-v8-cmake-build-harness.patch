new file mode 100644
index 0000000..49b6028
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,1479 @@
+cmake_minimum_required(VERSION 3.16)
+set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_SOURCE_DIR}/cmake/MSVC.cmake")
+set(CMAKE_DISABLE_IN_SOURCE_BUILD ON)
+project(V8 LANGUAGES CXX C ASM)
+
+option(V8CMAKE_FIND_PYTHON "Enable finding python" ON)
+
+if(MSVC)
+  enable_language(ASM_MASM)
+  set_property(
+    SOURCE ${PROJECT_BINARY_DIR}/embedded.S
+           v8/src/heap/base/asm/arm64/push_registers_masm.asm
+           v8/src/heap/base/asm/ia32/push_registers_masm.asm
+           v8/src/heap/base/asm/x64/push_registers_masm.asm
+    PROPERTY LANGUAGE ASM_MASM)
+
+endif()
+
+list(APPEND CMAKE_MODULE_PATH "${PROJECT_SOURCE_DIR}/cmake")
+set(THREADS_PREFER_PTHREAD_FLAG ON)
+
+if (V8CMAKE_FIND_PYTHON)
+  find_package(Python 3 REQUIRED QUIET COMPONENTS Interpreter)
+endif()
+find_package(Threads QUIET)
+
+include(CMakeDependentOption)
+include(GNUInstallDirs)
+
+include(CheckPythonModuleExists)
+include(GenerateBuiltinsList)
+
+check_python_module_exists(PYTHON_HAVE_MARKUPSAFE markupsafe)
+
+# V8 12.4 requires C++20 (BUILD.gn: -std=c++20).
+if (NOT CMAKE_CXX_STANDARD)
+  set(CMAKE_CXX_STANDARD 20)
+endif()
+
+if (NOT CMAKE_C_STANDARD)
+  set(CMAKE_C_STANDARD 99)
+endif()
+
+set(is-freebsd $<PLATFORM_ID:FreeBSD>)
+set(is-darwin $<PLATFORM_ID:Darwin>)
+set(is-linux $<PLATFORM_ID:Linux>)
+set(is-win $<PLATFORM_ID:Windows>)
+set(is-aix $<PLATFORM_ID:AIX>)
+string(CONCAT is-posix $<OR:
+  ${is-freebsd},
+  ${is-darwin},
+  ${is-linux},
+  ${is-aix}
+>)
+
+set(is-msvc $<CXX_COMPILER_ID:MSVC>)
+
+#
+# Architecture detection.
+#
+# Two parallel representations are kept:
+#   * ``arch-*``  configure-time booleans, used to pick option defaults and to
+#     add/remove entries from source lists;
+#   * ``is-*``    generator expressions, used inside target source lists (this
+#     is the shape v8-cmake upstream uses).
+#
+# Note that ``is-ppc`` means "any PowerPC" (32- or 64-bit).  Upstream v8-cmake
+# 11.6 made ``is-ppc``/``is-ppc64`` mutually exclusive and then guarded every
+# ppc source with $<AND:${is-ppc},${is-ppc64}>, which can never be true; the
+# ppc backend was therefore never compiled.  We keep the v8-cmake 9.4 shape
+# instead: ``is-ppc`` selects the backend sources, ``is-ppc64`` only picks the
+# V8_TARGET_ARCH_PPC64 vs V8_TARGET_ARCH_PPC define.
+set(arch-is-arm 0)
+set(arch-is-arm64 0)
+set(arch-is-ia32 0)
+set(arch-is-mips 0)
+set(arch-is-mips64 0)
+set(arch-is-ppc 0)
+set(arch-is-ppc64 0)
+set(arch-is-s390 0)
+set(arch-is-x64 0)
+
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)")
+  set(arch-is-arm64 1)
+elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)")
+  set(arch-is-x64 1)
+elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(ppc|powerpc)")
+  set(arch-is-ppc 1)
+  if (CMAKE_SIZEOF_VOID_P EQUAL 8)
+    set(arch-is-ppc64 1)
+  endif()
+elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(s390|S390)")
+  set(arch-is-s390 1)
+endif()
+
+set(is-arm ${arch-is-arm})
+set(is-arm64 ${arch-is-arm64})
+set(is-ia32 ${arch-is-ia32})
+set(is-mips ${arch-is-mips})
+set(is-mips64 ${arch-is-mips64})
+set(is-ppc ${arch-is-ppc})
+set(is-ppc64 ${arch-is-ppc64})
+set(is-s390 ${arch-is-s390})
+set(is-x64 ${arch-is-x64})
+
+#
+# Feature posture.  Defaults mirror V8 12.4's BUILD.gn/gni for the arch, except
+# where noted.  Everything that is 64-bit-only (pointer compression, sandbox,
+# external code space, static roots) is left at "not defined", which is a
+# supported upstream configuration and the one the ppc32 port needs.
+#
+option(V8_ENABLE_CONCURRENT_MARKING "Enable concurrent marking" ON)
+# i18n is upstream's default (gni: v8_enable_i18n_support = true) and builds
+# against the system ICU (>= 73, src/objects/intl-objects.h) - see the ICU
+# block after abseil below for everything the switch entails.
+option(V8_ENABLE_I18N "Enable Internationalization support (needs ICU >= 73)" ON)
+# Turbofan is mandatory: BUILD.gn asserts v8_enable_turbofan || !v8_enable_webassembly.
+option(V8_ENABLE_TURBOFAN "Enable the TurboFan optimizing compiler" ON)
+# Sparkplug is off: src/baseline/baseline-assembler-inl.h has no 32-bit ppc case.
+option(V8_ENABLE_SPARKPLUG "Enable the Sparkplug baseline compiler" OFF)
+# 256-bit wasm SIMD revectorization is x64-only upstream (BUILD.gn:655).
+option(V8_ENABLE_WASM_SIMD256_REVEC "Enable 256-bit wasm SIMD revectorization" ${arch-is-x64})
+# glibc (fdlibm lineage) sin/cos.  Upstream gates this on is_clang; we default
+# it on for every compiler because the ppc-darwin port wants the deterministic
+# fdlibm implementation rather than the system libm.
+option(V8_USE_LIBM_TRIG_FUNCTIONS "Use the bundled glibc sin/cos" ON)
+
+# Maglev is deliberately not offered.  There is no src/maglev/ppc, and V8 12.4
+# only ships maglev backends for x64/arm/arm64.  Note that Turboshaft needs
+# Maglev's *graph builder* even when maglev codegen is off - see the
+# maglev-when-disabled source list further down (BUILD.gn:5141).
+
+add_definitions(
+  -DV8_ENABLE_WEBASSEMBLY
+  -DV8_ADVANCED_BIGINT_ALGORITHMS
+  # v8_enable_maglev_graph_printer defaults to !build_with_chromium, i.e. true.
+  # src/compiler/turboshaft/maglev-graph-building-phase.cc calls
+  # maglev::PrintGraph() unguarded, and that symbol only exists when the define
+  # is set, so this is not optional for us.
+  -DV8_ENABLE_MAGLEV_GRAPH_PRINTER
+)
+
+# Embedder-facing V8 features, set the way node's configure.py sets them for
+# the V8 it bundles (nodejs22's node_mksnapshot FATALs in
+# v8::Context::SetPromiseHooks - "V8 was compiled without JavaScript Promise
+# hooks" - against archives built without the first one).  BUILD.gn defaults
+# are false / 0 / false; node sets 1 / 1 / 1.
+option(V8_ENABLE_JAVASCRIPT_PROMISE_HOOKS
+  "JavaScript promise hooks (Context::SetPromiseHooks); node requires them" ON)
+set(V8_PROMISE_INTERNAL_FIELD_COUNT 1 CACHE STRING
+  "Embedder fields on every JSPromise (node builds its V8 with 1)")
+option(V8_USE_SIPHASH "SipHash for the seeded string hash (node's default)" ON)
+if (V8_ENABLE_JAVASCRIPT_PROMISE_HOOKS)
+  add_definitions(-DV8_ENABLE_JAVASCRIPT_PROMISE_HOOKS)
+endif()
+if (V8_PROMISE_INTERNAL_FIELD_COUNT GREATER 0)
+  add_definitions(-DV8_PROMISE_INTERNAL_FIELD_COUNT=${V8_PROMISE_INTERNAL_FIELD_COUNT})
+endif()
+if (V8_USE_SIPHASH)
+  add_definitions(-DV8_USE_SIPHASH)
+endif()
+
+# BUILD.gn config("features") defaults that this harness had not carried
+# (audited against node's ppc32 release configuration, 2026-09-02):
+#   V8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA - without it
+#     Isolate::{Get,Set}ContinuationPreservedEmbedderData silently no-op
+#     (node's async_context_frame.cc relies on them);
+#   V8_ENABLE_LAZY_SOURCE_POSITIONS, V8_ALLOCATION_FOLDING - flag defaults;
+#   V8_ENABLE_REGEXP_INTERPRETER_THREADED_DISPATCH - computed-goto dispatch
+#     in regexp-interpreter.cc (gcc extension, fine on ppc);
+#   V8_ALLOCATION_SITE_TRACKING - pretenuring in factory/CSA/constructor
+#     builtins (BUILD.gn only drops it for single-generation heaps);
+#   V8_USE_ZLIB - the vendored zlib is compiled into v8_base anyway (see
+#     zlib-sources below); this makes the snapshot checksum use adler32 and
+#     enables compressed frame translations.
+# Deliberately NOT set although node's configure enables them for its own
+# V8: OBJECT_PRINT and ENABLE_DISASSEMBLER (debug printing / --print-code
+# only; the disassembler would compile src/diagnostics/ppc/disasm-ppc.cc's
+# ppc64-oriented body on ppc32) and V8_ENABLE_CHECKS (release API checks).
+# Also NOT set, matching node's configure: V8_ENABLE_EXTENSIBLE_RO_SNAPSHOT
+# (node passes 0) and V8_SHARED_RO_HEAP (node's
+# --disable-shared-readonly-heap; series patch 0043 assumes it off).
+add_definitions(
+  -DV8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA
+  -DV8_ENABLE_LAZY_SOURCE_POSITIONS
+  -DV8_ENABLE_REGEXP_INTERPRETER_THREADED_DISPATCH
+  -DV8_ALLOCATION_FOLDING
+  -DV8_ALLOCATION_SITE_TRACKING
+  -DV8_USE_ZLIB
+)
+
+if (V8_ENABLE_TURBOFAN)
+  add_definitions(-DV8_ENABLE_TURBOFAN)
+endif()
+if (V8_ENABLE_SPARKPLUG)
+  add_definitions(-DV8_ENABLE_SPARKPLUG)
+endif()
+if (V8_ENABLE_WASM_SIMD256_REVEC)
+  add_definitions(-DV8_ENABLE_WASM_SIMD256_REVEC)
+endif()
+if (V8_USE_LIBM_TRIG_FUNCTIONS)
+  add_definitions(-DV8_USE_LIBM_TRIG_FUNCTIONS)
+endif()
+if(WIN32)
+  add_definitions("-DNOMINMAX -DV8_ENABLE_SYSTEM_INSTRUMENTATION")
+  # todo: for zlib, need to extract zlib when refactor
+  add_definitions("-DX86_WINDOWS")
+  add_definitions("-D_WIN32_WINNT=0x0602")
+endif()
+
+set(
+  v8_defines
+  $<${is-darwin}:V8_HAVE_TARGET_OS>
+  $<${is-darwin}:V8_TARGET_OS_MACOS>
+  $<${is-linux}:V8_HAVE_TARGET_OS>
+  $<${is-linux}:V8_TARGET_OS_LINUX>
+  $<${is-win}:V8_HAVE_TARGET_OS>
+  $<${is-win}:V8_TARGET_OS_WIN>
+  $<${is-x64}:V8_TARGET_ARCH_X64>
+  $<${is-arm64}:V8_TARGET_ARCH_ARM64>
+  $<$<AND:${is-ppc},${is-ppc64}>:V8_TARGET_ARCH_PPC64>
+  $<$<AND:${is-ppc},$<NOT:${is-ppc64}>>:V8_TARGET_ARCH_PPC>
+  $<${is-ppc}:V8_TARGET_ARCH_PPC_BE>
+  $<${is-win}:NOMINMAX>
+  $<$<AND:${is-win},${is-x64}>:V8_OS_WIN_X64>
+  $<$<BOOL:${V8_ENABLE_CONCURRENT_MARKING}>:V8_CONCURRENT_MARKING>
+  $<${is-win}:V8_OS_WIN32>
+)
+
+set(disable-exceptions
+  $<$<CXX_COMPILER_ID:MSVC>:/EHs-c->
+  $<$<CXX_COMPILER_ID:AppleClang>:-fno-exceptions>
+  $<$<CXX_COMPILER_ID:Clang>:-fno-exceptions>
+  $<$<CXX_COMPILER_ID:GNU>:-fno-exceptions>
+)
+
+set(enable-exceptions
+  $<$<CXX_COMPILER_ID:MSVC>:/EHsc>
+  $<$<CXX_COMPILER_ID:AppleClang>:-fexceptions>
+  $<$<CXX_COMPILER_ID:Clang>:-fexceptions>
+  $<$<CXX_COMPILER_ID:GNU>:-fexceptions>
+)
+
+set(enable-fpic
+  $<$<CXX_COMPILER_ID:AppleClang>:-fPIC>
+  $<$<CXX_COMPILER_ID:Clang>:-fPIC>
+  $<$<CXX_COMPILER_ID:GNU>:-fPIC>
+)
+
+#
+# abseil-cpp
+#
+# V8 12.4 vendors a complete abseil (chromium pin b3ae305f) that ships its own
+# CMakeLists.  src/zone/zone-containers.h includes absl/container/flat_hash_map.h
+# and flat_hash_set.h, and those headers reach essentially every V8 translation
+# unit, so the include directory has to be global; the link closure is much
+# smaller and is pulled in through the v8-absl interface target.
+#
+set(ABSL_PROPAGATE_CXX_STD ON CACHE BOOL "" FORCE)
+set(ABSL_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
+set(ABSL_BUILD_TESTING OFF CACHE BOOL "" FORCE)
+set(ABSL_BUILD_TEST_HELPERS OFF CACHE BOOL "" FORCE)
+add_subdirectory(v8/third_party/abseil-cpp EXCLUDE_FROM_ALL)
+
+add_library(v8-absl INTERFACE)
+target_link_libraries(v8-absl
+  INTERFACE
+    absl::btree
+    absl::flat_hash_map
+    absl::flat_hash_set
+)
+target_include_directories(v8-absl
+  INTERFACE
+    ${PROJECT_SOURCE_DIR}/v8/third_party/abseil-cpp
+)
+
+# absl headers are reachable from nearly every V8 header, including in targets
+# that need no absl symbols at all (torque, the bytecode list generator, ...).
+include_directories(${PROJECT_SOURCE_DIR}/v8/third_party/abseil-cpp)
+
+# third_party/fp16 is header-only (src/wasm and src/base include fp16.h).
+include_directories(${PROJECT_SOURCE_DIR}/v8/third_party/fp16/src/include)
+
+#
+# ICU (i18n)
+#
+# BUILD.gn's v8_enable_i18n_support makes //third_party/icu a dependency of
+# every V8 target (":v8_maybe_icu").  This harness builds against the system
+# ICU instead, found through CMake's FindICU; V8 12.4 static-asserts ICU >= 73
+# (src/objects/intl-objects.h).
+#
+# What V8_INTL_SUPPORT reaches beyond the 17 intl TUs and 14 .tq files that
+# are conditionally listed further down:
+#  - src/execution/isolate.h includes unicode/uversion.h, so nearly every
+#    translation unit of v8_base, v8_compiler, v8_initializers,
+#    v8_torque_generated, v8_snapshot, d8 and mksnapshot needs the ICU
+#    headers - hence the directory-wide include.  It is SYSTEM so that it
+#    sorts after every -I of the vendored trees (zlib, abseil, fp16), the
+#    position an -I${prefix}/include from CPPFLAGS already had; a plain
+#    include_directories() would precede the per-target -I's instead.
+#  - v8_base gains the regexp case-folding tables that
+#    gen-regexp-special-case derives from ICU data at build time (see the
+#    generator next to v8-i18n-support below).
+#  - d8 itself uses icu::Locale (--icu-locale).
+# The link closure travels on v8-icu (interface target, empty with i18n
+# off), PUBLIC on v8_base_without_compiler so that d8/mksnapshot - and a
+# CMake consumer of the archives - get -licui18n -licuuc -licudata.  An
+# embedder that links the installed archives itself (node with
+# --with-intl=system-icu) supplies the same three libraries.
+#
+add_library(v8-icu INTERFACE)
+if (V8_ENABLE_I18N)
+  find_package(ICU 73 REQUIRED COMPONENTS i18n uc data)
+  message(STATUS "V8 i18n: ICU ${ICU_VERSION} (${ICU_INCLUDE_DIRS})")
+  include_directories(SYSTEM ${ICU_INCLUDE_DIRS})
+  target_link_libraries(v8-icu INTERFACE ICU::i18n ICU::uc ICU::data)
+  add_definitions(
+    -DV8_INTL_SUPPORT
+    # From Chromium's icu_config, which upstream V8 is always compiled
+    # under: V8 qualifies every ICU type with icu:: and never relies on the
+    # implicit `using namespace icu` that the system headers default to.
+    -DU_USING_ICU_NAMESPACE=0
+    # src/init/icu_util.cc: the ICU data is linked into libicudata, so
+    # InitializeICU[DefaultLocation] is a no-op returning true - what node's
+    # v8.gyp sets for every non-Windows build without an ICU data file.
+    # Left undefined, the macro compares equal to ICU_UTIL_DATA_FILE (both
+    # 0) and d8 would go looking for an icudtb.dat next to itself.
+    -DICU_UTIL_DATA_IMPL=ICU_UTIL_DATA_STATIC
+  )
+endif()
+
+#
+# d8
+#
+
+add_executable(
+  d8
+  $<${is-posix}:v8/src/d8/d8-posix.cc>
+  $<${is-win}:v8/src/d8/d8-windows.cc>
+  v8/src/d8/async-hooks-wrapper.cc
+  v8/src/d8/d8-console.cc
+  v8/src/d8/d8-js.cc
+  v8/src/d8/d8-test.cc
+  v8/src/d8/d8-platforms.cc
+  v8/src/d8/d8.cc
+)
+
+target_compile_definitions(d8 PRIVATE ${v8_defines} $<${is-msvc}:_HAS_EXCEPTIONS=0>)
+target_compile_options(d8 PRIVATE ${disable-exceptions})
+if(enable-fPIC)
+  target_compile_options(d8 PRIVATE ${enable-fpic})
+endif()
+
+target_include_directories(d8
+  PUBLIC
+    $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/v8/include>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+  PRIVATE
+    $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/v8>
+)
+
+target_link_libraries(d8
+  PRIVATE
+    v8_base_without_compiler
+    v8_compiler
+    v8_snapshot
+    v8_inspector
+    v8_libplatform
+    v8-absl
+    # d8.cc uses icu::Locale directly (--icu-locale); the transitive link
+    # through v8_base_without_compiler would cover it, this states it.
+    v8-icu
+)
+
+# Note: v8-cmake upstream also builds v8/samples/{shell,hello-world}.cc here.
+# node's deps/v8 prunes v8/samples, so those targets are dropped.
+
+# more granular library support
+add_library(v8-i18n-support OBJECT)
+set_property(TARGET v8-i18n-support PROPERTY EXCLUDE_FROM_ALL ON)
+
+list(APPEND i18n-sources
+  v8/src/builtins/builtins-intl.cc
+  v8/src/objects/intl-objects.cc
+  v8/src/objects/js-break-iterator.cc
+  v8/src/objects/js-collator.cc
+  v8/src/objects/js-date-time-format.cc
+  v8/src/objects/js-duration-format.cc
+  v8/src/objects/js-display-names.cc
+  v8/src/objects/js-list-format.cc
+  v8/src/objects/js-locale.cc
+  v8/src/objects/js-number-format.cc
+  v8/src/objects/js-plural-rules.cc
+  v8/src/objects/js-relative-time-format.cc
+  v8/src/objects/js-segment-iterator.cc
+  v8/src/objects/js-segmenter.cc
+  v8/src/objects/js-segments.cc
+  v8/src/runtime/runtime-intl.cc
+  v8/src/strings/char-predicates.cc
+)
+
+target_sources(v8-i18n-support PRIVATE ${i18n-sources})
+target_compile_definitions(v8-i18n-support PRIVATE ${v8_defines} $<${is-msvc}:_HAS_EXCEPTIONS=0>)
+target_compile_options(v8-i18n-support PRIVATE ${disable-exceptions})
+if(enable-fPIC)
+  target_compile_options(v8-i18n-support PRIVATE ${enable-fpic})
+endif()
+# These objects are folded into v8_base_without_compiler, so they take the
+# same generated-header inputs: builtins-intl.cc includes
+# src/builtins/builtins.h, which reaches the bytecode builtins list
+# (v8-bytecodes-builtin-list carries the include dir and the generated
+# header as an interface source), and every intl TU includes the
+# torque-generated class headers.  The explicit add_dependencies keeps the
+# object library from compiling before torque has run, independent of how
+# the generator orders an OBJECT library's link dependencies.
+target_link_libraries(v8-i18n-support
+  PRIVATE
+    v8_torque_generated
+    v8-bytecodes-builtin-list
+    v8-absl
+    v8-icu
+)
+add_dependencies(v8-i18n-support v8_torque_generated)
+
+# Not v8/src/objects: v8-cmake upstream lists it here, but no intl TU needs
+# it (every V8 include is tree-rooted, src/objects/intl-objects.h), and
+# with that directory on the -I list libstdc++'s <cstring>
+# (#include <string.h>) resolves to src/objects/string.h.  logging.h
+# includes <cstring> first thing, so the whole V8 header set unrolls
+# before DCHECK/UNREACHABLE exist.
+target_include_directories(v8-i18n-support
+  PRIVATE
+    ${PROJECT_SOURCE_DIR}/v8
+    ${PROJECT_SOURCE_DIR}/v8/include
+    ${PROJECT_BINARY_DIR}
+)
+
+# The regexp case-folding tables.  With i18n, BUILD.gn builds and runs
+# gen-regexp-special-case (BUILD.gn:7212, consumed at :6124): a host tool
+# that derives from ICU's data the sets of characters the ECMAScript
+# Canonicalize() rules treat specially (src/regexp/special-case.h) and
+# writes them out as a .cc that v8_base_without_compiler compiles.  Without
+# it every V8_INTL_SUPPORT build fails to link
+# RegExpCaseFolding::IgnoreSet/SpecialAddSet (regexp-compiler-tonode.cc,
+# regexp-compiler.cc, regexp-macro-assembler.cc).  Native build: host ==
+# target, so the tool takes the same defines as the other generators.
+if (V8_ENABLE_I18N)
+  add_executable(gen-regexp-special-case v8/src/regexp/gen-regexp-special-case.cc)
+  target_compile_definitions(gen-regexp-special-case PRIVATE ${v8_defines})
