new file mode 100644
index 0000000..cfed037
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,35 @@
+name: v8-cmake
+
+on:
+  push:
+  pull_request:
+    paths:
+      - 'CMakeLists.txt'
+      - 'cmake/**'
+      - 'v8/**'
+
+jobs:
+  build:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [macos-latest, ubuntu-20.04, ubuntu-22.04, windows-latest]
+    runs-on: ${{matrix.os}}
+    steps:
+      - uses: actions/checkout@v2
+      - name: setup
+        run: |
+          git config --global core.longpaths true
+          cmake -E make_directory ${{runner.workspace}}/build
+      - name: configure
+        run: cmake ${{runner.workspace}}/v8-cmake
+        working-directory: ${{runner.workspace}}/build
+      - name: build
+        run: cmake --build ${{runner.workspace}}/build -j 2
+      - name: test
+        if: matrix.os != 'windows-latest'
+        run: ${{runner.workspace}}/build/d8 -e 42
+      - name: test-windows
+        if: matrix.os == 'windows-latest'
+        run: ${{runner.workspace}}/build/Debug/d8 -e 42
+        shell: powershell
