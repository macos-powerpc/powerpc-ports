# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                claude-code
# 2.1.112 is the last release that ships cli.js; later ones are native
# x86_64/arm64 executables only.
version             2.1.112
revision            0

categories          llm
license             Restrictive NoMirror
platforms           {darwin any}
supported_archs     noarch
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer
master_sites        https://registry.npmjs.org/@anthropic-ai/${name}/-/
distname            ${name}-${version}
extract.suffix      .tgz
worksrcdir          package

checksums           rmd160  b16bc33d89774792655dd04de784c434bbd10b52 \
                    sha256  84379969ea53a0e5fd231a8f77debe4c7cb17dd971f4809d10d33f9aeca5de09 \
                    size    18679326

depends_run         path:bin/node:nodejs22 \
                    path:bin/rg:ripgrep
depends_test        path:bin/node:nodejs22

use_configure       no
build               { }

variant telemetry description "Allow Claude Code to send anonymous usage telemetry to Anthropic" {}

destroot {
    set share_dir ${prefix}/share/${name}

    xinstall -d ${destroot}${share_dir}
    foreach f {cli.js package.json sdk-tools.d.ts LICENSE.md README.md} {
        xinstall -m 0644 ${worksrcpath}/${f} ${destroot}${share_dir}
    }

    xinstall -d ${destroot}${prefix}/bin
    set launch_script [open ${destroot}${prefix}/bin/claude w 0755]
    puts $launch_script "#!/bin/sh"
    puts $launch_script "export DISABLE_AUTOUPDATER=1 DISABLE_INSTALLATION_CHECKS=1 USE_BUILTIN_RIPGREP=0"
    if {![variant_isset telemetry]} {
        puts $launch_script "export DISABLE_TELEMETRY=1"
    }
    puts $launch_script "exec ${prefix}/bin/node ${share_dir}/cli.js \"\$@\""
    close $launch_script
}

test.run            yes
test.cmd            ${prefix}/bin/node cli.js
test.target
test.args           --version
