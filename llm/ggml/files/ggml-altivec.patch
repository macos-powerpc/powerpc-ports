+// typed unaligned loads: same element type as *p (p must be a pointer vec_ld accepts)
+#define ggml_altivec_xl(off, p)   ((__typeof__(vec_ld(0, (p)))) ggml_altivec_xl_u8((const char *) (p) + (off)))
+#define ggml_altivec_xl_len(p, n) ((__typeof__(vec_ld(0, (p)))) ggml_altivec_xl_len_u8((p), (n)))
+
+// unaligned 16-byte store through memory; only bytes in [p, p + 16) are written
+static inline void ggml_altivec_xst_u8(vector unsigned char v, void * p) {
+    memcpy(p, &v, sizeof(v));
+}
+
+// unaligned float4 store; p only has to be 4-byte aligned (always true for float *)
+static inline void ggml_altivec_xst_f32(vector float v, float * p) {
+    if (((uintptr_t) p & 15) == 0) {
+        vec_st(v, 0, p);
+    } else {
+        // rotate the lanes to their in-block positions, then store each 4-byte element
+        v = vec_perm(v, v, vec_lvsr(0, p));
+        vec_ste(v,  0, p);
+        vec_ste(v,  4, p);
+        vec_ste(v,  8, p);
+        vec_ste(v, 12, p);
+    }
+}
