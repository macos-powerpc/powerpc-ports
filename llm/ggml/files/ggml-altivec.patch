+
+// Plain AltiVec/VMX (G4, G5, Cell PPU, POWER6 and earlier, big-endian): 128-bit
+// vectors, but no unaligned vector load/store and no 64-bit lanes. VSX targets
+// (POWER7 and later) keep their existing code paths.
+#if !defined(__VSX__)
+#define GGML_ALTIVEC_ONLY
+
+// unaligned 16-byte load: lvsl / lvx / lvx / vperm
+// the second lvx addresses the block holding byte 15, so the load never
+// touches memory outside [p, p + 16)
+static inline vector unsigned char ggml_altivec_xl_u8(const void * p) {
+    const unsigned char * q = (const unsigned char *) p;
+    const vector unsigned char lo = vec_ld( 0, q);
+    const vector unsigned char hi = vec_ld(15, q);
+    return vec_perm(lo, hi, vec_lvsl(0, q));
