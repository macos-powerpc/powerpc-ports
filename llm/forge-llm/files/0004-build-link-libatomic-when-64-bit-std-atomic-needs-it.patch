From ca29e8fa3fbb35d3c6e1c470878e2df3ca5b967b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 03:48:11 +0000
Subject: [PATCH 04/20] build: link libatomic when 64-bit std::atomic needs it

The metrics registry, memory counters and a few other places use
std::atomic<uint64_t>. On 32-bit targets such as powerpc these are not
lock-free and GCC lowers them to __atomic_*_8 libcalls provided by
libatomic, so links failed with undefined references.

Probe whether a 64-bit atomic links as-is and, if not, whether it links
with -latomic; in that case add atomic to forge_core's public link
interface. Hosts with native 64-bit atomics are unaffected.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 CMakeLists.txt | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 263ac29..b190aec 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -216,6 +216,26 @@ if(CUDAToolkit_FOUND)
 endif()
 target_link_libraries(forge_core PUBLIC forge_cpu_features)
 
+# std::atomic<uint64_t> (metrics and memory counters) is not lock-free on
+# 32-bit targets such as powerpc, where GCC emits __atomic_*_8 calls that
+# live in libatomic. Link it only when the plain build cannot resolve them.
+include(CheckCXXSourceCompiles)
+set(_forge_atomic64_src
+    "#include <atomic>\n#include <cstdint>\nstd::atomic<uint64_t> v{0};\nint main() { return static_cast<int>(v.fetch_add(1)); }\n")
+check_cxx_source_compiles("${_forge_atomic64_src}" FORGE_ATOMIC64_BUILTIN)
+if(NOT FORGE_ATOMIC64_BUILTIN)
+  set(CMAKE_REQUIRED_LIBRARIES atomic)
+  check_cxx_source_compiles("${_forge_atomic64_src}" FORGE_ATOMIC64_LIBATOMIC)
+  unset(CMAKE_REQUIRED_LIBRARIES)
+  if(FORGE_ATOMIC64_LIBATOMIC)
+    target_link_libraries(forge_core PUBLIC atomic)
+    message(STATUS "64-bit atomics: libatomic")
+  else()
+    message(WARNING "64-bit std::atomic does not link, with or without libatomic")
+  endif()
+endif()
+unset(_forge_atomic64_src)
+
 # ---- Operators library (static) ----
 # Defined in src/operators/CMakeLists.txt
 add_subdirectory(src/operators)
-- 
