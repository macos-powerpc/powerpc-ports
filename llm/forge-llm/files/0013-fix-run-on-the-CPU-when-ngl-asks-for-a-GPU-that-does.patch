From 87c2403ed448762f0e158f8417a0672f4491fcee Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 06:09:09 +0000
Subject: [PATCH 13/20] fix: run on the CPU when -ngl asks for a GPU that does
 not exist

The default -ngl is -1 ("auto"), which Model::load and
TransformerEngine::set_gpu_layers both took as "every layer on CUDA"
without checking that CUDA exists. On a CPU-only build (or a CUDA build
on a machine without a GPU) the model was then flagged as a CUDA model,
the loader copied every tensor instead of mapping it, and the engine's
weight placement threw "CUDA not available" right after the model
loaded, so forge-cli and forge-server only worked with an explicit
-ngl 0.

When BackendManager reports no CUDA device, resolve auto/all to 0 in
both places and ignore an explicit layer count with one warning, as
Bailingmoe3Engine already did. The interactive banner reports the
device actually used.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/cli/cli_interactive.cpp                  |  8 ++++++--
 src/inference/engines/transformer_engine.cpp | 13 ++++++++++++-
 src/model/model.cpp                          | 13 +++++++++++++
 3 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/src/cli/cli_interactive.cpp b/src/cli/cli_interactive.cpp
index c89ec37..41b7293 100644
--- a/src/cli/cli_interactive.cpp
+++ b/src/cli/cli_interactive.cpp
@@ -7,6 +7,7 @@
 #include <iostream>
 
 #include "cli_common.h"
+#include "forge/backend.h"
 #include "forge/chat_template.h"
 #include "forge/context.h"
 #include "forge/engine.h"
@@ -55,10 +56,13 @@ void interactive_chat(InferenceContext& ctx, Model& model, Tokenizer& tokenizer,
     std::cout << "\n";
     std::cout << "  " << cli_color::green("Model:") << " " << cli_color::bold(cfg.arch_type) << " ("
               << cli_color::cyan(std::to_string(cfg.num_layers)) << " layers)\n";
+    // The engine keeps everything on the CPU when no CUDA device exists,
+    // whatever -ngl says (see TransformerEngine::set_gpu_layers).
+    const bool on_gpu = args.common.n_gpu_layers != 0 && BackendManager::instance().has_cuda();
     std::cout << "  " << cli_color::green("Device:") << " "
-              << cli_color::bold(args.common.n_gpu_layers == 0 ? "CPU" : "CUDA") << "\n";
+              << cli_color::bold(on_gpu ? "CUDA" : "CPU") << "\n";
     std::cout << "  " << cli_color::green("GPU layers:") << " "
-              << cli_color::cyan(std::to_string(args.common.n_gpu_layers)) << "\n";
+              << cli_color::cyan(std::to_string(on_gpu ? args.common.n_gpu_layers : 0)) << "\n";
     std::cout << "  " << cli_color::green("Commands:") << " "
               << cli_color::dim("/quit, /clear, /system, /image, /save, /help") << "\n";
     std::cout << "\n";
diff --git a/src/inference/engines/transformer_engine.cpp b/src/inference/engines/transformer_engine.cpp
index d2da5f4..2719800 100644
--- a/src/inference/engines/transformer_engine.cpp
+++ b/src/inference/engines/transformer_engine.cpp
@@ -227,7 +227,18 @@ void TransformerEngine::set_gpu_layers(int gpu_layers) {
     }
 }
 
-void TransformerEngine::set_gpu_layers(int gpu_layers, const std::vector<int>& gpu_layers_per_dev) {
+void TransformerEngine::set_gpu_layers(int gpu_layers, const std::vector<int>& requested_per_dev) {
+    // Without a usable CUDA device (a CPU-only build, or no GPU present) every
+    // layer stays on the CPU: "auto"/"all" (negative, -1 is the default -ngl)
+    // resolve to 0 and an explicit count is ignored (Model::load already warned
+    // about that). Otherwise the default placed the layers on GPU 0 and the
+    // weight moves below threw "CUDA not available" from Tensor::to_device.
+    std::vector<int> gpu_layers_per_dev = requested_per_dev;
+    if (gpu_layers != 0 && !BackendManager::instance().has_cuda()) {
+        gpu_layers = 0;
+        gpu_layers_per_dev.clear();
+    }
+
     graph_runtime_.invalidate();
     gpu_layers_ = gpu_layers;
     const auto& cfg = model_.config();
diff --git a/src/model/model.cpp b/src/model/model.cpp
index 55932e4..ed8881f 100644
--- a/src/model/model.cpp
+++ b/src/model/model.cpp
@@ -11,6 +11,7 @@
 #    include <cuda_runtime.h>
 #endif
 
+#include "forge/backend.h"
 #include "forge/gguf_model.h"
 #include "forge/logger.h"
 #include "forge/ninf_model.h"
@@ -162,6 +163,18 @@ bool Model::load(const std::string& model_path, int n_gpu_layers) {
         config_ = parse_config_from_ninf(*loader_);
     }
 
+    // Without a usable CUDA device (a CPU-only build, or no GPU present) all
+    // layers load on the CPU: "auto"/"all" (negative; -1 is the default -ngl)
+    // become 0 and an explicit count is ignored. Placing them on CUDA anyway
+    // made the loader copy every tensor instead of mapping it, and marked the
+    // model as a CUDA model, so later transfers threw "CUDA not available".
+    if (n_gpu_layers != 0 && !BackendManager::instance().has_cuda()) {
+        if (n_gpu_layers > 0)
+            LOG_WARN("-ngl " + std::to_string(n_gpu_layers) +
+                     ": no CUDA device is available; running all layers on the CPU");
+        n_gpu_layers = 0;
+    }
+
     // Compute per-layer device vector from n_gpu_layers
     int num_layers = config_.num_layers;
     std::vector<DeviceType> layer_devices(num_layers);
-- 
