From 53d200a9c2e719a6276a167eb4ebef6207afd67b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 04:11:35 +0000
Subject: [PATCH 12/20] fix(inspect): refuse GGUF files that do not fit size_t
 on 32-bit hosts

The scanner mapped static_cast<size_t>(st_size) bytes, which on a 32-bit
host silently truncates files over 4 GiB. Report an error instead, like
the model loader does.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/inspect/perf/gguf_scanner.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/inspect/perf/gguf_scanner.cpp b/src/inspect/perf/gguf_scanner.cpp
index 58318e8..50c2474 100644
--- a/src/inspect/perf/gguf_scanner.cpp
+++ b/src/inspect/perf/gguf_scanner.cpp
@@ -4,6 +4,7 @@
 #include <cstdio>
 #include <cstring>
 #include <cerrno>
+#include <limits>
 #include <unordered_map>
 
 #include "../core/platform.h"
@@ -209,6 +210,14 @@ GgufSnapshot load_gguf(const std::string& path, int threads, ThreadPool* pool) {
         snap.error = "cannot stat file '" + path + "': " + std::strerror(errno);
         return snap;
     }
+    // The whole file is mapped at once, so it must fit in size_t (a 32-bit
+    // host would otherwise silently map only st_size mod 4 GiB bytes).
+    if (static_cast<uint64_t>(sb.st_size) > std::numeric_limits<size_t>::max()) {
+        forge_close(fd);
+        snap.ok = false;
+        snap.error = "file is too large to map in this process's address space: " + path;
+        return snap;
+    }
     const size_t file_size = static_cast<size_t>(sb.st_size);
     snap.file_size = file_size;
 
