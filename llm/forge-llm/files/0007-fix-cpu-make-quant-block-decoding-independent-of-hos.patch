diff --git a/include/forge/byteorder.h b/include/forge/byteorder.h
new file mode 100644
index 0000000..4420d8d
--- /dev/null
+++ b/include/forge/byteorder.h
@@ -0,0 +1,77 @@
+#pragma once
+// Byte-order helpers.
+//
+// GGUF and the ggml quantization block formats are little-endian. Code that
+// reinterprets a byte array as wider words (or a word table as bytes) must go
+// through these helpers so it gives the same result on big-endian hosts. On
+// little-endian hosts every function here compiles to a plain load/store.
+
+#include <cstdint>
+#include <cstring>
+
+#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && \
+    __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#    define FORGE_BIG_ENDIAN 1
+#else
+#    define FORGE_BIG_ENDIAN 0
+#endif
+
+namespace forge {
+
+inline constexpr bool kHostBigEndian = FORGE_BIG_ENDIAN != 0;
+
+constexpr uint16_t bswap16(uint16_t v) {
+    return static_cast<uint16_t>((v >> 8) | (v << 8));
+}
+
+constexpr uint32_t bswap32(uint32_t v) {
+    return (v >> 24) | ((v >> 8) & 0x0000FF00u) | ((v << 8) & 0x00FF0000u) | (v << 24);
+}
+
+constexpr uint64_t bswap64(uint64_t v) {
+    return (static_cast<uint64_t>(bswap32(static_cast<uint32_t>(v))) << 32) |
+           bswap32(static_cast<uint32_t>(v >> 32));
+}
+
+// Little-endian loads from (possibly unaligned) memory.
+inline uint16_t load_le16(const void* p) {
+    uint16_t v;
+    std::memcpy(&v, p, sizeof(v));
+    return kHostBigEndian ? bswap16(v) : v;
+}
+
+inline uint32_t load_le32(const void* p) {
+    uint32_t v;
+    std::memcpy(&v, p, sizeof(v));
+    return kHostBigEndian ? bswap32(v) : v;
+}
+
+inline uint64_t load_le64(const void* p) {
+    uint64_t v;
+    std::memcpy(&v, p, sizeof(v));
+    return kHostBigEndian ? bswap64(v) : v;
+}
+
+// Little-endian stores to (possibly unaligned) memory. store_le64(dst, v)
+// writes v's least significant byte first, which is how the ggml I-quant grid
+// tables (uint64_t/uint32_t constants holding one grid value per byte) are
+// meant to be read.
+inline void store_le16(void* p, uint16_t v) {
+    if (kHostBigEndian)
+        v = bswap16(v);
+    std::memcpy(p, &v, sizeof(v));
+}
+
+inline void store_le32(void* p, uint32_t v) {
+    if (kHostBigEndian)
+        v = bswap32(v);
+    std::memcpy(p, &v, sizeof(v));
+}
+
+inline void store_le64(void* p, uint64_t v) {
+    if (kHostBigEndian)
+        v = bswap64(v);
+    std::memcpy(p, &v, sizeof(v));
+}
+
+}  // namespace forge
