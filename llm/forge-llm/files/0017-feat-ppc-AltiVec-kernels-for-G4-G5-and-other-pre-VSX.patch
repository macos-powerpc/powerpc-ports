@@ -22,6 +22,7 @@
 #   qemu_candidates qemu binary names tried in order
 #   cflags          arch-specific compile flags
 #   inc_dirs        extra -I include directories (relative to PROJECT_SOURCE_DIR)
+#   [qemu_args]     optional extra arguments for the emulator (e.g. -cpu 7450)
 function(
   forge_add_cross_test
   name
@@ -77,8 +78,12 @@ function(
   add_custom_target(${name}-build ALL DEPENDS ${out_bin})
 
   # ctest wrapper script so `ctest` transparently runs under qemu.
+  set(qemu_args "")
+  if(ARGC GREATER 6)
+    string(REPLACE ";" " " qemu_args "${ARGV6}")
+  endif()
   set(runner ${out_dir}/${name}.sh)
-  file(WRITE ${runner} "#!/bin/sh\nexec ${qemu_found} ${out_bin}\n")
+  file(WRITE ${runner} "#!/bin/sh\nexec ${qemu_found} ${qemu_args} ${out_bin}\n")
   execute_process(COMMAND chmod +x ${runner})
 
   add_test(NAME ${name} COMMAND ${runner})
@@ -94,6 +99,20 @@ forge_add_cross_test(
   vsx-ppc64-kernels tests/test_ppc64_vsx_kernels.cpp powerpc64le-linux-gnu-g++
   "qemu-ppc64le-static;qemu-ppc64le" "-DUSE_VSX;-mcpu=power8" "")
 
+# The same PowerPC kernels built for AltiVec only (G4: 32-bit, big-endian, no
+# VSX) and run on an emulated 7450, which traps on any VSX instruction. The
+# compiler name and extra flags (e.g. --sysroot) can be overridden for
+# toolchains installed under other names.
+set(FORGE_CROSS_PPC32_CXX "powerpc-linux-gnu-g++"
+    CACHE STRING "32-bit big-endian PowerPC cross compiler for the AltiVec tests")
+set(FORGE_CROSS_PPC32_FLAGS "" CACHE STRING
+    "Extra flags for FORGE_CROSS_PPC32_CXX (e.g. --sysroot=...)")
+set(_forge_altivec_flags -DUSE_ALTIVEC -mcpu=7450 -maltivec -mabi=altivec
+                         ${FORGE_CROSS_PPC32_FLAGS} -pthread)
+forge_add_cross_test(
+  altivec-ppc-kernels tests/test_ppc64_vsx_kernels.cpp ${FORGE_CROSS_PPC32_CXX}
+  "qemu-ppc-static;qemu-ppc" "${_forge_altivec_flags}" "" "-cpu;7450")
+
 # Auto-discover every *.cpp under tests/arch/<arch>/ and cross-build it with
 # the matching toolchain + include path.
 file(GLOB ARM64_SOURCES CONFIGURE_DEPENDS
@@ -114,4 +133,8 @@ foreach(src IN LISTS PPC64_SOURCES)
     ppc64-${stem} tests/arch/ppc64/${stem}.cpp powerpc64le-linux-gnu-g++
     "qemu-ppc64le-static;qemu-ppc64le" "-DUSE_VSX;-mcpu=power8"
     "src/operators/cpu/arch/ppc64;src/operators/cpu/common;tests/arch")
+  forge_add_cross_test(
+    altivec-${stem} tests/arch/ppc64/${stem}.cpp ${FORGE_CROSS_PPC32_CXX}
+    "qemu-ppc-static;qemu-ppc" "${_forge_altivec_flags}"
+    "src/operators/cpu/arch/ppc64;src/operators/cpu/common;tests/arch" "-cpu;7450")
 endforeach()
