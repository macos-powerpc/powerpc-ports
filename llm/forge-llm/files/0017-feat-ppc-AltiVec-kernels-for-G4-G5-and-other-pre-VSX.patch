diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4f4a1f4..d4c9dc8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -85,9 +85,22 @@ if(FORGE_CPU_HAS_MATMUL_INT8)
     forge_cpu_features
     INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-march=armv8.2-a+dotprod+i8mm>)
 endif()
-if(FORGE_CPU_HAS_VSX)
-  target_compile_definitions(forge_cpu_features INTERFACE USE_VSX)
-  target_compile_options(forge_cpu_features INTERFACE -mcpu=power8)
+if(FORGE_CPU_HAS_ALTIVEC)
+  # The PowerPC kernels are guarded by USE_ALTIVEC; USE_VSX adds the VSX
+  # load/store/divide forms (see src/operators/cpu/arch/ppc64/ppc_simd.h).
+  target_compile_definitions(forge_cpu_features INTERFACE USE_ALTIVEC)
+  if(FORGE_CPU_HAS_VSX)
+    target_compile_definitions(forge_cpu_features INTERFACE USE_VSX)
+    if(NOT FORGE_TUNE_MARCH)
+      target_compile_options(forge_cpu_features INTERFACE -mcpu=power8)
+    endif()
+  else()
+    target_compile_options(forge_cpu_features INTERFACE -maltivec)
+    if(NOT APPLE)
+      # Darwin's ABI already includes the AltiVec extensions.
+      target_compile_options(forge_cpu_features INTERFACE -mabi=altivec)
+    endif()
+  endif()
 endif()
 
 option(USE_CUBLAS "Use cuBLAS for GPU matrix operations" ON)
diff --git a/cmake/cross_tests.cmake b/cmake/cross_tests.cmake
