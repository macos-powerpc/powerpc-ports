new file mode 100644
index 0000000..fa5add9
--- /dev/null
+++ b/src/operators/cpu/arch/ppc64/ppc_simd.h
@@ -0,0 +1,101 @@
+#pragma once
+// PowerPC SIMD portability layer for the arch/ppc64 kernels.
+//
+// The kernels are written against the AltiVec (VMX) intrinsics, which every
+// SIMD PowerPC has: G4/G5 and POWER6 (AltiVec only), POWER7+ (VSX, a superset).
+// The few operations that differ are wrapped here:
+//
+//   ppc_load(p)      unaligned 16-byte load  (VSX: lxvw4x; AltiVec: lvsl/vperm)
+//   ppc_store(v, p)  unaligned 16-byte store (VSX: stxvw4x; AltiVec: stvx when
+//                    aligned, else a plain 16-byte copy)
+//   ppc_div(a, b)    float division (VSX: xvdivsp; AltiVec: reciprocal estimate
+//                    refined by Newton-Raphson; b must be a normal float)
+//
+// USE_VSX builds also define USE_ALTIVEC (set here if a caller passed only
+// USE_VSX), so code guarded by USE_ALTIVEC covers both.
+//
+// AltiVec's lvx/stvx ignore the low four address bits instead of faulting, so
+// never use vec_ld/vec_st on data that is not known to be 16-byte aligned.
+
+#if defined(USE_VSX) && !defined(USE_ALTIVEC)
+#    define USE_ALTIVEC 1
+#endif
+
+#ifdef USE_ALTIVEC
+
+#    include <altivec.h>
+// In GNU C++ modes altivec.h may define these as macros; the kernels spell
+// the keywords __vector/__bool, and the plain names must stay usable.
+#    undef vector
+#    undef pixel
+#    undef bool
+
+#    include <cstdint>
+#    include <cstring>
+
+namespace forge {
+namespace cpu {
+
+namespace ppc_detail {
+template <typename T> struct vec_of;
+template <> struct vec_of<float> { using type = __vector float; };
+template <> struct vec_of<signed char> { using type = __vector signed char; };
+template <> struct vec_of<unsigned char> { using type = __vector unsigned char; };
+template <> struct vec_of<short> { using type = __vector signed short; };
+template <> struct vec_of<unsigned short> { using type = __vector unsigned short; };
+template <> struct vec_of<int> { using type = __vector signed int; };
+template <> struct vec_of<unsigned int> { using type = __vector unsigned int; };
+}  // namespace ppc_detail
+
+// 16 bytes from p (any alignment) as the vector type matching *p.
+template <typename T>
+static inline typename ppc_detail::vec_of<T>::type ppc_load(const T* p) {
+#    ifdef USE_VSX
+    return vec_xl(0, p);
+#    else
+    // Classic big-endian AltiVec unaligned load: the two aligned quadwords
+    // covering [p, p+16) merged by the lvsl permute. The second load uses
+    // offset 15, not 16, so it never touches the quadword after p+15 (which
+    // could be past the end of a mapping).
+    const unsigned char* b = reinterpret_cast<const unsigned char*>(p);
+    __vector unsigned char lo = vec_ld(0, b);
+    __vector unsigned char hi = vec_ld(15, b);
+    return (typename ppc_detail::vec_of<T>::type)vec_perm(lo, hi, vec_lvsl(0, b));
+#    endif
+}
+
+// Store the 16 bytes of v at p (any alignment).
+template <typename V, typename T>
+static inline void ppc_store(V v, T* p) {
+#    ifdef USE_VSX
+    vec_xst(v, 0, p);
+#    else
+    if ((reinterpret_cast<uintptr_t>(p) & 15) == 0) {
+        vec_st(v, 0, p);
+    } else {
+        // Element stores rather than a read-modify-write of the two covering
+        // quadwords: neighbouring bytes may belong to another thread's output.
+        std::memcpy(p, &v, 16);
+    }
+#    endif
+}
+
+static inline __vector float ppc_div(__vector float a, __vector float b) {
+#    ifdef USE_VSX
+    return a / b;
+#    else
