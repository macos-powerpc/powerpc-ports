 // ---- Tests ----
 
+// ppc_div: VSX divides; AltiVec refines a reciprocal estimate. Either must be
+// within a couple of ulps of the correctly rounded quotient.
+static void test_ppc_div() {
+    std::mt19937 rng(3);
+    std::uniform_real_distribution<float> mant(1.0f, 2.0f);
+    std::uniform_int_distribution<int> expo(-60, 60);
+    int bad = 0;
+    for (int i = 0; i < 4096 && bad < 3; ++i) {
+        alignas(16) float a[4], b[4], q[4];
+        for (int j = 0; j < 4; ++j) {
+            a[j] = std::ldexp(mant(rng), expo(rng)) * ((rng() & 1) ? -1.0f : 1.0f);
+            b[j] = std::ldexp(mant(rng), expo(rng));
+        }
+        forge::cpu::ppc_store(forge::cpu::ppc_div(forge::cpu::ppc_load(a), forge::cpu::ppc_load(b)), q);
+        for (int j = 0; j < 4; ++j) {
+            const float want = a[j] / b[j];
+            if (std::fabs(q[j] - want) > 2.5e-7f * std::fabs(want)) {
+                std::printf("  FAIL ppc_div %g / %g: got=%.9g want=%.9g\n", a[j], b[j], q[j], want);
+                ++bad;
+            }
+        }
+    }
+    if (bad) ++tests_failed;
+    else { ++tests_passed; std::printf("  PASS ppc_div (4096 x 4)\n"); }
+}
