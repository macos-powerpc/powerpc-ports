From 133f6f05aff312c69fa3e6cf755cf444bb490bb3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 03:59:59 +0000
Subject: [PATCH 09/20] test(arch): read I-quant grid tables byte-order
 independently

The shared IQ2_S/IQ2_XS/IQ3_S scalar references in tests/arch/*.inc
read grid values through a byte pointer into the uint64_t/uint32_t
tables, which gives them in reverse order on big-endian hosts. Unpack
them with forge::store_le64/store_le32, as the kernels and the scalar
dequant routines do. No change on little-endian hosts; on 32-bit
big-endian PowerPC (qemu-ppc) the ppc64 IQ tests now pass.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tests/arch/iq234nl_common.inc |  8 ++++++--
 tests/arch/iq3s_common.inc    | 16 ++++++++--------
 2 files changed, 14 insertions(+), 10 deletions(-)

diff --git a/tests/arch/iq234nl_common.inc b/tests/arch/iq234nl_common.inc
index 8786860..a7a5d57 100644
--- a/tests/arch/iq234nl_common.inc
+++ b/tests/arch/iq234nl_common.inc
@@ -18,6 +18,8 @@
 #include <vector>
 #include <limits>
 
+#include "forge/byteorder.h"
+
 #include "quant_tables.h"
 
 static uint16_t to_fp16(float v) {
@@ -62,7 +64,8 @@ static float ref_dot_iq2_s_q8_K(const uint8_t* blk, const forge::cpu::block_q8_K
             int base = ib32 * 32;
             for (int l = 0; l < 4; ++l) {
                 int grid_idx = qs[l] | ((qh[ib32] << (8 - 2 * l)) & 0x300);
-                const uint8_t* g = reinterpret_cast<const uint8_t*>(&forge::ops::iq2s_grid[grid_idx]);
+                uint8_t g[8];  // grid values, least significant byte first
+                forge::store_le64(g, forge::ops::iq2s_grid[grid_idx]);
                 float db = (l < 2) ? db0 : db1;
                 for (int j = 0; j < 8; ++j) {
                     float s = (signs[l] & kmask_iq2[j]) ? -1.f : 1.f;
@@ -91,7 +94,8 @@ static float ref_dot_iq2_xs_q8_K(const uint8_t* blk, const forge::cpu::block_q8_
             int base = ib32 * 32;
             for (int l = 0; l < 4; ++l) {
                 const uint16_t v = q2[4 * ib32 + l];
-                const uint8_t* g = reinterpret_cast<const uint8_t*>(&forge::ops::iq2xs_grid[v & 511]);
+                uint8_t g[8];
+                forge::store_le64(g, forge::ops::iq2xs_grid[v & 511]);
                 const uint8_t sb = forge::ops::ksigns_iq2xs[v >> 9];
                 float db = (l < 2) ? db0 : db1;
                 for (int j = 0; j < 8; ++j) {
diff --git a/tests/arch/iq3s_common.inc b/tests/arch/iq3s_common.inc
index b24038b..d8080d2 100644
--- a/tests/arch/iq3s_common.inc
+++ b/tests/arch/iq3s_common.inc
@@ -17,6 +17,8 @@
 #include <vector>
 #include <limits>
 
+#include "forge/byteorder.h"
+
 #include "quant_tables.h"
 
 static uint16_t to_fp16(float v) {
@@ -63,10 +65,9 @@ static float ref_dot_iq3_s_q8_K(const uint8_t* blk, const forge::cpu::block_q8_K
             int base = ib32 * 32;
             // group ib32 -> qh[0], group ib32+1 -> qh[1]
             for (int l = 0; l < 4; ++l) {
-                const uint8_t* g1a = reinterpret_cast<const uint8_t*>(
-                    &forge::ops::iq3s_grid[qs[2*l]     | ((qh[0] << (8 - 2*l)) & 256)]);
-                const uint8_t* g2a = reinterpret_cast<const uint8_t*>(
-                    &forge::ops::iq3s_grid[qs[2*l + 1] | ((qh[0] << (7 - 2*l)) & 256)]);
+                uint8_t g1a[4], g2a[4];  // grid values, least significant byte first
+                forge::store_le32(g1a, forge::ops::iq3s_grid[qs[2*l]     | ((qh[0] << (8 - 2*l)) & 256)]);
+                forge::store_le32(g2a, forge::ops::iq3s_grid[qs[2*l + 1] | ((qh[0] << (7 - 2*l)) & 256)]);
                 for (int j = 0; j < 4; ++j) {
                     float s1 = (signs[l] & kmask[j]) ? -1.f : 1.f;
                     float s2 = (signs[l] & kmask[j+4]) ? -1.f : 1.f;
@@ -76,10 +77,9 @@ static float ref_dot_iq3_s_q8_K(const uint8_t* blk, const forge::cpu::block_q8_K
             }
             qs += 8; signs += 4;
             for (int l = 0; l < 4; ++l) {
-                const uint8_t* g1b = reinterpret_cast<const uint8_t*>(
-                    &forge::ops::iq3s_grid[qs[2*l]     | ((qh[1] << (8 - 2*l)) & 256)]);
-                const uint8_t* g2b = reinterpret_cast<const uint8_t*>(
-                    &forge::ops::iq3s_grid[qs[2*l + 1] | ((qh[1] << (7 - 2*l)) & 256)]);
+                uint8_t g1b[4], g2b[4];  // grid values, least significant byte first
+                forge::store_le32(g1b, forge::ops::iq3s_grid[qs[2*l]     | ((qh[1] << (8 - 2*l)) & 256)]);
+                forge::store_le32(g2b, forge::ops::iq3s_grid[qs[2*l + 1] | ((qh[1] << (7 - 2*l)) & 256)]);
                 for (int j = 0; j < 4; ++j) {
                     float s1 = (signs[l] & kmask[j]) ? -1.f : 1.f;
                     float s2 = (signs[l] & kmask[j+4]) ? -1.f : 1.f;
