From 5c71c205ab8852aa9b2b03fd432859bd147b9a58 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 03:45:50 +0000
Subject: [PATCH 01/20] fix(gguf): read GGUF bool metadata as uint8_t

GGUF stores bools as a single byte, but the loader and the inspect
scanner memcpy'd that byte into a C++ bool. sizeof(bool) is
implementation-defined; on PowerPC Darwin it is 4, so three bytes stayed
uninitialized and, on a big-endian host, the file byte landed in the most
significant one. A false flag such as tokenizer.ggml.add_bos_token could
read back as true.

Read the byte into uint8_t instead (the tokenizer's metadata reader
already does this via read_u8()).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/inspect/perf/gguf_scanner.cpp | 4 ++--
 src/model/gguf_model.cpp          | 5 +++--
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/inspect/perf/gguf_scanner.cpp b/src/inspect/perf/gguf_scanner.cpp
index 95a65a3..58318e8 100644
--- a/src/inspect/perf/gguf_scanner.cpp
+++ b/src/inspect/perf/gguf_scanner.cpp
@@ -352,7 +352,7 @@ GgufSnapshot load_gguf(const std::string& path, int threads, ThreadPool* pool) {
             case 4: { uint32_t v; if (off + 4 > size) break; std::memcpy(&v, data + off, 4); off += 4; part.meta_int[key] = v; break; }
             case 5: { int32_t v; if (off + 4 > size) break; std::memcpy(&v, data + off, 4); off += 4; part.meta_int[key] = v; break; }
             case 6: { float v; if (off + 4 > size) break; std::memcpy(&v, data + off, 4); off += 4; part.meta_float[key] = v; break; }
-            case 7: { bool v; if (off + 1 > size) break; std::memcpy(&v, data + off, 1); off += 1; part.meta_int[key] = v ? 1 : 0; break; }
+            case 7: { uint8_t v; if (off + 1 > size) break; std::memcpy(&v, data + off, 1); off += 1; part.meta_int[key] = v ? 1 : 0; break; }
             case 8: { std::string v = read_gguf_string(data, size, off); part.meta_str[key] = v; break; }
             case 9: {
                 if (off + 12 > size) break;
@@ -374,7 +374,7 @@ GgufSnapshot load_gguf(const std::string& path, int threads, ThreadPool* pool) {
                     std::vector<int32_t> arr(arr_len);
                     for (uint64_t j = 0; j < arr_len; ++j) {
                         if (off + 1 > size) break;
-                        bool v;
+                        uint8_t v;
                         std::memcpy(&v, data + off, 1);
                         off += 1;
                         arr[j] = v ? 1 : 0;
diff --git a/src/model/gguf_model.cpp b/src/model/gguf_model.cpp
index 8a85aab..d697fdd 100644
--- a/src/model/gguf_model.cpp
+++ b/src/model/gguf_model.cpp
@@ -260,7 +260,8 @@ bool GgufModel::load(const std::string& path) {
             break;
         }
         case 7: {
-            bool val;
+            // GGUF bools are one byte; sizeof(bool) is not (4 on PowerPC Darwin).
+            uint8_t val;
             std::memcpy(&val, data + offset, 1);
             offset += 1;
             metadata_int_[key] = val ? 1 : 0;
@@ -290,7 +291,7 @@ bool GgufModel::load(const std::string& path) {
             } else if (arr_type == 7) {  // BOOL array -> store as INT32 array
                 std::vector<int32_t> arr(arr_len);
                 for (uint64_t j = 0; j < arr_len; ++j) {
-                    bool val;
+                    uint8_t val;
                     std::memcpy(&val, data + offset, 1);
                     offset += 1;
                     arr[j] = val ? 1 : 0;
-- 
