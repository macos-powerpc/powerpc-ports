+// Relative tolerance for the quantized kernels, whose integer-dot-then-scale
+// arithmetic rounds differently from the dequantize-then-dot reference.
+static void check_rel_f32(const char* name, const float* got, const float* expected,
+                          int n, float rel_tol) {
+    int errors = 0;
+    for (int i = 0; i < n && errors < 3; ++i) {
+        float diff = std::fabs(got[i] - expected[i]);
+        if (diff > rel_tol * std::max(1.0f, std::fabs(expected[i]))) {
+            std::printf("  FAIL %s[%d]: got=%.6f expected=%.6f diff=%.2e\n",
+                        name, i, got[i], expected[i], diff);
+            ++errors;
+        }
+    }
+    if (errors == 0) { ++tests_passed; std::printf("  PASS %s (n=%d)\n", name, n); }
+    else { ++tests_failed; }
+}
+
+static void check_rel_f32_scalar(const char* name, float got, float expected, float rel_tol) {
+    check_rel_f32(name, &got, &expected, 1, rel_tol);
