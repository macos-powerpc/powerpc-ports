+// ============================================================================
+// Shared helpers for the K-quant GEMMs
+// ============================================================================
+
+// acc += 16-lane signed-byte dot product of a and b, as 4 int32 partial sums.
+static inline __vector signed int dot16_s8_acc_vsx(__vector signed char a,
+                                                   __vector signed char b,
+                                                   __vector signed int acc) {
+    acc = vec_sum4s(vec_mule(a, b), acc);
+    return vec_sum4s(vec_mulo(a, b), acc);
+}
+
+static inline int hsum_i32x4_vsx(__vector signed int v) {
+    union { __vector signed int vi; int i[4]; } u;
+    u.vi = v;
+    return u.i[0] + u.i[1] + u.i[2] + u.i[3];
+}
+
 // ============================================================================
 // Q4_K GEMM: decode (M=1) and prefill (M>1)
 // Q4_K block: 144 bytes per 256 elements
 // Layout: d[2](fp16) + dmin[2](fp16) + scales[12] + qs[128]
-// 8 sub-blocks of 32 elements each.
-// Value = scale_sb * nibble + min_sb (super-block scale + min applied after).
+// 8 sub-blocks of 32 elements; qs is consumed 32 bytes (64 elements) at a time:
+// the low nibbles are sub-block 2j, the high nibbles sub-block 2j+1.
+// Value = d * sc[sb] * nibble - dmin * mn[sb]  (see dequantize_q4_k_row).
 // ============================================================================
 
+// Dot product of one Q4_K block with one Q8_K block, before the d / dmin
+// scaling: returns sum_sb sc[sb] * dot(q4, q8) and, via *min_acc,
+// sum_sb mn[sb] * sum(q8) for the sub-block.
+static inline int dot_q4_K_q8_K_block_vsx(const uint8_t* q4_qs, const uint8_t sc[8],
+                                          const uint8_t mn[8], const block_q8_K* y,
+                                          int* min_acc) {
+    const __vector unsigned char m4 = vec_splats((unsigned char)0x0F);
+    const __vector unsigned char s4 = vec_splats((unsigned char)4);
+    const __vector signed int zero = vec_splats((int)0);
+    const int8_t* q8 = y->qs;
+    int acc = 0, macc = 0;
+    for (int j = 0; j < 4; ++j) {
+        __vector unsigned char b0 = vec_xl(0, q4_qs + 32 * j);
+        __vector unsigned char b1 = vec_xl(0, q4_qs + 32 * j + 16);
+        __vector signed char q8_0 = vec_xl(0, q8 + 64 * j);
+        __vector signed char q8_1 = vec_xl(0, q8 + 64 * j + 16);
+        __vector signed char q8_2 = vec_xl(0, q8 + 64 * j + 32);
+        __vector signed char q8_3 = vec_xl(0, q8 + 64 * j + 48);
+
+        __vector signed int lo = dot16_s8_acc_vsx((__vector signed char)(b0 & m4), q8_0, zero);
+        lo = dot16_s8_acc_vsx((__vector signed char)(b1 & m4), q8_1, lo);
+        __vector signed int hi = dot16_s8_acc_vsx((__vector signed char)vec_sr(b0, s4), q8_2, zero);
+        hi = dot16_s8_acc_vsx((__vector signed char)vec_sr(b1, s4), q8_3, hi);
+
+        acc += hsum_i32x4_vsx(lo) * sc[2 * j] + hsum_i32x4_vsx(hi) * sc[2 * j + 1];
+        // bsums[k] = sum of q8[16k .. 16k+15]
+        macc += (y->bsums[4 * j] + y->bsums[4 * j + 1]) * mn[2 * j] +
+                (y->bsums[4 * j + 2] + y->bsums[4 * j + 3]) * mn[2 * j + 1];
+    }
+    *min_acc = macc;
+    return acc;
+}
