+// ---- K-quant GEMM Tests ----
+
+// Random K-quant blocks: random bytes everywhere, then sane positive fp16
+// values at the given scale offsets (in host order, as the kernels read them).
+static void make_random_kquant_blocks(std::mt19937& rng, uint8_t* w, int nblocks,
+                                      int block_bytes, std::initializer_list<int> f16_offsets) {
+    std::uniform_int_distribution<int> byte(0, 255);
+    std::uniform_real_distribution<float> scale(0.01f, 0.1f);
+    for (int i = 0; i < nblocks * block_bytes; ++i) w[i] = (uint8_t)byte(rng);
+    for (int b = 0; b < nblocks; ++b)
+        for (int off : f16_offsets) {
+            uint16_t h = encode_fp16(scale(rng));
+            std::memcpy(w + (size_t)b * block_bytes + off, &h, 2);
+        }
+}
+
+// out[m][n] = sum_k dequant(w[n])[k] * dequant(q8_K(a[m]))[k]
+static void ref_gemm_kquant(DequantRowFn dequant, const float* a, const uint8_t* w,
+                            float* out, int M, int K, int N) {
+    const int nb = K / 256;
+    std::vector<forge::cpu::block_q8_K> q8((size_t)nb);
+    std::vector<float> wrow(K);
+    for (int m = 0; m < M; ++m) {
+        forge::cpu::quantize_row_q8_K(a + (size_t)m * K, q8.data(), K);
+        for (int n = 0; n < N; ++n) {
+            dequant(w, wrow.data(), K, n);
+            double acc = 0.0;
+            for (int k = 0; k < K; ++k)
+                acc += (double)wrow[k] * q8[k / 256].qs[k % 256] * q8[k / 256].d;
+            out[(size_t)m * N + n] = (float)acc;
+        }
+    }
+}
+
+using GemmFn = void (*)(const float*, const uint8_t*, float*, int, int, int);
+static void test_gemm_kquant(const char* name, GemmFn gemm, DequantRowFn dequant,
+                             int block_bytes, std::initializer_list<int> f16_offsets) {
+    std::mt19937 rng(7);
+    for (int nb : {1, 2, 4}) {
+        const int K = nb * 256;
+        for (int M : {1, 3}) {
+            for (int N : {1, 5, 8}) {
+                std::vector<float> a((size_t)M * K);
+                fill_random(rng, a.data(), M * K, 2.0f);
+                std::vector<uint8_t> w((size_t)N * nb * block_bytes);
+                make_random_kquant_blocks(rng, w.data(), N * nb, block_bytes, f16_offsets);
+                std::vector<float> out((size_t)M * N), ref((size_t)M * N);
+                gemm(a.data(), w.data(), out.data(), M, K, N);
+                ref_gemm_kquant(dequant, a.data(), w.data(), ref.data(), M, K, N);
+                check_rel_f32(name, out.data(), ref.data(), M * N, 1e-4f);
+            }
         }
     }
 }
