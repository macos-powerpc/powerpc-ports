 // Q6_K GEMM: decode (M=1) and prefill (M>1)
 // Q6_K block: 210 bytes per 256 elements
 // Layout: ql[128] + qh[64] + scales[16] int8 + d[2] fp16
-// 16 sub-blocks of 16 elements each.
-// Value = (ql_lo4 | (qh_hi2 << 4)) - 32, then × scale_sb × d
-// Uses scalar decode loop for each sub-block, then VSX mule/mulo dot with Q8.
+// Two 128-element halves, each using 64 ql bytes, 32 qh bytes and 8 scales.
+// Within a half, for l in [0, 32):
+//   e[l]      = (ql[l]    & 0xF) | ((qh[l] >> 0) & 3) << 4   (scale sc[l/16 + 0])
+//   e[l + 32] = (ql[l+32] & 0xF) | ((qh[l] >> 2) & 3) << 4   (scale sc[l/16 + 2])
+//   e[l + 64] = (ql[l]    >> 4)  | ((qh[l] >> 4) & 3) << 4   (scale sc[l/16 + 4])
+//   e[l + 96] = (ql[l+32] >> 4)  | ((qh[l] >> 6) & 3) << 4   (scale sc[l/16 + 6])
+// minus 32, times d (see dequantize_q6_k_row).
 // ============================================================================
 
+// sum_sub-block sc * dot(q6, q8) for one Q6_K block, before the d scaling.
+static inline int dot_q6_K_q8_K_block_vsx(const block_q6_K* x, const block_q8_K* y) {
+    const __vector unsigned char m4 = vec_splats((unsigned char)0x0F);
+    const __vector unsigned char m3 = vec_splats((unsigned char)3);
+    const __vector unsigned char s2 = vec_splats((unsigned char)2);
+    const __vector unsigned char s4 = vec_splats((unsigned char)4);
+    const __vector unsigned char s6 = vec_splats((unsigned char)6);
+    const __vector signed char off = vec_splats((signed char)32);
+    const __vector signed int zero = vec_splats((int)0);
+    int acc = 0;
+    for (int half = 0; half < 2; ++half) {
+        const uint8_t* ql = x->ql + 64 * half;
+        const uint8_t* qh = x->qh + 32 * half;
+        const int8_t* sc = x->scales + 8 * half;
+        const int8_t* q8 = y->qs + 128 * half;
+        for (int g = 0; g < 2; ++g) {  // l in [16g, 16g + 16)
+            const int l0 = 16 * g;
+            __vector unsigned char a = vec_xl(0, ql + l0);
+            __vector unsigned char b = vec_xl(0, ql + 32 + l0);
+            __vector unsigned char h = vec_xl(0, qh + l0);
+            __vector signed char q1 = (__vector signed char)((a & m4) | vec_sl(h & m3, s4)) - off;
+            __vector signed char q2 = (__vector signed char)((b & m4) | vec_sl(vec_sr(h, s2) & m3, s4)) - off;
+            __vector signed char q3 = (__vector signed char)(vec_sr(a, s4) | vec_sl(vec_sr(h, s4) & m3, s4)) - off;
+            __vector signed char q4 = (__vector signed char)(vec_sr(b, s4) | vec_sl(vec_sr(h, s6), s4)) - off;
+            acc += hsum_i32x4_vsx(dot16_s8_acc_vsx(q1, vec_xl(0, q8 + l0), zero)) * sc[g + 0];
+            acc += hsum_i32x4_vsx(dot16_s8_acc_vsx(q2, vec_xl(0, q8 + 32 + l0), zero)) * sc[g + 2];
+            acc += hsum_i32x4_vsx(dot16_s8_acc_vsx(q3, vec_xl(0, q8 + 64 + l0), zero)) * sc[g + 4];
+            acc += hsum_i32x4_vsx(dot16_s8_acc_vsx(q4, vec_xl(0, q8 + 96 + l0), zero)) * sc[g + 6];
+        }
+    }
+    return acc;
+}
