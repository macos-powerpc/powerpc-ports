From 76dde577147dbdacd2885f06c1b8c347200f3896 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 04:01:02 +0000
Subject: [PATCH 10/20] fix(kv-cache): stop the VSX fp32->fp16 batch store
 writing past the end

fp32_to_fp16_batch_simd converted 4 floats per iteration, packed them
with vec_pack(result, result) and stored all 16 bytes, i.e. 8 halves for
4 inputs. Each store wrote 4 halves beyond the current group, and the
last one wrote 8 bytes past dst[n] whenever n >= 4.

Convert 8 floats per iteration and pack the two halves into one full
store; the scalar tail handles the rest. Checked for n = 0..40 with
canaries after dst[n]: the old code overran for every n >= 4, the new
code never does, and its values match the scalar converter.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/inference/kv_cache.cpp | 57 +++++++++++++++++++++-----------------
 1 file changed, 31 insertions(+), 26 deletions(-)

diff --git a/src/inference/kv_cache.cpp b/src/inference/kv_cache.cpp
index 63c9901..4b5be3d 100644
--- a/src/inference/kv_cache.cpp
+++ b/src/inference/kv_cache.cpp
@@ -241,40 +241,45 @@ static void fp16_to_fp32_batch_simd(const uint16_t* src, float* dst, int n) {
     }
 }
 
-static void fp32_to_fp16_batch_simd(const float* src, uint16_t* dst, int n) {
-    int i = 0;
-    for (; i + 4 <= n; i += 4) {
-        __vector float fv = vec_xl(0, src + i);
-        __vector unsigned int bits = (__vector unsigned int)fv;
+// Four fp32 lanes -> fp16 bit patterns in the low half of each 32-bit lane.
+static __vector unsigned int vsx_float4_to_half(__vector float fv) {
+    __vector unsigned int bits = (__vector unsigned int)fv;
 
-        __vector unsigned int shift16 = vec_splats(16U);
-        __vector unsigned int shift23 = vec_splats(23U);
-        __vector unsigned int shift10 = vec_splats(10U);
-        __vector unsigned int shift13 = vec_splats(13U);
+    __vector unsigned int shift16 = vec_splats(16U);
+    __vector unsigned int shift23 = vec_splats(23U);
+    __vector unsigned int shift10 = vec_splats(10U);
+    __vector unsigned int shift13 = vec_splats(13U);
 
-        __vector unsigned int sign = vec_sr(vec_and(bits, vec_splats(0x80000000U)), shift16);
-        __vector unsigned int exp = vec_sr(vec_and(bits, vec_splats(0x7F800000U)), shift23);
-        __vector unsigned int mant = vec_and(bits, vec_splats(0x007FE000U));
+    __vector unsigned int sign = vec_sr(vec_and(bits, vec_splats(0x80000000U)), shift16);
+    __vector unsigned int exp = vec_sr(vec_and(bits, vec_splats(0x7F800000U)), shift23);
+    __vector unsigned int mant = vec_and(bits, vec_splats(0x007FE000U));
 
-        __vector unsigned int is_ge_113 = (__vector unsigned int)vec_cmpge(exp, vec_splats(113U));
-        __vector unsigned int is_ge_143 = (__vector unsigned int)vec_cmpge(exp, vec_splats(143U));
-        __vector unsigned int is_ff = (__vector unsigned int)vec_cmpeq(exp, vec_splats(0xFFU));
+    __vector unsigned int is_ge_113 = (__vector unsigned int)vec_cmpge(exp, vec_splats(113U));
+    __vector unsigned int is_ge_143 = (__vector unsigned int)vec_cmpge(exp, vec_splats(143U));
+    __vector unsigned int is_ff = (__vector unsigned int)vec_cmpeq(exp, vec_splats(0xFFU));
 
-        __vector unsigned int norm_exp = vec_sub(exp, vec_splats(112U));
-        __vector unsigned int norm_mant = vec_sr(mant, shift13);
-        __vector unsigned int norm = vec_or(sign, vec_or(vec_sl(norm_exp, shift10), norm_mant));
+    __vector unsigned int norm_exp = vec_sub(exp, vec_splats(112U));
+    __vector unsigned int norm_mant = vec_sr(mant, shift13);
+    __vector unsigned int norm = vec_or(sign, vec_or(vec_sl(norm_exp, shift10), norm_mant));
 
-        __vector unsigned int inf =
-            vec_or(sign, vec_or(vec_splats(0x7C00U), vec_sr(mant, shift13)));
+    __vector unsigned int inf =
+        vec_or(sign, vec_or(vec_splats(0x7C00U), vec_sr(mant, shift13)));
 
-        __vector unsigned int zero = sign;
+    __vector unsigned int zero = sign;
 
-        // vec_sel(a, b, c): bit from a where c=0, from b where c=1
-        __vector unsigned int result = vec_sel(zero, norm, vec_or(is_ge_113, is_ff));
-        result = vec_sel(result, inf, vec_or(is_ge_143, is_ff));
+    // vec_sel(a, b, c): bit from a where c=0, from b where c=1
+    __vector unsigned int result = vec_sel(zero, norm, vec_or(is_ge_113, is_ff));
+    return vec_sel(result, inf, vec_or(is_ge_143, is_ff));
+}
 
-        __vector unsigned short h = vec_pack(result, result);
-        vec_xst(h, 0, (unsigned short*)(dst + i));
+static void fp32_to_fp16_batch_simd(const float* src, uint16_t* dst, int n) {
+    int i = 0;
+    // 8 floats per iteration so the packed result fills exactly one 16-byte
+    // store (packing 4 lanes and storing 16 bytes wrote 8 bytes past dst[n]).
+    for (; i + 8 <= n; i += 8) {
+        __vector unsigned int lo = vsx_float4_to_half(vec_xl(0, src + i));
+        __vector unsigned int hi = vsx_float4_to_half(vec_xl(0, src + i + 4));
+        vec_xst(vec_pack(lo, hi), 0, (unsigned short*)(dst + i));
     }
     for (; i < n; ++i) {
         dst[i] = fp32_to_fp16(src[i]);
-- 
