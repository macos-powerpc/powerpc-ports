From 2f8f5875a7c48aa7ef3358343e50067ad17e668b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 06:16:26 +0000
Subject: [PATCH 14/20] fix(cli): accurate KV-floor and thread-count messages

Two startup messages described the wrong situation:

- "KV context N is below the 4096 floor -- memory is tight" fired for
  any context under 4096, including a model trained on a short context
  (e.g. 128 tokens) or a small --ctx-size, where memory played no part.
  Warn only when the memory cap reduced the context below what was
  requested.
- "CPU threads auto-detected (hybrid offload)" was printed whenever
  -ngl was below the layer count, so also for CPU-only runs (-ngl 0)
  and for the default -ngl -1 with every layer on the GPU. Say "hybrid
  offload" only for a real CPU/GPU split, and report the thread count
  plainly for CPU-only runs.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/cli/forge_cli.cpp                        | 4 +++-
 src/inference/engines/transformer_engine.cpp | 7 ++++++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/cli/forge_cli.cpp b/src/cli/forge_cli.cpp
index a33620b..1ceb721 100644
--- a/src/cli/forge_cli.cpp
+++ b/src/cli/forge_cli.cpp
@@ -664,7 +664,9 @@ int run_cli(const CliArgs& args) {
             ctx.params_mut().n_batch = args.batch_size;
         if (args.common.threads > 0) {
             std::cout << "CPU threads set to: " << args.common.threads << "\n";
-        } else if (args.common.n_gpu_layers < cfg.num_layers) {
+        } else if (!tfm_eng->uses_gpu()) {
+            std::cout << "CPU threads auto-detected: " << ctx.params().n_threads << "\n";
+        } else if (args.common.n_gpu_layers > 0 && args.common.n_gpu_layers < cfg.num_layers) {
             std::cout << "CPU threads auto-detected (hybrid offload): " << ctx.params().n_threads
                       << "\n";
         }
diff --git a/src/inference/engines/transformer_engine.cpp b/src/inference/engines/transformer_engine.cpp
index 2719800..fe3427f 100644
--- a/src/inference/engines/transformer_engine.cpp
+++ b/src/inference/engines/transformer_engine.cpp
@@ -996,6 +996,8 @@ void TransformerEngine::init_kv_cache(const ModelConfig& cfg) {
         LOG_INFO("KV cache max_seq_len set to " + std::to_string(kv_max_seq) +
                  " (user --ctx-size)");
     }
+    // What the model or --ctx-size asks for, before memory caps it below.
+    const int requested_kv_seq = kv_max_seq;
 
     // Reserve one extra KV layer per MTP nextn block: the draft module reuses
     // engine attention at layer index cfg.num_layers.
@@ -1167,7 +1169,10 @@ void TransformerEngine::init_kv_cache(const ModelConfig& cfg) {
             kv_max_seq = KV_MIN_SEQ_FLOOR;
         }
 
-        if (kv_max_seq < KV_MIN_SEQ_FLOOR) {
+        // Only when memory forced it there: a model trained on a short context
+        // (or a small --ctx-size) is below the floor by choice, not because
+        // memory is tight.
+        if (kv_max_seq < KV_MIN_SEQ_FLOOR && kv_max_seq < requested_kv_seq) {
             LOG_WARN("KV context " + std::to_string(kv_max_seq) + " is below the " +
                      std::to_string(KV_MIN_SEQ_FLOOR) +
                      " floor -- memory is tight; try fewer GPU layers, a lower "
