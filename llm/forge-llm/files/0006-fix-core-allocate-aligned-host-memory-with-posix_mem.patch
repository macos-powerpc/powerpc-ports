From fb8aad98d9af1fc939304aad0da81751f7e2a74a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 03:48:52 +0000
Subject: [PATCH 06/20] fix(core): allocate aligned host memory with
 posix_memalign

std::aligned_alloc is only declared when the C library provides C11
aligned_alloc, which older platforms lack (macOS gained it in 10.15;
PowerPC Mac OS X 10.5/10.6 never did), so host_mem_pool.cpp did not
compile there. posix_memalign is POSIX.1-2001, returns memory that is
released with free() just like before, and is available on every
non-MSVC target we build for. The MSVC path is unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/core/host_mem_pool.cpp | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/src/core/host_mem_pool.cpp b/src/core/host_mem_pool.cpp
index c65e101..92dce21 100644
--- a/src/core/host_mem_pool.cpp
+++ b/src/core/host_mem_pool.cpp
@@ -16,18 +16,19 @@ namespace host_mem {
 namespace {
 
 // 64 bytes covers AVX-512, NEON (16) and VSX (16) alignment requirements.
-// std::aligned_alloc also requires size to be a multiple of alignment, which
-// align_up() guarantees.
+// Sizes are rounded up to a multiple of it by align_up().
 constexpr size_t kAlignment = 64;
 
-// MSVC's <cstdlib> does not provide std::aligned_alloc (C11 aligned_alloc is
-// unimplemented there), so fall back to _aligned_malloc/_aligned_free. Note the
-// argument order differs: _aligned_malloc(size, alignment).
+// MSVC has no C11 aligned_alloc, so use _aligned_malloc/_aligned_free there
+// (note the argument order: _aligned_malloc(size, alignment)). Elsewhere use
+// POSIX posix_memalign rather than std::aligned_alloc: the latter needs C11
+// aligned_alloc in the C library, which e.g. macOS only gained in 10.15.
 void* raw_aligned_alloc(size_t alignment, size_t size) {
 #if defined(_MSC_VER)
     return _aligned_malloc(size, alignment);
 #else
-    return std::aligned_alloc(alignment, size);
+    void* ptr = nullptr;
+    return posix_memalign(&ptr, alignment, size) == 0 ? ptr : nullptr;
 #endif
 }
 
