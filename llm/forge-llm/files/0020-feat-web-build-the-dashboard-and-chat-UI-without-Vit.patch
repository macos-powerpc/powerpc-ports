diff --git a/tools/web-build/build.mjs b/tools/web-build/build.mjs
new file mode 100644
index 0000000..6cd6c48
--- /dev/null
+++ b/tools/web-build/build.mjs
@@ -0,0 +1,296 @@
+#!/usr/bin/env node
+// Vite-free production build of a Forge web frontend (web/ or web-chat/).
+//
+//   node build.mjs <app dir> <output dir>
+//
+// Vite 7 needs esbuild (Go) and Rollup 4 (a Rust parser), both shipped as
+// per-platform native binaries, so it cannot run where neither exists (e.g.
+// PowerPC Macs). This script does the same job for these two frontends with
+// pure JavaScript only: Rollup 3 (+ node-resolve, commonjs), @vue/compiler-sfc, TypeScript's
+// transpileModule (type stripping only, no type checking) and terser. It
+// writes the layout Vite does -- index.html plus assets/index-<hash>.{js,css}
+// and the files the CSS references, all referenced relatively (base './') --
+// which is what cmake/EmbedDashboardAssets.cmake embeds.
+//
+// TypeScript is an optional dependency: it is taken from node_modules, or from
+// NODE_PATH (e.g. a system-wide install), so packagers can supply their own.
+//
+// Supported, and all the frontends use: <script setup lang="ts">,
+// <style scoped>, .ts modules, CSS imports (url() assets are copied).
+
+import { createHash } from 'node:crypto';
+import fs from 'node:fs';
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import commonjs from '@rollup/plugin-commonjs';
+import nodeResolve from '@rollup/plugin-node-resolve';
+import { rollup } from 'rollup';
+import { minify } from 'terser';
+import { compileScript, compileStyle, parse, registerTS } from 'vue/compiler-sfc';
+
+const require = createRequire(import.meta.url);
+const ts = require('typescript');
+registerTS(() => ts);
+
+const [appArg, outArg] = process.argv.slice(2);
+if (!appArg || !outArg) {
+    console.error('usage: node build.mjs <app dir> <output dir>');
+    process.exit(2);
+}
+const appDir = path.resolve(appArg);
+// The frontends' imports resolve against this tool's own node_modules.
+const toolModules = path.join(path.dirname(fileURLToPath(import.meta.url)), 'node_modules');
+const outDir = path.resolve(outArg);
+
+const hash8 = (data) => createHash('sha256').update(data).digest('hex').slice(0, 8);
+
+// Values Vite substitutes for a production build of a Vue app.
+const DEFINES = {
+    'process.env.NODE_ENV': '"production"',
+    __VUE_OPTIONS_API__: 'true',
+    __VUE_PROD_DEVTOOLS__: 'false',
+    __VUE_PROD_HYDRATION_MISMATCH_DETAILS__: 'false',
+};
+const defineRe = new RegExp(
+    '(?<![\\w$.])(' + Object.keys(DEFINES).map((k) => k.replace(/[.$]/g, '\\$&')).join('|') +
+        ')(?![\\w$])',
+    'g',
+);
+
+function define() {
+    return {
+        name: 'forge-define',
+        transform(code, id) {
+            if (!/\.(m?js|ts|vue)$/.test(id) || !defineRe.test(code))
+                return null;
+            defineRe.lastIndex = 0;
+            return { code: code.replace(defineRe, (m) => DEFINES[m]), map: null };
+        },
+    };
+}
+
+function stripTypes(code, fileName) {
+    return ts.transpileModule(code, {
+        fileName,
+        compilerOptions: {
+            target: ts.ScriptTarget.ES2020,
+            module: ts.ModuleKind.ESNext,
+            isolatedModules: true,
+            useDefineForClassFields: true,
+            sourceMap: false,
+        },
+    }).outputText;
+}
+
+function typescript() {
+    return {
+        name: 'forge-typescript',
+        transform(code, id) {
+            if (!id.endsWith('.ts') || id.endsWith('.d.ts'))
+                return null;
+            return { code: stripTypes(code, id), map: null };
+        },
+    };
+}
+
+// CSS from `import './x.css'` and from SFC <style> blocks, collected per module
+// and concatenated in chunk (execution) order; url() references are emitted
+// as assets.
+function css(cssByModule) {
+    const urlRe = /url\(\s*(['"]?)([^'")]+)\1\s*\)/g;
+    return {
+        name: 'forge-css',
+        transform(code, id) {
+            if (!id.endsWith('.css'))
+                return null;
+            cssByModule.set(id, rewriteUrls.call(this, code, id));
+            return { code: 'export default ""', map: null, moduleSideEffects: true };
+        },
+        // Exposed for the SFC plugin.
+        api: { rewriteUrls },
+    };
+
+    function rewriteUrls(code, id) {
+        return code.replace(urlRe, (whole, quote, ref) => {
+            if (/^(data:|https?:|#|\/)/.test(ref))
+                return whole;
+            const clean = ref.split(/[?#]/)[0];
+            const file = path.resolve(path.dirname(id), clean);
+            const source = fs.readFileSync(file);
+            const handle = this.emitFile({ type: 'asset', name: path.basename(file), source });
+            return `url(__FORGE_ASSET_${handle}__)`;
+        });
+    }
+}
+
+function vueSfc(cssByModule, cssApi) {
+    return {
+        name: 'forge-vue-sfc',
+        transform(source, id) {
+            if (!id.endsWith('.vue'))
+                return null;
+            const { descriptor, errors } = parse(source, { filename: id });
+            if (errors.length)
+                this.error(errors[0]);
+            if (!descriptor.scriptSetup)
+                this.error(`${id}: only <script setup> components are supported`);
+            const scopeId = hash8(path.relative(appDir, id).split(path.sep).join('/'));
+            const scoped = descriptor.styles.some((s) => s.scoped);
+
+            const script = compileScript(descriptor, {
+                id: scopeId,
+                isProd: true,
+                inlineTemplate: true,
+                genDefaultAs: '_sfc_main',
+                templateOptions: { compilerOptions: { scopeId: scoped ? `data-v-${scopeId}` : undefined } },
+                fs: {
+                    fileExists: (f) => fs.existsSync(f),
+                    readFile: (f) => fs.readFileSync(f, 'utf-8'),
+                    realpath: (f) => fs.realpathSync(f),
+                },
+            });
+            let code = script.content;
+            if (scoped)
+                code += `\n_sfc_main.__scopeId = "data-v-${scopeId}";`;
+            code += '\nexport default _sfc_main;\n';
+            if (script.lang === 'ts')
+                code = stripTypes(code, id + '.ts');
+
+            let styles = '';
+            for (const style of descriptor.styles) {
+                if (style.lang || style.module)
+                    this.error(`${id}: <style lang>/<style module> are not supported`);
+                const out = compileStyle({
+                    source: style.content,
+                    filename: id,
+                    id: `data-v-${scopeId}`,
+                    scoped: style.scoped,
+                    isProd: true,
+                });
+                if (out.errors.length)
+                    this.error(out.errors[0]);
+                styles += out.code + '\n';
+            }
+            if (styles)
+                cssByModule.set(id, cssApi.rewriteUrls.call(this, styles, id));
+            return { code, map: null };
+        },
+    };
+}
+
+function minifyCss(code) {
+    return code
+        .replace(/\/\*[\s\S]*?\*\//g, '')
+        .replace(/\s+/g, ' ')
+        .replace(/\s*([{}:;,>])\s*/g, '$1')
+        .replace(/;}/g, '}')
+        // [attr='ident'] -> [attr=ident], as esbuild's minifier (Vite) writes it
+        .replace(/\[([\w-]+)([~|^$*]?=)(['"])(-?[A-Za-z_][\w-]*)\3\]/g, '[$1$2$4]')
+        .trim();
+}
+
+async function build() {
+    const cssByModule = new Map();
+    const cssPlugin = css(cssByModule);
+    let cssFileName = null;
+
+    const bundle = await rollup({
+        input: path.join(appDir, 'src/main.ts'),
+        plugins: [
+            define(),
+            nodeResolve({
+                browser: true,
+                exportConditions: ['browser', 'import', 'module', 'default', 'production'],
+                extensions: ['.mjs', '.js', '.ts', '.json'],
+                modulePaths: [toolModules],
+            }),
+            commonjs(),  // highlight.js's ESM entry wraps its CommonJS core
+            cssPlugin,
+            vueSfc(cssByModule, cssPlugin.api),
+            typescript(),
+            {
+                name: 'forge-emit',
+                async renderChunk(code) {
+                    const out = await minify(code, {
+                        module: true,
+                        ecma: 2020,
+                        compress: { passes: 2 },
+                        format: { comments: false },
+                    });
+                    return { code: out.code, map: null };
+                },
+                generateBundle(_options, output) {
+                    // CSS of every module in execution order: a post-order walk
+                    // of the import graph. (CSS-only modules render no code, so
+                    // they are not in the chunks' module lists.)
+                    const parts = [];
+                    const seen = new Set();
+                    const visit = (id) => {
+                        if (seen.has(id))
+                            return;
+                        seen.add(id);
+                        for (const dep of this.getModuleInfo(id)?.importedIds ?? [])
+                            visit(dep);
+                        if (cssByModule.has(id))
+                            parts.push(cssByModule.get(id));
+                    };
+                    for (const file of Object.values(output))
+                        if (file.type === 'chunk' && file.isEntry)
+                            visit(file.facadeModuleId);
+                    if (!parts.length)
+                        return;
+                    // Assets and the stylesheet both live in assets/, so the
+                    // url()s become plain file names.
+                    const text = minifyCss(parts.join('\n')).replace(
+                        /__FORGE_ASSET_([\w$]+)__/g,
+                        (_, handle) => path.basename(this.getFileName(handle)),
+                    );
+                    cssFileName = `assets/index-${hash8(text)}.css`;
+                    this.emitFile({ type: 'asset', fileName: cssFileName, source: text });
+                },
+            },
+        ],
+        onwarn(warning, warn) {
+            if (warning.code === 'CIRCULAR_DEPENDENCY')
+                return;  // echarts/zrender have harmless cycles
+            if (warning.code === 'UNRESOLVED_IMPORT')
+                throw new Error(warning.message);
+            warn(warning);
+        },
+    });
+
+    fs.rmSync(outDir, { recursive: true, force: true });
+    const { output } = await bundle.write({
+        dir: outDir,
+        format: 'es',
+        entryFileNames: 'assets/index-[hash].js',
+        chunkFileNames: 'assets/[name]-[hash].js',
+        assetFileNames: 'assets/[name]-[hash][extname]',
+    });
+    await bundle.close();
+
+    const entry = output.find((f) => f.type === 'chunk' && f.isEntry);
+    let html = fs.readFileSync(path.join(appDir, 'index.html'), 'utf-8');
+    const scriptRe = /\s*<script type="module" src="\/src\/main\.ts"><\/script>/;
+    if (!scriptRe.test(html))
+        throw new Error('index.html: entry <script> not found');
+    html = html.replace(scriptRe, '');
+    html = html.replace(/\n([ \t]*)<\/head>/, (_, indent) => {
+        let tags = `\n${indent}  <script type="module" crossorigin src="./${entry.fileName}"></script>`;
+        if (cssFileName)
+            tags += `\n${indent}  <link rel="stylesheet" crossorigin href="./${cssFileName}">`;
+        return `${tags}\n${indent}</head>`;
+    });
+    fs.writeFileSync(path.join(outDir, 'index.html'), html);
+
+    for (const f of fs.readdirSync(path.join(outDir, 'assets')).sort())
+        console.log(`${path.relative(process.cwd(), path.join(outDir, 'assets', f))}  ` +
+                    `${fs.statSync(path.join(outDir, 'assets', f)).size} bytes`);
+}
+
+build().catch((err) => {
+    console.error(err.stack || String(err));
+    process.exit(1);
+});
