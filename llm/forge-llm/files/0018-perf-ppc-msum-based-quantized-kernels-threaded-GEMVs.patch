+// 16-byte load from a pointer known to be 16-byte aligned.
+template <typename T>
+static inline typename ppc_detail::vec_of<T>::type ppc_load_aligned(const T* p) {
+#    ifdef USE_VSX
+    return vec_xl(0, p);  // lvx's element order differs on little-endian
+#    else
+    return vec_ld(0, p);
+#    endif
+}
+
+// acc + 16 products u[i] * s[i] (unsigned x signed bytes), as 4 int32 partial
+// sums (vmsummbm: one instruction on every AltiVec/VSX CPU).
+static inline __vector signed int ppc_msum_u8s8(__vector unsigned char u, __vector signed char s,
+                                                __vector signed int acc) {
+    return vec_msum(s, u, acc);
+}
+
+// Sum of the four int32 lanes.
+static inline int ppc_hsum_i32(__vector signed int v) {
+    return vec_extract(vec_sums(v, vec_splats(0)), 3);
+}
+
+// IEEE binary16 -> binary32, exact for every input (including subnormals,
+// infinities and NaNs) and branch-free; replaces ldexp() in the per-block
+// scale decode of the quantized kernels. From Maratyszcza/FP16 (MIT).
+static inline float ppc_half_to_float(uint16_t h) {
+    const uint32_t w = static_cast<uint32_t>(h) << 16;
+    const uint32_t sign = w & 0x80000000u;
+    const uint32_t two_w = w + w;
+    uint32_t bits = (two_w >> 4) + (0xE0u << 23);
+    float normalized;
+    std::memcpy(&normalized, &bits, 4);
+    normalized *= 0x1.0p-112f;
+    bits = (two_w >> 17) | (126u << 23);
+    float denormalized;
+    std::memcpy(&denormalized, &bits, 4);
+    denormalized -= 0.5f;
+    const float magnitude = two_w < (1u << 27) ? denormalized : normalized;
+    std::memcpy(&bits, &magnitude, 4);
+    bits |= sign;
+    float out;
+    std::memcpy(&out, &bits, 4);
+    return out;
+}
+
+// fp16 field stored in host order (tensors are converted at load time).
+static inline float ppc_half_at(const uint8_t* p) {
+    uint16_t h;
+    std::memcpy(&h, p, 2);
+    return ppc_half_to_float(h);
+}
