From a4e2b606dc39eca222596ddfe3b5e4dee41646d5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 03:48:29 +0000
Subject: [PATCH 05/20] fix(cmake): use -mcpu=native instead of -march=native
 on PowerPC

FORGE_NATIVE_BUILD (on by default) added -march=native, which GCC for
PowerPC does not accept, so native ppc64/ppc64le builds failed in the
first compile. PowerPC selects the CPU with -mcpu; -mcpu=native resolves
the host CPU on Linux (AT_PLATFORM) and on Darwin (sysctl). Match the
processor names CMake reports there, including Darwin's
"Power Macintosh".

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 CMakeLists.txt | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b190aec..332532b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -25,6 +25,12 @@ else()
       set(CMAKE_CXX_FLAGS_RELEASE "-O3 -mcpu=apple-m1")
       set(CMAKE_CUDA_FLAGS_RELEASE "-O3 -Wno-deprecated-gpu-targets")
       message(STATUS "Native build: -mcpu=apple-m1 (macOS arm64)")
+    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(ppc|powerpc|Power Macintosh)")
+      # GCC for PowerPC has no -march; -mcpu=native picks the host CPU
+      # (POWERn on Linux, G4/G5 via sysctl on Darwin).
+      set(CMAKE_CXX_FLAGS_RELEASE "-O3 -mcpu=native")
+      set(CMAKE_CUDA_FLAGS_RELEASE "-O3 -Wno-deprecated-gpu-targets")
+      message(STATUS "Native build: -mcpu=native (PowerPC)")
     else()
       set(CMAKE_CXX_FLAGS_RELEASE "-O3 -march=native")
       set(CMAKE_CUDA_FLAGS_RELEASE "-O3 -Wno-deprecated-gpu-targets")
