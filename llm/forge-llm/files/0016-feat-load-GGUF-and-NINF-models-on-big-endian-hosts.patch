new file mode 100644
index 0000000..ad2f6d5
--- /dev/null
+++ b/src/model/tensor_byteswap.cpp
@@ -0,0 +1,94 @@
+#include "forge/tensor_byteswap.h"
+
+#include <cstdint>
+#include <cstring>
+
+#include "forge/byteorder.h"
+
+namespace forge {
+
+namespace {
+
+template <typename T, T (*Swap)(T)>
+void swap_fields(uint8_t* f, int count) {
+    for (int i = 0; i < count; ++i, f += sizeof(T)) {
+        T v;
+        std::memcpy(&v, f, sizeof(T));
+        v = Swap(v);
+        std::memcpy(f, &v, sizeof(T));
+    }
+}
+
+// A run of `count` consecutive `width`-byte fields at byte `offset` of a block.
+struct FieldRun {
+    uint16_t offset;
+    uint8_t width;
+    uint8_t count;
+};
+
+struct SwapLayout {
+    size_t block_bytes;  // element size for plain types, block size for quants
+    FieldRun runs[2];
+    int nruns;
+};
+
+// Multi-byte fields of each block type, following the ggml block structs.
+// Everything not listed is a byte array (or int8) and keeps its order.
+bool swap_layout(DataType dtype, SwapLayout& l) {
+    switch (dtype) {
+    // Plain arrays: one field per element.
+    case DataType::FP32:
+    case DataType::INT32:   l = {4, {{0, 4, 1}}, 1}; return true;
+    case DataType::FP16:
+    case DataType::BF16:    l = {2, {{0, 2, 1}}, 1}; return true;
+    case DataType::INT8:
+    case DataType::FP8_E4M3: l = {1, {}, 0}; return true;
+    // 32-element blocks: fp16 d (and m)
+    case DataType::Q4_0:    l = {18, {{0, 2, 1}}, 1}; return true;
+    case DataType::Q4_1:    l = {20, {{0, 2, 2}}, 1}; return true;
+    case DataType::Q5_0:    l = {22, {{0, 2, 1}}, 1}; return true;  // qh is uint8_t[4]
+    case DataType::Q5_1:    l = {24, {{0, 2, 2}}, 1}; return true;
+    case DataType::Q8_0:    l = {34, {{0, 2, 1}}, 1}; return true;
+    case DataType::IQ4_NL:  l = {18, {{0, 2, 1}}, 1}; return true;
+    // K-quants: fp16 d (and dmin)
+    case DataType::Q2_K:    l = {84, {{80, 2, 2}}, 1}; return true;
+    case DataType::Q3_K:    l = {110, {{108, 2, 1}}, 1}; return true;
+    case DataType::Q4_K:    l = {144, {{0, 2, 2}}, 1}; return true;
+    case DataType::Q5_K:    l = {176, {{0, 2, 2}}, 1}; return true;
+    case DataType::Q6_K:    l = {210, {{208, 2, 1}}, 1}; return true;
+    // I-quants
+    case DataType::IQ2_XXS: l = {66, {{0, 2, 33}}, 1}; return true;   // d + uint16_t qs[32]
+    case DataType::IQ2_XS:  l = {74, {{0, 2, 33}}, 1}; return true;   // d + uint16_t qs[32]
+    case DataType::IQ2_S:   l = {82, {{0, 2, 1}}, 1}; return true;
+    case DataType::IQ3_XXS: l = {98, {{0, 2, 1}}, 1}; return true;
+    case DataType::IQ3_S:   l = {110, {{0, 2, 1}}, 1}; return true;
+    case DataType::IQ4_XS:  l = {136, {{0, 2, 2}}, 1}; return true;   // d + scales_h
+    case DataType::IQ1_S:   l = {50, {{0, 2, 1}, {34, 2, 8}}, 2}; return true;  // d, qh[8]
+    case DataType::IQ1_M:   l = {56, {}, 0}; return true;  // bytes only
+    default:
+        return false;
+    }
+}
+
+}  // namespace
+
+bool byteswap_tensor_data(DataType dtype, void* data, size_t nbytes) {
+    SwapLayout l;
+    if (!swap_layout(dtype, l) || nbytes % l.block_bytes != 0)
+        return false;
+    uint8_t* p = static_cast<uint8_t*>(data);
+    const size_t nblocks = nbytes / l.block_bytes;
+    for (int r = 0; r < l.nruns; ++r) {
+        const FieldRun& run = l.runs[r];
+        for (size_t b = 0; b < nblocks; ++b) {
+            uint8_t* f = p + b * l.block_bytes + run.offset;
+            if (run.width == 2)
+                swap_fields<uint16_t, bswap16>(f, run.count);
+            else
+                swap_fields<uint32_t, bswap32>(f, run.count);
+        }
+    }
+    return true;
+}
+
+}  // namespace forge
