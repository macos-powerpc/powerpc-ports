diff --git a/tests/test_gguf_byteorder.cpp b/tests/test_gguf_byteorder.cpp
new file mode 100644
index 0000000..ca9419b
--- /dev/null
+++ b/tests/test_gguf_byteorder.cpp
@@ -0,0 +1,407 @@
+// GGUF byte-order handling.
+//
+// Writes the same synthetic model as a little-endian and as a big-endian GGUF
+// (every metadata value type; F32/F16/BF16 and every quantized type the CPU
+// path supports) and loads both with GgufModel. Metadata must read back
+// exactly, and every tensor, dequantized row by row, must hash to the values
+// recorded on a little-endian host. A big-endian host loading the
+// little-endian file therefore checks the load-time conversion against kernels
+// that never needed one.
+//
+// Set FORGE_GGUF_BYTEORDER_PRINT=1 to print the hashes instead of checking them.
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "forge/byteorder.h"
+#include "forge/fp16_compat.h"
+#include "forge/gguf_model.h"
+#include "forge/quant_traits.h"
+#include "forge/tensor.h"
+#include "forge/tensor_byteswap.h"
+#include "forge/tokenizer.h"
+
+using namespace forge;
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool ok, const std::string& what) {
+    if (!ok) {
+        std::printf("FAIL %s\n", what.c_str());
+        ++g_failures;
+    }
+}
+
+// ---- GGUF writer (explicit byte order) ----
+
+struct Writer {
+    bool big_endian;
+    std::vector<uint8_t> buf;
+
+    void bytes(const void* p, size_t n) {
+        const uint8_t* b = static_cast<const uint8_t*>(p);
+        buf.insert(buf.end(), b, b + n);
+    }
+    template <typename T>
+    void scalar(T v) {
+        uint8_t b[sizeof(T)];
+        std::memcpy(b, &v, sizeof(T));
+        if (big_endian != kHostBigEndian)
+            for (size_t i = 0; i < sizeof(T) / 2; ++i)
+                std::swap(b[i], b[sizeof(T) - 1 - i]);
+        bytes(b, sizeof(T));
+    }
+    void str(const std::string& s) {
+        scalar<uint64_t>(s.size());
+        bytes(s.data(), s.size());
+    }
+    void key(const std::string& k, uint32_t type) {
+        str(k);
+        scalar<uint32_t>(type);
+    }
+    void pad_to(size_t align) {
+        while (buf.size() % align)
+            buf.push_back(0);
+    }
+};
+
+struct TensorSpec {
+    const char* name;
+    GgmlDType ggml_type;
+    DataType dtype;
+    std::vector<uint8_t> le_data;  // canonical little-endian payload
+};
+
+constexpr int kRows = 3;
+constexpr int kCols = 512;
+
+uint64_t g_rng = 0x9E3779B97F4A7C15ull;
+uint32_t rnd() {
+    g_rng ^= g_rng << 13;
+    g_rng ^= g_rng >> 7;
+    g_rng ^= g_rng << 17;
+    return static_cast<uint32_t>(g_rng >> 11);
+}
+
+void put_le16(uint8_t* p, uint16_t v) {
+    p[0] = static_cast<uint8_t>(v);
+    p[1] = static_cast<uint8_t>(v >> 8);
+}
+
+// Positive, normal fp16 in roughly [2^-11, 1).
+uint16_t sane_half() {
+    return static_cast<uint16_t>(0x1000 + rnd() % 0x2800);
+}
+
+// Random little-endian payload for kRows x kCols elements of `dt`; fp16 scale
+// fields (listed by byte offset) get sane values so the dequantized output is
+// finite and meaningful.
+std::vector<uint8_t> make_payload(DataType dt, std::initializer_list<int> f16_fields) {
+    const size_t nbytes = compute_quantized_bytes(static_cast<int64_t>(kRows) * kCols, dt);
+    std::vector<uint8_t> d(nbytes);
+    if (dt == DataType::FP32) {
+        for (size_t i = 0; i < nbytes; i += 4) {
+            float f = static_cast<float>(static_cast<int>(rnd() % 20001) - 10000) / 1000.0f;
+            uint32_t u;
+            std::memcpy(&u, &f, 4);
+            for (int k = 0; k < 4; ++k)
+                d[i + k] = static_cast<uint8_t>(u >> (8 * k));
+        }
+        return d;
+    }
+    if (dt == DataType::FP16 || dt == DataType::BF16) {
+        for (size_t i = 0; i < nbytes; i += 2) {
+            const uint16_t sign = (rnd() & 1) ? 0x8000 : 0;
+            put_le16(&d[i], static_cast<uint16_t>(
+                                sign | (dt == DataType::FP16 ? sane_half() : 0x3C00 + rnd() % 0x0400)));
+        }
+        return d;
+    }
+    for (auto& b : d)
+        b = static_cast<uint8_t>(rnd());
+    const size_t block = dtype_block_size(dt);
+    for (size_t off = 0; off < nbytes; off += block)
+        for (int f : f16_fields)
+            put_le16(&d[off + f], sane_half());
+    return d;
+}
+
+std::vector<TensorSpec> make_tensors() {
+    std::vector<TensorSpec> t;
+    auto add = [&](const char* name, GgmlDType g, DataType dt, std::initializer_list<int> f16) {
+        t.push_back({name, g, dt, make_payload(dt, f16)});
+    };
+    add("t.f32", GgmlDType::F32, DataType::FP32, {});
+    add("t.f16", GgmlDType::F16, DataType::FP16, {});
+    add("t.bf16", GgmlDType::BF16, DataType::BF16, {});
+    add("t.q4_0", GgmlDType::Q4_0, DataType::Q4_0, {0});
+    add("t.q4_1", GgmlDType::Q4_1, DataType::Q4_1, {0, 2});
+    add("t.q5_0", GgmlDType::Q5_0, DataType::Q5_0, {0});
+    add("t.q5_1", GgmlDType::Q5_1, DataType::Q5_1, {0, 2});
+    add("t.q8_0", GgmlDType::Q8_0, DataType::Q8_0, {0});
+    add("t.q2_k", GgmlDType::Q2_K, DataType::Q2_K, {80, 82});
+    add("t.q3_k", GgmlDType::Q3_K, DataType::Q3_K, {108});
+    add("t.q4_k", GgmlDType::Q4_K, DataType::Q4_K, {0, 2});
+    add("t.q5_k", GgmlDType::Q5_K, DataType::Q5_K, {0, 2});
+    add("t.q6_k", GgmlDType::Q6_K, DataType::Q6_K, {208});
+    add("t.iq2_xxs", GgmlDType::IQ2_XXS, DataType::IQ2_XXS, {0});
+    add("t.iq2_xs", GgmlDType::IQ2_XS, DataType::IQ2_XS, {0});
+    add("t.iq2_s", GgmlDType::IQ2_S, DataType::IQ2_S, {0});
+    add("t.iq3_xxs", GgmlDType::IQ3_XXS, DataType::IQ3_XXS, {0});
+    add("t.iq3_s", GgmlDType::IQ3_S, DataType::IQ3_S, {0});
+    add("t.iq1_s", GgmlDType::IQ1_S, DataType::IQ1_S, {0});
+    add("t.iq1_m", GgmlDType::IQ1_M, DataType::IQ1_M, {});
+    add("t.iq4_nl", GgmlDType::IQ4_NL, DataType::IQ4_NL, {0});
+    add("t.iq4_xs", GgmlDType::IQ4_XS, DataType::IQ4_XS, {0});
+    return t;
+}
+
+std::vector<uint8_t> write_gguf(const std::vector<TensorSpec>& tensors, bool big_endian) {
+    Writer w{big_endian, {}};
+    w.bytes("GGUF", 4);
+    w.scalar<uint32_t>(3);
+    w.scalar<uint64_t>(tensors.size());
+    w.scalar<uint64_t>(25);  // KV count
+    w.key("general.architecture", 8);
+    w.str("llama");
+    w.key("general.alignment", 4);
+    w.scalar<uint32_t>(32);
+    w.key("t.u8", 0);
+    w.scalar<uint8_t>(200);
+    w.key("t.i8", 1);
+    w.scalar<int8_t>(-5);
+    w.key("t.u16", 2);
+    w.scalar<uint16_t>(60000);
+    w.key("t.i16", 3);
+    w.scalar<int16_t>(-30000);
+    w.key("t.u32", 4);
+    w.scalar<uint32_t>(4000000000u);
+    w.key("t.i32", 5);
+    w.scalar<int32_t>(-2000000000);
+    w.key("t.f32", 6);
+    w.scalar<float>(1.5f);
+    w.key("t.bool_true", 7);
+    w.scalar<uint8_t>(1);
+    w.key("t.bool_false", 7);
+    w.scalar<uint8_t>(0);
+    w.key("t.u64", 10);
+    w.scalar<uint64_t>(1ull << 40);
+    w.key("t.i64", 11);
+    w.scalar<int64_t>(-(1ll << 40));
+    w.key("t.f64", 12);
+    w.scalar<double>(2.25);
+    w.key("t.arr_i32", 9);
+    w.scalar<uint32_t>(5);
+    w.scalar<uint64_t>(3);
+    for (int32_t v : {1, -2, 300000})
+        w.scalar<int32_t>(v);
+    w.key("t.arr_bool", 9);
+    w.scalar<uint32_t>(7);
+    w.scalar<uint64_t>(3);
+    for (uint8_t v : {1, 0, 1})
+        w.scalar<uint8_t>(v);
+    w.key("t.arr_str", 9);
+    w.scalar<uint32_t>(8);
+    w.scalar<uint64_t>(2);
+    w.str("a");
+    w.str("bc");
+    // Minimal SentencePiece-style vocabulary for the tokenizer's own reader.
+    w.key("tokenizer.ggml.model", 8);
+    w.str("llama");
+    w.key("tokenizer.ggml.tokens", 9);
+    w.scalar<uint32_t>(8);
+    w.scalar<uint64_t>(5);
+    for (const char* tok : {"<unk>", "<s>", "</s>", "a", "b"})
+        w.str(tok);
+    w.key("tokenizer.ggml.scores", 9);
+    w.scalar<uint32_t>(6);
+    w.scalar<uint64_t>(5);
+    for (float v : {0.0f, 0.0f, 0.0f, -1.5f, -2.25f})
+        w.scalar<float>(v);
+    w.key("tokenizer.ggml.token_type", 9);
+    w.scalar<uint32_t>(5);
+    w.scalar<uint64_t>(5);
+    for (int32_t v : {2, 3, 3, 1, 1})
+        w.scalar<int32_t>(v);
+    w.key("tokenizer.ggml.bos_token_id", 4);
+    w.scalar<uint32_t>(1);
+    w.key("tokenizer.ggml.eos_token_id", 4);
+    w.scalar<uint32_t>(2);
+    w.key("tokenizer.ggml.add_bos_token", 7);
+    w.scalar<uint8_t>(1);
+    w.key("tokenizer.ggml.add_eos_token", 7);
+    w.scalar<uint8_t>(0);
+
+    uint64_t offset = 0;
+    std::vector<uint64_t> offsets;
+    for (const auto& t : tensors) {
+        w.str(t.name);
+        w.scalar<uint32_t>(2);
+        w.scalar<uint64_t>(kCols);  // ne0 (innermost)
+        w.scalar<uint64_t>(kRows);  // ne1
+        w.scalar<uint32_t>(static_cast<uint32_t>(t.ggml_type));
+        w.scalar<uint64_t>(offset);
+        offsets.push_back(offset);
+        offset += (t.le_data.size() + 31) / 32 * 32;
+    }
+    w.pad_to(32);
+    for (const auto& t : tensors) {
+        std::vector<uint8_t> payload = t.le_data;
+        if (big_endian)  // the field swap is its own inverse
+            check(byteswap_tensor_data(t.dtype, payload.data(), payload.size()),
+                  std::string("byteswap ") + t.name);
+        w.bytes(payload.data(), payload.size());
+        w.pad_to(32);
+    }
+    return w.buf;
+}
+
+uint64_t fnv1a(uint64_t h, const void* p, size_t n) {
+    const uint8_t* b = static_cast<const uint8_t*>(p);
+    for (size_t i = 0; i < n; ++i) {
+        h ^= b[i];
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+// Hash of the tensor's values as little-endian float bit patterns, row by row.
+uint64_t hash_tensor(const Tensor& t) {
+    uint64_t h = 14695981039346656037ull;
+    std::vector<float> row(kCols);
+    for (int r = 0; r < kRows; ++r) {
+        const uint8_t* base = static_cast<const uint8_t*>(t.data());
+        switch (t.dtype()) {
+        case DataType::FP32:
+            std::memcpy(row.data(), base + static_cast<size_t>(r) * kCols * 4, kCols * 4);
+            break;
+        case DataType::FP16:
+        case DataType::BF16:
+            for (int c = 0; c < kCols; ++c) {
+                uint16_t v;
+                std::memcpy(&v, base + (static_cast<size_t>(r) * kCols + c) * 2, 2);
+                uint32_t bits = t.dtype() == DataType::BF16
+                                    ? static_cast<uint32_t>(v) << 16
+                                    : fp16_detail::half_to_float_bits(v);
+                std::memcpy(&row[c], &bits, 4);
+            }
+            break;
+        default:
+            get_dequant_row_fn(t.dtype())(base, row.data(), kCols, r);
+            break;
+        }
+        for (float f : row) {
+            uint8_t le[4];
+            store_le32(le, [&] {
+                uint32_t u;
+                std::memcpy(&u, &f, 4);
+                return u;
+            }());
+            h = fnv1a(h, le, 4);
+        }
+    }
+    return h;
+}
+
+struct Expected {
+    const char* name;
+    uint64_t hash;
+};
+
+// Recorded on x86-64 (FORGE_GGUF_BYTEORDER_PRINT=1).
+const Expected kExpected[] = {
+#include "test_gguf_byteorder_expected.inc"
+};
+
+void check_model(const std::string& path, const std::vector<TensorSpec>& tensors,
+                 const char* label, bool print) {
+    GgufModel m;
+    if (!m.load(path)) {
+        check(false, std::string(label) + ": load");
+        return;
+    }
+    const std::string L = std::string(label) + ": ";
+    check(m.get_metadata_str("general.architecture") == "llama", L + "string");
+    check(m.get_metadata_int("t.u8") == 200, L + "u8");
+    check(m.get_metadata_int("t.i8") == -5, L + "i8");
+    check(m.get_metadata_int("t.u16") == 60000, L + "u16");
+    check(m.get_metadata_int("t.i16") == -30000, L + "i16");
+    check(m.get_metadata_int("t.u32") == 4000000000ll, L + "u32");
+    check(m.get_metadata_int("t.i32") == -2000000000ll, L + "i32");
+    check(m.get_metadata_float("t.f32") == 1.5, L + "f32");
+    check(m.get_metadata_int("t.bool_true") == 1, L + "bool true");
+    check(m.get_metadata_int("t.bool_false", 7) == 0, L + "bool false");
+    check(m.get_metadata_int("t.u64") == (1ll << 40), L + "u64");
+    check(m.get_metadata_int("t.i64") == -(1ll << 40), L + "i64");
+    check(m.get_metadata_float("t.f64") == 2.25, L + "f64");
+    check(m.get_metadata_int_array("t.arr_i32") == std::vector<int32_t>({1, -2, 300000}),
+          L + "int32 array");
+    check(m.get_metadata_int_array("t.arr_bool") == std::vector<int32_t>({1, 0, 1}),
+          L + "bool array");
+
+    Tokenizer tok;
+    check(tok.load_from_gguf(path), L + "tokenizer load");
+    check(tok.vocab_size() == 5, L + "tokenizer vocab size");
+    check(tok.id_to_token(3) == "a", L + "tokenizer token text");
+    check(tok.token_score(3) == -1.5f && tok.token_score(4) == -2.25f, L + "tokenizer scores");
+    check(tok.token_type(0) == 2 && tok.token_type(4) == 1, L + "tokenizer token types");
+    check(tok.bos_token_id() == 1 && tok.eos_token_id() == 2, L + "tokenizer bos/eos");
+    check(tok.add_bos_token() && !tok.add_eos_token(), L + "tokenizer add_bos/add_eos");
+
+    for (const auto& spec : tensors) {
+        TensorPtr t = m.get_tensor(spec.name, DeviceType::CPU);
+        if (!t) {
+            check(false, L + "get_tensor " + spec.name);
+            continue;
+        }
+        const uint64_t h = hash_tensor(*t);
+        if (print) {
+            std::printf("    {\"%s\", 0x%016llxull},\n", spec.name,
+                        static_cast<unsigned long long>(h));
+            continue;
+        }
+        bool found = false;
+        for (const auto& e : kExpected)
+            if (spec.name == std::string(e.name)) {
+                found = true;
+                check(h == e.hash, L + "tensor " + spec.name);
+            }
+        check(found, L + "no expected hash for " + spec.name);
+    }
+}
+
+}  // namespace
+
+int main() {
+    const char* p = std::getenv("FORGE_GGUF_BYTEORDER_PRINT");
+    const bool print = p && p[0] == '1';
+    const std::vector<TensorSpec> tensors = make_tensors();
+
+    const char* tmp = std::getenv("TMPDIR");
+    const std::string dir = tmp && *tmp ? tmp : "/tmp";
+    for (bool be : {false, true}) {
+        const std::string path =
+            dir + "/forge_gguf_byteorder_" + (be ? "be" : "le") + ".gguf";
+        const std::vector<uint8_t> file = write_gguf(tensors, be);
+        FILE* f = std::fopen(path.c_str(), "wb");
+        if (!f || std::fwrite(file.data(), 1, file.size(), f) != file.size()) {
+            std::printf("FAIL cannot write %s\n", path.c_str());
+            return 1;
+        }
+        std::fclose(f);
+        if (print && be)
+            break;  // the little-endian file's hashes are the reference
+        check_model(path, tensors, be ? "big-endian file" : "little-endian file", print);
+        std::remove(path.c_str());
+    }
+    if (print)
+        return 0;
+    std::printf(g_failures ? "FAILED (%d)\n" : "ALL PASSED\n", g_failures);
+    return g_failures ? 1 : 0;
+}
