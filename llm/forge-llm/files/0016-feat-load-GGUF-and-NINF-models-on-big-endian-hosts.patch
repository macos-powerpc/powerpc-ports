new file mode 100644
index 0000000..69de3ae
--- /dev/null
+++ b/include/forge/tensor_byteswap.h
@@ -0,0 +1,23 @@
+#pragma once
+// Byte-order conversion of tensor payloads.
+//
+// GGUF tensor data is little-endian: plain tensors are arrays of LE scalars,
+// and quantization blocks mix byte arrays with LE fp16/uint16 fields. The CPU
+// kernels read those multi-byte fields in host order, so on a host whose byte
+// order differs from the file's, the loader converts the data once at load
+// time with byteswap_tensor_data(). Byte arrays inside blocks are left as-is;
+// kernels that view them as wider words do so through forge/byteorder.h.
+
+#include <cstddef>
+
+#include "forge/types.h"
+
+namespace forge {
+
+// Reverse the byte order of every multi-byte field in `nbytes` bytes of tensor
+// data of type `dtype`, in place. The operation is its own inverse. Returns
+// false (leaving the data untouched) for a dtype without a known layout, or if
+// `nbytes` is not a whole number of elements/blocks.
+bool byteswap_tensor_data(DataType dtype, void* data, size_t nbytes);
+
+}  // namespace forge
diff --git a/src/core/platform.h b/src/core/platform.h
index ba5d419..006cfbb 100644
--- a/src/core/platform.h
+++ b/src/core/platform.h
@@ -58,6 +58,12 @@ static inline int forge_munmap(void* addr, size_t) {
     return UnmapViewOfFile(addr) ? 0 : -1;
 }
 
+// Make a read-only file mapping privately writable (copy-on-write). Not
+// supported for the read-only views created above.
+static inline int forge_mprotect_rw(void*, size_t) {
+    return -1;
+}
+
 // Eagerly pull the mapped range into memory (cold-cache readahead). No-op on
 // Windows versions without PrefetchVirtualMemory (Win8+).
 static inline void forge_prefetch(void* addr, size_t length) {
@@ -91,6 +97,11 @@ static inline void* forge_mmap(void* a, size_t l, int p, int f, int fd, off_t o)
 static inline int forge_munmap(void* a, size_t l) {
     return munmap(a, l);
 }
+// Make a MAP_PRIVATE file mapping writable; writes go to copy-on-write pages
+// and never reach the file.
+static inline int forge_mprotect_rw(void* a, size_t l) {
+    return mprotect(a, l, PROT_READ | PROT_WRITE);
+}
 static inline void forge_prefetch(void* addr, size_t length) {
     madvise(addr, length, MADV_WILLNEED);
 }
