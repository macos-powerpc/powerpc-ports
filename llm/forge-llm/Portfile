# TODO: untested, as of now, disabled by default.
variant dashboard description "Build the web dashboard and chat UI (needs Node.js)" {
    depends_build-append    path:bin/node:nodejs22 \
                            path:bin/npm:npm11 \
                            port:typescript

    foreach {pkg ver rmd160 sha256 size} ${npm_packages} {
        set tgz [lindex [split ${pkg} /] end]-${ver}.tgz
        set tag npm_[string map {@ {} / _ . _ - _} ${pkg}]
        master_sites-append https://registry.npmjs.org/${pkg}/-/:${tag}
        distfiles-append    ${tgz}:${tag}
        checksums-append    ${tgz} rmd160 ${rmd160} sha256 ${sha256} size ${size}
    }

    post-extract {
        foreach {pkg ver rmd160 sha256 size} ${npm_packages} {
            set tgz [lindex [split ${pkg} /] end]-${ver}.tgz
            system -W ${workpath} "env HOME=[shellescape ${workpath}] npm cache add \
                --cache [shellescape ${workpath}/npm-cache] [shellescape ${distpath}/${tgz}]"
        }
    }

    configure.args-append   -DFORGE_BUILD_DASHBOARD=ON \
                            -DFORGE_DASHBOARD_BUILDER=portable \
                            -DFORGE_NPM_CACHE=${workpath}/npm-cache \
                            {-DFORGE_NPM_CI_ARGS=--offline;--omit=optional}
    build.env-append        HOME=${workpath} \
                            NODE_PATH=${prefix}/lib/node_modules \
                            npm_config_update_notifier=false
}

# No install() rules upstream.
destroot {
    foreach bin {forge-cli forge-server forge-inspect} {
        xinstall -m 0755 ${build.dir}/${bin} ${destroot}${prefix}/bin/
    }
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} README.md LICENSE docs/build.md docs/cli.md \
        docs/models.md ${destroot}${prefix}/share/doc/${name}
}

notes "
Models are GGUF files (e.g. from Hugging Face). On 32-bit PowerPC the whole\
model is mapped into the process, so keep models below roughly 1.5 GB\
(0.5B-1.5B parameters at Q4_K_M/Q4_0). Try:
    forge-cli -m model.gguf -p \"Hello\" -n 64
    forge-server -m model.gguf --port 8080
"
