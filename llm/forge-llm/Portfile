compiler.blacklist-append   {clang < 1300}

# OpenBLAS disabled on purpose here.
configure.args-append \
                    -DFORGE_BUILD_DASHBOARD=OFF \
                    -DFORGE_BUILD_PYTHON=OFF \
                    -DFORGE_BUILD_TESTS=OFF \
                    -DFORGE_NATIVE_BUILD=OFF \
                    -DFORGE_USE_CUDA=OFF \
                    -DUSE_OPENBLAS=OFF

# The cmake portgroup's build type ignores the project's -O3; the matmul
# kernels want it.
configure.optflags  -O3

# PowerPC: AltiVec kernels for G4/G5. Without the variant the scalar kernels
# are built, which also run on a G3.
if {${configure.build_arch} in {ppc ppc64}} {
    variant altivec description {Use the AltiVec kernels (G4/G5)} {
        configure.args-append   -DFORGE_CPU_FEATURES=ALTIVEC
    }
    if {![catch {sysctl hw.optional.altivec} has_altivec] && ${has_altivec} == 1} {
        default_variants    +altivec
    }
    pre-configure {
        if {![variant_isset altivec]} {
            # Empty list = explicitly no SIMD (otherwise CMake probes
            # the compiler's default CPU).
            configure.args-append   -DFORGE_CPU_FEATURES=
        }
    }
}

