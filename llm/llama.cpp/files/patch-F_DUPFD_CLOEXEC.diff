From 8c824a9cace0111b9eb56e16dd2757dc44292b36 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Tue, 13 Oct 2026 06:26:47 +0800
Subject: [PATCH] server-common.cpp: add fallback for F_DUPFD_CLOEXEC when it
 is missing

Signed-off-by: Sergey Fedorov <vital.had@gmail.com>
---
 tools/server/server-common.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/tools/server/server-common.cpp b/tools/server/server-common.cpp
index 98c72dec16f..ca92bafa195 100644
--- tools/server/server-common.cpp
+++ tools/server/server-common.cpp
@@ -1932,7 +1932,17 @@ FILE * server_reserve_stdout() {
     SetStdHandle(STD_OUTPUT_HANDLE, GetStdHandle(STD_ERROR_HANDLE));
     FILE * f = _fdopen(fd, "w");
 #else
+#ifdef F_DUPFD_CLOEXEC
     int fd = fcntl(fileno(stdout), F_DUPFD_CLOEXEC, 0);
+#else
+    // fallback for systems without F_DUPFD_CLOEXEC (e.g. older macOS / POSIX.1-2001 systems)
+    // note: unlike F_DUPFD_CLOEXEC, this is not atomic, so there is a small window
+    //       in which a concurrent fork()+exec() could inherit the descriptor
+    int fd = dup(fileno(stdout));
+    if (fd >= 0) {
+        fcntl(fd, F_SETFD, fcntl(fd, F_GETFD, 0) | FD_CLOEXEC);
+    }
+#endif
     GGML_ASSERT(fd >= 0);
     dup2(fileno(stderr), fileno(stdout));
     FILE * f = fdopen(fd, "w");
