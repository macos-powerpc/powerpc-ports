PortSystem          1.0
PortGroup           github 1.0
PortGroup           makefile 1.0
PortGroup           openssl 1.0

openssl.branch      3

name                aqualink
github.setup        watermark-hd ppc-mac-modernization 0.5.22 v
revision            0
categories          aqua net
# license             unknown
maintainers         nomaintainer

description         SMB2/3 client and WebDAV NAS bridge for PowerPC Mac

long_description    AquaLink lets PowerPC Macs running Tiger or Leopard connect to \
                    modern SMB2/3 NAS shares, which the OS's built-in SMB1-only \
                    Samba stack cannot speak. It provides a Transmit/Cyberduck-style \
                    file browser for drag-and-drop transfers, and a local WebDAV \
                    bridge that lets the same share be mounted as a normal Finder \
                    volume via mount_webdav, without any kernel extension. It also \
                    includes the reverse: exposing a folder on the old Mac as a WebDAV \
                    share that a modern Mac or Windows machine can mount.

checksums           rmd160  a2ec347bbf3039ac9f0d015c7bcc04ded467ccb2 \
                    sha256  2648a6c0ac3c3d2df1758f1c23bab4598654559fb71042149a9259dc5d8690d9 \
                    size    127365
github.tarball_from archive

worksrcdir          ppc-mac-modernization-${version}/smb3/AquaLink

depends_lib-append  port:libsmb2

compiler.c_standard 1999

# The upstream Makefile resolves both libsmb2 and OpenSSL on their own from
# LIBSMB2_DIR/OPENSSL_DIR alone (checks for an installed dylib, then an
# installed static .a, then falls back to an uninstalled build-tree
# layout). libsmb2 has no PortGroup of its own, so it still needs the
# explicit build.args below. OpenSSL is handled by PortGroup openssl 1.0
# instead: its default openssl.configure (env_vars) exports OPENSSL_DIR
# (and OPENSSLDIR) pointing at [openssl::install_area] during the build
# phase, and it adds the port:openssl3 dependency itself -- no need to
# declare that dependency or the path manually here.
build.args          LIBSMB2_DIR=${prefix}

destroot {
    xinstall -d ${destroot}${applications_dir}
    copy ${worksrcpath}/AquaLink.app ${destroot}${applications_dir}
}

livecheck.type      regex
livecheck.url       https://github.com/watermark-hd/ppc-mac-modernization/tags
livecheck.regex     {v(\d+(?:\.\d+)*)}
