# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

# The last release is 0.9.9 (2025-12-21); this is main of 2026-09-06, which still reports 0.9.9.
github.setup        ismail-yilmaz Bobcat 136c75b53b51a1e5bb46b7041e39251ae7045dc7
name                [string tolower ${github.project}]
version             0.9.9-20260906
revision            0
categories          aqua shells
license             GPL-3
maintainers         {@barracuda156 macos-powerpc.org:barracuda}
description         Modern cross-platform terminal emulator built with U++
long_description    Bobcat is a modern, cross-platform terminal emulator built with \
                    Ultimate++. It provides a clean interface with support for multiple \
                    profiles, custom color schemes, split views and extensive keyboard \
                    shortcuts. Features include regex search, link detection, quick text \
                    snippets and session management.

github.tarball_from archive
github.livecheck.branch main

# Bobcat needs packages from UppHub: Terminal, AnsiParser and PtyProcess (nest
# TerminalCtrl) and MessageCtrl. With -h, umk deletes its UppHub directory on every run
# and clones the current heads of their repositories with git: the build needs the
# network, and it is not the same from one day to another. Use fixed commits as
# distfiles instead; update them together with Bobcat.
# Terminal: master of 2026-09-16, MessageCtrl: main of 2026-01-01.
set messagectrl_commit  7134df1080d92b442c2b1cf36b9a27bf2ae29f90
set terminal_commit     2680cd0dd18b2e2a256d2fa3c0c1b4a7ebb29bbc
set turtle_commit       fd413460c3d92c9a85fc620f6f3db50d96f3be2f 

master_sites        ${github.master_sites}:main \
                    https://github.com/ismail-yilmaz/MessageCtrl/archive/${messagectrl_commit}:messagectrl \
                    https://github.com/ismail-yilmaz/Terminal/archive/${terminal_commit}:terminal \
                    https://github.com/mirek-fidler/Turtle/archive/${turtle_commit}:turtle
distfiles           ${distname}${extract.suffix}:main \
                    MessageCtrl-${messagectrl_commit}${extract.suffix}:messagectrl \
                    Terminal-${terminal_commit}${extract.suffix}:terminal \
                    Turtle-${turtle_commit}${extract.suffix}:turtle

checksums           ${distname}${extract.suffix} \
                    rmd160  dae931a0c370e339dd5ee0ada39e5ad6c2230797 \
                    sha256  8f5ff120edad121c5f8b9f20723f2b17d02674035a95903fe8484d9bdd8caea7 \
                    size    8052544 \
                    MessageCtrl-${messagectrl_commit}${extract.suffix} \
                    rmd160  02a0ab26f4b14334a1f5f95dd48f1f69d32037d7 \
                    sha256  a1fff769224ddc8100396daf9442dfdfa4f3214edaea603ecadb8e188bf1b5f1 \
                    size    34467 \
                    Terminal-${terminal_commit}${extract.suffix} \
                    rmd160  55923ed63be43e3c8c5ab79d635efe4bbfec6065 \
                    sha256  5dbf126b531e7656b36ba98905f3068c182ef4a608f15f95a45018b022c0f3b2 \
                    size    435565 \
                    Turtle-${turtle_commit}${extract.suffix} \
                    rmd160  9f1445f423537c2e0172d7293a52505d7019242c \
                    sha256  f0cc4f12d1f97b13269811233e4c6fd099ee01338090d9ba086c0436f51d4a07 \
                    size    192800

depends_build-append \
                    port:makeicns
depends_lib-append  port:ultimatepp \
                    port:zlib

# Compiler requirements: C++17 support (inherited from U++)
compiler.cxx_standard   2017

# No configure phase - uses umk directly
use_configure       no

set build_type      GCC

# umk of ultimatepp patched for older systems has the GCC build method only.
if {[string match *clang* ${configure.compiler}] && ${os.major} >= 11} {
    set build_type  CLANG
}

# The first build run used to fail without a specific error, like with ultimatepp itself:
# umk could not start a compiler process after it had run some 120 of them. umk from
# ultimatepp @2026.1_2 raises its limit of open files and says why a process cannot be
# started. The same revision is needed for the application bundle to start from Finder.

# Build using umk from ultimatepp port
build.cmd           ${prefix}/bin/umk
build.args          ${worksrcpath},${workpath}/Terminal-${terminal_commit},${workpath}/MessageCtrl-${messagectrl_commit},${workpath}/Turtle-${turtle_commit},${prefix}/share/upp/uppsrc \
                    Bobcat \
                    ${build_type} \
                    -br \
                    -H${build.jobs} \
                    +GUI,SHARED \
                    Bobcat
build.env           CXX=${configure.cxx}

if {${configure.cxx_stdlib} ne "libc++"} {
    # The value is not expanded by a shell, so nothing can be appended to it here.
    build.env-append \
                    DYLD_LIBRARY_PATH=${prefix}/lib/libgcc
}

build.target

post-build {
    set icon_source ${worksrcpath}/Bobcat/data/bobcat128x128.png
    # umk builds the .app in ${worksrcpath}/Bobcat/Bobcat.app
    set app_resources ${worksrcpath}/Bobcat/Bobcat.app/Contents/Resources

    # Generate .icns file using makeicns
    system "makeicns -in ${icon_source} -out ${app_resources}/bobcat.icns"

    # Update Info.plist to reference the icon
    set plist ${worksrcpath}/Bobcat/Bobcat.app/Contents/Info.plist
    system "/usr/libexec/PlistBuddy -c 'Add :CFBundleIconFile string bobcat' ${plist}"
}

destroot {
    # Install Bobcat.app bundle to MacPorts Applications directory
    copy ${worksrcpath}/Bobcat/Bobcat.app ${destroot}${applications_dir}/Bobcat.app

    # Create symlink for command-line access
    ln -s ${applications_dir}/Bobcat.app/Contents/MacOS/Bobcat ${destroot}${prefix}/bin/bobcat

    # Install documentation
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
    xinstall -m 644 ${worksrcpath}/LICENSE ${destroot}${prefix}/share/doc/${name}/
}
