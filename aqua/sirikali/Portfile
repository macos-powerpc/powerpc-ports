PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           qt4 1.0

github.setup        mhogomchungu sirikali 1.8.6
revision            0
categories          aqua fuse sysutils
license             GPL-3
maintainers         {@barracuda156 macos-powerpc.org:barracuda}
description         GUI front-end to sshfs, ecryptfs-simple, cryfs, gocryptfs, securefs, fscrypt and encfs
long_description    Qt/C++ {*}${description}.
homepage            https://mhogomchungu.github.io/sirikali
checksums           rmd160  d4c33ff598e97f17a2855dcb0530411984bb844f \
                    sha256  84eb3c9df08e6b7ce4b7f1a3a4267d42e3a3be7104e595154860b8e83c0eceae \
                    size    1986384
github.tarball_from archive

installs_libs       no

post-extract {
    delete -f ${worksrcpath}/version
}

patch.pre_args-replace  -p0 -p1

patchfiles              0001-build-add-a-Qt4-build-path-to-the-cmake-files.patch \
                        0002-compat-add-the-Qt4-compatibility-layer.patch \
                        0003-compat-route-the-Qt5-only-includes-through-qt4compat.patch \
                        0004-compat-replace-the-Qt5-only-APIs-that-have-a-Qt4-spe.patch \
                        0005-connect-convert-to-string-based-connections.patch \
                        0006-lxqt_wallet-fix-colliding-include-guards-and-make-os.patch \
                        0007-macos-do-not-use-the-native-file-dialog-on-Qt4.patch \
                        0008-macos-apply-the-dialog-window-options-to-every-dialo.patch \
                        0009-engines-register-sshfs-on-macOS-again.patch

compiler.cxx_standard   2014

depends_build-append    path:bin/pkg-config:pkgconfig
depends_lib-append      port:libgcrypt \
                        port:libpwquality \
                        port:libsecret \
                        port:QJson4
depends_run-append      port:cryfs \
                        port:encfs \
                        port:sshfs

configure.args-append   -DINTERNAL_LXQT_WALLET=1 \
                        -DNOKDESUPPORT=1 \
                        -DNOOSXKEYCHAINSUPPORT=1 \
                        -DNOSECRETSUPPORT=1 \
                        -DBUILD_WITH_QT4=1

platform darwin {
    configure.args-append \
                        -DCMAKE_INSTALL_PREFIX=${applications_dir}
}

# lxqt_osx_keychain.cpp:158:52: error: invalid conversion from 'quint32*' {aka 'unsigned int*'} to 'UInt32*' {aka 'long unsigned int*'} [-fpermissive]
if {[string match *gcc* ${configure.compiler}]} {
    configure.cxxflags-append \
                        -fpermissive
}

variant osx_keychain conflicts secret description "Use Apple keychain" {
    configure.args-replace \
                        -DNOOSXKEYCHAINSUPPORT=1 \
                        -DNOOSXKEYCHAINSUPPORT=0
}

variant secret conflicts osx_keychain description "Use libsecret" {
    configure.args-replace \
                        -DNOSECRETSUPPORT=1 \
                        -DNOSECRETSUPPORT=0
}

if {![variant_isset osx_keychain]} {
    default_variants    +secret
}
