From 29c52b01a27fdc8f708ec23606c2bb9c2f062829 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 20:06:09 +0000
Subject: [PATCH 6/9] lxqt_wallet: fix colliding include guards and make
 osxkeychain a build option

lxqt_osx_keychain.h and lxqt_libsecret.h both used LXQT_SECRET_SERVICE_H.
lxqt_wallet.cpp includes libsecret first,so on any build that has both
backends enabled(a mac with libsecret installed,which is what
-DNOSECRETSUPPORT=0 asks for) the keychain header was skipped entirely
and the file failed with

    error: no type named 'osxKeyChain' in namespace 'LXQt::Wallet'

frontend/task.h collided with 3rdParty/tasks/task.hpp on
__TASK_H_INCLUDED__ the same way.  No translation unit includes both
today so it never fired,fixed while here.

The osxkeychain backend is now selected by -DNOOSXKEYCHAINSUPPORT like
the libsecret and kwallet ones are,instead of being wired to APPLE.  It
still defaults to enabled on macOS and disabled elsewhere,so nothing
changes unless the option is passed,and the CoreFoundation/Security
frameworks are only linked when it is on.
The keychain stub header,which is what gets compiled when the backend is
switched off,declared its own "using OSStatus = int".  On Apple that name
is already taken: MacTypes.h defines OSStatus as SInt32,which is signed
int in LP64 and signed long otherwise,and Qt4 repeats that verbatim in
QtGui/qmacdefines_mac.h,which QWidget pulls in.  On x86_64 the two
definitions agree and the redundant typedef is legal.  On 32 bit powerpc
they do not:

    error: conflicting declaration 'using OSStatus = int'
    note: previous declaration as 'typedef long int OSStatus'

so the stub uses that same LP64 conditional on Apple,and keeps the plain
int everywhere else,where nothing else declares the type.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J3PANPjHirYuwBkTemGj8R
---
 LINUX_BUILD_INSTRUCTIONS                      |  4 +++
 MACOS_BUILD_INSTRUCTIONS                      |  4 +++
 .../lxqt_wallet/frontend/CMakeLists.txt       | 32 ++++++++++++++++---
 .../lxqt_wallet/frontend/lxqt_osx_keychain.h  |  6 ++--
 .../frontend/lxqt_osx_keychain_private.h      | 15 +++++++++
 src/3rdParty/lxqt_wallet/frontend/task.h      |  6 ++--
 6 files changed, 57 insertions(+), 10 deletions(-)

diff --git a/LINUX_BUILD_INSTRUCTIONS b/LINUX_BUILD_INSTRUCTIONS
index f2c412f..9fbedf3 100644
--- a/LINUX_BUILD_INSTRUCTIONS
+++ b/LINUX_BUILD_INSTRUCTIONS
@@ -55,6 +55,10 @@ the internal copy of lxqt_wallet because a packaged one is never built against Q
 This option tells the build process to add gnome's libsecret secure storage of passwords.Set this option to "true" if
 you do not want libsecret's support.
 
+-DNOOSXKEYCHAINSUPPORT=false
+This option tells the build process to add macOS keychain secure storage of passwords.Set this option to "true" if you
+do not want osxkeychain support.It defaults to "false" on macOS and to "true" everywhere else.
+
 -DNOKDESUPPORT=false
 This option tells the build process to add KDE's secure storage of passwords.Set this option to "true" if you do not
 want KDE wallet support.
diff --git a/MACOS_BUILD_INSTRUCTIONS b/MACOS_BUILD_INSTRUCTIONS
index 6a38f66..62e110b 100644
--- a/MACOS_BUILD_INSTRUCTIONS
+++ b/MACOS_BUILD_INSTRUCTIONS
@@ -70,6 +70,10 @@ the internal copy of lxqt_wallet because a packaged one is never built against Q
 This option tells the build process to add gnome's libsecret secure storage of passwords.Set this option to "true" if
 you do not want libsecret's support.
 
+-DNOOSXKEYCHAINSUPPORT=false
+This option tells the build process to add macOS keychain secure storage of passwords.Set this option to "true" if you
+do not want osxkeychain support.It defaults to "false" on macOS and to "true" everywhere else.
+
 -DINTERNAL_LXQT_WALLET=false
 This project depends on lxqt_wallet project and it ships with an internal copy of the project. Set this option to "true"
 if you want SiriKali to unconditionally use the internal copy of the project or to "false" to make the build process
diff --git a/src/3rdParty/lxqt_wallet/frontend/CMakeLists.txt b/src/3rdParty/lxqt_wallet/frontend/CMakeLists.txt
index a85745e..27f54d6 100644
--- a/src/3rdParty/lxqt_wallet/frontend/CMakeLists.txt
+++ b/src/3rdParty/lxqt_wallet/frontend/CMakeLists.txt
@@ -12,10 +12,24 @@ include_directories(${PROJECT_BINARY_DIR})
 
 include_directories(${CMAKE_BINARY_DIR})
 
-if(APPLE)
-    file( WRITE ${PROJECT_BINARY_DIR}/osx_keychain.h "#define OSX_KEYCHAIN 1" )
-else()
+#
+# The osxkeychain backend is a build option like the libsecret and the kwallet
+# one,it just defaults to the platform it belongs to.
+#
+if(NOT DEFINED NOOSXKEYCHAINSUPPORT)
+    if(APPLE)
+        SET(NOOSXKEYCHAINSUPPORT "false")
+    else()
+        SET(NOOSXKEYCHAINSUPPORT "true")
+    endif()
+endif()
+
+if(NOOSXKEYCHAINSUPPORT)
+    SET(OSX_KEYCHAIN_SUPPORT "false")
     file( WRITE ${PROJECT_BINARY_DIR}/osx_keychain.h "#define OSX_KEYCHAIN 0" )
+else()
+    SET(OSX_KEYCHAIN_SUPPORT "true")
+    file( WRITE ${PROJECT_BINARY_DIR}/osx_keychain.h "#define OSX_KEYCHAIN 1" )
 endif()
 
 set(CMAKE_INCLUDE_CURRENT_DIR ON)
@@ -118,6 +132,16 @@ else()
     message(STATUS "-----------------------------------------------------------------------")
 endif()
 
+if(OSX_KEYCHAIN_SUPPORT)
+    message(STATUS "\n--------------------------------------------------------------------------")
+    message(STATUS "osxkeychain support enabled, will build osxkeychain functionality")
+    message(STATUS "-----------------------------------------------------------------------")
+else()
+    message(STATUS "\n--------------------------------------------------------------------------")
+    message(STATUS "osxkeychain support disabled, will not build osxkeychain functionality")
+    message(STATUS "-----------------------------------------------------------------------")
+endif()
+
 set(COMMON_UI_FILES  changepassworddialog.ui password_dialog.ui)
 set(COMMON_MOC_FILES task.h changepassworddialog.h password_dialog.h)
 set(COMMON_SRC_FILES changepassworddialog.cpp password_dialog.cpp lxqt_windows_dpapi.cpp lxqt_internal_wallet.cpp lxqt_wallet.cpp lxqt_osx_keychain.cpp)
@@ -206,7 +230,7 @@ else()
     endif()
 endif()
 
-if(APPLE)
+if(OSX_KEYCHAIN_SUPPORT)
     find_library(COREFOUNDATION_LIBRARY CoreFoundation REQUIRED)
     find_library(SECURITY_LIBRARY Security REQUIRED)
     target_link_libraries(lxqt-wallet ${COREFOUNDATION_LIBRARY} ${SECURITY_LIBRARY})
diff --git a/src/3rdParty/lxqt_wallet/frontend/lxqt_osx_keychain.h b/src/3rdParty/lxqt_wallet/frontend/lxqt_osx_keychain.h
index fa9fd6d..5f21087 100644
--- a/src/3rdParty/lxqt_wallet/frontend/lxqt_osx_keychain.h
+++ b/src/3rdParty/lxqt_wallet/frontend/lxqt_osx_keychain.h
@@ -28,8 +28,8 @@
  * SUCH DAMAGE.
  */
 
-#ifndef LXQT_SECRET_SERVICE_H
-#define LXQT_SECRET_SERVICE_H
+#ifndef LXQT_OSX_KEYCHAIN_H
+#define LXQT_OSX_KEYCHAIN_H
 
 #include "lxqt_wallet.h"
 
@@ -103,4 +103,4 @@ private:
 
 }
 
-#endif // LXQT_KWALLET_H
+#endif // LXQT_OSX_KEYCHAIN_H
diff --git a/src/3rdParty/lxqt_wallet/frontend/lxqt_osx_keychain_private.h b/src/3rdParty/lxqt_wallet/frontend/lxqt_osx_keychain_private.h
index 763ad2d..cd81301 100644
--- a/src/3rdParty/lxqt_wallet/frontend/lxqt_osx_keychain_private.h
+++ b/src/3rdParty/lxqt_wallet/frontend/lxqt_osx_keychain_private.h
@@ -32,7 +32,22 @@
 #ifndef LXQT_OSX_KEYCHAIN_PRIVATE_H
 #define LXQT_OSX_KEYCHAIN_PRIVATE_H
 
+/*
+ * OSStatus is not ours to name on Apple: MacTypes.h defines it as SInt32,
+ * which is "signed int" in LP64 and "signed long" everywhere else,and Qt4
+ * repeats that definition in QtGui/qmacdefines_mac.h,which QWidget pulls
+ * in.  A plain "int" happens to agree with it on x86_64 but not on 32 bit
+ * powerpc,where it is a conflicting declaration and a hard error.
+ */
+#ifdef __APPLE__
+#ifdef __LP64__
+typedef signed int OSStatus;
+#else
+typedef signed long OSStatus;
+#endif
+#else
 using OSStatus = int;
+#endif
 
 class foo;
 using SecKeychainItemRef = foo *;
diff --git a/src/3rdParty/lxqt_wallet/frontend/task.h b/src/3rdParty/lxqt_wallet/frontend/task.h
index d2ffe17..5bb4696 100644
--- a/src/3rdParty/lxqt_wallet/frontend/task.h
+++ b/src/3rdParty/lxqt_wallet/frontend/task.h
@@ -28,8 +28,8 @@
  * SUCH DAMAGE.
  */
 
-#ifndef __TASK_H_INCLUDED__
-#define __TASK_H_INCLUDED__
+#ifndef LXQT_WALLET_TASK_H_INCLUDED__
+#define LXQT_WALLET_TASK_H_INCLUDED__
 
 #include <utility>
 #include <future>
@@ -483,4 +483,4 @@ r = Task::await(foo_2, 6);
 
 #endif //end example block
 
-#endif //__TASK_H_INCLUDED__
+#endif //LXQT_WALLET_TASK_H_INCLUDED__
