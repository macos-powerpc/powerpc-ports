+#include <QMetaType>
 #include <QTimer>
 
+static void _registerProcessMetaTypes()
+{
+#if QT_VERSION < QT_VERSION_CHECK( 5,5,0 )
+	/*
+	 * A queued connection resolves the argument types of the signal through
+	 * QMetaType::type() and refuses to deliver anything it can not resolve.
+	 * Qt only started registering the QProcess enums with the meta type
+	 * system when Q_ENUM replaced Q_ENUMS in Qt 5.5,before that they have
+	 * to be registered by hand.
+	 */
+	static bool done = false ;
+
+	if( !done ){
+
+		done = true ;
+
+		qRegisterMetaType< QProcess::ProcessError >( "QProcess::ProcessError" ) ;
+		qRegisterMetaType< QProcess::ExitStatus >( "QProcess::ExitStatus" ) ;
+	}
+#endif
+}
+
 QObject * connectFunctor( QObject * sender,
 			  const char * signal,
 			  QObject * context,
@@ -144,6 +167,8 @@ QObject * connectFunctorProcessError( QObject * sender,
 				      std::function< void( QProcess::ProcessError ) > function,
 				      Qt::ConnectionType type )
 {
+	_registerProcessMetaTypes() ;
+
 	auto s = new functorSlot::ProcessError( context,std::move( function ) ) ;
 
 	QObject::connect( sender,signal,s,SLOT( invoke( QProcess::ProcessError ) ),type ) ;
@@ -157,6 +182,8 @@ QObject * connectFunctorProcessFinished( QObject * sender,
 					 std::function< void( int,QProcess::ExitStatus ) > function,
 					 Qt::ConnectionType type )
 {
+	_registerProcessMetaTypes() ;
+
 	auto s = new functorSlot::ProcessFinished( context,std::move( function ) ) ;
 
