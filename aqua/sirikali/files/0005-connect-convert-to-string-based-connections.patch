diff --git a/src/3rdParty/tasks/task.hpp b/src/3rdParty/tasks/task.hpp
index 184ac34..e8e096f 100644
--- a/src/3rdParty/tasks/task.hpp
+++ b/src/3rdParty/tasks/task.hpp
@@ -885,7 +885,7 @@ namespace Task
 					  [ this ](){ this->deleteLater() ; },
 					  [ this ](){ this->deleteLater() ; return m_function() ; } )
 			{
-				connect( this,&QThread::finished,this,&QThread::deleteLater ) ;
+				connect( this,SIGNAL( finished() ),this,SLOT( deleteLater() ) ) ;
 			}
 			future<Type>& Future()
 			{
@@ -916,7 +916,7 @@ namespace Task
 					  [ this ](){ this->deleteLater() ; },
 					  [ this ](){ m_function() ; this->deleteLater() ; } )
 			{
-				connect( this,&QThread::finished,this,&QThread::deleteLater ) ;
+				connect( this,SIGNAL( finished() ),this,SLOT( deleteLater() ) ) ;
 			}
 			future< void >& Future()
 			{
@@ -1087,13 +1087,40 @@ namespace Task
 		} ) ;
 	}
 #endif
+	/*
+	 * Qt4 can not connect a signal to a functor,the forwarder below is a
+	 * real slot that carries one.  It is parented to the context object so
+	 * the connection dies together with it.
+	 */
+	class progressForwarder : public QObject{
+		Q_OBJECT
+	public:
+		progressForwarder( QObject * parent,std::function< void( QVariant ) > function ) :
+			QObject( parent ),m_function( std::move( function ) )
+		{
+		}
+	public slots:
+		void invoke( QVariant x )
+		{
+			m_function( std::move( x ) ) ;
+		}
+	private:
+		std::function< void( QVariant ) > m_function ;
+	};
+
 	class progress : public QObject{
 		Q_OBJECT
 	public:
 		template< typename function >
 		progress( QObject * obj,function fn )
 		{
+		#if QT_VERSION < QT_VERSION_CHECK( 5,0,0 )
+			auto s = new Task::progressForwarder( obj,std::move( fn ) ) ;
+
+			connect( this,SIGNAL( update( QVariant ) ),s,SLOT( invoke( QVariant ) ) ) ;
+		#else
 			connect( this,&progress::update,obj,std::move( fn ) ) ;
+		#endif
 		}
 	signals:
 		void update( QVariant x ) const ;
