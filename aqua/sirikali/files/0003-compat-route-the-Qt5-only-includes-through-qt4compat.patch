--- a/src/settings.cpp
+++ b/src/settings.cpp
@@ -48,11 +48,21 @@
 #include <QTranslator>
 
 #include <QCoreApplication>
-#include <QStandardPaths>
+#include "qt4compat.h"
+
+/*
+ * Qt4 gets QStandardPaths from qt4compat.h and it resolves to the same paths
+ * Qt5 resolves to,hence the "or older than Qt5" part of these checks.
+ */
+#if QT_VERSION >= QT_VERSION_CHECK( 5,6,0 ) || QT_VERSION < QT_VERSION_CHECK( 5,0,0 )
+	#define SIRIKALI_USE_QSTANDARDPATHS 1
+#else
+	#define SIRIKALI_USE_QSTANDARDPATHS 0
+#endif
 
 static QString _configPath()
 {
-#if QT_VERSION >= QT_VERSION_CHECK( 5,6,0 )
+#if SIRIKALI_USE_QSTANDARDPATHS
 
 	auto s = QStandardPaths::standardLocations( QStandardPaths::ConfigLocation ) ;
 
@@ -69,7 +79,7 @@ static QString _configPath()
 
 static QString _documentsPath()
 {
-#if QT_VERSION >= QT_VERSION_CHECK( 5,6,0 )
+#if SIRIKALI_USE_QSTANDARDPATHS
 
 	auto s = QStandardPaths::standardLocations( QStandardPaths::DocumentsLocation ) ;
 
@@ -754,7 +764,7 @@ QString settings::ConfigLocation()
 
 	if( !m_settings.contains( "AppDataLocation" ) ){
 
-		#if QT_VERSION > QT_VERSION_CHECK( 5,4,0 )
+		#if QT_VERSION > QT_VERSION_CHECK( 5,4,0 ) || QT_VERSION < QT_VERSION_CHECK( 5,0,0 )
 			auto New = QStandardPaths::standardLocations( QStandardPaths::AppDataLocation ) ;
 		#else
 			QStringList New ;
