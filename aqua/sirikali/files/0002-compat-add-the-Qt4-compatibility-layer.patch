+#if defined( Q_OS_MAC ) || defined( Q_OS_FREEBSD ) || defined( Q_OS_OPENBSD ) || defined( Q_OS_NETBSD )
+
+#include <sys/param.h>
+#include <sys/ucred.h>
+#include <sys/mount.h>
+
+QList< QStorageInfo > QStorageInfo::mountedVolumes()
+{
+	QList< QStorageInfo > s ;
+
+	struct statfs * mounts = nullptr ;
+
+	const int count = getmntinfo( &mounts,MNT_NOWAIT ) ;
+
+	for( int i = 0 ; i < count ; i++ ){
+
+		const auto& e = mounts[ i ] ;
+
+		s.append( QStorageInfo( QFile::decodeName( e.f_mntonname ),
+					QByteArray( e.f_mntfromname ),
+					QByteArray( e.f_fstypename ),
+					( e.f_flags & MNT_RDONLY ) != 0 ) ) ;
+	}
+
+	return s ;
+}
+
+#elif defined( Q_OS_LINUX )
+
+/*
+ * Fields in /proc/self/mounts have their spaces,tabs,newlines and backslashes
+ * octal escaped.
+ */
+static QByteArray _unescape( const QByteArray& e )
+{
+	QByteArray m ;
+
+	for( int i = 0 ; i < e.size() ; i++ ){
+
+		if( e.at( i ) == '\\' && i + 3 < e.size() ){
+
+			bool ok = false ;
+
+			const auto s = QByteArray( e.constData() + i + 1,3 ).toInt( &ok,8 ) ;
+
+			if( ok ){
+
+				m += static_cast< char >( s ) ;
+
+				i += 3 ;
+
+				continue ;
+			}
+		}
+
+		m += e.at( i ) ;
+	}
+
+	return m ;
+}
+
+QList< QStorageInfo > QStorageInfo::mountedVolumes()
+{
+	QList< QStorageInfo > s ;
+
+	QFile f( "/proc/self/mounts" ) ;
+
+	if( !f.open( QIODevice::ReadOnly ) ){
+
+		return s ;
+	}
+
+	const auto lines = f.readAll().split( '\n' ) ;
+
+	for( const auto& it : lines ){
+
+		const auto m = it.split( ' ' ) ;
+
+		if( m.size() < 4 ){
+
+			continue ;
+		}
+
+		const auto opts = m.at( 3 ).split( ',' ) ;
+
+		s.append( QStorageInfo( QFile::decodeName( _unescape( m.at( 1 ) ) ),
+					_unescape( m.at( 0 ) ),
+					_unescape( m.at( 2 ) ),
+					opts.contains( "ro" ) ) ) ;
+	}
+
+	return s ;
+}
+
+#else
+
+QList< QStorageInfo > QStorageInfo::mountedVolumes()
+{
+	return QList< QStorageInfo >() ;
+}
+
+#endif
+
+#endif // QStorageInfo
