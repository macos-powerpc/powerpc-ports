+/*
+ * SiriKali only ever uses QLockFile from the not built by default
+ * utils/single_instance.hpp,a windows implementation is not worth carrying.
+ */
+
+QLockFile::QLockFile( const QString& path ) : m_path( path ),m_handle( -1 )
+{
+}
+
