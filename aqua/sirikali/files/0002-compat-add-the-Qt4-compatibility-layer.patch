+			QObject( parent ),m_function( std::move( function ) )
+		{
+		}
+	public slots:
+		void invoke( const QString& e )
+		{
+			m_function( e ) ;
+		}
+	private:
+		std::function< void( const QString& ) > m_function ;
+	} ;
+
+	class Action : public QObject
+	{
+		Q_OBJECT
+	public:
+		Action( QObject * parent,std::function< void( QAction * ) > function ) :
+			QObject( parent ),m_function( std::move( function ) )
+		{
+		}
+	public slots:
+		void invoke( QAction * e )
+		{
+			m_function( e ) ;
+		}
+	private:
