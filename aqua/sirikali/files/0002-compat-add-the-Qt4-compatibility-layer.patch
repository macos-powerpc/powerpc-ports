+#ifndef SIRIKALI_FUNCTOR_SLOT_H
+#define SIRIKALI_FUNCTOR_SLOT_H
+
+/*
+ * Qt4 can not connect a signal to a lambda or to a pointer to member
+ * function,it only understands SIGNAL()/SLOT() string based connections
+ * between real signals and real slots.
+ *
+ * The helpers below connect a string based signal to an arbitrary callable by
+ * creating a small QObject that carries the callable and exposes it as a real
+ * slot.  The carrier is parented to "context" so the connection dies together
+ * with it,exactly like the context object overload of QObject::connect() does
+ * on Qt5 and Qt6.  Call sites that had no context object pass the sender.
+ *
+ * There is one helper per slot signature and they are deliberately not
+ * overloaded: a lambda taking an "int" is also callable with a "bool" so
+ * overloads would turn into ambiguous std::function conversions at the call
+ * site.
+ *
+ * They are used on every supported Qt version so that there is only one code
+ * path to build and to test.
+ *
+ * Adding a signature: add the carrier class and the helper below,the carrier
+ * classes are moc'ed through the MOC_FILES list in CMakeLists.txt.
+ */
+
+#include <QObject>
+#include <QPoint>
+#include <QProcess>
+#include <QString>
+
+#include <functional>
+
+class QAction ;
+class QTableWidgetItem ;
+
+namespace functorSlot
+{
+	class Void : public QObject
+	{
+		Q_OBJECT
+	public:
+		Void( QObject * parent,std::function< void() > function,bool oneShot = false ) :
+			QObject( parent ),m_function( std::move( function ) ),m_oneShot( oneShot )
+		{
+		}
+	public slots:
+		void invoke()
+		{
+			m_function() ;
+
+			if( m_oneShot ){
+
+				this->deleteLater() ;
+			}
+		}
+	private:
+		std::function< void() > m_function ;
+		bool m_oneShot ;
+	} ;
+
+	class Bool : public QObject
+	{
+		Q_OBJECT
+	public:
+		Bool( QObject * parent,std::function< void( bool ) > function ) :
+			QObject( parent ),m_function( std::move( function ) )
+		{
+		}
+	public slots:
+		void invoke( bool e )
+		{
+			m_function( e ) ;
+		}
+	private:
+		std::function< void( bool ) > m_function ;
+	} ;
+
