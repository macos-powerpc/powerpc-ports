+#include <sys/file.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+QLockFile::QLockFile( const QString& path ) : m_path( path ),m_handle( -1 )
+{
+}
+
+QLockFile::~QLockFile()
+{
+	this->unlock() ;
+}
+
+bool QLockFile::lock()
+{
+	if( m_handle != -1 ){
+
+		return true ;
+	}
+
+	m_handle = open( m_path.toUtf8().constData(),O_RDWR | O_CREAT,0600 ) ;
+
+	if( m_handle == -1 ){
+
+		return false ;
+	}
+
+	if( flock( m_handle,LOCK_EX ) == -1 ){
+
+		close( m_handle ) ;
+		m_handle = -1 ;
+
+		return false ;
+	}
+
+	return true ;
+}
+
+bool QLockFile::tryLock( int timeOutMilliSeconds )
+{
+	Q_UNUSED( timeOutMilliSeconds )
+
+	if( m_handle != -1 ){
+
+		return true ;
+	}
+
+	m_handle = open( m_path.toUtf8().constData(),O_RDWR | O_CREAT,0600 ) ;
+
+	if( m_handle == -1 ){
+
+		return false ;
+	}
+
+	if( flock( m_handle,LOCK_EX | LOCK_NB ) == -1 ){
+
+		close( m_handle ) ;
+		m_handle = -1 ;
+
+		return false ;
+	}
+
+	return true ;
+}
+
+void QLockFile::unlock()
+{
+	if( m_handle != -1 ){
+
+		flock( m_handle,LOCK_UN ) ;
+		close( m_handle ) ;
+
+		m_handle = -1 ;
+
+		QFile::remove( m_path ) ;
+	}
+}
+
+bool QLockFile::isLocked() const
+{
+	return m_handle != -1 ;
+}
+
+#endif
+
+#endif // QLockFile
