+QObject * connectFunctor( QObject * sender,
+			  const char * signal,
+			  QObject * context,
+			  std::function< void() > function,
+			  Qt::ConnectionType type )
+{
+	auto s = new functorSlot::Void( context,std::move( function ) ) ;
+
+	QObject::connect( sender,signal,s,SLOT( invoke() ),type ) ;
+
+	return s ;
+}
