+static QString _organizationAndApp()
+{
+	QString m ;
+
+	const auto org = QCoreApplication::organizationName() ;
+
+	if( !org.isEmpty() ){
+
+		m += "/" + org ;
+	}
+
+	const auto app = QCoreApplication::applicationName() ;
+
+	if( !app.isEmpty() ){
+
+		m += "/" + app ;
+	}
+
+	return m ;
+}
+
+#ifdef Q_OS_MAC
+
+static QString _macBase( QStandardPaths::StandardLocation type,const QString& prefix )
+{
+	switch( type ){
+
+	case QStandardPaths::DesktopLocation      : return prefix + "/Desktop" ;
+	case QStandardPaths::DownloadLocation     :
+	case QStandardPaths::DocumentsLocation    : return prefix + "/Documents" ;
+	case QStandardPaths::FontsLocation        : return prefix + "/Library/Fonts" ;
+	case QStandardPaths::ApplicationsLocation : return prefix + "/Applications" ;
+	case QStandardPaths::MusicLocation        : return prefix + "/Music" ;
+	case QStandardPaths::MoviesLocation       : return prefix + "/Movies" ;
+	case QStandardPaths::PicturesLocation     : return prefix + "/Pictures" ;
+
+	case QStandardPaths::ConfigLocation        :
+	case QStandardPaths::GenericConfigLocation : return prefix + "/Library/Preferences" ;
+	case QStandardPaths::AppConfigLocation     : return prefix + "/Library/Preferences" + _organizationAndApp() ;
+
+	case QStandardPaths::GenericDataLocation :
+	case QStandardPaths::RuntimeLocation     : return prefix + "/Library/Application Support" ;
+
+	case QStandardPaths::DataLocation    :
+	case QStandardPaths::AppDataLocation : return prefix + "/Library/Application Support" + _organizationAndApp() ;
+
+	case QStandardPaths::GenericCacheLocation : return prefix + "/Library/Caches" ;
+	case QStandardPaths::CacheLocation        : return prefix + "/Library/Caches" + _organizationAndApp() ;
+
+	default : return QString() ;
+	}
+}
+
+QString QStandardPaths::writableLocation( QStandardPaths::StandardLocation type )
+{
+	if( type == QStandardPaths::TempLocation ){
+
+		return QDir::tempPath() ;
+
+	}else if( type == QStandardPaths::HomeLocation ){
+
+		return QDir::homePath() ;
+	}else{
+		return _macBase( type,QDir::homePath() ) ;
+	}
+}
+
+QStringList QStandardPaths::standardLocations( QStandardPaths::StandardLocation type )
+{
+	QStringList s ;
+
+	const auto m = QStandardPaths::writableLocation( type ) ;
+
+	if( !m.isEmpty() ){
+
+		s.append( m ) ;
+	}
+
+	if( type != QStandardPaths::TempLocation && type != QStandardPaths::HomeLocation ){
+
+		const auto e = _macBase( type,QString() ) ;
+
+		if( !e.isEmpty() && !s.contains( e ) ){
+
+			s.append( e ) ;
+		}
+	}
+
+	if( type == QStandardPaths::DataLocation || type == QStandardPaths::AppDataLocation ){
+
+		s.append( QCoreApplication::applicationDirPath() + "/../Resources" ) ;
+	}
+
+	return s ;
+}
+
+#elif defined( Q_OS_WIN )
+
+static QString _env( const char * variable )
+{
+	return QFile::decodeName( qgetenv( variable ) ) ;
+}
+
+QString QStandardPaths::writableLocation( QStandardPaths::StandardLocation type )
+{
+	switch( type ){
+
+	case QStandardPaths::HomeLocation      : return QDir::homePath() ;
+	case QStandardPaths::TempLocation      : return QDir::tempPath() ;
+	case QStandardPaths::DesktopLocation   : return QDir::homePath() + "/Desktop" ;
+	case QStandardPaths::DocumentsLocation : return QDir::homePath() + "/Documents" ;
+	case QStandardPaths::DownloadLocation  : return QDir::homePath() + "/Downloads" ;
+	case QStandardPaths::MusicLocation     : return QDir::homePath() + "/Music" ;
+	case QStandardPaths::MoviesLocation    : return QDir::homePath() + "/Videos" ;
+	case QStandardPaths::PicturesLocation  : return QDir::homePath() + "/Pictures" ;
+
+	case QStandardPaths::ConfigLocation        :
+	case QStandardPaths::GenericConfigLocation :
+	case QStandardPaths::GenericDataLocation   :
+	case QStandardPaths::RuntimeLocation       : return _env( "APPDATA" ) ;
+
+	case QStandardPaths::AppConfigLocation :
+	case QStandardPaths::DataLocation      :
+	case QStandardPaths::AppDataLocation   : return _env( "APPDATA" ) + _organizationAndApp() ;
+
+	case QStandardPaths::GenericCacheLocation : return _env( "LOCALAPPDATA" ) ;
+	case QStandardPaths::CacheLocation        : return _env( "LOCALAPPDATA" ) + _organizationAndApp() + "/cache" ;
+
+	default : return QString() ;
+	}
+}
+
+QStringList QStandardPaths::standardLocations( QStandardPaths::StandardLocation type )
+{
+	QStringList s ;
+
+	const auto m = QStandardPaths::writableLocation( type ) ;
+
+	if( !m.isEmpty() ){
+
+		s.append( m ) ;
+	}
+
+	return s ;
+}
+
+#else
+
+static QString _env( const char * variable )
+{
+	return QFile::decodeName( qgetenv( variable ) ) ;
+}
+
+static QString _xdg( const char * variable,const QString& fallBack )
+{
+	const auto m = _env( variable ) ;
+
+	if( m.startsWith( "/" ) ){
+
+		return m ;
+	}else{
+		return fallBack ;
+	}
+}
+
+static QString _xdgConfigHome()
+{
+	return _xdg( "XDG_CONFIG_HOME",QDir::homePath() + "/.config" ) ;
+}
+
+static QString _xdgDataHome()
+{
+	return _xdg( "XDG_DATA_HOME",QDir::homePath() + "/.local/share" ) ;
+}
+
+static QString _xdgCacheHome()
+{
+	return _xdg( "XDG_CACHE_HOME",QDir::homePath() + "/.cache" ) ;
+}
+
+QString QStandardPaths::writableLocation( QStandardPaths::StandardLocation type )
+{
+	switch( type ){
+
+	case QStandardPaths::HomeLocation      : return QDir::homePath() ;
+	case QStandardPaths::TempLocation      : return QDir::tempPath() ;
+	case QStandardPaths::DesktopLocation   : return QDir::homePath() + "/Desktop" ;
+	case QStandardPaths::DocumentsLocation : return QDir::homePath() + "/Documents" ;
+	case QStandardPaths::DownloadLocation  : return QDir::homePath() + "/Downloads" ;
+	case QStandardPaths::MusicLocation     : return QDir::homePath() + "/Music" ;
+	case QStandardPaths::MoviesLocation    : return QDir::homePath() + "/Videos" ;
+	case QStandardPaths::PicturesLocation  : return QDir::homePath() + "/Pictures" ;
+
+	case QStandardPaths::FontsLocation        : return _xdgDataHome() + "/fonts" ;
+	case QStandardPaths::ApplicationsLocation : return _xdgDataHome() + "/applications" ;
+
+	case QStandardPaths::ConfigLocation        :
+	case QStandardPaths::GenericConfigLocation : return _xdgConfigHome() ;
+	case QStandardPaths::AppConfigLocation     : return _xdgConfigHome() + _organizationAndApp() ;
+
+	case QStandardPaths::GenericDataLocation : return _xdgDataHome() ;
+
+	case QStandardPaths::DataLocation    :
+	case QStandardPaths::AppDataLocation : return _xdgDataHome() + _organizationAndApp() ;
+
+	case QStandardPaths::GenericCacheLocation : return _xdgCacheHome() ;
+	case QStandardPaths::CacheLocation        : return _xdgCacheHome() + _organizationAndApp() ;
+
+	case QStandardPaths::RuntimeLocation :
+
+		return _xdg( "XDG_RUNTIME_DIR","/tmp/runtime-" + _env( "USER" ) ) ;
+
+	default : return QString() ;
+	}
+}
+
+QStringList QStandardPaths::standardLocations( QStandardPaths::StandardLocation type )
+{
+	QStringList s ;
+
+	const auto m = QStandardPaths::writableLocation( type ) ;
+
+	if( !m.isEmpty() ){
+
+		s.append( m ) ;
+	}
+
+	auto _append = [ & ]( const char * variable,const QString& fallBack,const QString& postFix ){
+
+		auto e = _env( variable ) ;
+
+		const auto list = e.isEmpty() ? fallBack.split( ':' ) : e.split( ':' ) ;
+
+		for( const auto& it : list ){
+
+			if( it.startsWith( "/" ) ){
+
+				const auto x = it + postFix ;
+
+				if( !s.contains( x ) ){
+
+					s.append( x ) ;
+				}
+			}
+		}
+	} ;
+
+	switch( type ){
+
+	case QStandardPaths::ConfigLocation        :
+	case QStandardPaths::GenericConfigLocation :
+
+		_append( "XDG_CONFIG_DIRS","/etc/xdg",QString() ) ;
+		break ;
+
+	case QStandardPaths::AppConfigLocation :
+
+		_append( "XDG_CONFIG_DIRS","/etc/xdg",_organizationAndApp() ) ;
+		break ;
+
+	case QStandardPaths::GenericDataLocation :
+
+		_append( "XDG_DATA_DIRS","/usr/local/share:/usr/share",QString() ) ;
+		break ;
+
+	case QStandardPaths::DataLocation    :
+	case QStandardPaths::AppDataLocation :
+
+		_append( "XDG_DATA_DIRS","/usr/local/share:/usr/share",_organizationAndApp() ) ;
+		break ;
+
+	default :
+		break ;
+	}
+
+	return s ;
+}
+
+#endif
+
+#endif // QStandardPaths
