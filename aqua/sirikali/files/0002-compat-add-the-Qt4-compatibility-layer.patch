+		CacheLocation,
+		GenericDataLocation,
+		RuntimeLocation,
+		ConfigLocation,
+		DownloadLocation,
+		GenericCacheLocation,
+		GenericConfigLocation,
+		AppDataLocation,
+		AppConfigLocation,
+		AppLocalDataLocation = DataLocation
+	} ;
