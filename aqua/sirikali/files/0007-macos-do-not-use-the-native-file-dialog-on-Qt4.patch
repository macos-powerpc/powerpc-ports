From e4fb95af742baad7b5b41d2168d44274863f2e2c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sat, 22 Aug 2026 20:06:09 +0000
Subject: [PATCH 7/9] macos: do not use the native file dialog on Qt4

Cocoa's NSOpenPanel takes the process down on 10.6 PowerPC.  Clicking an
entry in the panel's side bar has QuickLook call

    +[NSURL previewItemVirtualNodeURLWithPath:]

which that AppKit does not have,and the NSInvalidArgumentException it
raises unwinds through the modal panel and out of main() as SIGTRAP:

    -[QLPreviewView _startLoadingPreviewItem:timeoutDate:reload:]
    -[NSNavPreviewController setPreviewItem:]
    -[NSBrowser addColumn]
    -[QNSOpenSavePanelDelegate runApplicationModalPanel]
    QFileDialog::getExistingDirectory(...)
    utility::getExistingDirectory(...)
    sirikali::unlockVolume(bool)

The exception crosses the Objective-C runtime inside a modal panel we do
not own,so there is nothing to catch on our side.  Clear the exported
flag Qt4 consults in the QFileDialog static functions and every dialog
becomes Qt's own,which is fine on 10.6 and unaffected by the bug.

utility::configFilePath() drives a QFileDialog instance instead of the
static functions,and QFileDialogPrivate::canBeNativeDialog() does not
look at that flag,so it asks for DontUseNativeDialog itself.

Limited to Qt4 on macOS: this is a bug in that platform's AppKit,not in
Qt,and the native dialog is worth keeping everywhere else.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CHd6nUCuxo4ac7p7eGehu2
---
 src/main.cpp    | 23 +++++++++++++++++++++++
 src/utility.cpp |  8 ++++++++
 2 files changed, 31 insertions(+)

diff --git a/src/main.cpp b/src/main.cpp
index 2a05479..661ae15 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -19,8 +19,31 @@
 
 #include "sirikali.h"
 
+#if QT_VERSION < QT_VERSION_CHECK( 5,0,0 ) && defined( Q_OS_MAC )
+
+/*
+ * Cocoa's file dialog takes the whole process down on 10.6 PowerPC. Selecting
+ * an entry in the side bar makes QuickLook call
+ * +[NSURL previewItemVirtualNodeURLWithPath:], which does not exist there, and
+ * the NSInvalidArgumentException that follows unwinds out through the modal
+ * panel as SIGTRAP. Nothing on our side of the dialog can catch it, so use
+ * Qt's own file dialog instead.
+ *
+ * Qt4 consults this exported flag in every QFileDialog static function. The
+ * QFileDialog instance in utility::configFilePath() does not go through those
+ * and asks for the option itself.
+ */
+extern Q_GUI_EXPORT bool qt_use_native_dialogs ;
+
+#endif
+
 int main( int argc,char * argv[] )
 {
+#if QT_VERSION < QT_VERSION_CHECK( 5,0,0 ) && defined( Q_OS_MAC )
+
+	qt_use_native_dialogs = false ;
+
+#endif
 	QStringList args ;
 
 	for( int i = 0 ; i < argc ; i++ ){
diff --git a/src/utility.cpp b/src/utility.cpp
index f33c10e..0dd0eb3 100644
--- a/src/utility.cpp
+++ b/src/utility.cpp
@@ -1183,6 +1183,14 @@ QString utility::configFilePath( QWidget * s,const QString& e )
 {
 	QFileDialog dialog( s ) ;
 
+#if QT_VERSION < QT_VERSION_CHECK( 5,0,0 ) && defined( Q_OS_MAC )
+	/*
+	 * QFileDialogPrivate::canBeNativeDialog() does not look at the flag
+	 * main() clears, so this one has to ask for itself.
+	 */
+	dialog.setOption( QFileDialog::DontUseNativeDialog ) ;
+#endif
+
 	dialog.setFileMode( QFileDialog::AnyFile ) ;
 
 	dialog.setDirectory( settings::instance().homePath() ) ;
