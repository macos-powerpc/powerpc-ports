+bool utility::removeFolderRecursively( const QString& path )
+{
+#if QT_VERSION >= QT_VERSION_CHECK( 5,0,0 )
+
+	return QDir( path ).removeRecursively() ;
+#else
+	/*
+	 * QDir::removeRecursively() is Qt 5.0.
+	 */
+	QDir dir( path ) ;
+
+	if( !dir.exists() ){
+
+		return true ;
+	}
+
+	auto filter = QDir::Filter::Files    |
+		      QDir::Filter::Dirs     |
+		      QDir::Filter::Hidden   |
+		      QDir::Filter::System   |
+		      QDir::Filter::NoDotAndDotDot ;
+
+	bool s = true ;
+
+	const auto entries = dir.entryInfoList( filter ) ;
+
+	for( const auto& it : entries ){
+
+		const auto m = it.absoluteFilePath() ;
+
+		if( it.isDir() && !it.isSymLink() ){
+
+			s = utility::removeFolderRecursively( m ) && s ;
+		}else{
+			s = QFile::remove( m ) && s ;
+		}
+	}
+
+	return QDir().rmdir( dir.absolutePath() ) && s ;
+#endif
+}
