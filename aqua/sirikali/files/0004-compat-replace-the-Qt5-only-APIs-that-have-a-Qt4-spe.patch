diff --git a/src/crypto.cpp b/src/crypto.cpp
index 8eb424a..6173772 100644
--- a/src/crypto.cpp
+++ b/src/crypto.cpp
@@ -21,10 +21,162 @@
 #include "task.hpp"
 
 #include <QFile>
-#include <QMessageAuthenticationCode>
 
 #include <random>
 
+/*
+ * QCryptographicHash learnt about SHA-256 in Qt 5.0 and
+ * QMessageAuthenticationCode showed up in Qt 5.1.  Older versions get the
+ * same two primitives from libgcrypt,which SiriKali already depends on
+ * through the internal lxqt_wallet backend.
+ */
+#if QT_VERSION < QT_VERSION_CHECK( 5,1,0 )
+
+#include <gcrypt.h>
+
+namespace
+{
+
+void _init_gcrypt()
+{
+	if( gcry_control( GCRYCTL_INITIALIZATION_FINISHED_P ) == 0 ){
+
+		gcry_check_version( nullptr ) ;
+		gcry_control( GCRYCTL_INITIALIZATION_FINISHED,0 ) ;
+	}
+}
+
+int _sha256_length()
+{
+	return static_cast< int >( gcry_md_get_algo_dlen( GCRY_MD_SHA256 ) ) ;
+}
+
+class hmac_sha256
+{
+public:
+	hmac_sha256( const QByteArray& key ) : m_handle( nullptr )
+	{
+		_init_gcrypt() ;
+
+		if( gcry_md_open( &m_handle,GCRY_MD_SHA256,GCRY_MD_FLAG_HMAC ) == 0 ){
+
+			gcry_md_setkey( m_handle,key.constData(),static_cast< size_t >( key.size() ) ) ;
+		}
+	}
+	~hmac_sha256()
+	{
+		if( m_handle ){
+
+			gcry_md_close( m_handle ) ;
+		}
+	}
+	bool valid() const
+	{
+		return m_handle != nullptr ;
+	}
+	void addData( const QByteArray& e )
+	{
+		gcry_md_write( m_handle,e.constData(),static_cast< size_t >( e.size() ) ) ;
+	}
+	bool addData( QIODevice * device )
+	{
+		if( !device->isReadable() ){
+
+			return false ;
+		}
+
+		QByteArray buffer ;
+
+		buffer.resize( 4096 ) ;
+
+		while( true ){
+
+			auto s = device->read( buffer.data(),buffer.size() ) ;
+
+			if( s > 0 ){
+
+				gcry_md_write( m_handle,buffer.constData(),static_cast< size_t >( s ) ) ;
+
+			}else if( s == 0 ){
+
+				return true ;
+			}else{
+				return false ;
+			}
+		}
+	}
+	QByteArray result()
+	{
+		gcry_md_final( m_handle ) ;
+
+		auto m = gcry_md_read( m_handle,GCRY_MD_SHA256 ) ;
+
+		return QByteArray( reinterpret_cast< const char * >( m ),_sha256_length() ) ;
+	}
+private:
+	gcry_md_hd_t m_handle ;
+} ;
+
+QByteArray _sha256( const QByteArray& e )
+{
+	_init_gcrypt() ;
+
+	QByteArray m( _sha256_length(),'\0' ) ;
+
+	gcry_md_hash_buffer( GCRY_MD_SHA256,
+			     m.data(),
+			     e.constData(),
+			     static_cast< size_t >( e.size() ) ) ;
+
+	return m ;
+}
+
+}
+
+#else
+
+#include <QCryptographicHash>
+#include <QMessageAuthenticationCode>
+
+namespace
+{
+
+class hmac_sha256
+{
+public:
+	hmac_sha256( const QByteArray& key ) :
+		m_hmac( QCryptographicHash::Sha256,key )
+	{
+	}
+	bool valid() const
+	{
+		return true ;
+	}
+	void addData( const QByteArray& e )
+	{
+		m_hmac.addData( e ) ;
+	}
+	bool addData( QIODevice * device )
+	{
+		return m_hmac.addData( device ) ;
+	}
+	QByteArray result()
+	{
+		return m_hmac.result() ;
+	}
+private:
+	QMessageAuthenticationCode m_hmac ;
+} ;
+
+QByteArray _sha256( const QByteArray& e )
+{
+	return QCryptographicHash::hash( e,QCryptographicHash::Sha256 ) ;
+}
+
+}
+
+#endif
+
 class rng{
 public:
 	rng()
@@ -63,15 +215,18 @@ QByteArray crypto::hmac_key( const QString& keyFile,const QString& password )
 {
 	return Task::await( [ & ](){
 
-		QMessageAuthenticationCode hmac( QCryptographicHash::Sha256,password.toUtf8() ) ;
+		hmac_sha256 hmac( password.toUtf8() ) ;
 
-		QFile file( keyFile ) ;
+		if( hmac.valid() ){
 
-		if( file.open( QIODevice::ReadOnly ) ){
+			QFile file( keyFile ) ;
 
-			if( hmac.addData( &file ) ){
+			if( file.open( QIODevice::ReadOnly ) ){
 
-				return hmac.result().toHex() ;
+				if( hmac.addData( &file ) ){
+
+					return hmac.result().toHex() ;
+				}
 			}
 		}
 
@@ -81,16 +236,22 @@ QByteArray crypto::hmac_key( const QString& keyFile,const QString& password )
 
 QByteArray crypto::hmac_key( const QString& password )
 {
-	QMessageAuthenticationCode hmac( QCryptographicHash::Sha256,password.toUtf8() ) ;
-	return hmac.result().toHex() ;
+	hmac_sha256 hmac( password.toUtf8() ) ;
+
+	if( hmac.valid() ){
+
+		return hmac.result().toHex() ;
+	}else{
+		return QByteArray() ;
+	}
 }
 
 QByteArray crypto::sha256( const QString& e )
 {
-	return QCryptographicHash::hash( e.toUtf8(),QCryptographicHash::Sha256 ).toHex() ;
+	return _sha256( e.toUtf8() ).toHex() ;
 }
 
 QByteArray crypto::sha256( const QByteArray& e )
 {
-	return QCryptographicHash::hash( e,QCryptographicHash::Sha256 ).toHex() ;
+	return _sha256( e ).toHex() ;
 }
