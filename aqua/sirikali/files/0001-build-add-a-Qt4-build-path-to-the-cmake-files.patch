 MACOS_BUILD_INSTRUCTIONS                      |   5 +
 .../lxqt_wallet/frontend/CMakeLists.txt       |  31 ++++-
 src/3rdParty/tasks/CMakeLists.txt             |  24 ++--
 src/sirikali_cppcryptfs/CMakeLists.txt        |  21 ++--
 src/siripolkit/CMakeLists.txt                 |  18 ++-
 7 files changed, 182 insertions(+), 31 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0b3ce91..25508d1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -16,8 +16,20 @@ file(WRITE ${PROJECT_BINARY_DIR}/VERSION_INFO "${PGR_VERSION}")
 set( CMAKE_CXX_STANDARD 14 )
 
 option(BUILD_WITH_QT6 "Build with Qt 6" OFF)
+option(BUILD_WITH_QT4 "Build with Qt 4" OFF)
+
+#
+# "-DQT5=0" is the historical(and still used by downstream packagers) way of
+# asking for a Qt4 build.
+#
+if( DEFINED QT5 AND NOT QT5 )
+	set( BUILD_WITH_QT4 ON )
+endif()
 
-if(BUILD_WITH_QT6)
+if(BUILD_WITH_QT4)
+	set(BUILD_WITH_QT6 OFF)
+	find_package(Qt4 4.8.0 COMPONENTS QtCore QtGui QtNetwork REQUIRED)
+elseif(BUILD_WITH_QT6)
         find_package(Qt6 COMPONENTS Core Widgets Network REQUIRED)
 else()
 	find_package(Qt5 COMPONENTS Core QUIET)
@@ -145,7 +157,51 @@ else()
 	endif()
 endif()
 
-if(BUILD_WITH_QT6)
+if(BUILD_WITH_QT4)
+
+	#
+	# The internal lxqt_wallet library talks to kwallet over dbus on every
+	# platform that does not build against KWallet directly,so QtDBus is
+	# looked for on all unices and not on linux only.
+	#
+	if( UNIX )
+		find_package( Qt4 4.8.0 COMPONENTS QtDBus QUIET )
+
+		if( QT_QTDBUS_FOUND )
+			set( QT_USE_QTDBUS TRUE )
+			message( STATUS "Found Qt4 QtDBus" )
+		else()
+			message( STATUS "Qt4 QtDBus was NOT found" )
+		endif()
+	endif()
+
+	INCLUDE( ${QT_USE_FILE} )
+
+	SET( QTVERSION "${QT_VERSION_MAJOR}.${QT_VERSION_MINOR}.${QT_VERSION_PATCH}" )
+
+	message( STATUS "Found Qt4, version ${QTVERSION}" )
+
+	#
+	# Qt4 has no QJson* classes,they are provided by a drop in replacement
+	# library: https://github.com/eteran/qjson4
+	#
+	find_path( QJSON4_INCLUDE_DIR NAMES QJsonDocument.h PATH_SUFFIXES QJson4 )
+	find_library( QJSON4_LIBRARY NAMES QJson4 )
+
+	if( NOT QJSON4_INCLUDE_DIR )
+		message( FATAL_ERROR "could not find QJson4 header files(QJsonDocument.h)" )
+	endif()
+
+	if( NOT QJSON4_LIBRARY )
+		message( FATAL_ERROR "could not find QJson4 library" )
+	endif()
+
+	message( STATUS "found QJson4 header files at: ${QJSON4_INCLUDE_DIR}" )
+	message( STATUS "found QJson4 library at: ${QJSON4_LIBRARY}" )
+
+	include_directories( ${QJSON4_INCLUDE_DIR} )
+
+elseif(BUILD_WITH_QT6)
 
 	if( UNIX AND NOT APPLE )
 
@@ -219,6 +275,14 @@ else()
 	ADD_SUBDIRECTORY( src/3rdParty/tasks )
 endif()
 
+if( BUILD_WITH_QT4 )
+	#
+	# Every packaged lxqt_wallet is built against Qt5 or Qt6,linking one
+	# into a Qt4 binary can not work,so always use the internal copy.
+	#
+	set( INTERNAL_LXQT_WALLET "true" )
+endif()
+
 if( INTERNAL_LXQT_WALLET )
 
 	message( STATUS "---------------------------------------------------------------------------" )
@@ -383,7 +447,26 @@ set( CMAKE_INCLUDE_CURRENT_DIR ON )
 INCLUDE_DIRECTORIES( ${CMAKE_BINARY_DIR} )
 INCLUDE_DIRECTORIES( ${GCRYPT_INCLUDE_PATH} )
 
-if(BUILD_WITH_QT6)
+if(BUILD_WITH_QT4)
+	QT4_WRAP_UI( UI ${UI_FILES} )
+	QT4_WRAP_CPP( MOC ${MOC_FILES} )
+	QT4_ADD_RESOURCES( TRAY_RC_SRCS src/icon.qrc )
+
+	if( APPLE )
+		add_executable( SiriKali MACOSX_BUNDLE ${MOC} ${UI} ${SRC} ${TRAY_RC_SRCS} ${PROJECT_SOURCE_DIR}/icons/256x256/sirikali.icns )
+		set_target_properties( SiriKali PROPERTIES MACOSX_BUNDLE ON )
+		set_target_properties( SiriKali PROPERTIES COMPILE_FLAGS "-Wextra -Wall -s -fPIC -pedantic")
+	else()
+		if( WIN32 )
+			set(APP_ICON_RESOURCE_WINDOWS "${CMAKE_CURRENT_SOURCE_DIR}/src/appicon.rc" )
+			add_executable( sirikali WIN32 ${MOC} ${UI} ${SRC} ${TRAY_RC_SRCS} ${APP_ICON_RESOURCE_WINDOWS} )
+			set_target_properties( sirikali PROPERTIES COMPILE_FLAGS "-Wextra -Wall -s -pedantic")
+		else()
+			add_executable( sirikali ${MOC} ${UI} ${SRC} ${TRAY_RC_SRCS} )
+			set_target_properties( sirikali PROPERTIES COMPILE_FLAGS "-Wextra -Wall -s -fPIC -pedantic")
+		endif()
+	endif()
+elseif(BUILD_WITH_QT6)
 
 	SET( TRAY_RC_SRCS "src/icon.qrc" )
 
@@ -429,7 +512,19 @@ endif()
 
 link_directories( ${GCRYPT_LIBRARY_PATH} )
 
-if(BUILD_WITH_QT6)
+if(BUILD_WITH_QT4)
+	if( WIN32 )
+		TARGET_LINK_LIBRARIES( sirikali ${QT_LIBRARIES} ${QJSON4_LIBRARY} mhogomchungu_task lxqt-wallet )
+	endif()
+
+	if( APPLE )
+		TARGET_LINK_LIBRARIES( SiriKali ${QT_LIBRARIES} ${QJSON4_LIBRARY} ${library_pwquality} ${GCRYPT_LIBRARY} mhogomchungu_task lxqt-wallet -L${GCRYPT_LIBRARY_PATH})
+	endif()
+
+	if( UNIX AND NOT APPLE )
+		TARGET_LINK_LIBRARIES( sirikali ${QT_LIBRARIES} ${QJSON4_LIBRARY} ${library_pwquality} ${GCRYPT_LIBRARY} mhogomchungu_task lxqt-wallet -L${GCRYPT_LIBRARY_PATH} -Wl,-znow)
+	endif()
+elseif(BUILD_WITH_QT6)
 	if( WIN32 )
 		TARGET_LINK_LIBRARIES( sirikali ${Qt6Widgets_LIBRARIES} ${Qt6Core_LIBRARIES} ${Qt6Widgets_LIBRARIES} ${Qt6Network_LIBRARIES} mhogomchungu_task lxqt-wallet )
 	endif()
@@ -455,7 +550,11 @@ else()
 	endif()
 endif()
 
-if(BUILD_WITH_QT6)
+if(BUILD_WITH_QT4)
+	message( STATUS "---------------------------------------------------------------------------" )
+	message( STATUS "Building using Qt4" )
+	message( STATUS "---------------------------------------------------------------------------\n\n" )
+elseif(BUILD_WITH_QT6)
 	message( STATUS "---------------------------------------------------------------------------" )
 	message( STATUS "Building using Qt6" )
 	message( STATUS "---------------------------------------------------------------------------\n\n" )
