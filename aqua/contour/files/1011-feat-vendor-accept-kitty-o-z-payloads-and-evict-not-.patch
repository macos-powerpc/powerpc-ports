+bool Screen::evictKittyImagesToFit(size_t incomingBytes, uint32_t keepId)
+{
+    // kitty enforces its store quota by deleting the oldest images to make room, NOT by refusing the
+    // transmission -- long-running senders (gallery scrollers, file managers) keep transmitting fresh
+    // ids without housekeeping and rely on the terminal to evict. Refusing with ENOSPC is an error
+    // kitty never sends in practice, so a client that matches on reply strings goes dark on it.
+    auto const quota = _settings->kittyImageStorageQuota;
+
+    // If even an empty store cannot hold the incoming image, eviction is pointless: refuse it alone.
+    if (incomingBytes > quota)
+        return false;
+
+    // `keepId` may already occupy the store as a prior version, frames included; it is replaced, so
+    // none of that counts. The same accounting the frame path uses (storedKittyBytes), so that images
+    // and frames are billed against one quota.
+    while (storedKittyBytes() - storedKittyBytesOf(keepId) + incomingBytes > quota)
+    {
+        // Pick the eviction victim: least-recently-used, but spare images with a live on-screen
+        // placement until nothing unplaced remains. A redraw idiom that re-places an evicted image
+        // re-transmits it, so evicting an unplaced image is invisible where evicting a placed one is
+        // not. `keepId` is never a candidate.
+        auto victim = _kittyImages.end();
+        auto victimHasPlacement = true; // prefer any no-placement candidate over a placed one
+        auto victimTick = std::numeric_limits<uint64_t>::max();
+        for (auto it = _kittyImages.begin(); it != _kittyImages.end(); ++it)
+        {
+            if (it->first == keepId)
+                continue;
+            auto const tickIt = _kittyImageLastUsed.find(it->first);
+            auto const tick = tickIt != _kittyImageLastUsed.end() ? tickIt->second : uint64_t { 0 };
+            auto const placed = hasLiveKittyPlacement(it->first);
+            // Rank unplaced-before-placed first, then oldest-first within each group.
+            if (std::tuple(placed, tick) < std::tuple(victimHasPlacement, victimTick))
+            {
+                victim = it;
+                victimHasPlacement = placed;
+                victimTick = tick;
+            }
+        }
+
+        if (victim == _kittyImages.end())
+            // Defensive: the loop only runs while something other than keepId is stored, so a victim
+            // exists. Stop rather than spin if that ever breaks.
+            return true;
+
+        // The frames go with the image they were composited from, as every other way of freeing it does.
+        removeKittyPlacementsOf(victim->first);
+        _kittyImageLastUsed.erase(victim->first);
+        _kittyAnimations.erase(victim->first);
+        _kittyImages.erase(victim);
+    }
+    return true;
+}
