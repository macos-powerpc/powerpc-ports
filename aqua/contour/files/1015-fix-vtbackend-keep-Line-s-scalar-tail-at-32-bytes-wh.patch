From 4315cad88b8a42326a508bc04552a560db056a92 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 8 Nov 2026 21:51:21 +0000
Subject: [PATCH 15/15] fix(vtbackend): keep Line's scalar tail at 32 bytes
 where bool is 4 bytes

On 32-bit Darwin PowerPC, bool is int-sized: GCC's rs6000/darwin.h
defines BOOL_TYPE_SIZE as INT_TYPE_SIZE unless -mone-byte-bool, and
rs6000.cc turns that on by default only for the 64-bit ABI. The
switch is not an option here, since it changes the ABI against the
system's own C++ libraries.

Line::_dirty was a bool, so it took four bytes at +24, moved _bornAt
to +28 and _blockId to +32, and the layout assertion fired:

  Line.hpp:800: error: static assertion failed: Line's scalar tail
  grew. See the comment on Line::_contextId before changing this.
  the comparison reduces to '(204 == 200)'

Store the flag in a uint8_t. The tail is then the 32 bytes the
assertion describes on every ABI, including this one; on the others
the layout is unchanged. CellProxy's optional back-pointer to the flag
follows the type. Behaviour is the same: it is only ever set to one
or zero and read as non-zero.

Assisted-by: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/vtbackend/grid/CellProxy.hpp | 6 +++---
 src/vtbackend/grid/Line.hpp      | 6 ++++--
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/vtbackend/grid/CellProxy.hpp b/src/vtbackend/grid/CellProxy.hpp
index 1eb7db581..de79db194 100644
--- a/src/vtbackend/grid/CellProxy.hpp
+++ b/src/vtbackend/grid/CellProxy.hpp
@@ -40,7 +40,7 @@ class BasicCellProxy
 
     using LineType = std::conditional_t<IsConst, LineSoA const, LineSoA>;
 
-    BasicCellProxy(LineType& line, size_t col, bool* dirty = nullptr) noexcept:
+    BasicCellProxy(LineType& line, size_t col, uint8_t* dirty = nullptr) noexcept:
         _line(&line), _col(col), _dirty(dirty)
     {
         // CellProxy must never be constructed on a blank (un-materialized) line:
@@ -336,7 +336,7 @@ class BasicCellProxy
         requires(!IsConst)
     {
         if (_dirty)
-            *_dirty = true;
+            *_dirty = 1;
     }
 
     /// Clears the cell to an empty one wearing @p attrs and @p hyperlinkId. Leaves the line's shape to
@@ -377,7 +377,7 @@ class BasicCellProxy
 
     LineType* _line;
     size_t _col;
-    bool* _dirty = nullptr; ///< Optional back-pointer to Line::_dirty for write-through dirtying.
+    uint8_t* _dirty = nullptr; ///< Optional back-pointer to Line::_dirty for write-through dirtying.
 };
 
 /// Mutable proxy — read-write access to a LineSoA cell.
diff --git a/src/vtbackend/grid/Line.hpp b/src/vtbackend/grid/Line.hpp
index 6de86064a..d209222ef 100644
--- a/src/vtbackend/grid/Line.hpp
+++ b/src/vtbackend/grid/Line.hpp
@@ -166,7 +166,7 @@ class Line
     void markDirty() noexcept { _dirty = true; }
 
     /// @return True while a change awaits its revision stamp.
-    [[nodiscard]] bool isDirty() const noexcept { return _dirty; }
+    [[nodiscard]] bool isDirty() const noexcept { return _dirty != 0; }
 
     /// Stamps the line with @p seqno iff it is dirty, clearing the dirty bit.
     /// @return True if the line was dirty (and got stamped).
@@ -769,7 +769,9 @@ class Line
                             ///< forEachLineChangedSince. Both are uint64_t — at
                             ///< one batch per ~20ms a wrap takes ~11.7 billion
                             ///< years, so wrap is not handled in the comparison.
-    bool _dirty = true;     ///< Fresh lines are pending: bootstrap self-heals.
+    uint8_t _dirty = 1;     ///< Fresh lines are pending: bootstrap self-heals. One byte on every
+                            ///< ABI: bool is four on 32-bit Darwin PowerPC, which would push
+                            ///< _blockId out of the tail below.
 
     /// The birth stamp bornAt() decodes, three bytes little-endian. Placed in the padding after _dirty,
     /// like _blockId below, so neither costs a byte per line; the static_assert after the class keeps it so.
-- 
