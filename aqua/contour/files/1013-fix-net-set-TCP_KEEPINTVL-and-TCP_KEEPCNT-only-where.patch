From def4cb6f7d6a9e3eef2bcdf033fb1464bfab9941 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 8 Nov 2026 21:30:11 +0000
Subject: [PATCH 14/14] fix(net): set TCP_KEEPINTVL and TCP_KEEPCNT only where
 the SDK has them

Darwin gained the per-socket probe interval and probe count in 10.9.
The 10.6 SDK's <netinet/tcp.h> has TCP_KEEPALIVE (the idle time) and
nothing else, so this file did not compile there:

  error: 'TCP_KEEPINTVL' was not declared in this scope
  error: 'TCP_KEEPCNT' was not declared in this scope

Set the two options only where the SDK defines them. Where it does
not, the idle time is still applied and the flag still armed, so a
silent peer is noticed after the kernel's own interval and count
(75 s and 8 probes on those releases, about ten minutes past the idle
time rather than the 16 s the settings ask for) instead of never. This
mirrors the Windows path, which cannot honour the count either.

Assisted-by: Claude Fable 5.1 <noreply@anthropic.com>
---
 vendor/core-cpp/src/core/net/posix/StreamSocketOptions.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/vendor/core-cpp/src/core/net/posix/StreamSocketOptions.cpp b/vendor/core-cpp/src/core/net/posix/StreamSocketOptions.cpp
index 137f354f6..85b543f47 100644
--- a/vendor/core-cpp/src/core/net/posix/StreamSocketOptions.cpp
+++ b/vendor/core-cpp/src/core/net/posix/StreamSocketOptions.cpp
@@ -48,8 +48,6 @@ namespace
         constexpr int IdleOption = TCP_KEEPIDLE;
 #endif
         auto const idle = wholeSeconds(settings.idle);
-        auto const interval = wholeSeconds(settings.interval);
-        auto const count = static_cast<int>(settings.count);
 
         // **The INTERVALS FIRST, and the flag last.** Reversed, a socket whose intervals could
         // not be applied would be left probing on the system default — two hours on Linux —
@@ -57,10 +55,15 @@ namespace
         // while reading back as armed to anything that checks the flag.
         if (::setsockopt(fd, IPPROTO_TCP, IdleOption, &idle, sizeof(idle)) != 0)
             return false;
+        // Darwin before 10.9 has only the idle time; interval and count stay the kernel's there.
+#if defined(TCP_KEEPINTVL) && defined(TCP_KEEPCNT)
+        auto const interval = wholeSeconds(settings.interval);
+        auto const count = static_cast<int>(settings.count);
         if (::setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &interval, sizeof(interval)) != 0)
             return false;
         if (::setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT, &count, sizeof(count)) != 0)
             return false;
+#endif
 
         int const on = 1;
         return ::setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &on, sizeof(on)) == 0;
