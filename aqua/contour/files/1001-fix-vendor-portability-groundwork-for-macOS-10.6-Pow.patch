diff --git a/src/vtpty/Process.hpp b/src/vtpty/Process.hpp
index 4b7799418..6a9cad5e9 100644
--- a/src/vtpty/Process.hpp
+++ b/src/vtpty/Process.hpp
@@ -201,10 +201,17 @@ struct std::formatter<vtpty::Process::ExitStatus>: std::formatter<std::string>
 #ifdef _WIN32
                                               strerror_s(buf, sizeof(buf), errno);
                                               return std::format("{} (signal number {})", buf, exit.signum);
-#else
+#elif defined(__GLIBC__) && (defined(_GNU_SOURCE) || !((_POSIX_C_SOURCE >= 200112L) || defined(_XOPEN_SOURCE)))
+                                              // glibc's GNU strerror_r returns a char* that may or may not be buf.
                                               return std::format("{} (signal number {})",
                                                                  strerror_r(errno, buf, sizeof(buf)),
                                                                  exit.signum);
+#else
+                                              // XSI strerror_r (Darwin, the BSDs, POSIX) returns int and
+                                              // writes the message into buf.
+                                              buf[0] = '\0';
+                                              (void) strerror_r(errno, buf, sizeof(buf));
+                                              return std::format("{} (signal number {})", buf, exit.signum);
 #endif
                                           } },
                        status);
