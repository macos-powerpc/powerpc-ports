+    /// Resolves the on-disk file path of a CTFont, returning true and filling @p out on success.
+    ///
+    /// Prefers kCTFontURLAttribute (reliable on modern macOS). On older systems (notably 10.6) that
+    /// attribute frequently returns null for system fonts, so it falls back to Apple Type Services:
+    /// CTFontGetPlatformFont -> ATSFontRef -> ATSFontGetFileReference -> FSRef -> path.
+    [[nodiscard]] bool copyFontFilePath(CTFontRef font, char* out, size_t outSize)
+    {
+        if (!font)
+            return false;
+
+        if (auto const url = CFObject<CFURLRef>(static_cast<CFURLRef>(CTFontCopyAttribute(font, kCTFontURLAttribute))))
+        {
+            if (CFURLGetFileSystemRepresentation(url.get(), true, reinterpret_cast<UInt8*>(out), static_cast<CFIndex>(outSize)))
+                return true;
+        }
+
+#if !defined(__LP64__)
+        // ATS fallback for 10.6, where kCTFontURLAttribute is frequently null for system fonts.
+        // Resolve via the PostScript name (reliably available from the CTFont) to an ATSFontRef,
+        // then to the font file. The ATSFontRef file APIs are 32-bit-only, which matches the
+        // PowerPC target; on 64-bit builds this path is unavailable but the URL attribute above
+        // works there anyway.
+        if (auto const psName = CFObject<CFStringRef>(CTFontCopyPostScriptName(font)))
+        {
+            ATSFontRef const atsFont = ATSFontFindFromPostScriptName(psName.get(), kATSOptionFlagsDefault);
+            if (atsFont != kATSFontRefUnspecified && atsFont != 0)
+            {
+                FSRef fsRef;
+                if (ATSFontGetFileReference(atsFont, &fsRef) == noErr
+                    && FSRefMakePath(&fsRef, reinterpret_cast<UInt8*>(out), static_cast<UInt32>(outSize)) == noErr)
+                    return true;
+            }
         }
-        return NSFontWeightRegular;
+#endif
+        return false;
     }
 
