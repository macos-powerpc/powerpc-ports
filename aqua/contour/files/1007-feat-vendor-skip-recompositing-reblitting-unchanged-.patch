+void Renderer::filterDirtyRows(std::span<vtbackend::RenderCell const> cells,
+                               std::span<vtbackend::RenderLine const> lines,
+                               std::optional<vtbackend::RenderCursor> const& cursor,
+                               bool repaintAll,
+                               vtbackend::RGBColor defaultBackground,
+                               std::vector<vtbackend::RenderCell>& dirtyCells,
+                               std::vector<vtbackend::RenderLine>& dirtyLines)
+{
+    using vtbackend::LineOffset;
+
+    auto const geometry = DamageGeometry {
+        .cellSize = _gridMetrics.cellSize,
+        .pageSize = _gridMetrics.pageSize,
+        .marginLeft = _gridMetrics.pageMargin.left,
+        .marginTop = _gridMetrics.pageMargin.top,
+        .renderSize = _renderTarget->renderSize(),
+        .defaultBackground = defaultBackground,
+    };
+    auto const everything = repaintAll || !_damage.valid || !(_damage.geometry == geometry);
+
+    // This frame, bucketed by screen row, in the storage the frame before last used. A row above the window
+    // (the smooth-scroll rows take the two-pass path, so none should reach this one) is drawn, not compared.
+    auto rows = std::move(_damageScratch);
+    for (auto& row: rows)
+    {
+        row.cells.clear();
+        row.lines.clear();
+    }
+    auto const rowAt = [&](LineOffset line) -> DamageRow* {
+        if (*line < 0)
+            return nullptr;
+        auto const index = static_cast<size_t>(*line);
+        if (index >= rows.size())
+            rows.resize(index + 1);
+        return &rows[index];
+    };
+    for (auto const& cell: cells)
+    {
+        if (auto* row = rowAt(cell.position.line))
+            row->cells.push_back(cell);
+        else
+        {
+            dirtyCells.push_back(cell);
+            _lastDirtyRows.push_back(cell.position.line);
+        }
+    }
+    for (auto const& line: lines)
+    {
+        if (auto* row = rowAt(line.lineOffset))
+            row->lines.push_back(line);
+        else
+        {
+            dirtyLines.push_back(line);
+            _lastDirtyRows.push_back(line.lineOffset);
+        }
+    }
+
+    // The cursor is drawn apart from the cells, and leaves no trace in them: the row it left and the row it
+    // is on are redrawn whatever their cells say, and so is every row a motion between the two sweeps.
+    auto cursorRows = std::vector<LineOffset> {};
+    if (_damage.cursorRow)
+        cursorRows.push_back(*_damage.cursorRow);
+    if (cursor)
+    {
+        cursorRows.push_back(cursor->position.line);
+        if (cursor->animateFrom)
+        {
+            auto const from = static_cast<int>(cursor->animateFrom->line);
+            auto const to = *cursor->position.line;
+            for (auto row = std::min(from, to); row <= std::max(from + 1, to); ++row)
+                cursorRows.push_back(LineOffset(row));
+        }
+    }
+    auto const touchesCursor = [&](LineOffset line) {
+        return std::ranges::find(cursorRows, line) != cursorRows.end();
+    };
+    auto const blinking = [](DamageRow const& row) {
+        return std::ranges::any_of(row.cells, [](auto const& cell) { return blinks(cell.attributes); })
+               || std::ranges::any_of(row.lines, [](auto const& line) { return blinks(line.textAttributes); });
+    };
+    auto const same = [](DamageRow const& a, DamageRow const& b) {
+        return std::ranges::equal(a.cells, b.cells, sameCell) && std::ranges::equal(a.lines, b.lines, sameLine);
+    };
+
+    auto const rowCount = std::max(rows.size(), _damage.rows.size());
+    for (size_t index = 0; index < rowCount; ++index)
+    {
+        auto const line = LineOffset::cast_from(index);
+        auto const* current = index < rows.size() ? &rows[index] : nullptr;
+        auto const* previous = index < _damage.rows.size() ? &_damage.rows[index] : nullptr;
+        auto const currentEmpty = !current || current->empty();
+        auto const previousEmpty = !previous || previous->empty();
+        if (currentEmpty && previousEmpty)
+            continue;
+        // A row that held content and holds none now is dirty with nothing to draw: it gets erased.
+        auto const dirty = everything || touchesCursor(line) || currentEmpty != previousEmpty
+                           || (current && blinking(*current)) || (current && previous && !same(*previous, *current));
+        if (!dirty)
+            continue;
+        _lastDirtyRows.push_back(line);
+        if (current)
+        {
+            dirtyCells.insert(dirtyCells.end(), current->cells.begin(), current->cells.end());
+            dirtyLines.insert(dirtyLines.end(), current->lines.begin(), current->lines.end());
+        }
+    }
+
+    _damageScratch = std::move(_damage.rows);
+    _damage.rows = std::move(rows);
+    _damage.cursorRow = cursor ? std::optional { cursor->position.line } : std::nullopt;
+    _damage.geometry = geometry;
+    _damage.valid = true;
+}
+
+void Renderer::noteRowsPainted(std::span<vtbackend::RenderCell const> cells,
+                               std::span<vtbackend::RenderLine const> lines)
+{
+    for (auto const& cell: cells)
+        if (_lastDirtyRows.empty() || _lastDirtyRows.back() != cell.position.line)
+            _lastDirtyRows.push_back(cell.position.line);
+    for (auto const& line: lines)
+        if (_lastDirtyRows.empty() || _lastDirtyRows.back() != line.lineOffset)
+            _lastDirtyRows.push_back(line.lineOffset);
+}
