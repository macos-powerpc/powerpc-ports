+    [[nodiscard]] bool render(vtbackend::Terminal& terminal,
+                              bool pressureHint,
+                              RenderDirtyMode dirtyMode = RenderDirtyMode::FullFrame);
+
+    /// The screen rows (RenderCell::position.line, so counted from the window's first row, status line
+    /// included) the most recent render() call painted, when it was called with
+    /// RenderDirtyMode::SkipUnchangedRows. Sorted, without duplicates. A caller whose RenderTarget does
+    /// not clear its surface on its own erases exactly these rows to the default background before the
+    /// frame's commands are composited -- a default-background cell emits no background rectangle -- and
+    /// may restrict its presentation (a blit, setNeedsDisplayInRect:) to the pixel rows they cover. A row
+    /// that held content last frame and holds none now is listed too, so that it gets erased. Empty, and
+    /// meaningless, after a FullFrame call.
+    [[nodiscard]] std::vector<vtbackend::LineOffset> const& lastDirtyRows() const noexcept
+    {
+        return _lastDirtyRows;
+    }
 
     /// Synchronously applies any staged font/geometry reconfiguration.
     ///
@@ -350,7 +384,7 @@ class Renderer
 
   private:
     /// Internal implementation of render(), wrapped in a try/catch for graceful degradation.
-    [[nodiscard]] bool renderImpl(vtbackend::Terminal& terminal, bool pressure);
+    [[nodiscard]] bool renderImpl(vtbackend::Terminal& terminal, bool pressure, RenderDirtyMode dirtyMode);
 
     void configureTextureAtlas();
 
@@ -388,6 +422,62 @@ class Renderer
     /// @param lines  Contiguous sub-range of RenderLine entries to render.
     void renderLines(std::span<vtbackend::RenderLine const> lines);
 
+    /// One screen row as the previous SkipUnchangedRows frame drew it: the render cells and lines whose
+    /// position named that row. @see filterDirtyRows
+    struct DamageRow
+    {
+        std::vector<vtbackend::RenderCell> cells;
+        std::vector<vtbackend::RenderLine> lines;
+
+        [[nodiscard]] bool empty() const noexcept { return cells.empty() && lines.empty(); }
+    };
+
+    /// What besides a row's own content decides its pixels. A change repaints every row.
+    struct DamageGeometry
+    {
+        vtbackend::ImageSize cellSize {};
+        vtbackend::PageSize pageSize {};
+        int marginLeft = 0;
+        int marginTop = 0;
+        vtbackend::ImageSize renderSize {};
+        vtbackend::RGBColor defaultBackground {};
+
+        bool operator==(DamageGeometry const&) const = default;
+    };
+
+    /// The previous SkipUnchangedRows frame, row by row, and the conditions it was drawn under.
+    struct DamageState
+    {
+        std::vector<DamageRow> rows;                    ///< Indexed by screen row.
+        std::optional<vtbackend::LineOffset> cursorRow; ///< The row the cursor was drawn on, if it was.
+        DamageGeometry geometry {};
+        bool valid = false; ///< False until a frame has been recorded.
+    };
+
+    /// Keeps of @p cells and @p lines -- the main display's, in the row-major order the render buffer holds
+    /// them -- only the rows that differ from the previous SkipUnchangedRows frame, appended to @p dirtyCells
