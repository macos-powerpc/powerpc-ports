+/// Controls whether Renderer::render() may skip re-emitting draw commands for screen rows whose
+/// content provably did not change since the previous call (see vtbackend::RenderBuffer::
+/// lineGenerations). Opt-in: a caller whose RenderTarget does not preserve unchanged pixels across
+/// frames (e.g. one that clears its surface every frame) must keep FullFrame, or unchanged rows
+/// will render as blank.
+enum class RenderDirtyMode
+{
+    /// Emit commands for every visible cell/line every frame, as if no dirty-tracking existed.
+    FullFrame,
+    /// Skip cells/lines whose row generation is unchanged from the previous render() call. The
+    /// caller's RenderTarget must retain previously-drawn pixels for skipped rows (no per-frame
+    /// full-surface clear), or their content will not appear.
+    SkipUnchangedRows,
+};
+
 /**
