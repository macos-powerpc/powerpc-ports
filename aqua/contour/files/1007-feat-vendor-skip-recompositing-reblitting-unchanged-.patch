-bool Renderer::render(vtbackend::Terminal& terminal, bool pressure)
+namespace
+{
+    // Row-for-row equality of what the render buffer carries, for RenderDirtyMode::SkipUnchangedRows.
+    // Field by field rather than a defaulted operator== on the vtbackend types themselves, so that this
+    // stays a renderer-local concern; a field upstream adds later is compared only once it is added here.
+
+    bool sameAttributes(vtbackend::RenderAttributes const& a, vtbackend::RenderAttributes const& b) noexcept
+    {
+        return a.foregroundColor == b.foregroundColor && a.backgroundColor == b.backgroundColor
+               && a.decorationColor == b.decorationColor && a.flags == b.flags && a.lineFlags == b.lineFlags;
+    }
+
+    bool sameImage(std::shared_ptr<vtbackend::ImageFragment> const& a,
+                   std::shared_ptr<vtbackend::ImageFragment> const& b) noexcept
+    {
+        if (a == b)
+            return true;
+        if (!a || !b)
+            return false;
+        return *a == *b; // the same image (by id) at the same offset
+    }
+
+    bool sameCell(vtbackend::RenderCell const& a, vtbackend::RenderCell const& b) noexcept
+    {
+        return a.position == b.position && a.width == b.width && a.sizing == b.sizing && a.linkRole == b.linkRole
+               && a.groupStart == b.groupStart && a.groupEnd == b.groupEnd
+               && sameAttributes(a.attributes, b.attributes) && a.codepoints == b.codepoints
+               && sameImage(a.image, b.image);
+    }
+
+    bool sameLine(vtbackend::RenderLine const& a, vtbackend::RenderLine const& b) noexcept
+    {
+        return a.lineOffset == b.lineOffset && a.usedColumns == b.usedColumns && a.displayWidth == b.displayWidth
+               && a.flags == b.flags && sameAttributes(a.textAttributes, b.textAttributes)
+               && sameAttributes(a.fillAttributes, b.fillAttributes) && a.text == b.text;
+    }
+
+    bool blinks(vtbackend::RenderAttributes const& attributes) noexcept
+    {
+        using vtbackend::CellFlag;
+        return static_cast<bool>(attributes.flags & CellFlag::Blinking)
+               || static_cast<bool>(attributes.flags & CellFlag::RapidBlinking);
+    }
+} // namespace
