From 9f52c84854ab1e0300868f46af181b8092b10ea2 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 14 Sep 2026 17:48:24 +0000
Subject: [PATCH] main: pick the translation by system locale name on Qt 4

Qt 4's QLocale::uiLanguages() on macOS is the whole AppleLanguages
preference list ("en", "ja", "fr", ...). QtPass has localization_en_US.qm
and en_GB but no localization_en.qm, so the QLocale overload of
QTranslator::load() misses "en" and walks on to the first language with
a file, which is Japanese on an English system. On Qt 4 resolve the system
locale name and then its language part explicitly, and stay with the
English source strings when neither exists, which is what Qt 5/6 end up
doing with their "en-US" ui language. Qt 5/6 keep the QLocale overload.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SNLMjDKKUDw5GKpBW96KSN
---
 main/main.cpp | 24 +++++++++++++++++++++---
 1 file changed, 21 insertions(+), 3 deletions(-)

diff --git a/main/main.cpp b/main/main.cpp
index d3481d3cd..fc8e87e75 100644
--- a/main/main.cpp
+++ b/main/main.cpp
@@ -168,9 +168,27 @@ auto main(int argc, char *argv[]) -> int {
   // untranslated whenever the system locale carried a country suffix that
   // didn't match any .qm file verbatim.
   QTranslator translator;
-  if (translator.load(QLocale::system(), QStringLiteral("localization"),
-                      QStringLiteral("_"), QStringLiteral(":/localization"),
-                      QStringLiteral(".qm"))) {
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+  // Qt 4's QLocale::uiLanguages() on macOS is the whole AppleLanguages
+  // preference list ("en", "ja", "fr", ...). There is no localization_en.qm,
+  // only en_US/en_GB, so the QLocale overload of load() misses "en" and walks
+  // on to the first language that has a file, which is Japanese on an
+  // English system. Resolve the system locale name and its language part
+  // explicitly instead, and stay with the English source strings otherwise.
+  const QString systemLocaleName = QLocale::system().name();
+  const QString systemLanguage =
+      systemLocaleName.section(QLatin1Char('_'), 0, 0);
+  const bool translationLoaded =
+      translator.load(QStringLiteral("localization_") + systemLocaleName,
+                      QStringLiteral(":/localization")) ||
+      translator.load(QStringLiteral("localization_") + systemLanguage,
+                      QStringLiteral(":/localization"));
+#else
+  const bool translationLoaded = translator.load(
+      QLocale::system(), QStringLiteral("localization"), QStringLiteral("_"),
+      QStringLiteral(":/localization"), QStringLiteral(".qm"));
+#endif
+  if (translationLoaded) {
 #if SINGLE_APP
     SingleApplication::installTranslator(&translator);
     SingleApplication::setLayoutDirection(
