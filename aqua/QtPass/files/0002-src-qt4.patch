+/**
+ * @brief Recursively remove a directory and its contents.
+ *
+ * QDir::removeRecursively() is a Qt 5 addition; this walks the tree by hand
+ * for Qt 4, deleting files and recursing into subdirectories before removing
+ * the now-empty directory itself.
+ * @param dir Directory to remove recursively.
+ * @return true if the directory (and everything under it) was removed.
+ */
+static bool removeDirRecursively(const QDir &dir) {
+  const QFileInfoList entries = dir.entryInfoList(
+      QDir::NoDotAndDotDot | QDir::AllEntries | QDir::Hidden | QDir::System);
+  for (const QFileInfo &entry : entries) {
+    if (entry.isDir() && !entry.isSymLink()) {
+      if (!removeDirRecursively(QDir(entry.absoluteFilePath()))) {
+        return false;
+      }
+    } else {
+      if (!QFile::remove(entry.absoluteFilePath())) {
+        return false;
+      }
+    }
+  }
+  QDir parent(dir);
+  parent.cdUp();
+  return parent.rmdir(dir.dirName());
+}
+#endif
