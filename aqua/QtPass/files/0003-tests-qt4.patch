-           QByteArrayLiteral("A=B=C=D"));
+  QCOMPARE(Base32::removePadding(QByteArray("AB=CDEF=")),
+           QByteArray("AB=CDEF"));
+  QCOMPARE(Base32::removePadding(QByteArray("A=B=C=D=")),
+           QByteArray("A=B=C=D"));
 }
 
