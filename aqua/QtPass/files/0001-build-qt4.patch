+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef SRC_QT4_SHA2_H_
+#define SRC_QT4_SHA2_H_
+
+#include <QByteArray>
+
+/**
+ * @file sha2.h
+ * @brief SHA-256 and SHA-512 (FIPS 180-4) for the Qt4 build, whose
+ * QCryptographicHash only knows MD4, MD5 and SHA-1.
+ *
+ * Byte-order explicit throughout, so the PowerPC (big-endian) target and the
+ * x86 development box produce identical digests.
+ */
+namespace Sha2 {
+/** @brief SHA-256 digest of @p data (32 bytes). */
+QByteArray sha256(const QByteArray &data);
+/** @brief SHA-512 digest of @p data (64 bytes). */
+QByteArray sha512(const QByteArray &data);
+} // namespace Sha2
+
+#endif // SRC_QT4_SHA2_H_
