diff --git a/src/functorthread.h b/src/functorthread.h
new file mode 100644
index 000000000..60969aa15
--- /dev/null
+++ b/src/functorthread.h
@@ -0,0 +1,60 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef SRC_FUNCTORTHREAD_H_
+#define SRC_FUNCTORTHREAD_H_
+
+#include <QThread>
+#include <atomic>
+#include <functional>
+#include <utility>
+
+/**
+ * @brief QThread that runs a callable, with a cooperative interrupt flag.
+ *
+ * Replaces QThread::create() (Qt 5.10) and QThread::requestInterruption()
+ * (Qt 5.2) with one implementation that behaves the same on every Qt
+ * version QtPass builds against. The flag shadows the QThread members of the
+ * same name on Qt 5+, so callers see one API.
+ */
+class FunctorThread : public QThread {
+  Q_OBJECT
+public:
+  /**
+   * @brief Wrap @p fn to run on the new thread.
+   * @param fn Callable executed by run().
+   * @param parent Optional owner.
+   */
+  explicit FunctorThread(std::function<void()> fn, QObject *parent = nullptr)
+      : QThread(parent), m_fn(std::move(fn)), m_interrupt(false) {}
+
+  /** @brief Ask the callable to stop at its next check. */
+  void requestInterruption() {
+    m_interrupt.store(true, std::memory_order_release);
+  }
+  /** @return true once requestInterruption() has been called. */
+  bool isInterruptionRequested() const {
+    return m_interrupt.load(std::memory_order_acquire);
+  }
+
+  /**
+   * @brief Interrupt flag of the calling thread, if it is a FunctorThread.
+   * @return true only when running on a FunctorThread that was interrupted.
+   */
+  static bool currentInterruptionRequested() {
+    const auto *t = qobject_cast<FunctorThread *>(QThread::currentThread());
+    return t && t->isInterruptionRequested();
+  }
+
+protected:
+  /** @brief Runs the wrapped callable. */
+  void run() override {
+    if (m_fn)
+      m_fn();
+  }
+
+private:
+  std::function<void()> m_fn;
+  std::atomic<bool> m_interrupt;
+};
+
+#endif // SRC_FUNCTORTHREAD_H_
