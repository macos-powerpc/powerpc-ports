@@ -0,0 +1,47 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef QT4_QRANDOMGENERATOR4_H
+#define QT4_QRANDOMGENERATOR4_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+/**
+ * @brief Qt4 backport of QRandomGenerator (Qt 5.10), system()->generate()
+ * subset.
+ *
+ * Backed by /dev/urandom, never by qrand(): this feeds password generation
+ * (Pass::boundedRandom(), src/pass.cpp), so a missing or unreadable entropy
+ * source aborts the process (qFatal) rather than silently degrading to a
+ * weak PRNG.
+ */
+class QRandomGenerator {
+public:
+  static QRandomGenerator *system();
+
+  quint32 generate();
+  quint64 generate64();
+
+  /**
+   * @brief Returns a random value in [0, highest).
+   * @param highest Exclusive upper bound.
+   * @return Unbiased random value (rejection sampling).
+   */
+  quint32 bounded(quint32 highest);
+
+  /**
+   * @brief Returns a random value in [lowest, highest).
+   * @param lowest Inclusive lower bound.
+   * @param highest Exclusive upper bound.
+   * @return Unbiased random value (rejection sampling).
+   */
+  quint32 bounded(quint32 lowest, quint32 highest);
+
+private:
+  QRandomGenerator() = default;
+};
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#endif // QT4_QRANDOMGENERATOR4_H
diff --git a/src/qt4/qregularexpression4.cpp b/src/qt4/qregularexpression4.cpp
new file mode 100644
index 000000000..02945be82
--- /dev/null
+++ b/src/qt4/qregularexpression4.cpp
@@ -0,0 +1,185 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "qregularexpression4.h"
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+QRegularExpression::QRegularExpression() : m_options(NoPatternOption) {
+  rebuild();
+}
+
+QRegularExpression::QRegularExpression(const QString &pattern,
+                                       PatternOptions options)
+    : m_pattern(pattern), m_options(options) {
+  rebuild();
+}
+
+void QRegularExpression::setPattern(const QString &pattern) {
+  m_pattern = pattern;
+  rebuild();
+}
+
+void QRegularExpression::setPatternOptions(PatternOptions options) {
+  m_options = options;
+  rebuild();
+}
+
+void QRegularExpression::rebuild() {
+  m_rx = QRegExp(m_pattern,
+                 (m_options & CaseInsensitiveOption) ? Qt::CaseInsensitive
+                                                     : Qt::CaseSensitive,
+                 QRegExp::RegExp2);
+  if (m_options & InvertedGreedinessOption)
+    m_rx.setMinimal(true);
+}
+
+QString QRegularExpression::errorString() const {
+  // Qt5 reports "no error" for a valid pattern; QRegExp reports an empty
+  // string, which call sites would print as an empty message.
+  const QString err = m_rx.errorString();
+  return err.isEmpty() ? QString::fromLatin1("no error") : err;
+}
+
+QString QRegularExpression::anchoredPattern(const QString &expression) {
+  // Qt5 wraps in \A(?:...)\z; QRegExp has no \A or \z, ^ and $ are string
+  // anchors outside multiline mode which is all anchoredPattern needs.
+  return QString::fromLatin1("^(?:") + expression + QString::fromLatin1(")$");
+}
+
+QString
+QRegularExpression::wildcardToRegularExpression(const QString &pattern) {
+  // Qt 5.15 semantics: anchored, * -> .*, ? -> ., [...] classes kept,
+  // everything else escaped.
+  QString rx;
+  rx.reserve(pattern.size() * 2 + 4);
+  rx += QLatin1String("^(?:");
+  const int n = pattern.size();
+  int i = 0;
+  while (i < n) {
+    const QChar c = pattern.at(i);
+    switch (c.unicode()) {
+    case '*':
+      rx += QLatin1String(".*");
+      break;
+    case '?':
+      rx += QLatin1Char('.');
+      break;
+    case '[': {
+      // copy a bracket expression through, translating a leading ! to ^
+      int j = i + 1;
+      QString cls;
+      if (j < n && pattern.at(j) == QLatin1Char('!')) {
+        cls += QLatin1Char('^');
+        ++j;
+      }
+      if (j < n && pattern.at(j) == QLatin1Char(']')) {
+        cls += QLatin1String("\\]");
+        ++j;
+      }
+      while (j < n && pattern.at(j) != QLatin1Char(']')) {
+        const QChar d = pattern.at(j);
+        if (d == QLatin1Char('\\') || d == QLatin1Char('['))
+          cls += QLatin1Char('\\');
+        cls += d;
+        ++j;
+      }
+      if (j < n) {
+        rx += QLatin1Char('[') + cls + QLatin1Char(']');
+        i = j;
+      } else {
+        rx += QLatin1String("\\[");
+      }
+      break;
+    }
+    default:
+      rx += QRegExp::escape(QString(c));
+      break;
+    }
+    ++i;
+  }
+  rx += QLatin1String(")$");
+  return rx;
+}
+
+QRegularExpressionMatch QRegularExpression::makeMatch(const QRegExp &rx, int at,
+                                                      int base) {
+  QRegularExpressionMatch m;
+  m.m_valid = true;
+  if (at < 0)
+    return m;
+  m.m_texts = rx.capturedTexts();
+  m.m_starts.resize(m.m_texts.size());
+  for (int i = 0; i < m.m_texts.size(); ++i) {
+    const int p = rx.pos(i);
+    m.m_starts[i] = p < 0 ? -1 : p + base;
+  }
+  return m;
+}
+
+// One match of rx in subject at or after offset, honouring MultilineOption by
+// trying each line in turn (^ and $ then bind to the line, as in PCRE).
+QRegularExpressionMatch QRegularExpression::matchOnce(const QRegExp &pattern,
+                                                      bool multiline,
+                                                      const QString &subject,
+                                                      int offset) {
+  QRegExp rx(pattern); // private capture state, safe to use across threads
+  if (!multiline) {
+    const int at = rx.indexIn(subject, offset, QRegExp::CaretAtZero);
+    return makeMatch(rx, at, 0);
+  }
+  int lineStart = 0;
+  const int n = subject.size();
+  while (lineStart <= n) {
+    int lineEnd = subject.indexOf(QLatin1Char('\n'), lineStart);
+    if (lineEnd < 0)
+      lineEnd = n;
+    if (lineEnd >= offset) {
+      const QString line = subject.mid(lineStart, lineEnd - lineStart);
+      const int from = offset > lineStart ? offset - lineStart : 0;
+      const int at = rx.indexIn(line, from, QRegExp::CaretAtZero);
+      if (at >= 0)
+        return makeMatch(rx, at, lineStart);
+    }
+    if (lineEnd >= n)
+      break;
+    lineStart = lineEnd + 1;
+  }
+  QRegularExpressionMatch none;
+  none.m_valid = true;
+  return none;
+}
+
+QRegularExpressionMatch QRegularExpression::match(const QString &subject,
+                                                  int offset, MatchType,
+                                                  MatchOptions) const {
+  if (!isValid())
+    return QRegularExpressionMatch();
+  if (offset < 0)
+    offset = qMax(0, subject.size() + offset);
+  return matchOnce(m_rx, m_options & MultilineOption, subject, offset);
+}
+
+QRegularExpressionMatchIterator
+QRegularExpression::globalMatch(const QString &subject, int offset, MatchType,
+                                MatchOptions) const {
+  QRegularExpressionMatchIterator it;
+  if (!isValid())
+    return it;
+  if (offset < 0)
+    offset = qMax(0, subject.size() + offset);
+  const bool multiline = m_options & MultilineOption;
+  while (offset <= subject.size()) {
+    const QRegularExpressionMatch m =
+        matchOnce(m_rx, multiline, subject, offset);
+    if (!m.hasMatch())
+      break;
+    it.m_matches.append(m);
+    const int end = m.capturedEnd(0);
+    offset = (end > m.capturedStart(0))
+                 ? end
+                 : end + 1; // never loop on an empty match
+  }
+  return it;
+}
+
+#endif // QT_VERSION < 5
diff --git a/src/qt4/qregularexpression4.h b/src/qt4/qregularexpression4.h
new file mode 100644
index 000000000..63d8d8cf5
--- /dev/null
+++ b/src/qt4/qregularexpression4.h
@@ -0,0 +1,166 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef SRC_QT4_QREGULAREXPRESSION4_H_
+#define SRC_QT4_QREGULAREXPRESSION4_H_
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QList>
+#include <QRegExp>
+#include <QString>
+#include <QStringList>
+#include <QVector>
+
+/**
+ * @file qregularexpression4.h
+ * @brief Qt4 stand-in for QRegularExpression, backed by QRegExp.
+ *
+ * Only the API surface QtPass uses is provided. Patterns are compiled with
+ * QRegExp::RegExp2 (greedy Perl-like syntax); the PCRE features QRegExp
+ * lacks (lookbehind, named groups, possessive quantifiers) are simply not
+ * available and QRegExp reports them through isValid()/errorString().
+ *
+ * MultilineOption is emulated by matching line by line, so ^ and $ anchor at
+ * line boundaries as they do in PCRE multiline mode. The implicit conversion
+ * to QRegExp lets the Qt4 QString members (replace, remove, split, contains,
+ * indexOf) accept a QRegularExpression argument unchanged; those calls never
+ * see MultilineOption, which no such call site uses.
+ */
+class QRegularExpressionMatch;
+class QRegularExpressionMatchIterator;
+
+class QRegularExpression {
+public:
+  enum PatternOption {
+    NoPatternOption = 0x0000,
+    CaseInsensitiveOption = 0x0001,
+    DotMatchesEverythingOption = 0x0002,
+    MultilineOption = 0x0004,
+    ExtendedPatternSyntaxOption = 0x0008,
+    InvertedGreedinessOption = 0x0010,
+    DontCaptureOption = 0x0020,
+    UseUnicodePropertiesOption = 0x0040
+  };
+  Q_DECLARE_FLAGS(PatternOptions, PatternOption)
+
+  enum MatchType {
+    NormalMatch = 0,
+    PartialPreferCompleteMatch,
+    PartialPreferFirstMatch,
+    NoMatch
+  };
+  enum MatchOption {
+    NoMatchOption = 0x0000,
+    AnchoredMatchOption = 0x0001,
+    AnchorAtOffsetMatchOption = 0x0001
+  };
+  Q_DECLARE_FLAGS(MatchOptions, MatchOption)
+
+  QRegularExpression();
+  explicit QRegularExpression(const QString &pattern,
+                              PatternOptions options = NoPatternOption);
+
+  QString pattern() const { return m_pattern; }
+  void setPattern(const QString &pattern);
+  PatternOptions patternOptions() const { return m_options; }
+  void setPatternOptions(PatternOptions options);
+
+  bool isValid() const { return m_rx.isValid(); }
+  QString errorString() const;
+  int patternErrorOffset() const { return isValid() ? -1 : 0; }
+  int captureCount() const { return m_rx.captureCount(); }
+
+  QRegularExpressionMatch
+  match(const QString &subject, int offset = 0,
+        MatchType matchType = NormalMatch,
+        MatchOptions matchOptions = NoMatchOption) const;
+  QRegularExpressionMatchIterator
+  globalMatch(const QString &subject, int offset = 0,
+              MatchType matchType = NormalMatch,
+              MatchOptions matchOptions = NoMatchOption) const;
+
+  static QString escape(const QString &str) { return QRegExp::escape(str); }
+  static QString anchoredPattern(const QString &expression);
+  static QString wildcardToRegularExpression(const QString &pattern);
+
+  /** @brief The underlying QRegExp (case sensitivity applied, no multiline). */
+  const QRegExp &regExp() const { return m_rx; }
+  operator const QRegExp &() const { return m_rx; }
+
+  bool operator==(const QRegularExpression &other) const {
+    return m_pattern == other.m_pattern && m_options == other.m_options;
+  }
+  bool operator!=(const QRegularExpression &other) const {
+    return !(*this == other);
+  }
+
+private:
+  void rebuild();
+  static QRegularExpressionMatch makeMatch(const QRegExp &rx, int at, int base);
+  static QRegularExpressionMatch matchOnce(const QRegExp &pattern,
+                                           bool multiline,
+                                           const QString &subject, int offset);
+  QString m_pattern;
+  PatternOptions m_options;
+  QRegExp m_rx;
+};
+Q_DECLARE_OPERATORS_FOR_FLAGS(QRegularExpression::PatternOptions)
+Q_DECLARE_OPERATORS_FOR_FLAGS(QRegularExpression::MatchOptions)
+
+class QRegularExpressionMatch {
+public:
+  QRegularExpressionMatch() : m_valid(false) {}
+
+  bool isValid() const { return m_valid; }
+  bool hasMatch() const {
+    return m_valid && !m_starts.isEmpty() && m_starts.at(0) >= 0;
+  }
+  bool hasPartialMatch() const { return false; }
+  int lastCapturedIndex() const { return m_texts.size() - 1; }
+
+  QString captured(int nth = 0) const {
+    return (nth >= 0 && nth < m_texts.size()) ? m_texts.at(nth) : QString();
+  }
+  QStringList capturedTexts() const { return m_texts; }
+  int capturedStart(int nth = 0) const {
+    return (nth >= 0 && nth < m_starts.size()) ? m_starts.at(nth) : -1;
+  }
+  int capturedLength(int nth = 0) const {
+    return (nth >= 0 && nth < m_texts.size()) ? m_texts.at(nth).length() : 0;
+  }
+  int capturedEnd(int nth = 0) const {
+    const int s = capturedStart(nth);
+    return s < 0 ? -1 : s + capturedLength(nth);
+  }
+
+private:
+  friend class QRegularExpression;
+  friend class QRegularExpressionMatchIterator;
+  bool m_valid;
+  QStringList m_texts;
+  QVector<int> m_starts;
+};
+
+class QRegularExpressionMatchIterator {
+public:
+  QRegularExpressionMatchIterator() : m_index(0) {}
+
+  bool isValid() const { return true; }
+  bool hasNext() const { return m_index < m_matches.size(); }
+  QRegularExpressionMatch next() {
+    return hasNext() ? m_matches.at(m_index++) : QRegularExpressionMatch();
+  }
+  QRegularExpressionMatch peekNext() const {
+    return hasNext() ? m_matches.at(m_index) : QRegularExpressionMatch();
+  }
+
+private:
+  friend class QRegularExpression;
+  QList<QRegularExpressionMatch> m_matches;
+  int m_index;
+};
+
+#endif // QT_VERSION < 5
+#endif // SRC_QT4_QREGULAREXPRESSION4_H_
diff --git a/src/qt4/qsavefile4.cpp b/src/qt4/qsavefile4.cpp
new file mode 100644
index 000000000..e73fb38fc
--- /dev/null
+++ b/src/qt4/qsavefile4.cpp
@@ -0,0 +1,78 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "qsavefile4.h"
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QByteArray>
+#include <QCoreApplication>
+
+#include <cstdio>
+
+#ifdef Q_OS_UNIX
+#include <unistd.h>
+#endif
+
+QSaveFile::QSaveFile(const QString &name)
+    : m_targetName(name), m_committed(false), m_directWriteFallback(false) {
+  // Temp file in the same directory so the final rename() stays on one
+  // filesystem (atomic on POSIX).
+  m_tempName = name + QLatin1String(".tmp.") +
+               QString::number(QCoreApplication::applicationPid());
+}
+
+QSaveFile::~QSaveFile() {
+  if (!m_committed) {
+    if (isOpen()) {
+      close();
+    }
+    if (QFile::exists(m_tempName)) {
+      QFile::remove(m_tempName);
+    }
+  }
+}
+
+bool QSaveFile::open(OpenMode mode) {
+  setFileName(m_tempName);
+  return QFile::open(mode);
+}
+
+bool QSaveFile::commit() {
+  if (!isOpen() || m_committed) {
+    return false;
+  }
+
+  flush();
+#ifdef Q_OS_UNIX
+  if (handle() != -1) {
+    ::fsync(handle());
+  }
+#endif
+  close();
+
+  // std::rename replaces an existing target atomically on POSIX.
+  const QByteArray from = QFile::encodeName(m_tempName);
+  const QByteArray to = QFile::encodeName(m_targetName);
+  if (std::rename(from.constData(), to.constData()) != 0) {
+    QFile::remove(m_tempName);
+    return false;
+  }
+
+  m_committed = true;
+  return true;
+}
+
+void QSaveFile::cancelWriting() {
+  if (isOpen()) {
+    close();
+  }
+  QFile::remove(m_tempName);
+}
+
+bool QSaveFile::directWriteFallback() const { return m_directWriteFallback; }
+
+void QSaveFile::setDirectWriteFallback(bool enabled) {
+  m_directWriteFallback = enabled;
+}
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
diff --git a/src/qt4/qsavefile4.h b/src/qt4/qsavefile4.h
new file mode 100644
index 000000000..3b7f45d49
--- /dev/null
