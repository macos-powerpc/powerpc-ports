diff --git a/src/qt4/QUrlQuery b/src/qt4/QUrlQuery
new file mode 100644
index 000000000..cf963e420
--- /dev/null
+++ b/src/qt4/QUrlQuery
@@ -0,0 +1,117 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef QT4_QURLQUERY_H
+#define QT4_QURLQUERY_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QList>
+#include <QPair>
+#include <QString>
+#include <QStringList>
+#include <QUrl>
+
+/**
+ * @brief Qt4 backport of QUrlQuery (Qt 5.0).
+ *
+ * Header-only; covers the surface QtPass uses (src/totp.cpp): parsing from
+ * a QUrl or a raw query string, and reading it back via hasQueryItem() /
+ * queryItemValue() / queryItems(). Backed by Qt4's own
+ * QUrl::queryItems()/QUrl::setQueryItems().
+ *
+ * queryItemValue() and queryItems() take Qt5's percent-decoding-options
+ * argument (QUrl::ComponentFormattingOptions, e.g. QUrl::FullyDecoded) as a
+ * plain int and ignore it: Qt4's QUrl has no such enum, but this class
+ * already stores fully-decoded values (see setQuery() below), so there is
+ * nothing left for an option to change.
+ */
+class QUrlQuery {
+public:
+  QUrlQuery() = default;
+  explicit QUrlQuery(const QUrl &url) : m_items(url.queryItems()) {}
+  explicit QUrlQuery(const QString &queryString) { setQuery(queryString); }
+
+  bool isEmpty() const { return m_items.isEmpty(); }
+  void clear() { m_items.clear(); }
+
+  void setQuery(const QString &queryString) {
+    m_items.clear();
+    const QStringList pairs =
+        queryString.split(QLatin1Char('&'), QString::SkipEmptyParts);
+    for (const QString &pair : pairs) {
+      const int eq = pair.indexOf(QLatin1Char('='));
+      if (eq < 0) {
+        m_items.append(
+            qMakePair(QUrl::fromPercentEncoding(pair.toLatin1()), QString()));
+      } else {
+        m_items.append(
+            qMakePair(QUrl::fromPercentEncoding(pair.left(eq).toLatin1()),
+                      QUrl::fromPercentEncoding(pair.mid(eq + 1).toLatin1())));
+      }
+    }
+  }
+
+  void addQueryItem(const QString &key, const QString &value) {
+    m_items.append(qMakePair(key, value));
+  }
+
+  bool hasQueryItem(const QString &key) const {
+    for (int i = 0; i < m_items.count(); ++i) {
+      if (m_items.at(i).first == key) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  QString queryItemValue(const QString &key, int options = 0) const {
+    Q_UNUSED(options)
+    for (int i = 0; i < m_items.count(); ++i) {
+      if (m_items.at(i).first == key) {
+        return m_items.at(i).second;
+      }
+    }
+    return QString();
+  }
+
+  void removeQueryItem(const QString &key) {
+    for (int i = 0; i < m_items.count(); ++i) {
+      if (m_items.at(i).first == key) {
+        m_items.removeAt(i);
+        return;
+      }
+    }
+  }
+
+  QList<QPair<QString, QString>> queryItems(int options = 0) const {
+    Q_UNUSED(options)
+    return m_items;
+  }
+
+  void setQueryItems(const QList<QPair<QString, QString>> &items) {
+    m_items = items;
+  }
+
+  // Fully-encoded serialization (the only formatting src/totp.cpp uses).
+  QString query() const {
+    QStringList parts;
+    for (int i = 0; i < m_items.count(); ++i) {
+      parts.append(
+          QString::fromLatin1(QUrl::toPercentEncoding(m_items.at(i).first)) +
+          QLatin1Char('=') +
+          QString::fromLatin1(QUrl::toPercentEncoding(m_items.at(i).second)));
+    }
+    return parts.join(QLatin1String("&"));
+  }
+
+  QString toString() const { return query(); }
+
+private:
+  QList<QPair<QString, QString>> m_items;
+};
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#endif // QT4_QURLQUERY_H
