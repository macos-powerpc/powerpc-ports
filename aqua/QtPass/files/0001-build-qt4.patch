--- /dev/null
+++ b/src/qt4/qmessageauthenticationcode4.cpp
@@ -0,0 +1,51 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "qmessageauthenticationcode4.h"
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include "sha2.h"
+
+#include <QCryptographicHash>
+
+namespace {
+
+QByteArray digest(QMessageAuthenticationCode::Algorithm method,
+                  const QByteArray &data) {
+  switch (method) {
+  case QMessageAuthenticationCode::Sha256:
+    return Sha2::sha256(data);
+  case QMessageAuthenticationCode::Sha512:
+    return Sha2::sha512(data);
+  case QMessageAuthenticationCode::Sha1:
+    break;
+  }
+  return QCryptographicHash::hash(data, QCryptographicHash::Sha1);
+}
+
+int blockSize(QMessageAuthenticationCode::Algorithm method) {
+  return method == QMessageAuthenticationCode::Sha512 ? 128 : 64;
+}
+
+} // namespace
+
+QByteArray QMessageAuthenticationCode::hash(const QByteArray &message,
+                                            const QByteArray &key,
+                                            Algorithm method) {
+  const int block = blockSize(method);
+  QByteArray k = key.size() > block ? digest(method, key) : key;
+  // Qt4's QByteArray::resize() leaves new bytes uninitialised: pad by hand.
+  const int used = k.size();
+  k.resize(block);
+  for (int i = used; i < block; ++i)
+    k[i] = 0;
+  QByteArray inner(block, 0);
+  QByteArray outer(block, 0);
+  for (int i = 0; i < block; ++i) {
+    inner[i] = static_cast<char>(k.at(i) ^ 0x36);
+    outer[i] = static_cast<char>(k.at(i) ^ 0x5c);
+  }
+  return digest(method, outer + digest(method, inner + message));
+}
+
+#endif // QT_VERSION < 5
