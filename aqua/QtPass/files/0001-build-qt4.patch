+
+/**
+ * @brief Qt4 stand-in for QMessageAuthenticationCode::hash() (Qt 5.1).
+ *
+ * Qt4's QCryptographicHash::Algorithm has no SHA-2 members, so the hash is
+ * selected with this class's own Algorithm enum; totp.cpp aliases it to
+ * QCryptographicHash::Algorithm on newer Qt. HMAC per RFC 2104.
+ */
+class QMessageAuthenticationCode {
+public:
+  enum Algorithm { Sha1, Sha256, Sha512 };
+
+  /**
+   * @brief HMAC of @p message under @p key.
+   * @param message Data to authenticate.
+   * @param key Secret key (any length).
+   * @param method Hash function.
+   * @return The raw MAC bytes.
+   */
+  static QByteArray hash(const QByteArray &message, const QByteArray &key,
+                         Algorithm method);
+};
