+} // namespace
+
+namespace Sha2 {
+
+QByteArray sha256(const QByteArray &data) {
+  quint32 h[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+                  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+  const unsigned char *p =
+      reinterpret_cast<const unsigned char *>(data.constData());
+  const quint64 len = static_cast<quint64>(data.size());
+  quint64 done = 0;
+  for (; done + 64 <= len; done += 64)
+    compress256(h, p + done);
+  unsigned char tail[128];
+  const int rest = static_cast<int>(len - done);
+  std::memcpy(tail, p + done, static_cast<size_t>(rest));
+  tail[rest] = 0x80;
+  const int padded = (rest < 56) ? 64 : 128;
+  std::memset(tail + rest + 1, 0, static_cast<size_t>(padded - rest - 1 - 8));
+  store64(tail + padded - 8, len * 8);
+  compress256(h, tail);
+  if (padded == 128)
+    compress256(h, tail + 64);
+  QByteArray out(32, 0);
+  for (int i = 0; i < 8; ++i)
+    store32(reinterpret_cast<unsigned char *>(out.data()) + 4 * i, h[i]);
+  return out;
+}
+
+QByteArray sha512(const QByteArray &data) {
+  quint64 h[8] = {
+      Q_UINT64_C(0x6a09e667f3bcc908), Q_UINT64_C(0xbb67ae8584caa73b),
+      Q_UINT64_C(0x3c6ef372fe94f82b), Q_UINT64_C(0xa54ff53a5f1d36f1),
+      Q_UINT64_C(0x510e527fade682d1), Q_UINT64_C(0x9b05688c2b3e6c1f),
+      Q_UINT64_C(0x1f83d9abfb41bd6b), Q_UINT64_C(0x5be0cd19137e2179)};
+  const unsigned char *p =
+      reinterpret_cast<const unsigned char *>(data.constData());
+  const quint64 len = static_cast<quint64>(data.size());
+  quint64 done = 0;
+  for (; done + 128 <= len; done += 128)
+    compress512(h, p + done);
+  unsigned char tail[256];
+  const int rest = static_cast<int>(len - done);
+  std::memcpy(tail, p + done, static_cast<size_t>(rest));
+  tail[rest] = 0x80;
+  const int padded = (rest < 112) ? 128 : 256;
+  std::memset(tail + rest + 1, 0, static_cast<size_t>(padded - rest - 1 - 16));
+  store64(tail + padded - 16, 0); // high 64 bits of the 128-bit length
+  store64(tail + padded - 8, len * 8);
+  compress512(h, tail);
+  if (padded == 256)
+    compress512(h, tail + 128);
+  QByteArray out(64, 0);
+  for (int i = 0; i < 8; ++i)
+    store64(reinterpret_cast<unsigned char *>(out.data()) + 8 * i, h[i]);
+  return out;
+}
+
+} // namespace Sha2
