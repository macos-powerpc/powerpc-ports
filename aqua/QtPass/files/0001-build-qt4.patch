@@ -0,0 +1,64 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef QT4_QSAVEFILE4_H
+#define QT4_QSAVEFILE4_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QFile>
+#include <QString>
+
+/**
+ * @brief Qt4 backport of QSaveFile (Qt 5.1).
+ *
+ * Writes into a temporary sibling file and atomically renames it over the
+ * target on commit(). Uncommitted data is discarded on destruction, so a
+ * reader of the target path never observes a partial write.
+ *
+ * Deviation from Qt5: fileName() reports the temporary file while open (no
+ * QtPass call site inspects it).
+ */
+class QSaveFile : public QFile {
+public:
+  explicit QSaveFile(const QString &name);
+  ~QSaveFile() override;
+
+  bool open(OpenMode mode) override;
+
+  /**
+   * @brief Closes the temporary file and renames it over the target.
+   * @return True if the file was open and the rename succeeded.
+   */
+  bool commit();
+
+  /**
+   * @brief Discards the temporary file without touching the target.
+   */
+  void cancelWriting();
+
+  /**
+   * @brief Whether a direct write is allowed when the safe temp+rename
+   * path is unavailable.
+   * @return The stored flag (informational only; this backport always
+   * writes through a temporary file).
+   */
+  bool directWriteFallback() const;
+
+  /**
+   * @brief Sets the direct-write-fallback flag.
+   * @param enabled New value for the flag.
+   */
+  void setDirectWriteFallback(bool enabled);
+
+private:
+  QString m_targetName;
+  QString m_tempName;
+  bool m_committed;
+  bool m_directWriteFallback;
+};
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#endif // QT4_QSAVEFILE4_H
diff --git a/src/qt4/qstandardpaths4.cpp b/src/qt4/qstandardpaths4.cpp
new file mode 100644
index 000000000..102fe4378
--- /dev/null
+++ b/src/qt4/qstandardpaths4.cpp
@@ -0,0 +1,127 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "qstandardpaths4.h"
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QByteArray>
+#include <QCoreApplication>
+#include <QDir>
+#include <QFileInfo>
+
+namespace {
+
+bool testModeEnabled = false;
+
+// The sandbox test mode redirects the per-app locations into, mirroring
+// Qt5's setTestModeEnabled(): a throwaway directory under the real temp
+// path, stable for the life of the process.
+QString testModeRoot() {
+  static const QString root =
+      QDir::tempPath() + QLatin1String("/qttest-qt4compat");
+  QDir().mkpath(root);
+  return root;
+}
+
+QString xdgOrFallback(const char *envVar, const QString &fallback) {
+  const QByteArray value = qgetenv(envVar);
+  if (!value.isEmpty()) {
+    return QString::fromLocal8Bit(value);
+  }
+  return fallback;
+}
+
+} // namespace
+
+QString QStandardPaths::writableLocation(StandardLocation type) {
+  switch (type) {
+  case HomeLocation:
+    return QDir::homePath();
+  case TempLocation:
+    return QDir::tempPath();
+  case ConfigLocation:
+  case GenericConfigLocation:
+    if (testModeEnabled) {
+      return testModeRoot() + QLatin1String("/config");
+    }
+#ifdef Q_OS_MAC
+    return QDir::homePath() + QLatin1String("/Library/Preferences");
+#else
+    return xdgOrFallback("XDG_CONFIG_HOME",
+                         QDir::homePath() + QLatin1String("/.config"));
+#endif
+  case AppConfigLocation: {
+    const QString base = writableLocation(GenericConfigLocation);
+    const QString app = QCoreApplication::applicationName();
+    return app.isEmpty() ? base : base + QLatin1Char('/') + app;
+  }
+  case GenericDataLocation:
+    if (testModeEnabled) {
+      return testModeRoot() + QLatin1String("/data");
+    }
+#ifdef Q_OS_MAC
+    return QDir::homePath() + QLatin1String("/Library/Application Support");
+#else
+    return xdgOrFallback("XDG_DATA_HOME",
+                         QDir::homePath() + QLatin1String("/.local/share"));
+#endif
+  case AppDataLocation: {
+    const QString base = writableLocation(GenericDataLocation);
+    const QString app = QCoreApplication::applicationName();
+    return app.isEmpty() ? base : base + QLatin1Char('/') + app;
+  }
+  case CacheLocation: {
+    QString base;
+    if (testModeEnabled) {
+      base = testModeRoot() + QLatin1String("/cache");
+    } else {
+#ifdef Q_OS_MAC
+      base = QDir::homePath() + QLatin1String("/Library/Caches");
+#else
+      base = xdgOrFallback("XDG_CACHE_HOME",
+                           QDir::homePath() + QLatin1String("/.cache"));
+#endif
+    }
+    const QString app = QCoreApplication::applicationName();
+    return app.isEmpty() ? base : base + QLatin1Char('/') + app;
+  }
+  case DocumentsLocation:
+    return QDir::homePath() + QLatin1String("/Documents");
+  }
+  return QString();
+}
+
+void QStandardPaths::setTestModeEnabled(bool enabled) {
+  testModeEnabled = enabled;
+}
+
+QString QStandardPaths::findExecutable(const QString &executableName,
+                                       const QStringList &paths) {
+  if (executableName.isEmpty()) {
+    return QString();
+  }
+
+  const QFileInfo candidateInfo(executableName);
+  if (candidateInfo.isAbsolute()) {
+    return candidateInfo.isFile() && candidateInfo.isExecutable()
+               ? candidateInfo.absoluteFilePath()
+               : QString();
+  }
+
+  QStringList searchPaths = paths;
+  if (searchPaths.isEmpty()) {
+    const QByteArray pathEnv = qgetenv("PATH");
+    searchPaths = QString::fromLocal8Bit(pathEnv).split(
+        QLatin1Char(':'), QString::SkipEmptyParts);
+  }
+
+  for (int i = 0; i < searchPaths.count(); ++i) {
+    const QFileInfo info(QDir(searchPaths.at(i)), executableName);
+    if (info.isFile() && info.isExecutable()) {
+      return info.absoluteFilePath();
+    }
+  }
+  return QString();
+}
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
diff --git a/src/qt4/qstandardpaths4.h b/src/qt4/qstandardpaths4.h
