diff --git a/src/qt4/qrandomgenerator4.cpp b/src/qt4/qrandomgenerator4.cpp
new file mode 100644
index 000000000..5b46686d1
--- /dev/null
+++ b/src/qt4/qrandomgenerator4.cpp
@@ -0,0 +1,67 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "qrandomgenerator4.h"
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <cerrno>
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+
+namespace {
+
+// Reads raw entropy from /dev/urandom (present on every target: Linux,
+// macOS 10.6+). This feeds password generation, so any failure is fatal
+// rather than a silent fallback to a weak PRNG.
+void systemRandom(void *buf, size_t len) {
+  std::FILE *f = std::fopen("/dev/urandom", "rb");
+  if (f == nullptr) {
+    qFatal("QRandomGenerator: cannot open /dev/urandom: %s",
+           std::strerror(errno));
+  }
+  const size_t read = std::fread(buf, 1, len, f);
+  std::fclose(f);
+  if (read != len) {
+    qFatal("QRandomGenerator: short read from /dev/urandom");
+  }
+}
+
+} // namespace
+
+QRandomGenerator *QRandomGenerator::system() {
+  static QRandomGenerator instance;
+  return &instance;
+}
+
+quint32 QRandomGenerator::generate() {
+  quint32 v;
+  systemRandom(&v, sizeof(v));
+  return v;
+}
+
+quint64 QRandomGenerator::generate64() {
+  return (quint64(generate()) << 32) | quint64(generate());
+}
+
+quint32 QRandomGenerator::bounded(quint32 highest) {
+  if (highest == 0) {
+    return 0;
+  }
+  // Rejection sampling to avoid modulo bias.
+  const quint32 limit = (0xFFFFFFFFu / highest) * highest;
+  quint32 v;
+  do {
+    v = generate();
+  } while (v >= limit);
+  return v % highest;
+}
+
+quint32 QRandomGenerator::bounded(quint32 lowest, quint32 highest) {
+  if (highest <= lowest) {
+    return lowest;
+  }
+  return lowest + bounded(highest - lowest);
+}
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
