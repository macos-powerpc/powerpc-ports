@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef QT4_QSTANDARDPATHS4_H
+#define QT4_QSTANDARDPATHS4_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QString>
+#include <QStringList>
+
+/**
+ * @brief Qt4 backport of QStandardPaths (Qt 5.0).
+ *
+ * Covers the subset QtPass uses: writableLocation() for a handful of
+ * locations, setTestModeEnabled() (redirects the per-app locations under a
+ * throwaway directory the way Qt5's does, for the test suite), and
+ * findExecutable() (a PATH search). XDG-based on Unix, ~/Library/... on
+ * Q_OS_MAC.
+ */
+class QStandardPaths {
+public:
+  enum StandardLocation {
+    HomeLocation,
+    TempLocation,
+    ConfigLocation,
+    GenericConfigLocation,
+    AppConfigLocation,
+    AppDataLocation,
+    GenericDataLocation,
+    CacheLocation,
+    DocumentsLocation
+  };
+
+  static QString writableLocation(StandardLocation type);
+
+  /**
+   * @brief Redirects the per-app locations under a throwaway directory.
+   * @param enabled New state; disabling restores the real locations.
+   */
+  static void setTestModeEnabled(bool enabled);
+
+  /**
+   * @brief Searches PATH (or the given directories) for an executable.
+   * @param executableName Bare name to look for.
+   * @param paths Directories to search; PATH when empty.
+   * @return The first matching, executable file found, or an empty string.
+   */
+  static QString findExecutable(const QString &executableName,
+                                const QStringList &paths = QStringList());
+};
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#endif // QT4_QSTANDARDPATHS4_H
diff --git a/src/qt4/qt4compat.h b/src/qt4/qt4compat.h
new file mode 100644
index 000000000..efdfc1729
--- /dev/null
+++ b/src/qt4/qt4compat.h
@@ -0,0 +1,69 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef QT4_QT4COMPAT_H
+#define QT4_QT4COMPAT_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QByteArray>
+#include <QString>
+
+#include <cstddef>
+#include <cstdlib>
+
+// Q_OS_MACOS (Qt 5.9 spelling of Q_OS_MAC). The codebase uses the modern
+// name in #if blocks; without the alias those branches silently compile
+// away on Mac.
+#if defined(Q_OS_MAC) && !defined(Q_OS_MACOS)
+#define Q_OS_MACOS
+#endif
+
+// qsizetype (Qt 5.10). Qt4 container/indexOf APIs are int-based, so
+// ptrdiff_t is wider than anything that gets stored in one here.
+typedef std::ptrdiff_t qsizetype;
+
+// QStringLiteral (Qt 5.0). fromUtf8 keeps source-encoding semantics
+// identical to Qt6 (the codebase has UTF-8 literals); the "" str "" trick
+// keeps it failing on non-literal arguments, like the real macro.
+#ifndef QStringLiteral
+#define QStringLiteral(str) QString::fromUtf8("" str "", int(sizeof(str)) - 1)
+#endif
+
+// Qt::SkipEmptyParts / Qt::KeepEmptyParts (Qt 5.14) - every use in the
+// codebase is a QString::split() argument, so QString::SplitBehavior values
+// under the Qt names are a drop-in.
+namespace Qt {
+static const QString::SplitBehavior SkipEmptyParts = QString::SkipEmptyParts;
+static const QString::SplitBehavior KeepEmptyParts = QString::KeepEmptyParts;
+} // namespace Qt
+
+// qEnvironmentVariable (Qt 5.10 semantics): returns the default when the
+// variable is unset. qgetenv() already exists on Qt4.
+inline QString qEnvironmentVariable(const char *name) {
+  return QString::fromLocal8Bit(qgetenv(name));
+}
+
+inline QString qEnvironmentVariable(const char *name,
+                                    const QString &defaultValue) {
+  if (::getenv(name) == nullptr) {
+    return defaultValue;
+  }
+  return QString::fromLocal8Bit(qgetenv(name));
+}
+
+// qEnvironmentVariableIsSet / qEnvironmentVariableIsEmpty (Qt 5.1). IsSet
+// uses ::getenv() directly so a variable that is set but empty is still
+// reported as set.
+inline bool qEnvironmentVariableIsSet(const char *name) {
+  return ::getenv(name) != nullptr;
+}
+
+inline bool qEnvironmentVariableIsEmpty(const char *name) {
+  return qgetenv(name).isEmpty();
+}
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#endif // QT4_QT4COMPAT_H
diff --git a/src/qt4/qtemporarydir4.cpp b/src/qt4/qtemporarydir4.cpp
new file mode 100644
index 000000000..2164ed914
--- /dev/null
+++ b/src/qt4/qtemporarydir4.cpp
@@ -0,0 +1,102 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "qtemporarydir4.h"
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QByteArray>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QFileInfoList>
+
+#include <cerrno>
+#include <cstring>
+#include <stdlib.h> // mkdtemp is POSIX, not std C - not guaranteed via <cstdlib>
+#include <unistd.h> // ...and on BSD/Darwin (unlike glibc) it's declared here, not stdlib.h
+
+namespace {
+
+// QDir::removeRecursively (Qt 5.0) has no Qt4 equivalent, and shimming the
+// QDir class itself risks corrupting other Qt4 headers' view of QDir in the
+// same translation unit (QFileInfo::dir()/absoluteDir() return it by
+// value). Kept as a file-local helper instead, the only caller being
+// QTemporaryDir::remove() below.
+bool removeDirRecursively(const QDir &dir) {
+  bool ok = true;
+  const QFileInfoList entries = dir.entryInfoList(
+      QDir::AllEntries | QDir::Hidden | QDir::System | QDir::NoDotAndDotDot);
+  for (int i = 0; i < entries.count(); ++i) {
+    const QFileInfo &info = entries.at(i);
+    if (info.isDir() && !info.isSymLink()) {
+      ok = removeDirRecursively(QDir(info.absoluteFilePath())) && ok;
+    } else {
+      ok = QFile::remove(info.absoluteFilePath()) && ok;
+    }
+  }
+  return QDir().rmdir(dir.absolutePath()) && ok;
+}
+
+} // namespace
+
+QTemporaryDir::QTemporaryDir() : m_autoRemove(true) {
+  create(QDir::tempPath() + QLatin1String("/qt_temp.XXXXXX"));
+}
+
+QTemporaryDir::QTemporaryDir(const QString &templateName) : m_autoRemove(true) {
+  QString tpl = templateName;
+  if (!tpl.endsWith(QLatin1String("XXXXXX"))) {
+    tpl += QLatin1String(".XXXXXX");
+  }
+  create(tpl);
+}
+
+QTemporaryDir::~QTemporaryDir() {
+  if (m_autoRemove) {
+    remove();
+  }
+}
+
+void QTemporaryDir::create(const QString &templatePath) {
+  QByteArray tpl = QFile::encodeName(templatePath);
+  if (::mkdtemp(tpl.data()) != nullptr) {
+    m_path = QFile::decodeName(tpl.constData());
+    m_errorString.clear();
+  } else {
+    m_errorString = QString::fromLocal8Bit(std::strerror(errno));
+  }
+}
+
+bool QTemporaryDir::isValid() const { return !m_path.isEmpty(); }
+
+QString QTemporaryDir::path() const { return m_path; }
+
+QString QTemporaryDir::filePath(const QString &fileName) const {
+  if (m_path.isEmpty()) {
+    return QString();
+  }
+  return m_path + QLatin1Char('/') + fileName;
+}
+
+bool QTemporaryDir::autoRemove() const { return m_autoRemove; }
+
+void QTemporaryDir::setAutoRemove(bool autoRemove) {
+  m_autoRemove = autoRemove;
+}
+
+bool QTemporaryDir::remove() {
+  if (!isValid()) {
+    return false;
+  }
+  const bool ok = removeDirRecursively(QDir(m_path));
+  if (ok) {
+    m_path.clear();
+  } else {
+    m_errorString = QStringLiteral("Failed to remove temporary directory");
+  }
+  return ok;
+}
+
+QString QTemporaryDir::errorString() const { return m_errorString; }
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
diff --git a/src/qt4/qtemporarydir4.h b/src/qt4/qtemporarydir4.h
new file mode 100644
index 000000000..d7abe027f
--- /dev/null
+++ b/src/qt4/qtemporarydir4.h
@@ -0,0 +1,62 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef QT4_QTEMPORARYDIR4_H
+#define QT4_QTEMPORARYDIR4_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QString>
+
+/**
+ * @brief Qt4 backport of QTemporaryDir (Qt 5.0).
+ *
+ * A unique directory created with mkdtemp(3), removed recursively on
+ * destruction unless setAutoRemove(false) was called. POSIX-only, like
+ * every other target of this port.
+ */
+class QTemporaryDir {
+public:
+  QTemporaryDir();
+  explicit QTemporaryDir(const QString &templateName);
+  ~QTemporaryDir();
+  QTemporaryDir(const QTemporaryDir &) = delete;
+  QTemporaryDir &operator=(const QTemporaryDir &) = delete;
+
+  bool isValid() const;
+  QString path() const;
+
+  /**
+   * @brief Builds a path inside this directory.
+   * @param fileName Name to append.
+   * @return path() + '/' + fileName, or an empty string if !isValid().
+   */
+  QString filePath(const QString &fileName) const;
+
+  bool autoRemove() const;
+  void setAutoRemove(bool autoRemove);
+
+  /**
+   * @brief Removes the directory and its contents immediately.
+   * @return True on success, or if the directory was already gone.
+   */
+  bool remove();
+
+  /**
+   * @brief Describes why construction or remove() failed.
+   * @return An empty string when the last such operation succeeded.
+   */
+  QString errorString() const;
+
+private:
+  void create(const QString &templatePath);
+
+  QString m_path;
+  QString m_errorString;
+  bool m_autoRemove;
+};
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#endif // QT4_QTEMPORARYDIR4_H
diff --git a/src/qt4/qtestcompat.h b/src/qt4/qtestcompat.h
new file mode 100644
index 000000000..62b274e3f
--- /dev/null
+++ b/src/qt4/qtestcompat.h
@@ -0,0 +1,186 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef QT4_QTESTCOMPAT_H
+#define QT4_QTESTCOMPAT_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+// Force-included into every test translation unit for the Qt4 build (after
+// qmake's own -include of qt4compat.h). Included before anything else in
+// the test source, so pull in QtTest ourselves: QSKIP below redefines a
+// macro QtTest's own headers declare, and the QTRY_* macros build on
+// QVERIFY/QCOMPARE/QTest::qWait, all from <QtTest>.
+#include <QtTest>
+
+#include <QPair>
+#include <QRegularExpression>
+#include <QVector>
+
+namespace qt4compattest {
+
+// Shared poll loop behind every QTRY_* macro below: re-check the condition
+// every 50 ms (Qt5's own QTRY_* step) until it holds or timeoutMs elapses.
+template <typename Predicate>
+inline void waitFor(Predicate predicate, int timeoutMs) {
+  int elapsed = 0;
+  while (!predicate() && elapsed < timeoutMs) {
+    QTest::qWait(50);
+    // Qt5's qWait() flushes deferred deletes; Qt4's does not, and outside
+    // exec() they would otherwise never run.
+    QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
+    elapsed += 50;
+  }
+}
+
+} // namespace qt4compattest
+
+// QTRY_VERIFY / QTRY_VERIFY2 / QTRY_COMPARE (+ _WITH_TIMEOUT) (Qt 5.0):
+// poll, then re-run the plain assertion so a failure reports normally
+// (expression text, file/line) via Qt4's own QVERIFY/QVERIFY2/QCOMPARE.
+#define QTRY_VERIFY_WITH_TIMEOUT(cond, timeoutMs)                              \
+  do {                                                                         \
+    qt4compattest::waitFor([&]() { return bool(cond); }, (timeoutMs));         \
+    QVERIFY(cond);                                                             \
+  } while (false)
+
+#define QTRY_VERIFY(cond) QTRY_VERIFY_WITH_TIMEOUT((cond), 5000)
+
+#define QTRY_VERIFY2_WITH_TIMEOUT(cond, msg, timeoutMs)                        \
+  do {                                                                         \
+    qt4compattest::waitFor([&]() { return bool(cond); }, (timeoutMs));         \
+    QVERIFY2(cond, msg);                                                       \
+  } while (false)
+
+#define QTRY_VERIFY2(cond, msg) QTRY_VERIFY2_WITH_TIMEOUT((cond), (msg), 5000)
+
+#define QTRY_COMPARE_WITH_TIMEOUT(actual, expected, timeoutMs)                 \
+  do {                                                                         \
+    qt4compattest::waitFor([&]() { return (actual) == (expected); },           \
+                           (timeoutMs));                                       \
+    QCOMPARE(actual, expected);                                                \
+  } while (false)
+
+#define QTRY_COMPARE(actual, expected)                                         \
+  QTRY_COMPARE_WITH_TIMEOUT(actual, expected, 5000)
+
+// QSKIP (Qt5's one-argument form; Qt4's own macro is QSKIP(statement,
+// mode)). Every call site in this codebase already uses the one-arg form.
+#undef QSKIP
+#define QSKIP(description)                                                     \
+  do {                                                                         \
+    QTest::qSkip(description, QTest::SkipAll, __FILE__, __LINE__);             \
+    return;                                                                    \
+  } while (false)
+
+// QCOMPARE_EQ/NE/LT/GT/LE/GE (Qt 6.4): Qt4's qtestcase.h has no
+// diagnostic-printing qCompare() overloads for ordering comparisons, so
+// these fall back to plain QVERIFY (still reports file/line on failure,
+// just not both operands' values).
+// QCOMPARE(pointer, nullptr): Qt4's testlib predates std::nullptr_t and has no
+// qCompare overload for it, so such comparisons fail to link.
+#include <cstddef>
+namespace QTest {
+template <typename T>
+inline bool qCompare(T *const &t1, std::nullptr_t const &, const char *actual,
+                     const char *expected, const char *file, int line) {
+  return compare_ptr_helper(t1, 0, actual, expected, file, line);
+}
+template <typename T>
+inline bool qCompare(std::nullptr_t const &, T *const &t2, const char *actual,
+                     const char *expected, const char *file, int line) {
+  return compare_ptr_helper(0, t2, actual, expected, file, line);
+}
+} // namespace QTest
+
+#define QCOMPARE_EQ(a, b) QVERIFY((a) == (b))
+#define QCOMPARE_NE(a, b) QVERIFY((a) != (b))
+#define QCOMPARE_LT(a, b) QVERIFY((a) < (b))
+#define QCOMPARE_GT(a, b) QVERIFY((a) > (b))
+#define QCOMPARE_LE(a, b) QVERIFY((a) <= (b))
+#define QCOMPARE_GE(a, b) QVERIFY((a) >= (b))
+
+// QTEST_SET_MAIN_SOURCE_PATH (Qt 5.0) records the source path for
+// QFINDTESTDATA; Qt4 has neither, and no test here looks up test data.
+#define QTEST_SET_MAIN_SOURCE_PATH
+
+// QTest::ignoreMessage(QtMsgType, const QRegularExpression &) (Qt 5.3).
+// Qt4's testlib can only ignore an exact message, so the pattern form is
+// implemented with a chained message handler that swallows the first message
+// of that type matching the pattern. Unlike Qt5's, a pattern that never
+// matches does not fail the test; the warning simply stays in the log.
+namespace qt4compattest {
+
+inline QVector<QPair<int, QRegularExpression>> &ignoredPatterns() {
+  static QVector<QPair<int, QRegularExpression>> patterns;
+  return patterns;
+}
+
+inline QtMsgHandler &chainedHandler() {
+  static QtMsgHandler handler = 0;
+  return handler;
+}
+
+inline void ignoringMessageHandler(QtMsgType type, const char *message) {
+  QVector<QPair<int, QRegularExpression>> &patterns = ignoredPatterns();
+  const QString text = QString::fromLocal8Bit(message);
+  for (int i = 0; i < patterns.size(); ++i) {
+    if (patterns.at(i).first == int(type) &&
+        patterns.at(i).second.match(text).hasMatch()) {
+      patterns.remove(i);
+      return;
+    }
+  }
+  if (chainedHandler() != 0) {
+    chainedHandler()(type, message);
+  }
+}
+
+} // namespace qt4compattest
+
+namespace QTest {
+
+inline void ignoreMessage(QtMsgType type, const QRegularExpression &pattern) {
+  static bool installed = false;
+  if (!installed) {
+    // Installed after testlib's own handler, so unmatched messages still
+    // reach it and keep being logged and matched against exact ignores.
+    qt4compattest::chainedHandler() =
+        qInstallMsgHandler(qt4compattest::ignoringMessageHandler);
+    installed = true;
+  }
+  qt4compattest::ignoredPatterns().append(qMakePair(int(type), pattern));
+}
+
+// qWaitFor (Qt 5.10): poll a predicate until it returns true or the
+// timeout expires.
+template <typename Functor>
+inline bool qWaitFor(Functor predicate, int timeout = 5000) {
+  int elapsed = 0;
+  while (!predicate() && elapsed < timeout) {
+    QTest::qWait(50);
+    QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
+    elapsed += 50;
+  }
+  return predicate();
+}
+
+// qWaitForWindowExposed / qWaitForWindowActive (Qt 5.0): Qt4 only has
+// qWaitForWindowShown, which is good enough for what the test suite checks
+// (the window has been mapped by the window manager).
+inline bool qWaitForWindowExposed(QWidget *widget, int timeout = 5000) {
+  Q_UNUSED(timeout)
+  return QTest::qWaitForWindowShown(widget);
+}
+
+inline bool qWaitForWindowActive(QWidget *widget, int timeout = 5000) {
+  Q_UNUSED(timeout)
+  return QTest::qWaitForWindowShown(widget);
+}
+
+} // namespace QTest
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#endif // QT4_QTESTCOMPAT_H
