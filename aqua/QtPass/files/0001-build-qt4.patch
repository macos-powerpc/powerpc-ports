diff --git a/src/qt4/QScopeGuard b/src/qt4/QScopeGuard
new file mode 100644
index 000000000..b4d333acc
--- /dev/null
+++ b/src/qt4/QScopeGuard
@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef SRC_QT4_QSCOPEGUARD_H_
+#define SRC_QT4_QSCOPEGUARD_H_
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <type_traits>
+#include <utility>
+
+/**
+ * @brief Qt4 stand-in for QScopeGuard / qScopeGuard() (Qt 5.12).
+ *
+ * Runs the stored callable when the guard goes out of scope unless
+ * dismiss() was called first.
+ */
+template <typename F> class QScopeGuard {
+public:
+  /** @brief Take ownership of @p f. */
+  explicit QScopeGuard(F &&f) : m_func(std::move(f)) {}
+  /** @brief Copy @p f. */
+  explicit QScopeGuard(const F &f) : m_func(f) {}
+  /** @brief Transfer the pending call from @p other. */
+  QScopeGuard(QScopeGuard &&other) noexcept
+      : m_func(std::move(other.m_func)), m_invoke(other.m_invoke) {
+    other.dismiss();
+  }
+  ~QScopeGuard() {
+    if (m_invoke)
+      m_func();
+  }
+  /** @brief Cancel the pending call. */
+  void dismiss() noexcept { m_invoke = false; }
+
+private:
+  QScopeGuard(const QScopeGuard &) = delete;
+  QScopeGuard &operator=(const QScopeGuard &) = delete;
+  F m_func;
+  bool m_invoke = true;
+};
+
+/**
+ * @brief Build a QScopeGuard around @p f.
+ * @param f Callable to run at scope exit.
+ * @return The guard; keep it in a named local.
+ */
+template <typename F>
+QScopeGuard<typename std::decay<F>::type> qScopeGuard(F &&f) {
+  return QScopeGuard<typename std::decay<F>::type>(std::forward<F>(f));
+}
+
+#endif // QT_VERSION < 5
+#endif // SRC_QT4_QSCOPEGUARD_H_
diff --git a/src/qt4/QSignalBlocker b/src/qt4/QSignalBlocker
new file mode 100644
index 000000000..e6ff8c6bd
--- /dev/null
+++ b/src/qt4/QSignalBlocker
@@ -0,0 +1,66 @@
+// SPDX-FileCopyrightText: 2026 Sergey Fedorov
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef QT4_QSIGNALBLOCKER_H
+#define QT4_QSIGNALBLOCKER_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QObject>
+
+/**
+ * @brief Qt4 backport of QSignalBlocker (Qt 5.3).
+ *
+ * RAII signal blocking: blocks signals on construction, restoring whatever
+ * state they were in beforehand on destruction (or immediately via
+ * unblock() / reblock()).
+ */
+class QSignalBlocker {
+public:
+  explicit QSignalBlocker(QObject *object)
+      : m_object(object), m_blocked(false), m_inhibited(false) {
+    if (m_object != nullptr) {
+      m_blocked = m_object->blockSignals(true);
+    }
+  }
+  explicit QSignalBlocker(QObject &object) : QSignalBlocker(&object) {}
+
+  ~QSignalBlocker() {
+    if (m_object != nullptr && !m_inhibited) {
+      m_object->blockSignals(m_blocked);
+    }
+  }
+
+  QSignalBlocker(const QSignalBlocker &) = delete;
+  QSignalBlocker &operator=(const QSignalBlocker &) = delete;
+
+  /**
+   * @brief Re-blocks signals after unblock(), or extends the block.
+   */
+  void reblock() {
+    if (m_object != nullptr) {
+      m_object->blockSignals(true);
+    }
+    m_inhibited = false;
+  }
+
+  /**
+   * @brief Restores the pre-construction blocked state immediately.
+   */
+  void unblock() {
+    if (m_object != nullptr) {
+      m_object->blockSignals(m_blocked);
+    }
+    m_inhibited = true;
+  }
+
+private:
+  QObject *m_object;
+  bool m_blocked;
+  bool m_inhibited;
+};
+
+#endif // QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#endif // QT4_QSIGNALBLOCKER_H
