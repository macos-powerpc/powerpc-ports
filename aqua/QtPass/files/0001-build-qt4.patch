+/**
+ * @brief `override` for virtuals that only exist from Qt 5 on.
+ *
+ * QAbstractItemModel::canDropMimeData() and supportedDragActions() are plain
+ * members in Qt4; marking them `override` there is an error, leaving the
+ * keyword off on Qt 5/6 would lose the check.
+ */
+#if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0)
+#define QTPASS_QT5_OVERRIDE override
+#else
+#define QTPASS_QT5_OVERRIDE
+#endif
+
+/**
+ * @brief QString::toHtmlEscaped() (Qt 5.0) for every supported Qt.
+ * @param plain Text to escape.
+ * @return @p plain with `<`, `>`, `&` and `"` replaced by entities.
+ */
+inline auto htmlEscaped(const QString &plain) -> QString {
+#if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0)
+  return plain.toHtmlEscaped();
+#else
+  QString rich;
+  rich.reserve(int(plain.length() * 1.1));
+  for (int i = 0; i < plain.length(); ++i) {
+    const QChar c = plain.at(i);
+    if (c == QLatin1Char('<'))
+      rich += QLatin1String("&lt;");
+    else if (c == QLatin1Char('>'))
+      rich += QLatin1String("&gt;");
+    else if (c == QLatin1Char('&'))
+      rich += QLatin1String("&amp;");
+    else if (c == QLatin1Char('"'))
+      rich += QLatin1String("&quot;");
+    else
+      rich += c;
+  }
+  return rich;
+#endif
+}
+
 #endif // SRC_QTCOMPAT_H_
