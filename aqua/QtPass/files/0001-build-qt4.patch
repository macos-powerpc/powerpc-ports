+void compress256(quint32 h[8], const unsigned char *block) {
+  quint32 w[64];
+  for (int i = 0; i < 16; ++i)
+    w[i] = load32(block + 4 * i);
+  for (int i = 16; i < 64; ++i) {
+    const quint32 s0 =
+        rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
+    const quint32 s1 =
+        rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
+    w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+  }
+  quint32 a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6],
+          hh = h[7];
+  for (int i = 0; i < 64; ++i) {
+    const quint32 S1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
+    const quint32 ch = (e & f) ^ (~e & g);
+    const quint32 t1 = hh + S1 + ch + K256[i] + w[i];
+    const quint32 S0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
+    const quint32 maj = (a & b) ^ (a & c) ^ (b & c);
+    const quint32 t2 = S0 + maj;
+    hh = g;
+    g = f;
+    f = e;
+    e = d + t1;
+    d = c;
+    c = b;
+    b = a;
+    a = t1 + t2;
+  }
+  h[0] += a;
+  h[1] += b;
+  h[2] += c;
+  h[3] += d;
+  h[4] += e;
+  h[5] += f;
+  h[6] += g;
+  h[7] += hh;
+}
+
+void compress512(quint64 h[8], const unsigned char *block) {
+  quint64 w[80];
+  for (int i = 0; i < 16; ++i)
+    w[i] = load64(block + 8 * i);
+  for (int i = 16; i < 80; ++i) {
+    const quint64 s0 =
+        rotr64(w[i - 15], 1) ^ rotr64(w[i - 15], 8) ^ (w[i - 15] >> 7);
+    const quint64 s1 =
+        rotr64(w[i - 2], 19) ^ rotr64(w[i - 2], 61) ^ (w[i - 2] >> 6);
+    w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+  }
+  quint64 a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6],
+          hh = h[7];
+  for (int i = 0; i < 80; ++i) {
+    const quint64 S1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
+    const quint64 ch = (e & f) ^ (~e & g);
+    const quint64 t1 = hh + S1 + ch + K512[i] + w[i];
+    const quint64 S0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
+    const quint64 maj = (a & b) ^ (a & c) ^ (b & c);
+    const quint64 t2 = S0 + maj;
+    hh = g;
+    g = f;
+    f = e;
+    e = d + t1;
+    d = c;
+    c = b;
+    b = a;
+    a = t1 + t2;
+  }
+  h[0] += a;
+  h[1] += b;
+  h[2] += c;
+  h[3] += d;
+  h[4] += e;
+  h[5] += f;
+  h[6] += g;
+  h[7] += hh;
+}
