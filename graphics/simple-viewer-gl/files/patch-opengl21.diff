diff --git third-party/glad/CMakeLists.txt third-party/glad/CMakeLists.txt
index 5b8bedc..aeea824 100644
--- third-party/glad/CMakeLists.txt
+++ third-party/glad/CMakeLists.txt
@@ -1,6 +1,53 @@
 cmake_minimum_required(VERSION 3.22)
 project(GLAD C)
 
-add_library(GLAD STATIC src/glad.c)
-target_include_directories(GLAD PUBLIC include)
+# The OpenGL loader is generated at build time by the glad Python package
+# (https://github.com/Dav1dde/glad), so no generated sources are kept in the
+# tree. --reproducible keeps the generator offline: glad ships the Khronos
+# specifications it needs.
+
+find_package(Python3 COMPONENTS Interpreter REQUIRED)
+
+execute_process(
+    COMMAND ${Python3_EXECUTABLE} -c "import glad; print(glad.__version__)"
+    RESULT_VARIABLE GLAD_IMPORT_RESULT
+    OUTPUT_VARIABLE GLAD_VERSION
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    ERROR_QUIET
+    )
+
+if(NOT GLAD_IMPORT_RESULT EQUAL 0 OR GLAD_VERSION VERSION_LESS 2.0)
+    message(FATAL_ERROR
+        "glad >= 2.0 (the glad2 Python package) is required to generate the "
+        "OpenGL loader, found: '${GLAD_VERSION}'. Install it with "
+        "'pip install glad2' (Debian/Ubuntu: python3-glad2, "
+        "MacPorts: py3X-glad2), or point CMake at another interpreter with "
+        "-DPython3_EXECUTABLE=..."
+        )
+endif()
+
+set(GLAD_OUT_DIR ${CMAKE_CURRENT_BINARY_DIR}/generated)
+set(GLAD_SOURCE ${GLAD_OUT_DIR}/src/gl.c)
+set(GLAD_HEADER ${GLAD_OUT_DIR}/include/glad/gl.h)
+
+# OpenGL 3.3 with the compatibility profile: the Core path uses GLSL 330, the
+# OpenGL 2.x fallback needs the luminance formats and, where vertex array and
+# framebuffer objects are not core, the ARB/EXT entry points.
+add_custom_command(
+    OUTPUT ${GLAD_SOURCE} ${GLAD_HEADER}
+    COMMAND ${Python3_EXECUTABLE} -m glad
+            --out-path=${GLAD_OUT_DIR}
+            --quiet
+            --reproducible
+            --api=gl:compatibility=3.3
+            --extensions=GL_ARB_framebuffer_object,GL_ARB_vertex_array_object,GL_EXT_framebuffer_object
+            c --loader
+    COMMENT "Generating OpenGL loader with glad ${GLAD_VERSION}"
+    VERBATIM
+    )
+
+add_library(GLAD STATIC ${GLAD_SOURCE})
+target_include_directories(GLAD PUBLIC ${GLAD_OUT_DIR}/include)
 target_compile_options(GLAD PRIVATE -Wno-pedantic)
+
+set(GLAD_INCLUDE_DIR ${GLAD_OUT_DIR}/include PARENT_SCOPE)
