+void render::detectCapabilities()
+{
+    // GLSL 330 needs a 3.3 context; anything older uses the GLSL 110 path.
+    LegacyGL = GLAD_GL_VERSION_3_3 == 0;
+
+    // Version and extension flags decide, not the entry points: glX/egl
+    // getProcAddress happily returns pointers for unsupported functions.
+
+    // Core since 3.0, otherwise ARB_vertex_array_object. Plain OpenGL 2.x
+    // has neither, so the vertex layout is re-specified on every frame.
+    VaoSupported = (GLAD_GL_VERSION_3_0 || GLAD_GL_ARB_vertex_array_object)
+        && glGenVertexArrays != nullptr
+        && glBindVertexArray != nullptr
+        && glDeleteVertexArrays != nullptr;
+
+    if ((GLAD_GL_VERSION_3_0 || GLAD_GL_ARB_framebuffer_object) && glGenFramebuffers != nullptr)
+    {
+        FboSupport = eFboSupport::Core;
+    }
+    else if (GLAD_GL_EXT_framebuffer_object && glGenFramebuffersEXT != nullptr)
+    {
+        FboSupport = eFboSupport::Ext;
+    }
+    else
+    {
+        FboSupport = eFboSupport::None;
+    }
+
+    // Detection is idempotent and may run more than once for the same
+    // context, so only the first pass reports what it found.
+    if (Reported)
+    {
+        return;
+    }
+    Reported = true;
+
+    if (LegacyGL)
+    {
+        cLog::Info("Legacy OpenGL context: using GLSL 110{}.",
+                   VaoSupported ? "" : ", no vertex array objects");
+    }
+
+    if (FboSupport == eFboSupport::None)
+    {
+        cLog::Warning("No framebuffer objects available, pixel info will be unavailable.");
+    }
+}
