# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               conflicts_build 1.0
PortGroup               github 1.0
PortGroup               legacysupport 1.1

# CLOCK_REALTIME
legacysupport.newest_darwin_requires_legacy 15

github.setup            reybits simple-viewer-gl 3.3.7 v
revision                0
categories              graphics gnome
license                 GPL-2
maintainers             {@barracuda156 macos-powerpc.org:barracuda} openmaintainer

description             Simple Viewer GL is a simple and tiny image viewer
long_description        {*}${description} based on OpenGL.
homepage                https://www.ugolnik.info/simple-viewer-gl
checksums               rmd160  77a4c0e40d80401791d30e6d89ebb6e7ef90e1ea \
                        sha256  76a591a0cf16b5890110dca45de20606baf4afe1f88c58d92a46e55e2f67c8d6 \
                        size    17232687
github.tarball_from     archive

cmake.build_type        Release

# -pedantic-errors rejects GCC's Objective-C output, and the hardcoded -O2
# overrides configure.optflags.
patchfiles              patch-no-pedantic.diff

# https://github.com/reybits/simple-viewer-gl/issues/8
# Upstream compiles the delegate out entirely unless the compiler is clang,
# which silently drops drag-and-drop. Rewrite it in Objective-C that GCC and
# the legacy runtime accept instead, so the feature is kept.
patchfiles-append       patch-objc-gcc.diff

# Fix a regression in upstream: https://github.com/reybits/simple-viewer-gl/issues/35
# Upstream requires an OpenGL 3.3 Core context and GLSL 3.30 since 3.3.0.
# PowerPC hardware, and Mac OS X up to 10.6 in general, stops at OpenGL 2.1,
# so glfwCreateWindow would fail outright. Fall back to a 2.1 context and
# a GLSL 1.20 render path when 3.3 Core is refused.
patchfiles-append       patch-opengl21.diff

# https://github.com/reybits/simple-viewer-gl/issues/6
conflicts_build         mesa

compiler.cxx_standard   2017

set python_ver          3.14
set python_branch       [string map {. {}} ${python_ver}]

# TODO: use libfmt, lunasvg etc. from ports:
# https://github.com/reybits/simple-viewer-gl/issues/34

depends_build-append    path:bin/pkg-config:pkgconfig \
                        port:py${python_branch}-glad2 \
                        port:python${python_branch}

depends_lib-append      port:curl \
                        port:giflib \
                        path:lib/pkgconfig/glfw3.pc:glfw \
                        port:ilmbase \
                        port:lcms2 \
                        port:libexif \
                        port:libheif \
                        path:include/turbojpeg.h:libjpeg-turbo \
                        port:libpng \
                        port:openexr \
                        port:openjpeg \
                        port:tiff \
                        port:webp \
                        port:zlib

configure.args-append   -DPython3_EXECUTABLE=${prefix}/bin/python${python_ver}

destroot {
    copy ${cmake.build_dir}/sviewgl.app ${destroot}${applications_dir}/
    ln -s ${applications_dir}/sviewgl.app/Contents/MacOS/sviewgl ${destroot}${prefix}/bin/sviewgl
}
