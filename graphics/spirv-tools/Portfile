                    size    3554324 \
                    SPIRV-Headers-${spirv_h_hash}.tar.gz \
                    rmd160  6c1ff552bcc8c25e57b64d18a1d34c3d774b789d \
                    sha256  a9bb9c48713245eacf97cc539b6f1d45405a92d8813f8b82e635f0a085ee9898 \
