diff --git a/build/config/compiler/BUILD.gn b/build/config/compiler/BUILD.gn
index 859e24e..80b1686 100644
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -53,6 +53,12 @@ declare_args() {
   lld_path = default_lld_path
 }
 
+declare_args() {
+  # Extra flags for all C/C++ compiles and links, e.g. from a packaging system.
+  extra_cflags = []
+  extra_ldflags = []
+}
+
 declare_args() {
   # Normally, Android builds are lightly optimized, even for debug builds, to
   # keep binary size down. Setting this flag to true disables such optimization
@@ -332,14 +338,14 @@ config("no_unresolved_symbols") {
 
 config("compiler") {
   asmflags = []
-  cflags = []
+  cflags = extra_cflags
   cflags_c = []
   cflags_cc = []
   cflags_objc = []
   cflags_objcc = []
   rustenv = []
   rustflags = []
-  ldflags = []
+  ldflags = extra_ldflags
   defines = []
   configs = []
 
@@ -1134,7 +1140,7 @@ config("linker") {
   # Note: `use_lld=false` on Apple platforms is experimental and may not
   # run properly on bots due to toolchain limitations. It is mainly
   # intended to unblock local builds for debugging.
-  if (is_apple && !use_lld) {
+  if (is_apple && !use_lld && is_clang) {
     if (!use_icf) {
       ldflags += [ "-Wl,-no_deduplicate" ]
     }
@@ -1920,7 +1926,7 @@ config("default_warnings") {
       cflags += [ "/wd4244" ]
     }
   } else {
-    if (is_apple || is_android) {
+    if ((is_apple || is_android) && is_clang) {
       # Warns if a method is used whose availability is newer than the
       # deployment target.
       cflags += [ "-Wunguarded-availability" ]
@@ -2111,7 +2117,7 @@ config("default_warnings") {
   }
 
   # TODO(crbug.com/355446806): Clean up and enable.
-  if (is_apple) {
+  if (is_apple && is_clang) {
     ldflags += [ "-Wl,-no_warn_duplicate_libraries" ]
   }
 
