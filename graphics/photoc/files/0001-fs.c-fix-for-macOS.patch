From b1359c370bdcc80aaa1c3f57e9506be1f09a9e5b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Mon, 12 Oct 2026 01:12:34 +0800
Subject: [PATCH] fs.c: fix for macOS

---
 src/core/fs.c | 32 ++++++++++++++++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git src/core/fs.c src/core/fs.c
index 9ecefe2..6e86950 100644
--- src/core/fs.c
+++ src/core/fs.c
@@ -13,7 +13,9 @@
 #include <fcntl.h>
 #include <linux/fs.h>
 #elif defined(__APPLE__)
+#include <AvailabilityMacros.h>
 #include <sys/stdio.h>
+#include <unistd.h>
 #endif
 #include <stdio.h>
 #include <stdint.h>
@@ -378,8 +380,21 @@ int photoc_fs_rename_noreplace(const char *source, const char *destination)
         errno = EINVAL;
         return -1;
     }
-#if defined(__APPLE__)
+#if defined(__APPLE__) && MAC_OS_X_VERSION_MIN_REQUIRED >= 101200
     return renamex_np(source, destination, RENAME_EXCL);
+#elif defined(__APPLE__)
+    /* renamex_np() needs macOS 10.12. link() fails with EEXIST rather than
+       replacing destination; a crash between the calls leaves both names. */
+    if (link(source, destination) != 0) {
+        return -1;
+    }
+    if (unlink(source) != 0) {
+        int saved_errno = errno;
+        unlink(destination);
+        errno = saved_errno;
+        return -1;
+    }
+    return 0;
 #elif defined(__linux__)
     return renameat2(AT_FDCWD, source, AT_FDCWD, destination, RENAME_NOREPLACE);
 #else
@@ -399,9 +414,22 @@ int photoc_fs_renameat_noreplace(int source_directory, const char *source_name,
         errno = EINVAL;
         return -1;
     }
-#if defined(__APPLE__)
+#if defined(__APPLE__) && MAC_OS_X_VERSION_MIN_REQUIRED >= 101200
     return renameatx_np(source_directory, source_name, destination_directory,
                         destination_name, RENAME_EXCL);
+#elif defined(__APPLE__)
+    /* See photoc_fs_rename_noreplace(). */
+    if (linkat(source_directory, source_name, destination_directory,
+               destination_name, 0) != 0) {
+        return -1;
+    }
+    if (unlinkat(source_directory, source_name, 0) != 0) {
+        int saved_errno = errno;
+        unlinkat(destination_directory, destination_name, 0);
+        errno = saved_errno;
+        return -1;
+    }
+    return 0;
 #elif defined(__linux__)
     return renameat2(source_directory, source_name, destination_directory,
                      destination_name, RENAME_NOREPLACE);
