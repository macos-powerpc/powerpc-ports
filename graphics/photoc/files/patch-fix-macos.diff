--- src/core/fs.c.orig	2026-10-02 04:09:10.000000000 +0800
+++ src/core/fs.c	2026-10-07 01:32:20.000000000 +0800
@@ -20,6 +20,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
+#include <unistd.h>
 
 static bool valid_path(const char *path)
 {
@@ -368,10 +369,27 @@
         errno = EINVAL;
         return -1;
     }
-#if defined(__APPLE__)
+#if defined(__APPLE__) && defined(RENAME_EXCL)
     return renamex_np(source, destination, RENAME_EXCL);
 #elif defined(__linux__)
     return renameat2(AT_FDCWD, source, AT_FDCWD, destination, RENAME_NOREPLACE);
+#elif defined(__APPLE__) || defined(__unix__)
+    /* Older systems (e.g. macOS releases predating 10.12, where
+       renamex_np()/RENAME_EXCL do not exist) lack an atomic rename-if-absent
+       primitive. link() fails with EEXIST when destination already exists,
+       so this sequence never overwrites an existing file; it is not atomic
+       with respect to a concurrent removal of destination, but it never
+       clobbers user data. */
+    if (link(source, destination) != 0) {
+        return -1;
+    }
+    if (unlink(source) != 0) {
+        int saved_errno = errno;
+        unlink(destination);
+        errno = saved_errno;
+        return -1;
+    }
+    return 0;
 #else
     errno = ENOTSUP;
     return -1;
@@ -389,12 +407,25 @@
         errno = EINVAL;
         return -1;
     }
-#if defined(__APPLE__)
+#if defined(__APPLE__) && defined(RENAME_EXCL)
     return renameatx_np(source_directory, source_name, destination_directory,
                         destination_name, RENAME_EXCL);
 #elif defined(__linux__)
     return renameat2(source_directory, source_name, destination_directory,
                      destination_name, RENAME_NOREPLACE);
+#elif defined(__APPLE__) || defined(__unix__)
+    /* See the fallback comment in photoc_fs_rename_noreplace() above. */
+    if (linkat(source_directory, source_name, destination_directory,
+              destination_name, 0) != 0) {
+        return -1;
+    }
+    if (unlinkat(source_directory, source_name, 0) != 0) {
+        int saved_errno = errno;
+        unlinkat(destination_directory, destination_name, 0);
+        errno = saved_errno;
+        return -1;
+    }
+    return 0;
 #else
     errno = ENOTSUP;
     return -1;
