From 55ce5ec55f88f83d9ccc1ff0cf1e83162c559d83 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 09:41:33 +0000
Subject: [PATCH] Cocoa: Finish launching without -[NSApplication run] before
 10.7

On Mac OS X 10.6 the buttons of an NSOpenPanel or NSSavePanel run with
-runModal do nothing: -[NSSavePanel ok:] reaches
-[NSApplication stopModalWithCode:], but the modal loop keeps running
and the panel cannot be closed.

In the 10.6 AppKit, -stopModalWithCode: ends a modal loop by lowering
the run loop depth in NSApplication's _running, but only while that is
above the _appFlags._hasBeenRun bit:

    if (_appFlags._hasBeenRun < _running)
        _running--;

AppKit assumes that once -run has been entered it is still on the
stack, below every modal loop.  GLFW instead enters -run during
initialization and stops it from -applicationDidFinishLaunching:, which
leaves _hasBeenRun set with _running back at 0.  Every later -runModal
loop then runs at depth 1, which -stopModalWithCode: refuses to lower,
so NSOpenPanel, NSSavePanel and NSAlert can never be dismissed.

When built with an SDK older than 10.7, call -finishLaunching directly,
as GLFW 3.0 did, and do not stop the run loop that is no longer
entered.  -finishLaunching still sends the will/did finish launching
notifications, so the menu bar is created as before.  Builds with the
10.7 SDK and later are unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/cocoa_init.m | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/src/cocoa_init.m b/src/cocoa_init.m
index 604c730..478bd2e 100644
--- a/src/cocoa_init.m
+++ b/src/cocoa_init.m
@@ -542,7 +542,11 @@ static void unregisterInputSourceObserver(void)
 - (void)applicationDidFinishLaunching:(NSNotification *)notification
 {
     _glfwPostEmptyEventCocoa();
+    // NOTE: Before the 10.7 SDK, _glfwInitCocoa finishes launching without
+    //       entering -[NSApplication run], so there is no event loop to stop
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 1070
     [NSApp stop:nil];
+#endif /*MAC_OS_X_VERSION_MAX_ALLOWED*/
 }
 
 - (void)applicationDidHide:(NSNotification *)notification
@@ -701,12 +705,22 @@ int _glfwInitCocoa(void)
     // NOTE: NSRunningApplication was added in the 10.6 SDK; on Mac OS X 10.5
     //       -[NSApplication isRunning] is the closest test for whether the
     //       event loop has already been started on our behalf
-#if MAC_OS_X_VERSION_MAX_ALLOWED >= 1060
+    // NOTE: On Mac OS X 10.6 and earlier, -[NSApplication run] sets the
+    //       _hasBeenRun flag for good, and -stopModalWithCode: then never
+    //       lowers the run loop depth below it.  After the run/stop below, a
+    //       -runModal loop (NSOpenPanel, NSSavePanel, NSAlert) runs at depth 1
+    //       with that flag set and cannot be ended, so the buttons do nothing.
+    //       Finishing launching directly, as GLFW 3.0 did, leaves the flag
+    //       clear
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 1070
     if (![[NSRunningApplication currentApplication] isFinishedLaunching])
         [NSApp run];
+#elif MAC_OS_X_VERSION_MAX_ALLOWED >= 1060
+    if (![[NSRunningApplication currentApplication] isFinishedLaunching])
+        [NSApp finishLaunching];
 #else
     if (![NSApp isRunning])
-        [NSApp run];
+        [NSApp finishLaunching];
 #endif /*MAC_OS_X_VERSION_MAX_ALLOWED*/
 
     // In case we are unbundled, make us a proper UI application
