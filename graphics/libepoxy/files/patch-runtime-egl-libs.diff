+/* The EGL and GLES libraries can be picked at runtime, e.g. to use ANGLE
+ * instead of Mesa, through EPOXY_EGL_LIB, EPOXY_GLES1_LIB and
+ * EPOXY_GLES2_LIB. They must all come from the same implementation.
+ */
+static const char *
+lib_name_from_env(const char *variable, const char *default_name)
+{
+    const char *name = getenv(variable);
+
+    return name != NULL && name[0] != '\0' ? name : default_name;
+}
