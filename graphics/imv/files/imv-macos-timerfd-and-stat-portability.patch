diff --git a/meson.build b/meson.build
index 47f051b..9fc9633 100644
--- a/meson.build
+++ b/meson.build
@@ -98,8 +98,12 @@ if build_wayland
     dependency('wayland-cursor'),
     dependency('wayland-egl'),
     dependency('egl'),
-    cc.find_library('rt'),
   ]
+  if host_machine.system() != 'linux'
+    # Linux has <sys/timerfd.h> natively; elsewhere (e.g. macOS/BSD) it's
+    # provided by epoll-shim, which also exposes struct itimerspec there.
+    deps_for_wayland += dependency('epoll-shim')
+  endif
 
   wl_protos = dependency('wayland-protocols')
   wl_scanner = find_program('wayland-scanner', native: true)
