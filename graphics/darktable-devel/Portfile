# Blacklist MacPorts Clang 14 and newer (up to 19) for now, due to compilation crashes.
# See: https://trac.macports.org/ticket/65246
#--------------------------------------------------------------------------------------------------
#compiler.blacklist-append {macports-clang-1[4-9]}

variant quartz conflicts x11 {
    depends_lib-append      port:gtk-osx-application-gtk3
    require_active_variants gtk3 quartz x11
}
if {[variant_isset quartz]} {
    PortGroup               app 1.1

    app.name                ${my_name}
    app.executable          ${workpath}/darktable-app
    app.icon                packaging/macosx/Icons.icns
}

variant x11 conflicts quartz {
    require_active_variants gtk3 x11 quartz
    configure.args-append   -DUSE_MAC_INTEGRATION=OFF
}

if {![variant_isset quartz]} {
    default_variants-append +x11
}

variant opencl description "Enable support for OpenCL" {
    configure.args-replace  -DUSE_OPENCL=OFF -DUSE_OPENCL=ON
}

variant openmp description "Enable support for OpenMP" {
    configure.args-replace  -DUSE_OPENMP=OFF -DUSE_OPENMP=ON
}
if {[variant_isset openmp]} {
    compiler.openmp_version 4.5
    compiler.log_verbose_output no
}

platform powerpc {
    variant G4 conflicts G5 description "Optimize for G4" {
        configure.cflags-append         -mcpu=G4 -mtune=G4
        configure.cxxflags-append       -mcpu=G4 -mtune=G4
        configure.objcxxflags-append    -mcpu=G4 -mtune=G4
    }

    variant G5 conflicts G4 description "Optimize for G5" {
        configure.cflags-append         -mcpu=970 -mtune=970
        configure.cxxflags-append       -mcpu=970 -mtune=970
        configure.objcxxflags-append    -mcpu=970 -mtune=970

        # https://github.com/iains/gcc-14-branch/issues/24
        if {${configure.build_arch} ne "ppc64"} {
            configure.cflags-append         -mno-powerpc64
            configure.cxxflags-append       -mno-powerpc64
            configure.objcxxflags-append    -mno-powerpc64
        }
    }
}

