From 752be09f2e1590a23d0eed5c5de523ff2ca47740 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 13:47:01 +0000
Subject: [PATCH 10/10] common: keep the C99 float classification names visible
 from C++

dttypes.h and common/math.h call isfinite(), isnan(), isinf() and
isnormal() through <math.h>, and lens.cc calls isfinite() and isnan()
directly. In C++ these are not macros: <cmath> removes them and the C++
<math.h> wrapper is expected to put the std:: functions back into the
global namespace. MacPorts legacy-support, used to build against old
macOS SDKs, marks that wrapper as already included from its own
<math.h>, so with GCC on macOS 10.6 nothing ever declares the global
names and every C++ unit including darktable.h fails with
"'isfinite' was not declared in this scope".

Include <cmath> and add using-declarations for the four functions in
the two headers when compiled as C++, which is what the wrapper would
have done.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017wUNQ69BaBcDfrxd6oXJeJ
---
 src/common/dttypes.h |  9 +++++++++
 src/common/math.h    | 12 ++++++++++++
 2 files changed, 21 insertions(+)

diff --git src/common/dttypes.h src/common/dttypes.h
index 5029202..ed73245 100644
--- src/common/dttypes.h
+++ src/common/dttypes.h
@@ -31,6 +31,15 @@
 #include <math.h>
 #include <stdint.h>
 
+// <cmath> discards the C99 classification macros, and the C++ <math.h>
+// that would put the std:: versions back in the global namespace is not
+// reached behind MacPorts legacy-support on old macOS, so name the one
+// used below explicitly
+#ifdef __cplusplus
+#include <cmath>
+using std::isfinite;
+#endif
+
 // When included by a C++ file, restrict qualifiers are not allowed
 #ifdef __cplusplus
 #define DT_RESTRICT
diff --git src/common/math.h src/common/math.h
index 689dc10..4cd9991 100644
--- src/common/math.h
+++ src/common/math.h
@@ -23,6 +23,18 @@
 #include <stdint.h>
 #include "common/sse.h"		// also includes darktable.h
 
+// <cmath> discards the C99 classification macros, and the C++ <math.h>
+// that would put the std:: versions back in the global namespace is not
+// reached behind MacPorts legacy-support on old macOS, so name the ones
+// used below explicitly
+#ifdef __cplusplus
+#include <cmath>
+using std::isfinite;
+using std::isinf;
+using std::isnan;
+using std::isnormal;
+#endif
+
 #define LUT_ELEM 512 // gamut LUT number of elements:
 
 #define DT_MEGA 1048576lu
