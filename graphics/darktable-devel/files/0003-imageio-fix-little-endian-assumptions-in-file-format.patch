From b33f964fd9f0040f5396f1bf9a620f4fc189f8b4 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 04:32:21 +0000
Subject: [PATCH] imageio: fix little-endian assumptions in file formats and
 shipped data

The PNG writer always called png_set_swap, the PPM and PDF writers
byte-swapped 16-bit samples by hand, and HEIF decoding and encoding
requested RRGGBB_LE while reading the samples as native uint16_t; all of
that is only right on a little-endian host. The spectral film LUT packs
are little-endian files read with native fread, and the shipped .dtstyle
camera styles carry module params as little-endian struct dumps.

Swap only where the host needs it (GUINT16_TO_BE, G_BYTE_ORDER), ask
libheif for the host's 16-bit layout, read the LUT pack header and
payload as little-endian, and skip importing the shipped styles on
big-endian hosts, where they would come out as garbage.

[5.6.1: the spectral film module does not exist yet; its hunks are dropped]

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XfSsLvzPAMMJrirjDuBXbx
---
 src/common/darktable.c     | 9 ++++++++-
 src/imageio/format/heif.c  | 4 +++-
 src/imageio/format/pdf.c   | 2 +-
 src/imageio/format/png.c   | 4 ++--
 src/imageio/format/ppm.c   | 2 +-
 src/imageio/imageio_heif.c | 5 +++--
 6 files changed, 18 insertions(+), 8 deletions(-)

diff --git src/common/darktable.c src/common/darktable.c
index dc16387..19e0663 100644
--- src/common/darktable.c
+++ src/common/darktable.c
@@ -1870,7 +1870,10 @@ int dt_init(int argc,
       dt_gui_presets_init(); // init preset db schema.
   }
 
-  // import default styles from shared directory
+  // import default styles from shared directory. the shipped .dtstyle
+  // files carry module params as little-endian struct dumps, which a
+  // big-endian host would import as garbage, so skip them there
+#if G_BYTE_ORDER == G_LITTLE_ENDIAN
   gchar *styledir = g_build_filename(sharedir, "darktable/styles", NULL);
   if(styledir)
   {
@@ -1878,6 +1881,10 @@ int dt_init(int argc,
     dt_import_default_styles(styledir);
     g_free(styledir);
   }
+#else
+  dt_print(DT_DEBUG_ALWAYS,
+           "[init] not importing default styles: they are little-endian encoded");
+#endif
 
   // we initialize grouping early because it's needed for collection init
   // idem for folder reachability
diff --git src/imageio/format/heif.c src/imageio/format/heif.c
index d8b038f..926c62e 100644
--- src/imageio/format/heif.c
+++ src/imageio/format/heif.c
@@ -155,9 +155,11 @@ int write_image(dt_imageio_module_data_t *data,
       break;
     case 10:
     case 12:
+      // the samples written below are in host byte order, so request the matching chroma
       err = heif_image_create(width, height,
                               heif_colorspace_RGB,
-                              heif_chroma_interleaved_RRGGBB_LE,
+                              G_BYTE_ORDER == G_BIG_ENDIAN ? heif_chroma_interleaved_RRGGBB_BE
+                                                           : heif_chroma_interleaved_RRGGBB_LE,
                               &image);
       break;
     default:
diff --git src/imageio/format/pdf.c src/imageio/format/pdf.c
index 16fa165..3a451b7 100644
--- src/imageio/format/pdf.c
+++ src/imageio/format/pdf.c
@@ -340,7 +340,7 @@ int write_image(dt_imageio_module_data_t *data, const char *filename, const void
           for(int x = 0; x < data->width; x++, in_ptr += 4, out_ptr += 3)
           {
             for(int c = 0; c < 3; c++)
-              out_ptr[c] = (0xff00 & (in_ptr[c] << 8)) | (in_ptr[c] >> 8);
+              out_ptr[c] = GUINT16_TO_BE(in_ptr[c]);
           }
         }
       }
diff --git src/imageio/format/png.c src/imageio/format/png.c
index 6b81792..65c8531 100644
--- src/imageio/format/png.c
+++ src/imageio/format/png.c
@@ -319,8 +319,8 @@ int write_image(dt_imageio_module_data_t *p_tmp,
   {
     if(p->bpp > 8)
     {
-      /* swap bytes of 16 bit files to most significant bit first */
-      png_set_swap(png_ptr);
+      /* libpng writes 16 bit samples big-endian, so only a little-endian host needs the swap */
+      if(G_BYTE_ORDER == G_LITTLE_ENDIAN) png_set_swap(png_ptr);
 
       for(unsigned i = 0; i < height; i++)
         row_pointers[i] = (png_bytep)((uint16_t *)ivoid + (size_t)4 * i * width);
diff --git src/imageio/format/ppm.c src/imageio/format/ppm.c
index 2bbf0cb..e9b2f99 100644
--- src/imageio/format/ppm.c
+++ src/imageio/format/ppm.c
@@ -52,7 +52,7 @@ int write_image(dt_imageio_module_data_t *ppm, const char *filename, const void
     {
       for(int x = 0; x < ppm->width; x++)
       {
-        for(int c = 0; c < 3; c++) swapped[c] = (0xff00 & (row[c] << 8)) | (row[c] >> 8);
+        for(int c = 0; c < 3; c++) swapped[c] = GUINT16_TO_BE(row[c]);
         int cnt = fwrite(&swapped, sizeof(uint16_t), 3, f);
         if(cnt != 3) break;
         row += 4;
diff --git src/imageio/imageio_heif.c src/imageio/imageio_heif.c
index 77163f4..8870fc8 100644
--- src/imageio/imageio_heif.c
+++ src/imageio/imageio_heif.c
@@ -163,11 +163,12 @@ dt_imageio_retval_t dt_imageio_open_heif(dt_image_t *img,
     goto out;
   }
   decode_options->ignore_transformations = TRUE;
-  // Darktable only supports LITTLE_ENDIAN systems, so RRGGBB_LE should be fine
+  // request the 16 bit samples in host byte order, since they are read back as uint16_t below
   err = heif_decode_image(handle,
                           &heif_img,
                           heif_colorspace_RGB,
-                          heif_chroma_interleaved_RRGGBB_LE,
+                          G_BYTE_ORDER == G_BIG_ENDIAN ? heif_chroma_interleaved_RRGGBB_BE
+                                                       : heif_chroma_interleaved_RRGGBB_LE,
                           decode_options);
   heif_decoding_options_free(decode_options);
   if(err.code != heif_error_Ok)
