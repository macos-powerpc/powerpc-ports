From c562c3634d75d1b3212d077082bc25c83edb9a06 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 13:47:01 +0000
Subject: [PATCH 09/10] dtpthread: guard the robust mutex errno codes

EOWNERDEAD and ENOTRECOVERABLE only exist where the C library has
robust mutexes; the macOS 10.6 SDK has neither, so the error-to-name
switch in _pthread_ret_mess() does not compile there. Wrap the two
cases in #ifdef, as the Linux-only codes below them already are.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017wUNQ69BaBcDfrxd6oXJeJ
---
 src/common/dtpthread.h | 5 +++++
 1 file changed, 5 insertions(+)

diff --git src/common/dtpthread.h src/common/dtpthread.h
index 98f3d38..cfe0d1d 100644
--- src/common/dtpthread.h
+++ src/common/dtpthread.h
@@ -43,9 +43,14 @@ static inline const char *_pthread_ret_mess(int error)
     case ETIMEDOUT:       return "ETIMEDOUT";
     case ESRCH:           return "ESRCH";
     case ENOMEM:          return "ENOMEM";
+// the robust mutex codes are missing from the macOS 10.6 SDK
+#ifdef EOWNERDEAD
     case EOWNERDEAD:      return "EOWNERDEAD";
+#endif
     case ECANCELED:       return "ECANCELED";
+#ifdef ENOTRECOVERABLE
     case ENOTRECOVERABLE: return "ENOTRECOVERABLE";
+#endif
 #if defined __linux__
     case ERFKILL:         return "ERFKILL";
     case EHWPOISON:       return "EHWPOISON";
