From 4949265f0e24876c294ab915e4baa01f58a6aa4e Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 04:32:21 +0000
Subject: [PATCH] build: accept big-endian and 32-bit PowerPC hosts

is_supported_platform.h refused any byte order but little-endian, only
recognized PPC64 through __PPC64__, which Darwin's GCC does not define
(it defines __ppc64__ and __ppc__), and refused 32-bit pointers
outright. With the display, export and file format code now keying on
G_BYTE_ORDER, allow both byte orders, accept the Darwin macros, and
allow 32-bit pointers for PowerPC only.

Apply the altivec.h shim to every PowerPC processor string, not just
ppc64le. Make the memory budget arithmetic saturate instead of
overflowing size_t on 32-bit hosts, cap the detected total memory at
what a 32-bit process can address, and print a pointer with %p in the
colorpicker debug helper instead of casting it to uint64_t, which is an
error on 32-bit under -Werror.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XfSsLvzPAMMJrirjDuBXbx
---
 src/CMakeLists.txt          |  5 ++++-
 src/common/darktable.c      | 20 +++++++++++++++++---
 src/is_supported_platform.h | 37 ++++++++++++++++++++++++++-----------
 src/libs/colorpicker.c      |  2 +-
 4 files changed, 48 insertions(+), 16 deletions(-)

diff --git src/CMakeLists.txt src/CMakeLists.txt
index 67e198e..1c80c67 100644
--- src/CMakeLists.txt
+++ src/CMakeLists.txt
@@ -251,7 +251,10 @@ endif(WIN32)
 
 set(SOURCES ${SOURCE_FILES} ${HEADER_FILES})
 
-if(CMAKE_SYSTEM_PROCESSOR STREQUAL "ppc64le")
+# gcc's altivec.h turns vector, pixel and bool into macros unless
+# __APPLE_ALTIVEC__ is defined; the shim in ppc64le/ prevents that on every
+# PowerPC target, big-endian and 32-bit included
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(ppc|powerpc)")
   include_directories(${CMAKE_CURRENT_SOURCE_DIR}/ppc64le)
 endif()
 
diff --git src/common/darktable.c src/common/darktable.c
index 44c2a95..857e052 100644
--- src/common/darktable.c
+++ src/common/darktable.c
@@ -549,6 +549,17 @@ static inline size_t _get_total_memory()
 #endif
 }
 
+// fractions are val/1024 of total memory and may exceed it on purpose
+// (the unrestricted level), which overflows size_t on 32-bit hosts
+static size_t _fraction_of_memory(const size_t memory, const int fraction)
+{
+  const uint64_t bytes = (uint64_t)memory / 1024 * (uint64_t)fraction;
+#if SIZE_MAX < UINT64_MAX
+  if(bytes > SIZE_MAX) return SIZE_MAX;
+#endif
+  return (size_t)bytes;
+}
+
 static size_t _get_mipmap_size()
 {
   dt_sys_resources_t *res = &darktable.dtresources;
@@ -556,7 +567,7 @@ static size_t _get_mipmap_size()
   if(level < 0)
     return res->refresource[4*(-level-1) + 2] * DT_MEGA;
   const int fraction = res->fractions[4*level + 2];
-  return res->total_memory / 1024lu * fraction;
+  return _fraction_of_memory(res->total_memory, fraction);
 }
 
 static void _check_resourcelevel(const char *key,
@@ -1851,6 +1862,9 @@ int dt_init(int argc,
   res->refresource = ref_resources;
   size_t total_mb = _get_total_memory() / 1024lu;
   if(total_mb < 8192) total_mb -= 1024;
+  // a 32-bit process cannot address more than 4GB whatever the machine
+  // has, and total_mb * DT_MEGA must not overflow size_t
+  if(total_mb > SIZE_MAX / DT_MEGA) total_mb = SIZE_MAX / DT_MEGA;
   res->total_memory = total_mb * DT_MEGA;
 
   char *config_info = calloc(1, DT_PERF_INFOSIZE);
@@ -2481,7 +2495,7 @@ size_t dt_get_available_mem()
     return res->refresource[4*(-level-1)] * DT_MEGA;
 
   const int fraction = res->fractions[4*level];
-  return MAX(512lu * DT_MEGA, res->total_memory / 1024lu * fraction);
+  return MAX(512lu * DT_MEGA, _fraction_of_memory(res->total_memory, fraction));
 }
 
 size_t dt_get_singlebuffer_mem()
@@ -2492,7 +2506,7 @@ size_t dt_get_singlebuffer_mem()
     return res->refresource[4*(-level-1) + 1] * DT_MEGA;
 
   const int fraction = res->fractions[4*level + 1];
-  return MAX(2lu * DT_MEGA, res->total_memory / 1024lu * fraction);
+  return MAX(2lu * DT_MEGA, _fraction_of_memory(res->total_memory, fraction));
 }
 
 void dt_configure_runtime_performance(const int old, char *info)
diff --git src/is_supported_platform.h src/is_supported_platform.h
index 8fc8c94..b8791bf 100644
--- src/is_supported_platform.h
+++ src/is_supported_platform.h
@@ -20,8 +20,11 @@
 
 // WARNING: do not #include anything in here!
 
-#if !defined(__BYTE_ORDER__) || __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
-#error "Unfortunately we only work on litte-endian systems."
+// byte-order dependent code keys on G_BYTE_ORDER (or __BYTE_ORDER__ where
+// glib is not available), so the compiler has to tell us which one it is
+#if !defined(__BYTE_ORDER__) \
+    || (__BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__ && __BYTE_ORDER__ != __ORDER_BIG_ENDIAN__)
+#error "Unfortunately we only work on little-endian or big-endian systems."
 #endif
 
 #if (defined(__amd64__) || defined(__amd64) || defined(__x86_64__) || defined(__x86_64))
@@ -36,12 +39,23 @@
 #define DT_SUPPORTED_ARMv8A 0
 #endif
 
-#if defined(__PPC64__)
+// either byte order. linux defines __PPC64__ and __powerpc64__, Darwin only
+// the Apple-style __ppc64__
+#if defined(__PPC64__) || defined(__powerpc64__) || defined(__ppc64__)
 #define DT_SUPPORTED_PPC64 1
 #else
 #define DT_SUPPORTED_PPC64 0
 #endif
 
+// 32-bit PowerPC (G3/G4, and 32-bit userland on a G5). Darwin defines
+// __ppc__, linux __powerpc__ and __PPC__; all three are also defined on
+// 64-bit builds, hence the exclusion
+#if !DT_SUPPORTED_PPC64 && (defined(__ppc__) || defined(__powerpc__) || defined(__PPC__))
+#define DT_SUPPORTED_PPC32 1
+#else
+#define DT_SUPPORTED_PPC32 0
+#endif
+
 #if (defined(__riscv) || defined(__riscv__)) && (__riscv_xlen==64)
 #define DT_SUPPORTED_RISCV64 1
 #else
@@ -54,16 +68,22 @@
 #define DT_SUPPORTED_LOONGARCH64 0
 #endif
 
-#if (DT_SUPPORTED_X86 + DT_SUPPORTED_ARMv8A + DT_SUPPORTED_PPC64 + DT_SUPPORTED_RISCV64 + DT_SUPPORTED_LOONGARCH64) > 1
+#if (DT_SUPPORTED_X86 + DT_SUPPORTED_ARMv8A + DT_SUPPORTED_PPC64 + DT_SUPPORTED_PPC32 + DT_SUPPORTED_RISCV64 + DT_SUPPORTED_LOONGARCH64) > 1
 #error "Looks like hardware platform detection macros are broken?"
 #endif
 
-#if !DT_SUPPORTED_X86 && !DT_SUPPORTED_ARMv8A && !DT_SUPPORTED_PPC64 && !DT_SUPPORTED_RISCV64 && !DT_SUPPORTED_LOONGARCH64
-#error "Unfortunately we only work on amd64, ARMv8-A, PPC64 (64-bit little-endian only), riscv64 and loongarch64"
+#if !DT_SUPPORTED_X86 && !DT_SUPPORTED_ARMv8A && !DT_SUPPORTED_PPC64 && !DT_SUPPORTED_PPC32 && !DT_SUPPORTED_RISCV64 && !DT_SUPPORTED_LOONGARCH64
+#error "Unfortunately we only work on amd64, ARMv8-A, PPC64, 32-bit PowerPC, riscv64 and loongarch64"
+#endif
+
+// double check for 32-bit architecture: PowerPC is the only one allowed
+#if defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ < 8 && !DT_SUPPORTED_PPC32
+#error "Unfortunately we only work on the 64-bit architectures amd64, ARMv8-A, PPC64, riscv64 and loongarch64, and on 32-bit PowerPC."
 #endif
 
 #undef DT_SUPPORTED_LOONGARCH64
 #undef DT_SUPPORTED_RISCV64
+#undef DT_SUPPORTED_PPC32
 #undef DT_SUPPORTED_PPC64
 #undef DT_SUPPORTED_ARMv8A
 #undef DT_SUPPORTED_X86
@@ -72,11 +92,6 @@
 #pragma message "Building without SSE2.  Some functionality will be noticeably slower."
 #endif
 
-// double check for 32-bit architecture
-#if defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ < 8
-#error "Unfortunately we only work on the 64-bit architectures amd64, ARMv8-A, PPC64, riscv64 and loongarch64."
-#endif
-
 // clang-format off
 // modelines: These editor modelines have been set for all relevant files by tools/update_modelines.py
 // vim: shiftwidth=2 expandtab tabstop=2 cindent
diff --git src/libs/colorpicker.c src/libs/colorpicker.c
index 7227854..0ea5153 100644
--- src/libs/colorpicker.c
+++ src/libs/colorpicker.c
@@ -99,7 +99,7 @@ int position(const dt_lib_module_t *self)
 static void _dump_sample(char* ctx, dt_colorpicker_sample_t *sample)
 {
   const gboolean isbox = sample->size == DT_LIB_COLORPICKER_SIZE_BOX;
-  printf(">>> %s KIND : %s (%lx)\n", ctx, isbox ? "box" : "point", (uint64_t)sample);
+  printf(">>> %s KIND : %s (%p)\n", ctx, isbox ? "box" : "point", (void *)sample);
   printf("   ");
   if(isbox)
   {
