 Rendering/OpenGL2/CMakeLists.txt              |   5 +
 Rendering/OpenGL2/vtkCocoaGLView.h            |   6 +
 Rendering/OpenGL2/vtkCocoaGLView.mm           |  46 +++---
 Rendering/OpenGL2/vtkCocoaRenderWindow.mm     | 141 +++++++++++-------
 Rendering/OpenGL2/vtkOSOpenGLRenderWindow.cxx |  38 ++++-
 Rendering/OpenGL2/vtkOpenGLRenderWindow.cxx   | 128 +++++++++++++---
 Rendering/OpenGL2/vtkXOpenGLRenderWindow.cxx  |  38 ++++-
 ThirdParty/glad/vtkglad/CMakeLists.txt        |   3 +
 8 files changed, 304 insertions(+), 101 deletions(-)

diff --git a/Rendering/OpenGL2/CMakeLists.txt b/Rendering/OpenGL2/CMakeLists.txt
index 876ec01..ea06762 100644
--- a/Rendering/OpenGL2/CMakeLists.txt
+++ b/Rendering/OpenGL2/CMakeLists.txt
@@ -462,6 +462,11 @@ endif()
 
 if (VTK_USE_COCOA)
   vtk_module_link(VTK::RenderingOpenGL2 PUBLIC "-framework Cocoa")
+  vtk_module_link(VTK::RenderingOpenGL2 PRIVATE "-framework OpenGL")
+elseif (VTK_USE_X)
+  # Link GL library explicitly for X11 backend (including macOS with XQuartz)
+  vtk_module_find_package(PACKAGE OpenGL COMPONENTS OpenGL)
+  vtk_module_link(VTK::RenderingOpenGL2 PUBLIC OpenGL::GL)
 elseif (VTK_USE_WIN32_OPENGL)
   # vtkWin32OpenGLDXRenderWindow requires D3D.
   vtk_module_find_package(PRIVATE_IF_SHARED
