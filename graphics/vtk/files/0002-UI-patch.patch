+// Helpers for the 10.7+ backing-store APIs. On older SDKs the methods are
+// declared in categories so the compiler emits the correct (stret or not)
+// message send; at runtime they are only used if the receiver responds.
+#ifdef __OBJC__
+#import <Cocoa/Cocoa.h>
+
+#if MAC_OS_X_VERSION_MAX_ALLOWED < 1070
+@interface NSView (vtkBackingCompatibility)
+- (NSPoint)convertPointToBacking:(NSPoint)aPoint;
+- (NSPoint)convertPointFromBacking:(NSPoint)aPoint;
+- (NSSize)convertSizeFromBacking:(NSSize)aSize;
+- (NSRect)convertRectToBacking:(NSRect)aRect;
+- (void)setWantsBestResolutionOpenGLSurface:(BOOL)flag;
+@end
+
+@interface NSWindow (vtkBackingCompatibility)
+- (CGFloat)backingScaleFactor;
+- (NSRect)convertRectToBacking:(NSRect)aRect;
+- (NSRect)convertRectFromBacking:(NSRect)aRect;
+@end
+
+@interface NSScreen (vtkBackingCompatibility)
+- (NSRect)convertRectToBacking:(NSRect)aRect;
+- (NSRect)convertRectFromBacking:(NSRect)aRect;
+@end
+#endif
+
+#if MAC_OS_X_VERSION_MAX_ALLOWED < 101000
+@interface NSOpenGLContext (vtkPixelFormatCompatibility)
+- (NSOpenGLPixelFormat*)pixelFormat;
+@end
+#endif
