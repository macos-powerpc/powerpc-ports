From 9e3113f36cc71f9065feeaf7b9aa6a3711cabccd Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 06:34:56 +0000
Subject: [PATCH] presets: decode the built-in little-endian blobs to host byte
 order

colorbalance and colorchecker ship presets as hex or gzip+base64 dumps
captured on little-endian machines, and exif.cc carries two such blobs
for upgrading old XMP files. Their structs consist of 4-byte fields
only, so add dt_exif_xmp_decode_le32(), which decodes and then swaps
every 32-bit word on big-endian hosts, and use it at those sites. On
little-endian hosts it is dt_exif_xmp_decode().

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XfSsLvzPAMMJrirjDuBXbx
---
 src/common/exif.cc     | 37 +++++++++++++++++++++++++++++++------
 src/common/exif.h      |  3 +++
 src/iop/colorbalance.c |  5 +++--
 src/iop/colorchecker.c | 12 ++++++------
 4 files changed, 43 insertions(+), 14 deletions(-)

diff --git src/common/exif.cc src/common/exif.cc
index 7bb3332..dd5a143 100644
--- src/common/exif.cc
+++ src/common/exif.cc
@@ -3467,6 +3467,30 @@ unsigned char *dt_exif_xmp_decode(const char *input,
   return output;
 }
 
+unsigned char *dt_exif_xmp_decode_le32(const char *input,
+                                       const int len,
+                                       int *output_len)
+{
+  int out_len = 0;
+  unsigned char *output = dt_exif_xmp_decode(input, len, &out_len);
+#if G_BYTE_ORDER == G_BIG_ENDIAN
+  if(output)
+  {
+    if(out_len % 4)
+    {
+      // not a struct of 4-byte fields, so the caller handed us the wrong blob
+      free(output);
+      return NULL;
+    }
+    uint32_t *words = (uint32_t *)output;
+    for(int i = 0; i < out_len / 4; i++)
+      words[i] = GUINT32_SWAP_LE_BE(words[i]);
+  }
+#endif
+  if(output_len) *output_len = out_len;
+  return output;
+}
+
 static void _exif_import_tags(dt_image_t *img,
                               Exiv2::XmpData::iterator &pos)
 {
@@ -4486,16 +4510,17 @@ gboolean dt_exif_xmp_read(dt_image_t *img,
             entry->operation = g_strdup("highlights");
 	    entry->enabled = TRUE;
 	    entry->modversion = 4;
-	    entry->params = dt_exif_xmp_decode(default_clip,
-	                                       strlen(default_clip),
-	                                       &entry->params_len);
+	    entry->params = dt_exif_xmp_decode_le32(default_clip,
+	                                            strlen(default_clip),
+	                                            &entry->params_len);
 	    entry->multi_name = g_strdup("");
 	    entry->multi_name_hand_edited = FALSE;
 	    entry->multi_priority = 0;
 	    entry->blendop_version = 13;
-	    entry->blendop_params = dt_exif_xmp_decode(no_blend,
-	                                               strlen(no_blend),
-	                                               &entry->blendop_params_len);
+	    // the blob's raster mask name is all zeros, so the word swap is exact
+	    entry->blendop_params = dt_exif_xmp_decode_le32(no_blend,
+	                                                    strlen(no_blend),
+	                                                    &entry->blendop_params_len);
 	    // We insert the module in second position, just after rawprepare.
 	    // This is to ensure that history_end do include this module.
 	    // Just adding one to history_end won't work if the history_end
diff --git src/common/exif.h src/common/exif.h
index 50e4b97..419cacd 100644
--- src/common/exif.h
+++ src/common/exif.h
@@ -131,6 +131,9 @@ void dt_exif_cleanup();
 char *dt_exif_xmp_encode(const unsigned char *input, const int len, int *output_len);
 char *dt_exif_xmp_encode_internal(const unsigned char *input, const int len, int *output_len, gboolean do_compress);
 unsigned char *dt_exif_xmp_decode(const char *input, const int len, int *output_len);
+/** like dt_exif_xmp_decode(), for a blob that was captured on a little-endian host from a struct
+    made only of 4-byte fields: the result is in host byte order */
+unsigned char *dt_exif_xmp_decode_le32(const char *input, const int len, int *output_len);
 
 /** look for color space hints in data and tell the caller if it's sRGB, AdobeRGB or something else. used for mipmaps */
 dt_colorspaces_color_profile_type_t dt_exif_get_color_space(const uint8_t *data, size_t size);
diff --git src/iop/colorbalance.c src/iop/colorbalance.c
index 98876e1..5651e00 100644
--- src/iop/colorbalance.c
+++ src/iop/colorbalance.c
@@ -263,8 +263,9 @@ static void add_preset(dt_iop_module_so_t *self, const char *name,
                        const char *pi, const int version, const char *bpi, const int blendop_version)
 {
   int len, blen;
-  uint8_t *p  = dt_exif_xmp_decode(pi, strlen(pi), &len);
-  uint8_t *bp = dt_exif_xmp_decode(bpi, strlen(bpi), &blen);
+  // captured on a little-endian host; both structs are all 4-byte fields
+  uint8_t *p  = dt_exif_xmp_decode_le32(pi, strlen(pi), &len);
+  uint8_t *bp = dt_exif_xmp_decode_le32(bpi, strlen(bpi), &blen);
   if(blendop_version != dt_develop_blend_version())
   {
     // update to current blendop params format
diff --git src/iop/colorchecker.c src/iop/colorchecker.c
index 1bd13f4..bf214d7 100644
--- src/iop/colorchecker.c
+++ src/iop/colorchecker.c
@@ -481,7 +481,7 @@ void init_presets(dt_iop_module_so_t *self)
   const char *hk_params_input =
     "";
   int params_len = 0;
