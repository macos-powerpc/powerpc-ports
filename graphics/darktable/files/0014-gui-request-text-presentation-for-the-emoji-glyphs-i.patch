From 8c7221f8243dbc0b40e539121220ccf697eae710 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 15:31:14 +0000
Subject: [PATCH] gui: request text presentation for the emoji glyphs in UI
 strings
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The flash and GPS icons produced by $(EXIF.FLASH.ICON) and
$(GPS.LOCATION.ICON), and the "❓" in the scopes tooltip, are emoji
presentation characters. Pango itemizes those into a run for the
"emoji" font family, and on a system without any emoji font (X11 on
old macOS, for one) it cannot load a font for that run and aborts the
program with "Could not load fallback font, bailing out".

Append U+FE0E, the text presentation selector, to the three glyphs so
they stay in the regular text run and are drawn by whatever font
covers them.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017wUNQ69BaBcDfrxd6oXJeJ
---
 src/common/variables.c | 7 +++++--
 src/libs/histogram.c   | 4 +++-
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git src/common/variables.c src/common/variables.c
--- src/common/variables.c
+++ src/common/variables.c
@@ -193,7 +193,9 @@
     else
     {
       // Bit 0 set means that flash was fired
-      params->data->exif_flash_icon = (img->exif_flash_tagvalue & 1) ? "⚡" : "";
+      // U+FE0E asks for text presentation: without it pango sends the glyph
+      // to the "emoji" font family and aborts on a system that has none
+      params->data->exif_flash_icon = (img->exif_flash_tagvalue & 1) ? "⚡\uFE0E" : "";
       params->data->exif_flash = (img->exif_flash_tagvalue & 1) ? _("yes") : _("no");
     }
 
@@ -540,7 +542,8 @@
   else if(_has_prefix(variable, "GPS.LOCATION.ICON"))
     // possible symbols: world map U+1F5FA 🗺, globe w/ meridians U+1F310 🌐
     //   pushpin U+1F4CC 📌 round pushpin U+1F4CD 📍   black pushpin U+1F588 🖈
-    result = g_strdup((!isnan(params->data->latitude) && !isnan(params->data->longitude)) ? "📌" : "");
+    // U+FE0E: text presentation, see the flash icon above
+    result = g_strdup((!isnan(params->data->latitude) && !isnan(params->data->longitude)) ? "📌\uFE0E" : "");
 
   // for watermark backward compatibility
   else if(_has_prefix(variable, "GPS.LOCATION"))
diff --git src/libs/histogram.c src/libs/histogram.c
--- src/libs/histogram.c
+++ src/libs/histogram.c
@@ -288,10 +288,12 @@
 void lib_histogram_update_tooltip(const dt_scopes_t *const scopes)
 {
   const char *const scope_name = dt_scopes_call(scopes->cur_mode, name);
+  // the U+FE0E after the glyph keeps pango from routing it to an emoji
+  // font, which aborts on a system that has none
   gchar *tip = g_strdup_printf("%s\n(%s)\n%s\n%s",
                                _(scope_name),
                                _("use buttons at top of graph to change type"),
-                               _("click on ❓ and then graph for documentation"),
+                               _("click on ❓\uFE0E and then graph for documentation"),
                                _("use color picker module to restrict area"));
   if(scopes->highlight == DT_SCOPES_HIGHLIGHT_BLACK_POINT)
     dt_util_str_cat(&tip, "\n%s\n%s",
-- 
