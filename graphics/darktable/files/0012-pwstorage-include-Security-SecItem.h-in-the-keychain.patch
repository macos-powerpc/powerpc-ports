From 4f021cd607d073f11d63e721a7217cb4673f2b9b Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 14:17:25 +0000
Subject: [PATCH] pwstorage: include Security/SecItem.h in the keychain backend

The backend uses the SecItem API (SecItemCopyMatching(), kSecClass and
the kSecAttr*, kSecMatch* and kSecReturn* keys) but only includes the
Security.h umbrella header. Security.h has pulled SecItem.h in since
the 10.7 SDK; with the 10.6 SDK the API is there but not reached that
way, and every one of those names comes out undeclared. Include
SecItem.h directly.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017wUNQ69BaBcDfrxd6oXJeJ
---
 src/common/pwstorage/backend_apple_keychain.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git src/common/pwstorage/backend_apple_keychain.c src/common/pwstorage/backend_apple_keychain.c
--- src/common/pwstorage/backend_apple_keychain.c
+++ src/common/pwstorage/backend_apple_keychain.c
@@ -21,6 +21,8 @@
 
 #include <CoreFoundation/CoreFoundation.h>
 #include <Security/Security.h>
+// the 10.6 SDK's Security.h umbrella does not yet pull in the SecItem API
+#include <Security/SecItem.h>
 
 
 static char* _CFStringCopyUTF8String(CFStringRef aString) {
-- 
2.43.0

