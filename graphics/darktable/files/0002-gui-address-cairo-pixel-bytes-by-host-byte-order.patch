diff --git src/common/colorspaces.c src/common/colorspaces.c
index c3fc7d6..1cc663d 100644
--- src/common/colorspaces.c
+++ src/common/colorspaces.c
@@ -33,6 +33,14 @@
 #include <lcms2.h>
 #include <strings.h>
 
+// lcms layout of a cairo RGB24/ARGB32 surface: B,G,R,A bytes on
+// little-endian hosts, A,R,G,B on big-endian ones
+#if G_BYTE_ORDER == G_BIG_ENDIAN
+#define DT_TYPE_CAIRO_8 TYPE_ARGB_8
+#else
+#define DT_TYPE_CAIRO_8 TYPE_BGRA_8
+#endif
+
 #ifdef USE_COLORDGTK
 #include "colord-gtk.h"
 #endif
@@ -1174,7 +1182,7 @@ static void _update_display_transforms(dt_colorspaces_t *self)
                                     DT_PROFILE_DIRECTION_DISPLAY)->profile,
                        TYPE_RGBA_8,
                        display_profile,
-                       TYPE_BGRA_8,
+                       DT_TYPE_CAIRO_8,
                        self->display_intent,
                        0);
 
@@ -1183,7 +1191,7 @@ static void _update_display_transforms(dt_colorspaces_t *self)
                                     DT_PROFILE_DIRECTION_DISPLAY)->profile,
                        TYPE_RGBA_8,
                        display_profile,
-                       TYPE_BGRA_8,
+                       DT_TYPE_CAIRO_8,
                        self->display_intent,
                        0);
 }
@@ -1215,7 +1223,7 @@ static void _update_display2_transforms(dt_colorspaces_t *self)
                                         DT_PROFILE_DIRECTION_DISPLAY2)->profile,
                            TYPE_RGBA_8,
                            display2_profile,
-                           TYPE_BGRA_8,
+                           DT_TYPE_CAIRO_8,
                            self->display2_intent,
                            0);
 
@@ -1224,7 +1232,7 @@ static void _update_display2_transforms(dt_colorspaces_t *self)
                                         DT_PROFILE_DIRECTION_DISPLAY2)->profile,
                            TYPE_RGBA_8,
                            display2_profile,
-                           TYPE_BGRA_8,
+                           DT_TYPE_CAIRO_8,
                            self->display2_intent,
                            0);
 }
diff --git src/common/dttypes.h src/common/dttypes.h
index f875f6a..5029202 100644
--- src/common/dttypes.h
+++ src/common/dttypes.h
@@ -59,6 +59,18 @@
 // utility type to ease declaration of aligned small arrays to hold a pixel (and document their purpose)
 typedef DT_ALIGNED_PIXEL float dt_aligned_pixel_t[4];
 
+// cairo stores ARGB32 and RGB24 pixels as native-endian 32-bit words, so the
+// byte holding a given channel depends on the host: B,G,R,A on little-endian
+// hosts and A,R,G,B on big-endian ones. use these instead of literal 0..3 when
+// addressing the bytes of a cairo pixel or of the 8-bit pixelpipe output
+#if G_BYTE_ORDER == G_BIG_ENDIAN
+#define DT_CAIRO_RGB(c) ((c) + 1) // c: 0 = R, 1 = G, 2 = B
+#define DT_CAIRO_ALPHA 0
+#else
+#define DT_CAIRO_RGB(c) (2 - (c))
+#define DT_CAIRO_ALPHA 3
+#endif
+
 // a 3x3 matrix, padded to permit SSE instructions to be used for multiplication and addition
 typedef float DT_ALIGNED_ARRAY dt_colormatrix_t[4][4];
 
diff --git src/common/focus_peaking.h src/common/focus_peaking.h
index 84aaed7..be74a6e 100644
--- src/common/focus_peaking.h
+++ src/common/focus_peaking.h
@@ -79,7 +79,8 @@ static inline void dt_focuspeaking(cairo_t *cr,
                                    uint8_t *const restrict image)
 {
   float *const restrict luma = dt_alloc_align_float((size_t)buf_width * buf_height);
-  uint8_t *const restrict focus_peaking = dt_alloc_align_uint8(buf_width * buf_height * 4);
+  // cairo ARGB32 pixels written as native-endian words, alpha in the top byte
+  uint32_t *const restrict focus_peaking = dt_alloc_align_type(uint32_t, (size_t)buf_width * buf_height);
 
   const size_t npixels = (size_t)buf_height * buf_width;
   // Create a luma buffer as the euclidian norm of RGB channels
@@ -91,9 +92,9 @@ static inline void dt_focuspeaking(cairo_t *cr,
       // remove gamma 2.2 and take the square is equivalent to this:
       const float exponent = 2.0f * 2.2f;
 
-      luma[index] = sqrtf( powf(_uint8_to_float(image[index_RGB]), exponent) +
-                           powf(_uint8_to_float(image[index_RGB + 1]), exponent) +
-                           powf(_uint8_to_float(image[index_RGB + 2]), exponent) );
+      luma[index] = sqrtf( powf(_uint8_to_float(image[index_RGB + DT_CAIRO_RGB(2)]), exponent) +
+                           powf(_uint8_to_float(image[index_RGB + DT_CAIRO_RGB(1)]), exponent) +
+                           powf(_uint8_to_float(image[index_RGB + DT_CAIRO_RGB(0)]), exponent) );
     }
 
   // Prefilter noise
@@ -164,33 +165,21 @@ static inline void dt_focuspeaking(cairo_t *cr,
   for(size_t i = 0; i < buf_height; ++i)
     for(size_t j = 0; j < buf_width; ++j)
     {
-      static const uint8_t yellow[4] = { 0/*B*/, 255/*G*/, 255/*R*/, 255/*alpha*/ };
-      static const uint8_t green[4] = { 0, 255, 0, 255 };
-      static const uint8_t blue[4] = { 255, 0, 0, 255 };
+      const uint32_t yellow = 0xffffff00u;
+      const uint32_t green = 0xff00ff00u;
+      const uint32_t blue = 0xff0000ffu;
 
-      const size_t index = (i * buf_width + j) * 4;
-      const float TV = luma_ds[index / 4];
+      const size_t index = i * buf_width + j;
+      const float TV = luma_ds[index];
 
       if(TV > six_sigma)
-      {
-        // Very sharp : paint yellow, BGR = (0, 255, 255)
-        for_four_channels(c) focus_peaking[index + c] = yellow[c];
-      }
+        focus_peaking[index] = yellow; // very sharp
       else if(TV > four_sigma)
-      {
-        // Mediun sharp : paint green, BGR = (0, 255, 0)
-        for_four_channels(c) focus_peaking[index + c] = green[c];
-      }
+        focus_peaking[index] = green; // medium sharp
       else if(TV > two_sigma)
-      {
-        // Little sharp : paint blue, BGR = (255, 0, 0)
-        for_four_channels(c) focus_peaking[index + c] = blue[c];
-      }
+        focus_peaking[index] = blue; // little sharp
       else
-      {
-        // Not sharp enough : paint 0
-        for_four_channels(c) focus_peaking[index + c] = 0;
-      }
+        focus_peaking[index] = 0; // not sharp enough: transparent
     }
 
   // draw the focus peaking overlay
diff --git src/develop/masks/object.c src/develop/masks/object.c
index 17dbb37..2c47ad8 100644
--- src/develop/masks/object.c
+++ src/develop/masks/object.c
@@ -902,11 +902,11 @@ static void _save_raster_mask(const float *mask,
     for(int x = 0; x < w; x++)
     {
       const uint8_t v = (mask[y * w + x] > threshold) ? 255 : 0;
-      // cairo RGB24 is native-endian BGRX in memory
-      row[x * 4 + 0] = v; // B
-      row[x * 4 + 1] = v; // G
-      row[x * 4 + 2] = v; // R
-      row[x * 4 + 3] = 0; // unused
+      // the byte positions of R, G, B and the unused channel follow the host byte order
+      row[x * 4 + DT_CAIRO_RGB(0)] = v; // R
+      row[x * 4 + DT_CAIRO_RGB(1)] = v; // G
+      row[x * 4 + DT_CAIRO_RGB(2)] = v; // B
+      row[x * 4 + DT_CAIRO_ALPHA] = 0; // unused
     }
   }
 
diff --git src/gui/draw.h src/gui/draw.h
index d74803e..af994f9 100644
--- src/gui/draw.h
+++ src/gui/draw.h
@@ -860,8 +860,8 @@ static inline void dt_draw_histogram_8(cairo_t *cr,
     dt_draw_histogram_8_linxlogy(cr, hist, channels, channel);
 }
 
-/** transform a data blob from cairo's premultiplied rgba/bgra to
- * GdkPixbuf's un-premultiplied bgra/rgba */
+/** transform a data blob from cairo's native-endian premultiplied ARGB32 to
+ * GdkPixbuf's un-premultiplied r,g,b,a byte order */
 static inline void dt_draw_cairo_to_gdk_pixbuf(uint8_t *data,
                                                const unsigned int width,
                                                const unsigned int height)
@@ -869,25 +869,25 @@ static inline void dt_draw_cairo_to_gdk_pixbuf(uint8_t *data,
   for(uint32_t y = 0; y < height; y++)
     for(uint32_t x = 0; x < width; x++)
     {
-      uint8_t *r, *g, *b, *a, tmp;
-      r = &data[(y * width + x) * 4 + 0];
-      g = &data[(y * width + x) * 4 + 1];
-      b = &data[(y * width + x) * 4 + 2];
-      a = &data[(y * width + x) * 4 + 3];
-
-      // switch r and b
-      tmp = *r;
-      *r = *b;
-      *b = tmp;
+      const uint32_t idx = (y * width + x) * 4;
+      const uint8_t a = data[idx + DT_CAIRO_ALPHA];
+      uint8_t r = data[idx + DT_CAIRO_RGB(0)];
+      uint8_t g = data[idx + DT_CAIRO_RGB(1)];
+      uint8_t b = data[idx + DT_CAIRO_RGB(2)];
 
       // cairo uses premultiplied alpha, reverse that
-      if(*a != 0)
+      if(a != 0)
       {
-        const float inv_a = 255.0 / *a;
-        *r *= inv_a;
-        *g *= inv_a;
-        *b *= inv_a;
+        const float inv_a = 255.0 / a;
+        r *= inv_a;
+        g *= inv_a;
+        b *= inv_a;
       }
+
+      data[idx + 0] = r;
+      data[idx + 1] = g;
+      data[idx + 2] = b;
+      data[idx + 3] = a;
     }
 }
 
diff --git src/imageio/imageio.c src/imageio/imageio.c
