         const float *const inbuf = (float *)outbuf;
         for(size_t k = 0; k < (size_t)processed_width * processed_height; k++)
         {
-          // convert in place, this is unfortunately very serial..
-          const uint8_t r = roundf(CLAMP(inbuf[4 * k + 2] * 0xff, 0, 0xff));
+          // convert in place to the cairo pixel layout, this is
+          // unfortunately very serial..
+          const uint8_t r = roundf(CLAMP(inbuf[4 * k + 0] * 0xff, 0, 0xff));
           const uint8_t g = roundf(CLAMP(inbuf[4 * k + 1] * 0xff, 0, 0xff));
-          const uint8_t b = roundf(CLAMP(inbuf[4 * k + 0] * 0xff, 0, 0xff));
-          outbuf[4 * k + 0] = r;
-          outbuf[4 * k + 1] = g;
-          outbuf[4 * k + 2] = b;
+          const uint8_t b = roundf(CLAMP(inbuf[4 * k + 2] * 0xff, 0, 0xff));
+          outbuf[4 * k + DT_CAIRO_RGB(0)] = r;
+          outbuf[4 * k + DT_CAIRO_RGB(1)] = g;
+          outbuf[4 * k + DT_CAIRO_RGB(2)] = b;
         }
       }
       // else processing output was 8-bit already, and no need to swap order
@@ -1434,12 +1435,15 @@ gboolean dt_imageio_export_with_flags(const dt_imgid_t imgid,
       { // !display_byteorder, need to swap:
         uint8_t *const buf8 = pipe.backbuf;
         DT_OMP_FOR()
-        // just flip byte order
+        // gamma wrote cairo pixels, the format modules want R,G,B,x
         for(size_t k = 0; k < (size_t)processed_width * processed_height; k++)
         {
-          uint8_t tmp = buf8[4 * k + 0];
-          buf8[4 * k + 0] = buf8[4 * k + 2];
-          buf8[4 * k + 2] = tmp;
+          const uint8_t r = buf8[4 * k + DT_CAIRO_RGB(0)];
+          const uint8_t g = buf8[4 * k + DT_CAIRO_RGB(1)];
+          const uint8_t b = buf8[4 * k + DT_CAIRO_RGB(2)];
+          buf8[4 * k + 0] = r;
+          buf8[4 * k + 1] = g;
+          buf8[4 * k + 2] = b;
         }
       }
     }
