From 9a8e5559a39dc78b6a9114dc72e58ae118d5f625 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 06:50:38 +0000
Subject: [PATCH] cmake: native optimization flags for PowerPC

march-mtune.cmake only knows the x86 flags: without BINARY_PACKAGE_BUILD
it probes -march=native, otherwise -mtune=generic. PowerPC GCC has
neither, so every probe failed and the build went on with a "resulting
binaries may be broken" warning; rawspeed repeats the same probes and
printed it again.

Detect PowerPC with the compiler and use -mcpu=native -mtune=native
there when native optimization is wanted, plus -mno-powerpc64 on 32-bit
builds, since -mcpu=native on a G5 would otherwise enable 64-bit
instructions. A package build adds no machine flags and no warning.
Native optimization stays the default elsewhere, but on PowerPC
BINARY_PACKAGE_BUILD now defaults to ON so that a plain build is
portable; the option therefore moves from DefineOptions.cmake to after
project(), where the processor is known.

rawspeed skips its own probing when RAWSPEED_MARCH is already defined,
so the probe now runs before src/external is added and hands the
PowerPC result down.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XfSsLvzPAMMJrirjDuBXbx
---
 CMakeLists.txt          | 10 ++++++++++
 DefineOptions.cmake     |  1 -
 cmake/march-mtune.cmake | 37 +++++++++++++++++++++++++++++++++++++
 src/CMakeLists.txt      |  8 ++++++--
 4 files changed, 53 insertions(+), 3 deletions(-)

diff --git CMakeLists.txt CMakeLists.txt
index 3f2a23b..266d069 100644
--- CMakeLists.txt
+++ CMakeLists.txt
@@ -23,6 +23,16 @@ else()
   project(darktable VERSION 0 LANGUAGES CXX C)
 endif()
 
+# native optimization is the default elsewhere, but a PowerPC build stays
+# portable unless asked otherwise (see cmake/march-mtune.cmake). defined here
+# rather than in DefineOptions.cmake because the processor is only known
+# after project()
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(ppc|powerpc)")
+  option(BINARY_PACKAGE_BUILD "Sets march optimization to generic" ON)
+else()
+  option(BINARY_PACKAGE_BUILD "Sets march optimization to generic" OFF)
+endif()
+
 # Allow forcing the C/CPP compiler that is actually used during the compilation
 # to something other than what is used by the cmake run. This is useful when
 # the compiler for some reason breaks the initial cmake checks but works fine
diff --git DefineOptions.cmake DefineOptions.cmake
index 8806a7e..9e007c0 100644
--- DefineOptions.cmake
+++ DefineOptions.cmake
@@ -12,7 +12,6 @@ option(USE_GRAPHICSMAGICK "Use GraphicsMagick library for image import." ON)
 option(USE_IMAGEMAGICK "Use ImageMagick library for image import." OFF)
 option(USE_DARKTABLE_PROFILING OFF)
 option(CUSTOM_CFLAGS "Don't override compiler optimization flags." OFF)
-option(BINARY_PACKAGE_BUILD "Sets march optimization to generic" OFF)
 option(USE_XMLLINT "Run xmllint to test if darktableconfig.xml is valid" ON)
 option(USE_PORTMIDI "Enable MIDI device support using PortMidi" ON)
 option(USE_OPENJPEG "Enable JPEG 2000 support" ON)
diff --git cmake/march-mtune.cmake cmake/march-mtune.cmake
index 8974768..098f99e 100644
--- cmake/march-mtune.cmake
+++ cmake/march-mtune.cmake
@@ -1,5 +1,42 @@
+include(CheckCCompilerFlag)
+include(CheckCSourceCompiles)
+
+# PowerPC has -mcpu/-mtune but neither -march nor a "generic" tuning target,
+# so the probes below would only fail with warnings there. checked with the
+# compiler rather than CMAKE_SYSTEM_PROCESSOR so that -arch builds on other
+# hosts are classified right
+check_c_source_compiles("
+#if !defined(__powerpc__) && !defined(__ppc__) && !defined(__PPC__) && !defined(__powerpc64__) && !defined(__ppc64__)
+#error not PowerPC
+#endif
+int main(void) { return 0; }" DT_TARGET_POWERPC)
+
 if(CMAKE_SYSTEM_NAME STREQUAL "SunOS")
   set(MARCH "-msse4.2")
+elseif(DT_TARGET_POWERPC)
+  # portable by default (BINARY_PACKAGE_BUILD defaults to ON on PowerPC in
+  # the top-level CMakeLists.txt); with it off, tune for the build machine
+  if(NOT BINARY_PACKAGE_BUILD)
+    MESSAGE("-- Checking for -mcpu=native support")
+    CHECK_C_COMPILER_FLAG("-mcpu=native" MCPUNATIVE)
+    if(MCPUNATIVE)
+      set(MARCH "-mcpu=native -mtune=native")
+      add_definitions("-DNATIVE_ARCH")
+      # -mcpu=native on a G5 enables 64-bit instructions, which a 32-bit
+      # build must not use
+      if(CMAKE_SIZEOF_VOID_P EQUAL 4)
+        CHECK_C_COMPILER_FLAG("-mno-powerpc64" MNOPOWERPC64)
+        if(MNOPOWERPC64)
+          set(MARCH "${MARCH} -mno-powerpc64")
+        endif()
+      endif()
+    else()
+      message(WARNING "The compiler does not support -mcpu=native, building without native optimization")
+    endif()
+  endif()
+  # rawspeed runs the same x86 probes on its own unless told what to use;
+  # this has to be set before src/external is added
+  separate_arguments(RAWSPEED_MARCH UNIX_COMMAND "${MARCH}")
 elseif(NOT BINARY_PACKAGE_BUILD AND (NOT APPLE OR CMAKE_C_COMPILER_ID STREQUAL "AppleClang"))
   MESSAGE("-- Checking for -march=native support")
   CHECK_C_COMPILER_FLAG("-march=native" MARCHNATIVE)
diff --git src/CMakeLists.txt src/CMakeLists.txt
index 1c80c67..994c8cb 100644
--- src/CMakeLists.txt
+++ src/CMakeLists.txt
@@ -1,3 +1,9 @@
+# the machine flags are probed before the bundled libraries are added so
+# that rawspeed can be handed the same choice (see cmake/march-mtune.cmake)
+if(NOT CUSTOM_CFLAGS)
+  include(march-mtune)
+endif()
+
 add_subdirectory(external)
 if(USE_AI)
   find_package(ONNXRuntime QUIET)
@@ -810,8 +816,6 @@ endif()
 
 
 if(NOT CUSTOM_CFLAGS)
-  include(march-mtune)
-
   #-g MUST be set for ALL builds, or there will be no support for them when bugs happen
   set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${MARCH} -g")
   set(CMAKE_C_FLAGS_RELWITHDEBINFO "${CMAKE_C_FLAGS_RELWITHDEBINFO} -O2 -ftree-vectorize")
