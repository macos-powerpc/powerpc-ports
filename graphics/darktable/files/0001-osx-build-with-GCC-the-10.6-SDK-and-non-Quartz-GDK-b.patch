From 66a8f83a79046a207c889950b88a58415d8e14e9 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 04:32:21 +0000
Subject: [PATCH] osx: build with GCC, the 10.6 SDK and non-Quartz GDK backends

osx.mm used Clang-only Objective-C syntax (@autoreleasepool, boxed
literals, dot syntax on plain methods, instance variables declared in
the @implementation) and messaged selectors the 10.6 SDK does not
declare, which GCC's Objective-C++ front end turns into errors under
-Werror. It also defined main() unconditionally and started an
NSApplication run loop before calling the real entry point, which only
makes sense with the Quartz backend.

Use NSAutoreleasePool and message syntax throughout, declare the 10.8
trash selector through a category for older SDKs, read the locale from
NSLocaleLanguageCode/NSLocaleCountryCode (10.4) instead of the 10.12
accessors, and compile the NSApplication launcher only when GDK has the
Quartz backend. main.c renames main() to apple_main() under the same
condition, so an X11 GTK build on macOS gets a plain main().

cmake probes c++, g++ and clang++ for Objective-C++ and ignores
CMAKE_CXX_COMPILER, so a GCC build could get osx.mm compiled by a
different compiler than the rest of the tree. Default the Objective-C++
compiler to the C++ compiler unless one was chosen explicitly.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XfSsLvzPAMMJrirjDuBXbx
---
 src/CMakeLists.txt |   7 ++
 src/gui/gtk.c      |   3 +-
 src/main.c         |   5 +-
 src/osx/osx.mm     | 199 +++++++++++++++++++++++++--------------------
 4 files changed, 126 insertions(+), 88 deletions(-)

diff --git src/CMakeLists.txt src/CMakeLists.txt
index d10dd7c..67e198e 100644
--- src/CMakeLists.txt
+++ src/CMakeLists.txt
@@ -191,6 +191,13 @@ if(APPLE)
   list(APPEND HEADER_FILES "common/pwstorage/backend_apple_keychain.h")
   list(APPEND SOURCE_FILES "main.c")
   include(CheckLanguage)
+  # cmake probes c++, g++ and clang++ for Objective-C++ and ignores
+  # CMAKE_CXX_COMPILER, so a GCC build would get osx.mm compiled and its
+  # C++ runtime picked by a different compiler. use the C++ compiler
+  # unless the user chose one explicitly
+  if(NOT CMAKE_OBJCXX_COMPILER AND "$ENV{OBJCXX}" STREQUAL "")
+    set(CMAKE_OBJCXX_COMPILER "${CMAKE_CXX_COMPILER}")
+  endif()
   check_language(OBJCXX)
   if(CMAKE_OBJCXX_COMPILER)
     enable_language(OBJCXX)
diff --git src/gui/gtk.c src/gui/gtk.c
index 100c75d..19352d9 100644
--- src/gui/gtk.c
+++ src/gui/gtk.c
@@ -65,7 +65,8 @@
 #ifdef MAC_INTEGRATION
 #include <gtkosxapplication.h>
 #endif
-#ifdef GDK_WINDOWING_QUARTZ
+#ifdef __APPLE__
+// dt_open_url() uses dt_osx_open_url() on every macOS GDK backend
 #include "osx/osx.h"
 #endif
 #ifdef _WIN32
diff --git src/main.c src/main.c
index 366413e..c5836a0 100644
--- src/main.c
+++ src/main.c
@@ -33,7 +33,10 @@
