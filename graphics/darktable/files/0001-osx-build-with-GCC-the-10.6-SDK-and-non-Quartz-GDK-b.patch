+// calls in here from applicationDidFinishLaunching. any other GDK backend
+// (X11 on macOS) runs a plain main()
 int apple_main(int argc, char *argv[])
 #else
 int main(int argc, char *argv[])
diff --git src/osx/osx.mm src/osx/osx.mm
index f84f874..b60d86d 100644
--- src/osx/osx.mm
+++ src/osx/osx.mm
@@ -31,12 +31,12 @@
   #include <gdk/quartz/gdkquartz-cocoa-access.h>
   }
 #endif
+#include <string>
