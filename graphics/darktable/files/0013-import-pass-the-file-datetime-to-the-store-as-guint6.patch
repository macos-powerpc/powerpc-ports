From 3e3865eb2b6e7269aed4dde536e9a228e6a0b9a3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 6 Sep 2026 15:30:32 +0000
Subject: [PATCH 13/14] import: pass the file datetime to the store as guint64

The file list store declares DT_IMPORT_DATETIME as G_TYPE_UINT64, but
the two insert calls pass a plain time_t. On a 32-bit host that is a
4-byte argument read as 8 bytes, so gtk picks up the next column id
from the wrong place and stops with "invalid column number", leaving
the date and thumbnail columns unset. Cast to guint64 at the call
sites; on 64-bit hosts this changes nothing.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017wUNQ69BaBcDfrxd6oXJeJ
---
 src/libs/import.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git src/libs/import.c src/libs/import.c
--- src/libs/import.c
+++ src/libs/import.c
@@ -387,7 +387,7 @@
                          DT_IMPORT_UI_FILENAME, file->filename,
                          DT_IMPORT_FILENAME, file->filename,
                          DT_IMPORT_UI_DATETIME, dt_txt,
-                         DT_IMPORT_DATETIME, datetime,
+                         DT_IMPORT_DATETIME, (guint64)datetime,
                          DT_IMPORT_THUMB, d->from.eye, -1);
       nb++;
       g_free(dt_txt);
@@ -861,7 +861,7 @@
                              DT_IMPORT_UI_FILENAME, &fullname[offset],
                              DT_IMPORT_FILENAME, fullname,
                              DT_IMPORT_UI_DATETIME, dt_txt,
-                             DT_IMPORT_DATETIME, datetime,
+                             DT_IMPORT_DATETIME, (guint64)datetime,
                              DT_IMPORT_THUMB, d->from.eye,
                              -1);
           d->from.nb++;
