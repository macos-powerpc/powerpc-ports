PortSystem                      1.0
PortGroup                       cmake           1.1
PortGroup                       github          1.0
PortGroup                       legacysupport   1.1

legacysupport.newest_darwin_requires_legacy 18
legacysupport.use_mp_libcxx     yes

github.setup                    AcademySoftwareFoundation openexr 3.5.3 v
revision                        2
categories                      graphics
license                         BSD
maintainers                     {mcalhoun @MarcusCalhoun-Lopez} {mascguy @mascguy} openmaintainer

description                     OpenEXR Graphics Library
long_description                OpenEXR is the professional-grade high dynamic range image \
                                storage format of the motion picture industry.
homepage                        https://www.openexr.com
checksums                       rmd160  b2d6db38b9ef6cc630bbbac9961ee68f6c103bbe \
                                sha256  aa84c2979d614a1bb5870da64d9fb4969deda8bf4f8166e7393bfd81e40af305 \
                                size    26460839
github.tarball_from             releases

# Backport, drop on next release:
patchfiles-append               e9e9fefc429904f412699199a5264bcba1e655ec.patch

# Python only used for tests
set py_ver                      3.14
set py_ver_nodot                [string map {. {}} ${py_ver}]

depends_build-append            path:bin/pkg-config:pkgconfig
depends_lib-append              port:imath \
                                port:libdeflate \
                                port:OpenJPH \
                                port:zstd

compiler.cxx_standard           2017

configure.args-append           -DBUILD_TESTING=OFF \
                                -DOPENEXR_BUILD_PYTHON=OFF

variant tests description "Enable test support" {
    depends_build-append        port:python${py_ver_nodot}

    configure.args-replace      -DBUILD_TESTING=OFF \
                                -DBUILD_TESTING=ON

    test.run                    yes
    test.target                 test
}

# Disable all optimizations newer than SSE3
if {${os.platform} eq "darwin" && ${os.major} < 11 && \
${configure.build_arch} in [list i386 x86_64]} {
    configure.args-append -DOPENEXR_IMF_HAVE_GCC_INLINE_ASM_AVX=OFF

    patchfiles-append early-intel-optimizations.diff
}

# only allow numbers, to avoid pre-release versions
github.livecheck.regex          {([0-9.]+)}
