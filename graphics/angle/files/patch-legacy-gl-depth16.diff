--- src/libANGLE/renderer/gl/formatutilsgl.cpp.orig
+++ src/libANGLE/renderer/gl/formatutilsgl.cpp
@@ -604,6 +604,17 @@
             // http://anglebug.com/42267264
             result = GL_BGRA8_EXT;
         }
+
+        // Drivers that have framebuffer objects only through GL_EXT_framebuffer_object commonly
+        // answer GL_FRAMEBUFFER_UNSUPPORTED when a 16-bit depth buffer is combined with a 32-bit
+        // color buffer (GeForce 6 and 7 series), and WebGL requires a framebuffer of an RGBA
+        // texture and a DEPTH_COMPONENT16 renderbuffer to be complete. More depth bits than asked
+        // for are allowed.
+        if (result == GL_DEPTH_COMPONENT16 && !functions->isAtLeastGL(gl::Version(3, 0)) &&
+            !functions->hasGLExtension("GL_ARB_framebuffer_object"))
+        {
+            result = GL_DEPTH_COMPONENT24;
+        }
     }
 
     return result;
