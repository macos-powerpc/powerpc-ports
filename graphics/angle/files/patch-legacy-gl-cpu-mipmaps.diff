+bool TextureGL::canGenerateMipmapOnCPU(const gl::Context *context) const
+{
+    const FunctionsGL *functions      = GetFunctionsGL(context);
+    const angle::FeaturesGL &features = GetFeaturesGL(context);
+
+    if ((getType() != gl::TextureType::_2D && getType() != gl::TextureType::CubeMap) ||
+        functions->getTexImage == nullptr)
+    {
+        return false;
+    }
+
+    const gl::InternalFormat &baseLevelInternalFormat = *mState.getBaseLevelDesc().format.info;
+    const angle::Format &format                       = angle::Format::Get(
+        angle::Format::InternalFormatToID(baseLevelInternalFormat.sizedInternalFormat));
+    if (format.mipGenerationFunction == nullptr || format.isBlock || format.depthBits > 0 ||
+        format.stencilBits > 0)
+    {
+        return false;
+    }
+
+    // The native texture must hold the data in the layout the mip function expects.
+    const LevelInfoGL &baseLevelInfo = getBaseLevelInfo();
+    if (baseLevelInfo.depthStencilWorkaround || baseLevelInfo.lumaWorkaround.enabled ||
+        baseLevelInfo.emulatedAlphaChannel)
+    {
+        return false;
+    }
+    const nativegl::TexSubImageFormat transfer = nativegl::GetTexSubImageFormat(
+        functions, features, baseLevelInternalFormat.format, baseLevelInternalFormat.type);
+    const gl::InternalFormat &transferFormat =
+        gl::GetInternalFormatInfo(transfer.format, transfer.type);
+    return transferFormat.internalFormat != GL_NONE &&
+           transferFormat.pixelBytes == format.pixelBytes;
+}
+
+// Reads the base level back and filters the other levels with the CPU.  Costs a readback (about
+// 20 ms on Mac OS X 10.5 whatever the size) per face, but needs neither glGenerateMipmap nor
+// rendering into the small levels.
+angle::Result TextureGL::generateMipmapOnCPU(const gl::Context *context)
+{
+    ContextGL *contextGL              = GetImplAs<ContextGL>(context);
+    const FunctionsGL *functions      = GetFunctionsGL(context);
+    StateManagerGL *stateManager      = GetStateManagerGL(context);
+    const angle::FeaturesGL &features = GetFeaturesGL(context);
+
+    const GLuint effectiveBaseLevel                   = mState.getEffectiveBaseLevel();
+    const GLuint maxLevel                             = mState.getMipmapMaxLevel();
+    const gl::ImageDesc &baseLevelDesc                = mState.getBaseLevelDesc();
+    const gl::InternalFormat &baseLevelInternalFormat = *baseLevelDesc.format.info;
+    const angle::Format &format                       = angle::Format::Get(
+        angle::Format::InternalFormatToID(baseLevelInternalFormat.sizedInternalFormat));
+    // The data travels in the format and type of the base level, and the new levels get its
+    // native internal format.
+    const nativegl::TexSubImageFormat transfer = nativegl::GetTexSubImageFormat(
+        functions, features, baseLevelInternalFormat.format, baseLevelInternalFormat.type);
+    const GLenum nativeInternalFormat = getBaseLevelInfo().nativeInternalFormat;
+
+    // Tightly packed rows, client memory on both sides.
+    gl::PixelPackState packState;
+    packState.alignment = 1;
+    ANGLE_TRY(stateManager->setPixelPackState(context, packState));
+    ANGLE_TRY(stateManager->setPixelPackBuffer(context, nullptr));
+    gl::PixelUnpackState unpackState;
+    unpackState.alignment = 1;
+    ANGLE_TRY(stateManager->setPixelUnpackState(context, unpackState));
+    ANGLE_TRY(stateManager->setPixelUnpackBuffer(context, nullptr));
+
+    stateManager->bindTexture(getType(), mTextureID);
+
+    const size_t pixelBytes = format.pixelBytes;
+    const size_t baseWidth  = static_cast<size_t>(baseLevelDesc.size.width);
+    const size_t baseHeight = static_cast<size_t>(baseLevelDesc.size.height);
+
+    std::vector<gl::TextureTarget> targets;
+    if (getType() == gl::TextureType::CubeMap)
+    {
+        for (gl::TextureTarget face : gl::AllCubeFaceTextureTargets())
+        {
+            targets.push_back(face);
+        }
+    }
+    else
+    {
+        targets.push_back(gl::NonCubeTextureTypeToTarget(getType()));
+    }
+
+    angle::MemoryBuffer source;
+    angle::MemoryBuffer destination;
+    for (gl::TextureTarget target : targets)
+    {
+        ANGLE_CHECK_GL_ALLOC(contextGL, source.resize(baseWidth * baseHeight * pixelBytes));
+        ANGLE_GL_TRY(context, functions->getTexImage(
+                                  ToGLenum(target), static_cast<GLint>(effectiveBaseLevel),
+                                  transfer.format, transfer.type, source.data()));
+
+        size_t width  = baseWidth;
+        size_t height = baseHeight;
+        for (GLuint level = effectiveBaseLevel + 1; level <= maxLevel; ++level)
+        {
+            const size_t mipWidth  = std::max<size_t>(width / 2, 1);
+            const size_t mipHeight = std::max<size_t>(height / 2, 1);
+            ANGLE_CHECK_GL_ALLOC(contextGL, destination.resize(mipWidth * mipHeight * pixelBytes));
+            format.mipGenerationFunction(width, height, 1, source.data(), width * pixelBytes,
+                                         width * height * pixelBytes, destination.data(),
+                                         mipWidth * pixelBytes, mipWidth * mipHeight * pixelBytes);
+
+            if (mState.getImmutableFormat())
+            {
+                ANGLE_GL_TRY(context,
+                             functions->texSubImage2D(
+                                 ToGLenum(target), static_cast<GLint>(level), 0, 0,
+                                 static_cast<GLsizei>(mipWidth), static_cast<GLsizei>(mipHeight),
+                                 transfer.format, transfer.type, destination.data()));
+            }
+            else
+            {
+                ANGLE_GL_TRY_ALWAYS_CHECK(
+                    context, functions->texImage2D(
+                                 ToGLenum(target), static_cast<GLint>(level), nativeInternalFormat,
+                                 static_cast<GLsizei>(mipWidth), static_cast<GLsizei>(mipHeight), 0,
+                                 transfer.format, transfer.type, destination.data()));
+            }
+
+            std::swap(source, destination);
+            width  = mipWidth;
+            height = mipHeight;
+        }
+    }
+
+    return angle::Result::Continue;
+}
