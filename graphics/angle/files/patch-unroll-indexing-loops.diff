+//
+// UnrollIndexingLoops.h: Unroll for loops whose loop index is used to index an array or a matrix,
+// so that every such index becomes a constant.  Works around GLSL compilers that cannot index
+// arrays dynamically in fragment shaders (Mac OS X 10.5 on GeForce 6/7: the draw writes nothing).
+//
+// Only loops of the ESSL 1.00 Appendix A form are unrolled:
+//
+//     for (int i = constant; i relop constant; i++, i--, ++i, --i, i += constant or i -= constant)
+//
+// where i is not written in the body.  break and continue are rewritten with flags, so the result
+// contains no loop.  Constant indices produced this way are clamped to the size of the indexed
+// array, as ClampIndirectIndices would have done at run time.
+//
+
