+#define COMPILER_TRANSLATOR_TREEOPS_UNROLLINDEXINGLOOPS_H_
+
+#include "common/angleutils.h"
+
+namespace sh
+{
+
+class TCompiler;
+class TIntermBlock;
+class TSymbolTable;
+
+[[nodiscard]] bool UnrollIndexingLoops(TCompiler *compiler,
+                                       TIntermBlock *root,
+                                       TSymbolTable *symbolTable);
+
+}  // namespace sh
+
+#endif  // COMPILER_TRANSLATOR_TREEOPS_UNROLLINDEXINGLOOPS_H_
