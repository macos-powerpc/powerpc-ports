+/*
+ * Qt4 compatibility shims.
+ *
+ * Converseen targets Qt5/Qt6, but the Qt5-only surface it relies on is small
+ * enough to emulate. This header provides the missing pieces when building
+ * against Qt4; under Qt5 and Qt6 it expands to nothing.
+ */
+
+#ifndef QT4COMPAT_H
+#define QT4COMPAT_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(5, 0, 0)
+
+#include <QCoreApplication>
+#include <QDesktopServices>
+#include <QDir>
+#include <QMap>
+#include <QString>
+#include <QStringList>
+#include <QTextStream>
+
+#include <cstdio>
+#include <cstdlib>
+
+/*
+ * Platform macros: Qt 5.0 introduced Q_OS_OSX and Qt 5.4 Q_OS_MACOS, both
+ * spelled Q_OS_MAC (or Q_OS_MACX) in Qt4.
+ */
+#if defined(Q_OS_MAC)
+#  ifndef Q_OS_MACOS
+#    define Q_OS_MACOS
+#  endif
+#  ifndef Q_OS_OSX
+#    define Q_OS_OSX
+#  endif
+#endif
+
+/*
+ * QStandardPaths (Qt 5.0). Only the locations Converseen actually asks for are
+ * resolved properly; anything else falls back to Qt4's DataLocation.
+ */
+class QStandardPaths
+{
+public:
+    enum StandardLocation {
+        DesktopLocation,
+        DocumentsLocation,
+        FontsLocation,
+        ApplicationsLocation,
+        MusicLocation,
+        MoviesLocation,
+        PicturesLocation,
+        TempLocation,
+        HomeLocation,
+        AppLocalDataLocation,
+        CacheLocation,
+        GenericDataLocation,
+        RuntimeLocation,
+        ConfigLocation,
+        DownloadLocation,
+        GenericCacheLocation,
+        GenericConfigLocation,
+        AppDataLocation,
+        AppConfigLocation
+    };
+
+    static QString writableLocation(StandardLocation type)
+    {
+        switch (type) {
+        case ConfigLocation:
+        case GenericConfigLocation:
+        case AppConfigLocation:
+#if defined(Q_OS_WIN)
+            return QDesktopServices::storageLocation(QDesktopServices::DataLocation);
+#elif defined(Q_OS_MAC)
+            return QDir::homePath() + QLatin1String("/Library/Preferences");
+#else
+        {
+            const QString xdgConfigHome =
+                QString::fromLocal8Bit(qgetenv("XDG_CONFIG_HOME"));
+
+            return xdgConfigHome.isEmpty()
+                ? QDir::homePath() + QLatin1String("/.config")
+                : xdgConfigHome;
+        }
+#endif
+        case HomeLocation:
+            return QDir::homePath();
+
+        case TempLocation:
+            return QDir::tempPath();
+
+        default:
+            return QDesktopServices::storageLocation(QDesktopServices::DataLocation);
+        }
+    }
+
+    static QStringList standardLocations(StandardLocation type)
+    {
+        return QStringList() << writableLocation(type);
+    }
+};
+
+/*
+ * QCommandLineOption / QCommandLineParser (Qt 5.2), reduced to the subset
+ * Converseen uses: named options with an optional value, --help and --version.
+ */
+class QCommandLineOption
+{
+public:
+    // Qt4's QList requires a default-constructible value type.
+    QCommandLineOption() {}
+
+    QCommandLineOption(const QStringList &names,
+                       const QString &description = QString(),
+                       const QString &valueName = QString())
+        : m_names(names)
+        , m_description(description)
+        , m_valueName(valueName)
+    {
+    }
+
+    QCommandLineOption(const QString &name,
+                       const QString &description = QString(),
+                       const QString &valueName = QString())
+        : m_names(QStringList(name))
+        , m_description(description)
+        , m_valueName(valueName)
+    {
+    }
+
+    QStringList names() const { return m_names; }
+    QString description() const { return m_description; }
+    QString valueName() const { return m_valueName; }
+
+private:
+    QStringList m_names;
+    QString m_description;
+    QString m_valueName;
+};
+
+class QCommandLineParser
+{
+public:
+    QCommandLineParser()
+        : m_helpAdded(false)
+        , m_versionAdded(false)
+    {
+    }
+
+    void setApplicationDescription(const QString &description)
+    {
+        m_description = description;
+    }
+
+    QString applicationDescription() const { return m_description; }
+
+    bool addOption(const QCommandLineOption &option)
+    {
+        m_options.append(option);
+        return true;
+    }
+
+    QCommandLineOption addHelpOption()
+    {
+        QCommandLineOption option(QStringList() << QLatin1String("h") << QLatin1String("help"),
+                                  QLatin1String("Displays this help."));
+        m_options.append(option);
+        m_helpAdded = true;
+
+        return option;
+    }
+
+    QCommandLineOption addVersionOption()
+    {
+        QCommandLineOption option(QStringList() << QLatin1String("v") << QLatin1String("version"),
+                                  QLatin1String("Displays version information."));
+        m_options.append(option);
+        m_versionAdded = true;
+
+        return option;
+    }
+
+    void process(const QCoreApplication &app)
+    {
+        process(app.arguments());
+    }
+
+    void process(const QStringList &arguments)
+    {
+        for (int i = 1; i < arguments.count(); i++) {
+            QString argument = arguments.at(i);
+
+            if (!argument.startsWith(QLatin1Char('-'))) {
+                m_positionalArguments.append(argument);
+                continue;
+            }
+
+            while (argument.startsWith(QLatin1Char('-')))
+                argument.remove(0, 1);
+
+            QString inlineValue;
+            bool hasInlineValue = false;
+
+            const int separator = argument.indexOf(QLatin1Char('='));
+
+            if (separator >= 0) {
+                inlineValue = argument.mid(separator + 1);
+                argument = argument.left(separator);
+                hasInlineValue = true;
+            }
+
+            const QCommandLineOption *option = findOption(argument);
+
+            /*
+             * Unknown options are ignored rather than fatal: on macOS the
+             * Finder appends a -psn_x_y process serial number to argv, and
+             * bailing out there would stop the bundle from launching.
+             */
+            if (!option)
+                continue;
+
+            const QString key = option->names().first();
+
+            if (option->valueName().isEmpty())
+                m_values.insert(key, QString());
+            else if (hasInlineValue)
+                m_values.insert(key, inlineValue);
+            else if (i + 1 < arguments.count())
+                m_values.insert(key, arguments.at(++i));
+            else
+                m_values.insert(key, QString());
+        }
+
+        if (m_helpAdded && m_values.contains(QLatin1String("h")))
+            showHelp(0);
+
+        if (m_versionAdded && m_values.contains(QLatin1String("v"))) {
+            QTextStream(stdout) << QCoreApplication::applicationName()
+                                << QLatin1Char(' ')
+                                << QCoreApplication::applicationVersion()
+                                << endl;
+            ::exit(0);
+        }
+    }
+
+    bool isSet(const QCommandLineOption &option) const
+    {
+        return m_values.contains(option.names().first());
+    }
+
+    QString value(const QCommandLineOption &option) const
+    {
+        return m_values.value(option.names().first());
+    }
+
+    QStringList positionalArguments() const { return m_positionalArguments; }
+
+    void showHelp(int exitCode = 0)
+    {
+        QTextStream out(stdout);
+
+        out << QLatin1String("Usage: ") << QCoreApplication::applicationFilePath()
+            << QLatin1String(" [options]") << endl;
+
+        if (!m_description.isEmpty())
+            out << m_description << endl;
+
+        out << endl << QLatin1String("Options:") << endl;
+
+        for (int i = 0; i < m_options.count(); i++) {
+            const QCommandLineOption &option = m_options.at(i);
+            QStringList flags = option.names();
+
+            for (int n = 0; n < flags.count(); n++)
+                flags[n] = (flags.at(n).length() == 1 ? QLatin1String("-") : QLatin1String("--"))
+                           + flags.at(n);
+
+            QString entry = QLatin1String("  ") + flags.join(QLatin1String(", "));
+
+            if (!option.valueName().isEmpty())
+                entry += QLatin1String(" <") + option.valueName() + QLatin1Char('>');
+
+            out << entry;
+
+            if (!option.description().isEmpty()) {
+                if (entry.length() < 32)
+                    out << QString(32 - entry.length(), QLatin1Char(' '));
+                else
+                    out << endl << QString(32, QLatin1Char(' '));
+
+                out << option.description();
+            }
+
+            out << endl;
+        }
+
+        ::exit(exitCode);
+    }
+
+private:
+    const QCommandLineOption *findOption(const QString &name) const
+    {
+        for (int i = 0; i < m_options.count(); i++) {
+            if (m_options.at(i).names().contains(name))
+                return &m_options.at(i);
+        }
+
+        return 0;
+    }
+
+    QString m_description;
+    QList<QCommandLineOption> m_options;
+    QMap<QString, QString> m_values;
+    QStringList m_positionalArguments;
+    bool m_helpAdded;
+    bool m_versionAdded;
+};
+
+#endif // QT_VERSION < 5.0.0
+
+#endif // QT4COMPAT_H
