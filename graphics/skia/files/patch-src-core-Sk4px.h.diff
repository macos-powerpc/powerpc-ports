--- src/core/Sk4px.h.orig
+++ src/core/Sk4px.h
@@ -27,7 +27,10 @@
 
     // RGBA rgba XYZW xyzw -> AAAA aaaa WWWW wwww
     Sk4px alphas() const {
-        static_assert(SK_A32_SHIFT == 24, "This method assumes little-endian.");
+        // fV holds pixels as they sit in memory. Alpha is the last byte of each pixel on either
+        // byte order: SK_A32_SHIFT is 24 on little endian and 0 on big endian (see SkTypes.h).
+        static_assert(SK_PMCOLOR_BYTE_ORDER(R,G,B,A) || SK_PMCOLOR_BYTE_ORDER(B,G,R,A),
+                      "This method assumes alpha is the last byte of an SkPMColor in memory.");
         return Sk4px(skvx::shuffle<3,3,3,3, 7,7,7,7, 11,11,11,11, 15,15,15,15>(fV));
     }
     Sk4px inv() const { return Sk4px(skvx::byte16(255) - fV); }
