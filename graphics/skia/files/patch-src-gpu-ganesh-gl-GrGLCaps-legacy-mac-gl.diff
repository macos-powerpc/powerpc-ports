--- src/gpu/ganesh/gl/GrGLCaps.cpp.orig
+++ src/gpu/ganesh/gl/GrGLCaps.cpp
@@ -4193,6 +4193,24 @@
     if (ctxInfo.vendor() == GrGLVendor::kNVIDIA) {
         fPerformColorClearsAsDraws = true;
     }
+    // Desktop OpenGL below 3.0 on macOS: the OpenGL 2 drivers of the PowerPC Macs (10.5, and 10.6
+    // on PowerPC; Intel Macs on 10.6 get this too and only lose asynchronous readback). With the
+    // drivers of Mac OS X 10.5.8 on a GeForce 6600 (GL 2.0, GLSL 1.20), measured: a readback into
+    // a pixel buffer object with GL_PACK_ROW_LENGTH or a pixel offset makes the card DMA into an
+    // unmapped page (DART exception, then a stall of about 30 s); the pixel buffer path ignores
+    // GL_PACK_ROW_LENGTH for BGRA; a pbuffer read with GL_PACK_SKIP_* came out wrong; and a
+    // readback into a pixel buffer is as synchronous as a plain glReadPixels. So: no transfer
+    // buffers and no pack row length. Every readback is one plain glReadPixels into tight rows
+    // (Skia reads through a scratch buffer when the caller's rows are not tight). Gated on the GL
+    // version because Skia cannot parse a driver version from "2.0 NVIDIA-1.5.48". Uploads are
+    // left as they are. Details: darwin/gl-drivers.md of the powerpc-ports work ("option A").
+    if (GR_IS_GR_GL(ctxInfo.standard()) && ctxInfo.version() < GR_GL_VER(3, 0)) {
+        fTransferBufferType = TransferBufferType::kNone;
+        fTransferFromBufferToTextureSupport = false;
+        fTransferFromSurfaceToBufferSupport = false;
+        fTransferFromBufferToBufferSupport = false;
+        fReadPixelsRowBytesSupport = false;
+    }
 #endif
 
