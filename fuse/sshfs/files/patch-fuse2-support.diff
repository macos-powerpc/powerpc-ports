diff -ruN sshfs-3.7.7.orig/compat/fuse2_compat.c sshfs-3.7.7/compat/fuse2_compat.c
--- sshfs-3.7.7.orig/compat/fuse2_compat.c
+++ sshfs-3.7.7/compat/fuse2_compat.c
@@ -0,0 +1,190 @@
+/*
+  The part of the libfuse 3 API that sshfs uses, on top of libfuse 2
+
+  This program can be distributed under the terms of the GNU GPL.
+  See the file COPYING.
+*/
+
+#include "fuse2_compat.h"
+
+#undef fuse_operations
+#undef fuse_fill_dir_t
+
+#include <fuse_lowlevel.h>
+#include <stdio.h>
+#include <string.h>
+
+static const struct fuse3_operations *next_oper;
+
+struct fill_dir_buf {
+	void *buf;
+	fuse_fill_dir_t filler;
+};
+
+static void *fuse2_init(struct fuse_conn_info *conn)
+{
+	struct fuse_config cfg;
+
+	memset(&cfg, 0, sizeof(cfg));
+	return next_oper->init(conn, &cfg);
+}
+
+static int fuse2_getattr(const char *path, struct stat *stbuf)
+{
+	return next_oper->getattr(path, stbuf, NULL);
+}
+
+static int fuse2_fgetattr(const char *path, struct stat *stbuf,
+			  struct fuse_file_info *fi)
+{
+	return next_oper->getattr(path, stbuf, fi);
+}
+
+static int fuse2_rename(const char *from, const char *to)
+{
+	return next_oper->rename(from, to, 0);
+}
+
+static int fuse2_chmod(const char *path, mode_t mode)
+{
+	return next_oper->chmod(path, mode, NULL);
+}
+
+static int fuse2_chown(const char *path, uid_t uid, gid_t gid)
+{
+	return next_oper->chown(path, uid, gid, NULL);
+}
+
+static int fuse2_truncate(const char *path, off_t size)
+{
+	return next_oper->truncate(path, size, NULL);
+}
+
+static int fuse2_ftruncate(const char *path, off_t size,
+			   struct fuse_file_info *fi)
+{
+	return next_oper->truncate(path, size, fi);
+}
+
+static int fuse2_utimens(const char *path, const struct timespec tv[2])
+{
+	return next_oper->utimens(path, tv, NULL);
+}
+
+static int fuse2_fill_dir(void *buf, const char *name,
+			  const struct stat *stbuf, off_t off,
+			  enum fuse_fill_dir_flags flags)
+{
+	struct fill_dir_buf *d = buf;
+
+	(void) flags;
+	return d->filler(d->buf, name, stbuf, off);
+}
+
+static int fuse2_readdir(const char *path, void *buf, fuse_fill_dir_t filler,
+			 off_t offset, struct fuse_file_info *fi)
+{
+	struct fill_dir_buf d = { buf, filler };
+
+	return next_oper->readdir(path, &d, fuse2_fill_dir, offset, fi, 0);
+}
+
+static void fuse2_fill_ops(struct fuse_operations *op,
+			   const struct fuse3_operations *n)
+{
+	memset(op, 0, sizeof(*op));
+	op->getattr     = n->getattr ? fuse2_getattr : NULL;
+	op->fgetattr    = n->getattr ? fuse2_fgetattr : NULL;
+	op->readlink    = n->readlink;
+	op->mknod       = n->mknod;
+	op->mkdir       = n->mkdir;
+	op->unlink      = n->unlink;
+	op->rmdir       = n->rmdir;
+	op->symlink     = n->symlink;
+	op->rename      = n->rename ? fuse2_rename : NULL;
+	op->link        = n->link;
+	op->chmod       = n->chmod ? fuse2_chmod : NULL;
+	op->chown       = n->chown ? fuse2_chown : NULL;
+	op->truncate    = n->truncate ? fuse2_truncate : NULL;
+	op->ftruncate   = n->truncate ? fuse2_ftruncate : NULL;
+	op->open        = n->open;
+	op->read        = n->read;
+	op->write       = n->write;
+	op->statfs      = n->statfs;
+	op->flush       = n->flush;
+	op->release     = n->release;
+	op->fsync       = n->fsync;
+	op->setxattr    = n->setxattr;
+	op->getxattr    = n->getxattr;
+	op->listxattr   = n->listxattr;
+	op->removexattr = n->removexattr;
+	op->opendir     = n->opendir;
+	op->readdir     = n->readdir ? fuse2_readdir : NULL;
+	op->releasedir  = n->releasedir;
+	op->init        = n->init ? fuse2_init : NULL;
+	op->access      = n->access;
+	op->create      = n->create;
+	op->utimens     = n->utimens ? fuse2_utimens : NULL;
+	op->flag_utime_omit_ok = 1;
+}
+
+struct fuse *fuse2_new(struct fuse_args *args, const char *mountpoint,
+		       const struct fuse3_operations *op)
+{
+	struct fuse_operations fuse2_oper;
+	struct fuse_chan *ch;
+	struct fuse *fuse;
+
+	next_oper = op;
+	fuse2_fill_ops(&fuse2_oper, op);
+
+	ch = fuse_mount(mountpoint, args);
+	if (ch == NULL)
+		return NULL;
+
+	fuse = fuse_new(ch, args, &fuse2_oper, sizeof(fuse2_oper), NULL);
+	if (fuse == NULL)
+		fuse_unmount(mountpoint, ch);
+
+	return fuse;
+}
+
+void fuse2_unmount(struct fuse *fuse, const char *mountpoint)
+{
+	struct fuse_session *se = fuse_get_session(fuse);
+
+	fuse_unmount(mountpoint, fuse_session_next_chan(se, NULL));
+}
+
+int fuse2_session_fd(struct fuse_session *se)
+{
+	return fuse_chan_fd(fuse_session_next_chan(se, NULL));
+}
+
+/*
+ * libfuse 2 prints its option help and version from the option parsers of
+ * fuse_mount() and fuse_new(), which then return without mounting.
+ */
+void fuse2_lib_help(struct fuse_args *args)
+{
+	struct fuse_operations fuse2_oper;
+
+	fflush(stdout);
+	memset(&fuse2_oper, 0, sizeof(fuse2_oper));
+	if (fuse_opt_add_arg(args, "-h") == -1)
+		return;
+	fuse_mount(NULL, args);
+	fuse_new(NULL, args, &fuse2_oper, sizeof(fuse2_oper), NULL);
+}
+
+void fuse2_lowlevel_version(void)
+{
+	char argv0[] = "";
+	char argv1[] = "--version";
+	char *argv[] = { argv0, argv1, NULL };
+	struct fuse_args args = FUSE_ARGS_INIT(2, argv);
+
+	fflush(stdout);
+	fuse_mount(NULL, &args);
+	fuse_opt_free_args(&args);
+}
diff -ruN sshfs-3.7.7.orig/compat/fuse2_compat.h sshfs-3.7.7/compat/fuse2_compat.h
--- sshfs-3.7.7.orig/compat/fuse2_compat.h
+++ sshfs-3.7.7/compat/fuse2_compat.h
@@ -0,0 +1,86 @@
+/*
+  The part of the libfuse 3 API that sshfs uses, on top of libfuse 2
+
+  This program can be distributed under the terms of the GNU GPL.
+  See the file COPYING.
+*/
+
+#ifndef _FUSE2_COMPAT_
+#define _FUSE2_COMPAT_
+
+#include <fuse.h>
+#include <fuse_opt.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <time.h>
+
+enum fuse_readdir_flags {
+	FUSE_READDIR_PLUS = (1 << 0)
+};
+
+enum fuse_fill_dir_flags {
+	FUSE_FILL_DIR_PLUS = (1 << 1)
+};
+
+typedef int (*fuse3_fill_dir_t) (void *buf, const char *name,
+				 const struct stat *stbuf, off_t off,
+				 enum fuse_fill_dir_flags flags);
+
+struct fuse_config {
+	int nullpath_ok;
+};
+
+#define FUSE2_OP_TYPE(op) __typeof__(((struct fuse_operations *) 0)->op)
+
+struct fuse3_operations {
+	int (*getattr) (const char *, struct stat *, struct fuse_file_info *);
+	int (*readlink) (const char *, char *, size_t);
+	int (*mknod) (const char *, mode_t, dev_t);
+	int (*mkdir) (const char *, mode_t);
+	int (*unlink) (const char *);
+	int (*rmdir) (const char *);
+	int (*symlink) (const char *, const char *);
+	int (*rename) (const char *, const char *, unsigned int);
+	int (*link) (const char *, const char *);
+	int (*chmod) (const char *, mode_t, struct fuse_file_info *);
+	int (*chown) (const char *, uid_t, gid_t, struct fuse_file_info *);
+	int (*truncate) (const char *, off_t, struct fuse_file_info *);
+	int (*open) (const char *, struct fuse_file_info *);
+	int (*read) (const char *, char *, size_t, off_t,
+		     struct fuse_file_info *);
+	int (*write) (const char *, const char *, size_t, off_t,
+		      struct fuse_file_info *);
+	int (*statfs) (const char *, struct statvfs *);
+	int (*flush) (const char *, struct fuse_file_info *);
+	int (*release) (const char *, struct fuse_file_info *);
+	int (*fsync) (const char *, int, struct fuse_file_info *);
+	FUSE2_OP_TYPE(setxattr) setxattr;
+	FUSE2_OP_TYPE(getxattr) getxattr;
+	FUSE2_OP_TYPE(listxattr) listxattr;
+	FUSE2_OP_TYPE(removexattr) removexattr;
+	int (*opendir) (const char *, struct fuse_file_info *);
+	int (*readdir) (const char *, void *, fuse3_fill_dir_t, off_t,
+			struct fuse_file_info *, enum fuse_readdir_flags);
+	int (*releasedir) (const char *, struct fuse_file_info *);
+	void *(*init) (struct fuse_conn_info *, struct fuse_config *);
+	int (*access) (const char *, int);
+	int (*create) (const char *, mode_t, struct fuse_file_info *);
+	int (*utimens) (const char *, const struct timespec tv[2],
+			struct fuse_file_info *);
+};
+
+#undef FUSE2_OP_TYPE
+
+/* Mounts the file system and creates its struct fuse */
+struct fuse *fuse2_new(struct fuse_args *args, const char *mountpoint,
+		       const struct fuse3_operations *op);
+void fuse2_unmount(struct fuse *fuse, const char *mountpoint);
+int fuse2_session_fd(struct fuse_session *se);
+void fuse2_lib_help(struct fuse_args *args);
+void fuse2_lowlevel_version(void);
+
+#define fuse_operations fuse3_operations
+#define fuse_fill_dir_t fuse3_fill_dir_t
+
+#endif /* _FUSE2_COMPAT_ */
