PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           gitlab 1.0
PortGroup           legacysupport 1.1
PortGroup           LTO 1.0
PortGroup           openssl 1.0

# getline, utimensat
legacysupport.newest_darwin_requires_legacy 16

gitlab.setup        Remmina Remmina 1.4.43 v
name                [string tolower ${gitlab.project}]
revision            0
categories          gnome net
license             LGPL-2.1+
maintainers         openmaintainer
platforms           darwin linux
description         The GTK Remmina Remote Desktop Client
long_description    Remmina remote desktop client \
                    Use other desktops remotely, from a tiny screen or large monitors. \
                    RDP, VNC, SPICE, X2Go, SSH, WWW (HTTP protocol) and EXEC network protocols are supported.
checksums           rmd160  dca09e1281c00a93476a6ebb7cbf3d3bd957be62 \
                    sha256  4aaa44adc892af557c1d4445e1ce935731baf26934849012313e99d5a9da49c4 \
                    size    2265198

depends_build-append \
                    port:libxml2 \
                    path:bin/pkg-config:pkgconfig

depends_lib-append  path:lib/pkgconfig/cairo.pc:cairo \
                    port:FreeRDP \
                    path:lib/pkgconfig/gdk-pixbuf-2.0.pc:gdk-pixbuf2 \
                    path:lib/pkgconfig/glib-2.0.pc:glib2 \
                    path:lib/pkgconfig/gtk+-3.0.pc:gtk3 \
                    path:lib/pkgconfig/harfbuzz.pc:harfbuzz \
                    port:json-glib \
                    port:libgcrypt \
                    port:libsecret \
                    port:libsodium \
                    port:libssh \
                    port:LibVNCServer \
                    path:lib/pkgconfig/pango.pc:pango \
                    port:pcre2 \
                    port:vte

# TODO: enable wayland for macOS.
platform linux {
    depends_build-append \
                    port:wayland-protocols
    depends_lib-append \
                    port:avahi \
                    port:wayland
}

compiler.cxx_standard   2011

patch.pre_args-replace  -p0 -p1
# tweak the cleverness around CMAKE_BUILD_TYPE
# and make certain to link in our libwayland-client on Linux
patchfiles-append   patch-cmake-mp.diff

configure.args-append \
                    -DWITH_EXAMPLES=OFF \
                    -DWITH_ICON_CACHE=OFF \
                    -DWITH_KF5WALLET=OFF \
                    -DHAVE_LIBAPPINDICATOR=OFF \
                    -DWITH_NEWS=OFF \
                    -DWITH_PYTHONLIBS=OFF \
                    -DWITH_SPICE=OFF \
                    -DWITH_TIP=OFF \
                    -DWITH_UPDATE_DESKTOP_DB=OFF \
                    -DWITH_WEBKIT2GTK=OFF \
                    -DWITH_WWW=OFF

variant spice description "Build support for the Spice protocol" {
    depends_lib-append \
                    port:spice-gtk
    configure.args-replace \
                    -DWITH_SPICE=OFF \
                    -DWITH_SPICE=ON
}

# gobject-introspection uses g-ir-scanner, which uses $CC from env
if {${universal_possible} && [variant_isset universal]} {
    foreach arch ${configure.universal_archs} {
        lappend merger_build_env(${arch}) \
                    "CC=${configure.cc} -arch ${arch}"
        lappend merger_destroot_env(${arch}) \
                    "CC=${configure.cc} -arch ${arch}"
    }
} else {
    build.env-append \
                    "CC=${configure.cc} ${configure.cc_archflags}"
    destroot.env-append \
                    "CC=${configure.cc} ${configure.cc_archflags}"
}

post-activate {
    if {${os.platform} eq "darwin"} {
        system "${prefix}/bin/update-mime-database ${prefix}/share/mime"
        system "${prefix}/bin/gtk-update-icon-cache -f -t ${prefix}/share/icons/hicolor"
    } else {
        catch {system "xdg-icon-resource forceupdate --theme hicolor"}
        system "env XDG_DATA_DIRS=${prefix}/share ${prefix}/bin/update-mime-database -V ${prefix}/share/mime"
    }
}
