--- meson.build	2026-07-25 02:28:22.000000000 +0800
+++ meson.build	2026-08-03 02:33:07.000000000 +0800
@@ -213,7 +213,16 @@
     wayland_client_dep = dependency('', required: false)
 endif
 if macos_display_enabled
-    coregraphics_dep = dependency('appleframeworks', modules: ['CoreGraphics'])
+    if cc.get_id() == 'gcc'
+        # Meson's 'appleframeworks' does not work with gcc,
+        # and on older macOS CoreGraphics can't be linked directly,
+        # so link to ApplicationServices instead.
+        coregraphics_dep = declare_dependency(
+            link_args: ['-framework', 'ApplicationServices'],
+        )
+    else
+        coregraphics_dep = dependency('appleframeworks', modules: ['CoreGraphics'])
+    endif
 else
     coregraphics_dep = dependency('', required: false)
 endif
