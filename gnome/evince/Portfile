# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           active_variants 1.1
PortGroup           gobject_introspection 1.0
PortGroup           legacysupport 1.1
PortGroup           meson 1.0
PortGroup           yelp 1.0

# O_CLOEXEC, at least
legacysupport.newest_darwin_requires_legacy 10

name                evince
set branch          48
version             ${branch}.4
revision            0
license             GPL-2+
description         Evince is a document viewer for multiple document formats like pdf, and many others.
long_description    {*}${description}
maintainers         {devans @dbevans} openmaintainer
categories          gnome print
homepage            https://wiki.gnome.org/Apps/Evince
master_sites        gnome:sources/${name}/${branch}/

use_xz              yes

checksums           rmd160  db2f033aa142c61076d768dda86edd3ad55c00d9 \
                    sha256  f296c5c662886635d4cd597e8ac0afcde7982be4486533c2b7f095b268be8668 \
                    size    2940896

meson.wrap_mode     nodownload

patchfiles          F_DUPFD_CLOEXEC.patch \
                    dvi-backend.patch

depends_build-append \
                    port:appstream-glib \
                    port:gettext \
                    port:gi-docgen \
                    port:gtk-doc \
                    port:itstool \
                    path:bin/pkg-config:pkgconfig

depends_lib-append  port:adwaita-icon-theme \
                    path:lib/pkgconfig/cairo.pc:cairo \
                    path:lib/pkgconfig/gdk-pixbuf-2.0.pc:gdk-pixbuf2 \
                    port:gettext-runtime \
                    path:lib/pkgconfig/glib-2.0.pc:glib2 \
                    port:gsettings-desktop-schemas \
                    port:gspell \
                    path:lib/pkgconfig/gtk+-3.0.pc:gtk3 \
                    port:hicolor-icon-theme \
                    port:libarchive \
                    port:libiconv \
                    port:libgxps \
                    port:libhandy \
                    port:libsecret \
                    port:libspectre \
                    port:libxml2 \
                    path:lib/pkgconfig/pango.pc:pango \
                    path:lib/pkgconfig/poppler.pc:poppler \
                    port:tiff \
                    port:zlib

depends_run-append  port:desktop-file-utils

compiler.cxx_standard   2011

gobject_introspection   yes
# The PG still passes incorrect form:
pre-configure {
    configure.args-replace  -Dintrospection=enabled -Dintrospection=true
}

configure.args-append \
                    -Dcomics=enabled \
                    -Ddbus=false \
                    -Ddjvu=disabled \
                    -Ddvi=disabled \
                    -Dgspell=enabled \
                    -Dgtk_doc=false \
                    -Dintrospection=true \
                    -Dkeyring=enabled \
                    -Dmultimedia=disabled \
                    -Dnautilus=false \
                    -Dpdf=enabled \
                    -Dps=enabled \
                    -Dsystemduserunitdir=no \
                    -Dthumbnail_cache=disabled \
                    -Dtiff=enabled \
                    -Duser_doc=true \
                    -Dxps=enabled

# ev-sidebar-links.c:345:36: error: passing argument 1 of 'gtk_menu_attach_to_widget'
# from incompatible pointer type [-Wincompatible-pointer-types]
# https://trac.macports.org/ticket/71965
configure.cflags-append \
                    -Wno-error=incompatible-pointer-types

variant djvu description "Support for djvu documents using djvulibre" {
    depends_lib-append      port:djvulibre
    configure.args-replace  -Ddjvu=disabled -Ddjvu=enabled
}

variant dvi description "Support for dvi documents using texlive" {
    depends_lib-append      port:texlive-bin
    configure.args-replace  -Ddvi=disabled -Ddvi=enabled
}

variant multimedia description "Build optional multimedia support using Gstreamer" {
    depends_lib-append      port:gstreamer1 \
                            port:gstreamer1-gst-plugins-base
    configure.args-replace  -Dmultimedia=disabled -Dmultimedia=enabled
}

variant nautilus conflicts quartz description "Build optional nautilus extensions" {
    depends_lib-append      port:nautilus
    configure.args-replace  -Dnautilus=false -Dnautilus=true
}

variant quartz conflicts x11 {
    require_active_variants gtk3 quartz
}

variant x11 conflicts quartz {
    require_active_variants gtk3 x11
    # TODO: gnome-desktop conflicts currently with gnome-desktop-gtk4,
    # which in turn is required by nautilus.
#    depends_lib-append      port:gnome-desktop
#    configure.args-replace  -Dthumbnail_cache=disabled -Dthumbnail_cache=enabled
}

default_variants-append     +djvu

if {![variant_isset quartz]} {
    default_variants-append +x11
}

post-activate    {
    system "${prefix}/bin/gtk-update-icon-cache -f -t ${prefix}/share/icons/hicolor"
    system "${prefix}/bin/update-desktop-database ${prefix}/share/applications"
    system "${prefix}/bin/glib-compile-schemas ${prefix}/share/glib-2.0/schemas"
}

livecheck.type      gnome
