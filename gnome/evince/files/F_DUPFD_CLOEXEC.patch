--- libview/ev-jobs.c
+++ libview/ev-jobs.c
@@ -45,6 +45,14 @@
 #include <unistd.h>
 #include <fcntl.h>
 
+#ifndef F_DUPFD_CLOEXEC
+/* Not provided by older SDKs (e.g. legacy macOS); fall back to F_DUPFD
+ * and set FD_CLOEXEC separately in ev_dupfd() below.
+ */
+#define F_DUPFD_CLOEXEC F_DUPFD
+#define EV_DUPFD_NEEDS_CLOEXEC_FALLBACK 1
+#endif
+
 typedef struct _EvJobLoadStreamPrivate EvJobLoadStreamPrivate;
 struct _EvJobLoadStreamPrivate
 {
@@ -1463,8 +1471,19 @@
                 int errsv = errno;
                 g_set_error_literal (error, G_FILE_ERROR, g_file_error_from_errno (errsv),
                                      g_strerror (errsv));
+                return new_fd;
         }
 
+#ifdef EV_DUPFD_NEEDS_CLOEXEC_FALLBACK
+        if (fcntl (new_fd, F_SETFD, FD_CLOEXEC) == -1) {
+                int errsv = errno;
+                g_set_error_literal (error, G_FILE_ERROR, g_file_error_from_errno (errsv),
+                                     g_strerror (errsv));
+                close (new_fd);
+                return -1;
+        }
+#endif
+
         return new_fd;
 }
 
