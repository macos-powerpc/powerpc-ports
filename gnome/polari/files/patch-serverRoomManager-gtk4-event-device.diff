gtk_get_current_event_device() does not exist in GTK4, so the toggle
renderer's handler always threw and the GTK3 property name input-source is
also gone. Remember the device of the last event seen by the list through a
capture-phase legacy event controller and use gdk_device_get_source().
--- src/serverRoomManager.js.orig
+++ src/serverRoomManager.js
@@ -183,10 +183,21 @@
             this._toggleChecked(path);
         });
 
+        // GTK4 has no gtk_get_current_event_device(); track the device
+        // of the last event the list received instead
+        let lastDevice = null;
+        const eventController = new Gtk.EventControllerLegacy({
+            propagation_phase: Gtk.PropagationPhase.CAPTURE,
+        });
+        eventController.connect('event', (controller, event) => {
+            lastDevice = event.get_device();
+            return Gdk.EVENT_PROPAGATE;
+        });
+        this._list.add_controller(eventController);
+
         this._toggleRenderer.connect('toggled', (cell, pathStr) => {
             // For pointer devices, ::row-activated is emitted as well
-            let dev = Gtk.get_current_event_device();
-            if (dev && dev.input_source === Gdk.InputSource.KEYBOARD)
+            if (lastDevice?.get_source() === Gdk.InputSource.KEYBOARD)
                 this._toggleChecked(Gtk.TreePath.new_from_string(pathStr));
         });
 
