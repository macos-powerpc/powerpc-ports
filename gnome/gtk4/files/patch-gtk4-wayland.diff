--- meson.build
+++ meson.build
@@ -176,6 +176,12 @@
   android_enabled = false
 endif
 
+# The Wayland backend is forced off for macOS above, on the assumption that
+# Wayland is Linux/BSD-only. Honour the option instead.
+if os_darwin
+  wayland_enabled = get_option('wayland-backend')
+endif
+
 gtk_prefix = get_option('prefix')
 gtk_includedir = join_paths(gtk_prefix, get_option('includedir'))
 gtk_libdir = join_paths(gtk_prefix, get_option('libdir'))
--- gdk/wayland/gdkseat-wayland.c
+++ gdk/wayland/gdkseat-wayland.c
@@ -51,6 +51,18 @@
 #include <dev/evdev/input.h>
 #elif defined(HAVE_LINUX_INPUT_H)
 #include <linux/input.h>
+#else
+/* Neither the Linux uapi header nor its FreeBSD evdev equivalent is
+ * available (e.g. macOS). wl_pointer.button and the tablet tool buttons
+ * carry raw Linux evdev codes over the wire regardless of host OS, so
+ * define the ones used below by hand. BTN_STYLUS3 has a fallback below. */
+#define BTN_LEFT     0x110
+#define BTN_RIGHT    0x111
+#define BTN_MIDDLE   0x112
+#define BTN_FORWARD  0x115
+#define BTN_BACK     0x116
+#define BTN_STYLUS   0x14b
+#define BTN_STYLUS2  0x14c
 #endif
 
 #define WL_POINTER_HAS_FRAME 5
