PortSystem          1.0
PortGroup           cmake       1.1
PortGroup           github      1.0
PortGroup           legacysupport 1.1

# fmemopen
legacysupport.newest_darwin_requires_legacy 15

github.setup        ngs-lang ngs 0.2.17 v
revision            1

categories          shells
installs_libs       no
license             GPL-3
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer
homepage            https://ngs-lang.org

description         \
    Next Generation Shell (NGS)

long_description    \
    NGS is an alternative shell. At its core is a domain-specific language \
    that was specifically designed to be a shell language. It is designed \
    with a focus on Ops and systems engineering. One way to think about NGS \
    is bash plus data structures plus better syntax and error handling.

checksums           rmd160  3ae81431097870c03b6054dc6f82e77dccaf33fa \
                    sha256  029c5d1167e884fee54fc99881e3d8c30478314f6e5fc2a7b832c909ed35d5b0 \
                    size    769926
github.tarball_from archive

patchfiles          patch-implicit.diff

post-patch {
    # Replace hard-coded prefixes
    foreach ftarget {
        doc/ngstut.1.md
        doc/ngs.1.md
        doc/ngslang.1.md
        lib/autoload/globals/DelimStr.ngs
        lib/stdlib.ngs
        CMakeLists.txt
    } {
        reinplace -E "s|/usr/local|${prefix}|g" ${worksrcpath}/${ftarget}
    }

    # Correct man and doc paths
    reinplace {s|DESTINATION man/man1|DESTINATION share/man/man1|} \
        ${worksrcpath}/CMakeLists.txt

    reinplace {s|DESTINATION doc/ngs|DESTINATION share/doc/ngs|} \
        ${worksrcpath}/CMakeLists.txt

    # Generate the man pages with minimark rather than pandoc. pandoc
    # needs GHC, which is unavailable on some platforms MacPorts still
    # supports (PowerPC in particular). minimark is a MicroHs
    # implementation of the same markdown-to-roff conversion and takes
    # the same options, so the command is the same but for the name and
    # the heap bound.
    # +RTS -H8M -RTS bounds the MicroHs runtime heap at 8M cells. The
    # default heap is far larger and gets the process OOM-killed part
    # way through doc/ngslang.1.md (75 KB, the biggest page) on a 1 GB
    # machine, which shows up as a truncated .1 file rather than an
    # error. 8M cells converts every page in the set with room to
    # spare; measured peak was 128 MB RSS on 64-bit.
    reinplace {s|pandoc -f markdown+hard_line_breaks|minimark +RTS -H8M -RTS -f markdown+hard_line_breaks|} \
        ${worksrcpath}/doc/Makefile

    # CMake looks the converter up by name to decide whether to build
    # the man target, and names it again in the status messages it
    # prints. Every lowercase "pandoc" in CMakeLists.txt belongs to
    # that block; the PANDOC cache variable itself keeps its name.
    reinplace {s|pandoc|minimark|g} ${worksrcpath}/CMakeLists.txt
}

compiler.blacklist-append \
                    *gcc-4.*

depends_build-append \
                    path:bin/gawk:gawk \
                    path:bin/gsed:gsed \
                    port:minimark \
                    port:peg \
                    path:bin/pkg-config:pkgconfig

depends_lib-append  port:boehmgc \
                    port:json-c \
                    port:libffi \
                    port:pcre

# BUILD_MAN defaults to AUTO, which silently ships no manuals when
# the converter is missing – and in that branch upstream forgets to clear
# DO_BUILD_MAN_PAGES, so the man target is added anyway and the build
# fails later instead. minimark is a build dependency, so require it
# and fail at configure time if it is ever absent.
configure.args-append \
                    -DBUILD_MAN=ON

configure.env-append \
                    "PKG_CONFIG_PATH=${prefix}/lib/pkgconfig"

build.env-append    "PKG_CONFIG_PATH=${prefix}/lib/pkgconfig"
