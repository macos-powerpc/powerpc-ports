From 1e32d023175ed3bb5607e5da52eb3545dad000aa Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Tue, 24 Nov 2026 16:17:54 +0800
Subject: [PATCH] wayland/ui_display.c: fix macOS build

---
 uitoolkit/wayland/ui_display.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git uitoolkit/wayland/ui_display.c uitoolkit/wayland/ui_display.c
index e07aa706..5429cc74 100644
--- uitoolkit/wayland/ui_display.c
+++ uitoolkit/wayland/ui_display.c
@@ -75,14 +75,14 @@ static int create_tmpfile_cloexec(char *tmpname) {
 static int posix_fallocate(int fd, off_t offset, off_t len) {
   fstore_t fst;
 
-  fst.fst_flags = F_ALLOCATEALL;
-  fst.fst_posmode = F_PE_SETCONTRIG; /* continuous area */
-  fst.fst_offset = offset;
-  fst.fst_length = len;
+  fst.fst_flags = F_ALLOCATECONTIG;   /* try contiguous first */
+  fst.fst_posmode = F_PEOFPOSMODE;    /* allocate relative to EOF */
+  fst.fst_offset = 0;
+  fst.fst_length = offset + len;
   fst.fst_bytesalloc = 0;
 
   if (fcntl(fd, F_PREALLOCATE, &fst) == -1) {
-    fst.fst_posmode = F_PE_SETBUFMODE;
+    fst.fst_flags = F_ALLOCATEALL;    /* fall back to non-contiguous */
     if (fcntl(fd, F_PREALLOCATE, &fst) == -1) {
       return -1;
     }
