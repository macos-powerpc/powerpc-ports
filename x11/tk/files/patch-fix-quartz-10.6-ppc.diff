  */
 
+/*
+ * The bit-fields are declared so that the numeric value of the keycode is
+ * (virt << 24) | (o_s << 22) | keychar on both little- and big-endian hosts.
+ * Compilers allocate bit-fields starting from the least significant bit on
+ * little-endian targets and from the most significant bit on big-endian
+ * targets, so the declaration order must be reversed for big-endian.  In
+ * particular the 10-bit xvirtual field must stay in the high bits: it is
+ * (virt << 2) | o_s, which is < 512 and is used to index xvirtual2unichar[].
+ */
+
+#ifdef __BIG_ENDIAN__
+typedef struct keycode_v_t {
+    unsigned virt: 8;     /* 8-bit virtual keycode - identifies a key. */
+    unsigned o_s: 2;         /* State of Option and Shift keys. */
+    unsigned keychar: 22;    /* UCS-32 character */
+} keycode_v;
+
+typedef struct keycode_x_t {
+    unsigned xvirtual: 10;    /* Combines o_s and virtual. This 10-bit integer
+			       * is used as a key for looking up the character
+			       * produced when pressing a key with a particular
+			       * Shift and Option modifier state. */
+    unsigned keychar: 22;     /* UCS-32 character */
+} keycode_x;
+#else
 typedef struct keycode_v_t {
     unsigned keychar: 22;    /* UCS-32 character */
     unsigned o_s: 2;         /* State of Option and Shift keys. */
@@ -156,6 +181,7 @@ typedef struct keycode_x_t {
 			       * produced when pressing a key with a particular
 			       * Shift and Option modifier state. */
 } keycode_x;
