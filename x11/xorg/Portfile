# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                xorg
# Version is meaningless, but this is a stub port anyway.
version             20260912
categories          x11
maintainers         {jeremyhu @jeremyhu} openmaintainer
license             Permissive
homepage            https://www.x.org
description         The X Window System
long_description    \
    X11, or X, is a vendor-neutral, system-architecture neutral \
    network-transparent window system and user interface standard. \
    In other words, it is a GUI for UNIX. X can use your network – \
    you may run CPU-intensive programs on high powered workstations \
    and display the user interface, the windows, on inexpensive \
    desktop machines.

platforms           any
supported_archs     noarch

# The aim is to switch to xlibre-xserver by default for all systems.
# Still needs some work and more testing though.
if {${os.platform} ne "darwin"} {
    depends_run     path:bin/X:xlibre-xserver
} elseif {${os.major} < 9} {
    # Tiger lacks spawn.h, limiting xorg-server to v1.18
    depends_run     path:bin/Xquartz:xorg-server-1.18
} elseif {${os.major} < 11} {
    # xquartz is newer than both xorg-server-legacy and xorg-server
    depends_run     path:bin/Xquartz:xquartz
} elseif {${os.major} < 15} {
    depends_run     path:bin/Xquartz:xorg-server-legacy
} else {
    # While xlibre-xserver and xquartz work on modern macOS, there are some oddities
    # to be fixed, so default to an older but reliable xorg-server for now.
    depends_run     path:bin/Xquartz:xorg-server
}

depends_run-append  port:xorg-apps

platform darwin {
    depends_run-append \
                    port:quartz-wm
}

distfiles
use_configure       no
build               {}
destroot {
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    system "echo ${long_description} > ${destroot}${prefix}/share/doc/${name}/README.txt"
}

livecheck.type      none
