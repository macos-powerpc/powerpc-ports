From 076aa82f02841ceae354a565ed5f99c7a3dc8f0a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 27 Jul 2026 19:28:53 +0000
Subject: [PATCH 3/3] Do not clear the current GL context for surfaces that
 never had one

-[OwlSurface tearDownGL] runs unconditionally from -dealloc, and
ended with [NSOpenGLContext clearCurrentContext] even for surfaces
that never set up GL -- which is every surface of an shm-only
client such as foot. On Mac OS X 10.6 ppc, CGLSetCurrentContext()
called with no context current crashes on a store to NULL+0xbdc
(gdb: 'stw r0,3036(r3)' with r3 == 0 inside CGLSetCurrentContext),
taking the compositor down whenever a client disconnected.

Return early when no GL context was ever created, and when one
was, only clear the thread's current context if it is actually
ours -- clearing global state we do not own is wrong regardless of
the 10.6 crash.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Kvag8nXEuGz9XJL3WdSxKC
---
 Sources/Compositor/OwlSurface.m | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/Sources/Compositor/OwlSurface.m b/Sources/Compositor/OwlSurface.m
index 100a3d7..fd4bff4 100644
--- a/Sources/Compositor/OwlSurface.m
+++ b/Sources/Compositor/OwlSurface.m
@@ -117,10 +117,21 @@ static void surface_damage_buffer_handler(
 }
 
 - (void) tearDownGL {
+    // Called unconditionally from -dealloc, including for surfaces
+    // that never had a GL context (shm-only clients like foot). Only
+    // touch global GL state if we actually own it: on Mac OS X 10.6
+    // ppc, CGLSetCurrentContext(NULL) crashes (a store to
+    // NULL+0xbdc) when invoked with no context current, taking the
+    // whole compositor down when a client disconnects.
+    if (_openGLContext == nil) {
+        return;
+    }
+    if ([NSOpenGLContext currentContext] == _openGLContext) {
+        [NSOpenGLContext clearCurrentContext];
+    }
     [_openGLContext clearDrawable];
     [_openGLContext release];
     _openGLContext = nil;
-    [NSOpenGLContext clearCurrentContext];
 }
 
 - (void) updateTrackingRect {
