From c0e7ae9abfbba2bb3f36c889da5a1311cf48ad01 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 27 Jul 2026 18:18:17 +0000
Subject: [PATCH 08/16] Avoid undefined float-to-uint32 conversion in event
 timestamps

[OwlServer timestamp] multiplies seconds-since-2001 by 1000, which
has exceeded UINT32_MAX since 2001-02-19; converting that double
directly to uint32_t is undefined behavior. x86 happens to wrap
modulo 2^32, but ppc saturates the conversion, pinning every input
event and frame callback timestamp at 4294967295. Truncate via
uint64_t instead, which is well-defined and preserves the existing
x86 behavior; Wayland timestamps may freely wrap.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Kvag8nXEuGz9XJL3WdSxKC
---
 Sources/Server/OwlServer.m | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/Sources/Server/OwlServer.m b/Sources/Server/OwlServer.m
index c967d21..7a7fbff 100644
--- a/Sources/Server/OwlServer.m
+++ b/Sources/Server/OwlServer.m
@@ -180,7 +180,13 @@
 // by -timeIntervalSinceReferenceDate, i.e. 1 January 2001.
 + (uint32_t) timestamp {
     NSTimeInterval ti = [[NSDate date] timeIntervalSinceReferenceDate];
-    return ti * 1000;
+    // ti * 1000 has exceeded UINT32_MAX since 2001-02-19, and
+    // converting an out-of-range double straight to uint32_t is
+    // undefined behavior: x86 happens to wrap modulo 2^32, but ppc
+    // saturates, pinning every timestamp at 4294967295. Truncate in
+    // integer arithmetic instead; Wayland timestamps may freely wrap.
+    uint64_t ms = (uint64_t)(ti * 1000.0);
+    return (uint32_t)ms;
 }
 
 // Explicitly flush our clients.
