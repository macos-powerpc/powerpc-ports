From c9c05ea374a9beb1ad3e4fb87e9e7d586800683a Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 30 Jul 2026 19:05:28 +0000
Subject: [PATCH 17/20] Do not declare ivars of incomplete enum type in
 OwlXdgPositioner

OwlXdgPositioner.h declared _anchor and _gravity as
enum xdg_positioner_anchor / enum xdg_positioner_gravity, but the
generated xdg-shell.h that defines those enums is not imported there,
and every .m file imports this header before xdg-shell.h. An object
of an incomplete enum type is invalid C ("field has incomplete
type"), so this could not compile. Store them as uint32_t instead,
like _constraintAdjustment already does; the switch statements over
them in OwlXdgPositioner.m are unaffected.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017CtxTDuv1qwYdYQ8qAKYB3
---
 Sources/Shell/OwlXdgPositioner.h | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/Sources/Shell/OwlXdgPositioner.h b/Sources/Shell/OwlXdgPositioner.h
index 4a75b97..bbbd464 100644
--- a/Sources/Shell/OwlXdgPositioner.h
+++ b/Sources/Shell/OwlXdgPositioner.h
@@ -31,8 +31,11 @@
 @public
     NSSize _size;
     NSRect _anchorRect;
-    enum xdg_positioner_anchor _anchor;
-    enum xdg_positioner_gravity _gravity;
+    // enum xdg_positioner_anchor / _gravity values; stored as plain
+    // uint32_t because the generated xdg-shell.h that defines those
+    // enums is not visible from this header.
+    uint32_t _anchor;
+    uint32_t _gravity;
     uint32_t _constraintAdjustment;
     NSPoint _offset;
 }
