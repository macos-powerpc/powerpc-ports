+#import "OwlGlobal.h"
+#import <Cocoa/Cocoa.h>
+#import <wayland-server.h>
+
+
+/* Implements xdg_toplevel_icon_manager_v1. macOS has no icon themes,
+ * so set_name is ignored; icons are applied from the largest supplied
+ * pixel buffer via NSWindow.setMiniwindowImage:. */
+@interface OwlXdgToplevelIconManagerV1 : NSObject <OwlGlobal> {
+    struct wl_resource *_resource;
+}
