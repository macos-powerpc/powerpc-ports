From a0333a50b72f51a77b9db752a0d895ddd3d9ca7d Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 31 Jul 2026 11:09:35 +0000
Subject: [PATCH] Create data devices, sources and offers at the negotiated
 version

get_data_device and create_data_source hardcoded version 2 for the
resources they create, and sendSelection did the same for its
offers, even though the client bound wl_data_device_manager at
version 3. Objects must be created at the version negotiated
through their parent: foot, holding what it correctly believed to
be a version 3 offer, called set_actions on our drag-and-drop
offer, and libwayland killed the connection with "invalid version
for wl_data_offer.set_actions (2, need at least 3)" - dragging
anything over a foot window instantly disconnected it.

Derive all three versions from the parent resource instead. The
version 3 requests these objects can now legally receive all have
handlers already (set_actions/finish on offers, set_actions on
sources), so nothing new is reachable that we don't implement.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G6m1eevhAns3j85HMZYKna
---
 Sources/Data/OwlWlDataDevice.m        | 2 +-
 Sources/Data/OwlWlDataDeviceManager.m | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Data/OwlWlDataDevice.m b/Sources/Data/OwlWlDataDevice.m
index c80775d..4087ca7 100644
--- a/Sources/Data/OwlWlDataDevice.m
+++ b/Sources/Data/OwlWlDataDevice.m
@@ -128,7 +128,7 @@ static const struct wl_data_device_interface data_device_impl = {
     struct wl_resource *offer_resource = wl_resource_create(
          wl_resource_get_client(_resource),
          &wl_data_offer_interface,
-         2,
+         wl_resource_get_version(_resource),
          0
     );
     wl_data_device_send_data_offer(_resource, offer_resource);
diff --git a/Sources/Data/OwlWlDataDeviceManager.m b/Sources/Data/OwlWlDataDeviceManager.m
index 52fb692..153f463 100644
--- a/Sources/Data/OwlWlDataDeviceManager.m
+++ b/Sources/Data/OwlWlDataDeviceManager.m
@@ -36,7 +36,7 @@ static void data_device_manager_create_data_source_handler(
     struct wl_resource *data_source_resource = wl_resource_create(
         client,
         &wl_data_source_interface,
-        2,
+        wl_resource_get_version(resource),
         id
     );
     [[[OwlWlDataSource alloc] initWithResource: data_source_resource] release];
@@ -51,7 +51,7 @@ static void data_device_manager_get_data_device_handler(
     struct wl_resource *data_device_resource = wl_resource_create(
         client,
         &wl_data_device_interface,
-        2,
+        wl_resource_get_version(resource),
         id
     );
     [[[OwlWlDataDevice alloc] initWithResource: data_device_resource] release];
