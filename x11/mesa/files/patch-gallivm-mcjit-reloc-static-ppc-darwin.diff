Pin Reloc::Static for the MCJIT on Darwin PPC: the (patched) LLVM 7
defaults Darwin ppc to PIC_, whose picbase SECTDIFF relocation forms the
RuntimeDyld MachO/PPC loader does not implement; the loader was written
and validated against static-code relocations.

--- src/gallium/auxiliary/gallivm/lp_bld_misc.cpp.orig
+++ src/gallium/auxiliary/gallivm/lp_bld_misc.cpp
@@ -618,6 +618,17 @@
 #endif
 
    builder.setMCPU(MCPU);
+
+#if DETECT_OS_APPLE && (DETECT_ARCH_PPC || DETECT_ARCH_PPC_64)
+   /*
+    * Darwin ppc defaults to PIC_ these days; the RuntimeDyld MachO/PPC
+    * loader implements the static-code relocation set (absolute
+    * lo16/ha16 pairs, BR24/BR14), not the picbase SECTDIFF forms, so pin
+    * the model the JIT was validated against.
+    */
+   builder.setRelocationModel(Reloc::Static);
+#endif
+
    if (gallivm_debug & (GALLIVM_DEBUG_IR | GALLIVM_DEBUG_ASM | GALLIVM_DEBUG_DUMP_BC)) {
       debug_printf("llc -mcpu option: %s\n", MCPU.str().c_str());
    }
