Add the missing LLVM-7 guard for llvm.fpto{s,u}i.sat, which only exists
from LLVM 12.  Without it, every NIR float->int conversion aborts at
shader-compile time with:

  llvm (version 7.1.1) found no intrinsic for llvm.fptosi.sat.v4i32.v4f32,
  going to crash...

Fall back to plain fptosi/fptoui exactly as Mesa did through 21.x.  On PPC
this is nearly equivalent anyway: fctiwz and vctsxs/vctuxs saturate in
hardware, and the AltiVec vector forms also convert NaN to 0, matching the
.sat semantics for the 4-wide vectors gallivm actually uses here.

--- src/gallium/auxiliary/gallivm/lp_bld_nir_soa.c.orig
+++ src/gallium/auxiliary/gallivm/lp_bld_nir_soa.c
@@ -3318,6 +3318,7 @@
       bool is_unsigned = nir_alu_type_get_base_type(dst_type) == nir_type_uint;
       LLVMTypeRef int_type = (is_unsigned ? dst_uint_bld : dst_int_bld)->vec_type;
 
+#if LLVM_VERSION_MAJOR >= 13
       char name[64];
       char tmp[64];
       char intrinsic[64];
@@ -3325,6 +3326,17 @@
       lp_format_intrinsic(tmp, 64, name, int_type);
       lp_format_intrinsic(intrinsic, 64, tmp, LLVMTypeOf(src[0]));
       result = lp_build_intrinsic_unary(builder, intrinsic, int_type, src[0]);
+#else
+      /* llvm.fpto{s,u}i.sat.* only exist from LLVM 12; do what Mesa <= 21.x
+       * did.  On PPC the hardware conversions saturate anyway (fctiwz,
+       * vctsxs/vctuxs), and the AltiVec vector forms also turn NaN into 0,
+       * which matches the .sat semantics.
+       */
+      if (is_unsigned)
+         result = LLVMBuildFPToUI(builder, src[0], int_type, "");
+      else
+         result = LLVMBuildFPToSI(builder, src[0], int_type, "");
+#endif
       break;
    }
    case nir_op_fabs:
