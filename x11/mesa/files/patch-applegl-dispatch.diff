--- src/glx/apple/apple_glapi.c
+++ src/glx/apple/apple_glapi.c
@@ -48,12 +48,48 @@
 struct _glapi_table * __ogl_framework_api = NULL;
 struct _glapi_table * __applegl_api = NULL;
 
+/* Functions that OpenGL.framework may only export under the name of the older
+ * extension. They are not aliases in the API XML, because the extension
+ * versions also accept names that were never generated, but that does not
+ * matter to callers following the core rules.
+ */
+static const struct {
+    const char *name;
+    const char *symbol;
+} _apple_glapi_fallbacks[] = {
+    { "BindFramebuffer", "glBindFramebufferEXT" },
+    { "BindRenderbuffer", "glBindRenderbufferEXT" },
+    { "GenVertexArrays", "glGenVertexArraysAPPLE" },
+    { "BindVertexArray", "glBindVertexArrayAPPLE" },
+    { "DeleteVertexArrays", "glDeleteVertexArraysAPPLE" },
+    { "IsVertexArray", "glIsVertexArrayAPPLE" },
+};
+
+static void _apple_glapi_patch_fallbacks(struct _glapi_table *table) {
+    void *handle = apple_cgl_get_dl_handle();
+    char symbol[64];
+    size_t i;
+
+    for (i = 0; i < sizeof(_apple_glapi_fallbacks) / sizeof(_apple_glapi_fallbacks[0]); i++) {
+        void *proc;
+
+        snprintf(symbol, sizeof(symbol), "gl%s", _apple_glapi_fallbacks[i].name);
+        if (dlsym(handle, symbol))
+            continue;
+
+        proc = dlsym(handle, _apple_glapi_fallbacks[i].symbol);
+        if (proc)
+            _glapi_table_patch(table, _apple_glapi_fallbacks[i].name, proc);
+    }
+}
+
 static void _apple_glapi_create_table(void) {
     if (__applegl_api)
         return;
 
     __ogl_framework_api = _glapi_create_table_from_handle(apple_cgl_get_dl_handle(), "gl");
     assert(__ogl_framework_api);
+    _apple_glapi_patch_fallbacks(__ogl_framework_api);
 
     size_t glapi_table_size = _gloffset_COUNT * sizeof(_glapi_proc*);
     __applegl_api = malloc(glapi_table_size);
@@ -62,7 +98,8 @@
 
     _glapi_table_patch(__applegl_api, "ReadPixels", __applegl_glReadPixels);
     _glapi_table_patch(__applegl_api, "CopyPixels", __applegl_glCopyPixels);
-    _glapi_table_patch(__applegl_api, "DrawBuffers", __applegl_glDrawBuffer);
+    _glapi_table_patch(__applegl_api, "DrawBuffer", __applegl_glDrawBuffer);
+    _glapi_table_patch(__applegl_api, "DrawBuffers", __applegl_glDrawBuffers);
     _glapi_table_patch(__applegl_api, "Viewport", __applegl_glViewport);
 }
 
