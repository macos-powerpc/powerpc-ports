+// Darwin PowerPC: Apple's compiler makes Objective-C methods take their PIC base from r12, which the ABI sets to
+// the callee's address on indirect calls; objc_msgSend does that, a plain function pointer call from code GCC
+// generates does not (r12 is whatever the last dispatch left), and AppKit's `sendEvent:` then reads through a
+// bogus pointer. So the original implementation is reached through objc_msgSend, as a method of its own.
+#[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+fn call_original(app: &NSApplication, _sel: Sel, event: &NSEvent) {
+    unsafe { objc2::msg_send![app, winitOriginalSendEvent: event] }
+}
+
+#[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
+fn add_original_method(_class: &objc2::runtime::AnyClass, _method: &objc2::runtime::Method, _original: Imp) {}
+
+#[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+fn add_original_method(class: &objc2::runtime::AnyClass, method: &objc2::runtime::Method, original: Imp) {
+    // Same type encoding as `sendEvent:`; `class_addMethod` is 10.5+.
+    let types = unsafe {
+        objc2::ffi::method_getTypeEncoding(method as *const objc2::runtime::Method as *const objc2::ffi::objc_method)
+    };
+    let added = unsafe {
+        objc2::ffi::class_addMethod(
+            class as *const objc2::runtime::AnyClass as *mut objc2::ffi::objc_class,
+            sel!(winitOriginalSendEvent:).as_ptr(),
+            Some(original),
+            types,
+        )
+    };
+    assert!(added != 0, "could not add winitOriginalSendEvent: to NSApplication");
+}
