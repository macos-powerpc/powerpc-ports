--- a/src/runtime.rs	2019-10-16 02:08:02.000000000 +0000
+++ b/src/runtime.rs	2026-10-07 19:24:19.787851204 +0000
@@ -33,7 +33,11 @@
 pub const NO: BOOL = false;
 
 /// A type that represents a method selector.
-#[repr(C)]
+// `repr(transparent)`, not `repr(C)`: libobjc returns a `SEL` (a pointer) in a register, but
+// a one-pointer `repr(C)` struct is an aggregate for the C ABI, which 32-bit PowerPC Darwin
+// returns through a hidden pointer. `sel_registerName`/`method_getName` then yield garbage
+// ("+[NSAutoreleasePool ]: unrecognized selector"). A transparent newtype is the pointer.
+#[repr(transparent)]
 pub struct Sel {
     ptr: *const c_void,
 }
