native-tls always uses Security.framework (SecureTransport) on Apple targets. On powerpc
Darwin (Mac OS X 10.4-10.6) that links SSLCreateContext (10.8) and SecTrustEvaluateWithError
(10.14), and the system SecureTransport only speaks TLS 1.0 anyway. Use the OpenSSL backend
there, like other unix systems: openssl-sys then links MacPorts openssl3, whose cert.pem is
the curl-ca-bundle file. Other Apple targets are unchanged.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -60,3 +60,3 @@
 
-[target.'cfg(not(any(target_os = "windows", target_vendor = "apple")))'.dependencies.log]
+[target.'cfg(not(any(target_os = "windows", all(target_vendor = "apple", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))))'.dependencies.log]
 version = "0.4.5"
@@ -63,3 +63,3 @@
 
-[target.'cfg(not(any(target_os = "windows", target_vendor = "apple")))'.dependencies.openssl]
+[target.'cfg(not(any(target_os = "windows", all(target_vendor = "apple", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))))'.dependencies.openssl]
 version = "0.10.69"
@@ -66,3 +66,3 @@
 
-[target.'cfg(not(any(target_os = "windows", target_vendor = "apple")))'.dependencies.openssl-probe]
+[target.'cfg(not(any(target_os = "windows", all(target_vendor = "apple", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))))'.dependencies.openssl-probe]
 version = "0.1"
@@ -69,3 +69,3 @@
 
-[target.'cfg(not(any(target_os = "windows", target_vendor = "apple")))'.dependencies.openssl-sys]
+[target.'cfg(not(any(target_os = "windows", all(target_vendor = "apple", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))))'.dependencies.openssl-sys]
 version = "0.9.81"
@@ -72,3 +72,3 @@
 
-[target.'cfg(target_os = "macos")'.dependencies.tempfile]
+[target.'cfg(all(target_os = "macos", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))'.dependencies.tempfile]
 version = "3.1.0"
@@ -78,3 +78,3 @@
 
-[target.'cfg(target_vendor = "apple")'.dependencies.libc]
+[target.'cfg(all(target_vendor = "apple", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))'.dependencies.libc]
 version = "0.2"
@@ -81,3 +81,3 @@
 
-[target.'cfg(target_vendor = "apple")'.dependencies.security-framework]
+[target.'cfg(all(target_vendor = "apple", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))'.dependencies.security-framework]
 version = "2.0.0"
@@ -84,3 +84,3 @@
 
-[target.'cfg(target_vendor = "apple")'.dependencies.security-framework-sys]
+[target.'cfg(all(target_vendor = "apple", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))'.dependencies.security-framework-sys]
 version = "2.0.0"
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -105,3 +105,3 @@
 
-#[cfg(not(any(target_os = "windows", target_vendor = "apple")))]
+#[cfg(not(any(target_os = "windows", all(target_vendor = "apple", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))))]
 #[macro_use]
@@ -108,3 +108,5 @@
