GCC 15 and later default to C23, where `void g(){}` declares a function taking no
arguments. GMP 6.3.0's "long long reliability test" probes call g() with six, so
configure rejects every compiler candidate:

  conftest.c:12:48: error: too many arguments to function 'g'; expected 0, have 6
  configure: error: could not find a working compiler, see config.log for details

Give g() a prototype, exactly as gmp-mpfr-sys 1.6.7/1.6.8 do (their only change to
the bundled GMP that matters on PowerPC).

--- a/gmp-6.3.0-c/configure	2026-10-05 07:36:50.612472238 +0000
+++ b/gmp-6.3.0-c/configure	2026-10-05 07:36:50.621472460 +0000
@@ -6568,7 +6568,7 @@
 
 #if defined (__GNUC__) && ! defined (__cplusplus)
 typedef unsigned long long t1;typedef t1*t2;
-void g(){}
+void g(int a,t1 const* b,t1 c,t2 d,t1 const* e,int f){}
 void h(){}
 static __inline__ t1 e(t2 rp,t2 up,int n,t1 v0)
 {t1 c,x,r;int i;if(v0){c=1;for(i=1;i<n;i++){x=up[i];r=x+1;rp[i]=r;}}return c;}
@@ -8187,7 +8187,7 @@
 
 #if defined (__GNUC__) && ! defined (__cplusplus)
 typedef unsigned long long t1;typedef t1*t2;
-void g(){}
+void g(int a,t1 const* b,t1 c,t2 d,t1 const* e,int f){}
 void h(){}
 static __inline__ t1 e(t2 rp,t2 up,int n,t1 v0)
 {t1 c,x,r;int i;if(v0){c=1;for(i=1;i<n;i++){x=up[i];r=x+1;rp[i]=r;}}return c;}
