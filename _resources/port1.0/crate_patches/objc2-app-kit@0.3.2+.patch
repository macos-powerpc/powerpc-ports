objc2-app-kit: AppKit on PowerPC uses the classic enum values
(NSTextAlignment Right = 1, Center = 2; see NSText.h in the 10.6 SDK), not
the iOS ones that TARGET_ABI_USES_IOS_VALUES selects for every architecture
other than x86_64.

--- a/src/lib.rs
+++ b/src/lib.rs
@@ -63,7 +63,11 @@ pub use self::generated::*;
 /// <https://github.com/xamarin/xamarin-macios/issues/12111>
 #[allow(unused)]
 #[allow(unexpected_cfgs)]
-pub(crate) const TARGET_ABI_USES_IOS_VALUES: bool = !cfg!(target_arch = "x86_64")
+pub(crate) const TARGET_ABI_USES_IOS_VALUES: bool = !cfg!(any(
+    target_arch = "x86_64",
+    target_arch = "powerpc",
+    target_arch = "powerpc64"
+))
     || (cfg!(all(target_vendor = "apple", not(target_os = "macos")))
         && !cfg!(target_env = "macabi"));
 
