objc2-contacts: Contacts is OS X 10.11+, there is none on PowerPC.
Don't link Contacts.framework on PowerPC, so that a program that merely
has this crate in its dependency graph still links. Its classes are
looked up at run time (and not found); a C function or static from
Contacts that is actually used is still undefined at link time.

--- a/src/generated/mod.rs
+++ b/src/generated/mod.rs
@@ -15,3 +15,7 @@
 
-#[link(name = "Contacts", kind = "framework")]
+// Contacts is OS X 10.11+, there is none on PowerPC.
+#[cfg_attr(
+    not(any(target_arch = "powerpc", target_arch = "powerpc64")),
+    link(name = "Contacts", kind = "framework")
+)]
 extern "C" {}
