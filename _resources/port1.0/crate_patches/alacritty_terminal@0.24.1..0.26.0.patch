+// Mac OS X 10.6 (PowerPC): the kernel has no kqueue filter for tty devices (kevent on the pty master fails with
+// EINVAL: `spec_kqfilter` knows only bpf there, ttys came with 10.7) and Darwin's poll(2) takes no devices either.
+// The pty is watched with select(2) on a helper thread that drops a token into a socketpair the poller can watch;
+// reads and writes still go straight to the pty.
+#[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+impl EventedReadWrite for Pty {
+    type Reader = select_relay::Reader;
+    type Writer = select_relay::Writer;
+
+    #[inline]
+    unsafe fn register(
+        &mut self,
+        poll: &Arc<Poller>,
+        mut interest: Event,
+        poll_opts: PollMode,
+    ) -> Result<()> {
+        interest.key = PTY_READ_WRITE_TOKEN;
+        unsafe {
+            poll.add_with_mode(self.relay.token_receiver(), interest, poll_opts)?;
+        }
+
+        unsafe {
+            poll.add_with_mode(
+                &self.signals,
+                Event::readable(PTY_CHILD_EVENT_TOKEN),
+                PollMode::Level,
+            )
+        }
+    }
+
+    #[inline]
+    fn reregister(
+        &mut self,
+        poll: &Arc<Poller>,
+        mut interest: Event,
+        poll_opts: PollMode,
+    ) -> Result<()> {
+        interest.key = PTY_READ_WRITE_TOKEN;
+        poll.modify_with_mode(self.relay.token_receiver(), interest, poll_opts)?;
+
+        poll.modify_with_mode(
+            &self.signals,
+            Event::readable(PTY_CHILD_EVENT_TOKEN),
+            PollMode::Level,
+        )
+    }
+
+    #[inline]
+    fn deregister(&mut self, poll: &Arc<Poller>) -> Result<()> {
+        poll.delete(self.relay.token_receiver())?;
+        poll.delete(&self.signals)
+    }
+
+    #[inline]
+    fn reader(&mut self) -> &mut select_relay::Reader {
+        self.relay.reader()
+    }
+
+    #[inline]
+    fn writer(&mut self) -> &mut select_relay::Writer {
+        self.relay.writer()
+    }
+}
