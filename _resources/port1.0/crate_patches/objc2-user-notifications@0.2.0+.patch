objc2-user-notifications: UserNotifications is macOS 10.14+, there is none on PowerPC.
Don't link UserNotifications.framework on PowerPC, so that a program that merely
has this crate in its dependency graph still links. Its classes are
looked up at run time (and not found); a C function or static from
UserNotifications that is actually used is still undefined at link time.

--- a/src/generated/mod.rs
+++ b/src/generated/mod.rs
@@ -15,3 +15,7 @@
 
-#[link(name = "UserNotifications", kind = "framework")]
+// UserNotifications is macOS 10.14+, there is none on PowerPC.
+#[cfg_attr(
+    not(any(target_arch = "powerpc", target_arch = "powerpc64")),
+    link(name = "UserNotifications", kind = "framework")
+)]
 extern "C" {}
