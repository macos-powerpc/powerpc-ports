+    container.clear();
+}
+
+#[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
 unsafe fn get_list(container: &mut Vec<Disk>) {
@@ -439,2 +454,9 @@
 
+// objc_autoreleasePoolPush/Pop are 10.7+, and on PowerPC this only wraps the
