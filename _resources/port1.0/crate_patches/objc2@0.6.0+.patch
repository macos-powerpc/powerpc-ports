+//! Runtime functions missing from Mac OS X 10.6 and earlier.
+//!
+//! `libobjc` gained the ARC entry points (`objc_retain`,
+//! `objc_autoreleasePoolPush`, the weak reference functions, ...) and
+//! `objc_copyClassList` in Mac OS X 10.7, so the PowerPC runtimes don't have
+//! them. These implement them with `-retain`, `-release`, `-autorelease`,
+//! `NSAutoreleasePool` and `objc_getClassList`.
+//!
+//! The runtime has no zeroing weak references either (except under garbage
+//! collection), so the weak functions here keep a strong reference: an
+//! object stays alive while a [`Weak`][crate::rc::Weak] to it exists, and
+//! loading the weak reference never returns `nil`. A reference cycle that a
+//! weak reference was meant to break is leaked, but a weak reference never
+//! dangles.
+use core::ffi::{c_uint, c_void};
+use core::mem;
+use core::ptr;
+
+use crate::runtime::{AnyClass, AnyObject, Imp, Sel};
+
+extern "C" {
+    // libSystem
+    fn _Block_copy(block: *const c_void) -> *mut c_void;
+    fn malloc(size: usize) -> *mut c_void;
+}
+
+/// Send a message that takes no arguments and returns an object or nothing.
+#[inline]
+unsafe fn send(obj: *mut AnyObject, sel: Sel) -> *mut AnyObject {
+    let msg_send: Imp = crate::ffi::objc_msgSend;
+    // SAFETY: `objc_msgSend` is called with the signature of the method.
+    let msg_send: unsafe extern "C-unwind" fn(*mut AnyObject, Sel) -> *mut AnyObject =
+        unsafe { mem::transmute(msg_send) };
+    unsafe { msg_send(obj, sel) }
+}
+
+// Autoreleasepool
+
+/// `[[NSAutoreleasePool alloc] init]`
+pub unsafe extern "C-unwind" fn objc_autoreleasePoolPush() -> *mut c_void {
+    let cls: *const AnyClass = crate::class!(NSAutoreleasePool);
+    unsafe {
+        let pool = send(cls as *mut AnyObject, crate::sel!(alloc));
+        send(pool, crate::sel!(init)).cast()
+    }
+}
+
+/// `[pool drain]`, which also drains any pools pushed after `pool`.
+pub unsafe extern "C-unwind" fn objc_autoreleasePoolPop(pool: *mut c_void) {
+    unsafe { send(pool.cast(), crate::sel!(drain)) };
+}
+
+// Autorelease
+
+pub unsafe extern "C-unwind" fn objc_autorelease(value: *mut AnyObject) -> *mut AnyObject {
+    if !value.is_null() {
+        unsafe { send(value, crate::sel!(autorelease)) };
+    }
+    value
+}
+
+pub unsafe extern "C-unwind" fn objc_autoreleaseReturnValue(
+    value: *mut AnyObject,
+) -> *mut AnyObject {
+    unsafe { objc_autorelease(value) }
+}
+
+// Weak pointers (strong references, see the module documentation)
+
+pub unsafe extern "C-unwind" fn objc_copyWeak(to: *mut *mut AnyObject, from: *mut *mut AnyObject) {
+    unsafe { *to = objc_retain(*from) };
+}
+
+pub unsafe extern "C-unwind" fn objc_destroyWeak(addr: *mut *mut AnyObject) {
+    unsafe {
+        objc_release(*addr);
+        *addr = ptr::null_mut();
+    }
+}
+
+pub unsafe extern "C-unwind" fn objc_initWeak(
+    addr: *mut *mut AnyObject,
+    value: *mut AnyObject,
+) -> *mut AnyObject {
+    unsafe { *addr = objc_retain(value) };
+    value
+}
+
+pub unsafe extern "C-unwind" fn objc_loadWeak(addr: *mut *mut AnyObject) -> *mut AnyObject {
+    unsafe { objc_autorelease(objc_loadWeakRetained(addr)) }
+}
+
+pub unsafe extern "C-unwind" fn objc_loadWeakRetained(addr: *mut *mut AnyObject) -> *mut AnyObject {
+    unsafe { objc_retain(*addr) }
+}
+
+pub unsafe extern "C-unwind" fn objc_moveWeak(to: *mut *mut AnyObject, from: *mut *mut AnyObject) {
+    unsafe {
+        *to = *from;
+        *from = ptr::null_mut();
+    }
+}
+
+// Retain / release
+
+pub unsafe extern "C-unwind" fn objc_release(value: *mut AnyObject) {
+    if !value.is_null() {
+        unsafe { send(value, crate::sel!(release)) };
+    }
+}
+
+pub unsafe extern "C-unwind" fn objc_retain(value: *mut AnyObject) -> *mut AnyObject {
+    if !value.is_null() {
+        unsafe { send(value, crate::sel!(retain)) };
+    }
+    value
+}
+
+pub unsafe extern "C-unwind" fn objc_retainAutorelease(value: *mut AnyObject) -> *mut AnyObject {
+    unsafe { objc_autorelease(objc_retain(value)) }
+}
+
+pub unsafe extern "C-unwind" fn objc_retainAutoreleaseReturnValue(
+    value: *mut AnyObject,
+) -> *mut AnyObject {
+    unsafe { objc_retainAutorelease(value) }
+}
+
+pub unsafe extern "C-unwind" fn objc_retainAutoreleasedReturnValue(
+    value: *mut AnyObject,
+) -> *mut AnyObject {
+    unsafe { objc_retain(value) }
+}
+
+/// `_Block_copy`
+pub unsafe extern "C-unwind" fn objc_retainBlock(value: *mut AnyObject) -> *mut AnyObject {
+    unsafe { _Block_copy(value.cast()).cast() }
+}
+
+// Storing values
+
+pub unsafe extern "C-unwind" fn objc_storeStrong(addr: *mut *mut AnyObject, value: *mut AnyObject) {
+    let prev = unsafe { *addr };
+    if prev != value {
+        unsafe {
+            *addr = objc_retain(value);
+            objc_release(prev);
+        }
+    }
+}
+
+pub unsafe extern "C-unwind" fn objc_storeWeak(
+    addr: *mut *mut AnyObject,
+    value: *mut AnyObject,
+) -> *mut AnyObject {
+    unsafe { objc_storeStrong(addr, value) };
+    value
+}
+
+// Classes
+
+/// The returned array is deallocated with [`free`][crate::ffi::free].
+pub unsafe extern "C" fn objc_copyClassList(out_len: *mut c_uint) -> *mut *const AnyClass {
+    let mut len = unsafe { crate::ffi::objc_getClassList(ptr::null_mut(), 0) }.max(0);
+    let buf = loop {
+        let buf: *mut *const AnyClass =
+            unsafe { malloc((len as usize + 1) * mem::size_of::<*const AnyClass>()) }.cast();
+        if buf.is_null() {
+            len = 0;
+            break buf;
+        }
+        // Fills in at most `len` classes, and returns how many are registered
+        // now, which is more if classes were added since the last call.
+        let count = unsafe { crate::ffi::objc_getClassList(buf, len) }.max(0);
+        if count <= len {
+            len = count;
+            unsafe { *buf.add(len as usize) = ptr::null() };
+            break buf;
+        }
+        unsafe { crate::ffi::free(buf.cast()) };
+        len = count;
+    };
+    if !out_len.is_null() {
+        unsafe { *out_len = len as c_uint };
+    }
+    buf
+}
