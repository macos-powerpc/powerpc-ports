sysinfo on powerpc Darwin (Mac OS X 10.4-10.6): don't use functions that 10.6 lacks
(checked against the ppc slices of the 10.6 SDK's libSystem, libobjc and CoreFoundation).
- proc_listallpids() is 10.7+: call proc_listpids(PROC_ALL_PIDS), which is what libproc's
  proc_listallpids() does, on every target.
- proc_pid_rusage() is 10.9+: per-process disk I/O stays 0 on powerpc.

--- a/src/apple/macos/process.rs
+++ b/src/apple/macos/process.rs
@@ -586,2 +586,7 @@
 
+// proc_pid_rusage() is 10.9+: no per-process disk I/O on PowerPC (Mac OS X 10.4-10.6).
+#[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+fn update_proc_disk_activity(_p: &mut Process) {}
+
+#[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
 fn update_proc_disk_activity(p: &mut Process) {
@@ -613,3 +618,5 @@
     unsafe {
-        let count = libc::proc_listallpids(::std::ptr::null_mut(), 0);
+        // proc_listallpids() is 10.7+; this is how libproc implements it (1 = PROC_ALL_PIDS).
+        let count = libc::proc_listpids(1, 0, ::std::ptr::null_mut(), 0)
+            / ::std::mem::size_of::<libc::c_int>() as libc::c_int;
         if count < 1 {
@@ -620,3 +627,4 @@
         let count = count * mem::size_of::<Pid>() as i32;
-        let x = libc::proc_listallpids(pids.as_mut_ptr() as *mut c_void, count);
+        let x = libc::proc_listpids(1, 0, pids.as_mut_ptr() as *mut c_void, count)
+            / ::std::mem::size_of::<libc::c_int>() as libc::c_int;
 
