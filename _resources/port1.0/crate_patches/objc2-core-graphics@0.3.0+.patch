objc2-core-graphics on PowerPC:

- Mac OS X 10.6 and earlier have CoreGraphics only inside ApplicationServices.
  There is no top-level CoreGraphics.framework on PowerPC, so link
  ApplicationServices there, which re-exports CoreGraphics.
- The `objc2-metal` feature is on by default, which builds objc2-metal and
  links Metal into every program that uses this crate with default features.
  There is no Metal on PowerPC (it is OS X 10.11+), so take it out of
  `default`. A crate that asks for the feature explicitly still gets it (and
  the objc2-metal stub, see objc2-metal@*.patch).

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -249,3 +249,2 @@ default = [
     "objc2",
-    "objc2-metal",
 ]
--- a/src/generated/mod.rs
+++ b/src/generated/mod.rs
@@ -19,3 +19,11 @@
 
-#[link(name = "CoreGraphics", kind = "framework")]
+// Mac OS X 10.6 and earlier have CoreGraphics only inside ApplicationServices.
+#[cfg_attr(
+    not(any(target_arch = "powerpc", target_arch = "powerpc64")),
+    link(name = "CoreGraphics", kind = "framework")
+)]
+#[cfg_attr(
+    any(target_arch = "powerpc", target_arch = "powerpc64"),
+    link(name = "ApplicationServices", kind = "framework")
+)]
 extern "C" {}
