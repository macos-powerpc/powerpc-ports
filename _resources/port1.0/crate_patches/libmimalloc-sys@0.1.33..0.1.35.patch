libmimalloc-sys 0.1.33-0.1.35: build the vendored mimalloc for Mac OS X 10.4-10.7 / Darwin ppc.
- The Apple random branch calls arc4random_buf without <stdlib.h>: GCC 14+ rejects the implicit declaration;
  arc4random_buf is 10.7+ and MacPorts legacysupport declares/provides it (stdlib.h selection upstream from 0.1.36).
Not needed from libmimalloc-sys 0.1.36 on. 0.1.24 has its own patch.

--- a/c_src/mimalloc/src/prim/unix/prim.c
+++ b/c_src/mimalloc/src/prim/unix/prim.c
@@ -732,6 +732,7 @@
 #if defined(__APPLE__)
 
 #include <AvailabilityMacros.h>
+#include <stdlib.h>  // arc4random_buf: 10.7+, declared by MacPorts legacysupport before that
 #if defined(MAC_OS_X_VERSION_10_10) && MAC_OS_X_VERSION_MAX_ALLOWED >= MAC_OS_X_VERSION_10_10
 #include <CommonCrypto/CommonCryptoError.h>
 #include <CommonCrypto/CommonRandom.h>
