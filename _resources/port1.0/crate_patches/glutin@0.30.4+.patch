glutin on powerpc-apple-darwin (Mac OS X 10.6 and earlier): NSOpenGLPFAOpenGLProfile is a
10.7 pixel format attribute; 10.6 logs "invalid pixel format attribute" and
-[NSOpenGLPixelFormat initWithAttributes:] returns nil for every profile, so
find_configs always failed with BadConfig (alacritty: 4 templates x 3 profiles = 12
log lines, then no window). On PowerPC drop the attribute and its value and take
the legacy (OpenGL 2.1) pixel format; the context side (NSOpenGLContext) is
10.5-clean. Same code from 0.30.4 (newWithAttributes) to 0.32.3; 0.30.0-0.30.3
use the cocoa crate and are out of the range.

--- a/src/api/cgl/config.rs
+++ b/src/api/cgl/config.rs
@@ -105,4 +105,5 @@
 
         // Automatically pick the latest profile.
+        #[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
         let raw = [
             NSOpenGLProfileVersion4_1Core,
@@ -117,4 +118,12 @@
         })
         .ok_or(ErrorKind::BadConfig)?;
+        // Mac OS X 10.6, the last release for PowerPC, rejects NSOpenGLPFAOpenGLProfile
+        // (10.7+) outright, so ask for the legacy (OpenGL 2.1) format without it.
+        #[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+        let raw = {
+            attrs.truncate(profile_attr_pos - 1);
+            attrs.push(0);
+            unsafe { NSOpenGLPixelFormat::newWithAttributes(&attrs) }.ok_or(ErrorKind::BadConfig)?
+        };
 
