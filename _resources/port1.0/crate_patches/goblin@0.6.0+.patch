+/// `r_info` as a big-endian file stores it -> the layout of the accessors
+#[inline]
+fn r_info_from_big_endian(w: u32) -> u32 {
+    (w >> 8) | ((w >> 7) & 1) << 24 | ((w >> 5) & 3) << 25 | ((w >> 4) & 1) << 27 | (w & 0xf) << 28
