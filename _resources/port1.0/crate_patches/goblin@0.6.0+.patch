+impl<'a> ctx::TryFromCtx<'a, Endian> for RelocationInfo {
+    type Error = scroll::Error;
+    fn try_from_ctx(src: &'a [u8], endian: Endian) -> Result<(Self, usize), Self::Error> {
+        let r_address: i32 = src.pread_with(0, endian)?;
+        let r_info: u32 = src.pread_with(4, endian)?;
+        Ok((
+            RelocationInfo::from_file_words(r_address, r_info, endian),
+            SIZEOF_RELOCATION_INFO,
+        ))
+    }
+}
+
+impl ctx::FromCtx<Endian> for RelocationInfo {
+    fn from_ctx(src: &[u8], endian: Endian) -> Self {
+        RelocationInfo::from_file_words(
+            src.cread_with(0usize, endian),
+            src.cread_with(4usize, endian),
+            endian,
+        )
+    }
+}
+
+impl<'a> ctx::TryIntoCtx<Endian> for &'a RelocationInfo {
+    type Error = scroll::Error;
+    fn try_into_ctx(self, dst: &mut [u8], endian: Endian) -> Result<usize, Self::Error> {
+        dst.pwrite_with(self.r_address, 0, endian)?;
+        dst.pwrite_with(self.file_r_info(endian), 4, endian)?;
+        Ok(SIZEOF_RELOCATION_INFO)
+    }
+}
+
+impl ctx::TryIntoCtx<Endian> for RelocationInfo {
+    type Error = scroll::Error;
+    fn try_into_ctx(self, dst: &mut [u8], endian: Endian) -> Result<usize, Self::Error> {
+        (&self).try_into_ctx(dst, endian)
+    }
