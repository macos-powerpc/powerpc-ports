+/// The layout of the accessors -> `r_info` as a big-endian file stores it
+#[inline]
+fn r_info_to_big_endian(w: u32) -> u32 {
+    (w & 0x00ff_ffff) << 8 | ((w >> 24) & 1) << 7 | ((w >> 25) & 3) << 5 | ((w >> 27) & 1) << 4 | (w >> 28)
+}
