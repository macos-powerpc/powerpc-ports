copypasta: the AppKit static `NSPasteboardTypeFileURL` is exported since macOS 10.13, so
alacritty fails to link on Mac OS X 10.6 (PowerPC). Its value is the UTI "public.file-url"
(kUTTypeFileURL); on powerpc `get_contents` builds that NSString at run time instead and the two
uses keep their text. Other targets compile the original code.

--- a/src/osx_clipboard.rs
+++ b/src/osx_clipboard.rs
@@ -19,5 +19,7 @@
 use objc2::runtime::ProtocolObject;
 use objc2::{msg_send_id, ClassType};
-use objc2_app_kit::{NSPasteboard, NSPasteboardTypeFileURL, NSPasteboardTypeString};
+use objc2_app_kit::{NSPasteboard, NSPasteboardTypeString};
+#[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
+use objc2_app_kit::NSPasteboardTypeFileURL;
 use objc2_foundation::{NSArray, NSString, NSURL};
 
@@ -48,4 +50,10 @@
     fn get_contents(&mut self) -> Result<String> {
         autoreleasepool(|_| {
+            // NSPasteboardTypeFileURL (10.13) is the UTI "public.file-url"; 10.6 (PowerPC) can't link the static
+            #[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+            let file_url_type = NSString::from_str("public.file-url");
+            #[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+            #[allow(non_snake_case)]
+            let NSPasteboardTypeFileURL: &NSString = &file_url_type;
             let types = unsafe { self.pasteboard.types() }.unwrap();
             let has_file = unsafe { types.containsObject(NSPasteboardTypeFileURL) };
