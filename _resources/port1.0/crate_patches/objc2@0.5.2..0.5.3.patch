+    #[cfg(target_arch = "powerpc")]
+    /// Every struct and union is returned through a hidden pointer, whatever
+    /// its size; everything else, including `long long` and floating-point
+    /// values, is returned in registers by plain `objc_msgSend`.
+    ///
+    /// GCC: `rs6000_return_in_memory`, with `aix_struct_return` set on Darwin.
+    unsafe impl<T: EncodeReturn> MsgSendFn for T {
+        const MSG_SEND: Imp = {
+            if let Encoding::Struct(_, _) | Encoding::Union(_, _) = T::ENCODING_RETURN {
+                ffi::objc_msgSend_stret
+            } else {
+                ffi::objc_msgSend
+            }
+        };
+        const MSG_SEND_SUPER: Imp = {
+            if let Encoding::Struct(_, _) | Encoding::Union(_, _) = T::ENCODING_RETURN {
+                ffi::objc_msgSendSuper_stret
+            } else {
+                ffi::objc_msgSendSuper
+            }
+        };
+    }
