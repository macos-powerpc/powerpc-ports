diff -U1 -r a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -22,2 +22,3 @@
 
+#[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
 mod sys {
@@ -36,2 +37,23 @@
     }
+}
+
+// powerpc Darwin (Mac OS X 10.6 and earlier) has no NSUserNotificationCenter and no NSUUID (both 10.8+), and
+// build.rs does not compile objc/notify.m there. Every entry point is a no-op: notifications are dropped
+// (`send_notification` reports `NotificationResponse::None`), the bundle identifier is left to the default
+// and `set_application` succeeds.
+#[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+#[allow(non_snake_case, unused_imports)]
+mod sys {
+    use objc2::rc::Retained;
+    use objc2_foundation::{NSDictionary, NSString};
+
+    pub unsafe fn sendNotification(_title: *const NSString, _subtitle: *const NSString, _message: *const NSString, _options: *const NSDictionary<NSString, NSString>) -> Retained<NSDictionary<NSString, NSString>> {
+        NSDictionary::new()
+    }
+    pub unsafe fn setApplication(_newbundleIdentifier: *const NSString) -> bool {
+        true
+    }
+    pub unsafe fn getBundleIdentifier(_appName: *const NSString) -> *const NSString {
+        std::ptr::null()
+    }
 }
