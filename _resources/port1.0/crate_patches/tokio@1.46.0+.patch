tokio runtime/task/raw.rs: record the task Cell's field offsets with offset_of! (needs Rust 1.77; mrustc targets 1.90)
instead of tokio's hand-rolled #[repr(C)] formula from size_of/align_of. On Darwin PowerPC (32-bit, GCC "power"
alignment) a u64-aligned field that is not the first field of its struct is 4-byte aligned although align_of says 8, so
the formula put Core::task_id at +32 while it really is at +28 whenever the scheduler is 8 bytes (BlockingSchedule =
Option<Arc<dyn Fn>>): every program that builds a runtime (the worker threads are spawn_blocking tasks) died in
Cell::new's debug_assertions check "assertion `left == right` failed left: 5252892 right: 5252896" (sad 0.4.32).
The now-unused const fns are left in place to keep the patch small. Base: tokio 1.46.0.

--- a/src/runtime/task/raw.rs	2026-10-10 17:41:18.114022074 +0000
+++ b/src/runtime/task/raw.rs	2026-10-10 17:41:18.138022682 +0000
@@ -73,39 +73,26 @@
 /// <https://users.rust-lang.org/t/custom-vtables-with-integers/78508>
 struct OffsetHelper<T, S>(T, S);
 impl<T: Future, S: Schedule> OffsetHelper<T, S> {
-    // Pass `size_of`/`align_of` as arguments rather than calling them directly
-    // inside `get_trailer_offset` because trait bounds on generic parameters
-    // of const fn are unstable on our MSRV.
-    const TRAILER_OFFSET: usize = get_trailer_offset(
-        std::mem::size_of::<Header>(),
-        std::mem::size_of::<Core<T, S>>(),
-        std::mem::align_of::<Core<T, S>>(),
-        std::mem::align_of::<Trailer>(),
-    );
+    // Ask the compiler for the field offsets instead of re-deriving them from
+    // `size_of`/`align_of` with the `#[repr(C)]` algorithm. On Darwin PowerPC
+    // (32-bit, "power" alignment) a `u64`-aligned field that is not the first
+    // field of its struct sits at a 4-byte boundary although `align_of::<Id>()`
+    // is 8, so the formula placed `task_id` 4 bytes past its real position
+    // whenever the scheduler is 8 bytes (blocking tasks) and the layout check
+    // in `Cell::new` failed.
+    const TRAILER_OFFSET: usize = std::mem::offset_of!(Cell<T, S>, trailer);
 
     // The `scheduler` is the first field of `Core`, so it has the same
     // offset as `Core`.
-    const SCHEDULER_OFFSET: usize = get_core_offset(
-        std::mem::size_of::<Header>(),
-        std::mem::align_of::<Core<T, S>>(),
-    );
+    const SCHEDULER_OFFSET: usize =
+        std::mem::offset_of!(Cell<T, S>, core) + std::mem::offset_of!(Core<T, S>, scheduler);
 
-    const ID_OFFSET: usize = get_id_offset(
-        std::mem::size_of::<Header>(),
-        std::mem::align_of::<Core<T, S>>(),
-        std::mem::size_of::<S>(),
-        std::mem::align_of::<Id>(),
-    );
+    const ID_OFFSET: usize =
+        std::mem::offset_of!(Cell<T, S>, core) + std::mem::offset_of!(Core<T, S>, task_id);
 
     #[cfg(tokio_unstable)]
-    const SPAWN_LOCATION_OFFSET: usize = get_spawn_location_offset(
-        std::mem::size_of::<Header>(),
-        std::mem::align_of::<Core<T, S>>(),
-        std::mem::size_of::<S>(),
-        std::mem::align_of::<Id>(),
-        std::mem::size_of::<Id>(),
-        std::mem::align_of::<&'static Location<'static>>(),
-    );
+    const SPAWN_LOCATION_OFFSET: usize =
+        std::mem::offset_of!(Cell<T, S>, core) + std::mem::offset_of!(Core<T, S>, spawned_at);
 }
 
