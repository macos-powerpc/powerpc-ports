libmimalloc-sys 0.1.31-0.1.32: build the vendored mimalloc for Mac OS X 10.4-10.7 / Darwin ppc.
- MACH_TASK_BASIC_INFO is 10.8+: fall back to TASK_BASIC_INFO (as mimalloc does from libmimalloc-sys 0.1.33).
- Darwin as wants `r27`, not `27`, in the ppc spin-wait hint (mimalloc has `r27` for __APPLE__ from 0.1.33).
- The Apple random branch calls arc4random_buf without <stdlib.h>: GCC 14+ rejects the implicit declaration;
  arc4random_buf is 10.7+ and MacPorts legacysupport declares/provides it (stdlib.h selection upstream from 0.1.36).
Not needed from libmimalloc-sys 0.1.36 on. 0.1.24 has its own patch.

--- a/c_src/mimalloc/include/mimalloc/atomic.h
+++ b/c_src/mimalloc/include/mimalloc/atomic.h
@@ -316,6 +316,10 @@
 static inline void mi_atomic_yield(void) {
   __asm__ volatile("yield" ::: "memory");
 }
+#elif defined(__APPLE__) && defined(__POWERPC__)
+static inline void mi_atomic_yield(void) {
+  __asm__ __volatile__ ("or r27,r27,r27" ::: "memory");  // Darwin as: r-prefixed registers
+}
 #elif defined(__powerpc__) || defined(__ppc__) || defined(__PPC__)
 static inline void mi_atomic_yield(void) {
   __asm__ __volatile__ ("or 27,27,27" ::: "memory");
--- a/c_src/mimalloc/src/prim/unix/prim.c
+++ b/c_src/mimalloc/src/prim/unix/prim.c
@@ -610,11 +610,19 @@
   pinfo->page_faults = 0;
 #elif defined(__APPLE__)
   pinfo->peak_rss = rusage.ru_maxrss;         // macos reports in bytes
+#ifdef MACH_TASK_BASIC_INFO
   struct mach_task_basic_info info;
   mach_msg_type_number_t infoCount = MACH_TASK_BASIC_INFO_COUNT;
   if (task_info(mach_task_self(), MACH_TASK_BASIC_INFO, (task_info_t)&info, &infoCount) == KERN_SUCCESS) {
     pinfo->current_rss = (size_t)info.resident_size;
   }
+#else  // MACH_TASK_BASIC_INFO is 10.8+
+  struct task_basic_info info;
+  mach_msg_type_number_t infoCount = TASK_BASIC_INFO_COUNT;
+  if (task_info(mach_task_self(), TASK_BASIC_INFO, (task_info_t)&info, &infoCount) == KERN_SUCCESS) {
+    pinfo->current_rss = (size_t)info.resident_size;
+  }
+#endif
 #else
   pinfo->peak_rss = rusage.ru_maxrss * 1024;  // Linux/BSD report in KiB
 #endif
@@ -711,6 +719,7 @@
 #if defined(__APPLE__)
 
 #include <AvailabilityMacros.h>
+#include <stdlib.h>  // arc4random_buf: 10.7+, declared by MacPorts legacysupport before that
 #if defined(MAC_OS_X_VERSION_10_10) && MAC_OS_X_VERSION_MAX_ALLOWED >= MAC_OS_X_VERSION_10_10
 #include <CommonCrypto/CommonCryptoError.h>
 #include <CommonCrypto/CommonRandom.h>
