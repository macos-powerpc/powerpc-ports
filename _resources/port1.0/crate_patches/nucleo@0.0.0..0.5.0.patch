+/// The `inflight` counter of [`Vec`]. It is a `u64` so that running past the `u32`
+/// indices is caught in `push` instead of wrapping around to an index in use.
+#[cfg(target_has_atomic = "64")]
+struct Inflight(AtomicU64);
+
+#[cfg(target_has_atomic = "64")]
+impl Inflight {
+    fn new() -> Self {
+        Inflight(AtomicU64::new(0))
+    }
+    fn load(&self, order: Ordering) -> u64 {
+        self.0.load(order)
+    }
+    fn fetch_add_one(&self, order: Ordering) -> u64 {
+        self.0.fetch_add(1, order)
+    }
+}
+
+/// Targets without 64-bit atomics (32-bit PowerPC, MIPS, ...): a `u32` that is
+/// never incremented past `u32::MAX`; once it is there, `fetch_add_one` returns
+/// `u32::MAX + 1`, which `push` rejects like the `u64` counter's overflow.
+#[cfg(not(target_has_atomic = "64"))]
+struct Inflight(AtomicU32);
+
+#[cfg(not(target_has_atomic = "64"))]
+impl Inflight {
+    fn new() -> Self {
+        Inflight(AtomicU32::new(0))
+    }
+    fn load(&self, order: Ordering) -> u64 {
+        self.0.load(order) as u64
+    }
+    fn fetch_add_one(&self, order: Ordering) -> u64 {
+        match self.0.fetch_update(order, Ordering::Relaxed, |i| i.checked_add(1)) {
+            Ok(i) => i as u64,
+            Err(i) => i as u64 + 1,
+        }
+    }
+}
+
 /// A lock-free, append-only vector.
