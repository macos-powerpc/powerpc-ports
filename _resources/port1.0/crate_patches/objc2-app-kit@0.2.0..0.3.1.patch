objc2-app-kit: AppKit on PowerPC uses the classic enum values
(NSTextAlignment Right = 1, Center = 2; see NSText.h in the 10.6 SDK), not
the iOS ones that TARGET_ABI_USES_IOS_VALUES selects for every architecture
other than x86_64.

--- a/src/lib.rs
+++ b/src/lib.rs
@@ -57,7 +57,12 @@ extern "C" {}
 // TODO: Make this work with mac catalyst
 #[allow(dead_code)]
 pub(crate) const TARGET_ABI_USES_IOS_VALUES: bool =
-    !cfg!(any(target_arch = "x86", target_arch = "x86_64")) || cfg!(not(target_os = "macos"));
+    !cfg!(any(
+        target_arch = "x86",
+        target_arch = "x86_64",
+        target_arch = "powerpc",
+        target_arch = "powerpc64"
+    )) || cfg!(not(target_os = "macos"));
 
 #[cfg(feature = "NSApplication")]
 mod application;
