objc2-exception-helper: libobjc has no objc_retain before Mac OS X 10.7, so on
PowerPC retain the caught exception with a -retain message instead.

The helper is compiled as Objective-C with -fobjc-exceptions; GCC does that
for the NeXT runtime on powerpc-apple-darwin, using the setjmp-based
objc_exception_try_enter/objc_exception_extract of the legacy runtime.

--- a/src/try_catch.m
+++ b/src/try_catch.m
@@ -17,7 +17,12 @@ unsigned char objc2_exception_helper_0_2_try_catch_exception(void (*f)(void *),
     } @catch (id exception) {
         // The exception is retained while inside the `@catch` block, but is
         // not guaranteed to be so outside of it; so hence we must do it here!
+#if defined(__ppc__) || defined(__ppc64__)
+        // libobjc has no `objc_retain` before Mac OS X 10.7.
+        *error = [exception retain];
+#else
         *error = objc_retain(exception);
+#endif
         return 1;
     }
 }
