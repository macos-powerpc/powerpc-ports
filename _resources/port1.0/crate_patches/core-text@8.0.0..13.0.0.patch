core-text: Mac OS X 10.6 and earlier have CoreText only inside ApplicationServices
(re-exported from it); there is no top-level CoreText.framework on PowerPC, so link
ApplicationServices there. core-text up to 7.0.0 linked ApplicationServices itself.

--- a/src/font.rs
+++ b/src/font.rs
@@ -419,3 +419,4 @@
 
-#[link(name = "CoreText", kind = "framework")]
+#[cfg_attr(not(any(target_arch = "powerpc", target_arch = "powerpc64")), link(name = "CoreText", kind = "framework"))]
+#[cfg_attr(any(target_arch = "powerpc", target_arch = "powerpc64"), link(name = "ApplicationServices", kind = "framework"))]
 extern {
