winit: Mac OS X 10.6 and earlier have CoreGraphics only inside ApplicationServices
(re-exported from it); there is no top-level CoreGraphics.framework on PowerPC, so link
ApplicationServices there. The opt-in ColorSync link (WINIT_LINK_COLORSYNC, 0.25-0.26)
is left alone.

--- a/src/platform_impl/macos/ffi.rs
+++ b/src/platform_impl/macos/ffi.rs
@@ -186,3 +186,4 @@
 
-#[link(name = "CoreGraphics", kind = "framework")]
+#[cfg_attr(not(any(target_arch = "powerpc", target_arch = "powerpc64")), link(name = "CoreGraphics", kind = "framework"))]
+#[cfg_attr(any(target_arch = "powerpc", target_arch = "powerpc64"), link(name = "ApplicationServices", kind = "framework"))]
 extern "C" {
