--- a/src/arch/powerpc32.s	2026-10-05 19:30:56.728272767 +0000
+++ b/src/arch/powerpc32.s	2026-10-05 19:30:56.768273841 +0000
@@ -4,6 +4,65 @@
    well?
 */
 
+#if defined(CFG_TARGET_OS_darwin) || defined(CFG_TARGET_OS_macos) || defined(CFG_TARGET_OS_ios)
+
+/* Darwin (Mach-O) PowerPC32.
+   - Symbols carry a `_` prefix, registers are written `rN`, and the cctools assembler has no `.type`,
+     `.size` or `.cfi_*` directives.
+   - The frame layout differs from SysV: the CALLEE saves its LR at 8(r1) of its caller's frame (so that
+     slot can't hold our own saved LR as it does in the SysV code below) and may spill its register
+     arguments into the caller's parameter area at 24(r1)..55(r1). Our frame is therefore 64 bytes
+     (keeping the 16-byte stack alignment) with the saved LR at 56(r1), above both areas.
+*/
+
+.text
+
+.globl _rust_psm_stack_direction
+.align 2
+_rust_psm_stack_direction:
+/* extern "C" fn() -> u8 */
+    li r3, STACK_DIRECTION_DESCENDING
+    blr
+
+
+.globl _rust_psm_stack_pointer
+.align 2
+_rust_psm_stack_pointer:
+/* extern "C" fn() -> *mut u8 */
+    mr r3, r1
+    blr
+
+
+.globl _rust_psm_replace_stack
+.align 2
+_rust_psm_replace_stack:
+/* extern "C" fn(r3: usize, r4: extern "C" fn(usize) -> !, r5: *mut u8, r6: *mut u8 (unused)) -> ! */
+    addi r5, r5, -64
+    li r0, 0
+    stw r0, 0(r5)
+    mr r1, r5
+    mtctr r4
+    bctr
+
+
+.globl _rust_psm_on_stack
+.align 2
+_rust_psm_on_stack:
+/* extern "C" fn(r3: usize, r4: usize, r5: extern "C" fn(usize, usize), r6: *mut u8, r7: *mut u8 (unused)) */
+    mflr r0
+    addi r6, r6, -64
+    stw r0, 56(r6)
+    subf r6, r1, r6
+    stwux r1, r1, r6
+    mtctr r5
+    bctrl
+    lwz r0, 56(r1)
+    mtlr r0
+    lwz r1, 0(r1)
+    blr
+
+#else /* SysV */
+
 .text
 .globl rust_psm_stack_direction
 .p2align 2
@@ -75,3 +134,5 @@
 .rust_psm_on_stack_end:
 .size       rust_psm_on_stack,.rust_psm_on_stack_end-rust_psm_on_stack
 .cfi_endproc
+
+#endif
