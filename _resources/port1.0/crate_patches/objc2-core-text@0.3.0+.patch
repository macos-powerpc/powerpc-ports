objc2-core-text: Mac OS X 10.6 and earlier have CoreText only inside ApplicationServices.
There is no top-level CoreText.framework on PowerPC, so link ApplicationServices
there, which re-exports CoreText.

--- a/src/generated/mod.rs
+++ b/src/generated/mod.rs
@@ -15,3 +15,11 @@
 
-#[link(name = "CoreText", kind = "framework")]
+// Mac OS X 10.6 and earlier have CoreText only inside ApplicationServices.
+#[cfg_attr(
+    not(any(target_arch = "powerpc", target_arch = "powerpc64")),
+    link(name = "CoreText", kind = "framework")
+)]
+#[cfg_attr(
+    any(target_arch = "powerpc", target_arch = "powerpc64"),
+    link(name = "ApplicationServices", kind = "framework")
+)]
 extern "C" {}
