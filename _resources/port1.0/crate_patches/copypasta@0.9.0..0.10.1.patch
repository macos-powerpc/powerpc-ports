copypasta: the AppKit static `NSPasteboardTypeFileURL` is exported since macOS 10.13, so a
consumer fails to link on Mac OS X 10.6 (PowerPC). Its value is the UTI "public.file-url"
(kUTTypeFileURL); on powerpc `get_contents` builds that (autoreleased) NSString at run time
instead and the two uses keep their text. Other targets compile the original code.

--- a/src/osx_clipboard.rs
+++ b/src/osx_clipboard.rs
@@ -29,4 +29,5 @@
 #[link(name = "AppKit", kind = "framework")]
 extern "C" {
+    #[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
     pub static NSPasteboardTypeFileURL: *mut Object;
     pub static NSPasteboardTypeString: *mut Object;
@@ -48,4 +49,9 @@
     fn get_contents(&mut self) -> Result<String> {
         autoreleasepool(|| unsafe {
+            // NSPasteboardTypeFileURL (10.13) is the UTI "public.file-url"; 10.6 (PowerPC) can't link the static
+            #[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+            #[allow(non_snake_case)]
+            let NSPasteboardTypeFileURL: *mut Object =
+                msg_send![class!(NSString), stringWithUTF8String: b"public.file-url\0".as_ptr()];
             let types: *mut NSArray<*mut NSString> = msg_send![self.pasteboard, types];
             let has_file: BOOL = msg_send![types, containsObject: NSPasteboardTypeFileURL];
