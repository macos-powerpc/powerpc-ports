objc2-core-image: Mac OS X 10.6 and earlier have CoreImage only inside
QuartzCore. There is no top-level CoreImage.framework on PowerPC, so link
QuartzCore there.

--- a/src/generated/mod.rs
+++ b/src/generated/mod.rs
@@ -15,3 +15,11 @@
 
-#[link(name = "CoreImage", kind = "framework")]
+// Mac OS X 10.6 and earlier have CoreImage only inside QuartzCore.
+#[cfg_attr(
+    not(any(target_arch = "powerpc", target_arch = "powerpc64")),
+    link(name = "CoreImage", kind = "framework")
+)]
+#[cfg_attr(
+    any(target_arch = "powerpc", target_arch = "powerpc64"),
+    link(name = "QuartzCore", kind = "framework")
+)]
 extern "C" {}
