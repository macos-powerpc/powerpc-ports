dispatch2: libdispatch before OS X 10.10 (all of PowerPC: 10.6 is the only
release with libdispatch) knows only the global queue priorities, and
dispatch_get_global_queue() returns NULL for a QoS class, which
DispatchQueue::global_queue() then uses as a queue. On PowerPC, pass the
priority that libdispatch maps the QoS class to instead.

Everything else dispatch2 uses by default (dispatch_*_f, semaphores, groups,
sources, dispatch_once's ~0 fast path) is in the 10.6 libdispatch. Data, I/O,
workloops and concurrent private queues are newer; using them is a link
error.

--- a/src/queue.rs
+++ b/src/queue.rs
@@ -55,11 +55,33 @@ impl GlobalQueueIdentifier {
     pub fn to_identifier(self) -> isize {
         match self {
             GlobalQueueIdentifier::Priority(queue_priority) => queue_priority.0 as isize,
-            GlobalQueueIdentifier::QualityOfService(qos_class) => qos_class.0 as isize,
+            GlobalQueueIdentifier::QualityOfService(qos_class) => qos_identifier(qos_class),
         }
     }
 }
 
+#[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
+#[inline]
+fn qos_identifier(qos_class: DispatchQoS) -> isize {
+    qos_class.0 as isize
+}
+
+/// libdispatch before OS X 10.10 (so all of PowerPC) only knows the queue
+/// priorities, and returns NULL for a QoS class: use the priority that
+/// libdispatch maps to that class.
+#[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+#[inline]
+fn qos_identifier(qos_class: DispatchQoS) -> isize {
+    let priority = if qos_class.0 >= DispatchQoS::UserInitiated.0 {
+        DispatchQueueGlobalPriority::High
+    } else if qos_class.0 >= DispatchQoS::Default.0 || qos_class.0 == DispatchQoS::Unspecified.0 {
+        DispatchQueueGlobalPriority::Default
+    } else {
+        DispatchQueueGlobalPriority::Low
+    };
+    priority.0 as isize
+}
+
 dispatch_object!(
     /// Dispatch queue.
     #[doc(alias = "dispatch_queue_t")]
