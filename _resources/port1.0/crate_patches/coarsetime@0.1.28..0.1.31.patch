coarsetime: 32-bit PowerPC has no 64-bit atomics, so std::sync::atomic::AtomicU64 does not exist there ("Unable to
resolve `use` target std::sync::atomic::AtomicU64" in src/instant.rs; rustc on ppc32 fails the same way). The most
recent timestamp is a `static RECENT: AtomicU64` read with `load` and written with `store`; the value is the crate's
u64 fixed-point tick count, so a narrower atomic would truncate it. New src/atomic64.rs: `std`'s AtomicU64 where the
target has 64-bit atomics (`cfg(target_has_atomic = "64")`), else a Mutex<u64> with the same `const fn new` / `load`
/ `store` surface; instant.rs imports it from there (these releases have no RECENT in clock.rs; 0.1.32+ do, see
coarsetime@0.1.32+.patch). Same lines in 0.1.28..0.1.31. Base: coarsetime 0.1.31.

diff -ruN a/src/atomic64.rs b/src/atomic64.rs
--- a/src/atomic64.rs
+++ b/src/atomic64.rs
@@ -0,0 +1,38 @@
+//! `AtomicU64` for targets without 64-bit atomics.
+//!
+//! 32-bit PowerPC, MIPS and older ARM have no `std::sync::atomic::AtomicU64`.
+//! The cached timestamps are `u64` ticks, so a narrower atomic would truncate
+//! them; those targets get a mutex with the same `new`/`load`/`store` surface.
+
+#[cfg(target_has_atomic = "64")]
+pub(crate) use std::sync::atomic::AtomicU64;
+
+#[cfg(not(target_has_atomic = "64"))]
+pub(crate) use fallback::AtomicU64;
+
+#[cfg(not(target_has_atomic = "64"))]
+mod fallback {
+    use std::sync::atomic::Ordering;
+    use std::sync::Mutex;
+
+    #[derive(Debug)]
+    pub(crate) struct AtomicU64(Mutex<u64>);
+
+    impl AtomicU64 {
+        pub(crate) const fn new(value: u64) -> Self {
+            Self(Mutex::new(value))
+        }
+
+        fn lock(&self) -> std::sync::MutexGuard<'_, u64> {
+            self.0.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+        }
+
+        pub(crate) fn load(&self, _order: Ordering) -> u64 {
+            *self.lock()
+        }
+
+        pub(crate) fn store(&self, value: u64, _order: Ordering) {
+            *self.lock() = value;
+        }
+    }
+}
