+use std::any::{Any, TypeId};
+use std::mem;
+
+use runtime::Imp;
+
+extern {
+    fn objc_msgSend();
+    fn objc_msgSend_stret();
+
+    fn objc_msgSendSuper();
+    fn objc_msgSendSuper_stret();
+}
+
+// 32-bit PowerPC (Mac OS X 10.4-10.6): structures of every size are returned through
+// a hidden pointer (the _stret variants); integers and pointers come back in r3/r4 and
+// floating-point values in f1, so plain objc_msgSend serves those (no _fpret needed).
+// All that is known about R is its size and TypeId, so anything of at most 4 bytes, and
+// u64/i64/f64, is taken as a scalar and everything else as a structure. That covers
+// pointers, BOOL, NSInteger, CGFloat, NSPoint/NSSize/NSRange (8 bytes) and NSRect; only
+// a structure of 1, 2 or 4 bytes would be sent the wrong way.
+fn returns_in_registers<R: Any>() -> bool {
+    let type_id = TypeId::of::<R>();
+    mem::size_of::<R>() <= 4 ||
+        type_id == TypeId::of::<u64>() ||
+        type_id == TypeId::of::<i64>() ||
+        type_id == TypeId::of::<f64>()
+}
+
+pub fn msg_send_fn<R: Any>() -> Imp {
+    if returns_in_registers::<R>() {
+        objc_msgSend
+    } else {
+        objc_msgSend_stret
+    }
+}
+
+pub fn msg_send_super_fn<R: Any>() -> Imp {
+    if returns_in_registers::<R>() {
+        objc_msgSendSuper
+    } else {
+        objc_msgSendSuper_stret
+    }
+}
