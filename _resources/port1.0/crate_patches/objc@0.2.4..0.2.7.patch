+#[cfg(target_arch = "powerpc")]
+pub use self::arc_fallback::{objc_retain, objc_release, objc_autorelease,
+                             objc_autoreleasePoolPush, objc_autoreleasePoolPop};
+
+// 32-bit PowerPC (Mac OS X 10.4-10.6): libobjc has none of the ARC entry points (10.7), so
+// send the messages they stand for. They are not exported (#[no_mangle]): another objc crate
+// in the same program may define them too. The weak-reference functions have no equivalent
+// and stay undefined, so a program that really uses WeakPtr fails to link instead of
+// misbehaving.
+#[cfg(target_arch = "powerpc")]
+mod arc_fallback {
+    use std::mem;
+    use std::os::raw::{c_char, c_void};
+    use std::sync::atomic::{AtomicPtr, Ordering};
+    use super::{Object, Sel, objc_getClass, sel_registerName};
+
+    extern {
+        fn objc_msgSend();
+    }
+
+    unsafe fn send(obj: *mut Object, cache: &AtomicPtr<c_void>, name: &'static [u8]) -> *mut Object {
+        let mut sel = cache.load(Ordering::Relaxed);
+        if sel.is_null() {
+            sel = sel_registerName(name.as_ptr() as *const c_char).as_ptr() as *mut c_void;
+            cache.store(sel, Ordering::Relaxed);
+        }
+        let imp: unsafe extern fn(*mut Object, Sel) -> *mut Object =
+            mem::transmute(objc_msgSend as unsafe extern fn());
+        imp(obj, Sel::from_ptr(sel))
+    }
+
+    static RETAIN: AtomicPtr<c_void> = AtomicPtr::new(0 as *mut c_void);
+    static RELEASE: AtomicPtr<c_void> = AtomicPtr::new(0 as *mut c_void);
+    static AUTORELEASE: AtomicPtr<c_void> = AtomicPtr::new(0 as *mut c_void);
+    static NEW: AtomicPtr<c_void> = AtomicPtr::new(0 as *mut c_void);
+    static DRAIN: AtomicPtr<c_void> = AtomicPtr::new(0 as *mut c_void);
+
+    /// `[obj retain]`
+    pub unsafe fn objc_retain(obj: *mut Object) -> *mut Object {
+        send(obj, &RETAIN, b"retain\0")
+    }
+    /// `[obj release]`
+    pub unsafe fn objc_release(obj: *mut Object) {
+        send(obj, &RELEASE, b"release\0");
+    }
+    /// `[obj autorelease]`
+    pub unsafe fn objc_autorelease(obj: *mut Object) {
+        send(obj, &AUTORELEASE, b"autorelease\0");
+    }
+    /// `[NSAutoreleasePool new]`, or null if Foundation isn't loaded (then nothing can be
+    /// autoreleased either)
+    pub unsafe fn objc_autoreleasePoolPush() -> *mut c_void {
+        let cls = objc_getClass(b"NSAutoreleasePool\0".as_ptr() as *const c_char);
+        if cls.is_null() {
+            return 0 as *mut c_void;
+        }
+        send(cls as *mut Object, &NEW, b"new\0") as *mut c_void
+    }
+    /// `[pool drain]`
+    pub unsafe fn objc_autoreleasePoolPop(context: *mut c_void) {
+        if !context.is_null() {
+            send(context as *mut Object, &DRAIN, b"drain\0");
+        }
+    }
+}
+
