core-text: CTFontDrawGlyphs (10.7) and CTFontCopyDefaultCascadeListForLanguages (10.8) do not
exist on Mac OS X 10.6, so crossfont (alacritty) fails to link on PowerPC. On powerpc, `draw_glyphs`
sets the font's CGFont and point size on the context and calls CGContextShowGlyphsAtPositions
(10.5; the same thing CTFontDrawGlyphs does for a font created without a matrix, minus colour
glyphs, which 10.6 has none of), and `cascade_list_for_languages` returns an empty list (the
caller's fallback fonts are then only what it adds itself, e.g. crossfont's "Apple Symbols").
Other targets compile the original functions.

--- a/src/font.rs
+++ b/src/font.rs
@@ -481,2 +481,12 @@
 
+    // CTFontDrawGlyphs is 10.7+: Mac OS X 10.6 (PowerPC) draws through the font's CGFont at its point size
+    #[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+    pub fn draw_glyphs(&self, glyphs: &[CGGlyph], positions: &[CGPoint], context: CGContext) {
+        assert_eq!(glyphs.len(), positions.len());
+        context.set_font(&self.copy_to_CGFont());
+        context.set_font_size(self.pt_size());
+        context.show_glyphs_at_positions(glyphs, positions);
+    }
+
+    #[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
     pub fn draw_glyphs(&self, glyphs: &[CGGlyph], positions: &[CGPoint], context: CGContext) {
@@ -582,2 +592,13 @@
 
+// CTFontCopyDefaultCascadeListForLanguages is 10.8+: no system cascade list on Mac OS X 10.6 (PowerPC)
+#[cfg(feature = "mountainlion")]
+#[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+pub fn cascade_list_for_languages(
+    _font: &CTFont,
+    _language_pref_list: &CFArray<CFString>,
+) -> CFArray<CTFontDescriptor> {
+    CFArray::<CTFontDescriptor>::from_CFTypes(&[])
+}
+
+#[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
 #[cfg(feature = "mountainlion")]
