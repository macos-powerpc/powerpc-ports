@@ -0,0 +1,18 @@
+//! Mac OS X on PowerPC (10.4-10.6): use a PEM bundle, as OpenSSL does, instead of the keychain.
+//!
+//! The keychain path (`macos.rs`, security-framework) needs newer Security.framework entry points, and the 10.6
+//! system roots are long out of date. The bundle is MacPorts' curl-ca-bundle; `MACPORTS_CA_BUNDLE` at build time
+//! overrides the path, and `SSL_CERT_FILE` / `SSL_CERT_DIR` at run time still take precedence (see `lib.rs`).
+
+use std::path::PathBuf;
+
+use crate::{CertPaths, CertificateResult};
+
+pub fn load_native_certs() -> CertificateResult {
+    let file = option_env!("MACPORTS_CA_BUNDLE").unwrap_or("/opt/local/share/curl/curl-ca-bundle.crt");
+    CertPaths {
+        file: Some(PathBuf::from(file)),
+        dirs: Vec::new(),
+    }
+    .load()
+}
