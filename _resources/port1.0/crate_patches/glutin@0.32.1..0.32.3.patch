glutin on powerpc-apple-darwin (Mac OS X 10.6 and earlier): api/cgl/surface.rs sends
`setWantsBestResolutionOpenGLSurface:` and `backingScaleFactor` (both 10.7) for every surface; on 10.6 they
are unrecognized selectors (with objc2 debug assertions: a panic "method not found"). PowerPC has no HiDPI:
skip the former, scale factor 1.0 for the latter. Companion of the config.rs NSOpenGLPFAOpenGLProfile patch.

--- a/src/api/cgl/surface.rs
+++ b/src/api/cgl/surface.rs
@@ -72,8 +72,11 @@
         // linked with the macOS 10.14 SDK and `true` if linked with a macOS 10.15 SDK
         // or newer. We always set it to `true` because we want High DPI surfaces, and
         // we want to avoid this confusing default system value.
+        // Mac OS X 10.6 (PowerPC) has neither this selector (10.7) nor HiDPI.
         #[allow(deprecated)]
-        ns_view.setWantsBestResolutionOpenGLSurface(true);
+        if !cfg!(any(target_arch = "powerpc", target_arch = "powerpc64")) {
+            ns_view.setWantsBestResolutionOpenGLSurface(true);
+        }
 
         // On Mojave, views apparently automatically become layer-backed shortly after
         // being added to a window. Changing the layer-backedness of a view breaks the
@@ -122,7 +125,14 @@
         run_on_main(|mtm| {
             let view = view.get(mtm);
             let scale_factor = match view.window() {
-                Some(window) => window.backingScaleFactor(),
+                // `backingScaleFactor` is 10.7; Mac OS X 10.6 (PowerPC) has no HiDPI
+                Some(window) => {
+                    if cfg!(any(target_arch = "powerpc", target_arch = "powerpc64")) {
+                        1.0
+                    } else {
+                        window.backingScaleFactor()
+                    }
+                },
                 None => 1.0,
             };
             let frame = view.frame();
@@ -135,7 +145,14 @@
         run_on_main(|mtm| {
             let view = view.get(mtm);
             let scale_factor = match view.window() {
-                Some(window) => window.backingScaleFactor(),
+                // `backingScaleFactor` is 10.7; Mac OS X 10.6 (PowerPC) has no HiDPI
+                Some(window) => {
+                    if cfg!(any(target_arch = "powerpc", target_arch = "powerpc64")) {
+                        1.0
+                    } else {
+                        window.backingScaleFactor()
+                    }
+                },
                 None => 1.0,
             };
             let frame = view.frame();
