objc2-metal: a stub on PowerPC. There is no Metal before OS X 10.11.

- Don't link Metal.framework, so a program that has this crate in its
  dependency graph still links.
- MTLCreateSystemDefaultDevice() returns no device and MTLCopyAllDevices()
  an empty array, so code that looks for a Metal device takes its fallback.

The classes don't exist at run time, and any other Metal function or static
that is actually used is undefined at link time.

--- a/src/device.rs
+++ b/src/device.rs
@@ -25,3 +25,5 @@ pub extern "C-unwind" fn MTLCopyAllDevices() -> Retained<NSArray<ProtocolObject<
     // to call the actual API when available.
-    #[cfg(target_os = "macos")]
+    //
+    // There is no Metal on PowerPC: there are no devices.
+    #[cfg(all(target_os = "macos", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))]
     {
@@ -36,3 +38,3 @@ pub extern "C-unwind" fn MTLCopyAllDevices() -> Retained<NSArray<ProtocolObject<
     }
-    #[cfg(not(target_os = "macos"))]
+    #[cfg(not(all(target_os = "macos", not(any(target_arch = "powerpc", target_arch = "powerpc64")))))]
     {
--- a/src/generated/MTLDevice.rs
+++ b/src/generated/MTLDevice.rs
@@ -48,7 +48,15 @@ pub extern "C-unwind" fn MTLCreateSystemDefaultDevice(
 ) -> Option<Retained<ProtocolObject<dyn MTLDevice>>> {
-    extern "C-unwind" {
-        fn MTLCreateSystemDefaultDevice() -> *mut ProtocolObject<dyn MTLDevice>;
+    #[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
+    {
+        extern "C-unwind" {
+            fn MTLCreateSystemDefaultDevice() -> *mut ProtocolObject<dyn MTLDevice>;
+        }
+        let ret = unsafe { MTLCreateSystemDefaultDevice() };
+        unsafe { Retained::from_raw(ret) }
+    }
+    // There is no Metal on PowerPC.
+    #[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+    {
+        None
     }
-    let ret = unsafe { MTLCreateSystemDefaultDevice() };
-    unsafe { Retained::from_raw(ret) }
 }
--- a/src/generated/mod.rs
+++ b/src/generated/mod.rs
@@ -20,3 +20,7 @@
 
-#[link(name = "Metal", kind = "framework")]
+// Metal is OS X 10.11+, there is none on PowerPC.
+#[cfg_attr(
+    not(any(target_arch = "powerpc", target_arch = "powerpc64")),
+    link(name = "Metal", kind = "framework")
+)]
 extern "C" {}
