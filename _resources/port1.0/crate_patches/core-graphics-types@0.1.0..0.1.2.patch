core-graphics-types on PowerPC:
- boolean_t had no definition for powerpc (a compile error). It is `int` on
  ppc and `unsigned int` on ppc64 (mach/ppc/boolean.h).
- Mac OS X 10.6 and earlier have CoreGraphics only inside ApplicationServices;
  there is no top-level CoreGraphics.framework on PowerPC, so link
  ApplicationServices there, which re-exports CoreGraphics.

--- a/src/base.rs
+++ b/src/base.rs
@@ -18,5 +18,7 @@ use libc;
           target_arch = "arm",
-          target_arch = "aarch64"))]
+          target_arch = "aarch64",
+          target_arch = "powerpc"))]
 pub type boolean_t = libc::c_int;
-#[cfg(target_arch = "x86_64")]
+#[cfg(any(target_arch = "x86_64",
+          target_arch = "powerpc64"))]
 pub type boolean_t = libc::c_uint;
--- a/src/geometry.rs
+++ b/src/geometry.rs
@@ -184,3 +184,4 @@ mod ffi {
 
-    #[link(name = "CoreGraphics", kind = "framework")]
+    #[cfg_attr(not(any(target_arch = "powerpc", target_arch = "powerpc64")), link(name = "CoreGraphics", kind = "framework"))]
+    #[cfg_attr(any(target_arch = "powerpc", target_arch = "powerpc64"), link(name = "ApplicationServices", kind = "framework"))]
     extern {
