merlin 1.2.1..3.0.0: support big-endian targets (zkcrypto/merlin PR #5)

mrustc on powerpc-apple-darwin (arti 2.7.0):

    merlin-3.0.0/src/lib.rs:10-16 error:0: compile_error! "This crate doesn't support big-endian
    targets, since I didn't have one to test correctness on. ..."

lib.rs only carries the guard; the one endian-dependent spot is strobe.rs. STROBE works on
the Keccak state as 200 bytes, and Keccak-f[1600] reads those bytes as 25 little-endian 64-bit
lanes (FIPS 202 3.1.2). merlin casts the 8-aligned byte array to `[u64; 25]` and calls
`keccak::f1600` on native words, which is right only on little-endian. On big-endian the state is
decoded into lanes with `LittleEndian::read_u64_into`, permuted, and written back with
`write_u64_into` (byteorder, already a merlin dependency for the transcript's u64/u32 encoding;
both functions exist since byteorder 1.2.0, merlin requires 1.2.4). The little-endian path is
unchanged. Nothing else in the crate depends on byte order: transcript.rs encodes integers with
byteorder LittleEndian and TranscriptRng goes through rand_core's fill-based helpers.

Upstream: https://github.com/zkcrypto/merlin/pull/5 (Ulrich Weigand, tested on s390x), unmerged;
3.0.0 is the latest release. This is the PR's diff unchanged, regenerated against 3.0.0 with
crate-relative paths. It applies without fuzz to 1.2.1, 1.3.0, 2.0.0, 2.0.1 and 3.0.0; 1.0.0..1.2.0
have a different lib.rs header (not covered).

--- a/src/lib.rs
+++ b/src/lib.rs
@@ -6,15 +6,6 @@
 //! Note that docs will only build on nightly Rust until
 //! [RFC 1990 stabilizes](https://github.com/rust-lang/rust/issues/44732).
 
-#[cfg(target_endian = "big")]
-compile_error!(
-    r#"
-This crate doesn't support big-endian targets, since I didn't
-have one to test correctness on.  If you're seeing this message,
-please file an issue!
-"#
-);
-
 mod constants;
 mod strobe;
 mod transcript;
--- a/src/strobe.rs
+++ b/src/strobe.rs
@@ -15,8 +15,24 @@
 const FLAG_M: u8 = 1 << 4;
 const FLAG_K: u8 = 1 << 5;
 
-fn transmute_state(st: &mut AlignedKeccakState) -> &mut [u64; 25] {
-    unsafe { &mut *(st as *mut AlignedKeccakState as *mut [u64; 25]) }
+const KECCAK_BLOCK_SIZE: usize = 25;
+
+fn keccakf_u8(st: &mut AlignedKeccakState) {
+    #[cfg(target_endian = "big")]
+    {
+        use byteorder::{ByteOrder, LittleEndian};
+        let mut keccak_block = [0u64; KECCAK_BLOCK_SIZE];
+        LittleEndian::read_u64_into(&st.0, &mut keccak_block);
+        keccak::f1600(&mut keccak_block);
+        LittleEndian::write_u64_into(&keccak_block, &mut st.0);
+    }
+    #[cfg(target_endian = "little")]
+    {
+        fn transmute_state(st: &mut AlignedKeccakState) -> &mut [u64; KECCAK_BLOCK_SIZE] {
+            unsafe { &mut *(st as *mut AlignedKeccakState as *mut [u64; KECCAK_BLOCK_SIZE]) }
+        }
+        keccak::f1600(transmute_state(st));
+    }
 }
 
 /// This is a wrapper around 200-byte buffer that's always 8-byte aligned
@@ -51,7 +67,7 @@
             let mut st = AlignedKeccakState([0u8; 200]);
             st[0..6].copy_from_slice(&[1, STROBE_R + 2, 1, 0, 1, 96]);
             st[6..18].copy_from_slice(b"STROBEv1.0.2");
-            keccak::f1600(transmute_state(&mut st));
+            keccakf_u8(&mut st);
 
             st
         };
@@ -94,7 +110,7 @@
         self.state[self.pos as usize] ^= self.pos_begin;
         self.state[(self.pos + 1) as usize] ^= 0x04;
         self.state[(STROBE_R + 1) as usize] ^= 0x80;
-        keccak::f1600(transmute_state(&mut self.state));
+        keccakf_u8(&mut self.state);
         self.pos = 0;
         self.pos_begin = 0;
     }
