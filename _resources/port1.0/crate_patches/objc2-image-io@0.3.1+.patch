objc2-image-io: Mac OS X 10.6 and earlier have ImageIO only inside
ApplicationServices. There is no top-level ImageIO.framework on PowerPC, so
link ApplicationServices there, which re-exports ImageIO.

--- a/src/generated/mod.rs
+++ b/src/generated/mod.rs
@@ -19,3 +19,11 @@
 
-#[link(name = "ImageIO", kind = "framework")]
+// Mac OS X 10.6 and earlier have ImageIO only inside ApplicationServices.
+#[cfg_attr(
+    not(any(target_arch = "powerpc", target_arch = "powerpc64")),
+    link(name = "ImageIO", kind = "framework")
+)]
+#[cfg_attr(
+    any(target_arch = "powerpc", target_arch = "powerpc64"),
+    link(name = "ApplicationServices", kind = "framework")
+)]
 extern "C" {}
