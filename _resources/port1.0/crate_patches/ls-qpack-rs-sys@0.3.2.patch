@@ -64,21 +64,13 @@
     );
     println!("cargo:rustc-link-lib=static=ls-qpack");
 
-    // Generate bindings (use headers from the patched source tree since
-    // cmake installs may not copy all headers we need)
-    let bindings = bindgen::Builder::default()
-        .derive_debug(true)
-        .derive_default(true)
-        .size_t_is_usize(true)
-        .layout_tests(false)
-        .generate_comments(false)
-        .clang_arg(format!("-I{}", dst.join("include").display()))
-        .header(ls_qpack_build.join("lsqpack.h").to_string_lossy())
-        .header(ls_qpack_build.join("lsxpack_header.h").to_string_lossy())
-        .generate()
-        .expect("Unable to generate bindings");
-
-    bindings
-        .write_to_file(out_dir.join("bindings.rs"))
-        .expect("Couldn't write bindings!");
+    // powerpc-ports (mrustc PortGroup): there is no libclang for bindgen on these systems, so the bindings of
+    // lsqpack.h + lsxpack_header.h are pre-generated (src/bindings_pregenerated.rs). They hold types and field order
+    // only, no layout constants: `#[repr(C)]` lays the structs out for the target, as the C compiler does.
+    let manifest_dir = PathBuf::from(env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR not set"));
+    fs::copy(
+        manifest_dir.join("src").join("bindings_pregenerated.rs"),
+        out_dir.join("bindings.rs"),
+    )
+    .expect("Couldn't write bindings!");
 }
