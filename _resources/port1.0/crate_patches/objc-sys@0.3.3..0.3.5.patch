+//! Runtime functions missing from Mac OS X 10.6 and earlier.
+//!
+//! `libobjc` gained the ARC entry points (`objc_retain`,
+//! `objc_autoreleasePoolPush`, the weak reference functions, ...) and
+//! `objc_copyClassList` in Mac OS X 10.7, so the PowerPC runtimes don't have
+//! them. These implement them with `-retain`, `-release`, `-autorelease`,
+//! `NSAutoreleasePool` and `objc_getClassList`.
+//!
+//! The runtime has no zeroing weak references either (except under garbage
+//! collection), so the weak functions here keep a strong reference: an
+//! object stays alive while a weak reference to it exists, and loading the
+//! weak reference never returns `nil`. A reference cycle that a weak
+//! reference was meant to break is leaked, but a weak reference never
+//! dangles.
+use core::ffi::{c_uint, c_void};
+use core::mem;
+use core::ptr;
+use core::sync::atomic::{AtomicPtr, Ordering};
+
+use crate::{objc_class, objc_object, objc_selector};
+
+extern "C" {
+    // libSystem
+    fn _Block_copy(block: *const c_void) -> *mut c_void;
+    fn malloc(size: usize) -> *mut c_void;
+}
+
+/// A selector, registered on first use.
+macro_rules! sel {
+    ($name:literal) => {{
+        static SEL: AtomicPtr<objc_selector> = AtomicPtr::new(ptr::null_mut());
+        let mut sel = SEL.load(Ordering::Relaxed);
+        if sel.is_null() {
+            sel = unsafe { crate::sel_registerName(concat!($name, "\0").as_ptr().cast()) }
+                as *mut objc_selector;
+            SEL.store(sel, Ordering::Relaxed);
+        }
+        sel as *const objc_selector
+    }};
+}
+
+/// Send a message that takes no arguments and returns an object or nothing.
+#[inline]
+unsafe fn send(obj: *mut objc_object, sel: *const objc_selector) -> *mut objc_object {
+    let msg_send: unsafe extern "C" fn() = crate::objc_msgSend;
+    // SAFETY: `objc_msgSend` is called with the signature of the method.
+    let msg_send: unsafe extern "C" fn(*mut objc_object, *const objc_selector) -> *mut objc_object =
+        unsafe { mem::transmute(msg_send) };
+    unsafe { msg_send(obj, sel) }
+}
+
+// Autoreleasepool
+
+/// `[[NSAutoreleasePool alloc] init]`
+pub unsafe extern "C" fn objc_autoreleasePoolPush() -> *mut c_void {
+    static CLS: AtomicPtr<objc_class> = AtomicPtr::new(ptr::null_mut());
+    let mut cls = CLS.load(Ordering::Relaxed);
+    if cls.is_null() {
+        cls = unsafe { crate::objc_getClass(b"NSAutoreleasePool\0".as_ptr().cast()) }
+            as *mut objc_class;
+        CLS.store(cls, Ordering::Relaxed);
+    }
+    unsafe {
+        let pool = send(cls.cast(), sel!("alloc"));
+        send(pool, sel!("init")).cast()
+    }
+}
+
+/// `[pool drain]`, which also drains any pools pushed after `pool`.
+pub unsafe extern "C" fn objc_autoreleasePoolPop(pool: *mut c_void) {
+    unsafe { send(pool.cast(), sel!("drain")) };
+}
+
+// Autorelease
+
+pub unsafe extern "C" fn objc_autorelease(value: *mut objc_object) -> *mut objc_object {
+    if !value.is_null() {
+        unsafe { send(value, sel!("autorelease")) };
+    }
+    value
+}
+
+pub unsafe extern "C" fn objc_autoreleaseReturnValue(value: *mut objc_object) -> *mut objc_object {
+    unsafe { objc_autorelease(value) }
+}
+
+// Weak pointers (strong references, see the module documentation)
+
+pub unsafe extern "C" fn objc_copyWeak(to: *mut *mut objc_object, from: *mut *mut objc_object) {
+    unsafe { *to = objc_retain(*from) };
+}
+
+pub unsafe extern "C" fn objc_destroyWeak(addr: *mut *mut objc_object) {
+    unsafe {
+        objc_release(*addr);
+        *addr = ptr::null_mut();
+    }
+}
+
+pub unsafe extern "C" fn objc_initWeak(
+    addr: *mut *mut objc_object,
+    value: *mut objc_object,
+) -> *mut objc_object {
+    unsafe { *addr = objc_retain(value) };
+    value
+}
+
+pub unsafe extern "C" fn objc_loadWeak(addr: *mut *mut objc_object) -> *mut objc_object {
+    unsafe { objc_autorelease(objc_loadWeakRetained(addr)) }
+}
+
+pub unsafe extern "C" fn objc_loadWeakRetained(addr: *mut *mut objc_object) -> *mut objc_object {
+    unsafe { objc_retain(*addr) }
+}
+
+pub unsafe extern "C" fn objc_moveWeak(to: *mut *mut objc_object, from: *mut *mut objc_object) {
+    unsafe {
+        *to = *from;
+        *from = ptr::null_mut();
+    }
+}
+
+// Retain / release
+
+pub unsafe extern "C" fn objc_release(value: *mut objc_object) {
+    if !value.is_null() {
+        unsafe { send(value, sel!("release")) };
+    }
+}
+
+pub unsafe extern "C" fn objc_retain(value: *mut objc_object) -> *mut objc_object {
+    if !value.is_null() {
+        unsafe { send(value, sel!("retain")) };
+    }
+    value
+}
+
+pub unsafe extern "C" fn objc_retainAutorelease(value: *mut objc_object) -> *mut objc_object {
+    unsafe { objc_autorelease(objc_retain(value)) }
+}
+
+pub unsafe extern "C" fn objc_retainAutoreleaseReturnValue(
+    value: *mut objc_object,
+) -> *mut objc_object {
+    unsafe { objc_retainAutorelease(value) }
+}
+
+pub unsafe extern "C" fn objc_retainAutoreleasedReturnValue(
+    value: *mut objc_object,
+) -> *mut objc_object {
+    unsafe { objc_retain(value) }
+}
+
+/// `_Block_copy`
+pub unsafe extern "C" fn objc_retainBlock(value: *mut objc_object) -> *mut objc_object {
+    unsafe { _Block_copy(value.cast()).cast() }
+}
+
+// Storing values
+
+pub unsafe extern "C" fn objc_storeStrong(addr: *mut *mut objc_object, value: *mut objc_object) {
+    let prev = unsafe { *addr };
+    if prev != value {
+        unsafe {
+            *addr = objc_retain(value);
+            objc_release(prev);
+        }
+    }
+}
+
+pub unsafe extern "C" fn objc_storeWeak(
+    addr: *mut *mut objc_object,
+    value: *mut objc_object,
+) -> *mut objc_object {
+    unsafe { objc_storeStrong(addr, value) };
+    value
+}
+
+// Classes
+
+/// The returned array is deallocated with [`free`][crate::free].
+pub unsafe extern "C" fn objc_copyClassList(out_len: *mut c_uint) -> *mut *const objc_class {
+    let mut len = unsafe { crate::objc_getClassList(ptr::null_mut(), 0) }.max(0);
+    let buf = loop {
+        let buf: *mut *const objc_class =
+            unsafe { malloc((len as usize + 1) * mem::size_of::<*const objc_class>()) }.cast();
+        if buf.is_null() {
+            len = 0;
+            break buf;
+        }
+        // Fills in at most `len` classes, and returns how many are registered
+        // now, which is more if classes were added since the last call.
+        let count = unsafe { crate::objc_getClassList(buf, len) }.max(0);
+        if count <= len {
+            len = count;
+            unsafe { *buf.add(len as usize) = ptr::null() };
+            break buf;
+        }
+        unsafe { crate::free(buf.cast()) };
+        len = count;
+    };
+    if !out_len.is_null() {
+        unsafe { *out_len = len as c_uint };
+    }
+    buf
+}
