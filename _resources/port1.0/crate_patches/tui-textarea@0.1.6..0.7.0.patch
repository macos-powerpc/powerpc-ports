tui-textarea src/widget.rs: 32-bit PowerPC has no 64-bit atomics, so std::sync::atomic::AtomicU64 does not exist there
("Unable to resolve `use` target std::sync::atomic::AtomicU64", gitui; rustc on ppc32 fails the same way). `Viewport`
packs row, column, width and height (four u16) into one AtomicU64 so `render(&self)` can record them. On targets
without 64-bit atomics a private `AtomicU64` stand-in keeps the u64 behind a std Mutex with the four calls the file
makes (new, load, store, get_mut), so the four values are still read and written together; 64-bit targets keep the
real AtomicU64. No-context hunk (anchored on the import line): the line after it differs between releases.
Applies to 0.1.6..0.7.0 (0.1.0-0.1.5 have no AtomicU64).

--- a/src/widget.rs	2026-10-22 05:54:03.389818667 +0000
+++ b/src/widget.rs	2026-10-22 05:54:03.437819921 +0000
@@ -10 +10,28 @@
-use std::sync::atomic::{AtomicU64, Ordering};
+#[cfg(target_has_atomic = "64")]
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+// 32-bit PowerPC has no 64-bit atomics. The four packed u16 of `Viewport` stay one value behind a mutex, with the
+// `AtomicU64` calls this file makes, so they are still read and written together.
+#[cfg(not(target_has_atomic = "64"))]
+#[derive(Default, Debug)]
+struct AtomicU64(std::sync::Mutex<u64>);
+
+#[cfg(not(target_has_atomic = "64"))]
+impl AtomicU64 {
+    fn new(v: u64) -> Self {
+        AtomicU64(std::sync::Mutex::new(v))
+    }
+
+    fn load(&self, _: Ordering) -> u64 {
+        *self.0.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    fn store(&self, v: u64, _: Ordering) {
+        *self.0.lock().unwrap_or_else(|e| e.into_inner()) = v;
+    }
+
+    fn get_mut(&mut self) -> &mut u64 {
+        self.0.get_mut().unwrap_or_else(|e| e.into_inner())
+    }
+}
