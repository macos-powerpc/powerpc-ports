         cg_context.fill_rect(context_rect);
@@ -435,7 +436,7 @@
         // Set fill color to white for drawing the glyph.
         cg_context.set_rgb_fill_color(1.0, 1.0, 1.0, 1.0);
         let rasterization_origin =
