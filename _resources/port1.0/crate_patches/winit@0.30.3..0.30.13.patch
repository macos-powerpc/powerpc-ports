winit: the AppKit static `NSAppearanceNameAqua` is exported since macOS 10.9, so alacritty fails
to link on Mac OS X 10.6 (PowerPC). winit already avoids the 10.14 `NSAppearanceNameDarkAqua`
static with `ns_string!` for the same reason; do the same for Aqua on powerpc (the string value
of the constant is its own name). Other targets keep using the static. (NSAppearance itself does
not exist on 10.6; these helpers are only reached through `effectiveAppearance` KVO notifications
and an explicit theme, which 10.6 never delivers.)

--- a/src/platform_impl/macos/window_delegate.rs
+++ b/src/platform_impl/macos/window_delegate.rs
@@ -1874,2 +1874,13 @@
 
+#[cfg(not(any(target_arch = "powerpc", target_arch = "powerpc64")))]
+fn aqua_appearance_name() -> &'static NSString {
+    unsafe { NSAppearanceNameAqua }
+}
+
+#[cfg(any(target_arch = "powerpc", target_arch = "powerpc64"))]
+fn aqua_appearance_name() -> &'static NSString {
+    // The static `NSAppearanceNameAqua` is 10.9+, so Mac OS X 10.6 can't link it either
+    ns_string!("NSAppearanceNameAqua")
+}
+
 fn dark_appearance_name() -> &'static NSString {
@@ -1881,3 +1892,3 @@
     let best_match = appearance.bestMatchFromAppearancesWithNames(&NSArray::from_id_slice(&[
-        unsafe { NSAppearanceNameAqua.copy() },
+        aqua_appearance_name().copy(),
         dark_appearance_name().copy(),
@@ -1899,3 +1910,3 @@
     let appearance = match theme? {
-        Theme::Light => unsafe { NSAppearance::appearanceNamed(NSAppearanceNameAqua) },
+        Theme::Light => NSAppearance::appearanceNamed(aqua_appearance_name()),
         Theme::Dark => NSAppearance::appearanceNamed(dark_appearance_name()),
