rustls-native-certs 0.6.0 on powerpc / powerpc64 Darwin (Mac OS X 10.4-10.6): load the CA bundle from a PEM file,
as OpenSSL does, instead of the keychain through security-framework (which needs Security.framework entry points newer
than 10.6, and whose 10.6 roots are long out of date). Drops the security-framework dependency there. 0.6.0 has no
`load_pem_certs` helper and reads no environment variables, so src/macports.rs carries its own loader.

Path: MACPORTS_CA_BUNDLE at build time, else /opt/local/share/curl/curl-ca-bundle.crt (port curl-ca-bundle).

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -44 +44 @@
-[target."cfg(target_os = \"macos\")".dependencies.security-framework]
+[target."cfg(all(target_os = \"macos\", not(any(target_arch = \"powerpc\", target_arch = \"powerpc64\"))))".dependencies.security-framework]
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -22,7 +22,12 @@
 
-#[cfg(target_os = "macos")]
+#[cfg(all(target_os = "macos", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))]
 mod macos;
-#[cfg(target_os = "macos")]
+#[cfg(all(target_os = "macos", not(any(target_arch = "powerpc", target_arch = "powerpc64"))))]
 use macos as platform;
 
+#[cfg(all(target_os = "macos", any(target_arch = "powerpc", target_arch = "powerpc64")))]
+mod macports;
+#[cfg(all(target_os = "macos", any(target_arch = "powerpc", target_arch = "powerpc64")))]
+use macports as platform;
+
 use std::io::Error;
--- a/src/macports.rs
+++ b/src/macports.rs
@@ -0,0 +1,20 @@
+//! Mac OS X on PowerPC (10.4-10.6): read a PEM bundle, as OpenSSL does, instead of the keychain.
+//!
+//! The keychain path (`macos.rs`, security-framework) needs newer Security.framework entry points, and the 10.6
+//! system roots are long out of date. The bundle is MacPorts' curl-ca-bundle; `MACPORTS_CA_BUNDLE` at build time
+//! overrides the path, and this version reads no environment variables.
+
+use crate::Certificate;
+
+use std::fs::File;
+use std::io::{BufReader, Error, ErrorKind};
+
+pub fn load_native_certs() -> Result<Vec<Certificate>, Error> {
+    let file = option_env!("MACPORTS_CA_BUNDLE").unwrap_or("/opt/local/share/curl/curl-ca-bundle.crt");
+    let f = File::open(file)
+        .map_err(|err| Error::new(err.kind(), format!("could not load certs from file {}: {}", file, err)))?;
+    match rustls_pemfile::certs(&mut BufReader::new(f)) {
+        Ok(contents) => Ok(contents.into_iter().map(Certificate).collect()),
+        Err(_) => Err(Error::new(ErrorKind::InvalidData, format!("Could not load PEM file {:?}", file))),
+    }
+}
