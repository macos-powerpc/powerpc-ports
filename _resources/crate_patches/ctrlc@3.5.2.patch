ctrlc only uses dispatch2 for a semaphore (DispatchSemaphore/DispatchTime/DispatchRetained),
none of which needs blocks or the Objective-C runtime. Build dispatch2 without its default
block2 and objc2 features: libdispatch is still used on 10.6, but block2/objc2 (which have no
PowerPC support: objc2 fails with "Failed to find impl with MSG_SEND_SUPER") are not built.

--- a/Cargo.toml	2026-10-04 04:29:19.784730310 +0000
+++ b/Cargo.toml	2026-10-04 04:29:19.823731293 +0000
@@ -71,6 +71,8 @@
 
 [target.'cfg(target_vendor = "apple")'.dependencies.dispatch2]
 version = "0.3"
+default-features = false
+features = ["std"]
 
 [target."cfg(unix)".dependencies.nix]
 version = "0.31"
