--- a/src/ap.h
+++ b/src/ap.h
@@ -336,9 +336,24 @@
 namespace alglib_impl
 {
 
+/*
+ * ALGLIB requires sizeof(ae_bool)==1 (enforced by a compile-time check in
+ * ap.cpp, and assumed by ae_sizeof() for DT_BOOL/DT_BYTE arrays).  Darwin on
+ * PowerPC defaults to a 4-byte C++ bool, which breaks that requirement.
+ * Rather than forcing -mone-byte-bool onto the library and onto every
+ * consumer that includes these headers, decouple ae_bool from C++ bool and
+ * let it be a plain 1-byte type, exactly as the pure-C edition of ALGLIB
+ * already does.  Struct layouts are unchanged either way.
+ */
+#if defined(__APPLE__) && (defined(__ppc__) || defined(__ppc64__)) && !defined(AE_NO_CPP_BOOL)
+#define AE_NO_CPP_BOOL
+#endif
+
 /* if we work under C++ environment, define several conditions */
 #ifdef AE_USE_CPP
+#if !defined(AE_NO_CPP_BOOL)
 #define AE_USE_CPP_BOOL
+#endif
 #define AE_USE_CPP_SERIALIZATION
 #include <iostream>
 #endif
