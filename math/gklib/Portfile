# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

github.setup        KarypisLab GKlib 0.0.1 v
name                [string tolower ${github.project}]
revision            0
epoch               1
categories          math
maintainers         nomaintainer
license             Apache-2

description         KarypisLab library of various helper routines and frameworks
long_description    {*}${description} used by the lab's software.

checksums           rmd160  03336c8290a28599341e17b47538fee180ffd9cd \
                    sha256  9ab4e0b4c3e06fde1de5b83991b9bcd9a3f424e8fe435e46020045fdc8a8e2b9 \
                    size    201824
github.tarball_from archive

compiler.thread_local_storage   yes

configure.args-append \
                    -DBUILD_SHARED_LIBS=ON

if {${configure.build_arch} ni [list i386 x86_64]} {
    configure.args-append \
                    -DNO_X86=ON
}

variant openmp description "Enable OpenMP support" {
    compiler.openmp_version 4.0
    configure.args-append \
                    -DOPENMP=ON
}
