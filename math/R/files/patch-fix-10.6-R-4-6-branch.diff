+#else
+/* 10.5 counterpart of applyFontVar(): CTFontManager is not available, so the
+   font is loaded as a CGFont and the variations are applied to that with
+   CGFontCreateCopyWithVariations(). The axis dictionaries returned by
+   CGFontCopyVariationAxes() carry the same (localized) axis names that
+   axisNameMatch() expects. Consumes cgFont and returns the font to use. */
+static CGFontRef legacy_applyFontVar(CGFontRef cgFont, SEXP font, int numVar)
+{
+    int i, j;
+    CFArrayRef cgFontVariationAxes = CGFontCopyVariationAxes(cgFont);
+    if (!cgFontVariationAxes)
+        return cgFont;
+    CFMutableDictionaryRef variations =
+        CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                  &kCFTypeDictionaryValueCallBacks);
+    CFIndex numAxes = CFArrayGetCount(cgFontVariationAxes);
+    for (i = 0; i < numVar; i++) {
+        const char* axisName = R_GE_glyphFontVarAxis(font, i);
+        for (j = 0; j < numAxes; j++) {
+            CFDictionaryRef axisDict =
+                CFArrayGetValueAtIndex(cgFontVariationAxes, j);
+            CFStringRef axisDictName =
+                CFDictionaryGetValue(axisDict, kCGFontVariationAxisName);
+            if (axisDictName && axisNameMatch(axisName, axisDictName)) {
+                double axisValue = R_GE_glyphFontVarValue(font, i);
+                CFNumberRef axisNumber =
+                    CFNumberCreate(NULL, kCFNumberDoubleType, &axisValue);
+                CFDictionarySetValue(variations, axisDictName, axisNumber);
+                CFRelease(axisNumber);
+            }
+        }
+    }
+    CGFontRef varFont = CGFontCreateCopyWithVariations(cgFont, variations);
+    CFRelease(variations);
+    CFRelease(cgFontVariationAxes);
+    if (!varFont)
+        return cgFont;
+    CGFontRelease(cgFont);
+    return varFont;
+}
+#endif
 
