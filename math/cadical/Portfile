    copy ${worksrcpath}/build/cadical ${destroot}${prefix}/bin/
    copy ${worksrcpath}/build/mobical ${destroot}${prefix}/bin/
    copy ${worksrcpath}/build/libcadical.a ${destroot}${prefix}/lib/
