# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               boost 1.0
PortGroup               github 1.0

# Update together w/ stan.
github.setup            stan-dev math 5.3.0 v
name                    stanmath
revision                0
categories              math
maintainers             {@barracuda156 macos-powerpc.org:barracuda}
license                 BSD
description             C++ template library for automatic differentiation
long_description        The Stan Math Library is a C++, reverse-mode automatic differentiation library designed to be usable, \
                        extensive and extensible, efficient, scalable, stable, portable and redistributable in order to facilitate \
                        the construction and utilization of algorithms that utilize derivatives.
homepage                https://mc-stan.org/math
checksums               rmd160  fcf2f7f1b6cf5cd376e07e2751664f19abe52bca \
                        sha256  6ad05c37e7df8add7d0089489249ddaadb57e30cead8cdd1323f4e1283c4fe64 \
                        size    28936192
github.tarball_from     archive
supported_archs         noarch
platforms               any

# Upstream bundles Boost 1.87.0 with this release. Whatever is chosen here has
# to match port:cmdstan, since both end up in one translation unit when a Stan
# program is compiled.
boost.version           1.87
boost.depends_type      run

# compiler define -DTBB_INTERFACE_NEW chooses oneTBB over TBB.
depends_run-append      path:share/pkgconfig/eigen3.pc:eigen3 \
                        port:onetbb \
                        port:sundials6

use_configure           no
build                   {}

destroot {
    copy ${worksrcpath}/stan ${destroot}${prefix}/include

    # Stan Math's make fragments are part of its build interface: cmdstan's
    # makefile includes make/compiler_flags, make/dependencies and
    # make/libraries from $(MATH), and make/standalone is what upstream points
    # standalone users at. Consumers set MATH to ${prefix}/share/${name}/ and
    # find the headers through their own include path.
    xinstall -d ${destroot}${prefix}/share/${name}/make
    foreach f {compiler_flags dependencies libraries standalone} {
        xinstall -m 0644 ${worksrcpath}/make/${f} \
            ${destroot}${prefix}/share/${name}/make
    }
}
