# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               boost 1.0
PortGroup               github 1.0

github.setup            stan-dev cmdstan 2.39.0 v
revision                0
categories              math
maintainers             {@barracuda156 macos-powerpc.org:barracuda}
license                 BSD
description             Command-line interface to Stan
long_description        CmdStan is the command-line interface to Stan, a package providing full \
                        Bayesian inference with MCMC sampling (NUTS, HMC), approximate Bayesian \
                        inference with variational inference (ADVI), and penalized maximum \
                        likelihood estimation with optimization (L-BFGS).
homepage                https://mc-stan.org/users/interfaces/cmdstan.html
checksums               rmd160  00752fbfc20f220f9ef62c20f704523f997e3cd9 \
                        sha256  0176a1fd2883e28a075f07b1d9846690b04764850a764a23b6cc23f27c23c868 \
                        size    1642506

# The archive tarball is the repository without its submodules, which is exactly
# what we want here: stan and stan_math come from port:stan and port:stanmath
# instead of the bundled copies carried by the release tarball.
github.tarball_from     archive

# Must be the Boost that port:stanmath was built and tested against, since both
# end up in one translation unit when a model is compiled. Upstream bundles
# 1.87.0 with Stan Math 5.3.0.
boost.version           1.87

set sundials_branch     6

# CmdStan, Stan, Stan Math and stanc3 are released in lockstep, and the C++ that
# stanc emits only compiles against its exact counterparts. cmdstan 2.39.0 needs
# stan 2.39.0, stanmath 5.3.0 and stanc3 2.39.0. Move all four together, and
# revbump this port whenever any of them changes: the objects prebuilt here are
# linked into every model a user compiles afterwards.
depends_lib-append      path:share/pkgconfig/eigen3.pc:eigen3 \
                        port:onetbb \
                        path:lib/pkgconfig/RapidJSON.pc:rapidjson \
                        port:sundials${sundials_branch} \
                        port:stan \
                        port:stanc3 \
                        port:stanmath

compiler.cxx_standard   2017

# Under STAN_THREADS, Stan Math makes the autodiff stack pointer thread-local,
# using the __thread GNU extension in preference to C++11 thread_local
# (autodiffstackstorage.hpp). Since the port prebuilds the threaded main object,
# that is a build requirement.
compiler.thread_local_storage yes

# lgamma.hpp:66:12: error: '::lgamma_r' has not been declared; did you mean 'lgamma'?
configure.cxxflags-append \
                        -D_BOOST_LGAMMA=1

use_configure           no

# CmdStan is a build tree rather than a set of binaries: users compile Stan
# programs by running make inside it, so the whole thing is installed and stays.
set cmdstandir          ${prefix}/libexec/${name}

# Where port:stanmath keeps Stan Math's make fragments, which cmdstan includes.
set mathdir             ${prefix}/share/stanmath

# port:onetbb and port:sundials6 install into their own libexec subprefixes
# rather than ${prefix} itself, and neither exposes its headers anywhere under
# the shared prefix (unlike a CMake consumer, cmdstan's own make-based build has
# no find_package() to discover them), so the include directories are named
# explicitly here.
set tbbincludedir       ${prefix}/libexec/onetbb/include
set sundialsincludedir  ${prefix}/libexec/sundials${sundials_branch}/include

# CmdStanR reads the makefile's own flags back out with `make print-CXXFLAGS`
# and then rewrites every -I it finds as relative to the CmdStan directory
# (get_cmdstan_flags() in its utils.R), because a stock CmdStan has no absolute
# include paths at all. An absolute -I comes back as <cmdstan>//opt/local/...
# and $expose_functions() and the model methods fail to compile. These symlinks
# let every include path in make/local stay relative to the tree, the way
# upstream's do.
proc cmdstan_treelinks {} {
    global prefix mathdir tbbincludedir sundialsincludedir
    return [list \
        include  ${prefix}/include \
        stanmath ${mathdir} \
        boost    [boost::include_dir] \
        tbb      ${tbbincludedir} \
        sundials ${sundialsincludedir}]
}

build.target            build

pre-build {
    if {![file exists ${mathdir}/make/compiler_flags]} {
        ui_error "port:stanmath does not provide ${mathdir}/make/compiler_flags."
        ui_error "cmdstan includes Stan Math's make fragments; update port:stanmath."
        return -code error "missing stan_math make fragments"
    }

    # A stanc from another release emits C++ that will not compile against these
    # headers, and the resulting errors are impossible to read.
    if {[catch {exec ${prefix}/bin/stanc --version} stancver]} {
        return -code error "cannot run ${prefix}/bin/stanc: ${stancver}"
    }
    if {![string match "*${version}*" ${stancver}]} {
        ui_error "port:stanc3 reports \"${stancver}\", which is not ${version}."
        ui_error "cmdstan ${version} requires stanc3 ${version}."
        return -code error "stanc3 version mismatch"
    }

    # bin/stanc has no prerequisites in make/stanc, so an existing file is what
    # stops cmdstan from downloading a stanc binary from GitHub.
    xinstall -d ${worksrcpath}/bin
    delete ${worksrcpath}/bin/stanc
    ln -s ${prefix}/bin/stanc ${worksrcpath}/bin/stanc

    foreach {link target} [cmdstan_treelinks] {
        delete ${worksrcpath}/${link}
        ln -s ${target} ${worksrcpath}/${link}
    }

    # Record the toolchain so that models are compiled the way the port was.
    # Users run make outside MacPorts' build environment, so everything MacPorts
    # would normally pass through the environment has to be written down here.
    set cmdstan_cxxflags "${configure.cxxflags} [get_canonical_archflags cxx]"
    set cmdstan_ldflags  "${configure.ldflags} [get_canonical_archflags ld]"
    if {${configure.sdkroot} ne ""} {
        append cmdstan_cxxflags " -isysroot ${configure.sdkroot}"
        append cmdstan_ldflags  " -isysroot ${configure.sdkroot}"
    }
    if {${os.platform} eq "darwin" && ${macosx_deployment_target} ne ""} {
        append cmdstan_cxxflags " -mmacosx-version-min=${macosx_deployment_target}"
        append cmdstan_ldflags  " -mmacosx-version-min=${macosx_deployment_target}"
    }
    if {[string match *gcc* ${configure.compiler}] && ${configure.build_arch} in [list arm i386 ppc]} {
        append cmdstan_ldflags " -latomic"
    }

    # SUNDIALS 6 and 7 spread their object code over a different set of
    # libraries, and variants can change which ones exist, so ask the filesystem
    # rather than hardcoding a list.
    set sundials_libdir ${prefix}/libexec/sundials${sundials_branch}/lib
    set sundials_libs {}
    foreach l {cvodes idas kinsol nvecserial sunmatrixdense sunlinsoldense \
               sunnonlinsolnewton sunnonlinsolfixedpoint generic core} {
        if {[glob -nocomplain ${sundials_libdir}/libsundials_${l}.*] ne ""} {
            lappend sundials_libs -lsundials_${l}
        }
    }
    if {${sundials_libs} eq ""} {
        return -code error "no SUNDIALS libraries found in ${sundials_libdir}"
    }

    set fd [open ${worksrcpath}/make/local w]
    puts ${fd} "##
# CmdStan build configuration written by MacPorts.
#
# This file belongs to port:${name} and is replaced whenever the port is
# reinstalled or upgraded. Keep your own settings in a file of your own and pull
# them in with an -include line at the end.
##

# Toolchain, recorded so that models are built exactly as the port was.
CXX = ${configure.cxx}
CC = ${configure.cc}
CXXFLAGS = ${cmdstan_cxxflags}
LDFLAGS = ${cmdstan_ldflags}
O = 3

# Every include path below is relative to this directory, resolved through
# the symlinks the port creates here:
#
#     include  -> ${prefix}/include
#     stanmath -> ${mathdir}
#     boost    -> [boost::include_dir]
#     tbb      -> ${tbbincludedir}
#     sundials -> ${sundialsincludedir}
#
# Relative is not a style choice: CmdStanR rewrites every -I it reads out of
# this makefile as relative to the CmdStan directory, so an absolute one breaks
# its \$expose_functions() and model-method compilation. make is always run with
# this directory as its working directory, by CmdStanR and by stanmodel alike.
#
# Stan and Stan Math headers merge into one include/stan tree. MATH only has to
# name the directory holding stan_math's make fragments, which cmdstan's
# makefile includes; the headers are found through INC_FIRST. STAN is left at
# its default, since nothing reachable in this configuration uses it.
MATH = stanmath/
RAPIDJSON = include/
CLI11 = lib/CLI11-1.9.1/
INC_FIRST = -I src -I include -I lib/CLI11-1.9.1

# Eigen (port:eigen3) and Boost (port:boost[boost::version_nodot]).
EIGEN = include/eigen3
BOOST = boost

# SUNDIALS (port:sundials6). Defining SUNDIALS_TARGETS at all, even to nothing,
# is what switches off stan_math's build of its own bundled copy. sundials6
# installs into its own libexec subprefix rather than ${prefix}, so both the
# include path (relative, via the sundials/ symlink) and the link path (kept
# absolute, per the TBB comment below) have to name that subprefix explicitly.
SUNDIALS_TARGETS =
INC_SUNDIALS = -I sundials
LDFLAGS_SUNDIALS = -L${sundials_libdir} -Wl,-rpath,${sundials_libdir}
LDLIBS_SUNDIALS = [join ${sundials_libs} " "]

# oneTBB (port:onetbb). TBB_LIB likewise switches off the bundled TBB build, and
# TBB_INTERFACE_NEW selects the oneTBB API over the old task scheduler. onetbb
# also installs into its own libexec subprefix. The link paths stay absolute;
# CmdStanR only rewrites include paths.
TBB_LIB = ${prefix}/libexec/onetbb/lib
TBB_INC = tbb
TBB_INTERFACE_NEW = true

# No precompiled model header. It would have to be written into a prefix that is
# read-only for the people compiling models, and it is only ever valid for
# the exact compiler that produced it.
PRECOMPILED_HEADERS = false"
    close ${fd}
}

post-build {
    # STAN_THREADS changes the name of the main object file, so building that
    # one too lets users turn threading on without write access to the tree.
    #
    # main_threads.d has to be named explicitly: `make build` never generates
    # it, because make/program only pulls it in when a model is being built, and
    # by then the tree is read-only. Missing, it is not fatal -- make carries on
    # past an -include whose recipe fails -- but the compiler first prints
    # a failure to write it, in the middle of the user's model compile.
    system -W ${worksrcpath} \
        "${build.cmd} ${build.jobs_arg} build src/cmdstan/main_threads.d STAN_THREADS=true"
}

test.run                yes
test {
    system -W ${worksrcpath} "${build.cmd} examples/bernoulli/bernoulli"
    system -W ${worksrcpath} "examples/bernoulli/bernoulli sample \
        data file=examples/bernoulli/bernoulli.data.json \
        output file=${workpath}/bernoulli-test.csv"
    system -W ${worksrcpath} "bin/stansummary ${workpath}/bernoulli-test.csv"
}

destroot {
    xinstall -d ${destroot}${cmdstandir}
    foreach f {LICENSE README.md RELEASE-NOTES.txt makefile examples lib make} {
        copy ${worksrcpath}/${f} ${destroot}${cmdstandir}
    }

    # Only src/cmdstan, so that src/test and its several hundred test models are
    # left behind along with runCmdStanTests.py, test-all.sh and the Jenkinsfile.
    xinstall -d ${destroot}${cmdstandir}/src
    copy ${worksrcpath}/src/cmdstan ${destroot}${cmdstandir}/src

    # bin/stanc is a symlink and copy would follow it, so the binaries are
    # listed one by one and the symlink is recreated below.
    xinstall -d ${destroot}${cmdstandir}/bin
    foreach f {cmdstan stansummary print diagnose} {
        copy ${worksrcpath}/bin/${f} ${destroot}${cmdstandir}/bin
    }

    # Anything `port test` may have left behind in the example directory.
    foreach f {bernoulli bernoulli.o bernoulli.d bernoulli.hpp} {
        delete ${destroot}${cmdstandir}/examples/bernoulli/${f}
    }
    foreach f [glob -nocomplain ${destroot}${cmdstandir}/examples/bernoulli/*.csv] {
        delete ${f}
    }

    # make must not decide that any of the prebuilt objects is out of date:
    # the tree is read-only for the people who will compile models in it.
    foreach f [concat [glob -nocomplain ${destroot}${cmdstandir}/src/cmdstan/*.o] \
                      [glob -nocomplain ${destroot}${cmdstandir}/src/cmdstan/*.d] \
                      [glob -nocomplain ${destroot}${cmdstandir}/bin/cmdstan/*.o] \
                      [glob -nocomplain ${destroot}${cmdstandir}/bin/*]] {
        touch ${f}
    }

    ln -s ${prefix}/bin/stanc ${destroot}${cmdstandir}/bin/stanc
    foreach {link target} [cmdstan_treelinks] {
        ln -s ${target} ${destroot}${cmdstandir}/${link}
    }

    xinstall -d ${destroot}${prefix}/bin
    ln -s ${cmdstandir}/bin/stansummary ${destroot}${prefix}/bin/stansummary

    set fd [open ${destroot}${prefix}/bin/stanmodel w]
    puts ${fd} {#!/bin/sh
# stanmodel - compile a Stan program with the MacPorts CmdStan installation.
#
# usage: stanmodel <model.stan> [make arguments ...]

set -e

if [ $# -lt 1 ]; then
    echo "usage: stanmodel <model.stan> [make arguments ...]" >&2
    exit 2
fi

model=$1
shift

case "$model" in
    *.stan) model=`expr "$model" : '\(.*\)\.stan$'` ;;
esac

dir=`dirname "$model"`
base=`basename "$model"`
dir=`cd "$dir" && pwd`
}
    puts ${fd} "exec ${build.cmd} -C \"${cmdstandir}\" \"\$dir/\$base\" \"\$@\""
    close ${fd}
    file attributes ${destroot}${prefix}/bin/stanmodel -permissions 0755

    set docdir ${prefix}/share/doc/${name}
    xinstall -d ${destroot}${docdir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE README.md RELEASE-NOTES.txt \
        ${destroot}${docdir}
}

notes "
CmdStan is installed as a build tree in

    ${cmdstandir}

Compile a Stan program with

    stanmodel /path/to/model.stan

which leaves the executable next to the .stan file, or drive the tree yourself:

    make -C ${cmdstandir} /path/to/model

Threading is built but off by default, as it is upstream. Turn it on per model:

    stanmodel /path/to/model.stan STAN_THREADS=true

or through CmdStanR's cpp_options. At run time the thread count comes from\
the STAN_NUM_THREADS environment variable: unset means one thread, -1 means one\
per core. Threading is what reduce_sum and map_rect need.

CmdStanPy and CmdStanR locate it through the CMDSTAN environment variable:

    export CMDSTAN=${cmdstandir}

CmdStanR's install_cmdstan(), rebuild_cmdstan() and cmdstan_make_local() write\
into the CmdStan directory and will fail here, as they should: this tree belongs\
to ports. Everything else, compiling and running models included, works\
against it read-only.

Build settings live in ${cmdstandir}/make/local. That file belongs to the port\
and is replaced on every upgrade, so keep your own settings in a file of your\
own and pull them in with an -include line at the end of it.

Models are compiled with the compiler used for this port, recorded in\
make/local. Upgrading stan, stanmath, stanc3, boost, eigen3, sundials6 or onetbb\
can leave the objects prebuilt in the tree stale; rebuild cmdstan if model\
builds start failing.
"

if {${os.platform} eq "darwin" && ${configure.cxx_stdlib} ne "libc++"} {
    notes-append "
        Running models compiled by CmdStan requires setting:

        DYLD_LIBRARY_PATH=${prefix}/lib/libgcc
    "
}
