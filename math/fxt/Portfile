extract.rename      yes

master_sites.mirror_subdir

patchfiles          patch-fix-makefile.diff

# Does not build with clangs at the moment:
# error: constexpr variable 's2' must be initialized by a constant expression
# See also: https://github.com/llvm/llvm-project/issues/60548
compiler.blacklist-append \
                    {clang} macports-clang-*

compiler.cxx_standard   2017

build.args-append   CC="${configure.cc} [get_canonical_archflags cc]" \
                    CXX="${configure.cxx} [get_canonical_archflags cxx]"

post-destroot {
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0755 {*}[glob ${worksrcpath}/doc/*.txt] ${destroot}${prefix}/share/doc/${name}
    copy ${worksrcpath}/demo ${destroot}${prefix}/share/doc/${name}
    copy ${worksrcpath}/src ${destroot}${prefix}/share/doc/${name}
}

livecheck.type      regex
livecheck.regex     ${name}-(\[0-9.\]+)${extract.suffix}
