--- R_Prefix.pch.orig
+++ R_Prefix.pch
@@ -5,3 +5,14 @@
 #ifdef __OBJC__
     #import <Cocoa/Cocoa.h>
 #endif
+
+/* Rconfig.h of R >= 4.6 defines HAVE_ENUM_BASE_TYPE when the compiler that
+   built R accepted the C23 "enum : int" syntax, and R_ext/Boolean.h then
+   declares Rboolean with that syntax unconditionally.  Pre-include Rconfig.h
+   (its include guard turns the later include from Boolean.h into a no-op)
+   and drop the macro unless this compiler is itself in C23 mode; the plain
+   enum has the same size, so the ABI is unchanged. */
+#include <Rconfig.h>
+#if !(defined(__STDC_VERSION__) && __STDC_VERSION__ > 202000L)
+# undef HAVE_ENUM_BASE_TYPE
+#endif
