From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 23 Oct 2026 00:00:00 +0800
Subject: [PATCH] ne_meminfo_darwin: fix for 32-bit darwin and pre-10.9 SDKs

- Use host_statistics()/vm_statistics on i386, ppc and deployment
  targets below 10.6, where host_statistics64() does not exist.
- Only read compressor_page_count/internal_page_count with a 10.9+ SDK;
  10.6-10.8 vm_statistics64 lacks them (broke 10.6 x86_64 and ppc64).
- Request HOST_VM_INFO64 from host_statistics64(): with HOST_VM_INFO the
  kernel falls back to host_statistics() and writes the 32-bit layout
  into the 64-bit struct.
- purgeable_count exists in both structs since 10.4; keep it unguarded.

---
 plugins/in_node_exporter_metrics/ne_meminfo_darwin.c | 33 +++++++++++++++++++++++++++++++--
 1 file changed, 31 insertions(+), 2 deletions(-)

--- plugins/in_node_exporter_metrics/ne_meminfo_darwin.c
+++ plugins/in_node_exporter_metrics/ne_meminfo_darwin.c
@@ -25,6 +25,7 @@
 #include "ne.h"
 #include "ne_utils.h"
 
+#include <string.h>
 #include <sys/types.h>
 #include <sys/sysctl.h>
 
@@ -32,6 +33,18 @@
 #include <mach/mach_init.h>
 #include <mach/mach_host.h>
 
+#include <AvailabilityMacros.h>
+
+/*
+ * host_statistics64() and vm_statistics64 first appeared in 10.6, so use the
+ * 32-bit interface for older targets and for 32-bit i386/ppc.
+ * The compressor and internal page counters only exist from 10.9 on.
+ */
+#if defined(__i386__) || defined(__ppc__) || \
+    MAC_OS_X_VERSION_MIN_REQUIRED < 1060
+#define NE_DARWIN_VM_STATS32
+#endif
+
 static int meminfo_configure(struct flb_ne *ctx)
 {
     struct cmt_counter *c;
@@ -140,7 +153,11 @@
 {
     mach_port_t host_port;
     mach_msg_type_number_t host_size;
+#ifdef NE_DARWIN_VM_STATS32
+    vm_statistics_data_t vm_stat;
+#else
     vm_statistics64_data_t vm_stat;
+#endif
     kern_return_t err;
     vm_size_t page_size;
     struct xsw_usage swap;
@@ -150,9 +167,19 @@
     size_t len;
 
     host_port = mach_host_self();
-    host_size = sizeof(vm_statistics_data_t) / sizeof(integer_t);
+    memset(&vm_stat, 0, sizeof(vm_stat));
 
-    err = host_statistics64(host_port, HOST_VM_INFO, (host_info_t)&vm_stat, &host_size);
+#ifdef NE_DARWIN_VM_STATS32
+    host_size = HOST_VM_INFO_COUNT;
+    err = host_statistics(host_port, HOST_VM_INFO, (host_info_t)&vm_stat, &host_size);
+#else
+    /*
+     * host_statistics64() passes flavors it does not handle, including
+     * HOST_VM_INFO, on to host_statistics(), which fills in the 32-bit layout.
+     */
+    host_size = HOST_VM_INFO64_COUNT;
+    err = host_statistics64(host_port, HOST_VM_INFO64, (host_info64_t)&vm_stat, &host_size);
+#endif
 
     if (err != KERN_SUCCESS) {
         flb_plg_error(ctx->ins, "host_statistics() is failed with error = %d", err);
@@ -177,8 +204,10 @@
     cmt_gauge_set(ctx->darwin_free_bytes, ts,
                   ps * vm_stat.free_count, 0, NULL);
 
+#if !defined(NE_DARWIN_VM_STATS32) && MAC_OS_X_VERSION_MAX_ALLOWED >= 1090
     cmt_gauge_set(ctx->darwin_compressed_bytes, ts,
                   ps * vm_stat.compressor_page_count, 0, NULL);
+#endif
 
     cmt_gauge_set(ctx->darwin_active_bytes, ts,
                   ps * vm_stat.active_count, 0, NULL);
@@ -186,8 +215,10 @@
     cmt_gauge_set(ctx->darwin_inactive_bytes, ts,
                   ps * vm_stat.inactive_count, 0, NULL);
 
+#if !defined(NE_DARWIN_VM_STATS32) && MAC_OS_X_VERSION_MAX_ALLOWED >= 1090
     cmt_gauge_set(ctx->darwin_internal_bytes, ts,
                   ps * vm_stat.internal_page_count, 0, NULL);
+#endif
 
     cmt_gauge_set(ctx->darwin_wired_bytes, ts,
                   ps * vm_stat.wire_count, 0, NULL);
