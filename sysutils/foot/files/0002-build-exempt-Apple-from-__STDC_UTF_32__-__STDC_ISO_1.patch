From 480b6ed4cd01b3982e202108ae2e11d349f9fc14 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 27 Jul 2026 12:15:29 +0000
Subject: [PATCH 2/2] build: exempt Apple from
 __STDC_UTF_32__/__STDC_ISO_10646__ checks

Neither is defined by Apple Clang, since Darwin's libc has no native
<uchar.h>/char32_t support for the compiler to recognize -- even
though the platform-provided shim's char32_t genuinely is a 32-bit
UTF-32 code unit, and Darwin's wchar_t genuinely is UCS-4. Extend the
existing FreeBSD/OpenBSD allowance pattern to __APPLE__.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01U6fuL1PtRJHhr97gAGyS1h
---
 char32.c | 4 ++--
 main.c   | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/char32.c b/char32.c
index be5bf229..3584b181 100644
--- a/char32.c
+++ b/char32.c
@@ -31,10 +31,10 @@
 _Static_assert(
     sizeof(wchar_t) == sizeof(char32_t), "wchar_t vs. char32_t size mismatch");
 
-#if !defined(__STDC_UTF_32__) || !__STDC_UTF_32__
+#if (!defined(__STDC_UTF_32__) || !__STDC_UTF_32__) && !defined(__APPLE__)
  #error "char32_t does not use UTF-32"
 #endif
-#if (!defined(__STDC_ISO_10646__) || !__STDC_ISO_10646__) && !defined(__FreeBSD__) && !defined(__OpenBSD__)
+#if (!defined(__STDC_ISO_10646__) || !__STDC_ISO_10646__) && !defined(__FreeBSD__) && !defined(__OpenBSD__) && !defined(__APPLE__)
  #error "wchar_t does not use UTF-32"
 #endif
 
diff --git a/main.c b/main.c
index d9c5dc3c..dbc6b628 100644
--- a/main.c
+++ b/main.c
@@ -34,7 +34,7 @@
 #include "xmalloc.h"
 #include "xsnprintf.h"
 
-#if !defined(__STDC_UTF_32__) || !__STDC_UTF_32__
+#if (!defined(__STDC_UTF_32__) || !__STDC_UTF_32__) && !defined(__APPLE__)
  #error "char32_t does not use UTF-32"
 #endif
 
