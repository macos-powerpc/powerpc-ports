From 54da9ec572c90caa7f418cccd8ad0c3afebc6cb3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 27 Jul 2026 15:08:09 +0000
Subject: [PATCH 7/7] main: use NSIG instead of SIGRTMAX in sanitize_signals()

Same fix as fdm.c's previous commit -- missed this occurrence in the
initial sweep. SIGRTMAX is undeclared on Darwin; NSIG is the correct
signal-count upper bound on every platform.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01U6fuL1PtRJHhr97gAGyS1h
---
 main.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/main.c b/main.c
index 02c281ce..879774bf 100644
--- a/main.c
+++ b/main.c
@@ -180,7 +180,7 @@ sanitize_signals(void)
     struct sigaction dfl = {.sa_handler = SIG_DFL};
     sigemptyset(&dfl.sa_mask);
 
-    for (int i = 1; i < SIGRTMAX; i++)
+    for (int i = 1; i < NSIG; i++)
         sigaction(i, &dfl, NULL);
 }
 
