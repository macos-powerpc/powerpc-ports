 pid_t
diff --git a/terminal.c b/terminal.c
index 4d0d1e77..5d50a592 100644
--- a/terminal.c
+++ b/terminal.c
@@ -710,8 +710,8 @@ initialize_render_workers(struct terminal *term)
 {
     LOG_INFO("using %hu rendering threads", term->render.workers.count);
 
-    if (sem_init(&term->render.workers.start, 0, 0) < 0 ||
-        sem_init(&term->render.workers.done, 0, 0) < 0)
+    if (render_sem_init(&term->render.workers.start) < 0 ||
+        render_sem_init(&term->render.workers.done) < 0)
     {
         LOG_ERRNO("failed to instantiate render worker semaphores");
         return false;
@@ -751,8 +751,8 @@ initialize_render_workers(struct terminal *term)
     return true;
 
 err_sem_destroy:
-    sem_destroy(&term->render.workers.start);
-    sem_destroy(&term->render.workers.done);
+    render_sem_destroy(&term->render.workers.start);
+    render_sem_destroy(&term->render.workers.done);
     return false;
 }
 
@@ -1859,7 +1859,7 @@ term_destroy(struct terminal *term)
         }
 
         for (size_t i = 0; i < worker_count; i++) {
-            sem_post(&term->render.workers.start);
+            render_sem_post(&term->render.workers.start);
             tll_push_back(term->render.workers.queue, -2);
         }
     }
@@ -1906,8 +1906,8 @@ term_destroy(struct terminal *term)
     mtx_destroy(&term->render.workers.preapplied_damage.lock);
     cnd_destroy(&term->render.workers.preapplied_damage.cond);
     mtx_destroy(&term->render.workers.lock);
-    sem_destroy(&term->render.workers.start);
-    sem_destroy(&term->render.workers.done);
+    render_sem_destroy(&term->render.workers.start);
+    render_sem_destroy(&term->render.workers.done);
     xassert(tll_length(term->render.workers.queue) == 0);
     tll_free(term->render.workers.queue);
 
diff --git a/terminal.h b/terminal.h
index 32145cac..c5161965 100644
--- a/terminal.h
+++ b/terminal.h
@@ -5,7 +5,135 @@
 #include <stddef.h>
 
 #include <threads.h>
-#include <semaphore.h>
+
+/*
+ * Render worker semaphores. render_sem_init() mirrors sem_init():
+ * returns 0 on success, -1 with errno set on failure.
+ */
+#if defined(__APPLE__)
+ #include <AvailabilityMacros.h>
+#endif
+
+#if defined(__APPLE__) && MAC_OS_X_VERSION_MIN_REQUIRED >= 1060
+ /*
+  * Darwin's unnamed POSIX semaphores (sem_init/sem_destroy) are
+  * deprecated, and documented as unreliable, not just discouraged.
+  * Use libdispatch's plain-C semaphore API instead (no Objective-C/
+  * Blocks required; available since the first libdispatch release
+  * in macOS 10.6).
+  */
+ #include <errno.h>
+ #include <dispatch/dispatch.h>
+
+typedef dispatch_semaphore_t render_sem_t;
+
+static inline int
+render_sem_init(render_sem_t *sem)
+{
+    *sem = dispatch_semaphore_create(0);
+    if (*sem == NULL) {
+        errno = ENOMEM;
+        return -1;
+    }
+    return 0;
+}
+
+static inline void
+render_sem_destroy(render_sem_t *sem)
+{
+    if (*sem != NULL) {
+        dispatch_release(*sem);
+        *sem = NULL;
+    }
+}
+
+static inline void
+render_sem_wait(render_sem_t *sem)
+{
+    dispatch_semaphore_wait(*sem, DISPATCH_TIME_FOREVER);
+}
+
+static inline void
+render_sem_post(render_sem_t *sem)
+{
+    dispatch_semaphore_signal(*sem);
+}
+#elif defined(__APPLE__)
+ /*
+  * No libdispatch before macOS 10.6: use Mach semaphores directly
+  * (what dispatch semaphores are built on, available since 10.0).
+  */
+ #include <errno.h>
+ #include <mach/mach.h>
+ #include <mach/task.h>
+ #include <mach/semaphore.h>
+
+typedef semaphore_t render_sem_t;
+
+static inline int
+render_sem_init(render_sem_t *sem)
+{
+    if (semaphore_create(
+            mach_task_self(), sem, SYNC_POLICY_FIFO, 0) != KERN_SUCCESS)
+    {
+        *sem = MACH_PORT_NULL;
+        errno = ENOMEM;
+        return -1;
+    }
+    return 0;
+}
+
+static inline void
+render_sem_destroy(render_sem_t *sem)
+{
+    if (*sem != MACH_PORT_NULL) {
+        semaphore_destroy(mach_task_self(), *sem);
+        *sem = MACH_PORT_NULL;
+    }
+}
+
+static inline void
+render_sem_wait(render_sem_t *sem)
+{
+    /* KERN_ABORTED means the wait was interrupted, not signaled */
+    while (semaphore_wait(*sem) == KERN_ABORTED)
+        ;
+}
+
+static inline void
+render_sem_post(render_sem_t *sem)
+{
+    semaphore_signal(*sem);
+}
+#else
+ #include <semaphore.h>
+
+typedef sem_t render_sem_t;
+
+static inline int
+render_sem_init(render_sem_t *sem)
+{
+    return sem_init(sem, 0, 0);
+}
+
+static inline void
+render_sem_destroy(render_sem_t *sem)
+{
+    sem_destroy(sem);
+}
+
+static inline void
+render_sem_wait(render_sem_t *sem)
+{
+    sem_wait(sem);
+}
+
+static inline void
+render_sem_post(render_sem_t *sem)
+{
+    sem_post(sem);
+}
+#endif
 
 #if defined(FOOT_GRAPHEME_CLUSTERING)
  #include <utf8proc.h>
@@ -694,8 +822,8 @@ struct terminal {
         /* Render threads + synchronization primitives */
         struct {
             uint16_t count;
-            sem_t start;
-            sem_t done;
+            render_sem_t start;
+            render_sem_t done;
             mtx_t lock;
             tll(int) queue;
             thrd_t *threads;
diff --git a/util.h b/util.h
index 3746e269..45722f39 100644
--- a/util.h
+++ b/util.h
@@ -5,6 +5,12 @@
 #include <string.h>
 #include <threads.h>
 
+#if defined(__APPLE__)
+ #include <errno.h>
+ #include <fcntl.h>
+ #include <unistd.h>
+#endif
+
 #define ALEN(v) (sizeof(v) / sizeof((v)[0]))
 #define min(x, y) ((x) < (y) ? (x) : (y))
 #define max(x, y) ((x) > (y) ? (x) : (y))
@@ -15,6 +21,51 @@ streq(const char *a, const char *b)
     return strcmp(a, b) == 0;
 }
 
+#if defined(__APPLE__)
+/*
+ * pipe2() is a Linux/glibc extension (later adopted by *BSD), never
+ * implemented by Darwin on any macOS version. All current call sites
+ * only ever pass O_CLOEXEC and/or O_NONBLOCK.
+ */
+static inline int
+pipe2(int fildes[2], int flags)
+{
+    if (flags & ~(O_CLOEXEC | O_NONBLOCK)) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    if (pipe(fildes) < 0)
+        return -1;
+
+    if (flags & O_NONBLOCK) {
+        for (int i = 0; i < 2; i++) {
+            int f = fcntl(fildes[i], F_GETFL, 0);
+            if (f < 0 || fcntl(fildes[i], F_SETFL, f | O_NONBLOCK) < 0)
+                goto fail;
+        }
+    }
+
+    if (flags & O_CLOEXEC) {
+        for (int i = 0; i < 2; i++) {
+            int f = fcntl(fildes[i], F_GETFD, 0);
+            if (f < 0 || fcntl(fildes[i], F_SETFD, f | FD_CLOEXEC) < 0)
+                goto fail;
+        }
+    }
+
+    return 0;
+
+fail: {
+    int saved_errno = errno;
+    close(fildes[0]);
+    close(fildes[1]);
+    errno = saved_errno;
+    return -1;
+}
+}
+#endif
+
 static inline const char *
 thrd_err_as_string(int thrd_err)
 {
