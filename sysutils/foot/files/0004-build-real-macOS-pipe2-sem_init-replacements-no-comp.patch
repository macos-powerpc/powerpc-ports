From a4c22284e6dc1086a8258a1afa72f8d8f7a5a151 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Mon, 27 Jul 2026 14:30:23 +0000
Subject: [PATCH] build: real macOS pipe2/sem_init replacements, no compat
 headers

pipe2() doesn't exist on Darwin -- add a portable static inline
polyfill to util.h (pipe() + per-fd fcntl(F_SETFL/F_SETFD)), included
by all five call sites.

sem_init/sem_destroy are deprecated on Darwin, and documented as
outright unreliable there, not just discouraged. terminal.h now wraps
the render worker start/done semaphores in a render_sem_t type with
render_sem_init/_destroy/_wait/_post helpers, so terminal.c/render.c
call sites don't branch individually. Backends:

 - macOS 10.6+: libdispatch's plain-C semaphore API
   (dispatch_semaphore_create/_wait/_signal/dispatch_release, no
   Objective-C/Blocks).
 - macOS < 10.6 (no libdispatch): Mach semaphores
   (semaphore_create/_wait/_signal/_destroy), retrying waits
   interrupted with KERN_ABORTED.
 - everything else: POSIX sem_t, unchanged.

The backend is chosen by MAC_OS_X_VERSION_MIN_REQUIRED rather than
header availability, so a newer SDK targeting 10.5 still avoids
libdispatch. render_sem_destroy() clears the handle on Darwin, so the
initialize_render_workers() error path followed by term_destroy()
doesn't release the same object twice.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01U6fuL1PtRJHhr97gAGyS1h
Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 render.c   |  14 +++---
 spawn.c    |   1 +
 terminal.c |  14 +++---
 terminal.h | 134 +++++++++++++++++++++++++++++++++++++++++++++++++++--
 util.h     |  51 ++++++++++++++++++++
 5 files changed, 197 insertions(+), 17 deletions(-)

diff --git a/render.c b/render.c
index 2bc44146..708de8d9 100644
--- a/render.c
+++ b/render.c
@@ -2198,12 +2198,12 @@ render_worker_thread(void *_ctx)
     if (pthread_setname_np(pthread_self(), proc_title) < 0)
         LOG_ERRNO("render worker %d: failed to set process title", my_id);
 
-    sem_t *start = &term->render.workers.start;
-    sem_t *done = &term->render.workers.done;
+    render_sem_t *start = &term->render.workers.start;
+    render_sem_t *done = &term->render.workers.done;
     mtx_t *lock = &term->render.workers.lock;
 
     while (true) {
-        sem_wait(start);
+        render_sem_wait(start);
 
         struct buffer *buf = term->render.workers.buf;
 
@@ -2237,7 +2237,7 @@ render_worker_thread(void *_ctx)
 
             case -1:
                 frame_done = true;
-                sem_post(done);
+                render_sem_post(done);
                 break;
 
             case -2:
@@ -3558,7 +3558,7 @@ grid_render(struct terminal *term)
         mtx_lock(&term->render.workers.lock);
         term->render.workers.buf = buf;
         for (size_t i = 0; i < term->render.workers.count; i++)
-            sem_post(&term->render.workers.start);
+            render_sem_post(&term->render.workers.start);
 
         xassert(tll_length(term->render.workers.queue) == 0);
     }
@@ -3588,7 +3588,7 @@ grid_render(struct terminal *term)
         mtx_unlock(&term->render.workers.lock);
 
         for (size_t i = 0; i < term->render.workers.count; i++)
-            sem_wait(&term->render.workers.done);
+            render_sem_wait(&term->render.workers.done);
         term->render.workers.buf = NULL;
     }
 
@@ -5472,7 +5472,7 @@ render_buffer_release_callback(struct buffer *buf, void *data)
     mtx_unlock(&term->render.workers.preapplied_damage.lock);
 
     mtx_lock(&term->render.workers.lock);
-    sem_post(&term->render.workers.start);
+    render_sem_post(&term->render.workers.start);
     xassert(tll_length(term->render.workers.queue) == 0);
     tll_push_back(term->render.workers.queue, -3);
     mtx_unlock(&term->render.workers.lock);
