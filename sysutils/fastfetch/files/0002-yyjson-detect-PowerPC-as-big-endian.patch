From 75fd6c9a54c5290a0701cf81e3d473fdc06be922 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 7 Aug 2026 03:15:35 +0000
Subject: [PATCH 02/41] yyjson: detect PowerPC as big-endian

Ported from https://github.com/macos-powerpc/powerpc-ports/blob/main/sysutils/fastfetch/files/0009-yyjson-PowerPC-macros.patch
---
 src/3rdparty/yyjson/yyjson.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/3rdparty/yyjson/yyjson.c b/src/3rdparty/yyjson/yyjson.c
index a9bc5f87..736f0994 100644
--- a/src/3rdparty/yyjson/yyjson.c
+++ b/src/3rdparty/yyjson/yyjson.c
@@ -263,7 +263,7 @@ uint32_t yyjson_version(void) {
 #elif (defined(__BIG_ENDIAN__) && __BIG_ENDIAN__ == 1) || \
     defined(__ARMEB__) || defined(__THUMBEB__) || defined(__AARCH64EB__) || \
     defined(_MIPSEB) || defined(__MIPSEB) || defined(__MIPSEB__) || \
-    defined(__or1k__) || defined(__OR1K__)
+    defined(__or1k__) || defined(__OR1K__) || defined(__POWERPC__)
 #   define YYJSON_ENDIAN YYJSON_BIG_ENDIAN
 #else
 #   define YYJSON_ENDIAN 0 /* unknown endian, detect at run-time */
-- 
2.43.0

