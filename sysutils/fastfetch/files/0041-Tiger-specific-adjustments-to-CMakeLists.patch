From 62c3dc188cce419eaf01cddbe55e51c00b0fa5fd Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 23:03:59 +0000
Subject: [PATCH 40/41] CMakeLists: Tiger/Leopard-specific adjustments

For os.major < 10 (Tiger/Leopard) targets: swap binary_apple.c for
binary_linux.c, and battery_apple.c/physicaldisk_apple.c/physicalmemory_apple.m
for their nosupport variants, since the APIs they need are not present (or not
reliably present) on these systems. Drop the CoreMedia framework link, which is
not required by this configuration.
---
 CMakeLists.txt | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7f756da8..2ce0cba0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1043,13 +1043,13 @@ elseif(APPLE)
         src/common/impl/processing_linux.c
         src/common/impl/sysctl.c
         src/common/impl/FFPlatform_unix.c
-        src/common/impl/binary_apple.c
+        src/common/impl/binary_linux.c
         src/common/impl/kmod_apple.c
         src/common/apple/cf_helpers.c
         src/common/apple/osascript.m
         src/common/apple/smc_temps.c
         src/common/apple/version.m
-        src/detection/battery/battery_apple.c
+        src/detection/battery/battery_nosupport.c
         src/detection/bluetooth/bluetooth_nosupport.c
         src/detection/bluetoothradio/bluetoothradio_nosupport.c
         src/detection/bootmgr/bootmgr_apple.c
@@ -1062,7 +1062,7 @@ elseif(APPLE)
         src/detection/cursor/cursor_apple.c
         src/detection/disk/disk_bsd.c
         src/detection/dns/dns_apple.c
-        src/detection/physicaldisk/physicaldisk_apple.c
+        src/detection/physicaldisk/physicaldisk_nosupport.c
         src/detection/diskio/diskio_apple.c
         src/detection/displayserver/displayserver_apple.c
         src/detection/font/font_apple.m
@@ -1125,7 +1125,7 @@ elseif(APPLE)
             src/detection/board/board_apple.c
             src/detection/chassis/chassis_apple.c
             src/detection/host/host_apple.c
-            src/detection/physicalmemory/physicalmemory_apple.m
+            src/detection/physicalmemory/physicalmemory_nosupport.c
         )
     endif()
 elseif(WIN32)
@@ -1991,7 +1991,6 @@ elseif(APPLE)
         PRIVATE "-framework Cocoa"
         PRIVATE "-framework CoreAudio"
         PRIVATE "-framework CoreFoundation"
-        PRIVATE "-framework CoreMedia"
         PRIVATE "-framework CoreVideo"
         PRIVATE "-framework IOBluetooth"
         PRIVATE "-framework IOKit"
-- 
