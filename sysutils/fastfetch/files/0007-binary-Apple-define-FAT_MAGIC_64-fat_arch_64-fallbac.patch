From b076235dc70225f72ce8fd41187ebd3e425f5992 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 7 Aug 2026 03:15:50 +0000
Subject: [PATCH 07/41] binary (Apple): define FAT_MAGIC_64/fat_arch_64
 fallbacks for pre-10.6 SDKs

Ported from https://github.com/macos-powerpc/powerpc-ports/blob/main/sysutils/fastfetch/files/0010-swap_fat_arch_64-does-not-exist-in-10.6.patch
---
 src/common/impl/binary_apple.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/common/impl/binary_apple.c b/src/common/impl/binary_apple.c
index dd35a5ae..94d672e5 100644
--- a/src/common/impl/binary_apple.c
+++ b/src/common/impl/binary_apple.c
@@ -11,6 +11,19 @@
 #include <mach-o/swap.h>
 #include <mach-o/fat.h>
 
+#ifndef FAT_MAGIC_64
+#define FAT_MAGIC_64 0xcafebabf
+#endif
+#ifndef FAT_CIGAM_64
+#define FAT_CIGAM_64 0xbfbafeca
+#endif
+#ifndef fat_arch_64
+#define fat_arch_64 fat_arch
+#endif
+#ifndef swap_fat_arch_64
+#define swap_fat_arch_64 swap_fat_arch
+#endif
+
 #pragma GCC diagnostic ignored "-Wdeprecated-declarations" // swap_fat_arch
 
 // Ref: https://github.com/AlexDenisov/segment_dumper/blob/master/main.c
-- 
2.43.0

