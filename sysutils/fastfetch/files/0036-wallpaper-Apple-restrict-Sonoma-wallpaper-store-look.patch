From 7298362d1482a8e873db87c0d553a485818acda0 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 25 Sep 2026 19:20:56 +0000
Subject: [PATCH] wallpaper (Apple): restrict Sonoma wallpaper-store lookup to
 macOS > 13

The Sonoma plist store and NSWorkspace lookups, and the @available
dispatch, are compiled only for modern targets. Legacy targets query
the Dock SQLite database and fall back to asking the Finder via
osascript.

Ported from https://github.com/macos-powerpc/powerpc-ports/blob/main/sysutils/fastfetch/files/0012-Misc-fixes-for-legacy-systems.patch
---
 src/detection/wallpaper/wallpaper_apple.m | 29 +++++++++++++++++++++--
 1 file changed, 27 insertions(+), 2 deletions(-)

diff --git a/src/detection/wallpaper/wallpaper_apple.m b/src/detection/wallpaper/wallpaper_apple.m
index 76d03168e..21aabcdb2 100644
--- a/src/detection/wallpaper/wallpaper_apple.m
+++ b/src/detection/wallpaper/wallpaper_apple.m
@@ -1,9 +1,12 @@
 #include "wallpaper.h"
 #include "common/settings.h"
+#include "common/apple/osascript.h"
 
-#import <Foundation/Foundation.h>
-#import <AppKit/AppKit.h>
+#include <Foundation/Foundation.h>
+#include <AppKit/AppKit.h>
+#include <AvailabilityMacros.h>
 
+#if MAC_OS_X_VERSION_MIN_REQUIRED > 130000
 const char* detectFromPlist(FFstrbuf* result) {
     // For Sonoma and later (macOS 14.0+)
     // https://github.com/JohnCoates/Aerial/issues/1332
@@ -83,6 +86,7 @@ const char* detectFromPlist(FFstrbuf* result) {
     }
     return nullptr;
 }
+#endif
 
 #ifdef FF_HAVE_SQLITE3
 const char* detectFromSQLite(FFstrbuf* result) {
@@ -105,6 +109,7 @@ const char* detectFromSQLite(FFstrbuf* result) {
 }
 #endif
 
+#if MAC_OS_X_VERSION_MIN_REQUIRED > 130000
 const char* detectFromNSWorkspace(FFstrbuf* result) {
     // Reliable for user-picked static images.
     NSScreen* mainScreen = NSScreen.mainScreen;
@@ -120,10 +125,29 @@ const char* detectFromNSWorkspace(FFstrbuf* result) {
 
     return "Failed to detect wallpaper from NSWorkspace";
 }
+#else
+static const char* detectFromOsascript(FFstrbuf* result) {
+    if (ffOsascript("tell application \"Finder\" to get POSIX path of (get desktop picture as alias)", result)) {
+        return nullptr;
+    }
+
+    return "Failed to detect wallpaper from osascript";
+}
+#endif
 
 const char* ffDetectWallpaper(FFstrbuf* result) {
     const char* error;
 
+#if MAC_OS_X_VERSION_MIN_REQUIRED <= 130000
+#ifdef FF_HAVE_SQLITE3
+    error = detectFromSQLite(result);
+    if (error) {
+        error = detectFromOsascript(result);
+    }
+#else
+    error = detectFromOsascript(result);
+#endif
+#else
     if (@available(macOS 14.0, *)) {
         error = detectFromPlist(result);
         if (error) {
@@ -143,5 +167,6 @@ const char* ffDetectWallpaper(FFstrbuf* result) {
         error = detectFromNSWorkspace(result);
 #endif
     }
+#endif
     return error;
 }
-- 
2.43.0

