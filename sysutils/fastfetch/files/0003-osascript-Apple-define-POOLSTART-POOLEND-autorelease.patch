From 99a15bd8aa9a735c44e722b12bc3f5240f7c4ebe Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 7 Aug 2026 03:19:49 +0000
Subject: [PATCH 03/38] osascript (Apple): define POOLSTART/POOLEND
 autorelease-pool helpers

Ported from https://github.com/macos-powerpc/powerpc-ports/blob/main/sysutils/fastfetch/files/0012-Misc-fixes-for-legacy-systems.patch
---
 src/common/apple/osascript.h | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/common/apple/osascript.h b/src/common/apple/osascript.h
index 164d8d708..1255ac302 100644
--- a/src/common/apple/osascript.h
+++ b/src/common/apple/osascript.h
@@ -3,3 +3,13 @@
 #include "fastfetch.h"
 
 bool ffOsascript(const char* input, FFstrbuf* result);
+
+#include <AvailabilityMacros.h>
+
+#if MAC_OS_X_VERSION_MIN_REQUIRED < 1090
+#define POOLSTART NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+#define POOLEND   [pool release];
+#else
+#define POOLSTART
+#define POOLEND
+#endif
-- 
