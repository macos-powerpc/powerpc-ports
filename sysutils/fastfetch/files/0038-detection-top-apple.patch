From 07eed76c64f71582ae27fac038aeb015ab62cd16 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 23:03:43 +0000
Subject: [PATCH 37/41] top (Apple): add pre-10.7 proc_listpids() and pre-10.9
 rusage/Mach-time fallbacks

proc_listallpids() is 10.7+; fall back to proc_listpids(PROC_ALL_PIDS) on
older/PowerPC targets. Before 10.9 there is no proc_pid_rusage()/RUSAGE_INFO_V2,
so compute CPU time from Mach absolute-time units and skip disk I/O counters.
The 10.5 SDK's pbi_start is a struct timeval rather than separate tv_sec/tv_usec
fields.
---
 src/detection/top/top_apple.c | 48 +++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/src/detection/top/top_apple.c b/src/detection/top/top_apple.c
index 3e5cc5ba..4a053794 100644
--- a/src/detection/top/top_apple.c
+++ b/src/detection/top/top_apple.c
@@ -6,8 +6,31 @@
 #include <string.h>
 #include <sys/sysctl.h>
 #include <libproc.h>
+#include <AvailabilityMacros.h>
+
+#ifndef RUSAGE_INFO_V2
+#include <mach/mach_time.h>
+#endif
 
 const char* ffTopGetProcessSnapshot(FFlist* snapshots, FFTopTypes showTypes) {
+#if MAC_OS_X_VERSION_MIN_REQUIRED < 1070
+    // proc_listallpids() is 10.7+. proc_listpids(PROC_ALL_PIDS) is what it wraps,
+    // but that takes and returns sizes in bytes rather than a count of pids.
+    int bufferSize = proc_listpids(PROC_ALL_PIDS, 0, nullptr, 0);
+    if (bufferSize <= 0) {
+        return "proc_listpids(PROC_ALL_PIDS, nullptr) failed";
+    }
+    bufferSize += bufferSize / 8 + (int) sizeof(pid_t);
+    FF_AUTO_FREE pid_t* pids = malloc((size_t) bufferSize);
+    if (pids == nullptr) {
+        return "malloc() failed";
+    }
+    bufferSize = proc_listpids(PROC_ALL_PIDS, 0, pids, bufferSize);
+    if (bufferSize <= 0) {
+        return "proc_listpids(PROC_ALL_PIDS, pids) failed";
+    }
+    int npids = bufferSize / (int) sizeof(pid_t);
+#else
     int npids = proc_listallpids(nullptr, 0);
     if (npids <= 0) {
         FF_DEBUG("proc_listallpids(nullptr, 0) failed: %s", strerror(errno));
@@ -26,9 +49,21 @@ const char* ffTopGetProcessSnapshot(FFlist* snapshots, FFTopTypes showTypes) {
         FF_DEBUG("proc_listallpids(pids, %d) failed: %s", pidCapacity * (int) sizeof(pid_t), strerror(errno));
         return "proc_listallpids(pids, bufferSize) failed";
     }
+#endif
 
     uint32_t count = (uint32_t) npids;
 
+#ifndef RUSAGE_INFO_V2
+    // Before 10.9 there is no proc_pid_rusage(). pti_total_user / pti_total_system
+    // are reported in Mach absolute-time units, which are not nanoseconds on PowerPC.
+    static double timebaseNsPerTick = 0;
+    if (timebaseNsPerTick == 0) {
+        mach_timebase_info_data_t timebase;
+        mach_timebase_info(&timebase);
+        timebaseNsPerTick = (double) timebase.numer / (double) timebase.denom;
+    }
+#endif
+
     for (uint32_t i = 0; i < count; ++i) {
         pid_t pid = pids[i];
 
@@ -47,15 +82,25 @@ const char* ffTopGetProcessSnapshot(FFlist* snapshots, FFTopTypes showTypes) {
             ffStrbufInitS(&item->name, proc.pbsd.pbi_comm);
         }
         item->pid = (uint32_t) pid;
+#ifdef RUSAGE_INFO_V2
         item->cpuTime = (proc.ptinfo.pti_total_user + proc.ptinfo.pti_total_system) / 1000000u; // ns -> ms
+#else
+        item->cpuTime = (uint64_t) ((double) (proc.ptinfo.pti_total_user + proc.ptinfo.pti_total_system) * timebaseNsPerTick / 1000000.0); // ticks -> ms
+#endif
         item->memBytes = proc.ptinfo.pti_resident_size;
+#if MAC_OS_X_VERSION_MAX_ALLOWED < 1060
+        // 10.5 SDK: pbi_start is a struct timeval
+        item->startTime = (uint64_t) proc.pbsd.pbi_start.tv_sec * 1000u + (uint64_t) proc.pbsd.pbi_start.tv_usec / 1000u; // convert to ms
+#else
         item->startTime = proc.pbsd.pbi_start_tvsec * 1000u + proc.pbsd.pbi_start_tvusec / 1000u; // convert to ms
+#endif
         item->threads = (uint32_t) proc.ptinfo.pti_threadnum;
 
         // FF_LIST_ADD does not zero the element, and top.c subtracts both counters for every
         // process it samples, whether or not they were collected.
         item->bytesRead = 0;
         item->bytesWritten = 0;
+#ifdef RUSAGE_INFO_V2
         if (showTypes & FF_TOP_TYPE_DISK) {
             struct rusage_info_v2 rusage;
             if (proc_pid_rusage(pid, RUSAGE_INFO_V2, (rusage_info_t*) &rusage) == 0) {
@@ -63,6 +108,9 @@ const char* ffTopGetProcessSnapshot(FFlist* snapshots, FFTopTypes showTypes) {
                 item->bytesWritten = rusage.ri_diskio_byteswritten;
             }
         }
+#else
+        (void) showTypes; // Disk IO counters need proc_pid_rusage(), 10.9+
+#endif
     }
 
     return nullptr;
-- 
