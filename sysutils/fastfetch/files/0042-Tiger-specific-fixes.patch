diff --git a/src/detection/processes/processes_apple.c b/src/detection/processes/processes_apple.c
index 727aeac02..f64261b5e 100644
--- a/src/detection/processes/processes_apple.c
+++ b/src/detection/processes/processes_apple.c
@@ -2,7 +2,7 @@
 #include "common/mallocHelper.h"
 
 #include <sys/sysctl.h>
-#import <libproc.h>
+#include <mach/mach.h>
 
 const char* ffDetectProcesses(const FFProcessesOptions* options, FFProcessesResult* result) {
     int request[] = { CTL_KERN, KERN_PROC, KERN_PROC_ALL };
@@ -28,13 +28,18 @@ const char* ffDetectProcesses(const FFProcessesOptions* options, FFProcessesResu
             continue;
         }
         result->processes++;
+    }
 
-        pid_t pid = proc->kp_proc.p_pid;
-        struct proc_taskinfo taskInfo;
-        if (proc_pidinfo(pid, PROC_PIDTASKINFO, 0, &taskInfo, sizeof(taskInfo)) == sizeof(taskInfo)) {
-            // NOTE: This fails for system processes
-            result->threads += (uint32_t) taskInfo.pti_threadnum;
+    // There is no libproc (proc_pidinfo) on 10.4. Take the system-wide thread count
+    // from the default processor set instead, which needs no privileges.
+    processor_set_name_t pset;
+    if (processor_set_default(mach_host_self(), &pset) == KERN_SUCCESS) {
+        processor_set_load_info_data_t load;
+        mach_msg_type_number_t loadCount = PROCESSOR_SET_LOAD_INFO_COUNT;
+        if (processor_set_statistics(pset, PROCESSOR_SET_LOAD_INFO, (processor_set_info_t) &load, &loadCount) == KERN_SUCCESS) {
+            result->threads = (uint32_t) load.thread_count;
         }
+        mach_port_deallocate(mach_task_self(), pset);
     }
 
     return nullptr;
diff --git a/src/detection/top/top_apple.c b/src/detection/top/top_apple.c
index 62fdfbfaf..792cf75fe 100644
--- a/src/detection/top/top_apple.c
+++ b/src/detection/top/top_apple.c
@@ -1,112 +1,6 @@
 #include "top.h"
-#include "common/mallocHelper.h"
 
-#include <errno.h>
-#include <sys/sysctl.h>
-#include <libproc.h>
-#include <AvailabilityMacros.h>
-
-#ifndef RUSAGE_INFO_V2
-#include <mach/mach_time.h>
-#endif
-
-const char* ffTopGetProcessSnapshot(FFlist* snapshots, FFTopTypes showTypes) {
-#if MAC_OS_X_VERSION_MIN_REQUIRED < 1070
-    // proc_listallpids() is 10.7+. proc_listpids(PROC_ALL_PIDS) is what it wraps,
-    // but that takes and returns sizes in bytes rather than a count of pids.
-    int bufferSize = proc_listpids(PROC_ALL_PIDS, 0, nullptr, 0);
-    if (bufferSize <= 0) {
-        return "proc_listpids(PROC_ALL_PIDS, nullptr) failed";
-    }
-    bufferSize += bufferSize / 8 + (int) sizeof(pid_t);
-    FF_AUTO_FREE pid_t* pids = malloc((size_t) bufferSize);
-    if (pids == nullptr) {
-        return "malloc() failed";
-    }
-    bufferSize = proc_listpids(PROC_ALL_PIDS, 0, pids, bufferSize);
-    if (bufferSize <= 0) {
-        return "proc_listpids(PROC_ALL_PIDS, pids) failed";
-    }
-    int npids = bufferSize / (int) sizeof(pid_t);
-#else
-    int npids = proc_listallpids(nullptr, 0);
-    if (npids <= 0) {
-        return "proc_listallpids(nullptr, 0) failed";
-    }
-    // `proc_listallpids` returns the number of pids, but it wants the size of the buffer in bytes:
-    // passing the count back would only let the kernel fill a quarter of it.
-    const int pidCapacity = npids + npids / 8 + 1;
-    FF_AUTO_FREE pid_t* pids = malloc((size_t) pidCapacity * sizeof(pid_t));
-    if (pids == nullptr) {
-        return "malloc() failed";
-    }
-    npids = proc_listallpids(pids, pidCapacity * (int) sizeof(pid_t));
-    if (npids <= 0) {
-        return "proc_listallpids(pids, bufferSize) failed";
-    }
-#endif
-
-    uint32_t count = (uint32_t) npids;
-
-#ifndef RUSAGE_INFO_V2
-    // Before 10.9 there is no proc_pid_rusage(). pti_total_user / pti_total_system
-    // are reported in Mach absolute-time units, which are not nanoseconds on PowerPC.
-    static double timebaseNsPerTick = 0;
-    if (timebaseNsPerTick == 0) {
-        mach_timebase_info_data_t timebase;
-        mach_timebase_info(&timebase);
-        timebaseNsPerTick = (double) timebase.numer / (double) timebase.denom;
-    }
-#endif
-
-    for (uint32_t i = 0; i < count; ++i) {
-        pid_t pid = pids[i];
-
-        struct proc_taskallinfo proc;
-        if (proc_pidinfo(pid, PROC_PIDTASKALLINFO, 0, &proc, sizeof(proc)) != sizeof(proc)) {
-            continue;
-        }
-
-        if (proc.pbsd.pbi_flags & PROC_FLAG_SYSTEM) {
-            continue;
-        }
-
-        FFTopProcessSnapshot* item = FF_LIST_ADD(FFTopProcessSnapshot, *snapshots);
-        ffStrbufInitS(&item->name, proc.pbsd.pbi_name);
-        if (item->name.length == 0) {
-            ffStrbufInitS(&item->name, proc.pbsd.pbi_comm);
-        }
-        item->pid = (uint32_t) pid;
-#ifdef RUSAGE_INFO_V2
-        item->cpuTime = (proc.ptinfo.pti_total_user + proc.ptinfo.pti_total_system) / 1000000u; // ns -> ms
-#else
-        item->cpuTime = (uint64_t) ((double) (proc.ptinfo.pti_total_user + proc.ptinfo.pti_total_system) * timebaseNsPerTick / 1000000.0); // ticks -> ms
-#endif
-        item->memBytes = proc.ptinfo.pti_resident_size;
-#if MAC_OS_X_VERSION_MAX_ALLOWED < 1060
-        // 10.5 SDK: pbi_start is a struct timeval
-        item->startTime = (uint64_t) proc.pbsd.pbi_start.tv_sec * 1000u + (uint64_t) proc.pbsd.pbi_start.tv_usec / 1000u; // convert to ms
-#else
-        item->startTime = proc.pbsd.pbi_start_tvsec * 1000u + proc.pbsd.pbi_start_tvusec / 1000u; // convert to ms
-#endif
-        item->threads = (uint32_t) proc.ptinfo.pti_threadnum;
-
-        // FF_LIST_ADD does not zero the element, and top.c subtracts both counters for every
-        // process it samples, whether or not they were collected.
-        item->bytesRead = 0;
-        item->bytesWritten = 0;
-#ifdef RUSAGE_INFO_V2
-        if (showTypes & FF_TOP_TYPE_DISK) {
-            struct rusage_info_v2 rusage;
-            if (proc_pid_rusage(pid, RUSAGE_INFO_V2, (rusage_info_t*) &rusage) == 0) {
-                item->bytesRead = rusage.ri_diskio_bytesread;
-                item->bytesWritten = rusage.ri_diskio_byteswritten;
-            }
-        }
-#else
-        (void) showTypes; // Disk IO counters need proc_pid_rusage(), 10.9+
-#endif
-    }
-
-    return nullptr;
+// Per-process CPU and memory usage needs libproc (proc_pidinfo), which is 10.5+
+const char* ffTopGetProcessSnapshot([[maybe_unused]] FFlist* snapshots, [[maybe_unused]] FFTopTypes showTypes) {
+    return "Not supported on Mac OS X 10.4";
 }
