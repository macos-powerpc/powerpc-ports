From 2d52648bed170fc3f1a3e3fc05db47af63cc0387 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 15 Oct 2026 23:03:49 +0000
Subject: [PATCH 38/41] lm (Apple): use dictionaryWithContentsOfFile: instead
 of 10.13+ dictionaryWithContentsOfURL:error:

+dictionaryWithContentsOfURL:error: requires macOS 10.13. Read the plist with
the legacy dictionaryWithContentsOfFile: API and fetch the version string via
objectForKey: instead of subscripting.
---
 src/detection/lm/lm_apple.m | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/detection/lm/lm_apple.m b/src/detection/lm/lm_apple.m
index d600058d..af5e7cc3 100644
--- a/src/detection/lm/lm_apple.m
+++ b/src/detection/lm/lm_apple.m
@@ -6,12 +6,12 @@ const char* ffDetectLM(FFLMResult* result) {
     ffStrbufSetStatic(&result->service, "loginwindow");
     ffStrbufSetStatic(&result->prettyName, "Login Window");
 
-    NSError* error;
-    NSDictionary* dict = [NSDictionary dictionaryWithContentsOfURL:[NSURL fileURLWithPath:@"/System/Library/CoreServices/loginwindow.app/Contents/Info.plist" isDirectory:NO]
-                                                                error:&error];
+    // +dictionaryWithContentsOfURL:error: is 10.13+
+    NSDictionary* dict = [NSDictionary dictionaryWithContentsOfFile:@"/System/Library/CoreServices/loginwindow.app/Contents/Info.plist"];
 
     if (dict) {
-        ffStrbufSetS(&result->version, ((NSString*) dict[@"CFBundleShortVersionString"]).UTF8String);
+        NSString* version = [dict objectForKey:@"CFBundleShortVersionString"];
+        ffStrbufSetS(&result->version, version.UTF8String);
     }
 
     return nullptr;
-- 
