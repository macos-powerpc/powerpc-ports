                    0008-Handle-pre-10.8-macOS-in-UnixStream-peer-credentials.patch \
                    0009-Build-the-pywatchman-C-extension-with-the-configured.patch \
                    0010-Don-t-FSEventStreamFlushSync-cross-thread-on-pre-10.patch

