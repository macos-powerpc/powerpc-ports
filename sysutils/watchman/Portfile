                    0004-Suppress-unprefixed-AssertMacros-names-on-old-macOS-.patch \
                    0005-Support-32-bit-platforms-in-w_string.patch \
                    0006-Include-fmt-format.h-instead-of-the-deprecated-fmt-c.patch \
