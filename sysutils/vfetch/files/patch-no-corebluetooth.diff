Report no bluetooth instead of using CoreBluetooth.

CoreBluetooth.framework was introduced in macOS 10.7 and never existed for
PowerPC. system/bluetooth.m is also Objective-C, which V only compiles as
such when the host is not a PowerPC Mac (see !user_darwin_ppc in
v/builder/cc.v). vfetch.v skips any field whose Result is unsuccessful, so
the BLUETOOTH line simply disappears.

--- system/bluetooth.v.original
+++ system/bluetooth.v
@@ -1,20 +1,6 @@
 module system
-
-// #include <Foundation/Foundation.h>
-// #include <IOBluetooth/IOBluetooth.h>
-#flag darwin -framework CoreBluetooth
-#include "@VMODROOT/system/bluetooth.m"
-
-fn C.get_connected_devices() int
 
 @[inline]
 fn get_bluetooth_status() Result {
-  devices_count := C.get_connected_devices()
-
-  return match true {
-    devices_count <= 0 { failure }
-    devices_count == 1 { success("1 device connected") }
-    devices_count > 1 { success("${devices_count} devices connected") }
-    else { failure }
-  }
+  return failure
 }
