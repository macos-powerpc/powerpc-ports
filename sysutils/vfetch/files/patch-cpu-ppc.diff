get_cpu() reads machdep.cpu.brand_string and machdep.cpu.core_count, but the
whole machdep.cpu.* sysctl MIB is x86-only -- it reads directly off CPUID,
which PowerPC doesn't have. On ppc/ppc64 both calls fail, get_cpu() returns
failure, and vfetch drops the CPU line entirely rather than printing
anything wrong.

Use the portable MIBs instead: hw.cpusubtype (mach/machine.h's
CPU_SUBTYPE_POWERPC_*) identifies the chip, hw.cpufrequency gives its clock
speed, and hw.ncpu the core count -- all three exist on every Darwin
architecture. hw.cpusubtype is mapped to the usual marketing name (601
through G5); 970/970FX/970MP/970GX all share subtype 100, so dual-core G5s
are told apart by hw.ncpu instead, same as multi-core Intel Macs already are.

--- system/cpu.v.original
+++ system/cpu.v
@@ -5,19 +5,48 @@

 fn C.sysctlbyname(name &char, oldp voidptr, oldlenp &usize, newp voidptr, newlen u64) int

+// PowerPC has no machdep.cpu.brand_string or machdep.cpu.core_count -- that
+// whole machdep.cpu.* MIB only exists on x86. hw.cpusubtype, hw.cpufrequency
+// and hw.ncpu are the portable equivalents, present on every Darwin
+// architecture; hw.cpusubtype's values are mach/machine.h's
+// CPU_SUBTYPE_POWERPC_*, mapped here to the usual marketing names.
+fn powerpc_name(subtype int) string {
+  return match subtype {
+    9      { 'PowerPC G3' }
+    10, 11 { 'PowerPC G4' }
+    100    { 'PowerPC G5' }
+    1      { 'PowerPC 601' }
+    2      { 'PowerPC 602' }
+    3      { 'PowerPC 603' }
+    4      { 'PowerPC 603e' }
+    5      { 'PowerPC 603ev' }
+    6      { 'PowerPC 604' }
+    7      { 'PowerPC 604e' }
+    8      { 'PowerPC 620' }
+    else   { 'PowerPC' }
+  }
+}
+
 @[inline]
 fn get_cpu() Result {
-  mut cpu_model := []u8{len: 256}
-  mut len := usize(sizeof(cpu_model))
-  if C.sysctlbyname("machdep.cpu.brand_string".str, &char(cpu_model.data), &len, 0, 0) != 0 {
+  mut subtype := 0
+  mut subtype_len := usize(sizeof(subtype))
+  if C.sysctlbyname("hw.cpusubtype".str, &subtype, &subtype_len, 0, 0) != 0 {
+    return failure
+  }
+
+  mut freq := u64(0)
+  mut freq_len := usize(sizeof(freq))
+  if C.sysctlbyname("hw.cpufrequency".str, &freq, &freq_len, 0, 0) != 0 {
     return failure
   }

   mut cores := 0
   mut cores_len := usize(sizeof(cores))
-  if C.sysctlbyname("machdep.cpu.core_count".str, &cores, &cores_len, 0, 0) != 0 {
+  if C.sysctlbyname("hw.ncpu".str, &cores, &cores_len, 0, 0) != 0 {
     return failure
   }

-  return success("${cpu_model.bytestr()} ${cores} cores")
+  ghz := f64(freq) / 1_000_000_000.0
+  return success("${powerpc_name(subtype)} @ ${ghz:.2f}GHz ${cores} cores")
 }
