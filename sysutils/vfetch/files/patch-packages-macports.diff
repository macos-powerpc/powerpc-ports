get_packages() only ever counts Homebrew's Cellar/Caskroom directories, so on
a MacPorts-only system (i.e. every target of this port) it always returns
failure and the package count line never appears.

Fall back to `port installed`, which lists one line per installed port
version plus a single header line ("The following ports are currently
installed:", or "No ports are installed." when there are none). Subtracting
that header line gives the count; this is the same approach neofetch uses
for its own MacPorts detection.

--- system/packages.v.original
+++ system/packages.v
@@ -18,6 +18,10 @@
 		return success('${total} (homebrew)')
 	}

+  if mp_total := count_macports() {
+    return success('${mp_total} (macports)')
+  }
+
 	return failure
 }

@@ -35,3 +39,26 @@

   return count
 }
+
+fn count_macports() ?u32 {
+  result := os.execute('port installed')
+  if result.exit_code != 0 {
+    return none
+  }
+
+  mut lines := u32(0)
+  for line in result.output.split_into_lines() {
+    if line.trim_space() != '' {
+      lines++
+    }
+  }
+
+  // "port installed" always prints one header line before any per-port
+  // lines ("The following ports are currently installed:", or "No ports
+  // are installed." when there are none).
+  if lines <= 1 {
+    return none
+  }
+
+  return lines - 1
+}
