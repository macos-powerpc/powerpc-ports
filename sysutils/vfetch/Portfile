# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           legacysupport 1.1

# clock_gettime
legacysupport.newest_darwin_requires_legacy 15

github.setup        carlosqsilva vfetch 0.4.0
revision            0
categories          sysutils
# Upstream ships no LICENSE file; MIT is declared in v.mod.
license             MIT
maintainers         nomaintainer

description         Command-line system fetch tool for macOS written in V
long_description    ${name} prints a summary of the running system – OS, \
                    uptime, CPU, memory, storage, battery and more – beside \
                    an ASCII logo, in the style of neofetch.

checksums           rmd160  a74e6a625dab0bf3c3b1437048373c2c7aa88bc2 \
                    sha256  fd184aa2c101c3c55a4e1d901539572c63279ea8e1b86bd639635be772a5ffb3 \
                    size    9291
github.tarball_from archive

depends_build-append \
                    port:vlang
depends_lib-append  port:boehmgc

use_configure       no

# Match vlang
compiler.c_standard 2011
compiler.blacklist-append {clang < 700} macports-clang-3.*

if {${configure.build_arch} in [list ppc ppc64]} {
    configure.ldflags-append -latomic
}

# Each conditional below guards a macOS API that postdates the system being
# built on. vfetch.v prints a field only when its Result is successful,
# so a stubbed module simply drops one line from the output.

platform darwin {
    # CoreBluetooth is 10.7+, and bluetooth.m is Objective-C.
    if {${os.major} < 11} {
        patchfiles-append patch-no-corebluetooth.diff
    } else {
        configure.cflags-append -framework IOBluetooth -framework Foundation
    }

    # CGDisplayCopyDisplayMode and CGDisplayModeGet* are 10.6+. Where the module
    # survives, it must link ApplicationServices: there is no top-level
    # CoreGraphics.framework before 10.8.
    if {${os.major} < 10} {
        patchfiles-append patch-resolution-pre-10.6.diff
    } else {
        patchfiles-append patch-framework-applicationservices.diff
    }

    if {${os.major} < 13} {
        patchfiles-append patch-memory-pre-10.9.diff
    }
}

# Keep everything V writes inside the work directory.
build.env-append    HOME=${workpath} \
                    VMODULES=${workpath}/.vmodules \
                    VTMP=${workpath}/.vtmp

build.cmd           ${prefix}/bin/v
build.target
build.args          -prod \
                    -cc ${configure.cc} \
                    -cflags [shellescape "${configure.cppflags} ${configure.cflags}"] \
                    -ldflags [shellescape ${configure.ldflags}] \
                    -o ${workpath}/${name} \
                    ${worksrcpath}

destroot {
    xinstall -m 0755 ${workpath}/${name} ${destroot}${prefix}/bin/${name}

    set docdir ${prefix}/share/doc/${name}
    xinstall -d ${destroot}${docdir}
    xinstall -m 0644 -W ${worksrcpath} README.md ${destroot}${docdir}
}
