# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8::et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github          1.0
PortGroup           legacysupport   1.1

name                lnav

homepage            https://lnav.org

description         Advanced log file viewer for the small-scale.
long_description    \
    Many logging tools, like Splunk, provide great features but are optimized \
    for large-scale deployments. They require installing and configuring \
    servers before they can be effectively used. There is still a need for \
    a robust log file analyzer for the terminal.

categories          sysutils
installs_libs       no
license             BSD
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer

subport ${name}-devel {}

if {${subport} eq ${name}} {
    # Main Port
    github.setup        tstack lnav 0.14.1 v
    revision            0

    conflicts           lnav-devel

    checksums           ${distname}${extract.suffix} \
                        rmd160  cf25052eede2b4c93112143acde513f725b1eac2 \
                        sha256  9eddf42dbbbd59af423cd25f49e744969c95a3901f9aba07e48481d4c41c4c4e \
                        size    34997196
    github.tarball_from archive

    github.livecheck.regex {([0-9.]+)}

} else {
    # Devel
    github.setup        tstack lnav 0.14.1 v
    revision            0

    conflicts           lnav

    checksums           ${distname}${extract.suffix} \
                        rmd160  cf25052eede2b4c93112143acde513f725b1eac2 \
                        sha256  9eddf42dbbbd59af423cd25f49e744969c95a3901f9aba07e48481d4c41c4c4e \
                        size    34997196
    github.tarball_from archive
}

# lnav(46900) malloc: *** error for object 0xa04dc754: pointer being freed was not allocated
legacysupport.redirect_bins lnav

patchfiles-append   patch-fix-broken-Makefile.diff

depends_lib-append  port:bzip2 \
                    port:curl \
                    port:libarchive \
                    port:ncurses \
                    path:lib/libssl.dylib:openssl \
                    port:pcre2 \
                    port:readline \
                    port:sqlite3 \
                    port:zlib

compiler.c_standard   2011
compiler.cxx_standard 2014

configure.args-append \
                    --disable-silent-rules \
                    --disable-static \
                    --with-libarchive \
                    --with-libcurl=${prefix} \
                    --with-ncurses \
                    --with-pcre2 \
                    --with-readline \
                    --with-sqlite3

use_autoreconf      yes

if {[string match *gcc* ${configure.compiler}] && ${configure.build_arch} in [list arm i386 ppc]} {
    configure.ldflags-append \
                    -latomic
}
