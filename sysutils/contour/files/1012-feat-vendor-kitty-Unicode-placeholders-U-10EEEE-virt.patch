+TEST_CASE("KittyGraphics.parse.virtual_placement_key", "[kitty]")
+{
+    auto const command = parseCommand("a=p,U=1,i=7"sv);
+    REQUIRE(command.has_value());
+    CHECK(command->virtualPlacement);
+    CHECK(command->imageId == 7);
+    CHECK_FALSE(parseCommand("a=p,i=7"sv)->virtualPlacement);
+}
+
+TEST_CASE("KittyGraphics.placeholder.diacritic_table_is_the_protocols", "[kitty]")
+{
+    CHECK(rowColumnDiacriticValue(U'\u0305') == uint16_t { 0 });
+    CHECK(rowColumnDiacriticValue(U'\u030D') == uint16_t { 1 });
+    CHECK(rowColumnDiacriticValue(U'\u030E') == uint16_t { 2 });
+    CHECK(rowColumnDiacriticValue(U'\U0001D244') == uint16_t { 296 });
+    // U+0300 is a combining character the protocol deliberately EXCLUDED (it has precomposed forms);
+    // counting it would shift every value after it.
+    CHECK_FALSE(rowColumnDiacriticValue(U'\u0300').has_value());
+    CHECK_FALSE(rowColumnDiacriticValue(U'a').has_value());
+}
+
