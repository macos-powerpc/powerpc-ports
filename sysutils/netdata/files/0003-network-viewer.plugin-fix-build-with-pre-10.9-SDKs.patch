network-viewer.plugin is now built on macOS (it was Linux-only in 2.10.x) and fails with
pre-10.9 SDKs:
- netinet/tcp_var.h and netinet/udp_var.h are not self-contained there and need
  sys/socketvar.h, netinet/ip_var.h and netinet/udp.h first;
- struct udpstat has udps_nosum only from the 10.9 SDK on (#ifndef __APPLE__ before).
network-viewer-topology.c includes both headers on macOS without using them.

--- src/collectors/network-viewer.plugin/network-viewer.c
+++ src/collectors/network-viewer.plugin/network-viewer.c
@@ -28,6 +28,12 @@
 // BSD kernel protocol counters for the network-protocols Function: struct
 // tcpstat / struct udpstat and the sysctl(3) API reading net.inet.*.stats.
 #include <sys/sysctl.h>
+#if defined(OS_MACOS)
+#include <AvailabilityMacros.h>
+#include <sys/socketvar.h>
+#include <netinet/ip_var.h>
+#include <netinet/udp.h>
+#endif
 #include <netinet/tcp_var.h>
 #include <netinet/udp_var.h>
 #endif
@@ -1558,8 +1564,10 @@
     uint64_t udp_errors     = first ? 0 : (
                                   UDP_DELTA(udps_hdrops) +
                                   UDP_DELTA(udps_badlen) +
-                                  UDP_DELTA(udps_badsum) +
-                                  UDP_DELTA(udps_nosum));
+#if !defined(OS_MACOS) || MAC_OS_X_VERSION_MAX_ALLOWED >= 1090
+                                  UDP_DELTA(udps_nosum) +
+#endif
+                                  UDP_DELTA(udps_badsum));
     uint64_t udp_no_port    = first ? 0 : UDP_DELTA(udps_noport);
 
 #undef TCP_DELTA
--- src/collectors/network-viewer.plugin/network-viewer-topology.c
+++ src/collectors/network-viewer.plugin/network-viewer-topology.c
@@ -721,8 +721,6 @@
 }
 #elif defined(OS_MACOS)
 #include <libproc.h>
-#include <netinet/tcp_var.h>
-#include <netinet/udp_var.h>
 #include <sys/proc_info.h>
 #include <sys/sysctl.h>
 
