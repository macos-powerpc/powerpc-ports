Old inttypes.h (e.g. 10.6 SDK) only exposes PRI*/SCN* to C++ when
__STDC_FORMAT_MACROS is defined before the first inclusion.
Rebased for 2.12.2: <inttypes.h> moved from common.h to libnetdata-base.h
and libnetdata-types.h.

--- src/libnetdata/libnetdata-base.h
+++ src/libnetdata/libnetdata-base.h
@@ -7,6 +7,9 @@
 #include <stdbool.h>
 #include <stddef.h>
 #if defined(HAVE_INTTYPES_H)
+#ifndef __STDC_FORMAT_MACROS
+#define __STDC_FORMAT_MACROS
+#endif
 #include <inttypes.h>
 #elif defined(HAVE_STDINT_H)
 #include <stdint.h>
--- src/libnetdata/libnetdata-types.h
+++ src/libnetdata/libnetdata-types.h
@@ -6,6 +6,9 @@
 #include "config.h"
 
 #if defined(HAVE_INTTYPES_H)
+#ifndef __STDC_FORMAT_MACROS
+#define __STDC_FORMAT_MACROS
+#endif
 #include <inttypes.h>
 #elif defined(HAVE_STDINT_H)
 #include <stdint.h>
