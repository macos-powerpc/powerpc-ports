powermetrics(1) exists only on 10.9 and later. Without it, the collector thread
kept re-probing four samplers via ndsudo every minute for the life of netdata.
Disable the module once if the binary that would be run is absent.

--- src/collectors/macos.plugin/macos_powermetrics.c
+++ src/collectors/macos.plugin/macos_powermetrics.c
@@ -943,6 +943,14 @@
     } else
         snprintfz(pm.command, sizeof(pm.command), "%s", command && *command ? command : MACOS_POWERMETRICS_DEFAULT_COMMAND);
 
+    const char *binary = pm.use_ndsudo ? MACOS_POWERMETRICS_DEFAULT_COMMAND : pm.command;
+    if (*binary == '/' && access(binary, X_OK) != 0) {
+        pm.failed_permanently = true;
+        pm.initialized = true;
+        collector_info("MACOS: %s is not available; powermetrics collection is disabled", binary);
+        return;
+    }
+
     pm.thread = nd_thread_create("MACPWRMET", NETDATA_THREAD_OPTION_DEFAULT, macos_powermetrics_thread, NULL);
     if (!pm.thread) {
         pm.failed_permanently = true;
