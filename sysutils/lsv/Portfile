# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           legacysupport 1.1

# clock_gettime
legacysupport.newest_darwin_requires_legacy 15

github.setup        mike-ward lsv 2025.3
revision            0
categories          sysutils
license             MIT
maintainers         nomaintainer

description         ls file lister in the spirit of eza, exa, lsd and natls
long_description    {*}${description}. ${name} lists directory contents with \
                    colours, icons, tree view, natural sort order and a wide \
                    range of formatting options. It is written in the V \
                    programming language.

checksums           rmd160  bf740085785bc365832ef9d5d749e295b68e9b69 \
                    sha256  fde546522a9d851a14036fc5741fdcc6704c605c4a978dfec3803aa6c031962f \
                    size    422299
github.tarball_from archive

installs_libs       no

depends_build-append \
                    port:vlang
depends_lib-append  port:boehmgc

compiler.blacklist-append \
                    *gcc-4.*

if {${configure.build_arch} in [list ppc ppc64]} {
    configure.ldflags-append -latomic
}

use_configure       no

# Keep everything V writes inside the work directory: by default it would use
# the build user's home directory for its caches and temporaries.
build.env-append    HOME=${workpath} \
                    VMODULES=${workpath}/.vmodules \
                    VTMP=${workpath}/.vtmp

build.cmd           ${prefix}/bin/v
build.target
build.args          -prod \
                    -show-c-output \
                    -cc ${configure.cc} \
                    -cflags [shellescape ${configure.cflags}] \
                    -ldflags [shellescape ${configure.ldflags}] \
                    -o ${workpath}/${name} \
                    ${worksrcpath}/${name}

test.run            yes
test.env-append     HOME=${workpath} \
                    VMODULES=${workpath}/.vmodules \
                    VTMP=${workpath}/.vtmp
test.cmd            ${prefix}/bin/v
test.target
test.args           -cc ${configure.cc} test ${worksrcpath}/${name}

destroot {
    xinstall -m 0755 ${workpath}/${name} ${destroot}${prefix}/bin/${name}

    set docdir ${prefix}/share/doc/${name}
    xinstall -d ${destroot}${docdir}
    xinstall -m 0644 -W ${worksrcpath} CHANGELOG.md LICENSE README.md \
        ${destroot}${docdir}
}
