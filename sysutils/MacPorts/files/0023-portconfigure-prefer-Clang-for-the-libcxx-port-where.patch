From a831ed526962fca5fa9a156c5fafc98402f98f2c Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 30 Oct 2026 17:01:50 +0000
Subject: [PATCH] portconfigure: prefer Clang for the libcxx port where the
 OS has libc++

GCC came first in the fallback list whenever Clang would use the libcxx
port, e.g. for C++23 before macOS 15. Base picks one compiler for all
languages, so GCC also compiled Objective-C and Objective-C++, and it
cannot parse the Cocoa headers of recent SDKs (blocks and other Clang
extensions).

Keep GCC first for the libcxx port only before Mac OS X 10.7, which has
no libc++ and whose SDK GCC handles. From 10.7 on, Clang 21 or newer
with the headers of the libcxx port comes first, and GCC stays the
fallback; ports that need GCC there can blacklist the Clang compilers.
This needs a clang_compilers.tcl that offers Clang 21 or newer on the
OS; otherwise GCC is still chosen.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/port1.0/portconfigure.tcl | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/port1.0/portconfigure.tcl b/src/port1.0/portconfigure.tcl
index 446207de1..c423e3b3c 100644
--- a/src/port1.0/portconfigure.tcl
+++ b/src/port1.0/portconfigure.tcl
@@ -1468,7 +1468,7 @@ proc compiler.command_line_tools_version {compiler} {
 }
 # internal function to choose compiler fallback list based on platform
 proc portconfigure::get_compiler_fallback {} {
-    global default_compilers xcodeversion os.subplatform \
+    global default_compilers xcodeversion os.major os.subplatform \
            configure.build_arch compiler.mpi
 
     # Check our override
@@ -1523,13 +1523,15 @@ proc portconfigure::get_compiler_fallback {} {
     set compilers [list]
     lappend compilers {*}${system_compilers}
     # when building for PowerPC architectures, prefer GCC to Clang; also when
-    # libc++ has to come from the libcxx port, which GCC is set up for
+    # libc++ has to come from the libcxx port on systems without one (later
+    # SDKs need Clang for Objective-C)
     set cur_arch ${configure.build_arch}
     if {$cur_arch eq ""} {
         global build_arch
         set cur_arch ${build_arch}
     }
-    if {$cur_arch in {ppc ppc64} || [portconfigure::libcxx_port_wanted]} {
+    if {$cur_arch in {ppc ppc64}
+            || (${os.major} < 11 && [portconfigure::libcxx_port_wanted])} {
         lappend compilers {*}${gcc_compilers}
         lappend compilers {*}${clang_compilers}
     } else {
