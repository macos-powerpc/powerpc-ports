From 235f106270b26f13a7b1cdf175dd00ef88b16188 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Fri, 30 Oct 2026 18:04:43 +0000
Subject: [PATCH] portconfigure: ignore the compiler lists of the MacPorts
 ports tree

clang_compilers.tcl, gcc_compilers.tcl and gcc_dependencies.tcl came from
the port's own tree, else from the default source. Where the MacPorts
ports tree is the default source, e.g. on a recent Mac that uses the
PPCPorts tree next to it, its lists were used: they offer no Clang newer
than 17 before macOS 13, which leaves only GCC for ports that need the
libcxx port, and they take GCC 14 as the main runtime.

Look the files up in the port's own tree and then in the trees of
sources.conf in order, as for PortGroups, but skip the MacPorts ports
tree and its mirrors (sources on macports.org or github.com/macports),
and fall back to the built-in lists. A local clone of the MacPorts ports
tree is not recognised.

- gcc_compilers.tcl is read again; 6e4569a6d had disabled the lookup to
  keep the MacPorts list out.
- The built-in Clang list now matches clang_compilers.tcl of
  powerpc-ports: Clang 18 to 22 from Darwin 16, depending on
  compiler.cxx_standard, and none for PowerPC builds. This also drops
  a bogus "compilers" entry.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/macports1.0/macports.tcl  | 51 ++++++++++++++++++++++++
 src/port1.0/portconfigure.tcl | 73 ++++++++++++++++++++---------------
 2 files changed, 93 insertions(+), 31 deletions(-)

diff --git a/src/macports1.0/macports.tcl b/src/macports1.0/macports.tcl
index 8a46df34b..cca84186f 100644
--- a/src/macports1.0/macports.tcl
+++ b/src/macports1.0/macports.tcl
@@ -2082,6 +2082,7 @@ proc macports::worker_init {workername portpath porturl portbuildpath options va
     $workername alias getportresourcepath macports::getportresourcepath
     $workername alias getportlogpath macports::getportlogpath
     $workername alias getdefaultportresourcepath macports::getdefaultportresourcepath
+    $workername alias getportcompilerspath macports::getportcompilerspath
     $workername alias getlocalporttreelist macports::getlocalporttreelist
     $workername alias getlocaltreeoptions macports::getlocaltreeoptions
     $workername alias getallporttrees macports::getallporttrees
@@ -2502,6 +2503,56 @@ proc macports::getdefaultportresourcepath {{path {}}} {
     return $proposedpath
 }
 
+##
+# Whether a source URL is the MacPorts ports tree or one of its mirrors
+#
+# @param url source URL
+# @return 1 if it is, 0 otherwise
+proc macports::is_macports_source {url} {
+    return [regexp -nocase {^[a-z]+://([^/]*\.)?macports\.org(:[0-9]+)?/|^[a-z]+://(www\.)?github\.com/macports/} $url]
+}
+
+##
+# Get the path to a file in _resources/port1.0/compilers, from the port's
+# own tree or else the first tree in sources.conf that has it. The trees of
+# the MacPorts ports tree and its mirrors are skipped, since their compiler
+# lists are made for the base of MacPorts.
+#
+# @param url port URL
+# @param name file name
+# @return path to the file, or an empty string if no tree has it
+proc macports::getportcompilerspath {url name} {
+    variable sources
+
+    set macports_trees [list]
+    set trees [list]
+    foreach source $sources {
+        set source_url [lindex $source 0]
+        if {[getprotocol $source_url] eq "file"} {
+            set tree [getportdir $source_url]
+        } else {
+            set tree [file normalize [getsourcepath $source_url]]
+        }
+        if {[is_macports_source $source_url]} {
+            lappend macports_trees $tree
+        } else {
+            lappend trees $tree
+        }
+    }
+    set own_tree [file normalize [file dirname [getportresourcepath $url {} no]]]
+    if {$own_tree ni $macports_trees} {
+        set trees [linsert $trees 0 $own_tree]
+    }
+
+    foreach tree $trees {
+        set path [file join $tree _resources port1.0 compilers $name]
+        if {[file exists $path]} {
+            return $path
+        }
+    }
+    return {}
+}
+
 ##
 # @return the list of local port trees
 #
