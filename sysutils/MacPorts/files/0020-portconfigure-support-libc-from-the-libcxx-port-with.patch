From 3375f5b39ad568cdf27b0a8b35aa295a1ef1ffcd Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 01:04:39 +0000
Subject: [PATCH 20/20] portconfigure: support libc++ from the libcxx port with
 GCC

When a MacPorts GCC is the C++ compiler and configure.cxx_stdlib is
libc++:

- pass -stdlib=libc++ also for ppc and ppc64 builds (libstdc++ ones
  are unchanged);
- prepend -L${prefix}/libexec/libcxx/lib to configure.ldflags, via
  a trace so that it follows the final compiler and stdlib;
- do not exclude GCC from the compiler fallbacks, but require at least
  a C++11-capable version;
- add depends_build on gccN-libcxx, which provides the headers in the
  location GCC was configured with. GCC cannot depend on it itself,
  since libcxx is built with GCC.

-D_GLIBCXX_USE_CXX11_ABI=0 remains limited to macports-libstdc++.

Assisted-By: Claude Opus 5.5 (1M context)
---
 src/port1.0/portconfigure.tcl | 59 +++++++++++++++++++++++++----------
 1 file changed, 42 insertions(+), 17 deletions(-)

diff --git a/src/port1.0/portconfigure.tcl b/src/port1.0/portconfigure.tcl
index 76f222f25..0956c1a7d 100644
--- a/src/port1.0/portconfigure.tcl
+++ b/src/port1.0/portconfigure.tcl
@@ -77,6 +77,14 @@ default configure.universal_objcxxflags {${configure.universal_cxxflags}}
 option_proc configure.cxxflags portconfigure::stdlib_trace
 option_proc configure.objcxxflags portconfigure::stdlib_trace
 
+# GCC used with libc++ from the libcxx port
+proc portconfigure::gcc_with_libcxx {} {
+    global configure.cxx configure.cxx_stdlib
+    # *g*-mp-* alone would also match clang++-mp-*
+    return [expr {${configure.cxx_stdlib} eq "libc++"
+                  && [string match *g*-mp-* ${configure.cxx}]
+                  && ![string match *clang* ${configure.cxx}]}]
+}
 proc portconfigure::should_add_stdlib {} {
     global configure.cxx configure.cxx_stdlib
     if {${configure.cxx_stdlib} eq ""} {
@@ -86,10 +94,10 @@ proc portconfigure::should_add_stdlib {} {
         return 1
     }
     # GCC also supports -stdlib starting with GCC 10 (and devel), but
-    # not with PPC builds
+    # PPC builds only need -stdlib=libc++ (-stdlib=libstdc++ is implicit default).
     global configure.build_arch
     if {[string match *g*-mp-* ${configure.cxx}]
-            && ${configure.build_arch} ni {ppc ppc64}} {
+            && (${configure.build_arch} ni {ppc ppc64} || [portconfigure::gcc_with_libcxx])} {
         # Do not pass stdlib to gcc if it is MacPorts custom macports-libstdc++ setting
         # as gcc does not uderstand this. Instead do nothing, which means gcc will
         # default to using its own libstdc++, which is in fact what we mean by
@@ -274,9 +282,27 @@ default configure.ldflags       {[portconfigure::configure_get_ldflags]}
 proc portconfigure::configure_get_ldflags {} {
     global prefix compiler.limit_flags
     if {${compiler.limit_flags}} {
-        return -Wl,-headerpad_max_install_names
+        set flags -Wl,-headerpad_max_install_names
     } else {
-        return "-L${prefix}/lib -Wl,-headerpad_max_install_names"
+        set flags "-L${prefix}/lib -Wl,-headerpad_max_install_names"
+    }
+    # GCC finds the libc++ headers on its own, but not the libraries of the
+    # libcxx port. Put them first, so that no other libc++ can shadow them.
+    if {[portconfigure::gcc_with_libcxx]} {
+        set flags [linsert $flags 0 -L${prefix}/libexec/libcxx/lib]
+    }
+    return $flags
+}
+# While the default above is in place, it is recomputed after this trace
+# runs (traces fire newest first), so this only matters once a Portfile has
+# changed configure.ldflags.
+option_proc configure.ldflags portconfigure::libcxx_ldflags_trace
+proc portconfigure::libcxx_ldflags_trace {opt action args} {
+    global $opt prefix
+    set libcxx_ldflag -L${prefix}/libexec/libcxx/lib
+    $opt-delete $libcxx_ldflag
+    if {$action eq "read" && [portconfigure::gcc_with_libcxx]} {
+        $opt-prepend $libcxx_ldflag
     }
 }
 default configure.libs          {}
@@ -1055,18 +1081,10 @@ proc portconfigure::get_min_clang {} {
 }
 # utility procedure: get minimum GCC version based on restrictions
 proc portconfigure::get_min_gcc {} {
-    global configure.cxx_stdlib
-
-    # Technically these only support macports-libstdc++, but if all the
-    # options that use the system libstdc++ have been blacklisted, we
-    # still need to use something. So only skip them entirely when
-    # using libc++.
-    if {${configure.cxx_stdlib} eq "libc++"} {
-        return none
-    }
-
-    global compiler.c_standard compiler.cxx_standard compiler.openmp_version \
-           compiler.thread_local_storage compiler.limit_flags \
+    # GCC can use libc++ from the libcxx port (with -stdlib=libc++), which
+    # requires at least C++11.
+    global configure.cxx_stdlib compiler.c_standard compiler.cxx_standard \
+           compiler.openmp_version compiler.thread_local_storage compiler.limit_flags \
            compiler.support_environment_sdkroot configure.sdkroot
 
     set min_value 1.0
@@ -1083,7 +1101,7 @@ proc portconfigure::get_min_gcc {} {
         set min_value [max_version $min_value 7]
     } elseif {${compiler.cxx_standard} >= 2014} {
         set min_value [max_version $min_value 5]
-    } elseif {${compiler.cxx_standard} >= 2011} {
+    } elseif {${compiler.cxx_standard} >= 2011 || ${configure.cxx_stdlib} eq "libc++"} {
         set min_value [max_version $min_value 4.8]
     }
     if {[vercmp ${compiler.openmp_version} 4.5] >= 0} {
@@ -1712,6 +1730,7 @@ proc portconfigure::add_compiler_port_dependencies {compiler} {
 
         # add C++ runtime dependency if necessary
         if {[regexp {^macports-gcc-(\d+(?:\.\d+)?)?$} ${compiler} -> gcc_version]} {
+            global configure.cxx_stdlib
             set libgccs [list]
             set dependencies_file [getportresourcepath $porturl "port1.0/compilers/gcc_dependencies.tcl"]
             if {[file exists ${dependencies_file}]} {
@@ -1747,6 +1766,12 @@ proc portconfigure::add_compiler_port_dependencies {compiler} {
                 ui_debug "Adding depends_lib libcxx"
                 depends_lib-delete "port:libcxx"
                 depends_lib-append "port:libcxx"
+                # GCC looks for the libc++ headers in a location of its own,
+                # provided by a subport (GCC cannot depend on it, since libcxx
+                # is built with GCC)
+                ui_debug "Adding depends_build port:gcc${gcc_version}-libcxx"
+                depends_build-delete "port:gcc${gcc_version}-libcxx"
+                depends_build-append "port:gcc${gcc_version}-libcxx"
             }
         } elseif {[regexp {^macports-clang(?:-(\d+(?:\.\d+)?))$} $compiler -> clang_version]} {
             global configure.cxx_stdlib compiler.openmp_version
-- 
2.55.0

