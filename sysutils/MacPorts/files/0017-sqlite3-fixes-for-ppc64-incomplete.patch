From 396bc476c1886ae0b76d3320943f1980364161c3 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <vital.had@gmail.com>
Date: Tue, 27 Oct 2026 07:57:26 +0800
Subject: [PATCH 17/20] sqlite3: fixes for ppc64, incomplete

---
 vendor/tcl8.6.17/pkgs/sqlite3.50.4/compat/sqlite3/shell.c | 2 +-
 vendor/tcl8.6.17/pkgs/sqlite3.50.4/generic/tclsqlite3.c   | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/vendor/tcl8.6.17/pkgs/sqlite3.50.4/compat/sqlite3/shell.c b/vendor/tcl8.6.17/pkgs/sqlite3.50.4/compat/sqlite3/shell.c
index e0b3a795b..2f832ae09 100644
--- a/vendor/tcl8.6.17/pkgs/sqlite3.50.4/compat/sqlite3/shell.c
+++ b/vendor/tcl8.6.17/pkgs/sqlite3.50.4/compat/sqlite3/shell.c
@@ -2425,7 +2425,7 @@ SQLITE_EXTENSION_INIT1
      defined(_M_AMD64) || defined(_M_ARM)     || defined(__x86)   ||    \
      defined(__arm__)
 #   define SHA3_BYTEORDER    1234
-# elif defined(sparc)    || defined(__ppc__)
+# elif defined(sparc)    || defined(__POWERPC__)
 #   define SHA3_BYTEORDER    4321
 # else
 #   define SHA3_BYTEORDER 0
diff --git a/vendor/tcl8.6.17/pkgs/sqlite3.50.4/generic/tclsqlite3.c b/vendor/tcl8.6.17/pkgs/sqlite3.50.4/generic/tclsqlite3.c
index f368c40d9..462f067b1 100644
--- a/vendor/tcl8.6.17/pkgs/sqlite3.50.4/generic/tclsqlite3.c
+++ b/vendor/tcl8.6.17/pkgs/sqlite3.50.4/generic/tclsqlite3.c
@@ -79,7 +79,7 @@
 #     define SQLITE_PTRSIZE __SIZEOF_POINTER__
 #   elif defined(i386)     || defined(__i386__)   || defined(_M_IX86) ||    \
          defined(_M_ARM)   || defined(__arm__)    || defined(__x86)   ||    \
-        (defined(__APPLE__) && defined(__POWERPC__)) ||                     \
+        (defined(__APPLE__) && defined(__ppc__)) ||                         \
         (defined(__TOS_AIX__) && !defined(__64BIT__))
 #     define SQLITE_PTRSIZE 4
 #   else
-- 
2.55.0

