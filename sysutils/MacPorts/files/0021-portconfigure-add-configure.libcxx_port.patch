From 9d729d8793c8fce577d3b22e642cd0b2571713df Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Tue, 27 Oct 2026 09:51:40 +0000
Subject: [PATCH] portconfigure: add configure.libcxx_port

Use libc++ from the libcxx port (${prefix}/libexec/libcxx) instead of
the one of the OS: yes, no or auto (the default).

- auto: always with MacPorts GCC and libc++, as before (libc++ has no
  availability markup for GCC, so its headers assume a dylib as new as
  they are); with Clang when the OS has no libc++ (before 10.7) or
  compiler.cxx_standard is 2023 or later before macOS 15.
- Clang gets -stdlib++-isystem${prefix}/libexec/libcxx/include/c++/v1,
  which replaces only the C++ library include path and is kept in
  configure.cxxflags like -stdlib, and the -L of the libraries (libc++
  re-exports libc++abi, so -lc++ is enough).
- When Clang would use the libcxx port, prefer GCC to Clang, require
  Clang 21 (supported by libc++ 23) and exclude Xcode clang.
- port:libcxx follows the C++ compiler; it and gccN-libcxx are no
  longer added when GCC is only the Fortran compiler.
- C++23 gets its own minimum versions (GCC 13, Clang 17, Xcode clang
  1600), and GCC with libc++ requires GCC 10 (-stdlib).

Assisted-By: Claude Opus 5.5 (1M context)
---
 src/port1.0/portconfigure.tcl | 133 +++++++++++++++++++++++++---------
 1 file changed, 99 insertions(+), 34 deletions(-)

diff --git a/src/port1.0/portconfigure.tcl b/src/port1.0/portconfigure.tcl
index 0956c1a7d..2abc11011 100644
--- a/src/port1.0/portconfigure.tcl
+++ b/src/port1.0/portconfigure.tcl
@@ -54,6 +54,7 @@ options configure.cxx \
         configure.cxx_archflags \
         configure.cxx_stdlib \
         configure.cxxflags \
+        configure.libcxx_port \
         configure.objcxx \
         configure.objcxx_archflags \
         configure.objcxxflags \
@@ -65,6 +66,10 @@ default configure.cxx_archflags         {[portconfigure::configure_get_archflags
 default configure.cxx_stdlib            {[portconfigure::configure_get_cxx_stdlib]}
 default configure.cxxflags \
         {[portconfigure::construct_cxxflags ${configure.optflags}]}
+# Use libc++ from the libcxx port instead of the one of the OS: yes, no or
+# auto (with GCC, and with Clang if the OS has none or one too old for
+# compiler.cxx_standard)
+default configure.libcxx_port           auto
 default configure.objcxx                {[portconfigure::configure_get_compiler objcxx]}
 default configure.objcxx_archflags      {[portconfigure::configure_get_archflags objcxx]}
 # No current reason for OBJCXXFLAGS to differ from CXXFLAGS.
@@ -77,13 +82,42 @@ default configure.universal_objcxxflags {${configure.universal_cxxflags}}
 option_proc configure.cxxflags portconfigure::stdlib_trace
 option_proc configure.objcxxflags portconfigure::stdlib_trace
 
-# GCC used with libc++ from the libcxx port
-proc portconfigure::gcc_with_libcxx {} {
-    global configure.cxx configure.cxx_stdlib
-    # *g*-mp-* alone would also match clang++-mp-*
-    return [expr {${configure.cxx_stdlib} eq "libc++"
-                  && [string match *g*-mp-* ${configure.cxx}]
-                  && ![string match *clang* ${configure.cxx}]}]
+# Whether the libc++ of the OS is missing, or too old for compiler.cxx_standard
+proc portconfigure::system_libcxx_too_old {} {
+    global os.major compiler.cxx_standard
+    # Mac OS X 10.6 and earlier have no libc++
+    if {${os.major} < 11} {
+        return 1
+    }
+    # Much of the C++23 library is missing from the libc++ of macOS 14 and
+    # earlier (LLVM 16 and earlier), in the SDK headers and in the dylib
+    return [expr {${compiler.cxx_standard} >= 2023 && ${os.major} < 24}]
+}
+# Whether Clang should use libc++ from the libcxx port
+proc portconfigure::libcxx_port_wanted {} {
+    global os.platform configure.cxx_stdlib configure.libcxx_port
+    if {${os.platform} ne "darwin" || ${configure.cxx_stdlib} ne "libc++"} {
+        return 0
+    }
+    if {${configure.libcxx_port} eq "auto"} {
+        return [portconfigure::system_libcxx_too_old]
+    }
+    return [tbool configure.libcxx_port]
+}
+# Whether configure.cxx uses libc++ from the libcxx port
+proc portconfigure::use_libcxx_port {} {
+    global configure.cxx configure.cxx_stdlib configure.libcxx_port
+    if {[string match *clang* ${configure.cxx}]} {
+        return [portconfigure::libcxx_port_wanted]
+    }
+    # libc++ has no availability markup for GCC, so the libc++ headers of
+    # MacPorts GCC assume that the dylib has everything they declare, which
+    # only holds for the one of the libcxx port, whatever the OS version.
+    # (*g*-mp-* would also match clang++-mp-*, handled above.)
+    if {${configure.cxx_stdlib} eq "libc++" && [string match *g*-mp-* ${configure.cxx}]} {
+        return [expr {${configure.libcxx_port} eq "auto" || [tbool configure.libcxx_port]}]
+    }
+    return 0
 }
 proc portconfigure::should_add_stdlib {} {
     global configure.cxx configure.cxx_stdlib
@@ -97,7 +131,7 @@ proc portconfigure::should_add_stdlib {} {
     # PPC builds only need -stdlib=libc++ (-stdlib=libstdc++ is implicit default).
     global configure.build_arch
     if {[string match *g*-mp-* ${configure.cxx}]
-            && (${configure.build_arch} ni {ppc ppc64} || [portconfigure::gcc_with_libcxx])} {
+            && (${configure.build_arch} ni {ppc ppc64} || ${configure.cxx_stdlib} eq "libc++")} {
         # Do not pass stdlib to gcc if it is MacPorts custom macports-libstdc++ setting
         # as gcc does not uderstand this. Instead do nothing, which means gcc will
         # default to using its own libstdc++, which is in fact what we mean by
@@ -131,16 +165,27 @@ proc portconfigure::construct_cxxflags {flags} {
     if {[portconfigure::should_add_cxx_abi]} {
         lappend flags -D_GLIBCXX_USE_CXX11_ABI=0
     }
+    lappend flags {*}[portconfigure::libcxx_port_cxxflags]
     return $flags
 }
+# Clang takes the libc++ headers from the SDK (or its own); replace them with
+# those of the libcxx port. GCC is configured with them.
+proc portconfigure::libcxx_port_cxxflags {} {
+    global configure.cxx prefix
+    if {[string match *clang* ${configure.cxx}] && [portconfigure::use_libcxx_port]} {
+        return [list -stdlib++-isystem${prefix}/libexec/libcxx/include/c++/v1]
+    }
+    return {}
+}
 proc portconfigure::stdlib_trace {opt action args} {
-    global $opt
+    global $opt prefix
     foreach flag [lsearch -all -inline [set $opt] -stdlib=*] {
         $opt-delete $flag
     }
     foreach flag [lsearch -all -exact -inline [set $opt] -D_GLIBCXX_USE_CXX11_ABI=0] {
         $opt-delete $flag
     }
+    $opt-delete -stdlib++-isystem${prefix}/libexec/libcxx/include/c++/v1
     if {$action eq "read"} {
         if {[portconfigure::should_add_stdlib]} {
             global configure.cxx_stdlib
@@ -149,6 +194,9 @@ proc portconfigure::stdlib_trace {opt action args} {
         if {[portconfigure::should_add_cxx_abi]} {
             $opt-append -D_GLIBCXX_USE_CXX11_ABI=0
         }
+        foreach flag [portconfigure::libcxx_port_cxxflags] {
+            $opt-append $flag
+        }
     }
 }
 # helper function to set configure.cxx_stdlib
@@ -286,9 +334,9 @@ proc portconfigure::configure_get_ldflags {} {
     } else {
         set flags "-L${prefix}/lib -Wl,-headerpad_max_install_names"
     }
-    # GCC finds the libc++ headers on its own, but not the libraries of the
-    # libcxx port. Put them first, so that no other libc++ can shadow them.
-    if {[portconfigure::gcc_with_libcxx]} {
+    # The compiler does not find the libraries of the libcxx port on its own.
+    # Put them first, so that no other libc++ can shadow them.
+    if {[portconfigure::use_libcxx_port]} {
         set flags [linsert $flags 0 -L${prefix}/libexec/libcxx/lib]
     }
     return $flags
@@ -301,7 +349,7 @@ proc portconfigure::libcxx_ldflags_trace {opt action args} {
     global $opt prefix
     set libcxx_ldflag -L${prefix}/libexec/libcxx/lib
     $opt-delete $libcxx_ldflag
-    if {$action eq "read" && [portconfigure::gcc_with_libcxx]} {
+    if {$action eq "read" && [portconfigure::use_libcxx_port]} {
         $opt-prepend $libcxx_ldflag
     }
 }
@@ -803,7 +851,8 @@ proc portconfigure::compiler_is_port {compiler} {
 # changing these options will invalidate the cache
 foreach varname {compiler.whitelist compiler.fallback compiler.blacklist
     compiler.c_standard compiler.cxx_standard compiler.openmp_version
-    compiler.mpi compiler.thread_local_storage configure.cxx_stdlib} {
+    compiler.mpi compiler.thread_local_storage configure.cxx_stdlib
+    configure.libcxx_port} {
         trace add variable $varname write portconfigure::recompute_default_compiler_proc
 }
 
@@ -989,6 +1038,11 @@ proc portconfigure::get_min_command_line {compiler} {
                 # no Xcode clang can build against libc++ on < 10.7
                 return none
             }
+            if {[portconfigure::libcxx_port_wanted]} {
+                # the libc++ of the libcxx port only supports the latest
+                # Xcode clang
+                return none
+            }
             if {(${compiler.limit_flags} || ${compiler.support_environment_sdkroot}) &&
                 ${configure.sdkroot} ne "" &&
                 !([file exists /usr/lib/libxcselect.dylib] || ${os.major} >= 20)
@@ -1000,7 +1054,9 @@ proc portconfigure::get_min_command_line {compiler} {
             } elseif {${compiler.c_standard} >= 2011} {
                 set min_value [max_version $min_value 500.2.75]
             }
-            if {${compiler.cxx_standard} >= 2020} {
+            if {${compiler.cxx_standard} >= 2023} {
+                set min_value [max_version $min_value 1600]
+            } elseif {${compiler.cxx_standard} >= 2020} {
                 set min_value [max_version $min_value 1500]
             } elseif {${compiler.cxx_standard} >= 2017} {
                 set min_value [max_version $min_value 1000.11.45.2]
@@ -1049,7 +1105,9 @@ proc portconfigure::get_min_clang {} {
     } elseif {${compiler.c_standard} >= 2011} {
         set min_value [max_version $min_value 3.1]
     }
-    if {${compiler.cxx_standard} >= 2020} {
+    if {${compiler.cxx_standard} >= 2023} {
+        set min_value [max_version $min_value 17]
+    } elseif {${compiler.cxx_standard} >= 2020} {
         set min_value [max_version $min_value 16]
     } elseif {${compiler.cxx_standard} >= 2017} {
         set min_value [max_version $min_value 5.0]
@@ -1077,12 +1135,14 @@ proc portconfigure::get_min_clang {} {
         # MacPorts patches certain versions of Clang to emulate thread-local storage
         set min_value [max_version $min_value 5.0]
     }
+    if {[portconfigure::libcxx_port_wanted]} {
+        # supported by the libc++ of the libcxx port (LLVM 23)
+        set min_value [max_version $min_value 21]
+    }
     return ${min_value}
 }
 # utility procedure: get minimum GCC version based on restrictions
 proc portconfigure::get_min_gcc {} {
-    # GCC can use libc++ from the libcxx port (with -stdlib=libc++), which
-    # requires at least C++11.
     global configure.cxx_stdlib compiler.c_standard compiler.cxx_standard \
            compiler.openmp_version compiler.thread_local_storage compiler.limit_flags \
            compiler.support_environment_sdkroot configure.sdkroot
@@ -1095,15 +1155,21 @@ proc portconfigure::get_min_gcc {} {
     } elseif {${compiler.c_standard} >= 1999} {
         set min_value [max_version $min_value 4.0]
     }
-    if {${compiler.cxx_standard} >= 2020} {
+    if {${compiler.cxx_standard} >= 2023} {
+        set min_value [max_version $min_value 13]
+    } elseif {${compiler.cxx_standard} >= 2020} {
         set min_value [max_version $min_value 12]
     } elseif {${compiler.cxx_standard} >= 2017} {
         set min_value [max_version $min_value 7]
     } elseif {${compiler.cxx_standard} >= 2014} {
         set min_value [max_version $min_value 5]
-    } elseif {${compiler.cxx_standard} >= 2011 || ${configure.cxx_stdlib} eq "libc++"} {
+    } elseif {${compiler.cxx_standard} >= 2011} {
         set min_value [max_version $min_value 4.8]
     }
+    if {${configure.cxx_stdlib} eq "libc++"} {
+        # -stdlib=libc++ (with libc++ from the libcxx port)
+        set min_value [max_version $min_value 10]
+    }
     if {[vercmp ${compiler.openmp_version} 4.5] >= 0} {
         set min_value [max_version $min_value 8]
     } elseif {[vercmp ${compiler.openmp_version} 4.0] >= 0} {
@@ -1417,13 +1483,14 @@ proc portconfigure::get_compiler_fallback {} {
     }
     set compilers [list]
     lappend compilers {*}${system_compilers}
-    # when building for PowerPC architectures, prefer GCC to Clang
+    # when building for PowerPC architectures, prefer GCC to Clang; also when
+    # libc++ has to come from the libcxx port, which GCC is set up for
     set cur_arch ${configure.build_arch}
     if {$cur_arch eq ""} {
         global build_arch
         set cur_arch ${build_arch}
     }
-    if {$cur_arch in {ppc ppc64}} {
+    if {$cur_arch in {ppc ppc64} || [portconfigure::libcxx_port_wanted]} {
         lappend compilers {*}${gcc_compilers}
         lappend compilers {*}${clang_compilers}
     } else {
@@ -1691,6 +1758,12 @@ proc portconfigure::add_automatic_compiler_dependencies {} {
         portconfigure::add_compiler_port_dependencies ${configure.compiler}
     }
 
+    if {[portconfigure::use_libcxx_port]} {
+        ui_debug "Adding depends_lib port:libcxx"
+        depends_lib-delete port:libcxx
+        depends_lib-append port:libcxx
+    }
+
     if {${compiler.require_fortran} && [portconfigure::configure_get_compiler fc ${configure.compiler}] eq ""} {
         # Fortran is required, but compiler does not provide it
         ui_debug "Adding Fortran compiler dependency"
@@ -1730,7 +1803,7 @@ proc portconfigure::add_compiler_port_dependencies {compiler} {
 
         # add C++ runtime dependency if necessary
         if {[regexp {^macports-gcc-(\d+(?:\.\d+)?)?$} ${compiler} -> gcc_version]} {
-            global configure.cxx_stdlib
+            global configure.compiler configure.cxx_stdlib
             set libgccs [list]
             set dependencies_file [getportresourcepath $porturl "port1.0/compilers/gcc_dependencies.tcl"]
             if {[file exists ${dependencies_file}]} {
@@ -1761,14 +1834,11 @@ proc portconfigure::add_compiler_port_dependencies {compiler} {
                 depends_lib-delete $libgcc_dep
                 depends_lib-append $libgcc_dep
             }
-            if {${configure.cxx_stdlib} eq "libc++"} {
-                # With GCC always use the modern libc++
-                ui_debug "Adding depends_lib libcxx"
-                depends_lib-delete "port:libcxx"
-                depends_lib-append "port:libcxx"
+            if {${compiler} eq ${configure.compiler} && ${configure.cxx_stdlib} eq "libc++"} {
                 # GCC looks for the libc++ headers in a location of its own,
                 # provided by a subport (GCC cannot depend on it, since libcxx
-                # is built with GCC)
+                # is built with GCC). port:libcxx itself is added in
+                # add_automatic_compiler_dependencies.
                 ui_debug "Adding depends_build port:gcc${gcc_version}-libcxx"
                 depends_build-delete "port:gcc${gcc_version}-libcxx"
                 depends_build-append "port:gcc${gcc_version}-libcxx"
@@ -1780,11 +1850,6 @@ proc portconfigure::add_compiler_port_dependencies {compiler} {
                 ui_debug "Adding depends_lib path:lib/libgcc/libgcc_s.1.dylib:libgcc"
                 depends_lib-delete "path:lib/libgcc/libgcc_s.1.dylib:libgcc"
                 depends_lib-append "path:lib/libgcc/libgcc_s.1.dylib:libgcc"
-            } elseif {${configure.cxx_stdlib} eq "libc++" && ${os.major} < 11} {
-                # libc++ does not exist on these systems
-                ui_debug "Adding depends_lib libcxx"
-                depends_lib-delete "port:libcxx"
-                depends_lib-append "port:libcxx"
             }
             if {${compiler.openmp_version} ne ""} {
                 ui_debug "Adding depends_lib port:libomp"
