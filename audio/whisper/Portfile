PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1

# clock_gettime
legacysupport.newest_darwin_requires_legacy 15

name                whisper
github.setup        ggerganov whisper.cpp 1.8.7 v
revision            0
categories          audio
license             MIT
maintainers         {ijams.me:nate @exprez135} \
                    openmaintainer
description         Port of OpenAI’s Whisper model in C/C++
long_description    High-performance inference of OpenAI’s Whisper automatic speech recognition \
                    (ASR) model.
# TODO: find a solution for this:
conflicts           llama.cpp
github.tarball_from archive
checksums           whisper.cpp-${version}.tar.gz \
                    rmd160  d79ff28d444df4b635fd5c819a7deefae4a41ff2 \
                    sha256  0b988ba5053cfa720f6d399f3f21885b01c4222178be435ca2272d6872717554 \
                    size    8910569

patchfiles          binary-ops-casting.diff \
                    include-missing-headers.diff \
                    whisper-add-models.diff

# Useless for our systems but harmless:
patchfiles-append   add-metal-path.diff \
                    ggml-hard-coded.diff

# https://github.com/macos-powerpc/powerpc-ports/issues/257
patchfiles-append   ggml-absolute-install-name.diff

post-patch {
    reinplace "s|__PREFIX__|${prefix}|" \
        src/whisper.cpp \
        ggml/src/ggml-metal/ggml-metal.metal \
        ggml/src/ggml-metal/ggml-metal-device.m
}

compiler.c_standard     2011
compiler.cxx_standard   2017

depends_build-append    path:bin/git:git

configure.args-append   -DGGML_BLAS=OFF \
                        -DGGML_CCACHE=OFF \
                        -DGGML_METAL=OFF \
                        -DGGML_METAL_EMBED_LIBRARY=OFF \
                        -DWHISPER_BUILD_EXAMPLES=ON \
                        -DWHISPER_BUILD_SERVER=OFF \
                        -DWHISPER_BUILD_TESTS=OFF

if {${os.platform} eq "darwin" && ${os.major} >= 15} {
    configure.args-replace \
        -DGGML_METAL=OFF -DGGML_METAL=ON \
        -DGGML_METAL_EMBED_LIBRARY=OFF -DGGML_METAL_EMBED_LIBRARY=ON
    configure.args-append \
        -DGGML_METAL_MACOSX_VERSION_MIN=${macos_version_major}
}

# TODO: still relevant?
if {[string match *gcc* ${configure.compiler}]} {
    # ggml/src/ggml-cpu/binary-ops.cpp:79:23: error: invalid conversion from 'void (*)(float*, vDSP_Stride, float*, vDSP_Stride, float*, vDSP_Stride, vDSP_Length)'
    # {aka 'void (*)(float*, long int, float*, long int, float*, long int, long unsigned int)'} to 'vDSP_fn_t' {aka 'void (*)(const float*, long int, const float*, long int, float*, long int, long unsigned int)'} [-fpermissive]
    configure.cxxflags-append \
        -fpermissive

    # ___atomic_compare_exchange_8, ___atomic_load_8
    configure.ldflags-append \
        -latomic
}

destroot {
    xinstall -d ${destroot}${prefix}/bin
}

post-destroot {
    xinstall -d ${destroot}${prefix}/share/whisper/ggml
    xinstall -d ${destroot}${prefix}/lib

    if {${os.platform} eq "darwin" && ${os.major} >= 15} {
        xinstall ${workpath}/build/bin/ggml-metal.metal ${destroot}${prefix}/share/whisper/ggml
        xinstall ${workpath}/build/bin/ggml-common.h ${destroot}${prefix}/share/whisper/ggml
    }

    # whisper/ggml/parakeet already have correct install(TARGETS ... LIBRARY)
    # rules upstream. Run the real cmake install (into a scratch stage, not
    # straight into the port's destroot, since WHISPER_BUILD_EXAMPLES=ON also
    # installs binaries and headers this port doesn't ship) instead of
    # hand-picking and renaming one build artifact per library. With
    # ggml-absolute-install-name.diff applied, every library CMake produces
    # here - whichever backends actually got built for this variant
    # selection (+blas, metal on os.major>=15, ...) - already carries
    # a correct absolute ${prefix}/lib install name and its full real-file +
    # SOVERSION-symlink + bare-symlink triad, so this is a plain copy with
    # no renaming, no version numbers to guess, and no install_name_tool.
    set stage ${workpath}/install-stage
    file delete -force ${stage}
    system "${configure.cmd} --install ${workpath}/build --prefix ${stage}"

    xinstall -m 755 ${stage}/bin/whisper-cli ${destroot}${prefix}/bin/whisper

    foreach entry [glob -nocomplain ${stage}/lib/libwhisper*.dylib ${stage}/lib/libggml*.dylib] {
        set name [file tail ${entry}]
        if {[file type ${entry}] eq "link"} {
            file link -symbolic ${destroot}${prefix}/lib/${name} [file readlink ${entry}]
        } else {
            xinstall -m 644 ${entry} ${destroot}${prefix}/lib/${name}
        }
    }
}

# Define model variants

variant tiny description {Install tiny model} {
    distfiles-append        ggml-tiny.bin:tiny
    master_sites-append     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/:tiny
    checksums-append        ggml-tiny.bin \
                            sha256  be07e048e1e599ad46341c8d2a135645097a538221678b7acdd1b1919c6e1b21 \
                            size    77691713
    post-destroot {
        xinstall -d ${destroot}${prefix}/share/whisper/models
        xinstall ${distpath}/ggml-tiny.bin ${destroot}${prefix}/share/whisper/models/tiny.bin
    }
}

