#============================================================
# Patch to bake an absolute ${prefix}/lib install name into every ggml
# shared library instead of CMake's @rpath-based default, matching how
# whisper/parakeet's libraries already come out of this same build with
# no explicit override anywhere. ggml is a nested CMake project (its own
# project() call), and something in that nested-project initialization -
# not pinned down further than that - causes it to use CMake's newer
# @rpath default even though nothing sets MACOSX_RPATH/INSTALL_NAME_DIR
# anywhere in either project. Forcing it here fixes it at the linker
# level (-install_name), rather than rewriting it after the fact with
# install_name_tool once the library is already built.
#============================================================
--- ggml/CMakeLists.txt
+++ ggml/CMakeLists.txt
@@ -1,6 +1,22 @@
 cmake_minimum_required(VERSION 3.14...3.28) # for add_link_options and implicit target directories.

 project("ggml" C CXX ASM)

+# ggml is a nested CMake project (its own project() call above), unlike
+# whisper/parakeet, which are added via add_subdirectory() straight into
+# the parent whisper.cpp project. With no MACOSX_RPATH/INSTALL_NAME_DIR set
+# anywhere in either project, targets created in this nested scope still
+# end up with CMake's @rpath-based default install name on Apple platforms
+# while targets in the parent scope do not. Force the non-@rpath, absolute
+# install name scheme explicitly here so every ggml shared library gets a
+# real ${CMAKE_INSTALL_PREFIX}/lib install name baked in by the linker
+# itself, instead of @rpath, matching the parent project's targets.
+if (APPLE)
+    set(CMAKE_MACOSX_RPATH OFF)
+    if (NOT CMAKE_INSTALL_NAME_DIR)
+        set(CMAKE_INSTALL_NAME_DIR "${CMAKE_INSTALL_PREFIX}/lib")
+    endif()
+endif()
+
 ### GGML Version
 set(GGML_VERSION_MAJOR 0)
 set(GGML_VERSION_MINOR 22)
