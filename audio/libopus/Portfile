# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem      1.0
PortGroup       muniversal 1.0

name            libopus
version         1.6.1
revision        1
conflicts       libopus-devel
categories      audio
license         BSD
maintainers     {jeremyhu @jeremyhu} openmaintainer
description     The Opus Audio Codec (IETF RFC 6716), reference implementation

long_description \
    Opus is the first state-of-the-art, fully Free and Open audio codec \
    ratified by a major standards organization. It is reportedly better \
    than all pre-existing codecs across the spectrum for voice, audio, archival \
    and real-time uses.

homepage        https://www.opus-codec.org

checksums       rmd160  0208e888f12d31bb5d2aa8acdfadc2059af63f1f \
                sha256  6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1 \
                size    10472813

if {${subport} eq ${name}} {
    master_sites    https://ftp.osuosl.org/pub/xiph/releases/opus/
    distname        opus-${version}
}

patch.pre_args-replace \
                -p0 -p1
# These assume autotools.

subport ${name}-devel {
    PortGroup       github 1.0

    github.setup    xiph opus 503d81b138d76621aae4b12786e90de48aa8db3a
    version         2026.09.11
    revision        0
    conflicts       libopus
    checksums       rmd160  7406b51842c88465609918c347bde4e13ac05e73 \
                    sha256  e34101b726c033be40e3f5a2695d086362d59069554ffd46800c38a13eade1f7 \
                    size    4957402
    github.tarball_from archive

    patchfiles-append \
                0001-Add-build-plumbing-for-PowerPC-AltiVec-intrinsics.patch \
                0002-Add-AltiVec-decode-kernels-for-PowerPC-G4-G5.patch \
                0003-celt-hoist-AltiVec-inner-prod-permute-vectors-out-of.patch \
                0004-configure-require-vec_splats-in-the-AltiVec-intrinsi.patch
}

use_autoreconf  yes
autoreconf.args -fiv

depends_build-append \
                path:bin/pkg-config:pkgconfig

# Checking how to get X86 CPU Info... configure: error:
# no supported Get CPU Info method, please disable intrinsics
# Also fails on powerpc with Xcode gcc.
compiler.blacklist-append \
                *gcc-4.* {clang < 500}

configure.args  --disable-silent-rules

platform darwin 10 {
    # See: https://trac.macports.org/ticket/64611
    if {${configure.build_arch} eq "ppc"} {
        configure.args-append   --build=powerpc-apple-darwin${os.major}
    }
}

livecheck.type  regex
livecheck.url   ${master_sites}
livecheck.regex opus-(\[\\d.\]+)${extract.suffix}
