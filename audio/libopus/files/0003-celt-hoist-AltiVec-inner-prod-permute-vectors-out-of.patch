From a356635b67fc5f30c416cb39889fe836a7041910 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 20 Sep 2026 13:36:12 +0000
Subject: [PATCH 3/4] celt: hoist AltiVec inner-prod permute vectors out of the
 loop

celt_inner_prod_altivec rebuilt both lvsl permute vectors on every
iteration, although x and y advance by whole vectors and so keep their
alignment for the length of the loop.  Compute the two permutes once
and fold the old vec_ldu helper into vec_ldu_perm, dropping the inner
loop from eight to six instructions per four elements.

The result is unchanged; re-verified against the C twin under the
check-asm build and the standalone edge harness (N = 0..96, every
pointer alignment).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 celt/ppc/celt_altivec.c | 26 +++++++++++++-------------
 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/celt/ppc/celt_altivec.c b/celt/ppc/celt_altivec.c
index 092b32c5..99dded33 100644
--- a/celt/ppc/celt_altivec.c
+++ b/celt/ppc/celt_altivec.c
@@ -61,16 +61,10 @@ static OPUS_INLINE vfloat vsplatf(float v)
 }
 
 /* Unaligned 4-float load.  There is no VSX here, so this is the classic
-   lvsl + two aligned loads + vperm.  The second load uses offset 15 (not 16)
-   so it can never touch a block past the last byte we actually want. */
-static OPUS_INLINE vfloat vec_ldu(const float *p)
-{
-   float *q = (float *)p;
-   return vec_perm(vec_ld(0, q), vec_ld(15, q), vec_lvsl(0, q));
-}
-
-/* Same, with the permute vector hoisted out of a loop.  Only valid while the
-   pointer keeps the same alignment, i.e. when it advances by whole vectors. */
+   lvsl + two aligned loads + vperm, with the permute vector hoisted out of
+   the loop: it stays valid while the pointer keeps its alignment, i.e. while
+   it advances by whole vectors.  The second load uses offset 15 (not 16) so
+   it can never touch a block past the last byte we actually want. */
 static OPUS_INLINE vfloat vec_ldu_perm(const float *p, vuchar perm)
 {
    float *q = (float *)p;
@@ -158,7 +152,7 @@ void celt_float2int16_altivec(const float * OPUS_RESTRICT in,
 opus_val32 celt_inner_prod_altivec(const opus_val16 *x, const opus_val16 *y,
       int N)
 {
-   int i;
+   int i = 0;
    float xy = 0;
    const vfloat vzero = vsplatf(0.f);
    vfloat sum = vzero;
@@ -169,8 +163,14 @@ opus_val32 celt_inner_prod_altivec(const opus_val16 *x, const opus_val16 *y,
 #endif
 
    /* Band-offset pointers, so both streams are loaded unaligned. */
-   for (i=0;i<N-3;i+=4)
-      sum = vec_madd(vec_ldu(x+i), vec_ldu(y+i), sum);
+   if (N >= 4)
+   {
+      const vuchar permx = vec_lvsl(0, (float *)x);
+      const vuchar permy = vec_lvsl(0, (float *)y);
+      for (;i<=N-4;i+=4)
+         sum = vec_madd(vec_ldu_perm(x+i, permx), vec_ldu_perm(y+i, permy),
+                        sum);
+   }
 
    /* Horizontal sum, kept out of the loop: the G5 moves vector lanes to the
       scalar side through memory. */
