From 459f3a936f5c016cb9839cc5ea6c4896eccd4025 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Sun, 20 Sep 2026 08:30:34 +0000
Subject: [PATCH 1/4] Add build plumbing for PowerPC AltiVec intrinsics

Adds a [powerpc*|ppc*] case to the configure intrinsics probe, guarded by
AC_C_BIGENDIAN so little-endian PowerPC keeps the C path.  The probe tries
PPC_ALTIVEC_CFLAGS (default "-maltivec -mabi=altivec") and falls back to
Xcode GCC's "-faltivec" spelling.

There is no run-time CPU detection: every G4/G5 has AltiVec, so a successful
probe defines both OPUS_PPC_MAY_HAVE_ALTIVEC and OPUS_PPC_PRESUME_ALTIVEC and
configure warns that the binary then requires a G4 or newer.  OPUS_ARCHMASK
stays 0 and opus_select_arch() is untouched.

Note that -mcpu=7450 / -mcpu=970 already enable AltiVec, so on those builds
the probe succeeds with no extra flags and OPUS_PPC_ALTIVEC_CFLAGS stays
empty; only the kernel object ever gets the flag, never the global CFLAGS.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 Makefile.am     |  9 ++++++
 celt_headers.mk |  1 +
 celt_sources.mk |  3 ++
 configure.ac    | 77 +++++++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 90 insertions(+)

diff --git a/Makefile.am b/Makefile.am
index d05630d0..9dfd4fa6 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -116,6 +116,10 @@ BUILT_SOURCES = $(CELT_SOURCES_ARM_ASM:.s=-gnu.S) \
 endif
 endif
 
+if HAVE_ALTIVEC
+CELT_SOURCES += $(CELT_SOURCES_ALTIVEC)
+endif
+
 CLEANFILES = $(CELT_SOURCES_ARM_ASM:.s=-gnu.S) \
  $(CELT_AM_SOURCES_ARM_ASM:.s.in=-gnu.S)
 
@@ -521,3 +525,8 @@ if HAVE_ARM_DOTPROD
 ARM_DOTPROD_OBJ = $(DNN_SOURCES_DOTPROD:.c=.lo)
 $(ARM_DOTPROD_OBJ): CFLAGS += $(ARM_DOTPROD_INTR_CFLAGS)
 endif
+
+if HAVE_ALTIVEC
+ALTIVEC_OBJ = $(CELT_SOURCES_ALTIVEC:.c=.lo)
+$(ALTIVEC_OBJ): CFLAGS += $(OPUS_PPC_ALTIVEC_CFLAGS)
+endif
diff --git a/celt_headers.mk b/celt_headers.mk
index a25470b9..7e0b92cd 100644
--- a/celt_headers.mk
+++ b/celt_headers.mk
@@ -48,6 +48,7 @@ celt/mips/fixed_generic_mipsr1.h \
 celt/mips/kiss_fft_mipsr1.h \
 celt/mips/mdct_mipsr1.h \
 celt/mips/pitch_mipsr1.h \
+celt/ppc/celt_altivec.h \
 celt/x86/pitch_sse.h \
 celt/x86/vq_sse.h \
 celt/x86/x86_arch_macros.h \
diff --git a/celt_sources.mk b/celt_sources.mk
index a12614bf..83129d39 100644
--- a/celt_sources.mk
+++ b/celt_sources.mk
@@ -54,3 +54,6 @@ celt/arm/celt_neon_aarch64.S \
 celt/arm/celt_mdct_tx.c \
 celt/arm/celt_tx_neon.S \
 celt/arm/pitch_neon_intr.c
+
+CELT_SOURCES_ALTIVEC = \
+celt/ppc/celt_altivec.c
diff --git a/configure.ac b/configure.ac
index e526d250..69e2e708 100644
--- a/configure.ac
+++ b/configure.ac
@@ -429,6 +429,7 @@ m4_define([DEFAULT_X86_SSE2_CFLAGS], [-msse2])
 m4_define([DEFAULT_X86_SSE4_1_CFLAGS], [-msse4.1])
 m4_define([DEFAULT_X86_AVX2_CFLAGS], [-mavx -mfma -mavx2])
 m4_define([DEFAULT_ARM_NEON_INTR_CFLAGS], [-mfpu=neon])
+m4_define([DEFAULT_PPC_ALTIVEC_CFLAGS], [-maltivec -mabi=altivec])
 m4_define([DEFAULT_ARM_DOTPROD_INTR_CFLAGS], ["-march=armv8.2-a+dotprod"])
 # With GCC on ARM32 softfp architectures (e.g. Android, or older Ubuntu) you need to specify
 # -mfloat-abi=softfp for -mfpu=neon to work.  However, on ARM32 hardfp architectures (e.g. newer Ubuntu),
@@ -448,6 +449,7 @@ AC_ARG_VAR([X86_SSE4_1_CFLAGS], [C compiler flags to compile SSE4.1 intrinsics @
 AC_ARG_VAR([X86_AVX2_CFLAGS], [C compiler flags to compile AVX2 intrinsics @<:@default=]DEFAULT_X86_AVX2_CFLAGS[@:>@])
 AC_ARG_VAR([ARM_NEON_INTR_CFLAGS], [C compiler flags to compile ARM NEON intrinsics @<:@default=]DEFAULT_ARM_NEON_INTR_CFLAGS / DEFAULT_ARM_NEON_SOFTFP_INTR_CFLAGS[@:>@])
 AC_ARG_VAR([ARM_DOTPROD_INTR_CFLAGS], [C compiler flags to compile ARM DOTPROD intrinsics @<:@default=]DEFAULT_ARM_DOTPROD_INTR_CFLAGS[@:>@])
+AC_ARG_VAR([PPC_ALTIVEC_CFLAGS], [C compiler flags to compile PowerPC AltiVec intrinsics @<:@default=]DEFAULT_PPC_ALTIVEC_CFLAGS[@:>@])
 
 AS_VAR_SET_IF([X86_SSE_CFLAGS], [], [AS_VAR_SET([X86_SSE_CFLAGS], "DEFAULT_X86_SSE_CFLAGS")])
 AS_VAR_SET_IF([X86_SSE2_CFLAGS], [], [AS_VAR_SET([X86_SSE2_CFLAGS], "DEFAULT_X86_SSE2_CFLAGS")])
@@ -455,6 +457,7 @@ AS_VAR_SET_IF([X86_SSE4_1_CFLAGS], [], [AS_VAR_SET([X86_SSE4_1_CFLAGS], "DEFAULT
 AS_VAR_SET_IF([X86_AVX2_CFLAGS], [], [AS_VAR_SET([X86_AVX2_CFLAGS], "DEFAULT_X86_AVX2_CFLAGS")])
 AS_VAR_SET_IF([ARM_NEON_INTR_CFLAGS], [], [AS_VAR_SET([ARM_NEON_INTR_CFLAGS], ["$RESOLVED_DEFAULT_ARM_NEON_INTR_CFLAGS"])])
 AS_VAR_SET_IF([ARM_DOTPROD_INTR_CFLAGS], [], [AS_VAR_SET([ARM_DOTPROD_INTR_CFLAGS], ["DEFAULT_ARM_DOTPROD_INTR_CFLAGS"])])
+AS_VAR_SET_IF([PPC_ALTIVEC_CFLAGS], [], [AS_VAR_SET([PPC_ALTIVEC_CFLAGS], ["DEFAULT_PPC_ALTIVEC_CFLAGS"])])
 
 
 AS_IF([test x"$enable_intrinsics" = x"yes"],[
@@ -770,6 +773,78 @@ AS_IF([test x"$enable_intrinsics" = x"yes"],[
                  AC_DEFINE([CPU_INFO_BY_C], [1], [Get CPU Info by c method])],
             [AC_MSG_ERROR([no supported Get CPU Info method, please disable run-time CPU capabilities detection or intrinsics])])])])
    ],
+   [powerpc*|ppc*],
+   [
+      dnl Compile-time-only AltiVec: every G4/G5 has it, so there is no
+      dnl run-time detection.  Little-endian PowerPC keeps the C path.
+      AC_C_BIGENDIAN(
+      [
+         OPUS_CHECK_INTRINSICS(
+            [AltiVec],
+            [$PPC_ALTIVEC_CFLAGS],
+            [OPUS_PPC_MAY_HAVE_ALTIVEC],
+            [OPUS_PPC_ALTIVEC_BYDEFAULT],
+            [[#include <altivec.h>
+            ]],
+            [[
+               static __vector float A0, A1;
+               __vector float SUMM;
+               float res[[4]] __attribute__((aligned(16)));
+               SUMM = vec_madd(A0, A1, A0);
+               vec_st(SUMM, 0, res);
+               return (int)res[[0]];
+            ]]
+         )
+         dnl Xcode's GCC spells the flag differently.
+         AS_IF([test x"$OPUS_PPC_MAY_HAVE_ALTIVEC" != x"1"],
+         [
+            AS_VAR_SET([PPC_ALTIVEC_CFLAGS], ["-faltivec"])
+            OPUS_CHECK_INTRINSICS(
+               [AltiVec],
+               [$PPC_ALTIVEC_CFLAGS],
+               [OPUS_PPC_MAY_HAVE_ALTIVEC],
+               [OPUS_PPC_ALTIVEC_BYDEFAULT],
+               [[#include <altivec.h>
+               ]],
+               [[
+                  static __vector float A0, A1;
+                  __vector float SUMM;
+                  float res[[4]] __attribute__((aligned(16)));
+                  SUMM = vec_madd(A0, A1, A0);
+                  vec_st(SUMM, 0, res);
+                  return (int)res[[0]];
+               ]]
+            )
+         ])
+         AS_IF([test x"$OPUS_PPC_MAY_HAVE_ALTIVEC" = x"1"],
+         [
+            AC_DEFINE([OPUS_PPC_MAY_HAVE_ALTIVEC], 1,
+               [Compiler supports PowerPC AltiVec Intrinsics])
+            dnl No RTCD on PowerPC: MAY_HAVE always implies PRESUME.
+            AC_DEFINE([OPUS_PPC_PRESUME_ALTIVEC], 1,
+               [Define if binary requires PowerPC AltiVec intrinsics support])
+            AS_IF([test x"$OPUS_PPC_ALTIVEC_BYDEFAULT" != x"1"],
+            [
+               OPUS_PPC_ALTIVEC_CFLAGS="$PPC_ALTIVEC_CFLAGS"
+            ])
+            AC_SUBST([OPUS_PPC_ALTIVEC_CFLAGS])
+            intrinsics_support="PowerPC (AltiVec)"
+            AC_MSG_WARN([AltiVec is assumed to be present at run time; the resulting binary requires a G4/G5 or newer.])
+         ],
+         [
+            AC_MSG_WARN([Compiler does not support AltiVec intrinsics])
+            intrinsics_support=no
+         ])
+      ],
+      [
+         AC_MSG_WARN([No AltiVec support on little-endian PowerPC])
+         intrinsics_support=no
+      ],
+      [
+         AC_MSG_WARN([Unknown PowerPC endianness, not using AltiVec])
+         intrinsics_support=no
+      ])
+   ],
    [
       AC_MSG_WARN([No intrinsics support for your architecture])
       intrinsics_support="no"
@@ -785,6 +860,8 @@ AM_CONDITIONAL([HAVE_ARM_DOTPROD],
 AM_CONDITIONAL([HAVE_ARM_NEON_INTR],
     [test x"$OPUS_ARM_MAY_HAVE_NEON_INTR" = x"1"])
 AM_CONDITIONAL([CPU_X86], [test "$cpu_x86" = "yes"])
+AM_CONDITIONAL([HAVE_ALTIVEC],
+    [test x"$OPUS_PPC_MAY_HAVE_ALTIVEC" = x"1"])
 AM_CONDITIONAL([HAVE_SSE],
     [test x"$OPUS_X86_MAY_HAVE_SSE" = x"1"])
 AM_CONDITIONAL([HAVE_SSE2],
-- 
2.43.0

