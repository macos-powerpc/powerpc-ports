From 0053b0840b6d6367f7ccac618ca638987a5423e5 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Thu, 29 Oct 2026 02:36:55 +0000
Subject: [PATCH] op/coreaudio: Fix 32-bit build and sample rate sync

On 32-bit Darwin (e.g. ppc), MacTypes.h defines UInt32 as unsigned long,
so passing &coreaudio_buffer_frame_size to an int * parameter is
an incompatible pointer type, which GCC 14 and later reject by default.
Use UInt32 * for frame_size in coreaudio_start_audio_unit() and
coreaudio_set_buffer_size().

coreaudio_sync_device_sample_rate() passed sizeof(&desc.mSampleRate),
the size of a pointer, as the size of the Float64 nominal sample rate.
This only worked where pointers are 8 bytes; on 32-bit the HAL rejects
the 4-byte size and sync_sample_rate has no effect. Use
sizeof(sample_rate).

Assisted-by: Claude Opus 5.5
---
 op/coreaudio.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/op/coreaudio.c b/op/coreaudio.c
index a8b4693..d52ecba 100644
--- op/coreaudio.c
+++ op/coreaudio.c
@@ -478,7 +478,7 @@ static void coreaudio_sync_device_sample_rate(AudioDeviceID dev_id, AudioStreamB
 					 &aopa,
 					 0,
 					 NULL,
-					 sizeof(&desc.mSampleRate),
+					 sizeof(sample_rate),
 					 &sample_rate);
 	if (err != noErr)
 		d_print("Failed to synchronize the sample rate: %d\n", err);
@@ -526,7 +526,7 @@ static void coreaudio_hog_device(AudioDeviceID dev_id, bool hog)
 		d_print("Cannot hog the device: %d\n", err);
 }
 
-static OSStatus coreaudio_set_buffer_size(AudioUnit au, AudioStreamBasicDescription desc, int *frame_size)
+static OSStatus coreaudio_set_buffer_size(AudioUnit au, AudioStreamBasicDescription desc, UInt32 *frame_size)
 {
 	AudioValueRange value_range = {0, 0};
 	UInt32 property_size = sizeof(AudioValueRange);
@@ -609,7 +609,7 @@ static OSStatus coreaudio_init_audio_unit(AudioUnit *au,
 }
 
 static OSStatus coreaudio_start_audio_unit(AudioUnit *au,
-					   int *frame_size,
+					   UInt32 *frame_size,
 					   AudioStreamBasicDescription desc)
 {
 
